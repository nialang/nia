using std::collections;

pub struct Span {
    start: usize,
    end: usize,
}

extend Span {
    pub fun init(start: usize, end: usize) Span {
        .{ start, end }
    }

    pub fun bytes(&self, source: &[u8]) &[u8] {
        &source[self.start..self.end]
    }

    pub fun equals(&self, source: &[u8], text: &[u8]) bool {
        self.bytes(source).equals(text)
    }
}

pub struct TaskId {
    index: usize,
}

extend TaskId {
    pub fun init(index: usize) TaskId {
        .{ index }
    }

    pub fun index(&self) usize {
        self.index
    }
}

pub struct Task {
    name: Span,
    duration: u32,
    dependencies: collections::ArrayList[TaskId],
}

extend Task {
    pub fun init(name: Span, duration: u32) Task {
        .{ name, duration, dependencies: .init() }
    }

    pub fun name(&self) Span {
        self.name
    }

    pub fun duration(&self) u32 {
        self.duration
    }

    pub fun dependencies(&self) &[TaskId] {
        self.dependencies.asSlice()
    }

    pub fun dependenciesMut(&mut self) &mut collections::ArrayList[TaskId] {
        &mut self.dependencies
    }
}

pub struct DependencyRef {
    task: TaskId,
    name: Span,
}

extend DependencyRef {
    pub fun init(task: TaskId, name: Span) DependencyRef {
        .{ task, name }
    }

    pub fun task(&self) TaskId {
        self.task
    }

    pub fun name(&self) Span {
        self.name
    }
}

pub struct Graph {
    tasks: collections::ArrayList[Task],
}

extend Graph {
    pub fun init(tasks: collections::ArrayList[Task]) Graph {
        .{ tasks }
    }

    pub fun len(&self) usize {
        self.tasks.len()
    }

    pub fun task(&self, id: TaskId) &Task {
        &self.tasks.asSlice()[id.index()]
    }

    pub fun taskMut(&mut self, id: TaskId) &mut Task {
        &mut self.tasks.asMutSlice()[id.index()]
    }

    pub fun tasks(&self) &[Task] {
        self.tasks.asSlice()
    }
}
