using root::model;
using std::collections;
using std::hash;
using std::mem;

struct NameContext {
    source: &[u8],
}

extend NameContext {
    fun init(source: &[u8]) NameContext {
        .{ source }
    }
}

extend NameContext : collections::HashMapContext[model::Span] {
    fun hash(&self, seed: u64, key: &model::Span) u64 {
        hash::wyhash(seed, key.bytes(self.source))
    }

    fun eql(&self, left: &model::Span, right: &model::Span) bool {
        left.bytes(self.source).equals(right.bytes(self.source))
    }
}

pub struct NameIndex {
    values: collections::HashMapWithContext[model::Span, model::TaskId, NameContext],
}

extend NameIndex {
    pub fun init(source: &[u8]) NameIndex {
        .{ values: .initContextSeed(NameContext::init(source), 0) }
    }

    pub fun insert(
        &mut self,
        allocator: &mut mem::Allocator,
        name: model::Span,
        id: model::TaskId,
    ) mem::Error!bool {
        if self.values.insertIfAbsent(allocator, name, id).? is ?_ {
            !false
        } else {
            !true
        }
    }

    pub fun get(&self, name: model::Span) ?model::TaskId {
        if self.values.get(&name) is ?id {
            ?id.*
        } else {
            null
        }
    }
}
