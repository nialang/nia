using std::build;
using std::fs;
using std::io;

fn generateSource(b: &mut build::Build) build::Error!void {
    let generatedPath = ".nia-build/generated.nia";
    let mut file = fs::File::create(
        fs::PathView::init(&generatedPath),
        fs::CreateOptions::init(),
    ).asBuildError().?;
    defer file.close().asBuildError().?;
    let mut buffer: [256]u8 = [_]u8[0; 256];
    let mut writer = file.writer(b.io(), &mut buffer[..]).asBuildError().?;
    writer.write_all(&b"using std::process;\npub fn main(init: process::Init) process::ExitCode!void { _ = init; !{} }\n").asBuildError().?;
    writer.flush().asBuildError()
}

fn failAction(b: &mut build::Build) build::Error!void {
    _ = b;
    build::Error::StepFailed!
}

pub fn build(b: &mut build::Build) build::Error!void {
    let helperName = "helper";
    let helperPath = "deps/helper.nia";
    let sourcePath = "src/main.nia";
    let generatedPath = ".nia-build/generated.nia";
    let sourceName = "source-app";
    let generatedName = "generated-app";
    let generateName = "generate-source";
    let emitSourceName = "emit-source";
    let emitGeneratedName = "emit-generated";
    let allName = "all";
    let failName = "fail";

    let imports = [
        build::ModuleImport::init(&helperName, fs::PathView::init(&helperPath)),
    ];
    let sourceModule = b.addModule(
        build::ModuleOptions::init(fs::PathView::init(&sourcePath))
            .withImports(&imports[..]),
    ).?;
    let generatedModule = b.addModule(
        build::ModuleOptions::init(fs::PathView::init(&generatedPath)),
    ).?;
    let sourceApp = b.addExecutable(
        build::ExecutableOptions::init(&sourceName, sourceModule),
    ).?;
    let generatedApp = b.addExecutable(
        build::ExecutableOptions::init(&generatedName, generatedModule),
    ).?;

    let generate = b.addStep(&generateName, &generateSource).?;
    let emitGenerated = b.addEmitExecutableStep(&emitGeneratedName, generatedApp).?;
    let emitSource = b.addEmitExecutableStep(&emitSourceName, sourceApp).?;
    let all = b.addStep(&allName, &build::noopStep).?;
    _ = b.addStep(&failName, &failAction).?;
    b.dependOn(emitGenerated, generate).?;
    b.dependOn(all, emitGenerated).?;
    b.dependOn(all, emitSource).?;
    b.setDefaultStep(all).?;
    !{}
}
