{
  "name": "nia",
  "displayName": "Nia",
  "description": "Nia language support",
  "version": "0.3.0",
  "publisher": "nialang",
  "license": "GPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/nialang/nia.git" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:nia"],
  "main": "./extension.js",
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "contributes": {
    "languages": [
      {
        "id": "nia",
        "aliases": ["Nia"],
        "extensions": [".nia"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./assets/nia-mark.svg", "dark": "./assets/nia-mark-dark.svg" }
      }
    ],
    "grammars": [
      { "language": "nia", "scopeName": "source.nia", "path": "./syntaxes/nia.tmLanguage.json" }
    ],
    "iconThemes": [
      { "id": "nia", "label": "Nia File Icons", "path": "./assets/file-icons.json" }
    ],
    "configurationDefaults": {
      "[nia]": { "editor.semanticHighlighting.enabled": true }
    },
    "configuration": {
      "title": "Nia",
      "properties": {
        "nia.server.path": {
          "type": "string",
          "default": "nia-lsp",
          "scope": "machine",
          "description": "Command or absolute path to the Nia language server."
        },
        "nia.server.resourceRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional lib directory for a Nia checkout or custom toolchain layout."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"const { copyFileSync } = require('node:fs'); for (const file of ['nia-mark.svg', 'nia-mark-dark.svg']) copyFileSync('../../assets/brand/' + file, 'assets/' + file); copyFileSync('../../LICENSES/GPL-3.0-or-later.txt', 'LICENSE.txt')\""
  }
}
