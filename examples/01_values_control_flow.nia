using std;
using std::debug;
using std::fmt;
using std::process;
using process::{Init, ExitCode, exit};

// Point is local to this module, so its fields can be initialized and read here.
struct Point {
    x: i32,
    y: i32,
}

// Methods live in extend blocks. The receiver decides the call syntax:
// point.len2() is shorthand for the method declared on Point.
extend Point {
    fn len2(&self) i32 {
        self.x * self.x + self.y * self.y
    }
}

fn sum(values: &[i32]) i32 {
    let mut total = 0;
    // Slice iteration yields &i32 items. The &value pattern copies out each i32.
    for &value in values {
        total += value;
    }
    total
}

fn grade(score: i32) i32 {
    // switch ranges are half-open with .. and inclusive with ..=.
    switch score {
        0..60 => 0,
        60..=79 => 1,
        80..=89 => 2,
        90..=100 => 3,
        _ => -1,
    }
}

pub fn main(init: Init) ExitCode!() {
    _ = init;

    // This literal gets its type from the binding annotation.
    let mut point: Point = { x: 3, y: 4 };
    // Use Type { ... } when a literal needs to stand on its own.
    let mut other = Point { x: 5, y: 12 };
    let mut point_len2 = point.len2();
    let mut other_len2 = other.len2();
    let mut score = grade(87);
    // [_] lets the compiler infer the array length from the elements.
    let mut values = [_]i32[point_len2, other_len2, score];
    // Array pointers coerce to slices when a slice is expected.
    let mut total = sum(&values);

    // defer runs at scope exit, including returns after this point.
    defer point.x = point.x + 1;

    if total != 25 + 169 + 2 {
        return exit(1)!;
    }

    debug::print(
        &"point={} other={} grade={} total={}\n",
        &[&point_len2, &other_len2, &score, &total],
    ).exit().?;

    !()
}
