import std;
import std.fmt;
import std.io;
import std.process;
import std.result;

struct Point {
    x: i32,
    y: i32,
}

extend Point {
    fn len2(&self) i32 {
        self.x * self.x + self.y * self.y
    }
}

fn sum(values: &[i32]) i32 {
    var total = 0;
    for i in std::range(0usize..values.len()) {
        total += values[i];
    }
    total
}

fn grade(score: i32) i32 {
    switch score {
        0..60 => 0,
        60..=79 => 1,
        80..=89 => 2,
        90..=100 => 3,
        _ => -1,
    }
}

pub fn main(init: process::Init) process::ExitCode!void {
    var buffer: [256]u8 = [_]u8[0; 256];
    var stdout = io::FileWriter::stdout(init.io(), &mut buffer[..]);

    var point: Point = { x: 3, y: 4 };
    var other = Point { x: 5, y: 12 };
    var point_len2 = point.len2();
    var other_len2 = other.len2();
    var score = grade(87);
    var values = [_]i32[point_len2, other_len2, score];
    var total = sum(&values[..]);

    defer point.x = point.x + 1;

    if total != 25 + 169 + 2 {
        return process::ExitCode::init(1)!;
    }

    stdout.print(
        "point={} other={} grade={} total={}\n",
        [&point_len2, &other_len2, &score, &total],
    ).map_err[process::ExitCode](&process::io_exit).?;
    stdout.flush().map_err[process::ExitCode](&process::io_exit).?;

    !{}
}
