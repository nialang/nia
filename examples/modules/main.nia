pub module config;
pub module facade;
pub module math;
pub module palette;

using std::debug;
using std::fmt;
using std::process;

using entry::config;
using entry::facade as api;

// using can import selected names, rename them, and import enum variants.
using api::{Point, add as plus, Color::Green};
using process::{Init, ExitCode, exit};

pub fn main(init: Init) ExitCode!void {
    _ = init;

    var point: Point = { x: 3, y: 4 };
    var values: [config::width]i32 = [1, 2, 3, 4];
    var sum = plus(values[0], values[3]);
    var len2 = point.len2();
    var color = api::color_code(Green);
    var diff = api::math::sub(10, 5);

    if sum + len2 + color + diff != 38 {
        return exit(1)!;
    }

    debug::print(
        "modules sum={} len2={} color={} diff={}\n",
        &[&sum, &len2, &color, &diff],
    );

    !{}
}
