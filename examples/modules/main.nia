pub module api;
pub module colors;
pub module config;
pub module geometry;

using std::io;
using std::fmt;
using std::process;
using entry::api;
using entry::config;
using api::{Point, add as plus, Color::Green};
using process::{Init, ExitCode, exit};

pub fn main(init: Init) ExitCode!() {
    _ = init;
    let point = Point { x: 3, y: 4 };
    let values: [i32; config::width] = [1, 2, 3, 4];
    let sum = plus(values[0], values[3]);
    let len2 = point.len2();
    let color = api::colorCode(Green);
    let diff = api::geometry::sub(10, 5);

    if sum + len2 + color + diff != 38 {
        return exit(1)!;
    }
    io::debugPrint(&"sum={} len2={} color={} diff={}\n", &[&sum, &len2, &color, &diff]).?;
    !()
}
