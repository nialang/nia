import std.fmt;
import std.io;
import std.process;

import .config;
import .facade as api;

using api::{Point, add as plus, Color::Green};

pub fn main(init: process::Init) process::ExitCode!void {
    var buffer: [256]u8 = [_]u8[0; 256];
    var stdout = io::FileWriter::stdout(init.io(), &mut buffer[..]);

    var point: Point = { x: 3, y: 4 };
    var values: [config::width]i32 = [1, 2, 3, 4];
    var sum = plus(values[0], values[3]);
    var len2 = point.len2();
    var color = api::color_code(Green);
    var diff = api::math::sub(10, 5);

    if sum + len2 + color + diff != 38 {
        return process::ExitCode::init(1)!;
    }

    switch stdout.print(
        "modules sum={} len2={} color={} diff={}\n",
        [&sum, &len2, &color, &diff],
    ) {
        !ok => _ = ok,
        error! => return process::ExitCode::init(2)!,
    }
    switch stdout.flush() {
        !ok => _ = ok,
        error! => return process::ExitCode::init(3)!,
    }

    !{}
}
