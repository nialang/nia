using std::debug;
using std::fmt;
using std::process;
using process::{Init, ExitCode, exit};

struct Point {
    x: i32,
    y: i32,
}

extend Point {
    fn distanceSquared(&self) i32 {
        self.x * self.x + self.y * self.y
    }
}

enum Band: u8 {
    Low,
    Middle,
    High,
}

fn classify(score: i32) Band {
    match score {
        0..60 => Band::Low,
        60..90 => Band::Middle,
        _ => Band::High,
    }
}

fn sum(values: &[i32]) i32 {
    let mut total = 0;
    for &value in values {
        total += value;
    }
    total
}

pub fn main(init: Init) ExitCode!() {
    _ = init;

    let mut point = Point { x: 3, y: 4 };
    let mut distance = point.distanceSquared();
    let mut samples = [distance, 60, 87];
    let mut total = sum(&samples);
    let band = classify(samples[2]);
    defer point.x = point.x + 1;

    if total != 176 {
        return exit(1)!;
    }
    match band {
        Band::High => {},
        _ => return exit(2)!,
    }

    debug::print(&"distance={} total={} score={}\n", &[&distance, &total, &samples[2]]).?;
    !()
}
