// A hosted executable starts from the platform C runtime and can call libc.
extern fn printf(fmt: &const u8, ...);

fn answer() i32 {
    42 // The last expression in a block is the return value.
}

fn main() i32 {
    var value = answer();
    printf(c"hello from nia: answer=%d\n", value);
    value // use `echo $?` to see this return value
}
