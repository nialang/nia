using std;
using std::debug;
using std::fmt;
using std::hash;
using std::mem;
using std::process;
using process::{Init, ExitCode};

fn run(init: Init) ExitCode!() {
    _ = init;

    let mut page = mem::PageAllocator::init();
    let mut gpa = mem::GeneralPurposeAllocator::init(&mut page);
    defer gpa.deinit().ok().exit().?;
    let allocator = &mut gpa;

    let mut scores = std::HashMap[i32, i32]::init();
    defer scores.deinit(allocator).exit().?;

    // Reserve before repeated insertion when an approximate size is known.
    scores.reserve(allocator, 8).exit().?;
    _ = scores.insert(allocator, 7, 70).exit().?;
    _ = scores.insert(allocator, 42, 420).exit().?;
    _ = scores.insert(allocator, 9, 90).exit().?;
    // getOrInsert returns the stored entry slot and any rejected input.
    let mut answerSlot = scores.getOrInsert(allocator, 42, 0).exit().?;
    _ = answerSlot.intoRejected();
    answerSlot.value().* = answerSlot.value().* + 1;
    switch scores.getEntryMut(&42) {
        mut ?entry => {
            entry.valueMut().* = entry.value().* + 9;
        },
        null => {
            return mem::Error::Invalid.asExitCode()!;
        },
    }
    for value in scores.valuesMut() {
        value.* = value.* / 10;
    }

    let mut answer = 0;
    switch scores.get(&42) {
        ?value => {
            answer = value.*;
        },
        null => {
            return mem::Error::Invalid.asExitCode()!;
        },
    }

    let mut removedKey = 0;
    let mut removedValue = 0;
    // removeEntry transfers the removed key and value out of the map.
    switch scores.removeEntry(&7) {
        ?entry => {
            removedKey = entry.key().*;
            removedValue = entry.value().*;
        },
        null => {
            return mem::Error::Invalid.asExitCode()!;
        },
    }

    let mut total = 0;
    for entry in scores {
        total += entry.value().*;
    }

    let mut len = scores.len();
    let mut hasSeven = scores.containsKey(&7);

    debug::print(&"hash_map len={} answer={} removed_key={} removed_value={} total={} has_seven={}\n", &[
        &len,
        &answer,
        &removedKey,
        &removedValue,
        &total,
        &hasSeven,
    ]).exit().?;
    debug::print(&"hash_map entries={}\n", &[&scores]).exit().?;
    !()
}

pub fn main(init: Init) ExitCode!() {
    run(init).?;
    !()
}
