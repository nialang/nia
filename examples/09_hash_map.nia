import std;
import std.debug;
import std.mem;
import std.process;
using process::{Init, ExitCode};

fn run(init: Init) mem::Error!void {
    _ = init;

    var page = mem::PageAllocator::init();
    var gpa = mem::GeneralPurposeAllocator::init(&mut page);
    defer gpa.deinit().?.ok().?;

    var scores = std::HashMap[i32, i32]::init_seed(2024u64);
    defer scores.deinit(&mut gpa).?;

    scores.reserve(&mut gpa, 8usize).?;
    _ = scores.put(&mut gpa, 7, 70).?;
    _ = scores.put(&mut gpa, 42, 420).?;
    _ = scores.put(&mut gpa, 9, 90).?;
    var answer_slot = scores.get_or_put_value(&mut gpa, 42, 0).?;
    answer_slot.value().* = answer_slot.value().* + 1;

    var answer = 0;
    switch scores.get(&42) {
        ?value => answer = value.*,
        null => return mem::Error::Invalid!,
    }

    var removed_key = 0;
    var removed_value = 0;
    switch scores.remove_entry(&7) {
        ?entry => {
            removed_key = entry.key().*;
            removed_value = entry.value().*;
        },
        null => return mem::Error::Invalid!,
    }

    var total = 0;
    for entry in scores.iter() {
        total += entry.value().*;
    }

    var len = scores.len();
    var has_seven = scores.contains_key(&7);

    debug::print("hash_map len={} answer={} removed_key={} removed_value={} total={} has_seven={}\n", [
        &len,
        &answer,
        &removed_key,
        &removed_value,
        &total,
        &has_seven,
    ]);
    debug::print("hash_map entries={}\n", [&scores]);
    !{}
}

pub fn main(init: Init) ExitCode!void {
    run(init).exit().?;
    !{}
}
