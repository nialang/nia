using std;
using std::debug;
using std::fmt;
using std::hash;
using std::mem;
using std::process;
using process::{Init, ExitCode};

fn run(init: Init) mem::Error!void {
    _ = init;

    let mut page = mem::PageAllocator::init();
    let mut gpa = mem::GeneralPurposeAllocator::init(&mut page);
    defer gpa.deinit().ok().?;
    let allocator = &mut gpa;

    // init_seed is deterministic, which keeps example output stable.
    let mut scores = std::HashMap[i32, i32]::init_seed(2024u64);
    defer scores.deinit(allocator).?;

    // Reserve before repeated insertion when an approximate size is known.
    scores.reserve(allocator, 8usize).?;
    _ = scores.insert(allocator, 7, 70).?;
    _ = scores.insert(allocator, 42, 420).?;
    _ = scores.insert(allocator, 9, 90).?;
    // get_or_put returns an entry slot. value() is a pointer to the stored
    // value, so .* reads or writes through that pointer.
    let mut answer_slot = scores.get_or_put(allocator, 42).?;
    answer_slot.value().* = answer_slot.value().* + 1;
    switch scores.get_entry_mut(&42) {
        mut ?entry => {
            entry.valueMut().* = entry.value().* + 9;
        },
        null => {
            return mem::Error::Invalid!;
        },
    }
    for value in scores.values_mut() {
        value.* = value.* / 10;
    }

    let mut answer = 0;
    switch scores.get(&42) {
        ?value => {
            answer = value.*;
        },
        null => {
            return mem::Error::Invalid!;
        },
    }

    let mut removed_key = 0;
    let mut removed_value = 0;
    // remove_entry transfers the removed key and value out of the map.
    switch scores.remove_entry(&7) {
        ?entry => {
            removed_key = entry.key().*;
            removed_value = entry.value().*;
        },
        null => {
            return mem::Error::Invalid!;
        },
    }

    let mut total = 0;
    for entry in scores.iter() {
        total += entry.value().*;
    }

    let mut len = scores.len();
    let mut has_seven = scores.contains_key(&7);

    debug::print(&"hash_map len={} answer={} removed_key={} removed_value={} total={} has_seven={}\n", &[
        &len,
        &answer,
        &removed_key,
        &removed_value,
        &total,
        &has_seven,
    ]);
    debug::print(&"hash_map entries={}\n", &[&scores]);
    !{}
}

pub fn main(init: Init) ExitCode!void {
    run(init).exit().?;
    !{}
}
