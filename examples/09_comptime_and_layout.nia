extern fn printf(fmt: &u8, ...);

// `comptime` bindings are evaluated during compilation and can drive types,
// array lengths, and other compile-time-only decisions.
comptime let width: usize = 2 + 2;
comptime let byte_count: usize = 4 * width;

// Top-level `let` data has an address and can be used for static byte data.
let message = c"layout";
let first_message_byte = &message[0];

// Attributes are AST marks. Unknown attributes are reserved by the language and
// have no semantic effect until the compiler assigns one.
@[example.section("layout")]
struct Header {
    @[example.field(0)]
    tag: u8,
    len: usize,
}

struct BuildShape {
    rows: usize,
    cols: usize,
}

comptime let shape: BuildShape = BuildShape{rows: 2, cols: width};
comptime let cell_count: usize = shape.rows * shape.cols;

fn target_name() &u8 {
    // `comptime if` prunes the inactive branch before name resolution and type
    // checking, while the whole file must still be syntactically valid.
    comptime if @builtin().target.os == "linux" {
        c"linux"
    } else {
        c"portable"
    }
}

fn pointer_width_name() &u8 {
    comptime if @builtin().target.pointer_width == 64 {
        c"64-bit"
    } else {
        c"32-bit-or-other"
    }
}

fn pointer_width_bytes() i32 {
    comptime if @builtin().target.pointer_width == 64 {
        8
    } else {
        4
    }
}

fn sized[T]() usize
where T: Sized {
    // Layout builtins are type-level queries available to checked code.
    @size[T]() + @align[T]()
}

fn main() i32 {
    comptime let local_width: usize = width;
    var values: [local_width]i32 = [1, 2, 3, 4];
    var storage: [byte_count]u8 = [0; byte_count];
    var cells: [cell_count]u8 = [0; cell_count];
    var header: Header = { tag: first_message_byte.*, len: storage.len() };

    printf(
        c"comptime/layout: values=%d storage=%d cells=%d word=%d tag=%d header_len=%d size_align=%d\n",
        values.len() as i32,
        storage.len() as i32,
        cells.len() as i32,
        pointer_width_bytes(),
        header.tag as i32,
        header.len as i32,
        sized[Header]() as i32,
    );
    printf(c"target: os=%s width=%s\n", target_name(), pointer_width_name());
    0
}
