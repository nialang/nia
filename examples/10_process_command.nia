using std::fs;
using std::process;
using process::{ExitCode, Init};

pub fn main(init: Init) ExitCode!void {
    let arguments: [2]&[char] = [&"-c", &"printf '%s\n' \"$NIA_EXAMPLE_MODE\""];
    let environment: [1]process::EnvEntry = [
        process::EnvEntry::init(&"NIA_EXAMPLE_MODE", &"typed environment"),
    ];
    // The executable path becomes argv[0]; arguments contains only user arguments.
    let command = process::Command::init(fs::PathView::init(&"/bin/sh"), init.env())
        .withArguments(&arguments)
        .withEnvironment(&environment)
        .withStdout(process::StdIo::Pipe);
    let mut child = command.spawn().exit().?;
    let mut stdout = switch child.takeStdout() {
        ?value => value,
        null => return process::exit(1)!,
    };
    let mut output: [18]u8 = [0; 18];
    stdout.readExact(&mut output[..]).exit().?;
    stdout.close().exit().?;
    let term = child.wait().exit().?;
    if not term.succeeded() or not (&output[..]).equals(&b"typed environment\n") {
        return process::exit(1)!;
    }
    !{}
}
