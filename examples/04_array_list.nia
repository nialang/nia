using std;
using std::debug;
using std::fmt;
using std::mem;
using std::process;
using process::{Init, ExitCode};

fn run(init: Init) ExitCode!() {
    _ = init;

    let mut storage: [256]u8 = [_]u8[0; 256];
    // FixedBufferAllocator never touches the OS; allocation fails when this
    // local byte array runs out of space.
    let mut fixed = mem::FixedBufferAllocator::init(&mut storage);
    // &mut fixed is the allocator handle. Bind it once so every container
    // operation uses the same pointer.
    let allocator = &mut fixed;
    let mut values = std::ArrayList[i32]::init();
    // Containers do not own an allocator. Deinitialize with the same allocator
    // that provided their backing storage.
    defer values.deinit(allocator).exit().?;

    values.push(allocator, 10).exit().?;
    values.push(allocator, 20).exit().?;
    values.push(allocator, 30).exit().?;

    let mut total = 0;
    for &item in values {
        total += item;
    }

    let mut len = values.len();
    let mut capacity = values.capacity();

    debug::print(
        &"array_list len={} capacity={} values={} total={}\n",
        &[&len, &capacity, &values, &total],
    ).exit().?;

    !()
}

pub fn main(init: Init) ExitCode!() {
    // Standard-library memory errors know how to become process exit codes.
    run(init).?;
    !()
}
