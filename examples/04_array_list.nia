import std;
import std.debug;
import std.mem;
import std.process;
using process::{Init, ExitCode};

fn run(init: Init) mem::Error!void {
    _ = init;

    var allocator = mem::PageAllocator::init();
    var values = std::ArrayList[i32]::init();

    values.push(&mut allocator, 10).?;
    values.push(&mut allocator, 20).?;
    values.push(&mut allocator, 30).?;

    let items = values.as_slice();
    var len = items.len();
    var capacity = values.capacity();
    var first = items[0];
    var last = items[2];

    debug::print(
        "array_list len={} capacity={} first={} last={}\n",
        [&len, &capacity, &first, &last],
    );

    values.deinit(&mut allocator).?;

    !{}
}

pub fn main(init: Init) ExitCode!void {
    run(init).exit().?;
    !{}
}
