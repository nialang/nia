using std;
using std::debug;
using std::mem;
using std::process;
using process::{Init, ExitCode};

fn run(init: Init) mem::Error!void {
    _ = init;

    var storage: [256]u8 = [_]u8[0; 256];
    // FixedBufferAllocator never touches the OS; allocation fails when this
    // local byte array runs out of space.
    var allocator = mem::FixedBufferAllocator::init(storage);
    var values = std::ArrayList[i32]::init();
    // Containers do not own an allocator. Deinitialize with the same allocator
    // that provided their backing storage.
    defer values.deinit(&mut allocator).?;

    values.push(&mut allocator, 10).?;
    values.push(&mut allocator, 20).?;
    values.push(&mut allocator, 30).?;

    var total = 0;
    for &item in values.iter() {
        total += item;
    }

    var len = values.len();
    var capacity = values.capacity();

    debug::print(
        "array_list len={} capacity={} values={} total={}\n",
        [&len, &capacity, &values, &total],
    );

    !{}
}

pub fn main(init: Init) ExitCode!void {
    // Standard-library memory errors know how to become process exit codes.
    run(init).exit().?;
    !{}
}
