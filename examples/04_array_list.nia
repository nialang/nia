import std;
import std.debug;
import std.mem;
import std.process;
using process::{Init, ExitCode};

fn run(init: Init) mem::Error!void {
    _ = init;

    var page = mem::PageAllocator::init();
    var values = std::ArrayList[i32]::init();
    defer values.deinit(&mut page).?;

    values.push(&mut page, 10).?;
    values.push(&mut page, 20).?;
    values.push(&mut page, 30).?;

    var total = 0;
    for &item in values.iter() {
        total += item;
    }

    var len = values.len();
    var capacity = values.capacity();

    debug::print(
        "array_list len={} capacity={} values={} total={}\n",
        [&len, &capacity, &values, &total],
    );

    !{}
}

pub fn main(init: Init) ExitCode!void {
    run(init).exit().?;
    !{}
}
