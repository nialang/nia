import std.fmt;
import std.io;
import std.process;
import std.result;

trait Measured {
    fn measure(&self) i32;
}

struct Count {
    value: i32,
}

extend Count : Measured {
    fn measure(&self) i32 {
        self.value
    }
}

extend Count : Add[Count] {
    type Output = Count;

    fn add(self, rhs: Count) Count {
        { value: self.value + rhs.value }
    }
}

fn combine[T](left: T, right: T) T
where T: Add[T, Output = T]
{
    left + right
}

fn read[T](value: &T) i32
where T: Measured
{
    value.measure()
}

pub fn main(init: process::Init) process::ExitCode!void {
    var buffer: [256]u8 = [_]u8[0; 256];
    var stdout = io::FileWriter::stdout(init.io(), &mut buffer[..]);

    var left: Count = { value: 20 };
    var right: Count = { value: 22 };
    var total = combine[Count](left, right);
    var measured = read[Count](&total);

    if measured != 42 {
        return process::ExitCode::init(1)!;
    }

    stdout.print("traits total={}\n", [&measured]).map_err[process::ExitCode](&process::io_exit).?;
    stdout.flush().map_err[process::ExitCode](&process::io_exit).?;

    !{}
}
