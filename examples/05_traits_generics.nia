using std::debug;
using std::fmt;
using std::process;
using process::{Init, ExitCode, exit};

trait Measured {
    fn measure(&self) i32;
}

struct Count {
    value: i32,
}

extend Count : Measured {
    fn measure(&self) i32 {
        self.value
    }
}

// Operator syntax is trait syntax. Implement Add to make left + right valid.
extend Count : Add[Count] {
    type Output = Count;

    fn add(self, rhs: Count) Count {
        { value: self.value + rhs.value }
    }
}

fn combine[T](left: T, right: T) T
where T: Add[T, Output = T]
{
    left + right
}

fn read[T](value: &T) i32
where T: Measured
{
    // Trait bounds make trait methods available inside generic functions.
    value.measure()
}

pub fn main(init: Init) ExitCode!void {
    _ = init;

    var left: Count = { value: 20 };
    var right: Count = { value: 22 };
    // Function type arguments can be inferred from arguments when the call is
    // unambiguous. `combine[Count](left, right)` is the explicit form.
    var total = combine(left, right);
    var measured = read(&total);

    if measured != 42 {
        return exit(1)!;
    }

    debug::print("traits total={}\n", &[&measured]);

    !{}
}
