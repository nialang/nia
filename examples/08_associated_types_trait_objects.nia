extern fn printf(fmt: &const u8, ...);

const report_fmt = c"trait objects: direct=%d dyn=%d sized=%d report=%d name=%d\n";

trait Named {
    fn name_code(&const self) i32;
}

trait Source {
    type Item;

    // Associated type projections use explicit `[Self as Trait]::Name` syntax.
    fn get(&const self) [Self as Source]::Item;
}

// `SizedSource` inherits `Source::Item` from its supertrait.
trait SizedSource : Source + Named {
    fn size(&const self) usize;
}

trait CountSource {
    type Item;

    fn count(&const self) [Self as CountSource]::Item;
}

// `Report` has two supertraits with associated types. Object types below bind
// each supertrait output explicitly to avoid ambiguity.
trait Report : Source + CountSource {
    fn report_code(&const self) i32;
}

struct Counter {
    value: i32,
    count: usize,
}

extend Counter : Named {
    fn name_code(&const self) i32 {
        7
    }
}

extend Counter : Source {
    type Item = i32;

    fn get(&const self) i32 {
        self.value
    }
}

extend Counter : SizedSource {
    fn size(&const self) usize {
        self.count
    }
}

extend Counter : CountSource {
    type Item = usize;

    fn count(&const self) usize {
        self.count
    }
}

extend Counter : Report {
    fn report_code(&const self) i32 {
        self.value + self.count as i32
    }
}

fn read[T](source: &const T) [T as Source]::Item
where T: Source {
    source.get()
}

fn dyn_read(source: &const Source[Item = i32]) i32 {
    source.get()
}

// `SizedSource` does not declare `Item` itself, so the object type binds the
// inherited supertrait associated type with a projection key.
fn dyn_size(source: &const SizedSource[[Self as Source]::Item = i32]) usize {
    source.size()
}

fn dyn_count(source: &const CountSource[Item = usize]) usize {
    source.count()
}

fn report_total(report: &const Report[
    [Self as Source]::Item = i32,
    [Self as CountSource]::Item = usize,
]) i32 {
    // Passing `report` to these functions performs trait object upcasts to the
    // selected supertrait object type.
    dyn_read(report) + dyn_count(report) as i32 + report.report_code()
}

fn main() i32 {
    var counter: Counter = { value: 35, count: 4usize };
    var object: &const Source[Item = i32] = &const counter;
    var sized: &const SizedSource[[Self as Source]::Item = i32] = &const counter;
    var report: &const Report[
        [Self as Source]::Item = i32,
        [Self as CountSource]::Item = usize,
    ] = &const counter;

    var direct = read[Counter](&const counter);
    var dyn_value = dyn_read(object);
    var sized_value = dyn_size(sized) as i32;
    var report_value = report_total(report);
    var name = counter.name_code();

    printf(
        &const report_fmt[0],
        direct,
        dyn_value,
        sized_value,
        report_value,
        name,
    );

    0
}
