using std::debug;
using std::process;
using process::{Init, ExitCode};

// Executable examples use the standard startup contract: the injected runtime
// calls this public root main and maps ExitCode errors to process status.
pub fn main(init: Init) ExitCode!void {
    // The startup payload currently carries runtime I/O state. Discard it when
    // a program only needs debug output.
    _ = init;
    // Format arguments are passed as a slice of value handles.
    debug::print("hello from nia\n", &[]);
    // Success is the value side of the ExitCode!void error union.
    !{}
}
