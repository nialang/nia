import std.debug;
import std.process;
using process::{Init, ExitCode};

fn first(values: &[i32]) i32 {
    values[0]
}

fn write_first(values: &mut [i32], value: i32) void {
    values[0] = value;
}

pub fn main(init: Init) ExitCode!void {
    _ = init;

    var values: [4]i32 = [1, 2, 3, 4];
    var window = &values[1..=2];
    var zeros: [4]i32 = [0; 4];
    var writable = &mut zeros[..];
    write_first(writable, first(window));

    let name = "nia";
    let bytes = b"ni" b"a";
    let c_name = c"nia";
    var window_len = window.len();
    var name_len = name.len();
    var bytes_len = bytes.len();
    var c_name_len = c_name.len();
    var first_written = writable[0];

    if first_written != 2 {
        return (1 as ExitCode)!;
    }
    if name_len != 3usize {
        return (2 as ExitCode)!;
    }
    if bytes[2] != b'a' {
        return (3 as ExitCode)!;
    }
    if c_name[3] != 0u8 {
        return (4 as ExitCode)!;
    }

    debug::print(
        "slice window={} first={} text={} bytes={} cstring={}\n",
        [&window_len, &first_written, &name_len, &bytes_len, &c_name_len],
    );

    !{}
}
