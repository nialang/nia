using std::debug;
using std::fmt;
using std::process;
using std::slice;
using process::{Init, ExitCode, exit};

static stable_bytes_storage = b"nia";

fn first(values: &[i32]) i32 {
    values[0]
}

fn write_first(values: &mut [i32], value: i32) void {
    values[0] = value;
}

fn byte_sum(bytes: &[u8]) usize {
    let mut total: usize = 0;
    for &byte in bytes.iter() {
        total += byte as usize;
    }
    total
}

fn copy_name(output: &mut [u8]) usize {
    let source = b"nia";
    let mut index: usize = 0;
    while index < source.len() and index < output.len() {
        output[index] = source[index];
        index += 1;
    }
    index
}

pub fn main(init: Init) ExitCode!void {
    _ = init;

    let mut values: [4]i32 = [1, 2, 3, 4];
    // Ranges create slice views; this one contains values[1] and values[2].
    let mut window = &values[1..=2];
    let mut zeros: [4]i32 = [0; 4];
    // Mutability belongs to the pointer/slice, so pass &mut when writing.
    let mut writable: &mut [i32] = &mut zeros;
    write_first(writable, first(window));

    // Text and byte-string literals are fixed-length array values.
    let name = "nia";
    // Adjacent byte-string literals concatenate.
    let bytes = b"ni" b"a";
    let phrase = "slice " "coercion";
    let multiline = (
        \\slice
        \\coercion
    );
    // Add a trailing NUL explicitly for C ABI calls.
    let c_name = b"nia\0";

    // Explicit pointers to arrays coerce to slices when a slice is expected.
    let direct_sum = byte_sum(&b"nia");

    // Use a top-level static when an address should refer to global storage.
    let stable_bytes: &[u8] = &stable_bytes_storage;

    // Or let the caller provide storage that the callee fills.
    let mut copied: [8]u8 = [0; 8];
    let copied_len = copy_name(&mut copied);

    let mut window_len = window.len();
    let mut name_len = name.len();
    let mut bytes_len = bytes.len();
    let mut c_name_len = c_name.len();
    let mut stable_bytes_len = stable_bytes.len();
    let mut first_written = writable[0];

    if first_written != 2 {
        return exit(1)!;
    }
    if name_len != 3 {
        return exit(2)!;
    }
    if bytes[2] != b'a' {
        return exit(3)!;
    }
    if phrase.len() != 14 or phrase[5] != ' ' {
        return exit(8)!;
    }
    if multiline.len() != 14 or multiline[5] != '\n' {
        return exit(9)!;
    }
    if c_name[3] != 0 {
        return exit(4)!;
    }
    if direct_sum != 312 {
        return exit(5)!;
    }
    if stable_bytes_len != 3 or stable_bytes[2] != b'a' {
        return exit(6)!;
    }
    if copied_len != 3 or copied[0] != b'n' or copied[2] != b'a' {
        return exit(7)!;
    }

    debug::print(
        &"slice window={} first={} text={} bytes={} cstring={} stable={} copied={}\n",
        &[
            &window_len,
            &first_written,
            &name_len,
            &bytes_len,
            &c_name_len,
            &stable_bytes_len,
            &copied_len,
        ],
    );

    !{}
}
