using std;
using std::debug;
using std::fmt;
using std::mem;
using std::process;
using process::{Init, ExitCode};

fn fillScores(list: &mut std::ArrayList[i32], allocator: &mut mem::Allocator) mem::Error!() {
    // allocator is already a handle. Pass it on directly.
    list.push(allocator, 8).?;
    list.push(allocator, 13).?;
    list.push(allocator, 21).?;
    !()
}

fn sum(values: &[i32]) i32 {
    let mut total = 0;
    for &value in values {
        total += value;
    }
    total
}

fn run(init: Init) ExitCode!() {
    _ = init;

    let mut page = mem::PageAllocator::init();
    // ArenaAllocator gets pages from a child allocator and frees/reset them as
    // a group. It is a good fit for phase-local scratch data.
    let mut arena = mem::ArenaAllocator::init(&mut page);
    defer arena.deinit().?;
    let allocator = &mut arena;

    let mut scores = std::ArrayList[i32]::init();
    fillScores(&mut scores, allocator).?;

    let mut firstTotal = sum(scores.asSlice());
    let mut firstCapacity = arena.capacity();
    let mut firstUsed = arena.used();

    // Every slice or container allocation from the arena becomes invalid after
    // reset. Only keep copied scalar results across this boundary.
    arena.reset().?;

    // New allocations after reset may reuse retained arena storage.
    let mut labels = allocator.allocSlice[u8](16).?;
    // This is mutable byte storage, not a string literal; string and
    // byte-string literal forms are covered in 02_slices_and_strings.nia.
    labels.asMutSlice()[0] = b'o';
    labels.asMutSlice()[1] = b'k';
    if labels.asSlice()[0] != b'o' or labels.asSlice()[1] != b'k' {
        return process::exit(1)!;
    }

    let mut bytesLen = labels.len();
    let mut retainedCapacity = arena.capacity();
    let mut retainedUsed = arena.used();

    debug::print(
        &"arena first_total={} capacity={} used={} retained_capacity={} retained_used={} scratch_len={}\n",
        &[
            &firstTotal,
            &firstCapacity,
            &firstUsed,
            &retainedCapacity,
            &retainedUsed,
            &bytesLen,
        ],
    ).?;

    !()
}

pub fn main(init: Init) ExitCode!() {
    run(init).?;
    !()
}
