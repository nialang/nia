using std::io;
using std::process;
using process::{Init, ExitCode};

struct Point {
    x: i32,
    y: i32,
}

extend Point {
    fun distanceSquared(&self) i32 {
        self.x * self.x + self.y * self.y
    }
}

enum Band: u8 {
    Low,
    Middle,
    High,
}

fun classify(score: i32) Band {
    match score {
        0..60 => .Low,
        60..90 => .Middle,
        _ => .High,
    }
}

fun sum(values: &[i32]) i32 {
    let mut total = 0;
    for &value in values {
        total += value;
    }
    total
}

pub fun main(init: Init) ExitCode!() {
    _ = init;

    let mut point = Point { x: 3, y: 4 };
    let distance = point.distanceSquared();
    let samples = [distance, 60, 95];
    let total = sum(&samples);
    let band = classify(samples[2]);
    defer point.x = point.x + 1;

    if total != 180 {
        return ExitCode(1)!;
    }
    match band {
        .High => {},
        _ => return ExitCode(2)!,
    }

    io::debugPrint("distance={} total={} score={}\n", [&distance, &total, &samples[2]]).?;
    !()
}
