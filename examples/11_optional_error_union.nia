extern fn printf(fmt: &u8, ...);

fn maybe_at(xs: &[i32], index: usize) ?i32 {
    if index < xs.len() {
        ?xs[index]
    } else {
        null
    }
}

fn lookup(xs: &[i32], index: usize) i32!i32 {
    switch maybe_at(xs, index) {
        ?value => !value,
        null => 1i32!,
    }
}

fn add_lookups(xs: &[i32], a: usize, b: usize) i32!i32 {
    var left = lookup(xs, a).?;
    var right = lookup(xs, b).?;
    !(left + right)
}

fn describe_optional(value: ?i32) &u8 {
    switch value {
        ?x => {
            if x > 0 {
                c"present-positive"
            } else {
                c"present"
            }
        },
        null => c"null",
    }
}

fn describe_result(value: i32!i32) i32 {
    switch value {
        !x => x,
        error! => 0 - error,
    }
}

fn main() i32 {
    var values: [3]i32 = [10, 20, 30];
    var slice = &values[..];
    var present = maybe_at(slice, 1);
    var missing = maybe_at(slice, 9);
    var sum_ok = add_lookups(slice, 0, 2);
    var sum_error = add_lookups(slice, 0, 9);

    printf(
        c"optional: present=%s missing=%s\n",
        describe_optional(present),
        describe_optional(missing),
    );
    printf(
        c"error union: ok=%d error=%d\n",
        describe_result(sum_ok),
        describe_result(sum_error),
    );
    0
}
