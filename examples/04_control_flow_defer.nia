extern fn printf(fmt: &u8, ...);

var cleanup_log: i32 = 0;

fn record_cleanup(tag: i32) void {
    // The decimal digits in `cleanup_log` make defer order visible.
    cleanup_log = cleanup_log * 10 + tag;
}

fn sign_name(value: i32) &u8 {
    // `if` is an expression. Every branch must produce the same type.
    if value < 0 {
        c"negative"
    } else if value == 0 {
        c"zero"
    } else {
        c"positive"
    }
}

fn clamp(value: i32, low: i32, high: i32) i32 {
    if value < low {
        low
    } else if value > high {
        high
    } else {
        value
    }
}

fn block_expression(seed: i32) i32 {
    // Blocks are expressions too. The final expression becomes the block value.
    var doubled_plus_one = {
        var doubled = seed * 2;
        doubled + 1
    };
    doubled_plus_one
}

fn range_sum(limit: i32) i32 {
    var total = 0;

    // `for name in start..end` iterates an exclusive range.
    for i in 0..limit {
        total += i;
    }

    // The loop binding may carry an explicit type when that matters.
    for i: i32 in 1..=3 {
        total += i;
    }

    total
}

fn sum_odd_below(limit: i32) i32 {
    var total = 0;
    for i in 0..limit {
        if i == 8 {
            break;
        }
        if (i % 2) == 0 {
            continue;
        }
        total += i;
    }
    total
}

fn factorial(n: i32) i32 {
    var value = n;
    var result = 1;

    // `while` is the usual condition-controlled loop.
    while value > 1 {
        result *= value;
        value -= 1;
    }

    result
}

fn first_multiple_at_least(start: i32, factor: i32) i32 {
    var candidate = start;

    // `loop` is an explicit infinite loop. Exit it with `break` or `return`.
    loop {
        if (candidate % factor) == 0 {
            return candidate;
        }
        candidate += 1;
    }

    candidate
}

fn grade(score: i32) i32 {
    // `switch` can match expression lists and integer ranges.
    switch score {
        0..60 => 0,
        60..=79 => 1,
        80..=89 => 2,
        90..=100 => 3,
        _ => -1,
    }
}

fn scoped_work(value: i32) i32 {
    // `defer` runs when the current block exits. Defers in one scope run in
    // reverse order, including when leaving through `return`, `break`, or
    // `continue`.
    defer record_cleanup(1);
    defer record_cleanup(2);

    if value < 0 {
        defer record_cleanup(3);
        return 0;
    }

    {
        defer record_cleanup(4);
        var local = block_expression(value);
        if local > 10 {
            return local;
        }
        local + 1
    }
}

fn defer_inside_loop() i32 {
    var total = 0;

    for i in 0..4 {
        defer record_cleanup(5);
        if i == 1 {
            continue;
        }
        if i == 3 {
            break;
        }
        total += i;
    }

    total
}

fn main() i32 {
    var sign = sign_name(-4);
    var clamped = clamp(42, 0, 10);
    var block_value = block_expression(5);
    var range_total = range_sum(5);
    var odd_total = sum_odd_below(10);
    var factorial_value = factorial(5);
    var multiple = first_multiple_at_least(17, 5);
    var grade_value = grade(87);
    var scoped_value = scoped_work(6);
    var negative_value = scoped_work(-1);
    var loop_value = defer_inside_loop();

    printf(
        c"control: sign=%s clamp=%d block=%d range=%d odd=%d factorial=%d multiple=%d grade=%d\n",
        sign,
        clamped,
        block_value,
        range_total,
        odd_total,
        factorial_value,
        multiple,
        grade_value,
    );
    printf(
        c"defer: scoped=%d negative=%d loop=%d cleanup_log=%d\n",
        scoped_value,
        negative_value,
        loop_value,
        cleanup_log,
    );
    0
}
