extern fn printf(fmt: &const u8, ...);

struct Point {
    x: i32,
    y: i32,
}

// `extern struct` uses C ABI-visible field layout. Plain `struct` uses Nia's
// layout rules, so use `extern struct` for data exchanged directly with C.
// See `docs/nia-abi.md` for the exact ABI layout rules.
extern struct CPoint {
    x: i32,
    y: i32,
}

// A union stores one active field at offset zero. Reading a different field is a
// low-level reinterpretation; the programmer owns that invariant.
union Bits {
    i: i32,
    f: f32,
}

enum Color: u8 {
    Red = 1,
    Green,
    Blue,
}

enum Flag: u32 {
    Read = 1,
    Write = 2,

    // `_` permits other backing values. Switches over this enum need a wildcard
    // arm because values such as `3u32 as Flag` are valid.
    _,
}

fn color_code(color: Color) i32 {
    switch color {
        Color::Red => 10,
        Color::Green => 20,
        Color::Blue => 30,
    }
}

fn flag_code(flag: Flag) i32 {
    switch flag {
        Flag::Read => 1,
        Flag::Write => 2,
        _ => 99,
    }
}

fn bucket_code(value: i32) i32 {
    switch value {
        0, 1 => 10,
        2..5 => 20,
        5..=7 => 30,
        _ => 99,
    }
}

fn point_sum(point: Point) i32 {
    point.x + point.y
}

fn main() i32 {
    // The usual struct literal form gets its type from the surrounding context:
    // binding annotations, function parameters, or return types.
    var point: Point = { x: 3, y: 4 };
    var argument_sum = point_sum({ x: 10, y: 20 });

    // Use an explicit type prefix when the literal should stand on its own.
    // A prefixed aggregate can also be used as a temporary reference target.
    var typed_point = Point { x: 8, y: 9 };
    var temp_point = &const Point { x: 1, y: 2 };
    point.x = point.x + 1;

    var c_point: CPoint = { x: 5, y: 6 };
    var bits: Bits = { i: 42 };
    var unnamed_flag: Flag = 3u32 as Flag;

    var total = point.x + point.y + argument_sum + typed_point.x + temp_point.y
        + c_point.x + c_point.y + bits.i
        + color_code(Color::Green)
        + flag_code(unnamed_flag)
        + bucket_code(6);

    printf(
        c"structs/unions/enums: point=(%d,%d) c_point=(%d,%d) bits=%d bucket=%d total=%d\n",
        point.x,
        point.y,
        c_point.x,
        c_point.y,
        bits.i,
        bucket_code(6),
        total,
    );
    0
}
