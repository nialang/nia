using std::io;
using std::process;
using std::slice;  // For .get() extension method
using process::{Init, ExitCode};

fun at(values: &[i32], index: usize) ?i32 {
    if values.get(index) is ?value {
        ?value.*
    } else {
        null
    }
}

fun requireAt(values: &[i32], index: usize) i32!i32 {
    if at(values, index) is ?value {
        !value
    } else {
        1i32!
    }
}

fun checkedPair(values: &[i32]) i32!i32 {
    let left = requireAt(values, 0).?;
    let right = requireAt(values, 2).?;
    !(left + right)
}

pub fun main(init: Init) ExitCode!() {
    _ = init;
    let values: [i32; 3] = [10, 20, 32];
    let mut pairSum = 0;

    if checkedPair(&values) is !sum {
        pairSum = sum;
    } else {
        return ExitCode(1)!;
    }
    if pairSum != 42 {
        return ExitCode(2)!;
    }
    if requireAt(&values, 9) is !value {
        _ = value;
        return ExitCode(3)!;
    }

    io::debugPrint(&"pair_sum={} missing=error\n", &[&pairSum]).?;
    !()
}
