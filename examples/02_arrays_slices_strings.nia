extern fn printf(fmt: &u8, ...);

// Arrays own a fixed number of elements. Slices are fat pointers over a range of
// array elements, and string literals are arrays of bytes/characters.

fn first(xs: &[i32]) i32 {
    xs[0]
}

fn fill_first(xs: &mut [i32], value: i32) i32 {
    xs[0] = value;
    xs[0]
}

fn sum3(xs: [3]i32) i32 {
    xs[0] + xs[1] + xs[2]
}

fn first_byte(ptr: &u8) i32 {
    ptr.* as i32
}

fn main() i32 {
    // Most aggregate literals use an expected type from a binding, parameter,
    // or return type.
    var xs: [4]i32 = [1, 2, 3, 4];
    var zeros: [4]i32 = [0; 4]; // Repeat initializer.
    var matrix: [2][3]i32 = [
        [1, 2, 3],
        [4, 5, 6],
    ];
    var direct_sum = sum3([10, 20, 30]);

    // Use an explicit array type prefix when the literal needs to carry its own
    // type, such as a temporary array that is immediately sliced.
    var temp_slice = &([3]i32[7, 8, 9])[..];

    var whole = &xs[..]; // Whole immutable slice.
    var mid = &xs[1..=2]; // Inclusive range slice.
    var writable = &mut zeros[..];

    // Slices expose their data pointer explicitly. `ptr[..]` forms a one-item
    // slice from a pointer, which is useful at C boundaries and low-level code.
    var ptr = mid.get_ptr_read();
    var single = &ptr[..];

    // String literal forms are deliberately explicit:
    // - `"..."` is text.
    // - `b"..."` is bytes.
    // - `c"..."` is null-terminated bytes for C APIs such as printf.
    // Adjacent literals concatenate at source level, not at runtime.
    let name = c"nia";
    var text = "ni" "a";
    var bytes = b"ni" b"a";

    // Multi-line byte/C-string literals keep the prefix on the first line; each
    // continuation line starts with `\`.
    var multi =
       c\\hello
        \\nia
    ;

    var whole_first = first(whole);
    var mid_first = first(mid);
    var filled_first = fill_first(writable, 9);
    var matrix_value = matrix[1][2];
    var name_first = first_byte(&name[0]);
    var multi_first = first_byte(&multi[0]);

    printf(
        c"arrays: xs0=%d mid0=%d filled0=%d matrix[1][2]=%d sum=%d\n",
        whole_first,
        mid_first,
        filled_first,
        matrix_value,
        direct_sum,
    );
    printf(
        c"slices: whole_len=%d mid_len=%d single_len=%d ptr_first=%d\n",
        whole.len() as i32,
        mid.len() as i32,
        single.len() as i32,
        first(single) + first(temp_slice),
    );
    printf(
        c"strings: name=%s text_len=%d bytes_len=%d first=%d multi_first=%d\n",
        &name[0],
        text.len() as i32,
        bytes.len() as i32,
        name_first,
        multi_first,
    );
    0
}
