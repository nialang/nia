using std;
using std::debug;
using std::mem;
using std::process;
using process::{Init, ExitCode};

fn run(init: Init) mem::Error!void {
    _ = init;

    var page = mem::PageAllocator::init();
    // The general-purpose allocator is the usual heap-backed allocator for
    // mixed lifetimes. The page allocator is its low-level backing source.
    var gpa = mem::GeneralPurposeAllocator::init(&mut page);
    // .ok() turns a leak report into mem::Error so examples fail on leaks.
    defer gpa.deinit().?.ok().?;

    var values = std::ArrayList[i32]::init();
    // Register container cleanup after allocator cleanup so it runs first.
    defer values.deinit(&mut gpa).?;

    values.push(&mut gpa, 10).?;
    values.push(&mut gpa, 20).?;
    values.push(&mut gpa, 30).?;

    var total = 0;
    for &value in values.iter() {
        total += value;
    }

    var used = gpa.query_used();
    var capacity = gpa.query_capacity();

    debug::print("values={} total={} heap_used={} heap_capacity={}\n", [
        &values,
        &total,
        &used,
        &capacity,
    ]);
    !{}
}

pub fn main(init: Init) ExitCode!void {
    run(init).exit().?;
    !{}
}
