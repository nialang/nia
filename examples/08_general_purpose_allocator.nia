using std;
using std::debug;
using std::fmt;
using std::mem;
using std::process;
using process::{Init, ExitCode};

fn run(init: Init) ExitCode!void {
    _ = init;

    let mut page = mem::PageAllocator::init();
    // The general-purpose allocator is the usual heap-backed allocator for
    // mixed lifetimes. The page allocator is its low-level backing source.
    let gpa = &mut mem::GeneralPurposeAllocator::init(&mut page);
    // .ok() turns a leak report into mem::Error so examples fail on leaks.
    defer gpa.deinit().ok().exit().?;

    let mut values = std::ArrayList[i32]::init();
    // Register container cleanup after allocator cleanup so it runs first.
    defer values.deinit(gpa).exit().?;

    // ArrayList asks for an allocator at each operation. Passing the handle
    // makes it explicit that the container uses this allocator's storage but
    // does not own the allocator itself.
    values.push(gpa, 10).exit().?;
    values.push(gpa, 20).exit().?;
    values.push(gpa, 30).exit().?;

    let mut total = 0;
    for &value in values {
        total += value;
    }

    let mut used = gpa.used();
    let mut capacity = gpa.capacity();

    debug::print(&"values={} total={} heap_used={} heap_capacity={}\n", &[
        &values,
        &total,
        &used,
        &capacity,
    ]).exit().?;
    !{}
}

pub fn main(init: Init) ExitCode!void {
    run(init).?;
    !{}
}
