// Formatted output through a buffered stdout writer: width, fill, precision,
// sign, alternate forms, and pointer formatting.
using std::fmt::template;
using std::io;
using std::process;

pub fun main(init: process::Init) process::ExitCode!() {
    _ = init;
    let mut buffer: [u8; 128] = [0; 128];
    let mut stdout = io::FileWriter::stdout(buffer);
    let name = "nia";
    let answer: i32 = 42;
    let byte: u8 = 171;
    let ptr = &answer;

    // `&ptr` formats the pointer itself; `ptr` would format the value it points to.
    stdout.print(
        "name={_>6.3} answer={+05} hex={#04x} ptr={p}\n",
        [name, answer, byte, &ptr],
    ).?;
    stdout.flush().?;
    !()
}
