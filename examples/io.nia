using std::fmt;
using std::io;
using std::process;
using process::{Init, ExitCode};

pub fn main(init: Init) ExitCode!() {
    let mut buffer: [u8; 128] = [0; 128];
    let mut stdout = io::FileWriter::stdout(&mut buffer);
    let name = "nia";
    let answer: i32 = 42;
    let byte: u8 = 171;
    let ptr = &answer;

    stdout.print(
        &"name={:_>6.3} answer={:+05} hex={:#04x} ptr={:p}\n",
        &[&name, &answer, &byte, &ptr],
    ).?;
    stdout.flush().?;
    !()
}
