// Closures with explicit captures, callable views and function pointers,
// parameter inference from use, and lazy iterator adapters.
using std::io;
using std::process;

// `&Fun(i32) i32` is a non-owning view of any closure with that signature.
fun applyTwice(f: &Fun(i32) i32, value: i32) i32 {
    f(f(value))
}

// A generic callable parameter: the closure's result type determines `T`.
fun callSupplier[T](supplier: &Fun() T) T {
    supplier()
}

fun double(x: i32) i32 {
    x * 2
}

pub fun main(init: process::Init) process::ExitCode!() {
    _ = init;

    // Parameter types are inferred from how a closure is used.
    let increment = \x -> x + 1;

    // Captures are explicit: by value, read-only pointer, or writable pointer.
    let step = 10;
    let addStep = \[step] x -> x + step;
    let mut calls = 0;
    let counted = \[&mut calls] x -> {
        calls.* += 1;
        x
    };

    let a = applyTwice(increment, 0);
    let b = applyTwice(addStep, 1);
    let c = applyTwice(counted, 5);

    // A named function converts to a function pointer where one is expected.
    let pointer: &fun(i32) i32 = double;
    let d = pointer(21);

    let answer = callSupplier(\-> 42u64);

    // `map` is lazy; `fold` and `position` consume the iterator.
    let squares = (1..5).iter().map(\value -> value * value);
    let squareTotal = squares.fold(0, \total, value -> total + value);
    let firstLarge = (1..10).iter().position(\value -> value * value > 20);
    let index = if firstLarge is ?index { index } else { 0 };

    io::debugPrint("a={} b={} c={} calls={} d={} answer={}\n", [
        a, b, c, calls, d, answer,
    ]).?;
    io::debugPrint("squares={} firstLarge={}\n", [squareTotal, index]).?;
    !()
}
