extern fn printf(fmt: &const u8, ...);

struct Pair[T, U] {
    first: T,
    second: U,
}

struct Box[T] {
    value: T,
}

// Generic `extend` blocks add methods to every instance of `Box[T]`.
extend[T] Box[T] {
    fn get(&const self) T {
        self.value
    }

    // Method-level generics are independent from the receiver type parameter.
    fn replace[U](&const self, value: U) U {
        value
    }

    fn make(value: T) Box[T] {
        { value: value }
    }
}

// Structural extension targets can be concrete types, including pointer types.
extend &i32 {
    fn is_null(self) bool {
        self as usize == 0
    }
}

fn id[T](value: T) T {
    value
}

fn swap_i32_bool(pair: Pair[i32, bool]) Pair[bool, i32] {
    { first: pair.second, second: pair.first }
}

fn box_value(box: Box[i32]) i32 {
    box.value
}

fn main() i32 {
    var pair: Pair[i32, bool] = { first: 7, second: true };
    var swapped = swap_i32_bool(pair);
    var box = Box[i32]::make(swapped.second);
    var argument_value = box_value({ value: 19 });

    // Generic literals also normally lean on expected type. Use an explicit
    // prefix when the literal stands alone or is inside a typed array literal.
    var literal_box = Box[i32] { value: 11 };
    var box_row = [2]Box[i32][
        Box[i32] { value: 13 },
        Box[i32] { value: 17 },
    ];

    // Associated method paths can be used as function pointers.
    var method_ptr: &const fn(&const Box[i32]) i32 = &const Box[i32]::get;
    var ptr: &i32 = 0usize as &i32;
    var null_flag = if ptr.is_null() { 1 } else { 0 };

    printf(
        c"generics/methods: get=%d method_ptr=%d replace=%d null=%d\n",
        id[i32](box.get()) + argument_value + literal_box.get() + box_row[1].get(),
        method_ptr(&const box),
        box.replace[i32](5),
        null_flag,
    );
    0
}
