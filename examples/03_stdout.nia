import std.fmt;
import std.io;
import std.process;
import std.result;
using process::{Init, ExitCode, io_exit};

pub fn main(init: Init) ExitCode!void {
    var buffer: [128]u8 = [_]u8[0; 128];
    var stdout = io::FileWriter::stdout(init.io(), buffer);

    stdout.print("nia stdout example\n", []).map_err[ExitCode](&io_exit).?;
    stdout.flush().map_err[ExitCode](&io_exit).?;

    !{}
}
