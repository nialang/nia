import std.fmt;
import std.io;
import std.process;
import std.result;

pub fn main(init: process::Init) process::ExitCode!void {
    var buffer: [128]u8 = [_]u8[0; 128];
    var stdout = io::FileWriter::stdout(init.io(), &mut buffer[..]);

    stdout.print("nia stdout example\n", []).map_err[process::ExitCode](&process::io_exit).?;
    stdout.flush().map_err[process::ExitCode](&process::io_exit).?;

    !{}
}
