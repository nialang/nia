using std::fmt;
using std::io;
using std::process;
using process::{Init, ExitCode};

pub fn main(init: Init) ExitCode!void {
    let mut buffer: [128]u8 = [_]u8[0; 128];
    // Application stdout goes through std::io. The writer keeps pointers to
    // the runtime I/O state and caller-provided scratch buffer.
    let mut stdout = io::FileWriter::stdout(init.io(), &mut buffer);
    let name = "nia";
    let answer = 42i32;
    let byte = 171u8;
    let ptr = &answer;

    // .exit().? maps std I/O errors into process exit errors and propagates.
    stdout.print(
        &"name={:_>6.3} answer={:+05} hex={:#04x} ptr={:p}\n",
        &[&name, &answer, &byte, &ptr],
    ).exit().?;
    stdout.flush().exit().?;

    !{}
}
