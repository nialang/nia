using std::fmt;
using std::io;
using std::process;
using process::{Init, ExitCode};

pub fn main(init: Init) ExitCode!void {
    var buffer: [128]u8 = [_]u8[0; 128];
    // Application stdout goes through std::io. The writer borrows both the
    // runtime I/O state and caller-provided scratch buffer.
    var stdout = io::FileWriter::stdout(init.io(), buffer);

    // .exit().? maps std I/O errors into process exit errors and propagates.
    stdout.print("nia stdout example\n", []).exit().?;
    stdout.flush().exit().?;

    !{}
}
