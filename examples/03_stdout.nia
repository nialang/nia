using std::fmt;
using std::io;
using std::process;
using process::{Init, ExitCode};

pub fn main(init: Init) ExitCode!void {
    var buffer: [128]u8 = [_]u8[0; 128];
    var stdout = io::FileWriter::stdout(init.io(), buffer);

    stdout.print("nia stdout example\n", []).exit().?;
    stdout.flush().exit().?;

    !{}
}
