using std::debug;
using std::fmt;
using std::process;
using std::slice;
using process::{Init, ExitCode, exit};

fn at(values: &[i32], index: usize) ?i32 {
    if values.get(index) is ?value {
        // Checked slice access returns a reference; ? constructs a copied value.
        ?value.*
    } else {
        null
    }
}

fn require_at(values: &[i32], index: usize) i32!i32 {
    switch at(values, index) {
        ?value => {
            // !value constructs the success side of an error union.
            !value
        },
        null => {
            // error! constructs the error side; here the error type is i32.
            1i32!
        },
    }
}

fn checked_pair(values: &[i32]) i32!i32 {
    // .? unwraps the success side or propagates the error side.
    let left = require_at(values, 0).?;
    let right = require_at(values, 2).?;
    !(left + right)
}

pub fn main(init: Init) ExitCode!() {
    _ = init;

    let mut values: [3]i32 = [10, 20, 32];
    let mut pair_sum = 0;
    // if-pattern is the concise form for one refutable success path.
    if checked_pair(&values) is !sum {
        pair_sum = sum;
        if sum != 42 {
            return exit(1)!;
        }
    } else {
        return exit(2)!;
    }

    if require_at(&values, 9) is !value {
        _ = value;
        return exit(3)!;
    }

    debug::print(&"optional/error pair_sum={} missing=error\n", &[&pair_sum]).?;

    !()
}
