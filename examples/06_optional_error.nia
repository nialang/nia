using std::debug;
using std::process;
using process::{Init, ExitCode, exit};

fn at(values: &[i32], index: usize) ?i32 {
    if index < values.len() {
        // ?value constructs the present side of an optional.
        ?values[index]
    } else {
        null
    }
}

fn require_at(values: &[i32], index: usize) i32!i32 {
    switch at(values, index) {
        // !value constructs the success side of an error union.
        ?value => !value,
        // error! constructs the error side; here the error type is i32.
        null => 1i32!,
    }
}

fn checked_pair(values: &[i32]) i32!i32 {
    // .? unwraps the success side or propagates the error side.
    let left = require_at(values, 0).?;
    let right = require_at(values, 2).?;
    !(left + right)
}

pub fn main(init: Init) ExitCode!void {
    _ = init;

    var values: [3]i32 = [10, 20, 32];
    var pair_sum = 0;
    // switch can destructure both success and error-union cases explicitly.
    switch checked_pair(&values) {
        !sum => {
            pair_sum = sum;
            if sum != 42 {
                return exit(1)!;
            }
        },
        error! => return exit(2)!,
    }

    switch require_at(&values, 9usize) {
        !value => {
            _ = value;
            return exit(3)!;
        },
        error! => _ = error,
    }

    debug::print("optional/error pair_sum={} missing=error\n", &[&pair_sum]);

    !{}
}
