import std.process;

fn at(values: &[i32], index: usize) ?i32 {
    if index < values.len() {
        ?values[index]
    } else {
        null
    }
}

fn require_at(values: &[i32], index: usize) i32!i32 {
    switch at(values, index) {
        ?value => !value,
        null => 1i32!,
    }
}

fn checked_pair(values: &[i32]) i32!i32 {
    let left = require_at(values, 0usize).?;
    let right = require_at(values, 2usize).?;
    !(left + right)
}

pub fn main(init: process::Init) process::ExitCode!void {
    _ = init;

    var values: [3]i32 = [10, 20, 32];
    switch checked_pair(&values[..]) {
        !sum => {
            if sum != 42 {
                return process::ExitCode::init(1)!;
            }
        },
        error! => return process::ExitCode::init(2)!,
    }

    switch require_at(&values[..], 9usize) {
        !value => {
            _ = value;
            return process::ExitCode::init(3)!;
        },
        error! => _ = error,
    }

    !{}
}
