using pkg::abi;
using std::fs;
using std::io;
using std::mem;
using std::process;

pub(pkg) struct BuildPlan {
    package_name_start: usize,
    package_name_len: usize,
    exe_name_start: usize,
    exe_name_len: usize,
    exe_root_start: usize,
    exe_root_len: usize,
    action: StepAction,
    action_path_start: usize,
    action_path_len: usize,
}

pub(pkg) enum StepAction: i32 {
    BuildExecutable = 1,
    CheckExecutable = 2,
    ObjectDirectory = 3,
    InstallExecutable = 4,
}

enum EntryKind: i32 {
    Package = 1,
    Executable = 2,
    LibraryPath = 3,
    Library = 4,
    Rpath = 5,
    DynamicLinker = 6,
    Step = 7,
    StepBuildExecutable = 8,
    DefaultStep = 9,
    StepCheckExecutable = 10,
    StepObjectDirectory = 11,
    StepInstallExecutable = 12,
}

extend BuildPlan {
    pub(pkg) fn package_name_start(&self) usize {
        self.package_name_start
    }

    pub(pkg) fn package_name_len(&self) usize {
        self.package_name_len
    }

    pub(pkg) fn exe_name_start(&self) usize {
        self.exe_name_start
    }

    pub(pkg) fn exe_name_len(&self) usize {
        self.exe_name_len
    }

    pub(pkg) fn exe_root_start(&self) usize {
        self.exe_root_start
    }

    pub(pkg) fn exe_root_len(&self) usize {
        self.exe_root_len
    }

    pub(pkg) fn action(&self) StepAction {
        self.action
    }

    pub(pkg) fn action_path_start(&self) usize {
        self.action_path_start
    }

    pub(pkg) fn action_path_len(&self) usize {
        self.action_path_len
    }
}

pub(pkg) fn parse(stderr: &mut io::FileWriter, graph: &[u8], requested_step: &[u8]) process::ExitCode!BuildPlan {
    var package_name_start = 0usize;
    var package_name_len = 0usize;
    var exe_name_start = 0usize;
    var exe_name_len = 0usize;
    var exe_root_start = 0usize;
    var exe_root_len = 0usize;
    var default_step_start = 0usize;
    var default_step_len = 0usize;
    var selected = SelectedStepState::init();
    var has_package = false;
    var has_executable = false;
    var has_default_step = false;
    var index = 0usize;
    while index < graph.len() {
        let line_end = if let ?value = find_byte(graph, index, b'\n') {
            value
        } else null {
            graph.len()
        };
        let line = &graph[index..line_end];
        if line.len() != 0 {
            let parsed = parse_line(stderr, line).?;
            switch parsed.kind() {
                EntryKind::Package => {
                    if has_package {
                        stderr.print("paw: build graph has duplicate package entries\n", &[]).exit().?;
                        return process::exit(2)!;
                    }
                    has_package = true;
                    package_name_start = index + parsed.first_value_start();
                    package_name_len = parsed.first_value_len();
                },
                EntryKind::Executable => {
                    if has_executable {
                        stderr.print("paw: build graph has multiple executables\n", &[]).exit().?;
                        return process::exit(2)!;
                    }
                    has_executable = true;
                    exe_name_start = index + parsed.first_value_start();
                    exe_name_len = parsed.first_value_len();
                    exe_root_start = index + parsed.second_value_start();
                    exe_root_len = parsed.second_value_len();
                },
                EntryKind::DefaultStep => {
                    if has_default_step {
                        stderr.print("paw: build graph has duplicate default steps\n", &[]).exit().?;
                        return process::exit(2)!;
                    }
                    has_default_step = true;
                    default_step_start = index + parsed.first_value_start();
                    default_step_len = parsed.first_value_len();
                },
                EntryKind::StepBuildExecutable, EntryKind::StepCheckExecutable, EntryKind::StepObjectDirectory, EntryKind::StepInstallExecutable => {
                    let step = &line[parsed.first_value_start()..(parsed.first_value_start() + parsed.first_value_len())];
                    if requested_step.len() != 0usize and mem::equal[u8](step, requested_step) {
                        selected.record_action(stderr, index, parsed).?;
                    }
                },
                EntryKind::Step => {
                    if requested_step.len() != 0usize {
                        let step = &line[parsed.first_value_start()..(parsed.first_value_start() + parsed.first_value_len())];
                        if mem::equal[u8](step, requested_step) {
                            selected.record_declaration();
                        }
                    }
                },
                EntryKind::LibraryPath, EntryKind::Library, EntryKind::Rpath, EntryKind::DynamicLinker => {},
            };
        }
        index = line_end + 1;
    }
    if package_name_len == 0 {
        stderr.print("paw: build graph has no package\n", &[]).exit().?;
        return process::exit(2)!;
    }
    if exe_name_len == 0usize or exe_root_len == 0usize {
        stderr.print("paw: build graph has no executable\n", &[]).exit().?;
        return process::exit(2)!;
    }
    if default_step_len == 0usize {
        stderr.print("paw: build graph has no default step\n", &[]).exit().?;
        return process::exit(2)!;
    }
    if requested_step.len() == 0usize {
        var scan = 0usize;
        let default_step = &graph[default_step_start..(default_step_start + default_step_len)];
        while scan < graph.len() {
            let line_end = if let ?value = find_byte(graph, scan, b'\n') {
                value
            } else null {
                graph.len()
            };
            let line = &graph[scan..line_end];
            if line.len() != 0 {
                let parsed = parse_line(stderr, line).?;
                if parsed.kind().is_step_action() {
                    let step = &line[parsed.first_value_start()..(parsed.first_value_start() + parsed.first_value_len())];
                    if mem::equal[u8](step, default_step) {
                        selected.record_action(stderr, scan, parsed).?;
                    }
                } else if parsed.kind() == EntryKind::Step {
                    let step = &line[parsed.first_value_start()..(parsed.first_value_start() + parsed.first_value_len())];
                    if mem::equal[u8](step, default_step) {
                        selected.record_declaration();
                    }
                }
            }
            scan = line_end + 1;
        }
    }
    let action = selected.action(stderr).?;
    if selected.action_exe_len() == 0usize {
        stderr.print("paw: requested step action has no executable\n", &[]).exit().?;
        return process::exit(2)!;
    }
    if selected.declarations() == 0usize {
        stderr.print("paw: requested step is not declared\n", &[]).exit().?;
        return process::exit(2)!;
    }
    if selected.declarations() != 1usize {
        stderr.print("paw: build graph has duplicate step declarations\n", &[]).exit().?;
        return process::exit(2)!;
    }
    let exe_name = &graph[exe_name_start..(exe_name_start + exe_name_len)];
    let selected_step_exe = &graph[selected.action_exe_start()..(selected.action_exe_start() + selected.action_exe_len())];
    if not mem::equal[u8](exe_name, selected_step_exe) {
        stderr.print("paw: requested step references unknown executable\n", &[]).exit().?;
        return process::exit(2)!;
    }
    if action == StepAction::InstallExecutable {
        let install_path = &graph[selected.action_path_start()..(selected.action_path_start() + selected.action_path_len())];
        validate_install_path(stderr, install_path).?;
    }
    !{
        package_name_start: package_name_start,
        package_name_len: package_name_len,
        exe_name_start: exe_name_start,
        exe_name_len: exe_name_len,
        exe_root_start: exe_root_start,
        exe_root_len: exe_root_len,
        action: action,
        action_path_start: selected.action_path_start(),
        action_path_len: selected.action_path_len(),
    }
}

struct SelectedStepState {
    declarations: usize,
    action_step_len: usize,
    action_exe_start: usize,
    action_exe_len: usize,
    action_path_start: usize,
    action_path_len: usize,
    action: ?StepAction,
}

extend SelectedStepState {
    fn init() SelectedStepState {
        {
            declarations: 0usize,
            action_step_len: 0usize,
            action_exe_start: 0usize,
            action_exe_len: 0usize,
            action_path_start: 0usize,
            action_path_len: 0usize,
            action: null,
        }
    }

    fn record_declaration(&mut self) void {
        self.declarations += 1usize;
    }

    fn record_action(&mut self, stderr: &mut io::FileWriter, line_start: usize, parsed: ParsedLine) process::ExitCode!void {
        if self.action_step_len != 0usize {
            stderr.print("paw: build graph has duplicate step actions\n", &[]).exit().?;
            return process::exit(2)!;
        }
        self.action_step_len = parsed.first_value_len();
        self.action_exe_start = line_start + parsed.second_value_start();
        self.action_exe_len = parsed.second_value_len();
        self.action_path_start = line_start + parsed.third_value_start();
        self.action_path_len = parsed.third_value_len();
        self.action = parsed.kind().step_action();
        !{}
    }

    fn action(&self, stderr: &mut io::FileWriter) process::ExitCode!StepAction {
        if let ?value = self.action {
            !value
        } else null {
            stderr.print("paw: requested step has no action\n", &[]).exit().?;
            return process::exit(2)!;
        }
    }

    fn declarations(&self) usize {
        self.declarations
    }

    fn action_exe_start(&self) usize {
        self.action_exe_start
    }

    fn action_exe_len(&self) usize {
        self.action_exe_len
    }

    fn action_path_start(&self) usize {
        self.action_path_start
    }

    fn action_path_len(&self) usize {
        self.action_path_len
    }
}

fn validate_install_path(stderr: &mut io::FileWriter, path: &[u8]) process::ExitCode!void {
    if path.len() == 0usize or path[0] == b'/' {
        stderr.print("paw: invalid install path\n", &[]).exit().?;
        return process::exit(2)!;
    }
    var component_start = 0usize;
    var index = 0usize;
    while index <= path.len() {
        if index == path.len() or path[index] == b'/' {
            let component = &path[component_start..index];
            if component.len() == 0usize or is_dot_component(component) or is_dot_dot_component(component) {
                stderr.print("paw: invalid install path\n", &[]).exit().?;
                return process::exit(2)!;
            }
            component_start = index + 1usize;
        } else if path[index] == 0u8 {
            stderr.print("paw: invalid install path\n", &[]).exit().?;
            return process::exit(2)!;
        }
        index += 1usize;
    }
    !{}
}

fn is_dot_component(component: &[u8]) bool {
    component.len() == 1usize and component[0] == b'.'
}

fn is_dot_dot_component(component: &[u8]) bool {
    component.len() == 2usize and component[0] == b'.' and component[1] == b'.'
}

struct ParsedLine {
    kind: EntryKind,
    first_value_start: usize,
    first_value_len: usize,
    second_value_start: usize,
    second_value_len: usize,
    third_value_start: usize,
    third_value_len: usize,
}

extend ParsedLine {
    fn kind(&self) EntryKind {
        self.kind
    }

    fn first_value_start(&self) usize {
        self.first_value_start
    }

    fn first_value_len(&self) usize {
        self.first_value_len
    }

    fn second_value_start(&self) usize {
        self.second_value_start
    }

    fn second_value_len(&self) usize {
        self.second_value_len
    }

    fn third_value_start(&self) usize {
        self.third_value_start
    }

    fn third_value_len(&self) usize {
        self.third_value_len
    }
}

fn parse_line(stderr: &mut io::FileWriter, line: &[u8]) process::ExitCode!ParsedLine {
    let first_tab = if let ?value = find_byte(line, 0, b'\t') {
        value
    } else null {
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    };
    let kind = if let ?value = EntryKind::parse(&line[0..first_tab]) {
        value
    } else null {
        stderr.print("paw: unknown build graph entry\n", &[]).exit().?;
        return process::exit(2)!;
    };
    let second_tab = find_byte(line, first_tab + 1, b'\t');
    switch kind {
        EntryKind::Package, EntryKind::Executable => parse_two_field_line(stderr, line, kind, first_tab, second_tab),
        EntryKind::Step, EntryKind::DefaultStep => parse_one_field_line(stderr, line, kind, first_tab, second_tab),
        EntryKind::StepBuildExecutable, EntryKind::StepCheckExecutable, EntryKind::StepObjectDirectory => parse_two_field_line(stderr, line, kind, first_tab, second_tab),
        EntryKind::StepInstallExecutable => parse_three_field_line(stderr, line, kind, first_tab, second_tab),
        EntryKind::LibraryPath, EntryKind::Library, EntryKind::Rpath => parse_two_field_line(stderr, line, kind, first_tab, second_tab),
        EntryKind::DynamicLinker => parse_dynamic_linker_line(stderr, line, kind, first_tab, second_tab),
    }
}

fn parse_one_field_line(
    stderr: &mut io::FileWriter,
    line: &[u8],
    kind: EntryKind,
    first_tab: usize,
    second_tab: ?usize,
) process::ExitCode!ParsedLine {
    if let ?extra = second_tab {
        _ = extra;
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    }
    !{
        kind: kind,
        first_value_start: first_tab + 1,
        first_value_len: line.len() - first_tab - 1,
        second_value_start: line.len(),
        second_value_len: 0usize,
        third_value_start: line.len(),
        third_value_len: 0usize,
    }
}

fn parse_two_field_line(
    stderr: &mut io::FileWriter,
    line: &[u8],
    kind: EntryKind,
    first_tab: usize,
    second_tab: ?usize,
) process::ExitCode!ParsedLine {
    let second = if let ?value = second_tab {
        value
    } else null {
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    };
    if let ?extra = find_byte(line, second + 1, b'\t') {
        _ = extra;
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    }
    !{
        kind: kind,
        first_value_start: first_tab + 1,
        first_value_len: second - first_tab - 1,
        second_value_start: second + 1,
        second_value_len: line.len() - second - 1,
        third_value_start: line.len(),
        third_value_len: 0usize,
    }
}

fn parse_three_field_line(
    stderr: &mut io::FileWriter,
    line: &[u8],
    kind: EntryKind,
    first_tab: usize,
    second_tab: ?usize,
) process::ExitCode!ParsedLine {
    let second = if let ?value = second_tab {
        value
    } else null {
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    };
    let third = if let ?value = find_byte(line, second + 1, b'\t') {
        value
    } else null {
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    };
    if let ?extra = find_byte(line, third + 1, b'\t') {
        _ = extra;
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    }
    !{
        kind: kind,
        first_value_start: first_tab + 1,
        first_value_len: second - first_tab - 1,
        second_value_start: second + 1,
        second_value_len: third - second - 1,
        third_value_start: third + 1,
        third_value_len: line.len() - third - 1,
    }
}

fn parse_dynamic_linker_line(
    stderr: &mut io::FileWriter,
    line: &[u8],
    kind: EntryKind,
    first_tab: usize,
    second_tab: ?usize,
) process::ExitCode!ParsedLine {
    let second = if let ?value = second_tab {
        value
    } else null {
        stderr.print("paw: invalid dynamic linker entry\n", &[]).exit().?;
        return process::exit(2)!;
    };
    let value = &line[(second + 1)..line.len()];
    if not mem::equal[u8](value, b"auto") and not mem::equal[u8](value, b"none") {
        if value.len() < 6usize or not mem::equal[u8](&value[0..5], b"path\t") {
            stderr.print("paw: invalid dynamic linker entry\n", &[]).exit().?;
            return process::exit(2)!;
        }
        return !{
            kind: kind,
            first_value_start: first_tab + 1,
            first_value_len: second - first_tab - 1,
            second_value_start: second + 1,
            second_value_len: line.len() - second - 1,
            third_value_start: line.len(),
            third_value_len: 0usize,
        };
    }
    if let ?extra = find_byte(line, second + 1, b'\t') {
        _ = extra;
        stderr.print("paw: invalid dynamic linker entry\n", &[]).exit().?;
        return process::exit(2)!;
    }
    !{
        kind: kind,
        first_value_start: first_tab + 1,
        first_value_len: second - first_tab - 1,
        second_value_start: second + 1,
        second_value_len: line.len() - second - 1,
        third_value_start: line.len(),
        third_value_len: 0usize,
    }
}

extend EntryKind {
    fn parse(text: &[u8]) ?EntryKind {
        if mem::equal[u8](text, b"package") {
            ?EntryKind::Package
        } else if mem::equal[u8](text, b"executable") {
            ?EntryKind::Executable
        } else if mem::equal[u8](text, b"library-path") {
            ?EntryKind::LibraryPath
        } else if mem::equal[u8](text, b"library") {
            ?EntryKind::Library
        } else if mem::equal[u8](text, b"rpath") {
            ?EntryKind::Rpath
        } else if mem::equal[u8](text, b"dynamic-linker") {
            ?EntryKind::DynamicLinker
        } else if mem::equal[u8](text, b"step") {
            ?EntryKind::Step
        } else if mem::equal[u8](text, b"step-build-executable") {
            ?EntryKind::StepBuildExecutable
        } else if mem::equal[u8](text, b"step-check-executable") {
            ?EntryKind::StepCheckExecutable
        } else if mem::equal[u8](text, b"step-object-directory") {
            ?EntryKind::StepObjectDirectory
        } else if mem::equal[u8](text, b"step-install-executable") {
            ?EntryKind::StepInstallExecutable
        } else if mem::equal[u8](text, b"default-step") {
            ?EntryKind::DefaultStep
        } else {
            null
        }
    }

    fn is_step_action(self) bool {
        self == EntryKind::StepBuildExecutable or self == EntryKind::StepCheckExecutable or self == EntryKind::StepObjectDirectory or self == EntryKind::StepInstallExecutable
    }

    fn step_action(self) ?StepAction {
        switch self {
            EntryKind::StepBuildExecutable => ?StepAction::BuildExecutable,
            EntryKind::StepCheckExecutable => ?StepAction::CheckExecutable,
            EntryKind::StepObjectDirectory => ?StepAction::ObjectDirectory,
            EntryKind::StepInstallExecutable => ?StepAction::InstallExecutable,
            EntryKind::Package, EntryKind::Executable, EntryKind::LibraryPath, EntryKind::Library, EntryKind::Rpath, EntryKind::DynamicLinker, EntryKind::Step, EntryKind::DefaultStep => null,
        }
    }
}

pub(pkg) fn apply_link_options(
    stderr: &mut io::FileWriter,
    graph: &[u8],
    root: &[u8],
    executable_name: &[u8],
    options: &abi::LinkOptions,
) process::ExitCode!void {
    var index = 0usize;
    while index < graph.len() {
        let line_end = if let ?value = find_byte(graph, index, b'\n') {
            value
        } else null {
            graph.len()
        };
        let line = &graph[index..line_end];
        if line.len() != 0 {
            apply_link_option_line(stderr, line, root, executable_name, options).?;
        }
        index = line_end + 1;
    }
    !{}
}

fn apply_link_option_line(
    stderr: &mut io::FileWriter,
    line: &[u8],
    root: &[u8],
    executable_name: &[u8],
    options: &abi::LinkOptions,
) process::ExitCode!void {
    let first_tab = if let ?value = find_byte(line, 0, b'\t') {
        value
    } else null {
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    };
    let kind = if let ?value = EntryKind::parse(&line[0..first_tab]) {
        value
    } else null {
        stderr.print("paw: unknown build graph entry\n", &[]).exit().?;
        return process::exit(2)!;
    };
    if kind == EntryKind::LibraryPath or kind == EntryKind::Library or kind == EntryKind::Rpath or kind == EntryKind::DynamicLinker {
        if not artifact_matches(line, first_tab, executable_name) {
            stderr.print("paw: build graph references unknown artifact\n", &[]).exit().?;
            return process::exit(2)!;
        }
    }
    switch kind {
        EntryKind::Package, EntryKind::Executable, EntryKind::Step, EntryKind::StepBuildExecutable, EntryKind::StepCheckExecutable, EntryKind::StepObjectDirectory, EntryKind::StepInstallExecutable, EntryKind::DefaultStep => !{},
        EntryKind::LibraryPath => {
            var path_storage: [4096]u8 = [0; 4096];
            apply_single_field_link_option(
                stderr,
                options.add_library_path(root_relative_path(root, require_artifact_payload(stderr, line, first_tab).?, &mut path_storage).?),
                b"paw: failed to add native library path",
            )
        },
        EntryKind::Library => apply_single_field_link_option(
            stderr,
            options.add_library(require_artifact_payload(stderr, line, first_tab).?),
            b"paw: failed to add native library",
        ),
        EntryKind::Rpath => {
            var path_storage: [4096]u8 = [0; 4096];
            apply_single_field_link_option(
                stderr,
                options.add_rpath(root_relative_path(root, require_artifact_payload(stderr, line, first_tab).?, &mut path_storage).?),
                b"paw: failed to add runtime library path",
            )
        },
        EntryKind::DynamicLinker => apply_dynamic_linker(stderr, line, first_tab, root, options),
    }
}

fn artifact_matches(line: &[u8], first_tab: usize, executable_name: &[u8]) bool {
    let second_tab = if let ?value = find_byte(line, first_tab + 1, b'\t') {
        value
    } else null {
        return false;
    };
    mem::equal[u8](&line[(first_tab + 1)..second_tab], executable_name)
}

fn artifact_payload(line: &[u8], first_tab: usize) ?&[u8] {
    let second_tab = if let ?value = find_byte(line, first_tab + 1, b'\t') {
        value
    } else null {
        return null;
    };
    ?&line[(second_tab + 1)..line.len()]
}

fn require_artifact_payload(stderr: &mut io::FileWriter, line: &[u8], first_tab: usize) process::ExitCode!&[u8] {
    if let ?payload = artifact_payload(line, first_tab) {
        !payload
    } else null {
        stderr.print("paw: invalid build graph line\n", &[]).exit().?;
        return process::exit(2)!;
    }
}

fn apply_single_field_link_option(stderr: &mut io::FileWriter, status: i32, message: &[u8]) process::ExitCode!void {
    if status != abi::status_ok {
        stderr.print("{}\n", &[message]).exit().?;
        return process::exit(2)!;
    }
    !{}
}

fn apply_dynamic_linker(
    stderr: &mut io::FileWriter,
    line: &[u8],
    first_tab: usize,
    root: &[u8],
    options: &abi::LinkOptions,
) process::ExitCode!void {
    let value = if let ?field = artifact_payload(line, first_tab) {
        field
    } else null {
        stderr.print("paw: invalid dynamic linker entry\n", &[]).exit().?;
        return process::exit(2)!;
    };
    if mem::equal[u8](value, b"auto") {
        return apply_single_field_link_option(
            stderr,
            options.set_dynamic_auto(),
            b"paw: failed to set dynamic linker",
        );
    }
    if mem::equal[u8](value, b"none") {
        return apply_single_field_link_option(
            stderr,
            options.set_dynamic_none(),
            b"paw: failed to set dynamic linker",
        );
    }
    if value.len() < 6usize or not mem::equal[u8](&value[0..5], b"path\t") {
        stderr.print("paw: invalid dynamic linker entry\n", &[]).exit().?;
        return process::exit(2)!;
    }
    var path_storage: [4096]u8 = [0; 4096];
    let path = root_relative_path(root, &value[5..value.len()], &mut path_storage).?;
    apply_single_field_link_option(
        stderr,
        options.set_dynamic_path(path),
        b"paw: failed to set dynamic linker",
    )
}

fn root_relative_path(root: &[u8], path: &[u8], out: &mut [u8]) process::ExitCode!&[u8] {
    if is_absolute(path) {
        return !path;
    }
    var writer = io::FixedBufferWriter::init(out);
    writer.write_all(root).exit().?;
    if writer.len() != 0usize and writer.written()[writer.len() - 1usize] != b'/' {
        writer.write_all(b"/").exit().?;
    }
    writer.write_all(path).exit().?;
    !writer.written()
}

fn is_absolute(path: &[u8]) bool {
    path.len() != 0usize and path[0] == b'/'
}

fn find_byte(bytes: &[u8], start: usize, value: u8) ?usize {
    var index = start;
    while index < bytes.len() {
        if bytes[index] == value {
            return ?index;
        }
        index += 1;
    }
    null
}

pub(pkg) fn read(
    init: process::Init,
    stderr: &mut io::FileWriter,
    graph_path: fs::Path,
    out: &mut [u8],
) process::ExitCode!&[u8] {
    var file = if let !value = fs::File::open(graph_path, fs::OpenOptions::read_only()) {
        value
    } else error! {
        stderr.print("paw: failed to open build graph\n", &[]).exit().?;
        return process::exit(2)!;
    };
    defer file.close().exit().?;
    var read_buffer: [1024]u8 = [0; 1024];
    var reader = file.reader(init.io(), &mut read_buffer[..]).exit().?;
    var len = 0usize;
    while true {
        if len == out.len() {
            stderr.print("paw: build graph is too large\n", &[]).exit().?;
            return process::exit(2)!;
        }
        let count = if let !value = reader.read(&mut out[len..out.len()]) {
            value
        } else error! {
            stderr.print("paw: failed to read build graph\n", &[]).exit().?;
            return process::exit(2)!;
        };
        if count == 0 {
            break;
        }
        len += count;
    }
    !&out[0..len]
}
