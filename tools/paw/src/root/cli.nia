using pkg::build;
using std::io;
using std::mem;
using std::process;
using process::{ExitCode, Init};

struct Cli {
    init: Init,
    stderr: &mut io::FileWriter,
}

struct Options {
    root: &[u8],
    step: &[u8],
}

pub fn run(init: Init, stderr: &mut io::FileWriter) ExitCode!ExitCode {
    var cli = Cli::init(init, stderr);
    cli.run(init.args())
}

extend Cli {
    fn init(init: Init, stderr: &mut io::FileWriter) Cli {
        { init: init, stderr: stderr }
    }

    fn run(&mut self, args: process::Args) process::ExitCode!ExitCode {
        var rest = args.skip_program();
        let options = self.parse_options(&mut rest).?;
        build::run_step(self.stderr, self.init, options.root, options.step)
    }

    fn parse_options(&mut self, args: &mut process::ArgsIter) process::ExitCode!Options {
        var root: &[u8] = b".";
        var step: &[u8] = b"";
        while true {
            let arg = if let ?value = args.next() {
                value
            } else null {
                break;
            };
            if mem::equal[u8](arg.bytes(), b"--root") {
                let value = if let ?root_arg = args.next() {
                    root_arg
                } else null {
                    self.print_usage_error().?;
                    return process::exit(2)!;
                };
                root = value.bytes();
            } else if mem::equal[u8](arg.bytes(), b"--help") {
                usage(self.stderr).?;
                self.stderr.flush().exit().?;
                return process::exit(0)!;
            } else if is_option(arg.bytes()) {
                self.print_usage_error().?;
                return process::exit(2)!;
            } else {
                if step.len() != 0usize {
                    self.print_usage_error().?;
                    return process::exit(2)!;
                }
                step = arg.bytes();
            }
        }
        !{ root: root, step: step }
    }

    fn print_usage_error(&mut self) process::ExitCode!void {
        usage(self.stderr).?;
        self.stderr.flush().exit().?;
        !{}
    }
}

fn is_option(arg: &[u8]) bool {
    arg.len() != 0usize and arg[0] == b'-'
}

fn usage(stderr: &mut io::FileWriter) process::ExitCode!void {
    stderr.print(
        \\usage: paw [step] [--root <dir>]
        \\
        ,
        &[],
    ).exit().?;
    !{}
}
