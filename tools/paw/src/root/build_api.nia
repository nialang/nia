using std::fs;
using std::fmt;
using std::io;
using std::process;

pub enum Error: i32 {
    Io = 1,
    InvalidInput = 2,
    _,
}

pub struct PackageOptions {
    name: &[char],
    version: &[char],
}

pub struct ExecutableOptions {
    name: &[char],
    root: &[char],
}

pub struct Build {
    writer: io::FileWriter,
    file: fs::File,
}

pub struct Executable {
    writer: &mut io::FileWriter,
    name: &[char],
}

pub struct Step {
    writer: &mut io::FileWriter,
    name: &[char],
}

extend PackageOptions {
    pub fn name(&self) &[char] {
        self.name
    }

    pub fn version(&self) &[char] {
        self.version
    }
}

extend ExecutableOptions {
    pub fn name(&self) &[char] {
        self.name
    }

    pub fn root(&self) &[char] {
        self.root
    }
}

extend Build {
    pub fn init(init: process::Init, graph_path: &[char], buffer: &mut [u8]) Error!Build {
        let file = fs::File::create(fs::Path::init(graph_path), fs::CreateOptions::init()).as_paw_error().?;
        let writer = file.writer(init.io(), buffer).as_paw_error().?;
        !{
            writer: writer,
            file: file,
        }
    }

    pub fn package(&mut self, options: PackageOptions) Error!void {
        let name = options.name();
        let version = options.version();
        if not is_graph_field(name) or not is_graph_field(version) {
            return Error::InvalidInput!;
        }
        self.writer.print("package\t{}\t{}\n", &[name, version]).as_paw_fmt_error()
    }

    pub fn executable(&mut self, options: ExecutableOptions) Error!Executable {
        let name = options.name();
        let root = options.root();
        if not is_graph_field(name) or not is_graph_field(root) {
            return Error::InvalidInput!;
        }
        self.writer.print("executable\t{}\t{}\n", &[name, root]).as_paw_fmt_error().?;
        !{ writer: &mut self.writer, name: name }
    }

    pub fn step(&mut self, name: &[char]) Error!Step {
        if not is_graph_field(name) {
            return Error::InvalidInput!;
        }
        self.writer.print("step\t{}\n", &[name]).as_paw_fmt_error().?;
        !{ writer: &mut self.writer, name: name }
    }

    pub fn finish(&mut self) Error!void {
        self.writer.flush().as_paw_error().?;
        self.file.close().as_paw_error().?;
        !{}
    }
}

extend Executable {
    pub fn library_path(&mut self, path: &[char]) Error!void {
        if not is_graph_field(path) {
            return Error::InvalidInput!;
        }
        self.writer.print("library-path\t{}\t{}\n", &[self.name, path]).as_paw_fmt_error()
    }

    pub fn library(&mut self, name: &[char]) Error!void {
        if not is_graph_field(name) {
            return Error::InvalidInput!;
        }
        self.writer.print("library\t{}\t{}\n", &[self.name, name]).as_paw_fmt_error()
    }

    pub fn rpath(&mut self, path: &[char]) Error!void {
        if not is_graph_field(path) {
            return Error::InvalidInput!;
        }
        self.writer.print("rpath\t{}\t{}\n", &[self.name, path]).as_paw_fmt_error()
    }

    pub fn dynamic_linker_auto(&mut self) Error!void {
        self.writer.print("dynamic-linker\t{}\tauto\n", &[self.name]).as_paw_fmt_error()
    }

    pub fn static_link(&mut self) Error!void {
        self.writer.print("link-mode\t{}\tstatic\n", &[self.name]).as_paw_fmt_error()
    }

    pub fn dynamic_link(&mut self) Error!void {
        self.writer.print("link-mode\t{}\tdynamic\n", &[self.name]).as_paw_fmt_error()
    }

    pub fn no_dynamic_linker(&mut self) Error!void {
        self.writer.print("dynamic-linker\t{}\tnone\n", &[self.name]).as_paw_fmt_error()
    }

    pub fn dynamic_linker_path(&mut self, path: &[char]) Error!void {
        if not is_graph_field(path) {
            return Error::InvalidInput!;
        }
        self.writer.print("dynamic-linker\t{}\tpath\t{}\n", &[self.name, path]).as_paw_fmt_error()
    }

    pub fn runtime_library(&mut self, source: &[char], name: &[char]) Error!void {
        if not is_graph_field(source) or not is_graph_field(name) {
            return Error::InvalidInput!;
        }
        self.writer.print("runtime-library\t{}\t{}\t{}\n", &[self.name, source, name]).as_paw_fmt_error()
    }

    pub fn use_nia_compiler(&mut self) Error!void {
        self.writer.print("nia-compiler\t{}\n", &[self.name]).as_paw_fmt_error()
    }
}

extend Step {
    pub fn build(&mut self, executable: &Executable) Error!void {
        self.writer.print("step-build-executable\t{}\t{}\n", &[self.name, executable.name]).as_paw_fmt_error()
    }

    pub fn check(&mut self, executable: &Executable) Error!void {
        self.writer.print("step-check-executable\t{}\t{}\n", &[self.name, executable.name]).as_paw_fmt_error()
    }

    pub fn objects(&mut self, executable: &Executable) Error!void {
        self.writer.print("step-object-directory\t{}\t{}\n", &[self.name, executable.name]).as_paw_fmt_error()
    }

    pub fn install(&mut self, executable: &Executable, path: &[char]) Error!void {
        if not is_graph_field(path) {
            return Error::InvalidInput!;
        }
        self.writer.print("step-install-executable\t{}\t{}\t{}\n", &[self.name, executable.name, path]).as_paw_fmt_error()
    }

    pub fn default(&mut self) Error!void {
        self.writer.print("default-step\t{}\n", &[self.name]).as_paw_fmt_error()
    }
}

extend Error {
    pub fn exit_code(self) process::ExitCode {
        switch self {
            Error::Io => process::exit(5),
            Error::InvalidInput => process::exit(22),
            _ => process::exit(255),
        }
    }
}

extend[T] Error!T {
    pub fn exit(self) process::ExitCode!T {
        if let !value = self {
            !value
        } else error! {
            error.exit_code()!
        }
    }
}

fn is_graph_field(text: &[char]) bool {
    if text.len() == 0usize {
        return false;
    }
    var index = 0usize;
    while index < text.len() {
        let ch = text[index];
        if ch == '\0' or ch == '\n' or ch == '\t' {
            return false;
        }
        index += 1usize;
    }
    true
}

extend[T] fs::Error!T {
    fn as_paw_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            Error::Io!
        }
    }
}

extend[T] io::BufferError!T {
    fn as_paw_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            Error::Io!
        }
    }
}

extend[T] fmt::Error!T {
    fn as_paw_fmt_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            switch error {
                fmt::Error::Write => Error::Io!,
                _ => Error::InvalidInput!,
            }
        }
    }
}
