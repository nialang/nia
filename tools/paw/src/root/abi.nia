pub comptime let status_ok: i32 = 0;
pub comptime let status_diagnostics: i32 = 1;
pub comptime let status_invalid_input: i32 = 2;
pub comptime let status_io_error: i32 = 4;
pub comptime let status_linker_error: i32 = 5;
pub comptime let status_invalid_artifact_request: i32 = 6;

pub comptime let runtime_bare: i32 = 0;
pub comptime let runtime_freestanding: i32 = 1;
pub comptime let opt_o0: i32 = 0;

extern struct NiaString {
    ptr: &u8,
    len: usize,
}

pub struct Session {
    raw: &void,
}

pub struct CheckRequest {
    raw: &void,
}

pub struct CheckResult {
    raw: &void,
}

pub struct LinkOptions {
    raw: &void,
}

extern fn nia_string_free(value: NiaString) void;
extern fn nia_session_new() &void;
extern fn nia_session_free(session: &void) void;
extern fn nia_session_set_source(
    session: &void,
    path_ptr: &u8,
    path_len: usize,
    text_ptr: &u8,
    text_len: usize,
) i32;
extern fn nia_check_request_new(path_ptr: &u8, path_len: usize) &void;
extern fn nia_check_request_free(request: &void) void;
extern fn nia_check_request_add_module(
    request: &void,
    name_ptr: &u8,
    name_len: usize,
    path_ptr: &u8,
    path_len: usize,
) i32;
extern fn nia_check_request_set_runtime(request: &void, runtime: i32) i32;
extern fn nia_check_request_set_optimization(request: &void, level: i32) i32;
extern fn nia_session_check(session: &void, request: &void) &void;
extern fn nia_session_emit_executable(
    session: &void,
    request: &void,
    output_ptr: &u8,
    output_len: usize,
) &void;
extern fn nia_session_emit_executable_with_options(
    session: &void,
    request: &void,
    output_ptr: &u8,
    output_len: usize,
    options: &void,
) &void;
extern fn nia_session_emit_object_directory(
    session: &void,
    request: &void,
    output_ptr: &u8,
    output_len: usize,
) &void;
extern fn nia_link_options_new() &void;
extern fn nia_link_options_free(options: &void) void;
extern fn nia_link_options_set_dynamic_linker_auto(options: &void) i32;
extern fn nia_link_options_set_no_dynamic_linker(options: &void) i32;
extern fn nia_link_options_set_dynamic_linker_path(options: &void, path_ptr: &u8, path_len: usize) i32;
extern fn nia_link_options_add_library_path(options: &void, path_ptr: &u8, path_len: usize) i32;
extern fn nia_link_options_add_rpath(options: &void, path_ptr: &u8, path_len: usize) i32;
extern fn nia_link_options_add_library(options: &void, name_ptr: &u8, name_len: usize) i32;
extern fn nia_result_status(result: &void) i32;
extern fn nia_result_message(result: &void) NiaString;
extern fn nia_result_free(result: &void) void;

pub fn free_string(value: NiaString) void {
    nia_string_free(value)
}

extend NiaString {
    pub fn bytes(&self) &[u8] {
        &self.ptr[0..self.len]
    }

    pub fn is_empty(&self) bool {
        self.len == 0usize
    }
}

extend Session {
    pub fn init() ?Session {
        Session::from_raw(nia_session_new())
    }

    fn from_raw(raw: &void) ?Session {
        if raw as usize == 0 {
            null
        } else {
            ?{ raw: raw }
        }
    }

    pub fn free(self) void {
        nia_session_free(self.raw)
    }

    pub fn set_source(&self, path: &[u8], text: &[u8]) i32 {
        nia_session_set_source(
            self.raw,
            path.get_ptr_read(),
            path.len(),
            text.get_ptr_read(),
            text.len(),
        )
    }

    pub fn check(&self, request: &CheckRequest) ?CheckResult {
        CheckResult::from_raw(nia_session_check(self.raw, request.raw()))
    }

    pub fn emit_object_directory(&self, request: &CheckRequest, output: &[u8]) ?CheckResult {
        CheckResult::from_raw(nia_session_emit_object_directory(self.raw, request.raw(), output.get_ptr_read(), output.len()))
    }

    pub fn emit_executable(&self, request: &CheckRequest, output: &[u8]) ?CheckResult {
        CheckResult::from_raw(nia_session_emit_executable(self.raw, request.raw(), output.get_ptr_read(), output.len()))
    }

    pub fn emit_executable_with_options(&self, request: &CheckRequest, output: &[u8], options: &LinkOptions) ?CheckResult {
        CheckResult::from_raw(nia_session_emit_executable_with_options(
            self.raw,
            request.raw(),
            output.get_ptr_read(),
            output.len(),
            options.raw(),
        ))
    }
}

extend CheckRequest {
    pub fn init(path: &[u8]) ?CheckRequest {
        let raw = nia_check_request_new(path.get_ptr_read(), path.len());
        if raw as usize == 0 {
            null
        } else {
            ?{ raw: raw }
        }
    }

    fn raw(&self) &void {
        self.raw
    }

    pub fn free(self) void {
        nia_check_request_free(self.raw)
    }

    pub fn add_module(&self, name: &[u8], path: &[u8]) i32 {
        nia_check_request_add_module(
            self.raw,
            name.get_ptr_read(),
            name.len(),
            path.get_ptr_read(),
            path.len(),
        )
    }

    pub fn set_bare(&self) i32 {
        nia_check_request_set_runtime(self.raw, runtime_bare)
    }

    pub fn set_freestanding(&self) i32 {
        nia_check_request_set_runtime(self.raw, runtime_freestanding)
    }

    pub fn set_runtime(&self, runtime: i32) i32 {
        nia_check_request_set_runtime(self.raw, runtime)
    }

    pub fn set_o0(&self) i32 {
        nia_check_request_set_optimization(self.raw, opt_o0)
    }
}

extend CheckResult {
    fn from_raw(raw: &void) ?CheckResult {
        if raw as usize == 0 {
            null
        } else {
            ?{ raw: raw }
        }
    }

    pub fn status(&self) i32 {
        nia_result_status(self.raw)
    }

    pub fn message(&self) NiaString {
        nia_result_message(self.raw)
    }

    pub fn free(self) void {
        nia_result_free(self.raw)
    }
}

extend LinkOptions {
    pub fn init() ?LinkOptions {
        let raw = nia_link_options_new();
        if raw as usize == 0 {
            null
        } else {
            ?{ raw: raw }
        }
    }

    fn raw(&self) &void {
        self.raw
    }

    pub fn free(self) void {
        nia_link_options_free(self.raw)
    }

    pub fn set_dynamic_auto(&self) i32 {
        nia_link_options_set_dynamic_linker_auto(self.raw)
    }

    pub fn set_dynamic_none(&self) i32 {
        nia_link_options_set_no_dynamic_linker(self.raw)
    }

    pub fn set_dynamic_path(&self, path: &[u8]) i32 {
        nia_link_options_set_dynamic_linker_path(self.raw, path.get_ptr_read(), path.len())
    }

    pub fn add_library_path(&self, path: &[u8]) i32 {
        nia_link_options_add_library_path(self.raw, path.get_ptr_read(), path.len())
    }

    pub fn add_rpath(&self, path: &[u8]) i32 {
        nia_link_options_add_rpath(self.raw, path.get_ptr_read(), path.len())
    }

    pub fn add_library(&self, name: &[u8]) i32 {
        nia_link_options_add_library(self.raw, name.get_ptr_read(), name.len())
    }
}
