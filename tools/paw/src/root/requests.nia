using pkg::abi;
using std::io;
using std::process;

pub(pkg) struct PreparedCheck {
    session: abi::Session,
    request: abi::CheckRequest,
}

extend PreparedCheck {
    pub(pkg) fn session(&self) &abi::Session {
        &self.session
    }

    pub(pkg) fn request(&self) &abi::CheckRequest {
        &self.request
    }
}

pub(pkg) fn status_code(status: i32) process::ExitCode {
    switch status {
        abi::status_ok => process::exit(0),
        abi::status_diagnostics => process::exit(1),
        abi::status_invalid_input => process::exit(2),
        abi::status_io_error => process::exit(3),
        abi::status_linker_error => process::exit(4),
        abi::status_invalid_artifact_request => process::exit(5),
        _ => process::exit(255),
    }
}

pub(pkg) fn print_result(stderr: &mut io::FileWriter, result: &abi::CheckResult) process::ExitCode!void {
    let message = result.message();
    if not message.is_empty() {
        stderr.print("{}", &[message.bytes()]).exit().?;
    }
    abi::free_string(message);
    !{}
}

pub(pkg) fn finish_result(stderr: &mut io::FileWriter, maybe_result: ?abi::CheckResult, null_message: &[u8]) process::ExitCode!process::ExitCode {
    let result = if let ?value = maybe_result {
        value
    } else null {
        stderr.print("{}\n", &[null_message]).exit().?;
        return process::exit(255)!;
    };
    defer result.free();

    let status = result.status();
    print_result(stderr, &result).?;
    !status_code(status)
}

pub(pkg) fn expect_status(stderr: &mut io::FileWriter, status: i32, message: &[u8]) process::ExitCode!void {
    if status != abi::status_ok {
        stderr.print("{}\n", &[message]).exit().?;
        return status_code(status)!;
    }
    !{}
}

pub(pkg) fn prepare_package_check(
    stderr: &mut io::FileWriter,
    name: &[u8],
    main_path: &[u8],
    package_path: &[u8],
    runtime: i32,
) process::ExitCode!PreparedCheck {
    var ready = false;
    let session = if let ?value = abi::Session::init() {
        value
    } else null {
        stderr.print("paw: failed to create nia session\n", &[]).exit().?;
        return process::exit(255)!;
    };
    defer if not ready {
        session.free();
    };

    let request = if let ?value = abi::CheckRequest::init(main_path) {
        value
    } else null {
        stderr.print("paw: failed to create check request\n", &[]).exit().?;
        return process::exit(2)!;
    };
    defer if not ready {
        request.free();
    };

    expect_status(stderr, request.set_runtime(runtime), b"paw: failed to set package runtime").?;
    expect_status(stderr, request.set_o0(), b"paw: failed to set optimization level").?;
    expect_status(stderr, request.add_module(name, package_path), b"paw: failed to add package module").?;

    ready = true;
    !{ session: session, request: request }
}

pub(pkg) fn finish(prepared: PreparedCheck) void {
    prepared.request.free();
    prepared.session.free();
}
