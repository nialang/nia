// Nia standard library root facade.
//
// Files are modules in Nia. This root facade re-exports selected items that
// are intentionally available as `std::name`; it does not re-export the
// standard-library implementation modules themselves.

pub module atomic;
pub module build;
pub module collections;
pub module cstring;
pub module debug;
pub module error;
pub module fmt;
pub module fs;
pub module hash;
pub module io;
pub module iter;
pub module math;
pub module mem;
pub module os;
pub module process;
pub module slice;
pub module string;
pub module unicode;

pub using atomic::Atomic;
pub using collections::{ArrayList, HashMap};
pub using cstring::CStringView;
pub using fs::{PathBuf, PathView};
pub using string::{StringBuf, StringView};
