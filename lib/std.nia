// Nia standard library root facade.
//
// Files are modules in Nia. This root facade re-exports selected items that
// are intentionally available as `std::name`; it does not re-export the
// standard-library implementation modules themselves.
//
// Owned values keep allocation and release explicit. Borrowed views do not
// extend backing storage lifetimes, and typed errors preserve domain causes.

pub module atomic;
pub module builtin;
pub module build;
pub module cmp;
pub module collections;
pub module cstring;
pub module debug;
pub module error;
pub module fmt;
pub module fs;
pub module hash;
pub module io;
pub module iter;
pub module math;
pub module mem;
pub(pkg) module os;
pub module option;
pub module parse;
pub module process;
pub module result;
pub module slice;
pub module string;
pub module unicode;

pub using atomic::Atomic;
pub using collections::{ArrayList, HashMap, HashMapInitError};
pub using cstring::{CString, CStringBuildError, CStringError, CStringView};
pub using fs::{Path, PathView};
pub using string::{String, TextError, TextFormatError};

using pkg::iter::range;
using pkg::hash;
