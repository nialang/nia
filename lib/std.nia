// Nia standard library root facade.
//
// Files are modules in Nia. This root facade re-exports selected items that
// are intentionally available as `std::name`; it does not re-export the
// standard-library implementation modules themselves.

pub module atomic;
pub module collections;
pub module debug;
pub module fmt;
pub module fs;
pub module hash;
pub module io;
pub module math;
pub module mem;
pub module os;
pub module process;
pub module range;
pub module slice;
pub module unicode;

pub using atomic::Atomic;
pub using collections::{
    ArrayList,
    DefaultHashMapContext,
    HashMap,
    HashMapContext,
    HashMapEntry,
    HashMapEntryMut,
    HashMapEntryRef,
    HashMapGetOrPutResult,
    HashMapIter,
    HashMapIterMut,
    HashMapKeys,
    HashMapValues,
    HashMapValuesMut,
    HashMapWithContext,
};
pub using hash::{Hash, Hasher, Wyhash};
pub using range::{from, inclusive, range};
pub using slice::SliceIter;
