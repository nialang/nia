// Nia standard library root.
//
// Public standard-library surfaces are re-exported from here so users can
// import `std` as the stable facade.

import std.io;
import std.array_list;
import std.fs;
import std.fmt;
import std.math;
import std.mem;
import std.os;
import std.process;
import std.range;
import std.result;
import std.unicode;

pub using {array_list, fmt, fs, io, math, mem, os, process, range, result, unicode};
pub using range::{from, inclusive, range};
