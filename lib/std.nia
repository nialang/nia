// Nia standard library root facade.
//
// Files are modules in Nia. This root facade re-exports selected items that
// are intentionally available as `std::name`; it does not re-export the
// standard-library implementation modules themselves.

pub module atomic;
pub module build;
pub module collections;
pub module cstr;
pub module debug;
pub module fmt;
pub module fs;
pub module hash;
pub module io;
pub module math;
pub module mem;
pub module os;
pub module process;
pub(pkg) module range;
pub module slice;
pub module unicode;

pub using atomic::Atomic;
pub using collections::{ArrayList, HashMap};
pub using cstr::CStr;
pub using range::{Range, RangeFrom, RangeInclusive, Step, from, inclusive, range};
