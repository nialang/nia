using std::{builtin, cpu, io};
using std::builtin::target::CpuFeature;

// Native support ABI used by debug checked entries. This function has only
// the build's guaranteed features. It must stay out of specialized bodies.
@[inlineNever]
extern fun __nia_check_cpu_features(required: u32) () {
    let features: [(CpuFeature, &[char]); 21] = [
        (CpuFeature::Sse2, &"sse2"), (CpuFeature::Sse3, &"sse3"),
        (CpuFeature::Ssse3, &"ssse3"), (CpuFeature::Sse4_1, &"sse4_1"),
        (CpuFeature::Sse4_2, &"sse4_2"), (CpuFeature::Popcnt, &"popcnt"),
        (CpuFeature::Cmpxchg16b, &"cmpxchg16b"), (CpuFeature::Avx, &"avx"),
        (CpuFeature::Avx2, &"avx2"), (CpuFeature::Fma, &"fma"),
        (CpuFeature::Bmi1, &"bmi1"), (CpuFeature::Bmi2, &"bmi2"),
        (CpuFeature::Lzcnt, &"lzcnt"), (CpuFeature::Movbe, &"movbe"),
        (CpuFeature::F16c, &"f16c"), (CpuFeature::Avx512f, &"avx512f"),
        (CpuFeature::Avx512bw, &"avx512bw"), (CpuFeature::Avx512cd, &"avx512cd"),
        (CpuFeature::Avx512dq, &"avx512dq"), (CpuFeature::Avx512vl, &"avx512vl"),
        (CpuFeature::Neon, &"neon"),
    ];
    let mut known = 0u32;
    for &(feature, _) in &features[..] {
        known |= bit(feature);
    }
    if (required & known) != required {
        _ = io::debugPrint("unknown required CPU feature mask\n", []);
        builtin::trap();
    }
    // Each feature follows the features it implies, so the last missing one
    // is a feature the function asked for rather than one of its dependencies.
    let mut missing: ?&[char] = null;
    for &(feature, name) in &features[..] {
        if (required & bit(feature)) != 0 and not cpu::supports(feature) {
            missing = ?name;
        }
    }
    if missing is ?name {
        _ = io::debugPrint("required CPU feature {} is unavailable\n", [name]);
        builtin::trap();
    }
}

const fun bit(feature: CpuFeature) u32 {
    1u32 << (feature as u32)
}
