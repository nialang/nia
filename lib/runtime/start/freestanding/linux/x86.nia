using pkg::main::callUserMain;
using std::math;
using std::os;
using std::process;

extern fn niaStartStack(stack: &usize) () {
    let argc = stack.*;
    let wordSize = std::builtin::size[usize]();
    let argvAddress = match startupAddress(stack, wordSize) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let envWordCount = match argc.checkedAdd(2) {
        ?count => count,
        null => {
            os::exit(127);
            0
        },
    };
    let envOffset = match wordSize.checkedMul(envWordCount) {
        ?offset => offset,
        null => {
            os::exit(127);
            0
        },
    };
    let envAddress = match startupAddress(stack, envOffset) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let init = process::Init::init(argc, argvAddress as &&u8, envAddress as &&u8);
    os::exit(callUserMain(init).0);
    loop {}
}

fn startupAddress(stack: &usize, offset: usize) ?usize {
    (stack as usize).checkedAdd(offset)
}

@[naked]
pub extern fn _start() () {
    std::builtin::asm(.{
        code:
            b"mov eax, esp\n"
            b"and esp, -16\n"
            b"sub esp, 12\n"
            b"push eax\n"
            // A direct call is PC-relative: no GOT or register operand, so
            // the naked function holds exactly this assembly.
            b"call niaStartStack\n"
            b"ud2",
        clobbers: [b"eax", b"ecx", b"edx", b"memory"],
        options: [b"volatile"],
    });
    loop {}
}
