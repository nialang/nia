using entry;
using pkg::math;
using pkg::os;
using pkg::process;

fn callUserMain(init: process::Init) process::ExitCode {
    if entry::main(init) is error! {
        return error;
    }
    .Success
}

extern fn nia_start_stack(stack: &usize) () {
    let argc = stack.*;
    let wordSize = std::builtin::size[usize]();
    let argvAddress = match startupAddress(stack, wordSize) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let envWordCount = match argc.checkedAdd(2) {
        ?count => count,
        null => {
            os::exit(127);
            0
        },
    };
    let envOffset = match wordSize.checkedMul(envWordCount) {
        ?offset => offset,
        null => {
            os::exit(127);
            0
        },
    };
    let envAddress = match startupAddress(stack, envOffset) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let init = process::Init::init(argc, argvAddress as &&u8, envAddress as &&u8);
    os::exit(callUserMain(init) as i32);
    loop {}
}

fn startupAddress(stack: &usize, offset: usize) ?usize {
    (stack as usize).checkedAdd(offset)
}

@[naked]
pub extern fn _start() () {
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\mov eax, esp
            \\and esp, -16
            \\sub esp, 12
            \\push eax
            \\call nia_start_stack
            \\ud2
        ,
        clobbers: [b"eax", b"ecx", b"edx", b"memory"],
        options: [b"volatile"],
    });
    loop {}
}
