// Linux process startup shared by every architecture: `_start` passes the
// entry stack and this image's ELF header and dynamic section.
using pkg::main::callUserMain;
using pkg::start::freestanding::linux::relocate::relocate;
using std::math;
using std::os;
using std::process;

// `header` and `dynamic` locate this image for static-pie self-relocation,
// which must precede every other statement.
extern fn niaStartStack(stack: &usize, header: usize, dynamic: usize) () {
    relocate(header, dynamic);
    let argc = stack.*;
    let wordSize = std::builtin::size[usize]();
    let argvAddress = match startupAddress(stack, wordSize) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let envWordCount = match argc.checkedAdd(2) {
        ?count => count,
        null => {
            os::exit(127);
            0
        },
    };
    let envOffset = match wordSize.checkedMul(envWordCount) {
        ?offset => offset,
        null => {
            os::exit(127);
            0
        },
    };
    let envAddress = match startupAddress(stack, envOffset) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let argv = argvAddress as &&u8;
    let envp = envAddress as &&u8;
    let init = process::Init::init(argc, argv, envp);
    let exit = callUserMain(init);
    os::exit(exit.0);
    loop {}
}

fn startupAddress(stack: &usize, offset: usize) ?usize {
    (stack as usize).checkedAdd(offset)
}
