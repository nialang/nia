using pkg::main::callUserMain;
using pkg::start::freestanding::linux::relocate::relocate;
using std::math;
using std::os;
using std::process;

// `header` and `dynamic` locate this image for static-pie self-relocation,
// which must precede every other statement.
extern fn niaStartStack(stack: &usize, header: usize, dynamic: usize) () {
    relocate(header, dynamic);
    let argc = stack.*;
    let wordSize = std::builtin::size[usize]();
    let argvAddress = match startupAddress(stack, wordSize) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let envWordCount = match argc.checkedAdd(2) {
        ?count => count,
        null => {
            os::exit(127);
            0
        },
    };
    let envOffset = match wordSize.checkedMul(envWordCount) {
        ?offset => offset,
        null => {
            os::exit(127);
            0
        },
    };
    let envAddress = match startupAddress(stack, envOffset) {
        ?address => address,
        null => {
            os::exit(127);
            0
        },
    };
    let argv = argvAddress as &&u8;
    let envp = envAddress as &&u8;
    let init = process::Init::init(argc, argv, envp);
    let exit = callUserMain(init);
    os::exit(exit.0);
    loop {}
}

fn startupAddress(stack: &usize, offset: usize) ?usize {
    (stack as usize).checkedAdd(offset)
}

@[naked]
pub extern fn _start() () {
    std::builtin::asm(.{
        code:
            // The linker defines both symbols; `_DYNAMIC` exists only in a
            // position-independent image, so it is weak and reads as 0
            // otherwise. Hidden symbols are reached PC-relative, without a
            // relocation that has not been applied yet.
            b".weak _DYNAMIC\n"
            b".hidden _DYNAMIC\n"
            b".hidden __ehdr_start\n"
            b"mov rdi, rsp\n"
            b"lea rsi, [rip + __ehdr_start]\n"
            b"lea rdx, [rip + _DYNAMIC]\n"
            // A direct call is PC-relative: no GOT or register operand, so
            // the naked function holds exactly this assembly.
            b"call niaStartStack\n"
            b"ud2",
        clobbers: [b"rdi", b"rsi", b"rdx", b"rax", b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    loop {}
}
