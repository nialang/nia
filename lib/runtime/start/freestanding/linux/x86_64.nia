@[naked]
pub extern fn _start() () {
    std::builtin::asm(.{
        code:
            // The linker defines both symbols; `_DYNAMIC` exists only in a
            // position-independent image, so it is weak and reads as 0
            // otherwise. Hidden symbols are reached PC-relative, without a
            // relocation that has not been applied yet.
            b".weak _DYNAMIC\n"
            b".hidden _DYNAMIC\n"
            b".hidden __ehdr_start\n"
            b"mov rdi, rsp\n"
            b"lea rsi, [rip + __ehdr_start]\n"
            b"lea rdx, [rip + _DYNAMIC]\n"
            // A direct call is PC-relative: no GOT or register operand, so
            // the naked function holds exactly this assembly.
            b"call niaStartStack\n"
            b"ud2",
        clobbers: [b"rdi", b"rsi", b"rdx", b"rax", b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    loop {}
}
