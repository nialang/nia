using pkg::builtins::windows::x86_64::__chkstk;

@[naked]
pub extern fn _start() () {
    std::builtin::asm(.{
        code:
            b"sub rsp, 40\n"
            // A direct call is PC-relative: no import thunk or register
            // operand, so the naked function holds exactly this assembly.
            b"call niaWindowsStart\n"
            b"ud2",
        clobbers: [b"rax", b"rcx", b"rdx", b"r8", b"r9", b"r10", b"r11", b"memory"],
        options: [b"volatile"],
    });
    loop {}
}
