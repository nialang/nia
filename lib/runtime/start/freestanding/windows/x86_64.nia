using pkg::start::freestanding::windows::startup::niaWindowsStart;
using pkg::builtins::windows::x86_64::__chkstk;

@[naked]
pub extern fn _start() () {
    std::builtin::asm(.{
        code:
            b"sub rsp, 40\n"
            b"call $0\n"
            b"ud2",
        inputs: .{ reg: &niaWindowsStart },
        clobbers: [b"rax", b"rcx", b"rdx", b"r8", b"r9", b"r10", b"r11", b"memory"],
        options: [b"volatile"],
    });
    loop {}
}
