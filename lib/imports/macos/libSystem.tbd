--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-macos, x86_64-macos ]
flags:           [ not_app_extension_safe ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 0
compatibility-version: 0
exports:
  - targets:         [ arm64-macos, x86_64-macos ]
    symbols:        [ ___error, _chdir, _close, _dup2, _execve, _exit,
                      _fcntl, _fdatasync, _fchmod, _fork, _fsync, _ftruncate,
                      _getcwd, ___getdirentries64, _getentropy, _kill, _lseek,
                      _mkdirat, _mmap, _munmap, _openat, _pipe, _read,
                      _renameat, _unlinkat, _waitpid, _write ]
  - targets:         [ arm64-macos ]
    symbols:        [ _fstat, _fstatat ]
  - targets:         [ x86_64-macos ]
    symbols:        [ '_fstat$INODE64', '_fstatat$INODE64' ]
...
