--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-macos, x86_64-macos ]
flags:           [ not_app_extension_safe ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 0
compatibility-version: 0
exports:
  - targets:         [ arm64-macos, x86_64-macos ]
    symbols:        [ ___error, _close, _exit, _fdatasync, _fchmod, _fsync,
                      _ftruncate, _getcwd, _getentropy, _lseek, _mmap, _munmap,
                      _read, _write ]
...
