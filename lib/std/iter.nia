// Iterator adapters and eager callback consumers.
//
// `forEach`, `fold`, `tryFold`, and `position` borrow callbacks only for the
// active call. Lazy adapters own their iterator state but no borrowed callback.

pub(pkg) module range;

using pkg::iter::range;

pub trait DoubleEndedIterator : Iterator {
    fn nextBack(&mut self) ?[Self as Iterator]::Item;
}

pub struct Take[I]
where I: Iterator
{
    iter: I,
    remaining: usize,
}

pub struct Rev[I]
where I: DoubleEndedIterator
{
    iter: I,
}

extend[I] Take[I]
where I: Iterator
{
    pub fn init(iter: I, remaining: usize) Take[I] {
        .{ iter, remaining }
    }
}

extend[I] Take[I] : Iterator
where I: Iterator
{
    type Item = [I as Iterator]::Item;

    pub fn next(&mut self) ?[I as Iterator]::Item {
        if self.remaining == 0 {
            return null;
        }
        if self.iter.next() is ?value {
            self.remaining -= 1;
            return ?value;
        }
        null
    }
}

extend[I] Rev[I]
where I: DoubleEndedIterator
{
    pub fn init(iter: I) Rev[I] {
        .{ iter }
    }
}

extend[I] Rev[I] : Iterator
where I: DoubleEndedIterator
{
    type Item = [I as Iterator]::Item;

    pub fn next(&mut self) ?[I as Iterator]::Item {
        self.iter.nextBack()
    }
}

extend[I] Rev[I] : DoubleEndedIterator
where I: DoubleEndedIterator
{
    pub fn nextBack(&mut self) ?[Rev[I] as Iterator]::Item {
        self.iter.next()
    }
}

extend[I] I
where I: Iterator
{
    pub fn take(self, limit: usize) Take[I] {
        Take[I]::init(self, limit)
    }

    pub fn count(self) usize {
        let mut iter = self;
        let mut total: usize = 0;
        while true {
            if iter.next() is ?_ {
                total += 1;
            } else {
                break;
            }
        }
        total
    }

    pub fn forEach(self, callback: &Fn([I as Iterator]::Item) ()) () {
        let mut iter = self;
        while true {
            if iter.next() is ?value {
                callback(value);
            } else {
                break;
            }
        }
    }

    pub fn fold[Accumulator](
        self,
        initial: Accumulator,
        callback: &Fn(Accumulator, [I as Iterator]::Item) Accumulator,
    ) Accumulator {
        let mut iter = self;
        let mut accumulator = initial;
        while true {
            if iter.next() is ?value {
                accumulator = callback(accumulator, value);
            } else {
                break;
            }
        }
        accumulator
    }

    pub fn tryFold[Accumulator, Error](
        self,
        initial: Accumulator,
        callback: &Fn(Accumulator, [I as Iterator]::Item) Error!Accumulator,
    ) Error!Accumulator {
        let mut iter = self;
        let mut accumulator = initial;
        while true {
            if iter.next() is ?value {
                accumulator = callback(accumulator, value).?;
            } else {
                break;
            }
        }
        !accumulator
    }

    pub fn position(self, predicate: &Fn([I as Iterator]::Item) bool) ?usize {
        let mut iter = self;
        let mut index: usize = 0;
        while true {
            if iter.next() is ?value {
                if predicate(value) {
                    return ?index;
                }
                index += 1;
            } else {
                break;
            }
        }
        null
    }
}

extend[I] I
where I: DoubleEndedIterator
{
    pub fn rev(self) Rev[I] {
        Rev[I]::init(self)
    }
}

pub using range::{Range, RangeFrom, RangeInclusive, Step, StepBack};
