// Iterator adapters and eager callback consumers.
//
// `forEach`, `fold`, `tryFold`, and `position` borrow callbacks for one call.
// Lazy adapters such as `Map` own their callback and iterator state.

pub(root) module range;

using root::iter::range;

pub trait DoubleEndedIterator : Iterator {
    fun nextBack(&mut self) ?[Self as Iterator]::Item;
}

pub struct Take[I]
where I: Iterator
{
    iter: I,
    remaining: usize,
}

pub struct Rev[I]
where I: DoubleEndedIterator
{
    iter: I,
}

pub struct Map[I, Mapper, Mapped]
where I: Iterator
{
    iter: I,
    mapper: Mapper,
}

extend[I] Take[I]
where I: Iterator
{
    pub fun init(iter: I, remaining: usize) Take[I] {
        .{ iter, remaining }
    }
}

extend[I] Take[I] : Iterator
where I: Iterator
{
    type Item = [I as Iterator]::Item;

    pub fun next(&mut self) ?[I as Iterator]::Item {
        if self.remaining == 0 {
            return null;
        }
        if self.iter.next() is ?value {
            self.remaining -= 1;
            return ?value;
        }
        null
    }
}

extend[I] Rev[I]
where I: DoubleEndedIterator
{
    pub fun init(iter: I) Rev[I] {
        .{ iter }
    }
}

extend[I] Rev[I] : Iterator
where I: DoubleEndedIterator
{
    type Item = [I as Iterator]::Item;

    pub fun next(&mut self) ?[I as Iterator]::Item {
        self.iter.nextBack()
    }
}

extend[I] Rev[I] : DoubleEndedIterator
where I: DoubleEndedIterator
{
    pub fun nextBack(&mut self) ?[Rev[I] as Iterator]::Item {
        self.iter.next()
    }
}

extend[I, Mapper, Mapped] Map[I, Mapper, Mapped]
where I: Iterator, Mapper: Fun([I as Iterator]::Item) Mapped
{
    pub fun init(iter: I, mapper: Mapper) Map[I, Mapper, Mapped] {
        .{ iter, mapper }
    }
}

extend[I, Mapper, Mapped] Map[I, Mapper, Mapped] : Iterator
where I: Iterator, Mapper: Fun([I as Iterator]::Item) Mapped
{
    type Item = Mapped;

    pub fun next(&mut self) ?Mapped {
        if self.iter.next() is ?value {
            return ?self.mapper(value);
        }
        null
    }
}

extend[I] I
where I: Iterator
{
    pub fun map[Mapper, Mapped](self, mapper: Mapper) Map[I, Mapper, Mapped]
    where Mapper: Fun([I as Iterator]::Item) Mapped
    {
        .init(self, mapper)
    }

    pub fun take(self, limit: usize) Take[I] {
        .init(self, limit)
    }

    pub fun count(self) usize {
        let mut total: usize = 0;
        for _ in self {
            total += 1;
        }
        total
    }

    pub fun forEach(self, callback: &Fun([I as Iterator]::Item) ()) () {
        for value in self {
            callback(value);
        }
    }

    pub fun fold[Accumulator](
        self,
        initial: Accumulator,
        callback: &Fun(Accumulator, [I as Iterator]::Item) Accumulator,
    ) Accumulator {
        let mut accumulator = initial;
        for value in self {
            accumulator = callback(accumulator, value);
        }
        accumulator
    }

    pub fun tryFold[Accumulator, Error](
        self,
        initial: Accumulator,
        callback: &Fun(Accumulator, [I as Iterator]::Item) Error!Accumulator,
    ) Error!Accumulator {
        let mut accumulator = initial;
        for value in self {
            accumulator = callback(accumulator, value).?;
        }
        !accumulator
    }

    pub fun position(self, predicate: &Fun([I as Iterator]::Item) bool) ?usize {
        let mut index: usize = 0;
        for value in self {
            if predicate(value) {
                return ?index;
            }
            index += 1;
        }
        null
    }
}

extend[I] I
where I: DoubleEndedIterator
{
    pub fun rev(self) Rev[I] {
        .init(self)
    }
}

pub using range::{Range, RangeFrom, RangeInclusive, Step, StepBack};
