pub(pkg) module range;

using pkg::iter::range;

pub trait DoubleEndedIterator : Iterator {
    fn nextBack(&mut self) ?[Self as Iterator]::Item;
}

pub struct Take[I]
where I: Iterator
{
    iter: I,
    remaining: usize,
}

pub struct Rev[I]
where I: DoubleEndedIterator
{
    iter: I,
}

extend[I] Take[I]
where I: Iterator
{
    fn init(iter: I, remaining: usize) Take[I] {
        { iter: iter, remaining: remaining }
    }
}

extend[I] Take[I] : Iterator
where I: Iterator
{
    type Item = [I as Iterator]::Item;

    pub fn next(&mut self) ?[I as Iterator]::Item {
        if self.remaining == 0 {
            return null;
        }
        switch self.iter.next() {
            ?value => {
                self.remaining -= 1;
                ?value
            },
            null => {
                null
            },
        }
    }
}

extend[I] Rev[I]
where I: DoubleEndedIterator
{
    fn init(iter: I) Rev[I] {
        { iter: iter }
    }
}

extend[I] Rev[I] : Iterator
where I: DoubleEndedIterator
{
    type Item = [I as Iterator]::Item;

    pub fn next(&mut self) ?[I as Iterator]::Item {
        self.iter.nextBack()
    }
}

extend[I] Rev[I] : DoubleEndedIterator
where I: DoubleEndedIterator
{
    pub fn nextBack(&mut self) ?[Rev[I] as Iterator]::Item {
        self.iter.next()
    }
}

extend[I] I
where I: Iterator
{
    pub fn take(self, limit: usize) Take[I] {
        Take[I]::init(self, limit)
    }

    pub fn count(self) usize {
        let mut iter = self;
        let mut total: usize = 0;
        let mut done = false;
        while done == false {
            switch iter.next() {
                ?value => {
                    _ = value;
                    total += 1;
                },
                null => {
                    done = true;
                },
            }
        }
        total
    }

    pub fn forEach(self, callback: &Fn([I as Iterator]::Item) ()) () {
        let mut iter = self;
        let mut done = false;
        while done == false {
            switch iter.next() {
                ?value => {
                    callback(value);
                },
                null => {
                    done = true;
                },
            }
        }
    }
}

extend[I] I
where I: DoubleEndedIterator
{
    pub fn rev(self) Rev[I] {
        Rev[I]::init(self)
    }
}

pub using range::{Range, RangeFrom, RangeInclusive, Step, StepBack};
