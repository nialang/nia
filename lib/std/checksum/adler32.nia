// Adler-32 rolling checksum as specified in RFC 1950.
//
// This checksum detects accidental corruption; it is not cryptographic and
// must not be used for authentication.

pub struct Adler32 {
    first: u32,
    second: u32,
}

const modulus: u64 = 65521;
// Bound each update chunk so `second` stays within u32 before reduction. This
// is the Adler-32 NMAX bound; larger inputs are processed in multiple chunks.
const maxBlockLength: usize = 5552;

extend Adler32 {
    pub fun init() Adler32 {
        .{ first: 1, second: 0 }
    }

    pub fun update(&mut self, bytes: &[u8]) () {
        let mut offset: usize = 0;
        while offset < bytes.len() {
            let count = if bytes.len() - offset < maxBlockLength {
                bytes.len() - offset
            } else {
                maxBlockLength
            };
            let mut first = self.first as u64;
            let mut second = self.second as u64;
            for &byte in &bytes[offset..(offset + count)] {
                first += byte as u64;
                second += first;
            }
            offset += count;
            self.first = (first % modulus) as u32;
            self.second = (second % modulus) as u32;
        }
    }

    pub fun finish(&self) u32 {
        (self.second << 16) | self.first
    }

    pub fun hash(bytes: &[u8]) u32 {
        let mut checksum = Adler32::init();
        checksum.update(bytes);
        checksum.finish()
    }
}
