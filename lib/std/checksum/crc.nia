pub struct Crc32 {
    state: u32,
}

pub struct Crc32C {
    state: u32,
}

fun updateState(state: &mut u32, bytes: &[u8], table: &[u32]) () {
    for index in 0..bytes.len() {
        let slot = ((state.* ^ bytes[index] as u32) & 0xffu32) as usize;
        state.* = (state.* >> 8) ^ table[slot];
    }
}

extend Crc32 {
    pub fun init() Crc32 { .{ state: u32::MAX } }

    pub fun update(&mut self, bytes: &[u8]) () {
        updateState(&mut self.state, bytes, &crc32Table[..]);
    }

    pub fun finish(&self) u32 { self.state ^ u32::MAX }

    pub fun hash(bytes: &[u8]) u32 {
        let mut checksum = Crc32::init();
        checksum.update(bytes);
        checksum.finish()
    }
}

extend Crc32C {
    pub fun init() Crc32C { .{ state: u32::MAX } }

    pub fun update(&mut self, bytes: &[u8]) () {
        updateState(&mut self.state, bytes, &crc32cTable[..]);
    }

    pub fun finish(&self) u32 { self.state ^ u32::MAX }

    pub fun hash(bytes: &[u8]) u32 {
        let mut checksum = Crc32C::init();
        checksum.update(bytes);
        checksum.finish()
    }
}
