import std.fs.options;
import std.fs.path;
import std.fs.types;
import std.os;
import std.result;

using types::{
    CreateDirOptions,
    CreateOptions,
    Dir,
    EncodedPath,
    Error,
    File,
    Metadata,
    MetadataOptions,
    OpenDirOptions,
    OpenOptions,
    Path,
};

comptime let max_i64_as_u64: u64 = 9223372036854775807u64;

extend Dir {
    fn from_owned_descriptor(handle: os::FileDescriptor) Dir {
        { handle: handle }
    }

    pub fn cwd() Error!Dir {
        let current = c".";
        let handle = os::open_dir_at(
            os::cwd(),
            &current[0],
            true,
        ).map_err[Error](&os::Error::as_fs_error).?;
        !Dir::from_owned_descriptor(handle)
    }

    pub fn open_file(&self, path: Path, options: OpenOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.open_encoded_file(encoded, options)
    }

    pub fn open_dir(&self, path: Path, options: OpenDirOptions) Error!Dir {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.open_encoded_dir(encoded, options)
    }

    pub fn create_file(&self, path: Path, options: CreateOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.create_encoded_file(encoded, options)
    }

    pub fn create_dir(&self, path: Path, options: CreateDirOptions) Error!void {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.create_encoded_dir(encoded, options)
    }

    pub fn delete_file(&self, path: Path) Error!void {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.delete_encoded_file(encoded)
    }

    pub fn delete_dir(&self, path: Path) Error!void {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.delete_encoded_dir(encoded)
    }

    pub fn rename(&self, old_path: Path, new_path: Path) Error!void {
        self.rename_to(old_path, self, new_path)
    }

    pub fn rename_to(&self, old_path: Path, new_dir: &Dir, new_path: Path) Error!void {
        var old_storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        var new_storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let old_encoded = old_path.encode(&mut old_storage[..]).?;
        let new_encoded = new_path.encode(&mut new_storage[..]).?;
        self.rename_encoded_to(old_encoded, new_dir, new_encoded)
    }

    pub fn metadata(&self, path: Path, options: MetadataOptions) Error!Metadata {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.encoded_metadata(encoded, options)
    }

    pub fn open_encoded_file(&self, path: EncodedPath, options: OpenOptions) Error!File {
        let handle = os::open_at(
            self.handle,
            path.ptr(),
            options.os_mode(),
            false,
            false,
            false,
            0,
        ).map_err[Error](&os::Error::as_fs_error).?;
        !File::from_owned_descriptor(handle)
    }

    pub fn open_encoded_dir(&self, path: EncodedPath, options: OpenDirOptions) Error!Dir {
        let handle = os::open_dir_at(
            self.handle,
            path.ptr(),
            options.follow_symlinks(),
        ).map_err[Error](&os::Error::as_fs_error).?;
        !Dir::from_owned_descriptor(handle)
    }

    pub fn create_encoded_file(&self, path: EncodedPath, options: CreateOptions) Error!File {
        let handle = os::open_at(
            self.handle,
            path.ptr(),
            options.os_mode(),
            true,
            options.truncate(),
            options.is_exclusive(),
            options.permissions(),
        ).map_err[Error](&os::Error::as_fs_error).?;
        !File::from_owned_descriptor(handle)
    }

    pub fn create_encoded_dir(&self, path: EncodedPath, options: CreateDirOptions) Error!void {
        os::create_dir_at(
            self.handle,
            path.ptr(),
            options.permissions(),
        ).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn delete_encoded_file(&self, path: EncodedPath) Error!void {
        os::delete_file_at(self.handle, path.ptr()).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn delete_encoded_dir(&self, path: EncodedPath) Error!void {
        os::delete_dir_at(self.handle, path.ptr()).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn rename_encoded_to(&self, old_path: EncodedPath, new_dir: &Dir, new_path: EncodedPath) Error!void {
        os::rename_at(
            self.handle,
            old_path.ptr(),
            new_dir.handle,
            new_path.ptr(),
        ).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn encoded_metadata(&self, path: EncodedPath, options: MetadataOptions) Error!Metadata {
        let metadata = os::metadata_at(
            self.handle,
            path.ptr(),
            options.follow_symlinks(),
        ).map_err[Error](&os::Error::as_fs_error).?;
        !metadata.as_fs_metadata()
    }

    pub fn close(&self) Error!void {
        self.handle.close().map_err[Error](&os::Error::as_fs_error)
    }
}

extend File {
    fn from_owned_descriptor(handle: os::FileDescriptor) File {
        { handle: handle }
    }

    pub fn open(path: Path, options: OpenOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        let handle = os::open_at(
            os::cwd(),
            encoded.ptr(),
            options.os_mode(),
            false,
            false,
            false,
            0,
        ).map_err[Error](&os::Error::as_fs_error).?;
        !File::from_owned_descriptor(handle)
    }

    pub fn create(path: Path, options: CreateOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        let handle = os::open_at(
            os::cwd(),
            encoded.ptr(),
            options.os_mode(),
            true,
            options.truncate(),
            options.is_exclusive(),
            options.permissions(),
        ).map_err[Error](&os::Error::as_fs_error).?;
        !File::from_owned_descriptor(handle)
    }

    pub fn handle(&self) os::FileDescriptor {
        self.handle
    }

    pub fn seek_to(&self, offset: u64) Error!u64 {
        if offset > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.handle.seek(offset as i64, os::SeekWhence::Start).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn seek_by(&self, delta: i64) Error!u64 {
        self.handle.seek(delta, os::SeekWhence::Current).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn seek_from_end(&self, delta: i64) Error!u64 {
        self.handle.seek(delta, os::SeekWhence::End).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn len(&self) Error!u64 {
        let metadata = self.metadata().?;
        !metadata.size()
    }

    pub fn metadata(&self) Error!Metadata {
        let metadata = self.handle.metadata().map_err[Error](&os::Error::as_fs_error).?;
        !metadata.as_fs_metadata()
    }

    pub fn truncate(&self, len: u64) Error!void {
        if len > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.handle.truncate(len).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn sync(&self) Error!void {
        self.handle.sync().map_err[Error](&os::Error::as_fs_error)
    }

    pub fn sync_data(&self) Error!void {
        self.handle.sync_data().map_err[Error](&os::Error::as_fs_error)
    }

    pub fn close(&self) Error!void {
        self.handle.close().map_err[Error](&os::Error::as_fs_error)
    }
}
