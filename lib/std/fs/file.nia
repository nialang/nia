import std.fs.options;
import std.fs.path;
import std.fs.types;
import std.os;
import std.result;

using types::{CreateOptions, Dir, EncodedPath, Error, File, OpenOptions, Path};

extend Dir {
    pub fn init(handle: os::FileDescriptor) Dir {
        { handle: handle }
    }

    pub fn cwd() Dir {
        Dir::init(os::cwd())
    }

    pub fn open_file(&self, path: Path, options: OpenOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.open_encoded_file(encoded, options)
    }

    pub fn create_file(&self, path: Path, options: CreateOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.create_encoded_file(encoded, options)
    }

    pub fn delete_file(&self, path: Path) Error!void {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = path.encode(&mut storage[..]).?;
        self.delete_encoded_file(encoded)
    }

    pub fn open_encoded_file(&self, path: EncodedPath, options: OpenOptions) Error!File {
        let handle = os::open_at(
            self.handle,
            path.ptr(),
            options.os_mode(),
            false,
            false,
            false,
            0,
        ).map_err[Error](&os::Error::as_fs_error).?;
        !File::init(handle)
    }

    pub fn create_encoded_file(&self, path: EncodedPath, options: CreateOptions) Error!File {
        let handle = os::open_at(
            self.handle,
            path.ptr(),
            options.os_mode(),
            true,
            options.truncate(),
            options.is_exclusive(),
            options.permissions(),
        ).map_err[Error](&os::Error::as_fs_error).?;
        !File::init(handle)
    }

    pub fn delete_encoded_file(&self, path: EncodedPath) Error!void {
        os::delete_file_at(self.handle, path.ptr()).map_err[Error](&os::Error::as_fs_error)
    }
}

extend File {
    pub fn init(handle: os::FileDescriptor) File {
        { handle: handle }
    }

    pub fn stdin() File {
        File::init(os::FileDescriptor::stdin())
    }

    pub fn stdout() File {
        File::init(os::FileDescriptor::stdout())
    }

    pub fn stderr() File {
        File::init(os::FileDescriptor::stderr())
    }

    pub fn handle(&self) os::FileDescriptor {
        self.handle
    }

    pub fn close(&self) Error!void {
        self.handle.close().map_err[Error](&os::Error::as_fs_error)
    }
}
