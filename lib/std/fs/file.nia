using pkg::fs::convert;
using pkg::fs::options;
using pkg::fs::path;
using pkg::fs::types;
using pkg::os;

using types::{
    CreateDirOptions,
    CreateOptions,
    Dir,
    DirIterator,
    Error,
    File,
    Metadata,
    MetadataOptions,
    NativePathView,
    OpenDirOptions,
    OpenOptions,
    Operation,
    OperationError,
    PathView,
};

pub fn getCwd(buffer: &mut [u8]) Error!&[u8] {
    os::getcwd(buffer).as_fs_error()
}

const max_path_bytes: usize = os::maxPathBytes;
const max_i64_as_u64: u64 = 9223372036854775807u64;

extend Dir {
    fn fromOwnedDescriptor(handle: os::FileHandle) Dir {
        { handle: ?handle }
    }

    pub fn cwd() Error!Dir {
        let current = b".\0";
        let handle = os::openDirAt(
            os::cwd(),
            &current[0],
            true,
        ).as_fs_error().?;
        !Dir::fromOwnedDescriptor(handle)
    }

    pub fn openFile(&self, path: PathView, options: OpenOptions) OperationError!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::OpenFile).?;
        self.openNativeFile(native, options)
    }

    pub fn openDir(&self, path: PathView, options: OpenDirOptions) OperationError!Dir {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::OpenDir).?;
        self.openNativeDir(native, options)
    }

    pub fn createFile(&self, path: PathView, options: CreateOptions) OperationError!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::CreateFile).?;
        self.createNativeFile(native, options)
    }

    pub fn createDir(&self, path: PathView, options: CreateDirOptions) OperationError!void {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::CreateDir).?;
        self.createNativeDir(native, options)
    }

    pub fn deleteFile(&self, path: PathView) OperationError!void {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::DeleteFile).?;
        self.deleteNativeFile(native)
    }

    pub fn deleteDir(&self, path: PathView) OperationError!void {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::DeleteDir).?;
        self.deleteNativeDir(native)
    }

    pub fn rename(&self, oldPath: PathView, newPath: PathView) OperationError!void {
        self.renameTo(oldPath, self, newPath)
    }

    pub fn renameTo(&self, oldPath: PathView, newDir: &Dir, newPath: PathView) OperationError!void {
        let mut oldStorage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let mut newStorage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let oldNative = oldPath.encode(&mut oldStorage[..]).withOperation(Operation::Rename).?;
        let newNative = newPath.encode(&mut newStorage[..]).withOperation(Operation::Rename).?;
        self.renameNativeTo(oldNative, newDir, newNative)
    }

    pub fn metadata(&self, path: PathView, options: MetadataOptions) OperationError!Metadata {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::Metadata).?;
        self.nativeMetadata(native, options)
    }

    pub fn entries(&mut self, buffer: &mut [u8]) Error!DirIterator {
        if buffer.len() == 0 {
            Error::Invalid!
        } else {
            !DirIterator::init(os::DirectoryReader::init(self.borrowHandle().?, buffer))
        }
    }

    pub fn openNativeFile(&self, path: NativePathView, options: OpenOptions) OperationError!File {
        let handle = os::openAt(
            self.borrowHandle().withOperation(Operation::OpenFile).?,
            path.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::OpenFile).?,
            false,
            false,
            false,
            0,
        ).as_fs_error().withOperation(Operation::OpenFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn openNativeDir(&self, path: NativePathView, options: OpenDirOptions) OperationError!Dir {
        let handle = os::openDirAt(
            self.borrowHandle().withOperation(Operation::OpenDir).?,
            path.ptr(),
            options.followSymlinks(),
        ).as_fs_error().withOperation(Operation::OpenDir).?;
        !Dir::fromOwnedDescriptor(handle)
    }

    pub fn createNativeFile(&self, path: NativePathView, options: CreateOptions) OperationError!File {
        let handle = os::openAt(
            self.borrowHandle().withOperation(Operation::CreateFile).?,
            path.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::CreateFile).?,
            true,
            options.truncate(),
            options.isExclusive(),
            options.permissions(),
        ).as_fs_error().withOperation(Operation::CreateFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn createNativeDir(&self, path: NativePathView, options: CreateDirOptions) OperationError!void {
        os::createDirAt(
            self.borrowHandle().withOperation(Operation::CreateDir).?,
            path.ptr(),
            options.permissions(),
        ).as_fs_error().withOperation(Operation::CreateDir)
    }

    pub fn deleteNativeFile(&self, path: NativePathView) OperationError!void {
        os::deleteFileAt(
            self.borrowHandle().withOperation(Operation::DeleteFile).?,
            path.ptr(),
        ).as_fs_error().withOperation(Operation::DeleteFile)
    }

    pub fn deleteNativeDir(&self, path: NativePathView) OperationError!void {
        os::deleteDirAt(
            self.borrowHandle().withOperation(Operation::DeleteDir).?,
            path.ptr(),
        ).as_fs_error().withOperation(Operation::DeleteDir)
    }

    pub fn renameNativeTo(&self, oldPath: NativePathView, newDir: &Dir, newPath: NativePathView) OperationError!void {
        os::renameAt(
            self.borrowHandle().withOperation(Operation::Rename).?,
            oldPath.ptr(),
            newDir.borrowHandle().withOperation(Operation::Rename).?,
            newPath.ptr(),
        ).as_fs_error().withOperation(Operation::Rename)
    }

    pub fn nativeMetadata(&self, path: NativePathView, options: MetadataOptions) OperationError!Metadata {
        let metadata = os::metadataAt(
            self.borrowHandle().withOperation(Operation::Metadata).?,
            path.ptr(),
            options.followSymlinks(),
        ).as_fs_error().withOperation(Operation::Metadata).?;
        !metadata.as_fs_metadata()
    }

    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        switch self.handle {
            ?handle => {
                !handle
            },
            null => {
                Error::BadFd!
            },
        }
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn close(&mut self) Error!void {
        let handle = self.takeHandle().?;
        handle.close().as_fs_error()
    }
}

extend File {
    fn fromOwnedDescriptor(handle: os::FileHandle) File {
        { handle: ?handle }
    }

    pub fn open(path: PathView, options: OpenOptions) OperationError!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::OpenFile).?;
        let handle = os::openAt(
            os::cwd(),
            native.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::OpenFile).?,
            false,
            false,
            false,
            0,
        ).as_fs_error().withOperation(Operation::OpenFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn create(path: PathView, options: CreateOptions) OperationError!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::CreateFile).?;
        let handle = os::openAt(
            os::cwd(),
            native.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::CreateFile).?,
            true,
            options.truncate(),
            options.isExclusive(),
            options.permissions(),
        ).as_fs_error().withOperation(Operation::CreateFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        switch self.handle {
            ?handle => {
                !handle
            },
            null => {
                Error::BadFd!
            },
        }
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn seekTo(&self, offset: u64) Error!u64 {
        if offset > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.borrowHandle().?.seek(offset as i64, os::SeekWhence::Start).as_fs_error()
    }

    pub fn seekBy(&self, delta: i64) Error!u64 {
        self.borrowHandle().?.seek(delta, os::SeekWhence::Current).as_fs_error()
    }

    pub fn seekFromEnd(&self, delta: i64) Error!u64 {
        self.borrowHandle().?.seek(delta, os::SeekWhence::End).as_fs_error()
    }

    pub fn len(&self) Error!u64 {
        let metadata = self.metadata().?;
        !metadata.size()
    }

    pub fn metadata(&self) Error!Metadata {
        let metadata = self.borrowHandle().?.metadata().as_fs_error().?;
        !metadata.as_fs_metadata()
    }

    pub fn truncate(&self, len: u64) Error!void {
        if len > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.borrowHandle().?.truncate(len).as_fs_error()
    }

    pub fn setPermissions(&self, permissions: u32) Error!void {
        self.borrowHandle().?.setPermissions(permissions).as_fs_error()
    }

    pub fn sync(&self) Error!void {
        self.borrowHandle().?.sync().as_fs_error()
    }

    pub fn syncData(&self) Error!void {
        self.borrowHandle().?.syncData().as_fs_error()
    }

    pub fn close(&mut self) Error!void {
        let handle = self.takeHandle().?;
        handle.close().as_fs_error()
    }
}
