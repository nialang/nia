using pkg::fs::convert;
using pkg::fs::options;
using pkg::fs::path;
using pkg::fs::types;
using pkg::os;

using types::{
    CreateDirOptions,
    CreateOptions,
    Dir,
    DirIterator,
    Error,
    File,
    Metadata,
    MetadataOptions,
    OpenDirOptions,
    OpenOptions,
    Operation,
    OperationError,
    PathView,
    RelativeNativePathView,
    RelativePathView,
};

pub fn getCwd(buffer: &mut [u8]) Error!&[u8] {
    !(os::getCwd(buffer).?)
}

const maxI64AsU64: u64 = 9223372036854775807;

struct ParentSplit {
    end: usize,
    separator: ?usize,
}

fn lowerNativeBytes(
    bytes: &[u8],
    storage: &mut [u8],
    operation: Operation,
) OperationError!RelativeNativePathView {
    let terminatedLen = match bytes.len().checkedAdd(1) {
        ?value => value,
        null => return OperationError::Path {
            operation: operation,
            cause: types::PathError::TooLong,
        }!,
    };
    if terminatedLen > storage.len() {
        return OperationError::Path {
            operation: operation,
            cause: types::PathError::TooLong,
        }!;
    }
    let mut index: usize = 0;
    while index < bytes.len() {
        storage[index] = bytes[index];
        index += 1;
    }
    storage[index] = 0;
    RelativeNativePathView::fromBytes(&storage[0..terminatedLen]).withOperation(operation)
}

fn parentSplit(bytes: &[u8], trimTrailingSeparators: bool) ParentSplit {
    let mut end = bytes.len();
    while trimTrailingSeparators and end != 0 and bytes[end - 1] == b'/' {
        end -= 1;
    }
    let mut index = end;
    while index != 0 {
        index -= 1;
        if bytes[index] == b'/' {
            return .{ end, separator: ?index };
        }
    }
    .{ end, separator: null }
}

extend Dir {
    fn fromOwnedDescriptor(handle: os::FileHandle) Dir {
        .{ handle: ?handle }
    }

    pub fn cwd() Error!Dir {
        let current = b".\0";
        let handle = os::openAtBeneath(
            os::cwd(),
            &current[0],
            os::OpenMode::ReadOnly,
            true,
            false,
            false,
            false,
            0,
            true,
        ).?;
        !Dir::fromOwnedDescriptor(handle)
    }

    pub fn openFile(&self, path: RelativePathView, options: OpenOptions) OperationError!File {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::OpenFile).?;
        self.openNativeFile(native, options)
    }

    pub fn openDir(&self, path: RelativePathView, options: OpenDirOptions) OperationError!Dir {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::OpenDir).?;
        self.openNativeDir(native, options)
    }

    pub fn createFile(&self, path: RelativePathView, options: CreateOptions) OperationError!File {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::CreateFile).?;
        self.createNativeFile(native, options)
    }

    pub fn createDir(&self, path: RelativePathView, options: CreateDirOptions) OperationError!() {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::CreateDir).?;
        self.createNativeDir(native, options)
    }

    pub fn deleteFile(&self, path: RelativePathView) OperationError!() {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::DeleteFile).?;
        self.deleteNativeFile(native)
    }

    pub fn deleteDir(&self, path: RelativePathView) OperationError!() {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::DeleteDir).?;
        self.deleteNativeDir(native)
    }

    pub fn rename(&self, oldPath: RelativePathView, newPath: RelativePathView) OperationError!() {
        self.renameTo(oldPath, self, newPath)
    }

    pub fn renameTo(
        &self,
        oldPath: RelativePathView,
        newDir: &Dir,
        newPath: RelativePathView,
    ) OperationError!() {
        let mut oldStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let oldNative = oldPath.encode(&mut oldStorage[..]).withOperation(Operation::Rename).?;
        let mut newStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let newNative = newPath.encode(&mut newStorage[..]).withOperation(Operation::Rename).?;
        self.renameNativeTo(oldNative, newDir, newNative)
    }

    pub fn metadata(&self, path: RelativePathView, options: MetadataOptions) OperationError!Metadata {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::Metadata).?;
        self.nativeMetadata(native, options)
    }

    pub fn entries(&mut self, buffer: &mut [u8]) Error!DirIterator {
        if buffer.len() == 0 {
            Error::Invalid!
        } else {
            _ = self.borrowHandle().?;
            !DirIterator::init(self, os::DirectoryReader::init(buffer))
        }
    }

    pub fn openNativeFile(&self, path: RelativeNativePathView, options: OpenOptions) OperationError!File {
        let handle = os::openAtBeneath(
            self.borrowHandle().withOperation(Operation::OpenFile).?,
            path.ptr(),
            options.osMode().withOperation(Operation::OpenFile).?,
            false,
            false,
            false,
            false,
            0,
            true,
        ).withOperation(Operation::OpenFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn openNativeDir(&self, path: RelativeNativePathView, options: OpenDirOptions) OperationError!Dir {
        let handle = os::openAtBeneath(
            self.borrowHandle().withOperation(Operation::OpenDir).?,
            path.ptr(),
            os::OpenMode::ReadOnly,
            true,
            false,
            false,
            false,
            0,
            options.followSymlinks(),
        ).withOperation(Operation::OpenDir).?;
        !Dir::fromOwnedDescriptor(handle)
    }

    pub fn createNativeFile(&self, path: RelativeNativePathView, options: CreateOptions) OperationError!File {
        let handle = os::openAtBeneath(
            self.borrowHandle().withOperation(Operation::CreateFile).?,
            path.ptr(),
            options.osMode().withOperation(Operation::CreateFile).?,
            false,
            true,
            options.truncate(),
            options.isExclusive(),
            options.permissions(),
            true,
        ).withOperation(Operation::CreateFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn createNativeDir(&self, path: RelativeNativePathView, options: CreateDirOptions) OperationError!() {
        let bytes = path.bytes();
        let split = parentSplit(bytes, true);
        let current = b".";
        let mut parentStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let parent = if split.separator is ?index {
            lowerNativeBytes(&bytes[0..index], &mut parentStorage[..], Operation::CreateDir).?
        } else {
            lowerNativeBytes(&current[..], &mut parentStorage[..], Operation::CreateDir).?
        };
        let nameStart = if split.separator is ?index { index + 1 } else { 0 };
        let mut nameStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let name = lowerNativeBytes(
            &bytes[nameStart..split.end],
            &mut nameStorage[..],
            Operation::CreateDir,
        ).?;
        os::createDirAtBeneath(
            self.borrowHandle().withOperation(Operation::CreateDir).?,
            parent.ptr(),
            name.ptr(),
            options.permissions(),
        ).withOperation(Operation::CreateDir)
    }

    pub fn deleteNativeFile(&self, path: RelativeNativePathView) OperationError!() {
        self.deleteNative(path, Operation::DeleteFile, false, false)
    }

    pub fn deleteNativeDir(&self, path: RelativeNativePathView) OperationError!() {
        self.deleteNative(path, Operation::DeleteDir, true, true)
    }

    fn deleteNative(
        &self,
        path: RelativeNativePathView,
        operation: Operation,
        directory: bool,
        trimTrailingSeparators: bool,
    ) OperationError!() {
        let bytes = path.bytes();
        let split = parentSplit(bytes, trimTrailingSeparators);
        let current = b".";
        let mut parentStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let parent = if split.separator is ?index {
            lowerNativeBytes(&bytes[0..index], &mut parentStorage[..], operation).?
        } else {
            lowerNativeBytes(&current[..], &mut parentStorage[..], operation).?
        };
        let nameStart = if split.separator is ?index { index + 1 } else { 0 };
        let mut nameStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let name = lowerNativeBytes(&bytes[nameStart..split.end], &mut nameStorage[..], operation).?;
        os::deleteAtBeneath(
            self.borrowHandle().withOperation(operation).?,
            parent.ptr(),
            name.ptr(),
            directory,
        ).withOperation(operation)
    }

    pub fn renameNativeTo(
        &self,
        oldPath: RelativeNativePathView,
        newDir: &Dir,
        newPath: RelativeNativePathView,
    ) OperationError!() {
        let oldBytes = oldPath.bytes();
        let oldSplit = parentSplit(oldBytes, false);
        let current = b".";
        let mut oldParentStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let oldParent = if oldSplit.separator is ?index {
            lowerNativeBytes(&oldBytes[0..index], &mut oldParentStorage[..], Operation::Rename).?
        } else {
            lowerNativeBytes(&current[..], &mut oldParentStorage[..], Operation::Rename).?
        };
        let oldNameStart = if oldSplit.separator is ?index { index + 1 } else { 0 };
        let mut oldNameStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let oldName = lowerNativeBytes(
            &oldBytes[oldNameStart..oldSplit.end],
            &mut oldNameStorage[..],
            Operation::Rename,
        ).?;

        let newBytes = newPath.bytes();
        let newSplit = parentSplit(newBytes, false);
        let mut newParentStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let newParent = if newSplit.separator is ?index {
            lowerNativeBytes(&newBytes[0..index], &mut newParentStorage[..], Operation::Rename).?
        } else {
            lowerNativeBytes(&current[..], &mut newParentStorage[..], Operation::Rename).?
        };
        let newNameStart = if newSplit.separator is ?index { index + 1 } else { 0 };
        let mut newNameStorage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let newName = lowerNativeBytes(
            &newBytes[newNameStart..newSplit.end],
            &mut newNameStorage[..],
            Operation::Rename,
        ).?;

        os::renameAtBeneath(
            self.borrowHandle().withOperation(Operation::Rename).?,
            oldParent.ptr(),
            oldName.ptr(),
            newDir.borrowHandle().withOperation(Operation::Rename).?,
            newParent.ptr(),
            newName.ptr(),
        ).withOperation(Operation::Rename)
    }

    pub fn nativeMetadata(&self, path: RelativeNativePathView, options: MetadataOptions) OperationError!Metadata {
        let metadata = os::metadataAtBeneath(
            self.borrowHandle().withOperation(Operation::Metadata).?,
            path.ptr(),
            options.followSymlinks(),
        ).withOperation(Operation::Metadata).?;
        !metadata.asFsMetadata()
    }

}

extend File {
    fn fromOwnedDescriptor(handle: os::FileHandle) File {
        .{ handle: ?handle }
    }

    pub fn open(path: PathView, options: OpenOptions) OperationError!File {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::OpenFile).?;
        let handle = os::openAt(
            os::cwd(),
            native.ptr(),
            options.osMode().withOperation(Operation::OpenFile).?,
            false,
            false,
            false,
            0,
        ).withOperation(Operation::OpenFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn create(path: PathView, options: CreateOptions) OperationError!File {
        let mut storage: [u8; os::maxPathBytes] = [0; os::maxPathBytes];
        let native = path.encode(&mut storage[..]).withOperation(Operation::CreateFile).?;
        let handle = os::openAt(
            os::cwd(),
            native.ptr(),
            options.osMode().withOperation(Operation::CreateFile).?,
            true,
            options.truncate(),
            options.isExclusive(),
            options.permissions(),
        ).withOperation(Operation::CreateFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn seekTo(&self, offset: u64) Error!u64 {
        if offset > maxI64AsU64 {
            return Error::OutOfRange!;
        }
        !(self.borrowHandle().?.seek(offset as i64, os::SeekWhence::Start).?)
    }

    pub fn seekBy(&self, delta: i64) Error!u64 {
        !(self.borrowHandle().?.seek(delta, os::SeekWhence::Current).?)
    }

    pub fn seekFromEnd(&self, delta: i64) Error!u64 {
        !(self.borrowHandle().?.seek(delta, os::SeekWhence::End).?)
    }

    pub fn len(&self) Error!u64 {
        let metadata = self.metadata().?;
        !metadata.size()
    }

    pub fn metadata(&self) Error!Metadata {
        let metadata = self.borrowHandle().?.metadata().?;
        !metadata.asFsMetadata()
    }

    pub fn truncate(&self, len: u64) Error!() {
        if len > maxI64AsU64 {
            return Error::OutOfRange!;
        }
        !(self.borrowHandle().?.truncate(len).?)
    }

    pub fn setPermissions(&self, permissions: u32) Error!() {
        !(self.borrowHandle().?.setPermissions(permissions).?)
    }

    pub fn sync(&self) Error!() {
        !(self.borrowHandle().?.sync().?)
    }

    pub fn syncData(&self) Error!() {
        !(self.borrowHandle().?.syncData().?)
    }

}
