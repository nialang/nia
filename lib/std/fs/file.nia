using pkg::fs::convert;
using pkg::fs::options;
using pkg::fs::path;
using pkg::fs::types;
using pkg::os;

using types::{
    CreateDirOptions,
    CreateOptions,
    Dir,
    EncodedPath,
    Error,
    File,
    Metadata,
    MetadataOptions,
    OpenDirOptions,
    OpenOptions,
    PathView,
    DirIterator,
};

pub fn getcwd(buffer: &mut [u8]) Error!&[u8] {
    os::getcwd(buffer).as_fs_error()
}

const max_path_bytes: usize = os::maxPathBytes;
const max_i64_as_u64: u64 = 9223372036854775807u64;

extend Dir {
    fn from_owned_descriptor(handle: os::FileHandle) Dir {
        { handle: ?handle }
    }

    pub fn cwd() Error!Dir {
        let current = b".\0";
        let handle = os::openDirAt(
            os::cwd(),
            &current[0],
            true,
        ).as_fs_error().?;
        !Dir::from_owned_descriptor(handle)
    }

    pub fn open_file(&self, path: PathView, options: OpenOptions) Error!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        self.open_encoded_file(encoded, options)
    }

    pub fn open_dir(&self, path: PathView, options: OpenDirOptions) Error!Dir {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        self.open_encoded_dir(encoded, options)
    }

    pub fn create_file(&self, path: PathView, options: CreateOptions) Error!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        self.create_encoded_file(encoded, options)
    }

    pub fn create_dir(&self, path: PathView, options: CreateDirOptions) Error!void {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        self.create_encoded_dir(encoded, options)
    }

    pub fn delete_file(&self, path: PathView) Error!void {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        self.delete_encoded_file(encoded)
    }

    pub fn delete_dir(&self, path: PathView) Error!void {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        self.delete_encoded_dir(encoded)
    }

    pub fn rename(&self, old_path: PathView, new_path: PathView) Error!void {
        self.rename_to(old_path, self, new_path)
    }

    pub fn rename_to(&self, old_path: PathView, new_dir: &Dir, new_path: PathView) Error!void {
        let mut old_storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let mut new_storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let old_encoded = old_path.encode(&mut old_storage[..]).asFsError().?;
        let new_encoded = new_path.encode(&mut new_storage[..]).asFsError().?;
        self.rename_encoded_to(old_encoded, new_dir, new_encoded)
    }

    pub fn metadata(&self, path: PathView, options: MetadataOptions) Error!Metadata {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        self.encoded_metadata(encoded, options)
    }

    pub fn entries(&mut self, buffer: &mut [u8]) Error!DirIterator {
        if buffer.len() == 0 {
            Error::Invalid!
        } else {
            !DirIterator::init(os::DirectoryReader::init(self.borrowHandle().?, buffer))
        }
    }

    pub fn open_encoded_file(&self, path: EncodedPath, options: OpenOptions) Error!File {
        let handle = os::openAt(
            self.borrowHandle().?,
            path.ptr(),
            options.os_mode().as_fs_error().?,
            false,
            false,
            false,
            0,
        ).as_fs_error().?;
        !File::from_owned_descriptor(handle)
    }

    pub fn open_encoded_dir(&self, path: EncodedPath, options: OpenDirOptions) Error!Dir {
        let handle = os::openDirAt(
            self.borrowHandle().?,
            path.ptr(),
            options.follow_symlinks(),
        ).as_fs_error().?;
        !Dir::from_owned_descriptor(handle)
    }

    pub fn create_encoded_file(&self, path: EncodedPath, options: CreateOptions) Error!File {
        let handle = os::openAt(
            self.borrowHandle().?,
            path.ptr(),
            options.os_mode().as_fs_error().?,
            true,
            options.truncate(),
            options.is_exclusive(),
            options.permissions(),
        ).as_fs_error().?;
        !File::from_owned_descriptor(handle)
    }

    pub fn create_encoded_dir(&self, path: EncodedPath, options: CreateDirOptions) Error!void {
        os::createDirAt(
            self.borrowHandle().?,
            path.ptr(),
            options.permissions(),
        ).as_fs_error()
    }

    pub fn delete_encoded_file(&self, path: EncodedPath) Error!void {
        os::deleteFileAt(self.borrowHandle().?, path.ptr()).as_fs_error()
    }

    pub fn delete_encoded_dir(&self, path: EncodedPath) Error!void {
        os::deleteDirAt(self.borrowHandle().?, path.ptr()).as_fs_error()
    }

    pub fn rename_encoded_to(&self, old_path: EncodedPath, new_dir: &Dir, new_path: EncodedPath) Error!void {
        os::renameAt(
            self.borrowHandle().?,
            old_path.ptr(),
            new_dir.borrowHandle().?,
            new_path.ptr(),
        ).as_fs_error()
    }

    pub fn encoded_metadata(&self, path: EncodedPath, options: MetadataOptions) Error!Metadata {
        let metadata = os::metadataAt(
            self.borrowHandle().?,
            path.ptr(),
            options.follow_symlinks(),
        ).as_fs_error().?;
        !metadata.as_fs_metadata()
    }

    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        switch self.handle {
            ?handle => {
                !handle
            },
            null => {
                Error::BadFd!
            },
        }
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn close(&mut self) Error!void {
        let handle = self.takeHandle().?;
        handle.close().as_fs_error()
    }
}

extend File {
    fn from_owned_descriptor(handle: os::FileHandle) File {
        { handle: ?handle }
    }

    pub fn open(path: PathView, options: OpenOptions) Error!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        let handle = os::openAt(
            os::cwd(),
            encoded.ptr(),
            options.os_mode().as_fs_error().?,
            false,
            false,
            false,
            0,
        ).as_fs_error().?;
        !File::from_owned_descriptor(handle)
    }

    pub fn create(path: PathView, options: CreateOptions) Error!File {
        let mut storage: [max_path_bytes]u8 = [_]u8[0; max_path_bytes];
        let encoded = path.encode(&mut storage[..]).asFsError().?;
        let handle = os::openAt(
            os::cwd(),
            encoded.ptr(),
            options.os_mode().as_fs_error().?,
            true,
            options.truncate(),
            options.is_exclusive(),
            options.permissions(),
        ).as_fs_error().?;
        !File::from_owned_descriptor(handle)
    }

    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        switch self.handle {
            ?handle => {
                !handle
            },
            null => {
                Error::BadFd!
            },
        }
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn seek_to(&self, offset: u64) Error!u64 {
        if offset > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.borrowHandle().?.seek(offset as i64, os::SeekWhence::Start).as_fs_error()
    }

    pub fn seek_by(&self, delta: i64) Error!u64 {
        self.borrowHandle().?.seek(delta, os::SeekWhence::Current).as_fs_error()
    }

    pub fn seek_from_end(&self, delta: i64) Error!u64 {
        self.borrowHandle().?.seek(delta, os::SeekWhence::End).as_fs_error()
    }

    pub fn len(&self) Error!u64 {
        let metadata = self.metadata().?;
        !metadata.size()
    }

    pub fn metadata(&self) Error!Metadata {
        let metadata = self.borrowHandle().?.metadata().as_fs_error().?;
        !metadata.as_fs_metadata()
    }

    pub fn truncate(&self, len: u64) Error!void {
        if len > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.borrowHandle().?.truncate(len).as_fs_error()
    }

    pub fn setPermissions(&self, permissions: u32) Error!void {
        self.borrowHandle().?.setPermissions(permissions).as_fs_error()
    }

    pub fn sync(&self) Error!void {
        self.borrowHandle().?.sync().as_fs_error()
    }

    pub fn syncData(&self) Error!void {
        self.borrowHandle().?.syncData().as_fs_error()
    }

    pub fn close(&mut self) Error!void {
        let handle = self.takeHandle().?;
        handle.close().as_fs_error()
    }
}
