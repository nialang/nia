using pkg::cstring;
using pkg::fs::convert;
using pkg::fs::options;
using pkg::fs::path;
using pkg::fs::types;
using pkg::mem;
using pkg::os;

using types::{
    CreateDirOptions,
    CreateOptions,
    Dir,
    DirIterator,
    Error,
    File,
    Metadata,
    MetadataOptions,
    NativePathView,
    OpenDirOptions,
    OpenOptions,
    Operation,
    OperationError,
    PathView,
    RelativeNativePathView,
    RelativePathView,
};

pub fn getCwd(buffer: &mut [u8]) Error!&[u8] {
    os::getcwd(buffer).as_fs_error()
}

const max_i64_as_u64: u64 = 9223372036854775807u64;

struct ParentSplit {
    end: usize,
    separator: ?usize,
}

fn lowerPath(
    allocator: &mut mem::Allocator,
    path: PathView,
    operation: Operation,
) OperationError!cstring::CString {
    switch cstring::CString::fromText(allocator, path.text()) {
        !value => !value,
        cstring::CStringBuildError::ContainsNul! => OperationError::Path {
            operation: operation,
            cause: types::PathError::ContainsNul,
        }!,
        cstring::CStringBuildError::Allocation(cause)! => OperationError::Allocation {
            operation: operation,
            cause: cause,
        }!,
    }
}

fn lowerNativeBytes(
    allocator: &mut mem::Allocator,
    bytes: &[u8],
    operation: Operation,
) OperationError!cstring::CString {
    switch cstring::CString::fromBytes(allocator, bytes) {
        !value => !value,
        cstring::CStringBuildError::ContainsNul! => OperationError::Path {
            operation: operation,
            cause: types::PathError::ContainsNul,
        }!,
        cstring::CStringBuildError::Allocation(cause)! => OperationError::Allocation {
            operation: operation,
            cause: cause,
        }!,
    }
}

fn parentSplit(bytes: &[u8], trimTrailingSeparators: bool) ParentSplit {
    let mut end = bytes.len();
    while trimTrailingSeparators and end != 0usize and bytes[end - 1usize] == b'/' {
        end -= 1usize;
    }
    let mut index = end;
    while index != 0usize {
        index -= 1usize;
        if bytes[index] == b'/' {
            return ParentSplit { end: end, separator: ?index };
        }
    }
    ParentSplit { end: end, separator: null }
}

extend Dir {
    fn fromOwnedDescriptor(handle: os::FileHandle) Dir {
        Self { handle: ?handle }
    }

    pub fn cwd() Error!Dir {
        let current = b".\0";
        let handle = os::openAtBeneath(
            os::cwd(),
            &current[0],
            os::OpenMode::ReadOnly,
            true,
            false,
            false,
            false,
            0,
            true,
        ).?;
        !Dir::fromOwnedDescriptor(handle)
    }

    pub fn openFile(&self, path: RelativePathView, options: OpenOptions) OperationError!File {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.openFileWithAllocator(allocator, path, options)
    }

    pub fn openFileWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativePathView,
        options: OpenOptions,
    ) OperationError!File {
        let mut owned = lowerPath(allocator, path.path(), Operation::OpenFile).?;
        defer owned.deinit(allocator).withOperation(Operation::OpenFile).?;
        let native = RelativeNativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::OpenFile).?;
        self.openNativeFile(native, options)
    }

    pub fn openDir(&self, path: RelativePathView, options: OpenDirOptions) OperationError!Dir {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.openDirWithAllocator(allocator, path, options)
    }

    pub fn openDirWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativePathView,
        options: OpenDirOptions,
    ) OperationError!Dir {
        let mut owned = lowerPath(allocator, path.path(), Operation::OpenDir).?;
        defer owned.deinit(allocator).withOperation(Operation::OpenDir).?;
        let native = RelativeNativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::OpenDir).?;
        self.openNativeDir(native, options)
    }

    pub fn createFile(&self, path: RelativePathView, options: CreateOptions) OperationError!File {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.createFileWithAllocator(allocator, path, options)
    }

    pub fn createFileWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativePathView,
        options: CreateOptions,
    ) OperationError!File {
        let mut owned = lowerPath(allocator, path.path(), Operation::CreateFile).?;
        defer owned.deinit(allocator).withOperation(Operation::CreateFile).?;
        let native = RelativeNativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::CreateFile).?;
        self.createNativeFile(native, options)
    }

    pub fn createDir(&self, path: RelativePathView, options: CreateDirOptions) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.createDirWithAllocator(allocator, path, options)
    }

    pub fn createDirWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativePathView,
        options: CreateDirOptions,
    ) OperationError!() {
        let mut owned = lowerPath(allocator, path.path(), Operation::CreateDir).?;
        defer owned.deinit(allocator).withOperation(Operation::CreateDir).?;
        let native = RelativeNativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::CreateDir).?;
        self.createNativeDirWithAllocator(allocator, native, options)
    }

    pub fn deleteFile(&self, path: RelativePathView) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.deleteFileWithAllocator(allocator, path)
    }

    pub fn deleteFileWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativePathView,
    ) OperationError!() {
        let mut owned = lowerPath(allocator, path.path(), Operation::DeleteFile).?;
        defer owned.deinit(allocator).withOperation(Operation::DeleteFile).?;
        let native = RelativeNativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::DeleteFile).?;
        self.deleteNativeFileWithAllocator(allocator, native)
    }

    pub fn deleteDir(&self, path: RelativePathView) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.deleteDirWithAllocator(allocator, path)
    }

    pub fn deleteDirWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativePathView,
    ) OperationError!() {
        let mut owned = lowerPath(allocator, path.path(), Operation::DeleteDir).?;
        defer owned.deinit(allocator).withOperation(Operation::DeleteDir).?;
        let native = RelativeNativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::DeleteDir).?;
        self.deleteNativeDirWithAllocator(allocator, native)
    }

    pub fn rename(&self, oldPath: RelativePathView, newPath: RelativePathView) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.renameWithAllocator(allocator, oldPath, newPath)
    }

    pub fn renameWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        oldPath: RelativePathView,
        newPath: RelativePathView,
    ) OperationError!() {
        self.renameToWithAllocator(allocator, oldPath, self, newPath)
    }

    pub fn renameTo(
        &self,
        oldPath: RelativePathView,
        newDir: &Dir,
        newPath: RelativePathView,
    ) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.renameToWithAllocator(allocator, oldPath, newDir, newPath)
    }

    pub fn renameToWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        oldPath: RelativePathView,
        newDir: &Dir,
        newPath: RelativePathView,
    ) OperationError!() {
        let mut oldOwned = lowerPath(allocator, oldPath.path(), Operation::Rename).?;
        defer oldOwned.deinit(allocator).withOperation(Operation::Rename).?;
        let mut newOwned = lowerPath(allocator, newPath.path(), Operation::Rename).?;
        defer newOwned.deinit(allocator).withOperation(Operation::Rename).?;
        let oldNative = RelativeNativePathView::fromBytes(oldOwned.nulTerminatedBytes()).withOperation(Operation::Rename).?;
        let newNative = RelativeNativePathView::fromBytes(newOwned.nulTerminatedBytes()).withOperation(Operation::Rename).?;
        self.renameNativeToWithAllocator(allocator, oldNative, newDir, newNative)
    }

    pub fn metadata(&self, path: RelativePathView, options: MetadataOptions) OperationError!Metadata {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.metadataWithAllocator(allocator, path, options)
    }

    pub fn metadataWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativePathView,
        options: MetadataOptions,
    ) OperationError!Metadata {
        let mut owned = lowerPath(allocator, path.path(), Operation::Metadata).?;
        defer owned.deinit(allocator).withOperation(Operation::Metadata).?;
        let native = RelativeNativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::Metadata).?;
        self.nativeMetadata(native, options)
    }

    pub fn entries(&mut self, buffer: &mut [u8]) Error!DirIterator {
        if buffer.len() == 0 {
            Error::Invalid!
        } else {
            !DirIterator::init(os::DirectoryReader::init(self.borrowHandle().?, buffer))
        }
    }

    pub fn openNativeFile(&self, path: RelativeNativePathView, options: OpenOptions) OperationError!File {
        let handle = os::openAtBeneath(
            self.borrowHandle().withOperation(Operation::OpenFile).?,
            path.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::OpenFile).?,
            false,
            false,
            false,
            false,
            0,
            true,
        ).as_fs_error().withOperation(Operation::OpenFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn openNativeDir(&self, path: RelativeNativePathView, options: OpenDirOptions) OperationError!Dir {
        let handle = os::openAtBeneath(
            self.borrowHandle().withOperation(Operation::OpenDir).?,
            path.ptr(),
            os::OpenMode::ReadOnly,
            true,
            false,
            false,
            false,
            0,
            options.followSymlinks(),
        ).as_fs_error().withOperation(Operation::OpenDir).?;
        !Dir::fromOwnedDescriptor(handle)
    }

    pub fn createNativeFile(&self, path: RelativeNativePathView, options: CreateOptions) OperationError!File {
        let handle = os::openAtBeneath(
            self.borrowHandle().withOperation(Operation::CreateFile).?,
            path.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::CreateFile).?,
            false,
            true,
            options.truncate(),
            options.isExclusive(),
            options.permissions(),
            true,
        ).as_fs_error().withOperation(Operation::CreateFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn createNativeDir(&self, path: RelativeNativePathView, options: CreateDirOptions) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.createNativeDirWithAllocator(allocator, path, options)
    }

    pub fn createNativeDirWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativeNativePathView,
        options: CreateDirOptions,
    ) OperationError!() {
        let bytes = path.bytes();
        let split = parentSplit(bytes, true);
        let current = b".";
        let mut parent = switch split.separator {
            ?index => lowerNativeBytes(allocator, &bytes[0..index], Operation::CreateDir).?,
            null => lowerNativeBytes(allocator, &current[..], Operation::CreateDir).?,
        };
        defer parent.deinit(allocator).withOperation(Operation::CreateDir).?;
        let nameStart = switch split.separator {
            ?index => index + 1usize,
            null => 0usize,
        };
        let mut name = lowerNativeBytes(allocator, &bytes[nameStart..split.end], Operation::CreateDir).?;
        defer name.deinit(allocator).withOperation(Operation::CreateDir).?;
        os::createDirAtBeneath(
            self.borrowHandle().withOperation(Operation::CreateDir).?,
            parent.rawPtr(),
            name.rawPtr(),
            options.permissions(),
        ).as_fs_error().withOperation(Operation::CreateDir)
    }

    pub fn deleteNativeFile(&self, path: RelativeNativePathView) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.deleteNativeFileWithAllocator(allocator, path)
    }

    pub fn deleteNativeFileWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativeNativePathView,
    ) OperationError!() {
        self.deleteNativeWithAllocator(allocator, path, Operation::DeleteFile, false, false)
    }

    pub fn deleteNativeDir(&self, path: RelativeNativePathView) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.deleteNativeDirWithAllocator(allocator, path)
    }

    pub fn deleteNativeDirWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativeNativePathView,
    ) OperationError!() {
        self.deleteNativeWithAllocator(allocator, path, Operation::DeleteDir, true, true)
    }

    fn deleteNativeWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        path: RelativeNativePathView,
        operation: Operation,
        directory: bool,
        trimTrailingSeparators: bool,
    ) OperationError!() {
        let bytes = path.bytes();
        let split = parentSplit(bytes, trimTrailingSeparators);
        let current = b".";
        let mut parent = switch split.separator {
            ?index => lowerNativeBytes(allocator, &bytes[0..index], operation).?,
            null => lowerNativeBytes(allocator, &current[..], operation).?,
        };
        defer parent.deinit(allocator).withOperation(operation).?;
        let nameStart = switch split.separator {
            ?index => index + 1usize,
            null => 0usize,
        };
        let mut name = lowerNativeBytes(allocator, &bytes[nameStart..split.end], operation).?;
        defer name.deinit(allocator).withOperation(operation).?;
        os::deleteAtBeneath(
            self.borrowHandle().withOperation(operation).?,
            parent.rawPtr(),
            name.rawPtr(),
            directory,
        ).as_fs_error().withOperation(operation)
    }

    pub fn renameNativeTo(
        &self,
        oldPath: RelativeNativePathView,
        newDir: &Dir,
        newPath: RelativeNativePathView,
    ) OperationError!() {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        self.renameNativeToWithAllocator(allocator, oldPath, newDir, newPath)
    }

    pub fn renameNativeToWithAllocator(
        &self,
        allocator: &mut mem::Allocator,
        oldPath: RelativeNativePathView,
        newDir: &Dir,
        newPath: RelativeNativePathView,
    ) OperationError!() {
        let oldBytes = oldPath.bytes();
        let oldSplit = parentSplit(oldBytes, false);
        let current = b".";
        let mut oldParent = switch oldSplit.separator {
            ?index => lowerNativeBytes(allocator, &oldBytes[0..index], Operation::Rename).?,
            null => lowerNativeBytes(allocator, &current[..], Operation::Rename).?,
        };
        defer oldParent.deinit(allocator).withOperation(Operation::Rename).?;
        let oldNameStart = switch oldSplit.separator {
            ?index => index + 1usize,
            null => 0usize,
        };
        let mut oldName = lowerNativeBytes(
            allocator,
            &oldBytes[oldNameStart..oldSplit.end],
            Operation::Rename,
        ).?;
        defer oldName.deinit(allocator).withOperation(Operation::Rename).?;

        let newBytes = newPath.bytes();
        let newSplit = parentSplit(newBytes, false);
        let mut newParent = switch newSplit.separator {
            ?index => lowerNativeBytes(allocator, &newBytes[0..index], Operation::Rename).?,
            null => lowerNativeBytes(allocator, &current[..], Operation::Rename).?,
        };
        defer newParent.deinit(allocator).withOperation(Operation::Rename).?;
        let newNameStart = switch newSplit.separator {
            ?index => index + 1usize,
            null => 0usize,
        };
        let mut newName = lowerNativeBytes(
            allocator,
            &newBytes[newNameStart..newSplit.end],
            Operation::Rename,
        ).?;
        defer newName.deinit(allocator).withOperation(Operation::Rename).?;

        os::renameAtBeneath(
            self.borrowHandle().withOperation(Operation::Rename).?,
            oldParent.rawPtr(),
            oldName.rawPtr(),
            newDir.borrowHandle().withOperation(Operation::Rename).?,
            newParent.rawPtr(),
            newName.rawPtr(),
        ).as_fs_error().withOperation(Operation::Rename)
    }

    pub fn nativeMetadata(&self, path: RelativeNativePathView, options: MetadataOptions) OperationError!Metadata {
        let metadata = os::metadataAtBeneath(
            self.borrowHandle().withOperation(Operation::Metadata).?,
            path.ptr(),
            options.followSymlinks(),
        ).as_fs_error().withOperation(Operation::Metadata).?;
        !metadata.as_fs_metadata()
    }

    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        switch self.handle {
            ?handle => {
                !handle
            },
            null => {
                Error::BadFd!
            },
        }
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn close(&mut self) Error!() {
        let handle = self.takeHandle().?;
        handle.close().as_fs_error()
    }
}

extend File {
    fn fromOwnedDescriptor(handle: os::FileHandle) File {
        Self { handle: ?handle }
    }

    pub fn open(path: PathView, options: OpenOptions) OperationError!File {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        File::openWithAllocator(allocator, path, options)
    }

    pub fn openWithAllocator(
        allocator: &mut mem::Allocator,
        path: PathView,
        options: OpenOptions,
    ) OperationError!File {
        let mut owned = lowerPath(allocator, path, Operation::OpenFile).?;
        defer owned.deinit(allocator).withOperation(Operation::OpenFile).?;
        let native = NativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::OpenFile).?;
        let handle = os::openAt(
            os::cwd(),
            native.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::OpenFile).?,
            false,
            false,
            false,
            0,
        ).as_fs_error().withOperation(Operation::OpenFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub fn create(path: PathView, options: CreateOptions) OperationError!File {
        let mut page = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut page;
        File::createWithAllocator(allocator, path, options)
    }

    pub fn createWithAllocator(
        allocator: &mut mem::Allocator,
        path: PathView,
        options: CreateOptions,
    ) OperationError!File {
        let mut owned = lowerPath(allocator, path, Operation::CreateFile).?;
        defer owned.deinit(allocator).withOperation(Operation::CreateFile).?;
        let native = NativePathView::fromBytes(owned.nulTerminatedBytes()).withOperation(Operation::CreateFile).?;
        let handle = os::openAt(
            os::cwd(),
            native.ptr(),
            options.osMode().as_fs_error().withOperation(Operation::CreateFile).?,
            true,
            options.truncate(),
            options.isExclusive(),
            options.permissions(),
        ).as_fs_error().withOperation(Operation::CreateFile).?;
        !File::fromOwnedDescriptor(handle)
    }

    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        switch self.handle {
            ?handle => {
                !handle
            },
            null => {
                Error::BadFd!
            },
        }
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn seekTo(&self, offset: u64) Error!u64 {
        if offset > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.borrowHandle().?.seek(offset as i64, os::SeekWhence::Start).as_fs_error()
    }

    pub fn seekBy(&self, delta: i64) Error!u64 {
        self.borrowHandle().?.seek(delta, os::SeekWhence::Current).as_fs_error()
    }

    pub fn seekFromEnd(&self, delta: i64) Error!u64 {
        self.borrowHandle().?.seek(delta, os::SeekWhence::End).as_fs_error()
    }

    pub fn len(&self) Error!u64 {
        let metadata = self.metadata().?;
        !metadata.size()
    }

    pub fn metadata(&self) Error!Metadata {
        let metadata = self.borrowHandle().?.metadata().?;
        !metadata.as_fs_metadata()
    }

    pub fn truncate(&self, len: u64) Error!() {
        if len > max_i64_as_u64 {
            return Error::OutOfRange!;
        }
        self.borrowHandle().?.truncate(len).as_fs_error()
    }

    pub fn setPermissions(&self, permissions: u32) Error!() {
        self.borrowHandle().?.setPermissions(permissions).as_fs_error()
    }

    pub fn sync(&self) Error!() {
        self.borrowHandle().?.sync().as_fs_error()
    }

    pub fn syncData(&self) Error!() {
        self.borrowHandle().?.syncData().as_fs_error()
    }

    pub fn close(&mut self) Error!() {
        let handle = self.takeHandle().?;
        handle.close().as_fs_error()
    }
}
