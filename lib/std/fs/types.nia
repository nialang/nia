import std.os;

pub enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    NotEmpty = 39,
    System = 255,
    _,
}

pub enum PathError: i32 {
    Invalid = 1,
    TooLong = 36,
    _,
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub struct Path {
    text: &[char],
}

pub struct EncodedPath {
    ptr: &u8,
}

// Dir owns its handle. Call close when the directory is no longer needed.
pub struct Dir {
    handle: os::FileDescriptor,
}

// File owns its handle. Call close when the file is no longer needed.
pub struct File {
    handle: os::FileDescriptor,
}

pub struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub struct Metadata {
    kind: FileKind,
    inode: u64,
    nlink: u32,
    size: u64,
    mode: u32,
    block_size: u32,
    atime: ?Timestamp,
    mtime: Timestamp,
    ctime: Timestamp,
}

pub struct OpenOptions {
    mode: OpenMode,
}

pub struct OpenDirOptions {
    follow_symlinks: bool,
}

pub struct MetadataOptions {
    follow_symlinks: bool,
}

pub struct CreateOptions {
    read: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
}

pub struct CreateDirOptions {
    permissions: u32,
}

extend os::Error {
    pub fn as_fs_error(self) Error {
        switch self {
            os::Error::PermissionDenied => Error::PermissionDenied,
            os::Error::NoEntry => Error::NotFound,
            os::Error::Interrupted => Error::Interrupted,
            os::Error::Io => Error::Io,
            os::Error::BadFd => Error::BadFd,
            os::Error::Again => Error::Again,
            os::Error::NoMemory => Error::OutOfMemory,
            os::Error::Access => Error::Access,
            os::Error::Fault => Error::Fault,
            os::Error::Busy => Error::Busy,
            os::Error::Exists => Error::AlreadyExists,
            os::Error::CrossDevice => Error::CrossDevice,
            os::Error::NotDir => Error::NotDir,
            os::Error::IsDir => Error::IsDir,
            os::Error::Invalid => Error::Invalid,
            os::Error::NoSpace => Error::NoSpace,
            os::Error::ReadOnly => Error::ReadOnly,
            os::Error::BrokenPipe => Error::BrokenPipe,
            os::Error::OutOfRange => Error::OutOfRange,
            os::Error::TooLong => Error::TooLong,
            os::Error::NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend os::FileKind {
    pub fn as_fs_file_kind(self) FileKind {
        switch self {
            os::FileKind::BlockDevice => FileKind::BlockDevice,
            os::FileKind::CharacterDevice => FileKind::CharacterDevice,
            os::FileKind::Directory => FileKind::Directory,
            os::FileKind::NamedPipe => FileKind::NamedPipe,
            os::FileKind::Symlink => FileKind::Symlink,
            os::FileKind::File => FileKind::File,
            os::FileKind::UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend os::Timestamp {
    pub fn as_fs_timestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend os::FileMetadata {
    pub fn as_fs_metadata(&self) Metadata {
        var atime: ?Timestamp = null;
        switch self.atime() {
            ?value => atime = ?value.as_fs_timestamp(),
            null => {},
        }
        Metadata::init(
            self.kind().as_fs_file_kind(),
            self.inode(),
            self.nlink(),
            self.size(),
            self.mode(),
            self.block_size(),
            atime,
            self.mtime().as_fs_timestamp(),
            self.ctime().as_fs_timestamp(),
        )
    }
}

extend Timestamp {
    pub fn init(seconds: i64, nanos: u32) Timestamp {
        { seconds: seconds, nanos: nanos }
    }

    pub fn seconds(&self) i64 {
        self.seconds
    }

    pub fn nanos(&self) u32 {
        self.nanos
    }
}

extend Metadata {
    pub fn init(
        kind: FileKind,
        inode: u64,
        nlink: u32,
        size: u64,
        mode: u32,
        block_size: u32,
        atime: ?Timestamp,
        mtime: Timestamp,
        ctime: Timestamp,
    ) Metadata {
        {
            kind: kind,
            inode: inode,
            nlink: nlink,
            size: size,
            mode: mode,
            block_size: block_size,
            atime: atime,
            mtime: mtime,
            ctime: ctime,
        }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn inode(&self) u64 {
        self.inode
    }

    pub fn nlink(&self) u32 {
        self.nlink
    }

    pub fn size(&self) u64 {
        self.size
    }

    pub fn mode(&self) u32 {
        self.mode
    }

    pub fn block_size(&self) u32 {
        self.block_size
    }

    pub fn atime(&self) ?Timestamp {
        self.atime
    }

    pub fn mtime(&self) Timestamp {
        self.mtime
    }

    pub fn ctime(&self) Timestamp {
        self.ctime
    }
}
