import std.os;

pub enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    NotEmpty = 39,
    System = 255,
    _,
}

pub enum PathError: i32 {
    Invalid = 1,
    TooLong = 36,
    _,
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub struct Path {
    text: &[char],
}

pub struct EncodedPath {
    ptr: &u8,
}

// DirEntry names point into the iterator buffer and are overwritten by later next calls.
pub struct DirEntry {
    kind: FileKind,
    name: &[u8],
}

// DirIterator does not own the directory handle or caller-provided buffer.
pub struct DirIterator {
    reader: os::DirectoryReader,
}

// Dir owns its handle. Call close when the directory is no longer needed.
pub struct Dir {
    handle: os::FileHandle,
}

// File owns its handle. Call close when the file is no longer needed.
pub struct File {
    handle: os::FileHandle,
}

pub struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub struct Metadata {
    kind: FileKind,
    file_id: ?u64,
    link_count: ?u32,
    size: u64,
    permissions: u32,
    preferred_block_size: u32,
    accessed: ?Timestamp,
    modified: Timestamp,
    status_changed: ?Timestamp,
}

pub struct OpenOptions {
    mode: OpenMode,
}

pub struct OpenDirOptions {
    follow_symlinks: bool,
}

pub struct MetadataOptions {
    follow_symlinks: bool,
}

pub struct CreateOptions {
    read: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
}

pub struct CreateDirOptions {
    permissions: u32,
}

extend os::Error {
    pub fn as_fs_error(self) Error {
        switch self {
            os::Error::PermissionDenied => Error::PermissionDenied,
            os::Error::NotFound => Error::NotFound,
            os::Error::Interrupted => Error::Interrupted,
            os::Error::Io => Error::Io,
            os::Error::BadFd => Error::BadFd,
            os::Error::Again => Error::Again,
            os::Error::OutOfMemory => Error::OutOfMemory,
            os::Error::Access => Error::Access,
            os::Error::Fault => Error::Fault,
            os::Error::Busy => Error::Busy,
            os::Error::AlreadyExists => Error::AlreadyExists,
            os::Error::CrossDevice => Error::CrossDevice,
            os::Error::NotDir => Error::NotDir,
            os::Error::IsDir => Error::IsDir,
            os::Error::Invalid => Error::Invalid,
            os::Error::NoSpace => Error::NoSpace,
            os::Error::ReadOnly => Error::ReadOnly,
            os::Error::BrokenPipe => Error::BrokenPipe,
            os::Error::OutOfRange => Error::OutOfRange,
            os::Error::TooLong => Error::TooLong,
            os::Error::NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend os::FileKind {
    pub fn as_fs_file_kind(self) FileKind {
        switch self {
            os::FileKind::BlockDevice => FileKind::BlockDevice,
            os::FileKind::CharacterDevice => FileKind::CharacterDevice,
            os::FileKind::Directory => FileKind::Directory,
            os::FileKind::NamedPipe => FileKind::NamedPipe,
            os::FileKind::Symlink => FileKind::Symlink,
            os::FileKind::File => FileKind::File,
            os::FileKind::UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend os::Timestamp {
    pub fn as_fs_timestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend os::FileMetadata {
    pub fn as_fs_metadata(&self) Metadata {
        var accessed: ?Timestamp = null;
        switch self.accessed() {
            ?value => accessed = ?value.as_fs_timestamp(),
            null => {},
        }
        var status_changed: ?Timestamp = null;
        switch self.status_changed() {
            ?value => status_changed = ?value.as_fs_timestamp(),
            null => {},
        }
        Metadata::init(
            self.kind().as_fs_file_kind(),
            self.file_id(),
            self.link_count(),
            self.size(),
            self.permissions(),
            self.preferred_block_size(),
            accessed,
            self.modified().as_fs_timestamp(),
            status_changed,
        )
    }
}

extend os::DirectoryEntry {
    pub fn as_fs_dir_entry(&self) DirEntry {
        DirEntry::init(self.kind().as_fs_file_kind(), self.name())
    }
}

extend DirEntry {
    pub fn init(kind: FileKind, name: &[u8]) DirEntry {
        { kind: kind, name: name }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn name(&self) &[u8] {
        self.name
    }

    pub fn is_dot(&self) bool {
        self.name.len() == 1usize and self.name[0] == b'.'
    }

    pub fn is_dot_dot(&self) bool {
        self.name.len() == 2usize and self.name[0] == b'.' and self.name[1] == b'.'
    }
}

extend DirIterator {
    pub fn init(reader: os::DirectoryReader) DirIterator {
        { reader: reader }
    }
}

extend DirIterator : Iterator {
    type Item = Error!DirEntry;

    pub fn next(&mut self) ?(Error!DirEntry) {
        let entry = switch self.reader.next() {
            ?result => result.map_err[Error](&os::Error::as_fs_error),
            null => return null,
        };
        switch entry {
            !value => ?(!value.as_fs_dir_entry()),
            err! => ?(err!),
        }
    }
}

extend Timestamp {
    pub fn init(seconds: i64, nanos: u32) Timestamp {
        { seconds: seconds, nanos: nanos }
    }

    pub fn seconds(&self) i64 {
        self.seconds
    }

    pub fn nanos(&self) u32 {
        self.nanos
    }
}

extend Metadata {
    pub fn init(
        kind: FileKind,
        file_id: ?u64,
        link_count: ?u32,
        size: u64,
        permissions: u32,
        preferred_block_size: u32,
        accessed: ?Timestamp,
        modified: Timestamp,
        status_changed: ?Timestamp,
    ) Metadata {
        {
            kind: kind,
            file_id: file_id,
            link_count: link_count,
            size: size,
            permissions: permissions,
            preferred_block_size: preferred_block_size,
            accessed: accessed,
            modified: modified,
            status_changed: status_changed,
        }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn file_id(&self) ?u64 {
        self.file_id
    }

    pub fn link_count(&self) ?u32 {
        self.link_count
    }

    pub fn size(&self) u64 {
        self.size
    }

    pub fn permissions(&self) u32 {
        self.permissions
    }

    pub fn preferred_block_size(&self) u32 {
        self.preferred_block_size
    }

    pub fn accessed(&self) ?Timestamp {
        self.accessed
    }

    pub fn modified(&self) Timestamp {
        self.modified
    }

    pub fn status_changed(&self) ?Timestamp {
        self.status_changed
    }
}
