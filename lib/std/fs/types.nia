using pkg::fs::convert;
using pkg::os;
using pkg::string;

pub enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    Unsupported = 38,
    SymlinkLoop = 40,
    NotEmpty = 39,
    System = 255,
    _,
}

pub enum PathError: i32 {
    ContainsNul = 1,
    Absolute = 2,
    ParentTraversal = 3,
    MissingTerminator = 22,
    TooLong = 36,
    _,
}

pub enum Operation {
    OpenFile,
    OpenDir,
    CreateFile,
    CreateDir,
    DeleteFile,
    DeleteDir,
    Rename,
    Metadata,
}

pub enum OperationError {
    Path { operation: Operation, cause: PathError },
    System { operation: Operation, cause: Error },
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub struct PathView {
    text: &[char],
}

// RelativePathView is validated to contain neither an absolute root nor a `..` component.
pub struct RelativePathView {
    path: PathView,
}

// Path owns allocator-backed scalar text. PathView is its borrowed counterpart.
// Construction, mutation, and deinit keep allocator provenance explicit.
pub struct Path {
    text: string::String,
}

// NativePathView borrows a validated NUL-terminated native byte sequence.
pub struct NativePathView {
    ptr: &u8,
    len: usize,
}

// RelativeNativePathView applies the same lexical root contract to native bytes.
pub struct RelativeNativePathView {
    path: NativePathView,
}

// DirEntry names point into the iterator buffer and are overwritten by later next calls.
pub struct DirEntry {
    kind: FileKind,
    name: &[u8],
}

// DirIterator borrows the directory owner and caller-provided buffer.
pub struct DirIterator {
    dir: &Dir,
    reader: os::DirectoryReader,
}

// Dir owns its handle. Call close when the directory is no longer needed.
pub struct Dir {
    handle: ?os::FileHandle,
}

// File owns its handle. Call close when the file is no longer needed.
pub struct File {
    handle: ?os::FileHandle,
}

pub struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub struct Metadata {
    kind: FileKind,
    fileId: ?u64,
    linkCount: ?u32,
    size: u64,
    permissions: u32,
    preferredBlockSize: u32,
    accessed: ?Timestamp,
    modified: Timestamp,
    statusChanged: ?Timestamp,
}

pub struct OpenOptions {
    mode: OpenMode,
}

pub struct OpenDirOptions {
    followSymlinks: bool,
}

pub struct MetadataOptions {
    followSymlinks: bool,
}

pub struct CreateOptions {
    read: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
}

pub struct CreateDirOptions {
    permissions: u32,
}

extend Dir {
    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        if self.handle is ?handle {
            return !handle;
        }
        Error::BadFd!
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn close(&mut self) Error!() {
        let handle = self.takeHandle().?;
        !(handle.close().?)
    }
}

extend File {
    pub(pkg) fn borrowHandle(&self) Error!os::FileHandle {
        if self.handle is ?handle {
            return !handle;
        }
        Error::BadFd!
    }

    pub(pkg) fn takeHandle(&mut self) Error!os::FileHandle {
        let handle = self.borrowHandle().?;
        self.handle = null;
        !handle
    }

    pub fn close(&mut self) Error!() {
        let handle = self.takeHandle().?;
        !(handle.close().?)
    }
}

extend DirEntry {
    pub fn init(kind: FileKind, name: &[u8]) DirEntry {
        Self { kind: kind, name: name }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn name(&self) &[u8] {
        self.name
    }

    pub fn isDot(&self) bool {
        self.name.len() == 1 and self.name[0] == b'.'
    }

    pub fn isDotDot(&self) bool {
        self.name.len() == 2 and self.name[0] == b'.' and self.name[1] == b'.'
    }
}

extend DirIterator {
    pub(pkg) fn init(dir: &Dir, reader: os::DirectoryReader) DirIterator {
        Self { dir: dir, reader: reader }
    }
}

extend DirIterator : Iterator {
    type Item = Error!DirEntry;

    pub fn next(&mut self) ?(Error!DirEntry) {
        if self.reader.isDone() {
            return null;
        }
        let handle = match self.dir.borrowHandle() {
            !value => value,
            error! => return ?(error!),
        };
        if self.reader.next(handle) is ?result {
            if result is !value {
                return ?(!value.asFsDirEntry());
            }
            if result is err! {
                return ?(err.intoError()!);
            }
        }
        null
    }
}

extend Timestamp {
    pub fn init(seconds: i64, nanos: u32) Timestamp {
        Self { seconds: seconds, nanos: nanos }
    }

    pub fn seconds(&self) i64 {
        self.seconds
    }

    pub fn nanos(&self) u32 {
        self.nanos
    }
}

extend Metadata {
    pub fn init(
        kind: FileKind,
        fileId: ?u64,
        linkCount: ?u32,
        size: u64,
        permissions: u32,
        preferredBlockSize: u32,
        accessed: ?Timestamp,
        modified: Timestamp,
        statusChanged: ?Timestamp,
    ) Metadata {
        Self {
            kind: kind,
            fileId: fileId,
            linkCount: linkCount,
            size: size,
            permissions: permissions,
            preferredBlockSize: preferredBlockSize,
            accessed: accessed,
            modified: modified,
            statusChanged: statusChanged,
        }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn fileId(&self) ?u64 {
        self.fileId
    }

    pub fn linkCount(&self) ?u32 {
        self.linkCount
    }

    pub fn size(&self) u64 {
        self.size
    }

    pub fn permissions(&self) u32 {
        self.permissions
    }

    pub fn preferredBlockSize(&self) u32 {
        self.preferredBlockSize
    }

    pub fn accessed(&self) ?Timestamp {
        self.accessed
    }

    pub fn modified(&self) Timestamp {
        self.modified
    }

    pub fn statusChanged(&self) ?Timestamp {
        self.statusChanged
    }
}
