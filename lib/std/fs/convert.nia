using pkg::error;
using pkg::fs::types;
using pkg::os;

using types::{DirEntry, Error, FileKind, Metadata, Operation, OperationError, PathError, Timestamp};

extend os::Error : error::IntoError[Error] {
    const fn intoError(self) Error {
        match self {
            .PermissionDenied => Error::PermissionDenied,
            .NotFound => Error::NotFound,
            .Interrupted => Error::Interrupted,
            .Io => Error::Io,
            .BadFd => Error::BadFd,
            .Again => Error::Again,
            .OutOfMemory => Error::OutOfMemory,
            .Access => Error::Access,
            .Fault => Error::Fault,
            .Busy => Error::Busy,
            .AlreadyExists => Error::AlreadyExists,
            .CrossDevice => Error::CrossDevice,
            .NotDir => Error::NotDir,
            .IsDir => Error::IsDir,
            .Invalid => Error::Invalid,
            .NoSpace => Error::NoSpace,
            .ReadOnly => Error::ReadOnly,
            .BrokenPipe => Error::BrokenPipe,
            .OutOfRange => Error::OutOfRange,
            .TooLong => Error::TooLong,
            .Unsupported => Error::Unsupported,
            .SymlinkLoop => Error::SymlinkLoop,
            .NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend[T] Error!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        match self {
            !value => !value,
            cause! => OperationError::System { operation: operation, cause: cause }!,
        }
    }
}

extend[T] os::Error!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        match self {
            !value => !value,
            cause! => OperationError::System {
                operation: operation,
                cause: cause.intoError(),
            }!,
        }
    }
}

extend[T] PathError!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        match self {
            !value => !value,
            cause! => OperationError::Path { operation: operation, cause: cause }!,
        }
    }
}

extend os::FileKind {
    pub(pkg) fn as_fs_file_kind(self) FileKind {
        match self {
            .BlockDevice => FileKind::BlockDevice,
            .CharacterDevice => FileKind::CharacterDevice,
            .Directory => FileKind::Directory,
            .NamedPipe => FileKind::NamedPipe,
            .Symlink => FileKind::Symlink,
            .File => FileKind::File,
            .UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend os::Timestamp {
    pub(pkg) fn as_fs_timestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend os::FileMetadata {
    pub(pkg) fn as_fs_metadata(&self) Metadata {
        let mut accessed: ?Timestamp = null;
        if self.accessed() is ?value {
            accessed = ?value.as_fs_timestamp();
        }
        let mut status_changed: ?Timestamp = null;
        if self.statusChanged() is ?value {
            status_changed = ?value.as_fs_timestamp();
        }
        Metadata::init(
            self.kind().as_fs_file_kind(),
            self.fileId(),
            self.linkCount(),
            self.size(),
            self.permissions(),
            self.preferredBlockSize(),
            accessed,
            self.modified().as_fs_timestamp(),
            status_changed,
        )
    }
}

extend os::DirectoryEntry {
    pub(pkg) fn as_fs_dir_entry(&self) DirEntry {
        DirEntry::init(self.kind().as_fs_file_kind(), self.name())
    }
}
