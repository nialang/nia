using package::fs::types;
using package::os;

using types::{DirEntry, Error, FileKind, Metadata, Timestamp};

extend os::Error {
    pub(package) fn as_fs_error(self) Error {
        switch self {
            os::Error::PermissionDenied => Error::PermissionDenied,
            os::Error::NotFound => Error::NotFound,
            os::Error::Interrupted => Error::Interrupted,
            os::Error::Io => Error::Io,
            os::Error::BadFd => Error::BadFd,
            os::Error::Again => Error::Again,
            os::Error::OutOfMemory => Error::OutOfMemory,
            os::Error::Access => Error::Access,
            os::Error::Fault => Error::Fault,
            os::Error::Busy => Error::Busy,
            os::Error::AlreadyExists => Error::AlreadyExists,
            os::Error::CrossDevice => Error::CrossDevice,
            os::Error::NotDir => Error::NotDir,
            os::Error::IsDir => Error::IsDir,
            os::Error::Invalid => Error::Invalid,
            os::Error::NoSpace => Error::NoSpace,
            os::Error::ReadOnly => Error::ReadOnly,
            os::Error::BrokenPipe => Error::BrokenPipe,
            os::Error::OutOfRange => Error::OutOfRange,
            os::Error::TooLong => Error::TooLong,
            os::Error::NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend[T] os::Error!T {
    pub(package) fn as_fs_error(self) Error!T {
        switch self {
            !value => !value,
            error! => error.as_fs_error()!,
        }
    }
}

extend os::FileKind {
    pub(package) fn as_fs_file_kind(self) FileKind {
        switch self {
            os::FileKind::BlockDevice => FileKind::BlockDevice,
            os::FileKind::CharacterDevice => FileKind::CharacterDevice,
            os::FileKind::Directory => FileKind::Directory,
            os::FileKind::NamedPipe => FileKind::NamedPipe,
            os::FileKind::Symlink => FileKind::Symlink,
            os::FileKind::File => FileKind::File,
            os::FileKind::UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend os::Timestamp {
    pub(package) fn as_fs_timestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend os::FileMetadata {
    pub(package) fn as_fs_metadata(&self) Metadata {
        var accessed: ?Timestamp = null;
        switch self.accessed() {
            ?value => accessed = ?value.as_fs_timestamp(),
            null => {},
        }
        var status_changed: ?Timestamp = null;
        switch self.status_changed() {
            ?value => status_changed = ?value.as_fs_timestamp(),
            null => {},
        }
        Metadata::init(
            self.kind().as_fs_file_kind(),
            self.file_id(),
            self.link_count(),
            self.size(),
            self.permissions(),
            self.preferred_block_size(),
            accessed,
            self.modified().as_fs_timestamp(),
            status_changed,
        )
    }
}

extend os::DirectoryEntry {
    pub(package) fn as_fs_dir_entry(&self) DirEntry {
        DirEntry::init(self.kind().as_fs_file_kind(), self.name())
    }
}
