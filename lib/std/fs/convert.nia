using pkg::error;
using pkg::fs::types;
using pkg::os;

using types::{DirEntry, Error, FileKind, Metadata, Operation, OperationError, PathError, Timestamp};

extend os::Error : error::IntoError[Error] {
    const fn into_error(self) Error {
        match self {
            os::Error::PermissionDenied => Error::PermissionDenied,
            os::Error::NotFound => Error::NotFound,
            os::Error::Interrupted => Error::Interrupted,
            os::Error::Io => Error::Io,
            os::Error::BadFd => Error::BadFd,
            os::Error::Again => Error::Again,
            os::Error::OutOfMemory => Error::OutOfMemory,
            os::Error::Access => Error::Access,
            os::Error::Fault => Error::Fault,
            os::Error::Busy => Error::Busy,
            os::Error::AlreadyExists => Error::AlreadyExists,
            os::Error::CrossDevice => Error::CrossDevice,
            os::Error::NotDir => Error::NotDir,
            os::Error::IsDir => Error::IsDir,
            os::Error::Invalid => Error::Invalid,
            os::Error::NoSpace => Error::NoSpace,
            os::Error::ReadOnly => Error::ReadOnly,
            os::Error::BrokenPipe => Error::BrokenPipe,
            os::Error::OutOfRange => Error::OutOfRange,
            os::Error::TooLong => Error::TooLong,
            os::Error::Unsupported => Error::Unsupported,
            os::Error::SymlinkLoop => Error::SymlinkLoop,
            os::Error::NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend os::Error {
    pub(pkg) fn as_fs_error(self) Error {
        self.into_error()
    }
}

extend[T] os::Error!T {
    pub(pkg) fn as_fs_error(self) Error!T {
        self.cast_error()
    }
}

extend[T] Error!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        match self {
            !value => !value,
            cause! => OperationError::System { operation: operation, cause: cause }!,
        }
    }
}

extend[T] PathError!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        match self {
            !value => !value,
            cause! => OperationError::Path { operation: operation, cause: cause }!,
        }
    }
}

extend os::FileKind {
    pub(pkg) fn as_fs_file_kind(self) FileKind {
        match self {
            os::FileKind::BlockDevice => FileKind::BlockDevice,
            os::FileKind::CharacterDevice => FileKind::CharacterDevice,
            os::FileKind::Directory => FileKind::Directory,
            os::FileKind::NamedPipe => FileKind::NamedPipe,
            os::FileKind::Symlink => FileKind::Symlink,
            os::FileKind::File => FileKind::File,
            os::FileKind::UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend os::Timestamp {
    pub(pkg) fn as_fs_timestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend os::FileMetadata {
    pub(pkg) fn as_fs_metadata(&self) Metadata {
        let mut accessed: ?Timestamp = null;
        match self.accessed() {
            ?value => {
                accessed = ?value.as_fs_timestamp();
            },
            null => {},
        }
        let mut status_changed: ?Timestamp = null;
        match self.statusChanged() {
            ?value => {
                status_changed = ?value.as_fs_timestamp();
            },
            null => {},
        }
        Metadata::init(
            self.kind().as_fs_file_kind(),
            self.fileId(),
            self.linkCount(),
            self.size(),
            self.permissions(),
            self.preferredBlockSize(),
            accessed,
            self.modified().as_fs_timestamp(),
            status_changed,
        )
    }
}

extend os::DirectoryEntry {
    pub(pkg) fn as_fs_dir_entry(&self) DirEntry {
        DirEntry::init(self.kind().as_fs_file_kind(), self.name())
    }
}
