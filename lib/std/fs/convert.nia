using pkg::error;
using pkg::fs::types;
using pkg::optional;
using pkg::os;

using types::{DirEntry, Error, FileKind, Metadata, Operation, OperationError, PathError, Timestamp};

extend os::Error : error::IntoError[Error] {
    const fn intoError(self) Error {
        match self {
            .PermissionDenied => Error::PermissionDenied,
            .NotFound => Error::NotFound,
            .Interrupted => Error::Interrupted,
            .Io => Error::Io,
            .BadFd => Error::BadFd,
            .Again => Error::Again,
            .OutOfMemory => Error::OutOfMemory,
            .Access => Error::Access,
            .Fault => Error::Fault,
            .Busy => Error::Busy,
            .AlreadyExists => Error::AlreadyExists,
            .CrossDevice => Error::CrossDevice,
            .NotDir => Error::NotDir,
            .IsDir => Error::IsDir,
            .Invalid => Error::Invalid,
            .NoSpace => Error::NoSpace,
            .ReadOnly => Error::ReadOnly,
            .BrokenPipe => Error::BrokenPipe,
            .OutOfRange => Error::OutOfRange,
            .TooLong => Error::TooLong,
            .Unsupported => Error::Unsupported,
            .SymlinkLoop => Error::SymlinkLoop,
            .NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend[T] Error!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        self.mapError(&\[operation] cause: Error -> .System { operation, cause })
    }
}

extend[T] os::Error!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        self.mapError(&\[operation] cause: os::Error -> .System {
            operation,
            cause: cause.intoError(),
        })
    }
}

extend[T] PathError!T {
    pub(pkg) fn withOperation(self, operation: Operation) OperationError!T {
        self.mapError(&\[operation] cause: PathError -> .Path { operation, cause })
    }
}

extend os::FileKind {
    pub(pkg) fn asFsFileKind(self) FileKind {
        match self {
            .BlockDevice => FileKind::BlockDevice,
            .CharacterDevice => FileKind::CharacterDevice,
            .Directory => FileKind::Directory,
            .NamedPipe => FileKind::NamedPipe,
            .Symlink => FileKind::Symlink,
            .File => FileKind::File,
            .UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend os::Timestamp {
    pub(pkg) fn asFsTimestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend os::FileMetadata {
    pub(pkg) fn asFsMetadata(&self) Metadata {
        let accessed = self.accessed().map(
            &\value: os::Timestamp -> value.asFsTimestamp(),
        );
        let statusChanged = self.statusChanged().map(
            &\value: os::Timestamp -> value.asFsTimestamp(),
        );
        Metadata::init(
            self.kind().asFsFileKind(),
            self.fileId(),
            self.linkCount(),
            self.size(),
            self.permissions(),
            self.preferredBlockSize(),
            accessed,
            self.modified().asFsTimestamp(),
            statusChanged,
        )
    }
}

extend os::DirectoryEntry {
    pub(pkg) fn asFsDirEntry(&self) DirEntry {
        DirEntry::init(self.kind().asFsFileKind(), self.name())
    }
}
