using pkg::fs::types;
using pkg::os;

using types::{CreateDirOptions, CreateOptions, MetadataOptions, OpenDirOptions, OpenMode, OpenOptions};

extend OpenOptions {
    pub fn readOnly() OpenOptions {
        .{ mode: .ReadOnly }
    }

    pub fn writeOnly() OpenOptions {
        .{ mode: .WriteOnly }
    }

    pub fn readWrite() OpenOptions {
        .{ mode: .ReadWrite }
    }

    pub fn mode(&self) OpenMode {
        self.mode
    }

    pub(pkg) fn osMode(&self) os::Error!os::OpenMode {
        match self.mode() {
            .ReadOnly => !.ReadOnly,
            .WriteOnly => !.WriteOnly,
            .ReadWrite => !.ReadWrite,
            _ => .Invalid!,
        }
    }
}

extend OpenDirOptions {
    pub fn init() OpenDirOptions {
        .{ followSymlinks: true }
    }

    pub fn noFollow() OpenDirOptions {
        .{ followSymlinks: false }
    }

    pub fn followSymlinks(&self) bool {
        self.followSymlinks
    }
}

extend MetadataOptions {
    pub fn init() MetadataOptions {
        .{ followSymlinks: true }
    }

    pub fn noFollow() MetadataOptions {
        .{ followSymlinks: false }
    }

    pub fn followSymlinks(&self) bool {
        self.followSymlinks
    }
}

extend CreateOptions {
    pub fn init() CreateOptions {
        .{ read: false, truncate: true, exclusive: false, permissions: 0o666 }
    }

    pub fn readWrite() CreateOptions {
        .{ read: true, truncate: true, exclusive: false, permissions: 0o666 }
    }

    pub fn exclusive() CreateOptions {
        .{ read: false, truncate: true, exclusive: true, permissions: 0o666 }
    }

    pub fn read(&self) bool {
        self.read
    }

    pub fn truncate(&self) bool {
        self.truncate
    }

    pub fn isExclusive(&self) bool {
        self.exclusive
    }

    pub fn permissions(&self) u32 {
        self.permissions
    }

    pub(pkg) fn osMode(&self) os::Error!os::OpenMode {
        if self.read() {
            !.ReadWrite
        } else {
            !.WriteOnly
        }
    }
}

extend CreateDirOptions {
    pub fn init() CreateDirOptions {
        .{ permissions: 0o777 }
    }

    pub fn permissions(&self) u32 {
        self.permissions
    }
}
