using pkg::fs::types;
using pkg::os;

using types::{CreateDirOptions, CreateOptions, MetadataOptions, OpenDirOptions, OpenMode, OpenOptions};

extend OpenOptions {
    pub fun readOnly() OpenOptions {
        .{ mode: .ReadOnly }
    }

    pub fun writeOnly() OpenOptions {
        .{ mode: .WriteOnly }
    }

    pub fun readWrite() OpenOptions {
        .{ mode: .ReadWrite }
    }

    pub fun mode(&self) OpenMode {
        self.mode
    }

    pub(pkg) fun osMode(&self) os::Error!os::OpenMode {
        match self.mode() {
            .ReadOnly => !.ReadOnly,
            .WriteOnly => !.WriteOnly,
            .ReadWrite => !.ReadWrite,
            _ => .Invalid!,
        }
    }
}

extend OpenDirOptions {
    pub fun init() OpenDirOptions {
        .{ followSymlinks: true }
    }

    pub fun noFollow() OpenDirOptions {
        .{ followSymlinks: false }
    }

    pub fun followSymlinks(&self) bool {
        self.followSymlinks
    }
}

extend MetadataOptions {
    pub fun init() MetadataOptions {
        .{ followSymlinks: true }
    }

    pub fun noFollow() MetadataOptions {
        .{ followSymlinks: false }
    }

    pub fun followSymlinks(&self) bool {
        self.followSymlinks
    }
}

extend CreateOptions {
    pub fun init() CreateOptions {
        .{ read: false, truncate: true, exclusive: false, permissions: 0o666 }
    }

    pub fun readWrite() CreateOptions {
        .{ read: true, truncate: true, exclusive: false, permissions: 0o666 }
    }

    pub fun exclusive() CreateOptions {
        .{ read: false, truncate: true, exclusive: true, permissions: 0o666 }
    }

    pub fun read(&self) bool {
        self.read
    }

    pub fun truncate(&self) bool {
        self.truncate
    }

    pub fun isExclusive(&self) bool {
        self.exclusive
    }

    pub fun permissions(&self) u32 {
        self.permissions
    }

    pub(pkg) fun osMode(&self) os::Error!os::OpenMode {
        if self.read() {
            !.ReadWrite
        } else {
            !.WriteOnly
        }
    }
}

extend CreateDirOptions {
    pub fun init() CreateDirOptions {
        .{ permissions: 0o777 }
    }

    pub fun permissions(&self) u32 {
        self.permissions
    }
}
