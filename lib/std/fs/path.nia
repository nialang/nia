using pkg::error;
using pkg::fs::types;
using pkg::mem;
using pkg::slice;
using pkg::string;

using types::{EncodedPath, Error, PathBuf, PathError, PathView};

extend PathView {
    pub fn init(text: &[char]) PathView {
        { text: text }
    }

    pub fn text(&self) &[char] {
        self.text
    }

    pub fn encode(&self, storage: &mut [u8]) PathError!EncodedPath {
        let mut out: usize = 0;
        for &ch in self.text().iter() {
            if ch.codepoint() == 0 {
                return PathError::ContainsNul!;
            }
            let encoded = ch.encode_utf8();
            let next = switch out.checked_add(encoded.len()) {
                ?value => value,
                null => return PathError::TooLong!,
            };
            if next >= storage.len() {
                return PathError::TooLong!;
            }
            for &byte in encoded.bytes().iter() {
                storage[out] = byte;
                out += 1;
            }
        }
        if out >= storage.len() {
            return PathError::TooLong!;
        }
        storage[out] = 0;
        !EncodedPath::init(storage.ptr(), out)
    }
}

extend PathBuf {
    pub fn init() PathBuf {
        { text: string::String::init() }
    }

    pub fn initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!PathBuf {
        let text = string::String::initCapacity(allocator, capacity).?;
        !PathBuf { text: text }
    }

    pub fn fromOwnedSlice(text: &mut [char]) PathBuf {
        { text: string::String::fromOwnedSlice(text) }
    }

    pub fn fromString(text: string::String) PathBuf {
        { text: text }
    }

    pub fn fromView(allocator: &mut mem::Allocator, path: PathView) mem::Error!PathBuf {
        let text = string::String::fromSlice(allocator, path.text()).?;
        !PathBuf::fromString(text)
    }

    pub fn fromUtf8(allocator: &mut mem::Allocator, bytes: &[u8]) string::TextError!PathBuf {
        let text = string::String::fromUtf8(allocator, bytes).?;
        !PathBuf::fromString(text)
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.text.deinit(allocator)
    }

    pub fn view(&self) PathView {
        PathView::init(self.text.text())
    }

    pub fn text(&self) &[char] {
        self.text.text()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn isEmpty(&self) bool {
        self.text.isEmpty()
    }

    pub fn clear(&mut self) void {
        self.text.clear()
    }

    pub fn append(&mut self, allocator: &mut mem::Allocator, text: &[char]) mem::Error!void {
        self.text.append(allocator, text)
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, ch: char) mem::Error!void {
        self.text.push(allocator, ch)
    }

    pub fn joinComponent(&mut self, allocator: &mut mem::Allocator, component: &[char]) mem::Error!void {
        appendComponentToString(allocator, component, &mut self.text)
    }

    pub fn encode(&self, storage: &mut [u8]) PathError!EncodedPath {
        self.view().encode(storage)
    }
}

fn appendComponentToString(
    allocator: &mut mem::Allocator,
    component: &[char],
    out: &mut string::String,
) mem::Error!void {
    if component.len() == 0 {
        return !{};
    }
    if out.isEmpty() {
        out.append(allocator, component)
    } else {
        let outHasSeparator = isSeparator(out.text()[out.len() - 1]);
        let componentHasSeparator = isSeparator(component[0]);
        let needsSeparator = not outHasSeparator and not componentHasSeparator;
        let appended: &[char] = if outHasSeparator and componentHasSeparator {
            &component[1..]
        } else {
            component
        };
        let separatorLen: usize = if needsSeparator { 1 } else { 0 };
        let appendLen = switch appended.len().checked_add(separatorLen) {
            ?value => value,
            null => return mem::Error::OutOfMemory!,
        };
        let needed = switch out.len().checked_add(appendLen) {
            ?value => value,
            null => return mem::Error::OutOfMemory!,
        };
        out.ensureTotalCapacity(allocator, needed).?;
        if needsSeparator {
            out.push(allocator, '/').?;
        }
        out.append(allocator, appended)
    }
}

fn isSeparator(ch: char) bool {
    ch == '/'
}

extend EncodedPath {
    fn init(ptr: &u8, len: usize) EncodedPath {
        { ptr: ptr, len: len }
    }

    pub fn ptr(&self) &u8 {
        self.ptr
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn bytes(&self) &[u8] {
        &self.ptr[0..self.len]
    }

    pub fn nulTerminatedBytes(&self) &[u8] {
        &self.ptr[0..(self.len + 1)]
    }
}

extend PathError : error::IntoError[Error] {
    fn into_error(self) Error {
        switch self {
            PathError::ContainsNul => Error::Invalid,
            PathError::TooLong => Error::TooLong,
            _ => Error::Invalid,
        }
    }
}

extend[T] PathError!T {
    pub(pkg) fn asFsError(self) Error!T {
        self.cast_error()
    }
}
