using pkg::collections;
using pkg::error;
using pkg::fs::types;
using pkg::mem;
using pkg::string;
using pkg::unicode;

using types::{EncodedPath, Error, PathBuf, PathError, PathView};

extend PathView {
    pub fn init(text: &[char]) PathView {
        { text: string::StringView::init(text) }
    }

    pub fn from_string(text: string::StringView) PathView {
        { text: text }
    }

    pub fn from_utf8_into(
        allocator: &mut mem::Allocator,
        bytes: &[u8],
        out: &mut collections::ArrayList[char],
    ) Error!PathView {
        out.clear_retaining_capacity();
        var index = 0usize;
        while index < bytes.len() {
            let decoded = if let ?value = unicode::utf8_decode_first(&bytes[index..]) {
                value
            } else null {
                return Error::Invalid!;
            };
            out.push(allocator, decoded.char()).as_fs_error().?;
            index += decoded.len();
        }
        !PathView::init(out.as_slice())
    }

    pub fn text(&self) &[char] {
        self.text.text()
    }

    pub fn string(&self) string::StringView {
        self.text
    }

    pub fn to_path_buf(&self, allocator: &mut mem::Allocator) Error!PathBuf {
        var text = string::StringBuf::from_slice(allocator, self.text()).as_fs_error().?;
        !PathBuf::from_string_buf(text)
    }

    pub fn encode(&self, storage: &mut [u8]) Error!EncodedPath {
        self.encode_bytes(storage).as_fs_error()
    }

    pub fn encode_bytes(&self, storage: &mut [u8]) PathError!EncodedPath {
        var out = 0usize;
        var index = 0usize;
        let text = self.text();
        while index < text.len() {
            let ch = text[index];
            if ch as u32 == 0u32 {
                return PathError::Invalid!;
            }
            let encoded = ch.encode_utf8();
            if out + encoded.len() >= storage.len() {
                return PathError::TooLong!;
            }
            let bytes = encoded.bytes();
            var byte_index = 0usize;
            while byte_index < bytes.len() {
                storage[out] = bytes[byte_index];
                out += 1usize;
                byte_index += 1usize;
            }
            index += 1usize;
        }
        if out >= storage.len() {
            return PathError::TooLong!;
        }
        storage[out] = 0u8;
        !EncodedPath::init(storage.get_ptr_read(), out)
    }

}

extend PathBuf {
    pub fn init() PathBuf {
        { text: string::StringBuf::init() }
    }

    pub fn init_capacity(allocator: &mut mem::Allocator, capacity: usize) Error!PathBuf {
        var text = string::StringBuf::init_capacity(allocator, capacity).as_fs_error().?;
        !PathBuf { text: text }
    }

    pub fn from_owned_slice(text: &mut [char]) PathBuf {
        { text: string::StringBuf::from_owned_slice(text) }
    }

    pub fn from_string_buf(text: string::StringBuf) PathBuf {
        { text: text }
    }

    pub fn from_path(allocator: &mut mem::Allocator, path: PathView) Error!PathBuf {
        path.to_path_buf(allocator)
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        self.text.deinit(allocator).as_fs_error()
    }

    pub fn view(&self) PathView {
        PathView::from_string(self.text.view())
    }

    pub fn text(&self) &[char] {
        self.text.text()
    }

    pub fn string(&self) string::StringView {
        self.text.view()
    }

    pub fn string_buf(&self) &string::StringBuf {
        &self.text
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn is_empty(&self) bool {
        self.text.is_empty()
    }

    pub fn clear(&mut self) void {
        self.text.clear()
    }

    pub fn append(&mut self, allocator: &mut mem::Allocator, text: &[char]) Error!void {
        self.text.append(allocator, text).as_fs_error()
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, ch: char) Error!void {
        self.text.push(allocator, ch).as_fs_error()
    }

    pub fn join(&mut self, allocator: &mut mem::Allocator, component: PathView) Error!void {
        append_component_to_string_buf(allocator, component.text(), &mut self.text).?;
        !{}
    }

    pub fn join_component(&mut self, allocator: &mut mem::Allocator, component: &[char]) Error!void {
        self.join(allocator, PathView::init(component))
    }

    pub fn encode(&self, storage: &mut [u8]) Error!EncodedPath {
        self.view().encode(storage)
    }

    pub fn encode_bytes(&self, storage: &mut [u8]) PathError!EncodedPath {
        self.view().encode_bytes(storage)
    }
}

fn append_component_to_string_buf(
    allocator: &mut mem::Allocator,
    component: &[char],
    out: &mut string::StringBuf,
) Error!void {
    if component.len() == 0usize {
        return !{};
    }
    if out.len() == 0usize {
        out.append(allocator, component).as_fs_error()
    } else {
        let out_has_sep = is_separator(out.text()[out.len() - 1usize]);
        let component_has_sep = is_separator(component[0]);
        if not out_has_sep and not component_has_sep {
            out.push(allocator, '/').as_fs_error().?;
            out.append(allocator, component).as_fs_error()
        } else if out_has_sep and component_has_sep {
            out.append(allocator, &component[1usize..]).as_fs_error()
        } else {
            out.append(allocator, component).as_fs_error()
        }
    }
}

fn is_separator(ch: char) bool {
    ch == '/'
}

extend EncodedPath {
    pub fn init(ptr: &u8, len: usize) EncodedPath {
        { ptr: ptr, len: len }
    }

    pub fn ptr(&self) &u8 {
        self.ptr
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn bytes(&self) &[u8] {
        &self.ptr[0..self.len]
    }

    pub fn nul_terminated_bytes(&self) &[u8] {
        &self.ptr[0..(self.len + 1usize)]
    }
}

extend PathError : error::IntoError[Error] {
    fn into_error(self) Error {
        switch self {
            PathError::Invalid => Error::Invalid,
            PathError::TooLong => Error::TooLong,
            _ => Error::Invalid,
        }
    }
}

extend PathError {
    pub(pkg) fn as_fs_error(self) Error {
        self.into_error()
    }
}

extend[T] PathError!T {
    pub(pkg) fn as_fs_error(self) Error!T {
        self.cast_error()
    }
}

extend mem::Error : error::IntoError[Error] {
    fn into_error(self) Error {
        switch self {
            mem::Error::OutOfMemory => Error::OutOfMemory,
            mem::Error::Invalid => Error::Invalid,
            mem::Error::InvalidAlignment => Error::Invalid,
            mem::Error::System => Error::System,
            _ => Error::System,
        }
    }
}

extend mem::Error {
    pub(pkg) fn as_fs_error(self) Error {
        self.into_error()
    }
}

extend[T] mem::Error!T {
    pub(pkg) fn as_fs_error(self) Error!T {
        self.cast_error()
    }
}
