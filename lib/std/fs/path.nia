using pkg::fs::types;
using pkg::math;
using pkg::mem;
using pkg::slice;
using pkg::string;

using types::{
    NativePathView,
    Path,
    PathError,
    PathView,
    RelativeNativePathView,
    RelativePathView,
};

extend PathView {
    pub fun init(text: &[char]) PathView {
        .{ text }
    }

    pub fun text(&self) &[char] {
        self.text
    }

    pub fun relative(self) PathError!RelativePathView {
        RelativePathView::fromPath(self)
    }

    // Validates NULs, total UTF-8 length, and terminator capacity before
    // writing. Any encoding error leaves the complete output buffer unchanged
    // rather than publishing a partial native path.
    pub fun encode(&self, storage: &mut [u8]) PathError!NativePathView {
        let byteLen = encodedPathByteLen(self.text()).?;
        if byteLen >= storage.len() {
            return .TooLong!;
        }
        let mut out: usize = 0;
        for &ch in self.text() {
            let encoded = ch.encodeUtf8();
            for &byte in encoded.bytes() {
                storage[out] = byte;
                out += 1;
            }
        }
        storage[out] = 0;
        !.init(storage.ptr(), out)
    }
}

fun encodedPathByteLen(text: &[char]) PathError!usize {
    let mut len: usize = 0;
    for &ch in text {
        if ch.codepoint() == 0 {
            return .ContainsNul!;
        }
        len = match len.checkedAdd(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return .TooLong!,
        };
    }
    !len
}

extend RelativePathView {
    fun init(path: PathView) RelativePathView {
        .{ path }
    }

    pub fun fromText(text: &[char]) PathError!RelativePathView {
        RelativePathView::fromPath(.init(text))
    }

    pub fun fromPath(path: PathView) PathError!RelativePathView {
        validateRelativeText(path.text()).?;
        !.init(path)
    }

    pub fun path(&self) PathView {
        self.path
    }

    pub fun text(&self) &[char] {
        self.path.text()
    }

    pub fun encode(&self, storage: &mut [u8]) PathError!RelativeNativePathView {
        let native = self.path.encode(storage).?;
        !.init(native)
    }
}

extend Path {
    pub fun init() Path {
        .{ text: .init() }
    }

    pub fun initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!Path {
        let text = string::String::initCapacity(allocator, capacity).?;
        !.{ text }
    }

    pub fun fromString(text: string::String) Path {
        .{ text }
    }

    pub fun fromView(allocator: &mut mem::Allocator, path: PathView) mem::Error!Path {
        let text = string::String::fromSlice(allocator, path.text()).?;
        !.fromString(text)
    }

    pub fun fromUtf8(allocator: &mut mem::Allocator, bytes: &[u8]) string::TextError!Path {
        let text = string::String::fromUtf8(allocator, bytes).?;
        !.fromString(text)
    }

    pub fun deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.text.deinit(allocator)
    }

    pub fun view(&self) PathView {
        .init(self.text.text())
    }

    pub fun text(&self) &[char] {
        self.text.text()
    }

    pub fun len(&self) usize {
        self.text.len()
    }

    pub fun isEmpty(&self) bool {
        self.text.isEmpty()
    }

    pub fun clear(&mut self) () {
        self.text.clear()
    }

    pub fun append(&mut self, allocator: &mut mem::Allocator, text: &[char]) mem::Error!() {
        self.text.append(allocator, text)
    }

    pub fun push(&mut self, allocator: &mut mem::Allocator, ch: char) mem::Error!() {
        self.text.push(allocator, ch)
    }

    // `component` may borrow this path's own text. Its logical offset is
    // recorded before growth and the slice is rebuilt after any allocation
    // move; the join commits only after the complete length is reserved and
    // retains no temporary allocation owner.
    pub fun joinComponent(&mut self, allocator: &mut mem::Allocator, component: &[char]) mem::Error!() {
        appendComponentToString(allocator, component, &mut self.text)
    }

    pub fun encode(&self, storage: &mut [u8]) PathError!NativePathView {
        self.view().encode(storage)
    }
}

fun appendComponentToString(
    allocator: &mut mem::Allocator,
    component: &[char],
    out: &mut string::String,
) mem::Error!() {
    if component.len() == 0 {
        return !();
    }
    if out.isEmpty() {
        out.append(allocator, component)
    } else {
        let outHasSeparator = isSeparator(out.text()[out.len() - 1]);
        let componentHasSeparator = isSeparator(component[0]);
        let needsSeparator = not outHasSeparator and not componentHasSeparator;
        let appended: &[char] = if outHasSeparator and componentHasSeparator {
            &component[1..]
        } else {
            component
        };
        let separatorLen: usize = if needsSeparator { 1 } else { 0 };
        let appendLen = match appended.len().checkedAdd(separatorLen) {
            ?value => value,
            null => return .OutOfMemory!,
        };
        let needed = match out.len().checkedAdd(appendLen) {
            ?value => value,
            null => return .OutOfMemory!,
        };
        let sourceOffset = textSliceOffset(out, appended).?;
        out.ensureTotalCapacity(allocator, needed).?;
        let stableAppended: &[char] = match sourceOffset {
            ?offset => &out.text()[offset..(offset + appended.len())],
            null => appended,
        };
        if needsSeparator {
            out.pushAssumeCapacity('/');
        }
        out.appendAssumeCapacity(stableAppended);
        !()
    }
}

fun textSliceOffset(out: &string::String, text: &[char]) mem::Error!?usize {
    if text.len() == 0 or out.len() == 0 {
        return !null;
    }
    let itemSize = pkg::builtin::size[char]();
    let base = out.text().ptr() as usize;
    let source = text.ptr() as usize;
    if source < base {
        return !null;
    }
    let outBytes = match out.len().checkedMul(itemSize) {
        ?value => value,
        null => return .Invalid!,
    };
    let outEnd = match base.checkedAdd(outBytes) {
        ?value => value,
        null => return .Invalid!,
    };
    let sourceBytes = match text.len().checkedMul(itemSize) {
        ?value => value,
        null => return .Invalid!,
    };
    let sourceEnd = match source.checkedAdd(sourceBytes) {
        ?value => value,
        null => return .Invalid!,
    };
    if sourceEnd > outEnd {
        return !null;
    }
    let byteOffset = source - base;
    if byteOffset % itemSize != 0 {
        return .Invalid!;
    }
    !?(byteOffset / itemSize)
}

fun isSeparator(ch: char) bool {
    ch == '/'
}

extend NativePathView {
    fun init(ptr: &u8, len: usize) NativePathView {
        .{ ptr, len }
    }

    pub fun fromBytes(bytes: &[u8]) PathError!NativePathView {
        if bytes.len() == 0 or bytes[bytes.len() - 1] != 0 {
            return .MissingTerminator!;
        }
        let len = bytes.len() - 1;
        let mut index: usize = 0;
        while index < len {
            if bytes[index] == 0 {
                return .ContainsNul!;
            }
            index += 1;
        }
        !.init(bytes.ptr(), len)
    }

    pub fun relative(self) PathError!RelativeNativePathView {
        RelativeNativePathView::fromNative(self)
    }

    pub fun ptr(&self) &u8 {
        self.ptr
    }

    pub fun len(&self) usize {
        self.len
    }

    pub fun bytes(&self) &[u8] {
        &self.ptr[0..self.len]
    }

    pub fun nulTerminatedBytes(&self) &[u8] {
        &self.ptr[0..(self.len + 1)]
    }
}

extend RelativeNativePathView {
    fun init(path: NativePathView) RelativeNativePathView {
        .{ path }
    }

    pub fun fromBytes(bytes: &[u8]) PathError!RelativeNativePathView {
        let native = NativePathView::fromBytes(bytes).?;
        RelativeNativePathView::fromNative(native)
    }

    pub fun fromNative(path: NativePathView) PathError!RelativeNativePathView {
        validateRelativeBytes(path.bytes()).?;
        !.init(path)
    }

    pub fun native(&self) NativePathView {
        self.path
    }

    pub fun bytes(&self) &[u8] {
        self.path.bytes()
    }

    pub fun nulTerminatedBytes(&self) &[u8] {
        self.path.nulTerminatedBytes()
    }

    pub fun ptr(&self) &u8 {
        self.path.ptr()
    }
}

fun validateRelativeText(text: &[char]) PathError!() {
    if text.len() != 0 and text[0] == '/' {
        return .Absolute!;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index < text.len() {
        if text[index] == '/' {
            if index - componentStart == 2
                and text[componentStart] == '.'
                and text[componentStart + 1] == '.'
            {
                return .ParentTraversal!;
            }
            componentStart = index + 1;
        }
        index += 1;
    }
    if text.len() - componentStart == 2
        and text[componentStart] == '.'
        and text[componentStart + 1] == '.'
    {
        return .ParentTraversal!;
    }
    !()
}

fun validateRelativeBytes(bytes: &[u8]) PathError!() {
    if bytes.len() != 0 and bytes[0] == b'/' {
        return .Absolute!;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index < bytes.len() {
        if bytes[index] == b'/' {
            if index - componentStart == 2
                and bytes[componentStart] == b'.'
                and bytes[componentStart + 1] == b'.'
            {
                return .ParentTraversal!;
            }
            componentStart = index + 1;
        }
        index += 1;
    }
    if bytes.len() - componentStart == 2
        and bytes[componentStart] == b'.'
        and bytes[componentStart + 1] == b'.'
    {
        return .ParentTraversal!;
    }
    !()
}
