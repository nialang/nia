using pkg::fs::types;
using pkg::math;
using pkg::mem;
using pkg::slice;
using pkg::string;

using types::{
    NativePathView,
    Path,
    PathError,
    PathView,
    RelativeNativePathView,
    RelativePathView,
};

extend PathView {
    pub fn init(text: &[char]) PathView {
        { text: text }
    }

    pub fn text(&self) &[char] {
        self.text
    }

    pub fn relative(self) PathError!RelativePathView {
        RelativePathView::fromPath(self)
    }

    pub fn encode(&self, storage: &mut [u8]) PathError!NativePathView {
        let mut out: usize = 0;
        for &ch in self.text() {
            if ch.codepoint() == 0 {
                return PathError::ContainsNul!;
            }
            let encoded = ch.encodeUtf8();
            let next = switch out.checked_add(encoded.byteLen()) {
                ?value => value,
                null => return PathError::TooLong!,
            };
            if next >= storage.len() {
                return PathError::TooLong!;
            }
            for &byte in encoded.bytes() {
                storage[out] = byte;
                out += 1;
            }
        }
        if out >= storage.len() {
            return PathError::TooLong!;
        }
        storage[out] = 0;
        !NativePathView::init(storage.ptr(), out)
    }
}

extend RelativePathView {
    fn init(path: PathView) RelativePathView {
        { path: path }
    }

    pub fn fromText(text: &[char]) PathError!RelativePathView {
        RelativePathView::fromPath(PathView::init(text))
    }

    pub fn fromPath(path: PathView) PathError!RelativePathView {
        validateRelativeText(path.text()).?;
        !RelativePathView::init(path)
    }

    pub fn path(&self) PathView {
        self.path
    }

    pub fn text(&self) &[char] {
        self.path.text()
    }

    pub fn encode(&self, storage: &mut [u8]) PathError!RelativeNativePathView {
        let native = self.path.encode(storage).?;
        !RelativeNativePathView::init(native)
    }
}

extend Path {
    pub fn init() Path {
        { text: string::String::init() }
    }

    pub fn initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!Path {
        let text = string::String::initCapacity(allocator, capacity).?;
        !Path { text: text }
    }

    pub fn fromString(text: string::String) Path {
        { text: text }
    }

    pub fn fromView(allocator: &mut mem::Allocator, path: PathView) mem::Error!Path {
        let text = string::String::fromSlice(allocator, path.text()).?;
        !Path::fromString(text)
    }

    pub fn fromUtf8(allocator: &mut mem::Allocator, bytes: &[u8]) string::TextError!Path {
        let text = string::String::fromUtf8(allocator, bytes).?;
        !Path::fromString(text)
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.text.deinit(allocator)
    }

    pub fn view(&self) PathView {
        PathView::init(self.text.text())
    }

    pub fn text(&self) &[char] {
        self.text.text()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn isEmpty(&self) bool {
        self.text.isEmpty()
    }

    pub fn clear(&mut self) () {
        self.text.clear()
    }

    pub fn append(&mut self, allocator: &mut mem::Allocator, text: &[char]) mem::Error!() {
        self.text.append(allocator, text)
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, ch: char) mem::Error!() {
        self.text.push(allocator, ch)
    }

    pub fn joinComponent(&mut self, allocator: &mut mem::Allocator, component: &[char]) mem::Error!() {
        appendComponentToString(allocator, component, &mut self.text)
    }

    pub fn encode(&self, storage: &mut [u8]) PathError!NativePathView {
        self.view().encode(storage)
    }
}

fn appendComponentToString(
    allocator: &mut mem::Allocator,
    component: &[char],
    out: &mut string::String,
) mem::Error!() {
    if component.len() == 0 {
        return !();
    }
    if out.isEmpty() {
        out.append(allocator, component)
    } else {
        let outHasSeparator = isSeparator(out.text()[out.len() - 1]);
        let componentHasSeparator = isSeparator(component[0]);
        let needsSeparator = not outHasSeparator and not componentHasSeparator;
        let appended: &[char] = if outHasSeparator and componentHasSeparator {
            &component[1..]
        } else {
            component
        };
        let separatorLen: usize = if needsSeparator { 1 } else { 0 };
        let appendLen = switch appended.len().checked_add(separatorLen) {
            ?value => value,
            null => return mem::Error::OutOfMemory!,
        };
        let needed = switch out.len().checked_add(appendLen) {
            ?value => value,
            null => return mem::Error::OutOfMemory!,
        };
        out.ensureTotalCapacity(allocator, needed).?;
        if needsSeparator {
            out.push(allocator, '/').?;
        }
        out.append(allocator, appended)
    }
}

fn isSeparator(ch: char) bool {
    ch == '/'
}

extend NativePathView {
    fn init(ptr: &u8, len: usize) NativePathView {
        { ptr: ptr, len: len }
    }

    pub fn fromBytes(bytes: &[u8]) PathError!NativePathView {
        if bytes.len() == 0 or bytes[bytes.len() - 1] != 0 {
            return PathError::MissingTerminator!;
        }
        let len = bytes.len() - 1;
        let mut index: usize = 0;
        while index < len {
            if bytes[index] == 0 {
                return PathError::ContainsNul!;
            }
            index += 1;
        }
        !NativePathView::init(bytes.ptr(), len)
    }

    pub fn relative(self) PathError!RelativeNativePathView {
        RelativeNativePathView::fromNative(self)
    }

    pub fn ptr(&self) &u8 {
        self.ptr
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn bytes(&self) &[u8] {
        &self.ptr[0..self.len]
    }

    pub fn nulTerminatedBytes(&self) &[u8] {
        &self.ptr[0..(self.len + 1)]
    }
}

extend RelativeNativePathView {
    fn init(path: NativePathView) RelativeNativePathView {
        { path: path }
    }

    pub fn fromBytes(bytes: &[u8]) PathError!RelativeNativePathView {
        let native = NativePathView::fromBytes(bytes).?;
        RelativeNativePathView::fromNative(native)
    }

    pub fn fromNative(path: NativePathView) PathError!RelativeNativePathView {
        validateRelativeBytes(path.bytes()).?;
        !RelativeNativePathView::init(path)
    }

    pub fn native(&self) NativePathView {
        self.path
    }

    pub fn bytes(&self) &[u8] {
        self.path.bytes()
    }

    pub fn nulTerminatedBytes(&self) &[u8] {
        self.path.nulTerminatedBytes()
    }

    pub fn ptr(&self) &u8 {
        self.path.ptr()
    }
}

fn validateRelativeText(text: &[char]) PathError!() {
    if text.len() != 0 and text[0] == '/' {
        return PathError::Absolute!;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index < text.len() {
        if text[index] == '/' {
            if index - componentStart == 2
                and text[componentStart] == '.'
                and text[componentStart + 1] == '.'
            {
                return PathError::ParentTraversal!;
            }
            componentStart = index + 1;
        }
        index += 1;
    }
    if text.len() - componentStart == 2
        and text[componentStart] == '.'
        and text[componentStart + 1] == '.'
    {
        return PathError::ParentTraversal!;
    }
    !()
}

fn validateRelativeBytes(bytes: &[u8]) PathError!() {
    if bytes.len() != 0 and bytes[0] == b'/' {
        return PathError::Absolute!;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index < bytes.len() {
        if bytes[index] == b'/' {
            if index - componentStart == 2
                and bytes[componentStart] == b'.'
                and bytes[componentStart + 1] == b'.'
            {
                return PathError::ParentTraversal!;
            }
            componentStart = index + 1;
        }
        index += 1;
    }
    if bytes.len() - componentStart == 2
        and bytes[componentStart] == b'.'
        and bytes[componentStart + 1] == b'.'
    {
        return PathError::ParentTraversal!;
    }
    !()
}
