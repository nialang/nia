using super::{DoubleEndedIterator, Rev};

pub trait Step {
    fn forward_checked(self) ?Self;
}

pub trait StepBack {
    fn backward_checked(self) ?Self;
}

pub struct Range[T] {
    start: T,
    end: T,
}

pub struct RangeInclusive[T] {
    current: T,
    end: T,
    done: bool,
}

pub struct RangeFrom[T] {
    current: T,
    done: bool,
}

extend[T] Range[T] {
    pub fn init(start: T, end: T) Range[T] {
        { start: start, end: end }
    }

    pub fn from_bounds(bounds: T..T) Range[T] {
        Range[T]::init(bounds.start(), bounds.end())
    }

    pub fn start(&self) T {
        self.start
    }

    pub fn end(&self) T {
        self.end
    }
}

extend[T] Range[T] : Iterator
where T: Step + Ord[T]
{
    type Item = T;

    pub fn next(&mut self) ?T {
        if self.start >= self.end {
            null
        } else {
            let value = self.start;
            self.start = switch self.start.forward_checked() {
                ?next => {
                    next
                },
                null => {
                    self.end
                },
            };
            ?value
        }
    }
}

extend[T] Range[T] : DoubleEndedIterator
where T: Step + StepBack + Ord[T]
{
    pub fn next_back(&mut self) ?[Range[T] as Iterator]::Item {
        if self.start >= self.end {
            null
        } else {
            self.end = switch self.end.backward_checked() {
                ?previous => {
                    previous
                },
                null => {
                    self.start
                },
            };
            ?self.end
        }
    }
}

extend[T] Range[T]
where T: Step + StepBack + Ord[T]
{
    pub fn rev(self) Rev[Range[T]] {
        Rev[Range[T]]::init(self)
    }
}

extend[T] T..T : Iterable
where T: Step + Ord[T]
{
    type Item = T;
    type Iter = Range[T];

    pub fn iter(&self) Range[T] {
        Range[T]::from_bounds(self.*)
    }
}

extend[T] RangeInclusive[T]
where T: Ord[T]
{
    pub fn init(start: T, end: T) RangeInclusive[T] {
        { current: start, end: end, done: start > end }
    }

    pub fn from_bounds(bounds: T..=T) RangeInclusive[T] {
        RangeInclusive[T]::init(bounds.start(), bounds.end())
    }

    pub fn start(&self) T {
        self.current
    }

    pub fn end(&self) T {
        self.end
    }
}

extend[T] RangeInclusive[T] : Iterator
where T: Step + Ord[T] + Eq[T]
{
    type Item = T;

    pub fn next(&mut self) ?T {
        if self.done {
            return null;
        }
        let value = self.current;
        if value == self.end {
            self.done = true;
        } else {
            self.current = switch self.current.forward_checked() {
                ?next => {
                    next
                },
                null => {
                        self.done = true;
                        self.end
                },
            };
        }
        ?value
    }
}

extend[T] RangeInclusive[T] : DoubleEndedIterator
where T: Step + StepBack + Ord[T] + Eq[T]
{
    pub fn next_back(&mut self) ?[RangeInclusive[T] as Iterator]::Item {
        if self.done {
            return null;
        }
        let value = self.end;
        if value == self.current {
            self.done = true;
        } else {
            self.end = switch self.end.backward_checked() {
                ?previous => {
                    previous
                },
                null => {
                        self.done = true;
                        self.current
                },
            };
        }
        ?value
    }
}

extend[T] RangeInclusive[T]
where T: Step + StepBack + Ord[T] + Eq[T]
{
    pub fn rev(self) Rev[RangeInclusive[T]] {
        Rev[RangeInclusive[T]]::init(self)
    }
}

extend[T] T..=T : Iterable
where T: Step + Ord[T] + Eq[T]
{
    type Item = T;
    type Iter = RangeInclusive[T];

    pub fn iter(&self) RangeInclusive[T] {
        RangeInclusive[T]::from_bounds(self.*)
    }
}

extend[T] RangeFrom[T] {
    pub fn init(start: T) RangeFrom[T] {
        { current: start, done: false }
    }

    pub fn from_bounds(bounds: T..) RangeFrom[T] {
        RangeFrom[T]::init(bounds.start())
    }

    pub fn start(&self) T {
        self.current
    }
}

extend[T] RangeFrom[T] : Iterator
where T: Step
{
    type Item = T;

    pub fn next(&mut self) ?T {
        if self.done {
            return null;
        }
        let value = self.current;
        self.current = switch self.current.forward_checked() {
            ?next => {
                next
            },
            null => {
                    self.done = true;
                    self.current
            },
        };
        ?value
    }
}

extend[T] T.. : Iterable
where T: Step
{
    type Item = T;
    type Iter = RangeFrom[T];

    pub fn iter(&self) RangeFrom[T] {
        RangeFrom[T]::from_bounds(self.*)
    }
}

extend i8 : Step {
    pub fn forward_checked(self) ?i8 {
        if self == i8::MAX { null } else { ?(self + 1i8) }
    }
}

extend i8 : StepBack {
    pub fn backward_checked(self) ?i8 {
        if self == i8::MIN { null } else { ?(self - 1i8) }
    }
}

