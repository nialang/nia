pub comptime let wyhash_secret0: u64 = 0xa0761d6478bd642fu64;
pub comptime let wyhash_secret1: u64 = 0xe7037ed1a0b428dbu64;
pub comptime let wyhash_secret2: u64 = 0x8ebc6af09c88c6e3u64;
pub comptime let wyhash_secret3: u64 = 0x589965cc75374cc3u64;

pub trait Hasher {
    fn write(&mut self, bytes: &[u8]) void;
    fn finish(&self) u64;
}

pub trait Hash[H]
where H: Hasher
{
    fn hash(&self, hasher: &mut H) void;
}

pub fn wyhash(seed: u64, bytes: &[u8]) u64 {
    var state0 = seed ^ mix(seed ^ wyhash_secret0, wyhash_secret1);
    var state1 = state0;
    var state2 = state0;
    var a = 0u64;
    var b = 0u64;

    if bytes.len() <= 16usize {
        if bytes.len() >= 4usize {
            let end = bytes.len() - 4usize;
            let quarter = (bytes.len() >> 3usize) << 2usize;
            a = (read4(&bytes[0..]) << 32u64) | read4(&bytes[quarter..]);
            b = (read4(&bytes[end..]) << 32u64) | read4(&bytes[end - quarter..]);
        } else if bytes.len() > 0usize {
            a = ((bytes[0] as u64) << 16u64)
                | ((bytes[bytes.len() >> 1usize] as u64) << 8u64)
                | (bytes[bytes.len() - 1usize] as u64);
            b = 0u64;
        }
    } else {
        var i = 0usize;
        if bytes.len() >= 48usize {
            while i + 48usize < bytes.len() {
                state0 = mix(read8(&bytes[i..]) ^ wyhash_secret1, read8(&bytes[i + 8usize..]) ^ state0);
                state1 = mix(read8(&bytes[i + 16usize..]) ^ wyhash_secret2, read8(&bytes[i + 24usize..]) ^ state1);
                state2 = mix(read8(&bytes[i + 32usize..]) ^ wyhash_secret3, read8(&bytes[i + 40usize..]) ^ state2);
                i += 48usize;
            }
            state0 ^= state1 ^ state2;
        }

        while i + 16usize < bytes.len() {
            state0 = mix(read8(&bytes[i..]) ^ wyhash_secret1, read8(&bytes[i + 8usize..]) ^ state0);
            i += 16usize;
        }

        a = read8(&bytes[bytes.len() - 16usize..]);
        b = read8(&bytes[bytes.len() - 8usize..]);
    }

    a ^= wyhash_secret1;
    b ^= state0;
    let product = (a as u128) * (b as u128);
    a = product as u64;
    b = (product >> 64u128) as u64;
    mix(a ^ wyhash_secret0 ^ (bytes.len() as u64), b ^ wyhash_secret1)
}

fn mix(a: u64, b: u64) u64 {
    let product = (a as u128) * (b as u128);
    (product as u64) ^ ((product >> 64u128) as u64)
}

fn read4(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64)
}

fn read8(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64)
        | ((bytes[4] as u64) << 32u64)
        | ((bytes[5] as u64) << 40u64)
        | ((bytes[6] as u64) << 48u64)
        | ((bytes[7] as u64) << 56u64)
}

extend[H] u8 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([self.*])
    }
}

extend[H] u16 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([
            self.* as u8,
            (self.* >> 8u16) as u8,
        ])
    }
}

extend[H] u32 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([
            self.* as u8,
            (self.* >> 8u32) as u8,
            (self.* >> 16u32) as u8,
            (self.* >> 24u32) as u8,
        ])
    }
}

extend[H] u64 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([
            self.* as u8,
            (self.* >> 8u64) as u8,
            (self.* >> 16u64) as u8,
            (self.* >> 24u64) as u8,
            (self.* >> 32u64) as u8,
            (self.* >> 40u64) as u8,
            (self.* >> 48u64) as u8,
            (self.* >> 56u64) as u8,
        ])
    }
}

extend[H] usize : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u64).hash(hasher)
    }
}

extend[H] i32 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u32).hash(hasher)
    }
}

extend[H] [u8] : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write(self)
    }
}
