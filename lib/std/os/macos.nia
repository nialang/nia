// Darwin platform boundary. Native calls stay in the private bindings module;
// operations without an implementation still return Unsupported explicitly.
pub(root) module bindings;
using root::os::macos::bindings;
using root::error;
using root::math;
using root::option;

// Keep parity with Darwin's PATH_MAX-sized syscall buffers. The shorter
// fcntl(F_GETPATH) buffer below is only used for capability containment.
pub const maxPathBytes: usize = 4096;
const fdPathBytes: usize = 1024;

pub enum Errno: i32 {
    PermissionDenied = 1, NoEntry = 2, Interrupted = 4, Io = 5,
    BadFd = 9, NoChild = 10, Again = 35, NoMemory = 12, Access = 13,
    Fault = 14, Busy = 16, Exists = 17, CrossDevice = 18, NotDir = 20,
    IsDir = 21, Invalid = 22, NoSpace = 28, ReadOnly = 30, BrokenPipe = 32,
    OutOfRange = 34, TooLong = 63, Unsupported = 45, SymlinkLoop = 62,
    NotEmpty = 66, _,
}

pub enum SpawnStage: i32 { Setup = 1, Stdio = 2, Cwd = 3, Exec = 4, _ }
pub enum SpawnError {
    Setup(Errno), Stdio(Errno), Cwd(Errno), Exec(Errno),
    Reap { stage: SpawnStage, primary: Errno, cause: Errno, pid: ProcessId },
}
pub enum OpenMode: i32 { ReadOnly = 0, WriteOnly = 1, ReadWrite = 2, _ }
pub enum SeekWhence: usize { Start = 0, Current = 1, End = 2, _ }
pub enum StdIo: i32 { Inherit = 1, Ignore = 2, Pipe = 3 }
pub enum FileKind: i32 {
    BlockDevice = 1, CharacterDevice = 2, Directory = 3, NamedPipe = 4,
    Symlink = 5, File = 6, UnixSocket = 7, Unknown = 255, _
}

pub struct Timestamp { seconds: i64, nanos: u32 }
pub struct FileMetadata {
    kind: FileKind, inode: u64, nlink: u32, size: u64, mode: u32,
    blockSize: u32, atime: ?Timestamp, mtime: Timestamp, ctime: ?Timestamp,
}
pub struct DirectoryEntry { kind: FileKind, name: &[u8], size: u64 }
pub struct DirectoryReader { base: i64 }
pub struct FileDescriptor { fd: i32 }
pub struct ProcessId { pid: i32 }
pub struct WaitStatus { raw: i32 }
pub struct SpawnResult {
    pid: ProcessId, stdin: ?FileDescriptor, stdout: ?FileDescriptor, stderr: ?FileDescriptor,
}
pub struct SpawnAttempt { result: ?SpawnResult, error: ?SpawnError }
pub struct SpawnOptions { stdin: StdIo, stdout: StdIo, stderr: StdIo, cwd: ?&u8 }
pub struct MappedPages { ptr: &mut u8, releasePtr: &mut u8, releaseSize: usize }

extend Timestamp {
    pub fun init(seconds: i64, nanos: u32) Timestamp { .{ seconds, nanos } }
    pub fun seconds(&self) i64 { self.seconds }
    pub fun nanos(&self) u32 { self.nanos }
}
extend FileMetadata {
    pub fun init(kind: FileKind, inode: u64, nlink: u32, size: u64, mode: u32, blockSize: u32, atime: ?Timestamp, mtime: Timestamp, ctime: ?Timestamp) FileMetadata {
        .{ kind, inode, nlink, size, mode, blockSize, atime, mtime, ctime }
    }
    pub fun kind(&self) FileKind { self.kind }
    pub fun inode(&self) u64 { self.inode }
    pub fun nlink(&self) u32 { self.nlink }
    pub fun size(&self) u64 { self.size }
    pub fun mode(&self) u32 { self.mode }
    pub fun blockSize(&self) u32 { self.blockSize }
    pub fun atime(&self) ?Timestamp { self.atime }
    pub fun mtime(&self) Timestamp { self.mtime }
    pub fun ctime(&self) ?Timestamp { self.ctime }
}
extend DirectoryEntry {
    pub fun init(kind: FileKind, name: &[u8], size: u64) DirectoryEntry { .{ kind, name, size } }
    pub fun kind(&self) FileKind { self.kind }
    pub fun name(&self) &[u8] { self.name }
    pub fun size(&self) u64 { self.size }
}
extend ProcessId {
    pub const fun init(pid: i32) ProcessId { .{ pid } }
    pub const fun raw(&self) i32 { self.pid }
}
extend WaitStatus {
    pub fun init(raw: i32) WaitStatus { .{ raw } }
    pub fun raw(&self) i32 { self.raw }
    pub fun exited(&self) bool { (self.raw & 0x7f) == 0 }
    pub fun signaled(&self) bool { let signal = self.raw & 0x7f; signal != 0 and signal != 0x7f }
    pub fun stopped(&self) bool { (self.raw & 0xff) == 0x7f }
    pub fun exitCode(&self) ?i32 { if self.exited() { ?((self.raw >> 8) & 0xff) } else { null } }
    pub fun signal(&self) ?i32 { if self.signaled() { ?(self.raw & 0x7f) } else { null } }
    pub fun stopSignal(&self) ?i32 { if self.stopped() { ?((self.raw >> 8) & 0xff) } else { null } }
}
extend SpawnResult {
    pub fun init(pid: ProcessId, stdin: ?FileDescriptor, stdout: ?FileDescriptor, stderr: ?FileDescriptor) SpawnResult { .{ pid, stdin, stdout, stderr } }
    pub fun pid(&self) ProcessId { self.pid }
    pub fun stdin(&self) ?FileDescriptor { self.stdin }
    pub fun stdout(&self) ?FileDescriptor { self.stdout }
    pub fun stderr(&self) ?FileDescriptor { self.stderr }
}
extend SpawnAttempt {
    pub fun success(result: SpawnResult) SpawnAttempt { .{ result: ?result, error: null } }
    pub fun failure(error: SpawnError) SpawnAttempt { .{ result: null, error: ?error } }
    pub fun finish(&mut self) SpawnError!SpawnResult {
        match self.result {
            ?value => { self.result = null; !value },
            null => match self.error { ?value => { self.error = null; value! }, null => .Setup(.Io)! },
        }
    }
}
extend SpawnError {
    pub fun fromStage(stage: SpawnStage, errno: Errno) SpawnError {
        match stage { .Setup => .Setup(errno), .Stdio => .Stdio(errno), .Cwd => .Cwd(errno), .Exec => .Exec(errno), _ => .Setup(errno) }
    }
    pub fun stage(&self) SpawnStage { match self.* { .Setup(_) => .Setup, .Stdio(_) => .Stdio, .Cwd(_) => .Cwd, .Exec(_) => .Exec, .Reap { stage, primary: _, cause: _, pid: _ } => stage } }
    pub fun primary(&self) Errno { match self.* { .Setup(value) => value, .Stdio(value) => value, .Cwd(value) => value, .Exec(value) => value, .Reap { stage: _, primary, cause: _, pid: _ } => primary } }
}
extend SpawnOptions {
    pub fun init() SpawnOptions { .{ stdin: .Inherit, stdout: .Inherit, stderr: .Inherit, cwd: null } }
    pub fun stdin(&self) StdIo { self.stdin }
    pub fun stdout(&self) StdIo { self.stdout }
    pub fun stderr(&self) StdIo { self.stderr }
    pub fun cwd(&self) ?&u8 { self.cwd }
    pub fun setStdin(&mut self, value: StdIo) () { self.stdin = value }
    pub fun setStdout(&mut self, value: StdIo) () { self.stdout = value }
    pub fun setStderr(&mut self, value: StdIo) () { self.stderr = value }
    pub fun setCwd(&mut self, value: &u8) () { self.cwd = ?value }
}
extend MappedPages {
    pub fun ptr(&self) &mut u8 { self.ptr }
    pub fun releasePtr(&self) &mut u8 { self.releasePtr }
    pub fun releaseSize(&self) usize { self.releaseSize }
}

extend FileDescriptor {
    pub fun init(fd: i32) FileDescriptor { .{ fd } }
    pub fun stdin() FileDescriptor { .init(0) }
    pub fun stdout() FileDescriptor { .init(1) }
    pub fun stderr() FileDescriptor { .init(2) }
    pub fun raw(&self) i32 { self.fd }
    pub fun writeSome(&self, bytes: &[u8]) Errno!usize {
        let ret = bindings::write(self.fd, bytes.ptr(), bytes.len());
        if ret < 0 { return errno()!; }
        if ret as usize > bytes.len() { return .Io!; }
        !(ret as usize)
    }
    pub fun readSome(&self, bytes: &mut [u8]) Errno!usize {
        let ret = bindings::read(self.fd, bytes.ptrMut(), bytes.len());
        if ret < 0 { return errno()!; }
        if ret as usize > bytes.len() { return .Io!; }
        !(ret as usize)
    }
    pub fun close(&self) Errno!() { checkZero(bindings::close(self.fd)) }
    pub fun seek(&self, offset: i64, whence: SeekWhence) Errno!u64 {
        let ret = bindings::lseek(self.fd, offset, whence as i32);
        if ret < 0 { return errno()!; }
        !(ret as u64)
    }
    pub fun truncate(&self, len: u64) Errno!() { checkZero(bindings::ftruncate(self.fd, len as i64)) }
    pub fun setPermissions(&self, permissions: u32) Errno!() {
        checkZero(bindings::fchmod(self.fd, permissions as u16))
    }
    pub fun sync(&self) Errno!() { checkZero(bindings::fsync(self.fd)) }
    pub fun syncData(&self) Errno!() { checkZero(bindings::fdatasync(self.fd)) }
    pub fun metadata(&self) Errno!FileMetadata {
        let mut stat: bindings::DarwinStat;
        if bindings::fstat(self.fd, &mut stat) != 0 { return errno()!; }
        stat.asMetadata()
    }
}

pub fun initDirectoryReader() DirectoryReader { .{ base: 0 } }
pub fun closeDirectoryReader(reader: &mut DirectoryReader) Errno!() { _ = reader; !() }
pub fun readDirEntries(reader: &mut DirectoryReader, handle: FileDescriptor, buffer: &mut [u8]) Errno!usize {
    if buffer.len() == 0 { return .Invalid!; }
    let ret = bindings::getdirentries64(handle.fd, buffer.ptrMut(), buffer.len(), &mut reader.base);
    if ret < 0 { return errno()!; }
    let amount = ret as usize;
    if amount > buffer.len() { return .Io!; }
    !amount
}
pub fun dirEntryAt(handle: FileDescriptor, buffer: &[u8], offset: usize) Errno!DirectoryEntry {
    if parseDirent(buffer, offset) is ?parsed {
        let metadata = metadataAtDirent(handle, &buffer[parsed.nameStart]).?;
        return !DirectoryEntry::init(
            metadata.kind(),
            &buffer[parsed.nameStart..parsed.nameEnd],
            metadata.size(),
        );
    }
    .Invalid!
}
pub fun dirEntryNextOffset(buffer: &[u8], offset: usize) ?usize {
    parseDirent(buffer, offset).map[usize, _](\parsed: ParsedDirent -> parsed.recordEnd)
}
pub fun cwd() FileDescriptor { .init(-2) }
pub fun getCwd(buffer: &mut [u8]) Errno!&[u8] {
    if buffer.len() == 0 { return .Invalid!; }
    let result = bindings::getcwd(buffer.ptrMut(), buffer.len());
    if result as usize == 0 { return errno()!; }
    let mut length: usize = 0;
    while length < buffer.len() and buffer[length] != 0 { length += 1; }
    if length == buffer.len() { return .Io!; }
    !&buffer[0..length]
}
pub fun pageSize() usize { 4096 }
pub fun pageAlignedLen(len: usize) Errno!usize { if len.alignForward(pageSize()) is ?value { !value } else { .OutOfRange! } }
pub fun mapPages(len: usize, align: usize) Errno!MappedPages {
    if len == 0 or align == 0 or not align.isPowerOfTwo() { return .Invalid!; }
    let alignedLen = pageAlignedLen(len).?;
    let extra = if align > pageSize() { align - pageSize() } else { 0 };
    let mapLen = match alignedLen.checkedAdd(extra) {
        ?value => value,
        null => return .OutOfRange!,
    };
    let mapped = bindings::mmap(0, mapLen, bindings::protRead | bindings::protWrite, bindings::mapPrivate | bindings::mapAnonymous, -1, 0);
    if mapped as usize == usize::MAX { return errno()!; }
    let mappedAddr = mapped as usize;
    if mappedAddr.checkedAdd(mapLen) is null {
        _ = bindings::munmap(mapped, mapLen);
        return .OutOfRange!;
    }
    let resultAddr = match mappedAddr.alignForward(align) {
        ?value => value,
        null => {
            _ = bindings::munmap(mapped, mapLen);
            return .OutOfRange!;
        },
    };
    !.{ ptr: resultAddr as &mut u8, releasePtr: mapped, releaseSize: mapLen }
}
pub fun unmapPages(ptr: &mut u8, len: usize) Errno!() {
    if len == 0 { return .Invalid!; }
    checkZero(bindings::munmap(ptr, pageAlignedLen(len).?))
}
pub fun random(bytes: &mut [u8]) Errno!() {
    let mut offset: usize = 0;
    while offset < bytes.len() {
        let remaining = bytes.len() - offset;
        let chunk = if remaining > 256 { 256 } else { remaining };
        let mut chunkBuffer = &mut bytes[offset..];
        if bindings::getentropy(chunkBuffer.ptrMut(), chunk) != 0 { return errno()!; }
        offset += chunk;
    }
    !()
}
pub fun openAt(dir: FileDescriptor, path: &u8, mode: OpenMode, create: bool, truncate: bool, exclusive: bool, permissions: u32) Errno!FileDescriptor {
    let flags = openFlags(mode, false, create, truncate, exclusive, true);
    let ret = bindings::openat(dir.fd, path, flags, permissions);
    if ret < 0 { return errno()!; }
    !FileDescriptor::init(ret)
}
pub fun openAtBeneath(dir: FileDescriptor, path: &u8, mode: OpenMode, directory: bool, create: bool, truncate: bool, exclusive: bool, permissions: u32, followSymlinks: bool) Errno!FileDescriptor {
    let mut storage: [u8; maxPathBytes] = [0; maxPathBytes];
    let length = copyAndValidateRelative(path, &mut storage[..]).?;
    let mut current = dir;
    let mut ownsCurrent = false;
    let mut cursor: usize = 0;
    while cursor < length {
        while cursor < length and storage[cursor] == b'/' { cursor += 1; }
        if cursor == length { break; }
        let componentStart = cursor;
        while cursor < length and storage[cursor] != b'/' { cursor += 1; }
        let componentEnd = cursor;
        while cursor < length and storage[cursor] == b'/' { cursor += 1; }
        let isFinal = cursor == length;
        storage[componentEnd] = 0;
        if isFinal {
            // Never follow an existing final link for a mutating open. A
            // read-only open may follow it, but the resulting descriptor is
            // checked against the capability root before publication.
            let effectiveFollow = followSymlinks and not create and not truncate and not exclusive;
            let flags = openFlags(mode, directory, create, truncate, exclusive, effectiveFollow);
            let ret = bindings::openat(current.fd, &storage[componentStart], flags, permissions);
            if ret < 0 {
                let cause = errno();
                if ownsCurrent { _ = current.close(); }
                return cause!;
            }
            let result = FileDescriptor::init(ret);
            if effectiveFollow {
                let containment = ensureContained(dir, result);
                if containment is error! {
                    _ = result.close();
                    if ownsCurrent { _ = current.close(); }
                    return error!;
                }
            }
            if ownsCurrent { _ = current.close(); }
            return !result;
        }
        let ret = bindings::openat(current.fd, &storage[componentStart], bindings::openDirectory | bindings::openNoFollow, 0);
        if ret < 0 {
            let cause = errno();
            // Darwin reports either ELOOP or ENOTDIR when O_NOFOLLOW meets
            // an intermediate symlink. Inspect the component without
            // following it so ordinary non-directory errors retain identity.
            let mut escaped = false;
            if cause == .SymlinkLoop or cause == .NotDir {
                let mut stat: bindings::DarwinStat;
                if bindings::fstatat(current.fd, &storage[componentStart], &mut stat, bindings::atSymlinkNoFollow) == 0
                    and stat.kind() == .Symlink
                {
                    escaped = true;
                }
            }
            if ownsCurrent { _ = current.close(); }
            if escaped { return .CrossDevice!; }
            return cause!;
        }
        if ownsCurrent { _ = current.close(); }
        current = FileDescriptor::init(ret);
        ownsCurrent = true;
    }
    if ownsCurrent { _ = current.close(); }
    .Invalid!
}
pub fun createDirAtBeneath(dir: FileDescriptor, parent: &u8, name: &u8, permissions: u32) Errno!() {
    let parentHandle = openAtBeneath(dir, parent, .ReadOnly, true, false, false, false, 0, false).?;
    let result = bindings::mkdirat(parentHandle.fd, name, permissions as u16);
    let operation = checkZero(result);
    operation.cleanupAfter(parentHandle.close())
}
pub fun deleteAtBeneath(dir: FileDescriptor, parent: &u8, name: &u8, directory: bool) Errno!() {
    let parentHandle = openAtBeneath(dir, parent, .ReadOnly, true, false, false, false, 0, false).?;
    let flags = if directory { bindings::atRemoveDir } else { 0 };
    let result = bindings::unlinkat(parentHandle.fd, name, flags);
    let operation = checkZero(result);
    operation.cleanupAfter(parentHandle.close())
}
pub fun renameAtBeneath(oldDir: FileDescriptor, oldParent: &u8, oldName: &u8, newDir: FileDescriptor, newParent: &u8, newName: &u8) Errno!() {
    let oldHandle = openAtBeneath(oldDir, oldParent, .ReadOnly, true, false, false, false, 0, false).?;
    let newHandle = match openAtBeneath(newDir, newParent, .ReadOnly, true, false, false, false, 0, false) {
        !handle => handle,
        error! => { _ = oldHandle.close(); return error!; },
    };
    let result = bindings::renameat(oldHandle.fd, oldName, newHandle.fd, newName);
    let operation = checkZero(result);
    operation.cleanupAfter(oldHandle.close()).cleanupAfter(newHandle.close())
}
pub fun metadataAtBeneath(dir: FileDescriptor, path: &u8, followSymlinks: bool) Errno!FileMetadata {
    if followSymlinks {
        let handle = openAtBeneath(dir, path, .ReadOnly, false, false, false, false, 0, true).?;
        let result = handle.metadata();
        return result.cleanupAfter(handle.close());
    }
    let mut storage: [u8; maxPathBytes] = [0; maxPathBytes];
    let length = copyAndValidateRelative(path, &mut storage[..]).?;
    let mut finalEnd = length;
    while finalEnd != 0 and storage[finalEnd - 1] == b'/' { finalEnd -= 1; }
    storage[finalEnd] = 0;
    let finalStart = finalComponentStart(&storage[..], finalEnd);
    let mut current = dir;
    let mut ownsCurrent = false;
    let mut cursor: usize = 0;
    while cursor < finalStart {
        while cursor < finalStart and storage[cursor] == b'/' { cursor += 1; }
        if cursor == finalStart { break; }
        let componentStart = cursor;
        while cursor < finalStart and storage[cursor] != b'/' { cursor += 1; }
        let componentEnd = cursor;
        while cursor < finalStart and storage[cursor] == b'/' { cursor += 1; }
        storage[componentEnd] = 0;
        let ret = bindings::openat(current.fd, &storage[componentStart], bindings::openDirectory | bindings::openNoFollow, 0);
        if ret < 0 {
            let cause = errno();
            let mut escaped = false;
            if cause == .SymlinkLoop or cause == .NotDir {
                let mut linkStat: bindings::DarwinStat;
                if bindings::fstatat(current.fd, &storage[componentStart], &mut linkStat, bindings::atSymlinkNoFollow) == 0
                    and linkStat.kind() == .Symlink
                {
                    escaped = true;
                }
            }
            if ownsCurrent { _ = current.close(); }
            if escaped { return .CrossDevice!; }
            return cause!;
        }
        if ownsCurrent { _ = current.close(); }
        current = FileDescriptor::init(ret);
        ownsCurrent = true;
        while cursor < finalStart and storage[cursor] == b'/' { cursor += 1; }
    }
    let flags = if followSymlinks { 0 } else { bindings::atSymlinkNoFollow };
    let mut stat: bindings::DarwinStat;
    if bindings::fstatat(current.fd, &storage[finalStart], &mut stat, flags) != 0 {
        let cause = errno();
        if ownsCurrent { _ = current.close(); }
        return cause!;
    }
    let result = stat.asMetadata();
    if ownsCurrent { result.cleanupAfter(current.close()) } else { result }
}
struct SpawnPipe { read: ?FileDescriptor, write: ?FileDescriptor }
struct SpawnResources { stdin: SpawnPipe, stdout: SpawnPipe, stderr: SpawnPipe, error: SpawnPipe }
struct SpawnErrorRecord { stage: i32, code: i32 }

pub fun spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    let mut resources = SpawnResources::init();
    let result = spawnWithResources(path, argv, envp, options, &mut resources);
    resources.closeAll();
    result
}

fun spawnWithResources(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions, resources: &mut SpawnResources) SpawnAttempt {
    if options.stdin() == StdIo::Pipe {
        resources.stdin = match SpawnPipe::openCloseOnExec() { !pipe => pipe, error! => return .failure(.Setup(error)) };
    }
    if options.stdout() == StdIo::Pipe {
        resources.stdout = match SpawnPipe::openCloseOnExec() { !pipe => pipe, error! => return .failure(.Setup(error)) };
    }
    if options.stderr() == StdIo::Pipe {
        resources.stderr = match SpawnPipe::openCloseOnExec() { !pipe => pipe, error! => return .failure(.Setup(error)) };
    }
    resources.error = match SpawnPipe::openCloseOnExec() { !pipe => pipe, error! => return .failure(.Setup(error)) };
    let ret = bindings::fork();
    if ret < 0 { return .failure(.Setup(errno())); }
    if ret == 0 {
        resources.error.closeRead();
        if applyStdio(options, &mut resources.stdin, &mut resources.stdout, &mut resources.stderr) is error! {
            reportSpawnError(&resources.error, .Stdio, error);
            exit(127);
        }
        if applyCwd(options) is error! {
            reportSpawnError(&resources.error, .Cwd, error);
            exit(127);
        }
        let execError = executePath(path, argv, envp);
        reportSpawnError(&resources.error, .Exec, execError);
        exit(127);
        .failure(.Setup(.Io))
    } else {
        resources.stdin.closeRead();
        resources.stdout.closeWrite();
        resources.stderr.closeWrite();
        resources.error.closeWrite();
        let pid = ProcessId::init(ret);
        let errorRead = if resources.error.takeRead() is ?fd { fd } else { return failedSpawnAttempt(pid, .Setup(.Io)); };
        match readSpawnError(errorRead) {
            !(?spawnError) => failedSpawnAttempt(pid, spawnError),
            !null => .success(.init(pid, resources.stdin.takeWrite(), resources.stdout.takeRead(), resources.stderr.takeRead())),
            error! => failedSpawnAttempt(pid, error),
        }
    }
}

fun executePath(path: &u8, argv: &&u8, envp: &&u8) Errno {
    let mut pathLen: usize = 0;
    while path[pathLen] != 0 { pathLen += 1; }
    let mut hasSeparator = false;
    let mut index: usize = 0;
    while index < pathLen {
        if path[index] == b'/' { hasSeparator = true; break; }
        index += 1;
    }
    if hasSeparator { return execveResult(bindings::execve(path, argv, envp)); }
    let pointerSize = root::builtin::size[&u8]();
    let mut entry = envp;
    while entry as usize != 0 and entry.* as usize != 0 {
        let text = entry.*;
        let mut textLen: usize = 0;
        while text[textLen] != 0 { textLen += 1; }
        if textLen >= 5 and text[0] == b'P' and text[1] == b'A' and text[2] == b'T' and text[3] == b'H' and text[4] == b'=' {
            let valueEnd = textLen;
            let mut segmentStart: usize = 5;
            loop {
                let mut segmentEnd = segmentStart;
                while segmentEnd < valueEnd and text[segmentEnd] != b':' { segmentEnd += 1; }
                let mut candidate: [u8; maxPathBytes] = [0; maxPathBytes];
                let mut cursor: usize = 0;
                if segmentEnd == segmentStart {
                    candidate[0] = b'.';
                    cursor = 1;
                } else {
                    while segmentStart < segmentEnd {
                        if cursor + 1 >= candidate.len() { return .TooLong; }
                        candidate[cursor] = text[segmentStart];
                        cursor += 1;
                        segmentStart += 1;
                    }
                }
                if cursor != 0 and candidate[cursor - 1] != b'/' {
                    if cursor + 1 >= candidate.len() { return .TooLong; }
                    candidate[cursor] = b'/';
                    cursor += 1;
                }
                let mut commandIndex: usize = 0;
                while commandIndex < pathLen {
                    if cursor + 1 >= candidate.len() { return .TooLong; }
                    candidate[cursor] = path[commandIndex];
                    cursor += 1;
                    commandIndex += 1;
                }
                candidate[cursor] = 0;
                let error = execveResult(bindings::execve(&candidate[0], argv, envp));
                if error != .NoEntry { return error; }
                if segmentEnd == valueEnd { break; }
                segmentStart = segmentEnd + 1;
            }
            return .NoEntry;
        }
        entry = ((entry as usize) + pointerSize) as &&u8;
    }
    .NoEntry
}

fun execveResult(result: i32) Errno {
    if result == 0 { .Io } else { errno() }
}

fun failedSpawnAttempt(pid: ProcessId, error: SpawnError) SpawnAttempt {
    if reapSpawnFailure(pid) is cause! {
        return .failure(.Reap { stage: error.stage(), primary: error.primary(), cause: cause, pid: pid });
    }
    .failure(error)
}

fun reapSpawnFailure(pid: ProcessId) Errno!() {
    loop {
        match wait(pid) {
            !status => { _ = status; return !(); },
            .Interrupted! => {},
            .NoChild! => return !(),
            error! => { return error!; },
        }
    }
}

fun reportSpawnError(pipe: &SpawnPipe, stage: SpawnStage, value: Errno) () {
    if pipe.write() is !fd {
        let mut record: SpawnErrorRecord = .{ stage: stage as i32, code: value as i32 };
        let bytes = &mut ((&mut record as &mut u8)[0..root::builtin::size[SpawnErrorRecord]()]);
        let mut written: usize = 0;
        while written < bytes.len() {
            match fd.writeSome(&bytes[written..]) {
                !amount => { if amount == 0 { return; } written += amount; },
                .Interrupted! => {},
                error! => return,
            }
        }
    }
}

fun readSpawnError(fd: FileDescriptor) SpawnError! ?SpawnError {
    let mut record: SpawnErrorRecord = .{ stage: SpawnStage::Setup as i32, code: Errno::Io as i32 };
    let bytes = &mut ((&mut record as &mut u8)[0..root::builtin::size[SpawnErrorRecord]()]);
    let mut readLen: usize = 0;
    while readLen < bytes.len() {
        let amount = match fd.readSome(&mut bytes[readLen..]) {
            !amount => amount,
            .Interrupted! => continue,
            error! => return finishSpawnError(fd, .Setup(error)!),
        };
        if amount == 0 {
            if readLen == 0 { return finishSpawnError(fd, !null); }
            return finishSpawnError(fd, .Setup(.Io)!);
        }
        readLen += amount;
    }
    finishSpawnError(fd, !(?SpawnError::fromStage(record.stage as SpawnStage, record.code as Errno)))
}

fun finishSpawnError(fd: FileDescriptor, result: SpawnError! ?SpawnError) SpawnError! ?SpawnError {
    match result {
        !value => { match fd.close() { !ok => { _ = ok; !value }, error! => .Setup(error)! } },
        error! => { _ = fd.close(); error! },
    }
}

fun applyStdio(options: SpawnOptions, stdinPipe: &mut SpawnPipe, stdoutPipe: &mut SpawnPipe, stderrPipe: &mut SpawnPipe) Errno!() {
    let mut devNull: ?FileDescriptor = null;
    if options.stdin() == StdIo::Ignore {
        let fd = openDevNull().?; devNull = ?fd; dupTo(fd, FileDescriptor::stdin()).?;
    } else if options.stdin() == StdIo::Pipe { dupTo(stdinPipe.read().?, FileDescriptor::stdin()).?; }
    if options.stdout() == StdIo::Ignore {
        match devNull { ?fd => dupTo(fd, FileDescriptor::stdout()).?, null => { let fd = openDevNull().?; devNull = ?fd; dupTo(fd, FileDescriptor::stdout()).?; } }
    } else if options.stdout() == StdIo::Pipe { dupTo(stdoutPipe.write().?, FileDescriptor::stdout()).?; }
    if options.stderr() == StdIo::Ignore {
        match devNull { ?fd => dupTo(fd, FileDescriptor::stderr()).?, null => { let fd = openDevNull().?; devNull = ?fd; dupTo(fd, FileDescriptor::stderr()).?; } }
    } else if options.stderr() == StdIo::Pipe { dupTo(stderrPipe.write().?, FileDescriptor::stderr()).?; }
    stdinPipe.closeAllExcept(options);
    stdoutPipe.closeAllExcept(options);
    stderrPipe.closeAllExcept(options);
    if devNull is ?fd and not isStandardTarget(fd, options) { fd.close().?; }
    !()
}

fun applyCwd(options: SpawnOptions) Errno!() {
    if options.cwd() is ?path { checkZero(bindings::chdir(path)) } else { !() }
}

fun openDevNull() Errno!FileDescriptor {
    let path = b"/dev/null\0";
    openAt(cwd(), &path[0], .ReadWrite, false, false, false, 0)
}

fun dupTo(from: FileDescriptor, to: FileDescriptor) Errno!() {
    if from.raw() == to.raw() { return checkZero(bindings::fcntl(to.raw(), bindings::fSetFd, 0)); }
    let ret = bindings::dup2(from.raw(), to.raw());
    if ret < 0 { errno()! } else if ret != to.raw() { .Io! } else { !() }
}

pub fun wait(pid: ProcessId) Errno!WaitStatus { waitWithOptions(pid, 0) }

pub fun tryWait(pid: ProcessId) Errno! ?WaitStatus {
    let mut status: i32 = 0;
    let ret = bindings::waitpid(pid.raw(), &mut status, bindings::waitNoHang);
    if ret < 0 { return errno()!; }
    if ret == 0 { !null } else if ret != pid.raw() { .Io! } else { !(?.init(status)) }
}

pub fun killWith(pid: ProcessId, signal: i32) Errno!() { checkZero(bindings::kill(pid.raw(), signal)) }

fun waitWithOptions(pid: ProcessId, options: i32) Errno!WaitStatus {
    let mut status: i32 = 0;
    let ret = bindings::waitpid(pid.raw(), &mut status, options);
    if ret < 0 { return errno()!; }
    if ret != pid.raw() { .Io! } else { !.init(status) }
}

extend SpawnPipe {
    fun closed() SpawnPipe { .{ read: null, write: null } }
    fun init(read: FileDescriptor, write: FileDescriptor) SpawnPipe { .{ read: ?read, write: ?write } }
    fun openCloseOnExec() Errno!SpawnPipe {
        let mut fds: [i32; 2] = [0; 2];
        if bindings::pipe(&mut fds[0]) != 0 { return errno()!; }
        let first = bindings::fcntl(fds[0], bindings::fSetFd, bindings::fdCloseOnExec);
        let second = if first < 0 { -1 } else { bindings::fcntl(fds[1], bindings::fSetFd, bindings::fdCloseOnExec) };
        if first < 0 or second < 0 {
            let cause = errno();
            _ = bindings::close(fds[0]);
            _ = bindings::close(fds[1]);
            return cause!;
        }
        !.init(.init(fds[0]), .init(fds[1]))
    }
    fun read(&self) Errno!FileDescriptor { if self.read is ?fd { !fd } else { .Invalid! } }
    fun write(&self) Errno!FileDescriptor { if self.write is ?fd { !fd } else { .Invalid! } }
    fun takeRead(&mut self) ?FileDescriptor { let value = self.read; self.read = null; value }
    fun takeWrite(&mut self) ?FileDescriptor { let value = self.write; self.write = null; value }
    fun closeRead(&mut self) () { if self.takeRead() is ?fd { _ = fd.close(); } }
    fun closeWrite(&mut self) () { if self.takeWrite() is ?fd { _ = fd.close(); } }
    fun closeAll(&mut self) () { self.closeRead(); self.closeWrite(); }
    fun closeAllExcept(&mut self, options: SpawnOptions) () {
        if self.takeRead() is ?fd and not isStandardTarget(fd, options) { _ = fd.close(); }
        if self.takeWrite() is ?fd and not isStandardTarget(fd, options) { _ = fd.close(); }
    }
}

fun isStandardTarget(fd: FileDescriptor, options: SpawnOptions) bool {
    (options.stdin() != StdIo::Inherit and fd.raw() == 0)
        or (options.stdout() != StdIo::Inherit and fd.raw() == 1)
        or (options.stderr() != StdIo::Inherit and fd.raw() == 2)
}

extend SpawnResources {
    fun init() SpawnResources { .{ stdin: .closed(), stdout: .closed(), stderr: .closed(), error: .closed() } }
    fun closeAll(&mut self) () { self.stdin.closeAll(); self.stdout.closeAll(); self.stderr.closeAll(); self.error.closeAll(); }
}
pub fun exit(code: i32) () { bindings::exit(code); loop {} }

const statTypeMask: u16 = 0o170000;
const statFifo: u16 = 0o010000;
const statCharacter: u16 = 0o020000;
const statDirectory: u16 = 0o040000;
const statBlock: u16 = 0o060000;
const statRegular: u16 = 0o100000;
const statSymlink: u16 = 0o120000;
const statSocket: u16 = 0o140000;
const nanosPerSecond: i64 = 1000000000;

struct ParsedDirent {
    recordEnd: usize,
    nameStart: usize,
    nameEnd: usize,
}

fun openFlags(mode: OpenMode, directory: bool, create: bool, truncate: bool, exclusive: bool, followSymlinks: bool) i32 {
    let mut flags = mode as i32;
    if directory { flags = flags | bindings::openDirectory; }
    if create { flags = flags | bindings::openCreate; }
    if truncate { flags = flags | bindings::openTruncate; }
    if exclusive { flags = flags | bindings::openExclusive; }
    if not followSymlinks { flags = flags | bindings::openNoFollow; }
    flags
}

fun copyAndValidateRelative(path: &u8, storage: &mut [u8]) Errno!usize {
    let mut length: usize = 0;
    while length < storage.len() and path[length] != 0 {
        storage[length] = path[length];
        length += 1;
    }
    if length == storage.len() { return .TooLong!; }
    if length == 0 or storage[0] == b'/' { return .Invalid!; }
    storage[length] = 0;
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index <= length {
        if index == length or storage[index] == b'/' {
            if index - componentStart == 2
                and storage[componentStart] == b'.'
                and storage[componentStart + 1] == b'.'
            { return .Invalid!; }
            componentStart = index + 1;
        }
        index += 1;
    }
    !length
}

fun finalComponentStart(storage: &[u8], length: usize) usize {
    let mut end = length;
    while end != 0 and storage[end - 1] == b'/' { end -= 1; }
    let mut index = end;
    while index != 0 {
        index -= 1;
        if storage[index] == b'/' { return index + 1; }
    }
    0
}

fun metadataAtDirent(handle: FileDescriptor, path: &u8) Errno!FileMetadata {
    let mut stat: bindings::DarwinStat;
    if bindings::fstatat(handle.fd, path, &mut stat, bindings::atSymlinkNoFollow) != 0 { return errno()!; }
    stat.asMetadata()
}

fun parseDirent(buffer: &[u8], offset: usize) ?ParsedDirent {
    const reclenOffset: usize = 16;
    const namlenOffset: usize = 18;
    const nameOffset: usize = 21;
    if offset >= buffer.len() or buffer.len() - offset < nameOffset + 1 { return null; }
    let reclen = readU16(buffer, offset + reclenOffset);
    let namlen = readU16(buffer, offset + namlenOffset);
    let reclenSize = reclen as usize;
    let namlenSize = namlen as usize;
    if reclenSize < nameOffset + 1 or reclenSize > buffer.len() - offset { return null; }
    if namlenSize == 0 or namlenSize >= reclenSize - nameOffset { return null; }
    let nameStart = offset + nameOffset;
    let nameEnd = nameStart + namlenSize;
    let recordEnd = offset + reclenSize;
    if nameEnd >= recordEnd or buffer[nameEnd] != 0 { return null; }
    ?.{ recordEnd: recordEnd, nameStart: nameStart, nameEnd: nameEnd }
}

fun readU16(buffer: &[u8], offset: usize) u16 {
    (buffer[offset] as u16) | ((buffer[offset + 1] as u16) << 8)
}

extend bindings::DarwinTimespec {
    fun asTimestamp(&self) Errno!Timestamp {
        if self.nanos < 0 or self.nanos >= nanosPerSecond { return .Invalid!; }
        !Timestamp::init(self.seconds, self.nanos as u32)
    }
}

extend bindings::DarwinStat {
    fun kind(&self) FileKind {
        match self.mode & statTypeMask {
            (statDirectory) => .Directory,
            (statCharacter) => .CharacterDevice,
            (statBlock) => .BlockDevice,
            (statRegular) => .File,
            (statFifo) => .NamedPipe,
            (statSymlink) => .Symlink,
            (statSocket) => .UnixSocket,
            _ => .Unknown,
        }
    }

    fun asMetadata(&self) Errno!FileMetadata {
        if self.size < 0 or self.blockSize <= 0 { return .OutOfRange!; }
        !FileMetadata::init(
            self.kind(),
            self.inode,
            self.links as u32,
            self.size as u64,
            self.mode as u32,
            self.blockSize as u32,
            ?self.atime.asTimestamp().?,
            self.mtime.asTimestamp().?,
            ?self.ctime.asTimestamp().?,
        )
    }
}

fun errno() Errno {
    let value = bindings::__error().*;
    // Preserve portable errors for unsupported calls and invalid native paths.
    if value == 78 { .Unsupported }
    else if value == 92 { .Invalid }
    else { value as Errno }
}

fun fdPath(fd: FileDescriptor, buffer: &mut [u8]) Errno!&[u8] {
    if buffer.len() == 0 { return .Invalid!; }
    let result = if fd.fd == -2 {
        bindings::getcwd(buffer.ptrMut(), buffer.len()) as usize
    } else {
        if bindings::fcntl(fd.fd, bindings::fGetPath, buffer.ptrMut()) != 0 { return errno()!; }
        buffer.ptrMut() as usize
    };
    if result == 0 { return errno()!; }
    let mut length: usize = 0;
    while length < buffer.len() and buffer[length] != 0 { length += 1; }
    if length == buffer.len() { return .TooLong!; }
    !&buffer[0..length]
}

fun pathWithin(base: &[u8], candidate: &[u8]) bool {
    if base.len() == 1 and base[0] == b'/' {
        return candidate.len() != 0 and candidate[0] == b'/';
    }
    if candidate.len() < base.len() { return false; }
    let mut index: usize = 0;
    while index < base.len() {
        if base[index] != candidate[index] { return false; }
        index += 1;
    }
    candidate.len() == base.len() or candidate[base.len()] == b'/'
}

fun ensureContained(base: FileDescriptor, candidate: FileDescriptor) Errno!() {
    let mut baseStorage: [u8; fdPathBytes] = [0; fdPathBytes];
    let mut candidateStorage: [u8; fdPathBytes] = [0; fdPathBytes];
    let basePath = fdPath(base, &mut baseStorage[..]).?;
    let candidatePath = fdPath(candidate, &mut candidateStorage[..]).?;
    if pathWithin(basePath, candidatePath) { !() } else { .CrossDevice! }
}

fun checkZero(result: i32) Errno!() {
    if result == 0 { !() } else { errno()! }
}
