// Windows OS boundary. `bindings` exposes the available raw Win32 ABI;
// implementation modules stay package-private and back the higher-level OS
// operations below.
//
// Win32 declarations live in `bindings`; file, directory, path, encoding,
// memory, and process operations are delegated to the package-private
// implementation modules. Startup does not depend on a C CRT entry.

pub module bindings;
pub(root) module command;
pub(root) module directory;
pub(root) module encoding;
pub(root) module error;
pub(root) module fd;
pub(root) module mem;
pub(root) module path;
pub(root) module process;
pub(root) module random;
pub(root) module stat;
pub(root) module types;

pub using root::os::windows::types::{
    maxPathBytes,
    Errno,
    SpawnStage,
    SpawnError,
    OpenMode,
    SeekWhence,
    StdIo,
    FileKind,
    Timestamp,
    FileMetadata,
    DirectoryEntry,
    FileDescriptor,
    ProcessId,
    WaitStatus,
    SpawnResult,
    SpawnAttempt,
    SpawnOptions,
};

pub using root::os::windows::directory::{
    DirectoryReader,
    initDirectoryReader,
    closeDirectoryReader,
    readDirEntries,
    dirEntryAt,
    dirEntryNextOffset,
};

pub using root::os::windows::fd::{
    cwd,
    getCwd,
    openAt,
    openAtBeneath,
    createDirAtBeneath,
    deleteAtBeneath,
    renameAtBeneath,
};

pub using root::os::windows::stat::{
    metadataAtBeneath,
};

pub using root::os::windows::mem::{
    MappedPages,
    pageSize,
    pageAlignedLen,
    mapPages,
    unmapPages,
};

pub using root::os::windows::process::{
    spawn,
    wait,
    tryWait,
    killWith,
    exit,
};

pub using root::os::windows::random::{
    random,
};
