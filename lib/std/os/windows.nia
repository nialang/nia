// Windows OS boundary for the standard library.
//
// This module deliberately keeps Win32 handles and error codes below the
// platform facade. The rest of std::os sees the same typed contract as Linux.

using pkg::math;

pub const maxPathBytes: usize = 32768;

const invalidHandle: usize = (-1) as usize;
const stdInputHandle: i32 = -10;
const stdOutputHandle: i32 = -11;
const stdErrorHandle: i32 = -12;
const waitObject0: u32 = 0;
const waitTimeout: u32 = 258;
const infinite: u32 = 0xffffffff;
const signalTerm: i32 = 15;
const signalKill: i32 = 9;
const memCommit: u32 = 0x1000;
const memReserve: u32 = 0x2000;
const memRelease: u32 = 0x8000;
const pageReadWrite: u32 = 0x04;
const fileAttributeDirectory: u32 = 0x10;
const fileFlagBackupSemantics: u32 = 0x02000000;
const fileFlagOpenReparsePoint: u32 = 0x00200000;
const fileReadAttributes: u32 = 0x80;
const genericRead: u32 = 0x80000000;
const genericWrite: u32 = 0x40000000;
const fileShareRead: u32 = 0x00000001;
const fileShareWrite: u32 = 0x00000002;
const fileShareDelete: u32 = 0x00000004;
const createNew: u32 = 1;
const createAlways: u32 = 2;
const openExisting: u32 = 3;
const openAlways: u32 = 4;
const truncateExisting: u32 = 5;
const fileBegin: u32 = 0;
const fileCurrent: u32 = 1;
const fileEnd: u32 = 2;
const errorAccessDenied: u32 = 5;
const errorInvalidHandle: u32 = 6;
const errorNotEnoughMemory: u32 = 8;
const errorInvalidData: u32 = 13;
const errorOutofmemory: u32 = 14;
const errorAlreadyExists: u32 = 183;
const errorFileNotFound: u32 = 2;
const errorPathNotFound: u32 = 3;
const errorNoMoreFiles: u32 = 18;
const errorDirectory: u32 = 267;
const errorNotSupported: u32 = 50;
const errorFilenameExcedRange: u32 = 206;
const errorInvalidName: u32 = 123;
const invalidFileAttributes: u32 = 0xffffffff;
const fileNameNormalized: u32 = 0;
const getFileExInfoStandard: u32 = 0;
const fileAttributeReadonly: u32 = 0x1;
const windowsEpochTicks: u64 = 116444736000000000;
const ticksPerSecond: u64 = 10000000;
const handleFlagInherit: u32 = 1;
const duplicateSameAccess: u32 = 2;
const startupUseStdHandles: u32 = 0x100;
const createUnicodeEnvironment: u32 = 0x400;
const nullDeviceAccess: u32 = 0xc0000000;
const codePageUtf8: u32 = 65001;
const multiByteErrInvalidChars: u32 = 8;
const findDataNameBytes: usize = 260;
const findDataAlternateBytes: usize = 14;
const directoryRecordHeader: usize = 8;
const fileAttributeNormal: u32 = 0x80;
const fileAttributeReparsePoint: u32 = 0x400;

pub enum Errno: i32 {
    PermissionDenied = 1,
    NoEntry = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    NoChild = 10,
    Again = 11,
    NoMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    Exists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    Unsupported = 38,
    SymlinkLoop = 40,
    NotEmpty = 39,
    _,
}

pub enum SpawnStage: i32 { Setup = 1, Stdio = 2, Cwd = 3, Exec = 4, _ }

pub enum SpawnError {
    Setup(Errno),
    Stdio(Errno),
    Cwd(Errno),
    Exec(Errno),
    Reap { stage: SpawnStage, primary: Errno, cause: Errno, pid: ProcessId },
}

pub enum OpenMode: i32 { ReadOnly = 0, WriteOnly = 1, ReadWrite = 2, _ }
pub enum SeekWhence: usize { Start = 0, Current = 1, End = 2, _ }
pub enum StdIo: i32 { Inherit = 1, Ignore = 2, Pipe = 3 }
pub enum FileKind: i32 {
    BlockDevice = 1, CharacterDevice = 2, Directory = 3, NamedPipe = 4,
    Symlink = 5, File = 6, UnixSocket = 7, Unknown = 255, _
}

pub struct Timestamp { seconds: i64, nanos: u32 }
pub struct FileMetadata {
    kind: FileKind,
    inode: u64,
    nlink: u32,
    size: u64,
    mode: u32,
    blockSize: u32,
    atime: ?Timestamp,
    mtime: Timestamp,
    ctime: ?Timestamp,
}
pub struct DirectoryEntry { kind: FileKind, name: &[u8] }
pub struct DirectoryReader { search: usize, data: FindData, hasData: bool, done: bool }

// A Windows HANDLE is pointer-sized. Keeping it opaque prevents accidental
// arithmetic in the facade while retaining a stable raw value for the ABI.
pub struct FileDescriptor { handle: usize }
pub struct ProcessId { pid: i32, handle: usize }
pub struct WaitStatus { raw: i32 }
pub struct SpawnResult { pid: ProcessId, stdin: ?FileDescriptor, stdout: ?FileDescriptor, stderr: ?FileDescriptor }
pub struct SpawnAttempt { result: ?SpawnResult, error: ?SpawnError, pendingReap: ?ProcessId, pendingReapError: ?Errno }
pub struct SpawnOptions { stdin: StdIo, stdout: StdIo, stderr: StdIo, cwd: ?&u8 }

pub struct MappedPages { ptr: &mut u8, releasePtr: &mut u8, releaseSize: usize }

