// Windows OS boundary. Native bindings and implementation modules stay
// package-private; std::os consumes this platform contract.

pub(pkg) module bindings;
pub(pkg) module command;
pub(pkg) module directory;
pub(pkg) module encoding;
pub(pkg) module error;
pub(pkg) module fd;
pub(pkg) module mem;
pub(pkg) module path;
pub(pkg) module process;
pub(pkg) module random;
pub(pkg) module stat;
pub(pkg) module types;

pub using pkg::os::windows::types::{
    maxPathBytes,
    Errno,
    SpawnStage,
    SpawnError,
    OpenMode,
    SeekWhence,
    StdIo,
    FileKind,
    Timestamp,
    FileMetadata,
    DirectoryEntry,
    FileDescriptor,
    ProcessId,
    WaitStatus,
    SpawnResult,
    SpawnAttempt,
    SpawnOptions,
};

pub using pkg::os::windows::directory::{
    DirectoryReader,
    initDirectoryReader,
    closeDirectoryReader,
    readDirEntries,
    dirEntryAt,
    dirEntryNextOffset,
};

pub using pkg::os::windows::fd::{
    cwd,
    getCwd,
    openAt,
    openAtBeneath,
    createDirAtBeneath,
    deleteAtBeneath,
    renameAtBeneath,
};

pub using pkg::os::windows::stat::{
    metadataAtBeneath,
};

pub using pkg::os::windows::mem::{
    MappedPages,
    pageSize,
    pageAlignedLen,
    mapPages,
    unmapPages,
};

pub using pkg::os::windows::process::{
    spawn,
    wait,
    tryWait,
    killWith,
    exit,
};

pub using pkg::os::windows::random::{
    random,
};
