using pkg::os::linux::syscall;
using pkg::os::linux::types;

using types::Errno;

pub fn random(bytes: &mut [u8]) Errno!void {
    let mut done = 0usize;
    while done < bytes.len() {
        let mut chunk = &mut bytes[done..];
        let ret = syscall::syscall3(syscall::getrandom, chunk.ptr_mut() as usize, chunk.len(), 0);
        if ret < 0 {
            let err = ret.syscall_error();
            if err == Errno::Interrupted {
                continue;
            }
            return err!;
        }
        let n = ret as usize;
        if n == 0usize {
            return Errno::Io!;
        }
        done += n;
    }
    !{}
}
