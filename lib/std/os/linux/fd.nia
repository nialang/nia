using pkg::os::linux::syscall;
using pkg::os::linux::stat;
using pkg::os::linux::types;

using types::{DirectoryEntry, Errno, FileDescriptor, FileKind, FileMetadata, OpenMode, SeekWhence};

comptime let linux_dirent64_reclen_offset: usize = 16usize;
comptime let linux_dirent64_type_offset: usize = 18usize;
comptime let linux_dirent64_name_offset: usize = 19usize;
comptime let dirent_type_unknown: u8 = 0u8;
comptime let dirent_type_fifo: u8 = 1u8;
comptime let dirent_type_chr: u8 = 2u8;
comptime let dirent_type_dir: u8 = 4u8;
comptime let dirent_type_blk: u8 = 6u8;
comptime let dirent_type_reg: u8 = 8u8;
comptime let dirent_type_lnk: u8 = 10u8;
comptime let dirent_type_sock: u8 = 12u8;

extend FileDescriptor {
    pub fn write_some(&self, bytes: &[u8]) Errno!usize {
        let ptr = bytes.get_ptr_read();
        let ret = syscall::syscall3(syscall::write, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !(ret as usize)
        }
    }

    pub fn read_some(&self, bytes: &mut [u8]) Errno!usize {
        let ptr = bytes.get_ptr();
        let ret = syscall::syscall3(syscall::read, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !(ret as usize)
        }
    }

    pub fn close(&self) Errno!void {
        let ret = syscall::syscall1(syscall::close, self.fd as usize);
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !{}
        }
    }

    pub fn seek(&self, offset: i64, whence: SeekWhence) Errno!u64 {
        let ret = syscall::syscall3(
            syscall::lseek,
            self.fd as usize,
            offset as usize,
            whence as usize,
        );
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !(ret as u64)
        }
    }

    pub fn truncate(&self, len: u64) Errno!void {
        let ret = syscall::syscall2(syscall::ftruncate, self.fd as usize, len as usize);
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !{}
        }
    }

    pub fn sync(&self) Errno!void {
        let ret = syscall::syscall1(syscall::fsync, self.fd as usize);
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !{}
        }
    }

    pub fn sync_data(&self) Errno!void {
        let ret = syscall::syscall1(syscall::fdatasync, self.fd as usize);
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !{}
        }
    }

    pub fn metadata(&self) Errno!FileMetadata {
        stat::metadata_fd(FileDescriptor::init(self.fd))
    }

    pub fn read_dir_entries(&self, buffer: &mut [u8]) Errno!usize {
        if buffer.len() == 0 {
            return Errno::Invalid!;
        }
        let ret = syscall::syscall3(
            syscall::getdents64,
            self.fd as usize,
            buffer.get_ptr() as usize,
            buffer.len(),
        );
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !(ret as usize)
        }
    }
}

pub fn cwd() FileDescriptor {
    FileDescriptor::init(types::at_fdcwd)
}

pub fn getcwd(buffer: &mut [u8]) Errno!&[u8] {
    if buffer.len() == 0usize {
        return Errno::Invalid!;
    }
    let ret = syscall::syscall2(
        syscall::getcwd,
        buffer.get_ptr() as usize,
        buffer.len(),
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        var len = ret as usize;
        if len > buffer.len() {
            return Errno::TooLong!;
        }
        if len != 0usize and buffer[len - 1usize] == 0u8 {
            len -= 1usize;
        }
        !&buffer[0..len]
    }
}

pub fn open_at(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Errno!FileDescriptor {
    var flags = mode as i32;
    if create {
        flags = flags + types::open_create;
    }
    if exclusive {
        flags = flags + types::open_exclusive;
    }
    if truncate {
        flags = flags + types::open_truncate;
    }

    let ret = syscall::syscall4(
        syscall::openat,
        dir.raw() as usize,
        path as usize,
        flags as usize,
        permissions as usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !FileDescriptor::init(ret as i32)
    }
}

pub fn open_dir_at(dir: FileDescriptor, path: &u8, follow_symlinks: bool) Errno!FileDescriptor {
    var flags = (OpenMode::ReadOnly as i32) + types::open_directory + types::open_close_on_exec;
    if not follow_symlinks {
        flags = flags + types::open_no_follow;
    }
    let ret = syscall::syscall4(
        syscall::openat,
        dir.raw() as usize,
        path as usize,
        flags as usize,
        0,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !FileDescriptor::init(ret as i32)
    }
}

pub fn create_dir_at(dir: FileDescriptor, path: &u8, permissions: u32) Errno!void {
    let ret = syscall::syscall3(
        syscall::mkdirat,
        dir.raw() as usize,
        path as usize,
        permissions as usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn delete_file_at(dir: FileDescriptor, path: &u8) Errno!void {
    let ret = syscall::syscall3(syscall::unlinkat, dir.raw() as usize, path as usize, 0);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn delete_dir_at(dir: FileDescriptor, path: &u8) Errno!void {
    let ret = syscall::syscall3(
        syscall::unlinkat,
        dir.raw() as usize,
        path as usize,
        types::at_removedir,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn rename_at(
    old_dir: FileDescriptor,
    old_path: &u8,
    new_dir: FileDescriptor,
    new_path: &u8,
) Errno!void {
    let ret = syscall::syscall4(
        syscall::renameat,
        old_dir.raw() as usize,
        old_path as usize,
        new_dir.raw() as usize,
        new_path as usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn metadata_at(dir: FileDescriptor, path: &u8, follow_symlinks: bool) Errno!FileMetadata {
    stat::metadata_at(dir, path, follow_symlinks)
}

pub fn dir_entry_at(buffer: &[u8], offset: usize) ?DirectoryEntry {
    if offset >= buffer.len() {
        return null;
    }
    let remaining = buffer.len() - offset;
    if remaining < linux_dirent64_name_offset + 1usize {
        return null;
    }

    let reclen = dirent_reclen(buffer, offset);
    if reclen <= linux_dirent64_name_offset or reclen > remaining {
        return null;
    }

    let name_len = dirent_name_len(buffer, offset, reclen);
    ?DirectoryEntry::init(
        dirent_kind(buffer[offset + linux_dirent64_type_offset]),
        & buffer[(offset + linux_dirent64_name_offset)..(offset + linux_dirent64_name_offset + name_len)],
    )
}

pub fn dir_entry_next_offset(buffer: &[u8], offset: usize) ?usize {
    if offset >= buffer.len() {
        return null;
    }
    let remaining = buffer.len() - offset;
    if remaining < linux_dirent64_name_offset + 1usize {
        return null;
    }

    let reclen = dirent_reclen(buffer, offset);
    if reclen <= linux_dirent64_name_offset or reclen > remaining {
        null
    } else {
        ?(offset + reclen)
    }
}

fn dirent_reclen(buffer: &[u8], offset: usize) usize {
    (buffer[offset + linux_dirent64_reclen_offset] as usize)
        | ((buffer[offset + linux_dirent64_reclen_offset + 1usize] as usize) << 8usize)
}

fn dirent_name_len(buffer: &[u8], offset: usize, reclen: usize) usize {
    let start = offset + linux_dirent64_name_offset;
    let end = offset + reclen;
    var len = 0usize;
    while start + len < end and buffer[start + len] != 0u8 {
        len += 1usize;
    }
    len
}

fn dirent_kind(value: u8) FileKind {
    switch value {
        dirent_type_fifo => FileKind::NamedPipe,
        dirent_type_chr => FileKind::CharacterDevice,
        dirent_type_dir => FileKind::Directory,
        dirent_type_blk => FileKind::BlockDevice,
        dirent_type_reg => FileKind::File,
        dirent_type_lnk => FileKind::Symlink,
        dirent_type_sock => FileKind::UnixSocket,
        dirent_type_unknown => FileKind::Unknown,
        _ => FileKind::Unknown,
    }
}
