using pkg::os::linux::syscall;
using pkg::os::linux::stat;
using pkg::os::linux::types;
using pkg::error;
using pkg::math;

using types::{DirectoryEntry, Errno, FileDescriptor, FileKind, FileMetadata, OpenHow, OpenMode, Pipe, SeekWhence};

const linuxDirent64ReclenOffset: usize = 16;
const linuxDirent64TypeOffset: usize = 18;
const linuxDirent64NameOffset: usize = 19;
const direntTypeUnknown: u8 = 0;
const direntTypeFifo: u8 = 1;
const direntTypeChr: u8 = 2;
const direntTypeDir: u8 = 4;
const direntTypeBlk: u8 = 6;
const direntTypeReg: u8 = 8;
const direntTypeLnk: u8 = 10;
const direntTypeSock: u8 = 12;

struct ParsedDirent {
    recordEnd: usize,
    typeIndex: usize,
    nameStart: usize,
    nameEnd: usize,
}

extend FileDescriptor {
    pub fn writeSome(&self, bytes: &[u8]) Errno!usize {
        let ptr = bytes.ptr();
        let ret = syscall::syscall3(syscall::write, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscallError()!
        } else {
            let amount = ret as usize;
            if amount > bytes.len() {
                return Errno::Io!;
            }
            !amount
        }
    }

    pub fn readSome(&self, bytes: &mut [u8]) Errno!usize {
        let ptr = bytes.ptrMut();
        let ret = syscall::syscall3(syscall::read, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscallError()!
        } else {
            let amount = ret as usize;
            if amount > bytes.len() {
                return Errno::Io!;
            }
            !amount
        }
    }

    pub fn close(&self) Errno!() {
        let ret = syscall::syscall1(syscall::close, self.fd as usize);
        ret.syscallSuccess()
    }

    pub fn seek(&self, offset: i64, whence: SeekWhence) Errno!u64 {
        let ret = syscall::syscall3(
            syscall::lseek,
            self.fd as usize,
            offset as usize,
            whence as usize,
        );
        if ret < 0 {
            ret.syscallError()!
        } else {
            !(ret as u64)
        }
    }

    pub fn truncate(&self, len: u64) Errno!() {
        let ret = syscall::syscall2(syscall::ftruncate, self.fd as usize, len as usize);
        ret.syscallSuccess()
    }

    pub fn setPermissions(&self, permissions: u32) Errno!() {
        let ret = syscall::syscall2(syscall::fchmod, self.fd as usize, permissions as usize);
        ret.syscallSuccess()
    }

    pub fn sync(&self) Errno!() {
        let ret = syscall::syscall1(syscall::fsync, self.fd as usize);
        ret.syscallSuccess()
    }

    pub fn syncData(&self) Errno!() {
        let ret = syscall::syscall1(syscall::fdatasync, self.fd as usize);
        ret.syscallSuccess()
    }

    pub fn metadata(&self) Errno!FileMetadata {
        stat::metadataFd(FileDescriptor::init(self.fd))
    }

    pub fn readDirEntries(&self, buffer: &mut [u8]) Errno!usize {
        if buffer.len() == 0 {
            return Errno::Invalid!;
        }
        let ret = syscall::syscall3(
            syscall::getdents64,
            self.fd as usize,
            buffer.ptrMut() as usize,
            buffer.len(),
        );
        if ret < 0 {
            ret.syscallError()!
        } else {
            let amount = ret as usize;
            if amount > buffer.len() {
                return Errno::Io!;
            }
            !amount
        }
    }
}

pub fn cwd() FileDescriptor {
    FileDescriptor::init(types::atFdCwd)
}

pub fn pipeCloseOnExec() Errno!Pipe {
    let mut fds: [i32; 2] = [0, 0];
    let ret = syscall::syscall2(
        syscall::pipe2,
        &mut fds[0] as usize,
        types::closeOnExec as usize,
    );
    ret.syscallSuccess().?;
    let read = FileDescriptor::fromKernel(fds[0]).?;
    let write = FileDescriptor::fromKernel(fds[1]).?;
    !Pipe::init(read, write)
}

pub fn getCwd(buffer: &mut [u8]) Errno!&[u8] {
    if buffer.len() == 0 {
        return Errno::Invalid!;
    }
    let ret = syscall::syscall2(
        syscall::getcwd,
        buffer.ptrMut() as usize,
        buffer.len(),
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        let mut len = ret as usize;
        if len == 0 or len > buffer.len() {
            return Errno::Io!;
        }
        if buffer[len - 1] != 0 {
            return Errno::Io!;
        }
        len -= 1;
        !&buffer[0..len]
    }
}

pub fn openAt(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Errno!FileDescriptor {
    let mut flags = mode as i32;
    if create {
        flags = flags + types::openCreate;
    }
    if exclusive {
        flags = flags + types::openExclusive;
    }
    if truncate {
        flags = flags + types::openTruncate;
    }

    let ret = syscall::syscall4(
        syscall::openat,
        dir.raw() as usize,
        path as usize,
        flags as usize,
        permissions as usize,
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        !FileDescriptor::fromSyscall(ret).?
    }
}

// openat2 resolves every component beneath the directory fd, including symlinks.
pub fn openAtBeneath(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    followSymlinks: bool,
) Errno!FileDescriptor {
    let mut flags = mode as i32;
    if directory {
        flags = flags + types::openDirectory;
    }
    if create {
        flags = flags + types::openCreate;
    }
    if exclusive {
        flags = flags + types::openExclusive;
    }
    if truncate {
        flags = flags + types::openTruncate;
    }
    if not followSymlinks {
        flags = flags + types::openNoFollow;
    }
    let how = OpenHow {
        flags: flags as u64,
        mode: permissions as u64,
        resolve: types::resolveBeneath | types::resolveNoMagicLinks,
    };
    let ret = syscall::syscall4(
        syscall::openat2,
        dir.raw() as usize,
        path as usize,
        &how as usize,
        std::builtin::size[OpenHow](),
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        !FileDescriptor::fromSyscall(ret).?
    }
}

pub fn createDirAt(dir: FileDescriptor, path: &u8, permissions: u32) Errno!() {
    let ret = syscall::syscall3(
        syscall::mkdirat,
        dir.raw() as usize,
        path as usize,
        permissions as usize,
    );
    ret.syscallSuccess()
}

pub fn createDirAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Errno!() {
    let parentHandle = openAtBeneath(
        dir,
        parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let result = createDirAt(parentHandle, name, permissions);
    result.cleanupAfter(parentHandle.close())
}

pub fn deleteFileAt(dir: FileDescriptor, path: &u8) Errno!() {
    let ret = syscall::syscall3(syscall::unlinkat, dir.raw() as usize, path as usize, 0);
    ret.syscallSuccess()
}

pub fn deleteDirAt(dir: FileDescriptor, path: &u8) Errno!() {
    let ret = syscall::syscall3(
        syscall::unlinkat,
        dir.raw() as usize,
        path as usize,
        types::atRemoveDir,
    );
    ret.syscallSuccess()
}

pub fn deleteAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    directory: bool,
) Errno!() {
    let parentHandle = openAtBeneath(
        dir,
        parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let result = if directory {
        deleteDirAt(parentHandle, name)
    } else {
        deleteFileAt(parentHandle, name)
    };
    result.cleanupAfter(parentHandle.close())
}

pub fn renameAt(
    oldDir: FileDescriptor,
    oldPath: &u8,
    newDir: FileDescriptor,
    newPath: &u8,
) Errno!() {
    let ret = syscall::syscall4(
        syscall::renameat,
        oldDir.raw() as usize,
        oldPath as usize,
        newDir.raw() as usize,
        newPath as usize,
    );
    ret.syscallSuccess()
}

pub fn renameAtBeneath(
    oldDir: FileDescriptor,
    oldParent: &u8,
    oldName: &u8,
    newDir: FileDescriptor,
    newParent: &u8,
    newName: &u8,
) Errno!() {
    let oldParentHandle = openAtBeneath(
        oldDir,
        oldParent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let newParentHandle = match openAtBeneath(
        newDir,
        newParent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ) {
        !handle => {
            handle
        },
        error! => {
            _ = oldParentHandle.close();
            return error!;
        },
    };
    let result = renameAt(
        oldParentHandle,
        oldName,
        newParentHandle,
        newName,
    );
    result
        .cleanupAfter(oldParentHandle.close())
        .cleanupAfter(newParentHandle.close())
}

pub fn dirEntryAt(buffer: &[u8], offset: usize) ?DirectoryEntry {
    let parsed = match parseDirent(buffer, offset) {
        ?value => value,
        null => return null,
    };
    ?DirectoryEntry::init(
        direntKind(buffer[parsed.typeIndex]),
        &buffer[parsed.nameStart..parsed.nameEnd],
    )
}

pub fn dirEntryNextOffset(buffer: &[u8], offset: usize) ?usize {
    match parseDirent(buffer, offset) {
        ?parsed => ?parsed.recordEnd,
        null => null,
    }
}

fn parseDirent(buffer: &[u8], offset: usize) ?ParsedDirent {
    if offset >= buffer.len() {
        return null;
    }
    let remaining = buffer.len() - offset;
    if remaining < linuxDirent64NameOffset + 1 {
        return null;
    }

    let reclen = direntReclen(buffer, offset);
    if reclen <= linuxDirent64NameOffset or reclen > remaining {
        return null;
    }
    let recordEnd = match offset.checkedAdd(reclen) {
        ?value => value,
        null => return null,
    };
    let typeIndex = match offset.checkedAdd(linuxDirent64TypeOffset) {
        ?value => value,
        null => return null,
    };
    let nameStart = match offset.checkedAdd(linuxDirent64NameOffset) {
        ?value => value,
        null => return null,
    };
    let mut nameEnd = nameStart;
    while nameEnd < recordEnd and buffer[nameEnd] != 0 {
        nameEnd += 1;
    }
    if nameEnd == nameStart or nameEnd == recordEnd {
        return null;
    }
    ?ParsedDirent {
        recordEnd: recordEnd,
        typeIndex: typeIndex,
        nameStart: nameStart,
        nameEnd: nameEnd,
    }
}

fn direntReclen(buffer: &[u8], offset: usize) usize {
    (buffer[offset + linuxDirent64ReclenOffset] as usize)
        | ((buffer[offset + linuxDirent64ReclenOffset + 1] as usize) << 8usize)
}

fn direntKind(value: u8) FileKind {
    match value {
        (direntTypeFifo) => FileKind::NamedPipe,
        (direntTypeChr) => FileKind::CharacterDevice,
        (direntTypeDir) => FileKind::Directory,
        (direntTypeBlk) => FileKind::BlockDevice,
        (direntTypeReg) => FileKind::File,
        (direntTypeLnk) => FileKind::Symlink,
        (direntTypeSock) => FileKind::UnixSocket,
        (direntTypeUnknown) => FileKind::Unknown,
        _ => FileKind::Unknown,
    }
}
