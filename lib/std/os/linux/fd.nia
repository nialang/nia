import std.os.linux.syscall;
import std.os.linux.types;

using types::{Error, FileDescriptor, OpenMode};

extend FileDescriptor {
    pub fn init(fd: i32) FileDescriptor {
        { fd: fd }
    }

    pub fn stdin() FileDescriptor {
        FileDescriptor::init(0)
    }

    pub fn stdout() FileDescriptor {
        FileDescriptor::init(1)
    }

    pub fn stderr() FileDescriptor {
        FileDescriptor::init(2)
    }

    pub fn raw(&self) i32 {
        self.fd
    }

    pub fn write_some(&self, bytes: &[u8]) Error!usize {
        let ptr = bytes.get_ptr_read();
        let ret = syscall::syscall3(syscall::write, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !(ret as usize)
        }
    }

    pub fn read_some(&self, bytes: &mut [u8]) Error!usize {
        let ptr = bytes.get_ptr();
        let ret = syscall::syscall3(syscall::read, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !(ret as usize)
        }
    }

    pub fn close(&self) Error!void {
        let ret = syscall::syscall1(syscall::close, self.fd as usize);
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !{}
        }
    }
}

pub fn cwd() FileDescriptor {
    FileDescriptor::init(types::at_fdcwd)
}

pub fn open_at(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileDescriptor {
    var flags = mode as i32;
    if create {
        flags = flags + types::open_create;
    }
    if exclusive {
        flags = flags + types::open_exclusive;
    }
    if truncate {
        flags = flags + types::open_truncate;
    }

    let ret = syscall::syscall4(
        syscall::openat,
        dir.raw() as usize,
        path as usize,
        flags as usize,
        permissions as usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !FileDescriptor::init(ret as i32)
    }
}

pub fn create_dir_at(dir: FileDescriptor, path: &u8, permissions: u32) Error!void {
    let ret = syscall::syscall3(
        syscall::mkdirat,
        dir.raw() as usize,
        path as usize,
        permissions as usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn delete_file_at(dir: FileDescriptor, path: &u8) Error!void {
    let ret = syscall::syscall3(syscall::unlinkat, dir.raw() as usize, path as usize, 0);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn delete_dir_at(dir: FileDescriptor, path: &u8) Error!void {
    let ret = syscall::syscall3(
        syscall::unlinkat,
        dir.raw() as usize,
        path as usize,
        types::at_removedir,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn rename_at(
    old_dir: FileDescriptor,
    old_path: &u8,
    new_dir: FileDescriptor,
    new_path: &u8,
) Error!void {
    let ret = syscall::syscall4(
        syscall::renameat,
        old_dir.raw() as usize,
        old_path as usize,
        new_dir.raw() as usize,
        new_path as usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}
