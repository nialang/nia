using root::os::linux::syscall;
using root::os::linux::stat;
using root::os::linux::types;
using root::error;
using root::math;
using root::option;

using types::{DirectoryEntry, Errno, FileDescriptor, FileKind, FileMetadata, OpenHow, OpenMode, Pipe, SeekWhence};

const linuxDirent64ReclenOffset: usize = 16;
const linuxDirent64NameOffset: usize = 19;

struct ParsedDirent {
    recordEnd: usize,
    nameStart: usize,
    nameEnd: usize,
}

extend FileDescriptor {
    pub fun writeSome(&self, bytes: &[u8]) Errno!usize {
        let ptr = bytes.ptr();
        let ret = syscall::syscall3(syscall::write, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscallError()!
        } else {
            let amount = ret as usize;
            if amount > bytes.len() {
                return .Io!;
            }
            !amount
        }
    }

    pub fun readSome(&self, bytes: &mut [u8]) Errno!usize {
        let ptr = bytes.ptrMut();
        let ret = syscall::syscall3(syscall::read, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscallError()!
        } else {
            let amount = ret as usize;
            if amount > bytes.len() {
                return .Io!;
            }
            !amount
        }
    }

    pub fun close(&self) Errno!() {
        let ret = syscall::syscall1(syscall::close, self.fd as usize);
        ret.syscallSuccess()
    }

    pub fun seek(&self, offset: i64, whence: SeekWhence) Errno!u64 {
        let ret = syscall::syscall3(
            syscall::lseek,
            self.fd as usize,
            offset as usize,
            whence as usize,
        );
        if ret < 0 {
            ret.syscallError()!
        } else {
            !(ret as u64)
        }
    }

    pub fun truncate(&self, len: u64) Errno!() {
        let ret = syscall::syscall2(syscall::ftruncate, self.fd as usize, len as usize);
        ret.syscallSuccess()
    }

    pub fun setPermissions(&self, permissions: u32) Errno!() {
        let ret = syscall::syscall2(syscall::fchmod, self.fd as usize, permissions as usize);
        ret.syscallSuccess()
    }

    pub fun sync(&self) Errno!() {
        let ret = syscall::syscall1(syscall::fsync, self.fd as usize);
        ret.syscallSuccess()
    }

    pub fun syncData(&self) Errno!() {
        let ret = syscall::syscall1(syscall::fdatasync, self.fd as usize);
        ret.syscallSuccess()
    }

    pub fun metadata(&self) Errno!FileMetadata {
        stat::metadataFd(FileDescriptor::init(self.fd))
    }

    pub fun readDirEntries(&self, buffer: &mut [u8]) Errno!usize {
        if buffer.len() == 0 {
            return .Invalid!;
        }
        let ret = syscall::syscall3(
            syscall::getdents64,
            self.fd as usize,
            buffer.ptrMut() as usize,
            buffer.len(),
        );
        if ret < 0 {
            ret.syscallError()!
        } else {
            let amount = ret as usize;
            if amount > buffer.len() {
                return .Io!;
            }
            !amount
        }
    }
}

pub fun cwd() FileDescriptor {
    .init(types::atFdCwd)
}

pub fun pipeCloseOnExec() Errno!Pipe {
    let mut fds: [i32; 2] = [0, 0];
    let ret = syscall::syscall2(
        syscall::pipe2,
        &mut fds[0] as usize,
        types::closeOnExec as usize,
    );
    ret.syscallSuccess().?;
    let read = FileDescriptor::fromKernel(fds[0]).?;
    let write = FileDescriptor::fromKernel(fds[1]).?;
    !.init(read, write)
}

pub fun getCwd(buffer: &mut [u8]) Errno!&[u8] {
    if buffer.len() == 0 {
        return .Invalid!;
    }
    let ret = syscall::syscall2(
        syscall::getcwd,
        buffer.ptrMut() as usize,
        buffer.len(),
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        let mut len = ret as usize;
        if len == 0 or len > buffer.len() {
            return .Io!;
        }
        if buffer[len - 1] != 0 {
            return .Io!;
        }
        len -= 1;
        !&buffer[0..len]
    }
}

pub fun openAt(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Errno!FileDescriptor {
    let mut flags = mode as i32;
    if create {
        flags = flags + types::openCreate;
    }
    if exclusive {
        flags = flags + types::openExclusive;
    }
    if truncate {
        flags = flags + types::openTruncate;
    }

    let ret = syscall::syscall4(
        syscall::openat,
        dir.raw() as usize,
        path as usize,
        flags as usize,
        permissions as usize,
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        !FileDescriptor::fromSyscall(ret).?
    }
}

// openat2 resolves every component beneath the directory fd, including symlinks.
pub fun openAtBeneath(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    followSymlinks: bool,
) Errno!FileDescriptor {
    let mut flags = mode as i32;
    if directory {
        flags = flags + types::openDirectory;
    }
    if create {
        flags = flags + types::openCreate;
    }
    if exclusive {
        flags = flags + types::openExclusive;
    }
    if truncate {
        flags = flags + types::openTruncate;
    }
    if not followSymlinks {
        flags = flags + types::openNoFollow;
    }
    let how = OpenHow {
        flags: flags as u64,
        mode: permissions as u64,
        resolve: types::resolveBeneath | types::resolveNoMagicLinks,
    };
    let ret = syscall::syscall4(
        syscall::openat2,
        dir.raw() as usize,
        path as usize,
        &how as usize,
        root::builtin::size[OpenHow](),
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        !FileDescriptor::fromSyscall(ret).?
    }
}

pub fun createDirAt(dir: FileDescriptor, path: &u8, permissions: u32) Errno!() {
    let ret = syscall::syscall3(
        syscall::mkdirat,
        dir.raw() as usize,
        path as usize,
        permissions as usize,
    );
    ret.syscallSuccess()
}

pub fun createDirAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Errno!() {
    let parentHandle = openAtBeneath(
        dir,
        parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let result = createDirAt(parentHandle, name, permissions);
    result.cleanupAfter(parentHandle.close())
}

pub fun deleteFileAt(dir: FileDescriptor, path: &u8) Errno!() {
    let ret = syscall::syscall3(syscall::unlinkat, dir.raw() as usize, path as usize, 0);
    ret.syscallSuccess()
}

pub fun deleteDirAt(dir: FileDescriptor, path: &u8) Errno!() {
    let ret = syscall::syscall3(
        syscall::unlinkat,
        dir.raw() as usize,
        path as usize,
        types::atRemoveDir,
    );
    ret.syscallSuccess()
}

pub fun deleteAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    directory: bool,
) Errno!() {
    let parentHandle = openAtBeneath(
        dir,
        parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let result = if directory {
        deleteDirAt(parentHandle, name)
    } else {
        deleteFileAt(parentHandle, name)
    };
    result.cleanupAfter(parentHandle.close())
}

pub fun renameAt(
    oldDir: FileDescriptor,
    oldPath: &u8,
    newDir: FileDescriptor,
    newPath: &u8,
) Errno!() {
    let ret = syscall::syscall4(
        syscall::renameat,
        oldDir.raw() as usize,
        oldPath as usize,
        newDir.raw() as usize,
        newPath as usize,
    );
    ret.syscallSuccess()
}

pub fun renameAtBeneath(
    oldDir: FileDescriptor,
    oldParent: &u8,
    oldName: &u8,
    newDir: FileDescriptor,
    newParent: &u8,
    newName: &u8,
) Errno!() {
    let oldParentHandle = openAtBeneath(
        oldDir,
        oldParent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let newParentHandle = match openAtBeneath(
        newDir,
        newParent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ) {
        !handle => {
            handle
        },
        error! => {
            _ = oldParentHandle.close();
            return error!;
        },
    };
    let result = renameAt(
        oldParentHandle,
        oldName,
        newParentHandle,
        newName,
    );
    result
        .cleanupAfter(oldParentHandle.close())
        .cleanupAfter(newParentHandle.close())
}

pub fun dirEntryAt(handle: FileDescriptor, buffer: &[u8], offset: usize) Errno!DirectoryEntry {
    if parseDirent(buffer, offset) is ?parsed {
        let metadata = stat::directoryEntryMetadata(handle, &buffer[parsed.nameStart]).?;
        return !DirectoryEntry::init(
            metadata.kind(),
            &buffer[parsed.nameStart..parsed.nameEnd],
            metadata.size(),
        );
    }
    .Invalid!
}

pub fun dirEntryNextOffset(buffer: &[u8], offset: usize) ?usize {
    parseDirent(buffer, offset).map[usize, _](\parsed: ParsedDirent -> parsed.recordEnd)
}

fun parseDirent(buffer: &[u8], offset: usize) ?ParsedDirent {
    if offset >= buffer.len() {
        return null;
    }
    let remaining = buffer.len() - offset;
    if remaining < linuxDirent64NameOffset + 1 {
        return null;
    }

    let reclen = direntReclen(buffer, offset);
    if reclen <= linuxDirent64NameOffset or reclen > remaining {
        return null;
    }
    let recordEnd = match offset.checkedAdd(reclen) {
        ?value => value,
        null => return null,
    };
    let nameStart = match offset.checkedAdd(linuxDirent64NameOffset) {
        ?value => value,
        null => return null,
    };
    let mut nameEnd = nameStart;
    while nameEnd < recordEnd and buffer[nameEnd] != 0 {
        nameEnd += 1;
    }
    if nameEnd == nameStart or nameEnd == recordEnd {
        return null;
    }
    ?.{
        recordEnd: recordEnd,
        nameStart: nameStart,
        nameEnd: nameEnd,
    }
}

fun direntReclen(buffer: &[u8], offset: usize) usize {
    (buffer[offset + linuxDirent64ReclenOffset] as usize)
        | ((buffer[offset + linuxDirent64ReclenOffset + 1] as usize) << 8)
}
