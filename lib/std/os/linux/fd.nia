using pkg::os::linux::syscall;
using pkg::os::linux::stat;
using pkg::os::linux::types;
using pkg::math;

using types::{DirectoryEntry, Errno, FileDescriptor, FileKind, FileMetadata, OpenHow, OpenMode, Pipe, SeekWhence};

const linux_dirent64_reclen_offset: usize = 16usize;
const linux_dirent64_type_offset: usize = 18usize;
const linux_dirent64_name_offset: usize = 19usize;
const dirent_type_unknown: u8 = 0u8;
const dirent_type_fifo: u8 = 1u8;
const dirent_type_chr: u8 = 2u8;
const dirent_type_dir: u8 = 4u8;
const dirent_type_blk: u8 = 6u8;
const dirent_type_reg: u8 = 8u8;
const dirent_type_lnk: u8 = 10u8;
const dirent_type_sock: u8 = 12u8;

struct ParsedDirent {
    recordEnd: usize,
    typeIndex: usize,
    nameStart: usize,
    nameEnd: usize,
}

extend FileDescriptor {
    pub fn write_some(&self, bytes: &[u8]) Errno!usize {
        let ptr = bytes.ptr();
        let ret = syscall::syscall3(syscall::write, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscall_error()!
        } else {
            let amount = ret as usize;
            if amount > bytes.len() {
                return Errno::Io!;
            }
            !amount
        }
    }

    pub fn read_some(&self, bytes: &mut [u8]) Errno!usize {
        let ptr = bytes.ptrMut();
        let ret = syscall::syscall3(syscall::read, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            ret.syscall_error()!
        } else {
            let amount = ret as usize;
            if amount > bytes.len() {
                return Errno::Io!;
            }
            !amount
        }
    }

    pub fn close(&self) Errno!() {
        let ret = syscall::syscall1(syscall::close, self.fd as usize);
        ret.syscall_success()
    }

    pub fn seek(&self, offset: i64, whence: SeekWhence) Errno!u64 {
        let ret = syscall::syscall3(
            syscall::lseek,
            self.fd as usize,
            offset as usize,
            whence as usize,
        );
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !(ret as u64)
        }
    }

    pub fn truncate(&self, len: u64) Errno!() {
        let ret = syscall::syscall2(syscall::ftruncate, self.fd as usize, len as usize);
        ret.syscall_success()
    }

    pub fn set_permissions(&self, permissions: u32) Errno!() {
        let ret = syscall::syscall2(syscall::fchmod, self.fd as usize, permissions as usize);
        ret.syscall_success()
    }

    pub fn sync(&self) Errno!() {
        let ret = syscall::syscall1(syscall::fsync, self.fd as usize);
        ret.syscall_success()
    }

    pub fn sync_data(&self) Errno!() {
        let ret = syscall::syscall1(syscall::fdatasync, self.fd as usize);
        ret.syscall_success()
    }

    pub fn metadata(&self) Errno!FileMetadata {
        stat::metadata_fd(FileDescriptor::init(self.fd))
    }

    pub fn read_dir_entries(&self, buffer: &mut [u8]) Errno!usize {
        if buffer.len() == 0 {
            return Errno::Invalid!;
        }
        let ret = syscall::syscall3(
            syscall::getdents64,
            self.fd as usize,
            buffer.ptrMut() as usize,
            buffer.len(),
        );
        if ret < 0 {
            ret.syscall_error()!
        } else {
            let amount = ret as usize;
            if amount > buffer.len() {
                return Errno::Io!;
            }
            !amount
        }
    }
}

pub fn cwd() FileDescriptor {
    FileDescriptor::init(types::at_fdcwd)
}

pub fn pipe_close_on_exec() Errno!Pipe {
    let mut fds: [i32; 2] = [0, 0];
    let ret = syscall::syscall2(
        syscall::pipe2,
        &mut fds[0] as usize,
        types::close_on_exec as usize,
    );
    ret.syscall_success().?;
    let read = FileDescriptor::from_kernel(fds[0]).?;
    let write = FileDescriptor::from_kernel(fds[1]).?;
    !Pipe::init(read, write)
}

pub fn getcwd(buffer: &mut [u8]) Errno!&[u8] {
    if buffer.len() == 0usize {
        return Errno::Invalid!;
    }
    let ret = syscall::syscall2(
        syscall::getcwd,
        buffer.ptrMut() as usize,
        buffer.len(),
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        let mut len = ret as usize;
        if len == 0usize or len > buffer.len() {
            return Errno::Io!;
        }
        if buffer[len - 1usize] != 0u8 {
            return Errno::Io!;
        }
        len -= 1usize;
        !&buffer[0..len]
    }
}

pub fn open_at(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Errno!FileDescriptor {
    let mut flags = mode as i32;
    if create {
        flags = flags + types::open_create;
    }
    if exclusive {
        flags = flags + types::open_exclusive;
    }
    if truncate {
        flags = flags + types::open_truncate;
    }

    let ret = syscall::syscall4(
        syscall::openat,
        dir.raw() as usize,
        path as usize,
        flags as usize,
        permissions as usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !FileDescriptor::from_syscall(ret).?
    }
}

// openat2 resolves every component beneath the directory fd, including symlinks.
pub fn open_at_beneath(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    follow_symlinks: bool,
) Errno!FileDescriptor {
    let mut flags = mode as i32;
    if directory {
        flags = flags + types::open_directory;
    }
    if create {
        flags = flags + types::open_create;
    }
    if exclusive {
        flags = flags + types::open_exclusive;
    }
    if truncate {
        flags = flags + types::open_truncate;
    }
    if not follow_symlinks {
        flags = flags + types::open_no_follow;
    }
    let how = OpenHow {
        flags: flags as u64,
        mode: permissions as u64,
        resolve: types::resolve_beneath | types::resolve_no_magiclinks,
    };
    let ret = syscall::syscall4(
        syscall::openat2,
        dir.raw() as usize,
        path as usize,
        &how as usize,
        std::builtin::size[OpenHow](),
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !FileDescriptor::from_syscall(ret).?
    }
}

pub fn create_dir_at(dir: FileDescriptor, path: &u8, permissions: u32) Errno!() {
    let ret = syscall::syscall3(
        syscall::mkdirat,
        dir.raw() as usize,
        path as usize,
        permissions as usize,
    );
    ret.syscall_success()
}

pub fn create_dir_at_beneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Errno!() {
    let parent_handle = open_at_beneath(
        dir,
        parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let result = create_dir_at(parent_handle, name, permissions);
    result.close_after(parent_handle.close())
}

pub fn delete_file_at(dir: FileDescriptor, path: &u8) Errno!() {
    let ret = syscall::syscall3(syscall::unlinkat, dir.raw() as usize, path as usize, 0);
    ret.syscall_success()
}

pub fn delete_dir_at(dir: FileDescriptor, path: &u8) Errno!() {
    let ret = syscall::syscall3(
        syscall::unlinkat,
        dir.raw() as usize,
        path as usize,
        types::at_removedir,
    );
    ret.syscall_success()
}

pub fn delete_at_beneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    directory: bool,
) Errno!() {
    let parent_handle = open_at_beneath(
        dir,
        parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let result = if directory {
        delete_dir_at(parent_handle, name)
    } else {
        delete_file_at(parent_handle, name)
    };
    result.close_after(parent_handle.close())
}

pub fn rename_at(
    old_dir: FileDescriptor,
    old_path: &u8,
    new_dir: FileDescriptor,
    new_path: &u8,
) Errno!() {
    let ret = syscall::syscall4(
        syscall::renameat,
        old_dir.raw() as usize,
        old_path as usize,
        new_dir.raw() as usize,
        new_path as usize,
    );
    ret.syscall_success()
}

pub fn rename_at_beneath(
    old_dir: FileDescriptor,
    old_parent: &u8,
    old_name: &u8,
    new_dir: FileDescriptor,
    new_parent: &u8,
    new_name: &u8,
) Errno!() {
    let old_parent_handle = open_at_beneath(
        old_dir,
        old_parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ).?;
    let new_parent_handle = match open_at_beneath(
        new_dir,
        new_parent,
        OpenMode::ReadOnly,
        true,
        false,
        false,
        false,
        0,
        true,
    ) {
        !handle => {
            handle
        },
        error! => {
            _ = old_parent_handle.close();
            return error!;
        },
    };
    let result = rename_at(
        old_parent_handle,
        old_name,
        new_parent_handle,
        new_name,
    );
    result
        .close_after(old_parent_handle.close())
        .close_after(new_parent_handle.close())
}

pub fn dir_entry_at(buffer: &[u8], offset: usize) ?DirectoryEntry {
    let parsed = match parseDirent(buffer, offset) {
        ?value => value,
        null => return null,
    };
    ?DirectoryEntry::init(
        dirent_kind(buffer[parsed.typeIndex]),
        &buffer[parsed.nameStart..parsed.nameEnd],
    )
}

pub fn dir_entry_next_offset(buffer: &[u8], offset: usize) ?usize {
    match parseDirent(buffer, offset) {
        ?parsed => ?parsed.recordEnd,
        null => null,
    }
}

fn parseDirent(buffer: &[u8], offset: usize) ?ParsedDirent {
    if offset >= buffer.len() {
        return null;
    }
    let remaining = buffer.len() - offset;
    if remaining < linux_dirent64_name_offset + 1usize {
        return null;
    }

    let reclen = dirent_reclen(buffer, offset);
    if reclen <= linux_dirent64_name_offset or reclen > remaining {
        return null;
    }
    let recordEnd = match offset.checked_add(reclen) {
        ?value => value,
        null => return null,
    };
    let typeIndex = match offset.checked_add(linux_dirent64_type_offset) {
        ?value => value,
        null => return null,
    };
    let nameStart = match offset.checked_add(linux_dirent64_name_offset) {
        ?value => value,
        null => return null,
    };
    let mut nameEnd = nameStart;
    while nameEnd < recordEnd and buffer[nameEnd] != 0u8 {
        nameEnd += 1usize;
    }
    if nameEnd == nameStart or nameEnd == recordEnd {
        return null;
    }
    ?ParsedDirent {
        recordEnd: recordEnd,
        typeIndex: typeIndex,
        nameStart: nameStart,
        nameEnd: nameEnd,
    }
}

fn dirent_reclen(buffer: &[u8], offset: usize) usize {
    (buffer[offset + linux_dirent64_reclen_offset] as usize)
        | ((buffer[offset + linux_dirent64_reclen_offset + 1usize] as usize) << 8usize)
}

fn dirent_kind(value: u8) FileKind {
    match value {
        (dirent_type_fifo) => FileKind::NamedPipe,
        (dirent_type_chr) => FileKind::CharacterDevice,
        (dirent_type_dir) => FileKind::Directory,
        (dirent_type_blk) => FileKind::BlockDevice,
        (dirent_type_reg) => FileKind::File,
        (dirent_type_lnk) => FileKind::Symlink,
        (dirent_type_sock) => FileKind::UnixSocket,
        (dirent_type_unknown) => FileKind::Unknown,
        _ => FileKind::Unknown,
    }
}
