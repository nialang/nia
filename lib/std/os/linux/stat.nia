using pkg::os::linux::syscall;
using pkg::os::linux::types;

using types::{Errno, FileDescriptor, FileKind, FileMetadata, Timestamp};
using types::OpenHow;

const atEmptyPath: usize = 0x1000usize;
const statxType: u32 = 0x00000001u32;
const statxMode: u32 = 0x00000002u32;
const statxNlink: u32 = 0x00000004u32;
const statxAtime: u32 = 0x00000020u32;
const statxMtime: u32 = 0x00000040u32;
const statxCtime: u32 = 0x00000080u32;
const statxIno: u32 = 0x00000100u32;
const statxSize: u32 = 0x00000200u32;
const statxBlocks: u32 = 0x00000400u32;
const statxRequestBasic: u32 =
    statxType | statxMode | statxNlink | statxAtime | statxMtime | statxCtime | statxIno | statxSize | statxBlocks;
const statxRequiredBasic: u32 =
    statxType | statxMode | statxNlink | statxMtime | statxCtime | statxIno | statxSize;
const sIfmt: u16 = 0o170000u16;
const sIfifo: u16 = 0o010000u16;
const sIfchr: u16 = 0o020000u16;
const sIfdir: u16 = 0o040000u16;
const sIfblk: u16 = 0o060000u16;
const sIfreg: u16 = 0o100000u16;
const sIflnk: u16 = 0o120000u16;
const sIfsock: u16 = 0o140000u16;
const nanosPerSecond: u32 = 1000000000u32;

pub extern struct StatxTimestamp {
    sec: i64,
    nsec: u32,
    reserved: i32,
}

pub extern struct Statx {
    mask: u32,
    blksize: u32,
    attributes: u64,
    nlink: u32,
    uid: u32,
    gid: u32,
    mode: u16,
    spare0: u16,
    ino: u64,
    size: u64,
    blocks: u64,
    attributesMask: u64,
    atime: StatxTimestamp,
    btime: StatxTimestamp,
    ctime: StatxTimestamp,
    mtime: StatxTimestamp,
    rdevMajor: u32,
    rdevMinor: u32,
    devMajor: u32,
    devMinor: u32,
    mntId: u64,
    dioMemAlign: u32,
    dioOffsetAlign: u32,
    subvol: u64,
    atomicWriteUnitMin: u32,
    atomicWriteUnitMax: u32,
    atomicWriteSegmentsMax: u32,
    dioReadOffsetAlign: u32,
    atomicWriteUnitMaxOpt: u32,
    spare2: [u32; 1],
    spare3: [u64; 8],
}

pub fn metadataFd(fd: FileDescriptor) Errno!FileMetadata {
    let empty = b"\0";
    statxAt(fd, &empty[0], atEmptyPath, statxRequestBasic)
}

pub fn metadataAtBeneath(dir: FileDescriptor, path: &u8, followSymlinks: bool) Errno!FileMetadata {
    let mut flags = types::openPath;
    if not followSymlinks {
        flags = flags + types::openNoFollow;
    }
    let how = OpenHow {
        flags: flags as u64,
        mode: 0u64,
        resolve: types::resolveBeneath | types::resolveNoMagicLinks,
    };
    let ret = syscall::syscall4(
        syscall::openat2,
        dir.raw() as usize,
        path as usize,
        &how as usize,
        std::builtin::size[OpenHow](),
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        let handle = FileDescriptor::fromSyscall(ret).?;
        let result = metadataFd(handle);
        result.closeAfter(handle.close())
    }
}

fn statxAt(dir: FileDescriptor, path: &u8, flags: usize, mask: u32) Errno!FileMetadata {
    let mut stx: Statx;
    let mut bytes = &mut ((&mut stx as &mut u8)[0..std::builtin::size[Statx]()]);
    std::builtin::memset(bytes, 0);
    let ret = syscall::syscall5(
        syscall::statx,
        dir.raw() as usize,
        path as usize,
        flags,
        mask as usize,
        &mut stx as usize,
    );
    ret.syscallSuccess().?;
    stx.asMetadata()
}

extend StatxTimestamp {
    fn asTimestamp(&self) Errno!Timestamp {
        if self.nsec >= nanosPerSecond {
            return Errno::Invalid!;
        }
        !Timestamp::init(self.sec, self.nsec)
    }
}

extend Statx {
    fn hasRequiredBasic(&self) bool {
        (self.mask & statxRequiredBasic) == statxRequiredBasic
    }

    fn kind(&self) FileKind {
        match self.mode & sIfmt {
            (sIfdir) => FileKind::Directory,
            (sIfchr) => FileKind::CharacterDevice,
            (sIfblk) => FileKind::BlockDevice,
            (sIfreg) => FileKind::File,
            (sIfifo) => FileKind::NamedPipe,
            (sIflnk) => FileKind::Symlink,
            (sIfsock) => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }

    pub fn asMetadata(&self) Errno!FileMetadata {
        if not self.hasRequiredBasic() {
            return Errno::Invalid!;
        }
        let mut atime: ?Timestamp = null;
        if (self.mask & statxAtime) == statxAtime {
            atime = ?self.atime.asTimestamp().?;
        }
        let mut blockSize = 1u32;
        if (self.mask & statxBlocks) == statxBlocks {
            blockSize = self.blksize;
        }
        !FileMetadata::init(
            self.kind(),
            self.ino,
            self.nlink,
            self.size,
            self.mode as u32,
            blockSize,
            atime,
            self.mtime.asTimestamp().?,
            self.ctime.asTimestamp().?,
        )
    }
}
