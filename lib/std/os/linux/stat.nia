using pkg::os::linux::syscall;
using pkg::os::linux::types;

using types::{Errno, FileDescriptor, FileKind, FileMetadata, Timestamp};
using types::OpenHow;

const at_empty_path: usize = 0x1000usize;
const statx_type: u32 = 0x00000001u32;
const statx_mode: u32 = 0x00000002u32;
const statx_nlink: u32 = 0x00000004u32;
const statx_atime: u32 = 0x00000020u32;
const statx_mtime: u32 = 0x00000040u32;
const statx_ctime: u32 = 0x00000080u32;
const statx_ino: u32 = 0x00000100u32;
const statx_size: u32 = 0x00000200u32;
const statx_blocks: u32 = 0x00000400u32;
const statx_request_basic: u32 =
    statx_type | statx_mode | statx_nlink | statx_atime | statx_mtime | statx_ctime | statx_ino | statx_size | statx_blocks;
const statx_required_basic: u32 =
    statx_type | statx_mode | statx_nlink | statx_mtime | statx_ctime | statx_ino | statx_size;
const s_ifmt: u16 = 0o170000u16;
const s_ififo: u16 = 0o010000u16;
const s_ifchr: u16 = 0o020000u16;
const s_ifdir: u16 = 0o040000u16;
const s_ifblk: u16 = 0o060000u16;
const s_ifreg: u16 = 0o100000u16;
const s_iflnk: u16 = 0o120000u16;
const s_ifsock: u16 = 0o140000u16;
const nanos_per_second: u32 = 1000000000u32;

pub extern struct StatxTimestamp {
    sec: i64,
    nsec: u32,
    reserved: i32,
}

pub extern struct Statx {
    mask: u32,
    blksize: u32,
    attributes: u64,
    nlink: u32,
    uid: u32,
    gid: u32,
    mode: u16,
    spare0: u16,
    ino: u64,
    size: u64,
    blocks: u64,
    attributes_mask: u64,
    atime: StatxTimestamp,
    btime: StatxTimestamp,
    ctime: StatxTimestamp,
    mtime: StatxTimestamp,
    rdev_major: u32,
    rdev_minor: u32,
    dev_major: u32,
    dev_minor: u32,
    mnt_id: u64,
    dio_mem_align: u32,
    dio_offset_align: u32,
    subvol: u64,
    atomic_write_unit_min: u32,
    atomic_write_unit_max: u32,
    atomic_write_segments_max: u32,
    dio_read_offset_align: u32,
    atomic_write_unit_max_opt: u32,
    spare2: [u32; 1],
    spare3: [u64; 8],
}

pub fn metadata_fd(fd: FileDescriptor) Errno!FileMetadata {
    let empty = b"\0";
    statx_at(fd, &empty[0], at_empty_path, statx_request_basic)
}

pub fn metadata_at_beneath(dir: FileDescriptor, path: &u8, follow_symlinks: bool) Errno!FileMetadata {
    let mut flags = types::open_path;
    if not follow_symlinks {
        flags = flags + types::open_no_follow;
    }
    let how = OpenHow {
        flags: flags as u64,
        mode: 0u64,
        resolve: types::resolve_beneath | types::resolve_no_magiclinks,
    };
    let ret = syscall::syscall4(
        syscall::openat2,
        dir.raw() as usize,
        path as usize,
        &how as usize,
        std::builtin::size[OpenHow](),
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        let handle = FileDescriptor::from_syscall(ret).?;
        let result = metadata_fd(handle);
        match handle.close() {
            !ok => { _ = ok; },
            error! => { _ = error; },
        }
        result
    }
}

fn statx_at(dir: FileDescriptor, path: &u8, flags: usize, mask: u32) Errno!FileMetadata {
    let mut stx: Statx;
    let mut bytes = &mut ((&mut stx as &mut u8)[0..std::builtin::size[Statx]()]);
    std::builtin::memset(bytes, 0);
    let ret = syscall::syscall5(
        syscall::statx,
        dir.raw() as usize,
        path as usize,
        flags,
        mask as usize,
        &mut stx as usize,
    );
    ret.syscall_success().?;
    stx.as_metadata()
}

extend StatxTimestamp {
    fn as_timestamp(&self) Errno!Timestamp {
        if self.nsec >= nanos_per_second {
            return Errno::Invalid!;
        }
        !Timestamp::init(self.sec, self.nsec)
    }
}

extend Statx {
    fn has_required_basic(&self) bool {
        (self.mask & statx_required_basic) == statx_required_basic
    }

    fn kind(&self) FileKind {
        match self.mode & s_ifmt {
            (s_ifdir) => FileKind::Directory,
            (s_ifchr) => FileKind::CharacterDevice,
            (s_ifblk) => FileKind::BlockDevice,
            (s_ifreg) => FileKind::File,
            (s_ififo) => FileKind::NamedPipe,
            (s_iflnk) => FileKind::Symlink,
            (s_ifsock) => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }

    pub fn as_metadata(&self) Errno!FileMetadata {
        if not self.has_required_basic() {
            return Errno::Invalid!;
        }
        let mut atime: ?Timestamp = null;
        if (self.mask & statx_atime) == statx_atime {
            atime = ?self.atime.as_timestamp().?;
        }
        let mut block_size = 1u32;
        if (self.mask & statx_blocks) == statx_blocks {
            block_size = self.blksize;
        }
        !FileMetadata::init(
            self.kind(),
            self.ino,
            self.nlink,
            self.size,
            self.mode as u32,
            block_size,
            atime,
            self.mtime.as_timestamp().?,
            self.ctime.as_timestamp().?,
        )
    }
}
