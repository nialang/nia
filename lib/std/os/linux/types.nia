pub comptime let max_path_bytes: usize = 4096usize;
pub comptime let at_fdcwd: i32 = -100;
pub comptime let at_removedir: usize = 0x200usize;
pub comptime let open_create: i32 = 0o100;
pub comptime let open_exclusive: i32 = 0o200;
pub comptime let open_truncate: i32 = 0o1000;
pub comptime let open_directory: i32 = 0o200000;
pub comptime let open_no_follow: i32 = 0o400000;
pub comptime let open_close_on_exec: i32 = 0o2000000;

pub enum Errno: i32 {
    PermissionDenied = 1,
    NoEntry = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    NoMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    Exists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    NotEmpty = 39,
    _,
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub enum SeekWhence: usize {
    Start = 0,
    Current = 1,
    End = 2,
    _,
}

pub enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub struct FileMetadata {
    kind: FileKind,
    inode: u64,
    nlink: u32,
    size: u64,
    mode: u32,
    block_size: u32,
    atime: ?Timestamp,
    mtime: Timestamp,
    ctime: Timestamp,
}

pub struct FileDescriptor {
    fd: i32,
}

extend Errno {
    pub fn from_code(code: i32) Errno {
        code as Errno
    }
}

extend FileDescriptor {
    pub fn init(fd: i32) FileDescriptor {
        { fd: fd }
    }

    pub fn stdin() FileDescriptor {
        FileDescriptor::init(0)
    }

    pub fn stdout() FileDescriptor {
        FileDescriptor::init(1)
    }

    pub fn stderr() FileDescriptor {
        FileDescriptor::init(2)
    }

    pub fn raw(&self) i32 {
        self.fd
    }
}

extend Timestamp {
    pub fn init(seconds: i64, nanos: u32) Timestamp {
        { seconds: seconds, nanos: nanos }
    }

    pub fn seconds(&self) i64 {
        self.seconds
    }

    pub fn nanos(&self) u32 {
        self.nanos
    }
}

extend FileMetadata {
    pub fn init(
        kind: FileKind,
        inode: u64,
        nlink: u32,
        size: u64,
        mode: u32,
        block_size: u32,
        atime: ?Timestamp,
        mtime: Timestamp,
        ctime: Timestamp,
    ) FileMetadata {
        {
            kind: kind,
            inode: inode,
            nlink: nlink,
            size: size,
            mode: mode,
            block_size: block_size,
            atime: atime,
            mtime: mtime,
            ctime: ctime,
        }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn inode(&self) u64 {
        self.inode
    }

    pub fn nlink(&self) u32 {
        self.nlink
    }

    pub fn size(&self) u64 {
        self.size
    }

    pub fn mode(&self) u32 {
        self.mode
    }

    pub fn block_size(&self) u32 {
        self.block_size
    }

    pub fn atime(&self) ?Timestamp {
        self.atime
    }

    pub fn mtime(&self) Timestamp {
        self.mtime
    }

    pub fn ctime(&self) Timestamp {
        self.ctime
    }
}

extend isize {
    pub fn syscall_error(self) Errno {
        Errno::from_code((0isize - self) as i32)
    }
}
