pub const maxPathBytes: usize = 4096;
pub const atFdCwd: i32 = -100;
pub const atRemoveDir: usize = 0x200;
pub const openCreate: i32 = 0o100;
pub const openExclusive: i32 = 0o200;
pub const openTruncate: i32 = 0o1000;
// arm64 moves these two flags; x86 and x86_64 share the classic values.
@[if arch == "aarch64"]
pub const openDirectory: i32 = 0o40000;
@[if arch == "aarch64"]
pub const openNoFollow: i32 = 0o100000;
@[if arch != "aarch64"]
pub const openDirectory: i32 = 0o200000;
@[if arch != "aarch64"]
pub const openNoFollow: i32 = 0o400000;
pub const openPath: i32 = 0x200000;
pub const resolveNoMagicLinks: u64 = 0x02;
pub const resolveBeneath: u64 = 0x08;
pub const closeOnExec: i32 = 0o2000000;
pub const waitNoHang: usize = 1;
pub const sigTerm: i32 = 15;
const maxSyscallErrno: isize = 4095;

pub enum Errno: i32 {
    PermissionDenied = 1,
    NoEntry = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    NoChild = 10,
    Again = 11,
    NoMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    Exists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    Unsupported = 38,
    SymlinkLoop = 40,
    NotEmpty = 39,
    _,
}

pub enum SpawnStage: i32 {
    Setup = 1,
    Stdio = 2,
    Cwd = 3,
    Exec = 4,
    _,
}

pub enum SpawnError {
    Setup(Errno),
    Stdio(Errno),
    Cwd(Errno),
    Exec(Errno),
    Reap {
        stage: SpawnStage,
        primary: Errno,
        cause: Errno,
        pid: ProcessId,
    },
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub enum SeekWhence: usize {
    Start = 0,
    Current = 1,
    End = 2,
    _,
}

pub enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub struct DirectoryEntry {
    kind: FileKind,
    name: &[u8],
    size: u64,
}

pub struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub struct FileMetadata {
    kind: FileKind,
    inode: u64,
    nlink: u32,
    size: u64,
    mode: u32,
    blockSize: u32,
    atime: ?Timestamp,
    mtime: Timestamp,
    ctime: ?Timestamp,
}

pub struct FileDescriptor {
    fd: i32,
}

pub struct Pipe {
    read: FileDescriptor,
    write: FileDescriptor,
}

pub struct ProcessId {
    pid: i32,
}

pub struct WaitStatus {
    raw: i32,
}

pub enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub struct SpawnResult {
    pid: ProcessId,
    stdin: ?FileDescriptor,
    stdout: ?FileDescriptor,
    stderr: ?FileDescriptor,
}

pub struct SpawnAttempt {
    result: ?SpawnResult,
    error: ?SpawnError,
    pendingReap: ?ProcessId,
    pendingReapError: ?Errno,
}

pub struct SpawnOptions {
    stdin: StdIo,
    stdout: StdIo,
    stderr: StdIo,
    cwd: ?&u8,
}

pub extern struct OpenHow {
    flags: u64,
    mode: u64,
    resolve: u64,
}

extend Errno {
    pub fun fromCode(code: i32) Errno {
        code as Errno
    }
}

extend SpawnError {
    pub fun fromStage(stage: SpawnStage, errno: Errno) SpawnError {
        match stage {
            .Setup => .Setup(errno),
            .Stdio => .Stdio(errno),
            .Cwd => .Cwd(errno),
            .Exec => .Exec(errno),
            _ => .Setup(errno),
        }
    }

    pub fun stage(&self) SpawnStage {
        match self.* {
            .Setup(_) => .Setup,
            .Stdio(_) => .Stdio,
            .Cwd(_) => .Cwd,
            .Exec(_) => .Exec,
            .Reap { stage, primary: _, cause: _, pid: _ } => stage,
        }
    }

    pub fun primary(&self) Errno {
        match self.* {
            .Setup(cause) => cause,
            .Stdio(cause) => cause,
            .Cwd(cause) => cause,
            .Exec(cause) => cause,
            .Reap { stage: _, primary, cause: _, pid: _ } => primary,
        }
    }
}

extend SpawnAttempt {
    pub fun success(result: SpawnResult) SpawnAttempt {
        .{ result: ?result, error: null, pendingReap: null, pendingReapError: null }
    }

    pub fun failure(error: SpawnError) SpawnAttempt {
        .{ result: null, error: ?error, pendingReap: null, pendingReapError: null }
    }

    pub fun reapFailure(error: SpawnError, pid: ProcessId, cause: Errno) SpawnAttempt {
        .{ result: null, error: ?error, pendingReap: ?pid, pendingReapError: ?cause }
    }
}

extend FileDescriptor {
    pub fun init(fd: i32) FileDescriptor {
        .{ fd }
    }

    pub fun fromSyscall(ret: isize) Errno!FileDescriptor {
        if ret < 0 or ret > i32::MAX as isize {
            return .Io!;
        }
        !.init(ret as i32)
    }

    pub fun fromKernel(fd: i32) Errno!FileDescriptor {
        if fd < 0 {
            return .Io!;
        }
        !.init(fd)
    }

    pub fun stdin() FileDescriptor {
        .init(0)
    }

    pub fun stdout() FileDescriptor {
        .init(1)
    }

    pub fun stderr() FileDescriptor {
        .init(2)
    }

    pub fun raw(&self) i32 {
        self.fd
    }
}

extend Pipe {
    pub fun init(read: FileDescriptor, write: FileDescriptor) Pipe {
        .{ read, write }
    }

    pub fun read(&self) FileDescriptor {
        self.read
    }

    pub fun write(&self) FileDescriptor {
        self.write
    }
}

extend ProcessId {
    pub const fun init(pid: i32) ProcessId {
        .{ pid }
    }

    pub fun fromSyscall(ret: isize) Errno!ProcessId {
        if ret <= 0 or ret > i32::MAX as isize {
            return .Io!;
        }
        !.init(ret as i32)
    }

    pub const fun raw(&self) i32 {
        self.pid
    }
}

extend WaitStatus {
    pub fun init(raw: i32) WaitStatus {
        .{ raw }
    }

    pub fun raw(&self) i32 {
        self.raw
    }

    pub fun exited(&self) bool {
        (self.raw & 0x7f) == 0
    }

    pub fun signaled(&self) bool {
        let signal = self.raw & 0x7f;
        signal != 0 and signal != 0x7f
    }

    pub fun stopped(&self) bool {
        (self.raw & 0xff) == 0x7f
    }

    pub fun exitCode(&self) ?i32 {
        if self.exited() {
            ?((self.raw >> 8) & 0xff)
        } else {
            null
        }
    }

    pub fun signal(&self) ?i32 {
        if self.signaled() {
            ?(self.raw & 0x7f)
        } else {
            null
        }
    }

    pub fun stopSignal(&self) ?i32 {
        if self.stopped() {
            ?((self.raw >> 8) & 0xff)
        } else {
            null
        }
    }
}

extend SpawnResult {
    pub fun init(
        pid: ProcessId,
        stdin: ?FileDescriptor,
        stdout: ?FileDescriptor,
        stderr: ?FileDescriptor,
    ) SpawnResult {
        .{ pid, stdin, stdout, stderr }
    }

    pub fun pid(&self) ProcessId {
        self.pid
    }

    pub fun stdin(&self) ?FileDescriptor {
        self.stdin
    }

    pub fun stdout(&self) ?FileDescriptor {
        self.stdout
    }

    pub fun stderr(&self) ?FileDescriptor {
        self.stderr
    }
}

extend SpawnOptions {
    pub fun init() SpawnOptions {
        .{
            stdin: .Inherit,
            stdout: .Inherit,
            stderr: .Inherit,
            cwd: null,
        }
    }

    pub fun stdin(&self) StdIo {
        self.stdin
    }

    pub fun stdout(&self) StdIo {
        self.stdout
    }

    pub fun stderr(&self) StdIo {
        self.stderr
    }

    pub fun cwd(&self) ?&u8 {
        self.cwd
    }

    pub fun setStdin(&mut self, behavior: StdIo) () {
        self.stdin = behavior;
    }

    pub fun setStdout(&mut self, behavior: StdIo) () {
        self.stdout = behavior;
    }

    pub fun setStderr(&mut self, behavior: StdIo) () {
        self.stderr = behavior;
    }

    pub fun setCwd(&mut self, path: &u8) () {
        self.cwd = ?path;
    }
}

extend DirectoryEntry {
    pub fun init(kind: FileKind, name: &[u8], size: u64) DirectoryEntry {
        .{ kind, name, size }
    }

    pub fun kind(&self) FileKind {
        self.kind
    }

    pub fun name(&self) &[u8] {
        self.name
    }

    pub fun size(&self) u64 { self.size }
}

extend Timestamp {
    pub fun init(seconds: i64, nanos: u32) Timestamp {
        .{ seconds, nanos }
    }

    pub fun seconds(&self) i64 {
        self.seconds
    }

    pub fun nanos(&self) u32 {
        self.nanos
    }
}

extend FileMetadata {
    pub fun init(
        kind: FileKind,
        inode: u64,
        nlink: u32,
        size: u64,
        mode: u32,
        blockSize: u32,
        atime: ?Timestamp,
        mtime: Timestamp,
        ctime: ?Timestamp,
    ) FileMetadata {
        .{ kind, inode, nlink, size, mode, blockSize, atime, mtime, ctime }
    }

    pub fun kind(&self) FileKind {
        self.kind
    }

    pub fun inode(&self) u64 {
        self.inode
    }

    pub fun nlink(&self) u32 {
        self.nlink
    }

    pub fun size(&self) u64 {
        self.size
    }

    pub fun mode(&self) u32 {
        self.mode
    }

    pub fun blockSize(&self) u32 {
        self.blockSize
    }

    pub fun atime(&self) ?Timestamp {
        self.atime
    }

    pub fun mtime(&self) Timestamp {
        self.mtime
    }

    pub fun ctime(&self) ?Timestamp {
        self.ctime
    }
}

extend isize {
    pub fun syscallSuccess(self) Errno!() {
        if self < 0 {
            self.syscallError()!
        } else if self != 0 {
            .Io!
        } else {
            !()
        }
    }

    pub fun syscallError(self) Errno {
        if self >= 0 or self == isize::MIN {
            return Errno::Io;
        }
        let magnitude: isize = 0 - self;
        if magnitude > maxSyscallErrno {
            return Errno::Io;
        }
        Errno::fromCode(magnitude as i32)
    }
}
