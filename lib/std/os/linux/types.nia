pub const max_path_bytes: usize = 4096usize;
pub const at_fdcwd: i32 = -100;
pub const at_removedir: usize = 0x200usize;
pub const open_create: i32 = 0o100;
pub const open_exclusive: i32 = 0o200;
pub const open_truncate: i32 = 0o1000;
pub const open_directory: i32 = 0o200000;
pub const open_no_follow: i32 = 0o400000;
pub const open_path: i32 = 0x200000;
pub const resolve_no_magiclinks: u64 = 0x02u64;
pub const resolve_beneath: u64 = 0x08u64;
pub const close_on_exec: i32 = 0o2000000;
pub const wait_no_hang: usize = 1usize;
pub const sigterm: i32 = 15;

pub enum Errno: i32 {
    PermissionDenied = 1,
    NoEntry = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    NoMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    Exists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    Unsupported = 38,
    SymlinkLoop = 40,
    NotEmpty = 39,
    _,
}

pub enum SpawnStage: i32 {
    Setup = 1,
    Stdio = 2,
    Cwd = 3,
    Exec = 4,
    _,
}

pub enum SpawnError {
    Setup(Errno),
    Stdio(Errno),
    Cwd(Errno),
    Exec(Errno),
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub enum SeekWhence: usize {
    Start = 0,
    Current = 1,
    End = 2,
    _,
}

pub enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub struct DirectoryEntry {
    kind: FileKind,
    name: &[u8],
}

pub struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub struct FileMetadata {
    kind: FileKind,
    inode: u64,
    nlink: u32,
    size: u64,
    mode: u32,
    block_size: u32,
    atime: ?Timestamp,
    mtime: Timestamp,
    ctime: Timestamp,
}

pub struct FileDescriptor {
    fd: i32,
}

pub struct Pipe {
    read: FileDescriptor,
    write: FileDescriptor,
}

pub struct ProcessId {
    pid: i32,
}

pub struct WaitStatus {
    raw: i32,
}

pub enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub struct SpawnResult {
    pid: ProcessId,
    stdin: ?FileDescriptor,
    stdout: ?FileDescriptor,
    stderr: ?FileDescriptor,
}

pub struct SpawnOptions {
    stdin: StdIo,
    stdout: StdIo,
    stderr: StdIo,
    cwd: ?&u8,
}

pub extern struct OpenHow {
    flags: u64,
    mode: u64,
    resolve: u64,
}

extend Errno {
    pub fn from_code(code: i32) Errno {
        code as Errno
    }
}

extend SpawnError {
    pub fn from_stage(stage: SpawnStage, errno: Errno) SpawnError {
        switch stage {
            SpawnStage::Setup => SpawnError::Setup(errno),
            SpawnStage::Stdio => SpawnError::Stdio(errno),
            SpawnStage::Cwd => SpawnError::Cwd(errno),
            SpawnStage::Exec => SpawnError::Exec(errno),
            _ => SpawnError::Setup(errno),
        }
    }
}

extend FileDescriptor {
    pub fn init(fd: i32) FileDescriptor {
        { fd: fd }
    }

    pub fn stdin() FileDescriptor {
        FileDescriptor::init(0)
    }

    pub fn stdout() FileDescriptor {
        FileDescriptor::init(1)
    }

    pub fn stderr() FileDescriptor {
        FileDescriptor::init(2)
    }

    pub fn raw(&self) i32 {
        self.fd
    }
}

extend Pipe {
    pub fn init(read: FileDescriptor, write: FileDescriptor) Pipe {
        { read: read, write: write }
    }

    pub fn read(&self) FileDescriptor {
        self.read
    }

    pub fn write(&self) FileDescriptor {
        self.write
    }
}

extend ProcessId {
    pub fn init(pid: i32) ProcessId {
        { pid: pid }
    }

    pub fn raw(&self) i32 {
        self.pid
    }
}

extend WaitStatus {
    pub fn init(raw: i32) WaitStatus {
        { raw: raw }
    }

    pub fn raw(&self) i32 {
        self.raw
    }

    pub fn exited(&self) bool {
        (self.raw & 0x7fi32) == 0i32
    }

    pub fn signaled(&self) bool {
        let signal = self.raw & 0x7fi32;
        signal != 0i32 and signal != 0x7fi32
    }

    pub fn stopped(&self) bool {
        (self.raw & 0xffi32) == 0x7fi32
    }

    pub fn exit_code(&self) ?i32 {
        if self.exited() {
            ?((self.raw >> 8u8) & 0xffi32)
        } else {
            null
        }
    }

    pub fn signal(&self) ?i32 {
        if self.signaled() {
            ?(self.raw & 0x7fi32)
        } else {
            null
        }
    }

    pub fn stop_signal(&self) ?i32 {
        if self.stopped() {
            ?((self.raw >> 8u8) & 0xffi32)
        } else {
            null
        }
    }
}

extend SpawnResult {
    pub fn init(
        pid: ProcessId,
        stdin: ?FileDescriptor,
        stdout: ?FileDescriptor,
        stderr: ?FileDescriptor,
    ) SpawnResult {
        { pid: pid, stdin: stdin, stdout: stdout, stderr: stderr }
    }

    pub fn pid(&self) ProcessId {
        self.pid
    }

    pub fn stdin(&self) ?FileDescriptor {
        self.stdin
    }

    pub fn stdout(&self) ?FileDescriptor {
        self.stdout
    }

    pub fn stderr(&self) ?FileDescriptor {
        self.stderr
    }
}

extend SpawnOptions {
    pub fn init() SpawnOptions {
        {
            stdin: StdIo::Inherit,
            stdout: StdIo::Inherit,
            stderr: StdIo::Inherit,
            cwd: null,
        }
    }

    pub fn stdin(&self) StdIo {
        self.stdin
    }

    pub fn stdout(&self) StdIo {
        self.stdout
    }

    pub fn stderr(&self) StdIo {
        self.stderr
    }

    pub fn cwd(&self) ?&u8 {
        self.cwd
    }

    pub fn set_stdin(&mut self, behavior: StdIo) void {
        self.stdin = behavior;
    }

    pub fn set_stdout(&mut self, behavior: StdIo) void {
        self.stdout = behavior;
    }

    pub fn set_stderr(&mut self, behavior: StdIo) void {
        self.stderr = behavior;
    }

    pub fn set_cwd(&mut self, path: &u8) void {
        self.cwd = ?path;
    }
}

extend DirectoryEntry {
    pub fn init(kind: FileKind, name: &[u8]) DirectoryEntry {
        { kind: kind, name: name }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn name(&self) &[u8] {
        self.name
    }
}

extend Timestamp {
    pub fn init(seconds: i64, nanos: u32) Timestamp {
        { seconds: seconds, nanos: nanos }
    }

    pub fn seconds(&self) i64 {
        self.seconds
    }

    pub fn nanos(&self) u32 {
        self.nanos
    }
}

extend FileMetadata {
    pub fn init(
        kind: FileKind,
        inode: u64,
        nlink: u32,
        size: u64,
        mode: u32,
        block_size: u32,
        atime: ?Timestamp,
        mtime: Timestamp,
        ctime: Timestamp,
    ) FileMetadata {
        {
            kind: kind,
            inode: inode,
            nlink: nlink,
            size: size,
            mode: mode,
            block_size: block_size,
            atime: atime,
            mtime: mtime,
            ctime: ctime,
        }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn inode(&self) u64 {
        self.inode
    }

    pub fn nlink(&self) u32 {
        self.nlink
    }

    pub fn size(&self) u64 {
        self.size
    }

    pub fn mode(&self) u32 {
        self.mode
    }

    pub fn block_size(&self) u32 {
        self.block_size
    }

    pub fn atime(&self) ?Timestamp {
        self.atime
    }

    pub fn mtime(&self) Timestamp {
        self.mtime
    }

    pub fn ctime(&self) Timestamp {
        self.ctime
    }
}

extend isize {
    pub fn syscall_error(self) Errno {
        Errno::from_code((0isize - self) as i32)
    }
}
