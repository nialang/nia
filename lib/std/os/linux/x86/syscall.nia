pub fn syscall4(number: usize, arg0: usize, arg1: usize, arg2: usize, arg3: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\push ebx
            \\push esi
            \\int 0x80
            \\pop esi
            \\pop ebx
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
            ebx: arg0,
            ecx: arg1,
            edx: arg2,
            esi: arg3,
        },
        clobbers: [b"memory"],
        options: [b"volatile"],
    });
    ret
}

pub fn syscall5(number: usize, arg0: usize, arg1: usize, arg2: usize, arg3: usize, arg4: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\push ebx
            \\push esi
            \\push edi
            \\int 0x80
            \\pop edi
            \\pop esi
            \\pop ebx
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
            ebx: arg0,
            ecx: arg1,
            edx: arg2,
            esi: arg3,
            edi: arg4,
        },
        clobbers: [b"memory"],
        options: [b"volatile"],
    });
    ret
}

pub fn syscall6(
    number: usize,
    arg0: usize,
    arg1: usize,
    arg2: usize,
    arg3: usize,
    arg4: usize,
    arg5: usize,
) isize {
    let args: [usize; 6] = [arg0, arg1, arg2, arg3, arg4, arg5];
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\push ebx
            \\push esi
            \\push edi
            \\push ebp
            \\mov ebx, [ecx]
            \\mov edx, [ecx + 8]
            \\mov esi, [ecx + 12]
            \\mov edi, [ecx + 16]
            \\mov ebp, [ecx + 20]
            \\mov ecx, [ecx + 4]
            \\int 0x80
            \\pop ebp
            \\pop edi
            \\pop esi
            \\pop ebx
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
            ecx: &args[0] as usize,
        },
        clobbers: [b"memory"],
        options: [b"volatile"],
    });
    ret
}
