pub fn syscall4(number: usize, arg0: usize, arg1: usize, arg2: usize, arg3: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\push ebx
            \\push esi
            \\int 0x80
            \\pop esi
            \\pop ebx
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
            ebx: arg0,
            ecx: arg1,
            edx: arg2,
            esi: arg3,
        },
        clobbers: [b"memory"],
        options: [b"volatile"],
    });
    ret
}

pub fn syscall5(number: usize, arg0: usize, arg1: usize, arg2: usize, arg3: usize, arg4: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\push ebx
            \\push esi
            \\push edi
            \\int 0x80
            \\pop edi
            \\pop esi
            \\pop ebx
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
            ebx: arg0,
            ecx: arg1,
            edx: arg2,
            esi: arg3,
            edi: arg4,
