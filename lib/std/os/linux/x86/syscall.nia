pub const read: usize = 3;
pub const write: usize = 4;
pub const close: usize = 6;
pub const dup2: usize = 63;
pub const lseek: usize = 19;
pub const mmap: usize = 192;
pub const munmap: usize = 91;
pub const fork: usize = 2;
pub const execve: usize = 11;
pub const exit: usize = 1;
pub const wait4: usize = 114;
pub const kill: usize = 37;
pub const fchmod: usize = 94;
pub const fsync: usize = 118;
pub const fdatasync: usize = 148;
pub const ftruncate: usize = 93;
pub const getcwd: usize = 183;
pub const chdir: usize = 12;
pub const getdents64: usize = 220;
pub const openat: usize = 295;
pub const openat2: usize = 437;
pub const mkdirat: usize = 296;
pub const unlinkat: usize = 301;
pub const renameat: usize = 302;
pub const pipe2: usize = 331;
pub const getrandom: usize = 355;
pub const statx: usize = 383;

pub fn syscall0(number: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\int 0x80
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
        },
        clobbers: [b"memory"],
        options: [b"volatile"],
    });
    ret
}

pub fn syscall1(number: usize, arg0: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\push ebx
            \\int 0x80
            \\pop ebx
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
            ebx: arg0,
        },
        clobbers: [b"memory"],
        options: [b"volatile"],
    });
    ret
}

pub fn syscall2(number: usize, arg0: usize, arg1: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm(std::builtin::AsmConfig {
        code:
            b\\push ebx
            \\int 0x80
            \\pop ebx
        ,
        outputs: std::builtin::AsmOutputs {
            eax: ret,
        },
        inputs: std::builtin::AsmInputs {
            eax: number,
            ebx: arg0,
            ecx: arg1,
        },
        clobbers: [b"memory"],
        options: [b"volatile"],
    });
    ret
}

