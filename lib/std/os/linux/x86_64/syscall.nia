pub comptime let read: usize = 0usize;
pub comptime let write: usize = 1usize;
pub comptime let close: usize = 3usize;
pub comptime let lseek: usize = 8usize;
pub comptime let mmap: usize = 9usize;
pub comptime let munmap: usize = 11usize;
pub comptime let exit: usize = 60usize;
pub comptime let fsync: usize = 74usize;
pub comptime let fdatasync: usize = 75usize;
pub comptime let ftruncate: usize = 77usize;
pub comptime let getcwd: usize = 79usize;
pub comptime let getdents64: usize = 217usize;
pub comptime let openat: usize = 257usize;
pub comptime let mkdirat: usize = 258usize;
pub comptime let unlinkat: usize = 263usize;
pub comptime let renameat: usize = 264usize;
pub comptime let getrandom: usize = 318usize;
pub comptime let statx: usize = 332usize;

pub fn syscall1(number: usize, arg0: usize) isize {
    var ret: isize = 0;
    @asm({
        code:
            b\\syscall
        ,
        outputs: {
            rax: ret,
        },
        inputs: {
            rax: number,
            rdi: arg0,
        },
        clobbers: [b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    ret
}

