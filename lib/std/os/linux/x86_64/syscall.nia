pub const statx: usize = 332usize;

pub fn syscall0(number: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm({
        code:
            b\\syscall
        ,
        outputs: {
            rax: ret,
        },
        inputs: {
            rax: number,
        },
        clobbers: [b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    ret
}

pub fn syscall1(number: usize, arg0: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm({
        code:
            b\\syscall
        ,
        outputs: {
            rax: ret,
        },
        inputs: {
            rax: number,
            rdi: arg0,
        },
        clobbers: [b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    ret
}

