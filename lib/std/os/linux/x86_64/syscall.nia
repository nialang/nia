pub const read: usize = 0usize;
pub const write: usize = 1usize;
pub const close: usize = 3usize;
pub const dup2: usize = 33usize;
pub const lseek: usize = 8usize;
pub const mmap: usize = 9usize;
pub const munmap: usize = 11usize;
pub const fork: usize = 57usize;
pub const execve: usize = 59usize;
pub const exit: usize = 60usize;
pub const wait4: usize = 61usize;
pub const kill: usize = 62usize;
pub const fchmod: usize = 91usize;
pub const fsync: usize = 74usize;
pub const fdatasync: usize = 75usize;
pub const ftruncate: usize = 77usize;
pub const getcwd: usize = 79usize;
pub const chdir: usize = 80usize;
pub const getdents64: usize = 217usize;
pub const openat: usize = 257usize;
pub const openat2: usize = 437usize;
pub const mkdirat: usize = 258usize;
pub const unlinkat: usize = 263usize;
pub const renameat: usize = 264usize;
