pub comptime read: usize = 0usize;
pub comptime write: usize = 1usize;
pub comptime close: usize = 3usize;
pub comptime dup2: usize = 33usize;
pub comptime lseek: usize = 8usize;
pub comptime mmap: usize = 9usize;
pub comptime munmap: usize = 11usize;
pub comptime fork: usize = 57usize;
pub comptime execve: usize = 59usize;
pub comptime exit: usize = 60usize;
pub comptime wait4: usize = 61usize;
pub comptime kill: usize = 62usize;
pub comptime fchmod: usize = 91usize;
pub comptime fsync: usize = 74usize;
pub comptime fdatasync: usize = 75usize;
pub comptime ftruncate: usize = 77usize;
pub comptime getcwd: usize = 79usize;
pub comptime chdir: usize = 80usize;
pub comptime getdents64: usize = 217usize;
pub comptime openat: usize = 257usize;
pub comptime mkdirat: usize = 258usize;
pub comptime unlinkat: usize = 263usize;
pub comptime renameat: usize = 264usize;
pub comptime pipe2: usize = 293usize;
pub comptime getrandom: usize = 318usize;
pub comptime statx: usize = 332usize;

pub fn syscall0(number: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm({
        code:
            b\\syscall
        ,
        outputs: {
            rax: ret,
        },
        inputs: {
            rax: number,
        },
        clobbers: [b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    ret
}

pub fn syscall1(number: usize, arg0: usize) isize {
    let mut ret: isize = 0;
    std::builtin::asm({
        code:
            b\\syscall
        ,
        outputs: {
            rax: ret,
        },
        inputs: {
            rax: number,
            rdi: arg0,
        },
        clobbers: [b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    ret
}

