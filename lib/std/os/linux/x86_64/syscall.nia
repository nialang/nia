pub fn syscall4(number: usize, arg0: usize, arg1: usize, arg2: usize, arg3: usize) isize {
    var ret: isize = 0;
    @asm({
        code:
            b\\syscall
        ,
        outputs: {
            rax: ret,
        },
        inputs: {
            rax: number,
            rdi: arg0,
            rsi: arg1,
            rdx: arg2,
            r10: arg3,
