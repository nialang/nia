using pkg::os::linux::syscall;
using pkg::os::linux::types;
using pkg::os::linux::fd as linux_fd;

using types::{Errno, OpenMode, Pipe, ProcessId, SpawnAttempt, SpawnError, SpawnOptions, SpawnResult, SpawnStage, StdIo, WaitStatus};

struct SpawnPipe {
    read: ?types::FileDescriptor,
    write: ?types::FileDescriptor,
}

struct SpawnResources {
    stdin: SpawnPipe,
    stdout: SpawnPipe,
    stderr: SpawnPipe,
    error: SpawnPipe,
}

struct SpawnErrorRecord {
    stage: i32,
    code: i32,
}

pub fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    let mut resources = SpawnResources::init();
    let result = spawn_with_resources(path, argv, envp, options, &mut resources);
    resources.close_all();
    result
}

fn spawn_with_resources(
    path: &u8,
    argv: &&u8,
    envp: &&u8,
    options: SpawnOptions,
    resources: &mut SpawnResources,
) SpawnAttempt {
    if options.stdin() == StdIo::Pipe {
        resources.stdin = match SpawnPipe::open_close_on_exec() {
            !pipe => pipe,
            error! => return SpawnAttempt::failure(SpawnError::Setup(error)),
        };
    }
    if options.stdout() == StdIo::Pipe {
        resources.stdout = match SpawnPipe::open_close_on_exec() {
            !pipe => pipe,
            error! => return SpawnAttempt::failure(SpawnError::Setup(error)),
        };
    }
    if options.stderr() == StdIo::Pipe {
        resources.stderr = match SpawnPipe::open_close_on_exec() {
            !pipe => pipe,
            error! => return SpawnAttempt::failure(SpawnError::Setup(error)),
        };
    }
    resources.error = match SpawnPipe::open_close_on_exec() {
        !pipe => pipe,
        error! => return SpawnAttempt::failure(SpawnError::Setup(error)),
    };
    let ret = syscall::syscall0(syscall::fork);
    if ret < 0 {
        SpawnAttempt::failure(SpawnError::Setup(ret.syscall_error()))
    } else if ret == 0 {
        resources.error.close_read();
        match apply_stdio(options, &mut resources.stdin, &mut resources.stdout, &mut resources.stderr) {
            !ok => {
                _ = ok;
            },
            error! => {
                report_spawn_error(&resources.error, SpawnStage::Stdio, error);
                exit(127);
            },
        }
        match apply_cwd(options) {
            !ok => {
                _ = ok;
            },
            error! => {
                report_spawn_error(&resources.error, SpawnStage::Cwd, error);
                exit(127);
            },
        }
        let exec_ret = syscall::syscall3(syscall::execve, path as usize, argv as usize, envp as usize);
        report_spawn_error(&resources.error, SpawnStage::Exec, exec_ret.syscall_error());
        exit(127);
        SpawnAttempt::failure(SpawnError::Setup(Errno::Io))
    } else {
        resources.stdin.close_read();
        resources.stdout.close_write();
        resources.stderr.close_write();
        resources.error.close_write();
        let pid = match ProcessId::from_syscall(ret) {
            !pid => pid,
            error! => return SpawnAttempt::failure(SpawnError::Setup(error)),
        };
        let error_read = match resources.error.take_read() {
            ?fd => {
                fd
            },
            null => {
                return failed_spawn_attempt(pid, SpawnError::Setup(Errno::Io));
            },
        };
        match read_spawn_error(error_read) {
            !(?spawn_error) => {
                failed_spawn_attempt(pid, spawn_error)
            },
            !null => {
                SpawnAttempt::success(SpawnResult::init(
                    pid,
                    resources.stdin.take_write(),
                    resources.stdout.take_read(),
                    resources.stderr.take_read(),
                ))
            },
            error! => {
                failed_spawn_attempt(pid, error)
            },
        }
    }
}

fn failed_spawn_attempt(pid: ProcessId, error: SpawnError) SpawnAttempt {
    match reap_spawn_failure(pid) {
        !ok => {
            _ = ok;
            SpawnAttempt::failure(error)
        },
        reap_error! => {
            SpawnAttempt::reap_failure(error, pid, reap_error)
        },
    }
}

fn report_spawn_error(pipe: &SpawnPipe, stage: SpawnStage, errno: Errno) () {
    match pipe.write() {
        !fd => {
            write_spawn_error(fd, stage, errno);
        },
        error! => {
            exit(127);
        },
    }
}

fn write_spawn_error(fd: types::FileDescriptor, stage: SpawnStage, errno: Errno) () {
    let mut record = SpawnErrorRecord::init(stage, errno);
    let mut bytes = &mut ((&mut record as &mut u8)[0..std::builtin::size[SpawnErrorRecord]()]);
    let mut written = 0usize;
    // The parent treats EOF before a record as successful close-on-exec.
    while written < bytes.len() {
        match fd.write_some(&bytes[written..]) {
            !amount => {
                if amount == 0usize {
                    return;
                }
                written += amount;
            },
            Errno::Interrupted! => {},
            error! => {
                _ = error;
                return;
            },
        }
    }
}

fn read_spawn_error(fd: types::FileDescriptor) SpawnError! ?SpawnError {
    let mut record = SpawnErrorRecord::init(SpawnStage::Setup, Errno::Io);
    let mut bytes = &mut ((&mut record as &mut u8)[0..std::builtin::size[SpawnErrorRecord]()]);
    let mut read_len = 0usize;
    while read_len < bytes.len() {
        let amount = match fd.read_some(&mut bytes[read_len..]) {
            !amount => {
                amount
            },
            Errno::Interrupted! => {
                continue;
            },
            error! => {
                return finish_spawn_error(fd, SpawnError::Setup(error)!);
            },
        };
        if amount == 0usize {
            if read_len == 0usize {
                return finish_spawn_error(fd, !null);
            }
            return finish_spawn_error(fd, SpawnError::Setup(Errno::Io)!);
        }
        read_len += amount;
    }
    finish_spawn_error(fd, !(?SpawnError::from_stage(record.stage(), record.errno())))
}

fn finish_spawn_error(
    fd: types::FileDescriptor,
    result: SpawnError! ?SpawnError,
) SpawnError! ?SpawnError {
    match result {
        !value => {
            match fd.close() {
                !ok => {
                    _ = ok;
                    !value
                },
                error! => {
                    SpawnError::Setup(error)!
                },
            }
        },
        error! => {
            _ = fd.close();
            error!
        },
    }
}

fn reap_spawn_failure(pid: ProcessId) Errno!() {
    // A failed handshake still owns the forked child until wait succeeds.
    while true {
        match wait(pid) {
            !status => {
                _ = status;
                return !();
            },
            Errno::Interrupted! => {},
            Errno::NoChild! => {
                // The kernel confirms that no waitable child owner remains.
                return !();
            },
            error! => {
                return error!;
            },
        }
    }
    !()
}

extend SpawnAttempt {
    pub fn finish(&mut self) SpawnError!SpawnResult {
        match self.pending_reap {
            ?pid => {
                match self.pending_reap_error {
                    ?cause => {
                        self.pending_reap_error = null;
                        return self.reap_error(pid, cause)!;
                    },
                    null => {},
                }
                match reap_spawn_failure(pid) {
                    !ok => {
                        _ = ok;
                        self.pending_reap = null;
                    },
                    cause! => {
                        return self.reap_error(pid, cause)!;
                    },
                }
            },
            null => {},
        }
        match self.result {
            ?result => {
                self.result = null;
                !result
            },
            null => {
                let error = match self.error {
                    ?cause => cause,
                    null => SpawnError::Setup(Errno::Invalid),
                };
                self.error = null;
                error!
            },
        }
    }

    fn reap_error(&self, pid: ProcessId, cause: Errno) SpawnError {
        let primary = match self.error {
            ?error => error,
            null => SpawnError::Setup(Errno::Invalid),
        };
        SpawnError::Reap {
            stage: primary.stage(),
            primary: primary.primary(),
            cause: cause,
            pid: pid,
        }
    }
}

fn apply_stdio(options: SpawnOptions, stdin_pipe: &mut SpawnPipe, stdout_pipe: &mut SpawnPipe, stderr_pipe: &mut SpawnPipe) Errno!() {
    let mut dev_null: ?types::FileDescriptor = null;
    if options.stdin() == StdIo::Ignore {
        let fd = open_dev_null().?;
        dev_null = ?fd;
        dup_to(fd, types::FileDescriptor::stdin()).?;
    } else if options.stdin() == StdIo::Pipe {
        dup_to(stdin_pipe.read().?, types::FileDescriptor::stdin()).?;
    }
    if options.stdout() == StdIo::Ignore {
        match dev_null {
            ?fd => {
                dup_to(fd, types::FileDescriptor::stdout()).?;
            },
            null => {
                let fd = open_dev_null().?;
                dev_null = ?fd;
                dup_to(fd, types::FileDescriptor::stdout()).?;
            },
        }
    } else if options.stdout() == StdIo::Pipe {
        dup_to(stdout_pipe.write().?, types::FileDescriptor::stdout()).?;
    }
    if options.stderr() == StdIo::Ignore {
        match dev_null {
            ?fd => {
                dup_to(fd, types::FileDescriptor::stderr()).?;
            },
            null => {
                let fd = open_dev_null().?;
                dev_null = ?fd;
                dup_to(fd, types::FileDescriptor::stderr()).?;
            },
        }
    } else if options.stderr() == StdIo::Pipe {
        dup_to(stderr_pipe.write().?, types::FileDescriptor::stderr()).?;
    }
    stdin_pipe.close_all_except(options);
    stdout_pipe.close_all_except(options);
    stderr_pipe.close_all_except(options);
    match dev_null {
        ?fd => {
            if not isStandardTarget(fd, options) {
                fd.close().?;
            }
        },
        null => {},
    }
    !()
}

fn apply_cwd(options: SpawnOptions) Errno!() {
    match options.cwd() {
        ?path => {
            let ret = syscall::syscall1(syscall::chdir, path as usize);
            ret.syscall_success()
        },
        null => {
            !()
        },
    }
}

fn open_dev_null() Errno!types::FileDescriptor {
    let path = b"/dev/null\0";
    let ret = syscall::syscall4(
        syscall::openat,
        types::at_fdcwd as usize,
        &path[0] as usize,
        OpenMode::ReadWrite as i32 as usize,
        0usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !types::FileDescriptor::from_syscall(ret).?
    }
}

fn dup_to(from: types::FileDescriptor, to: types::FileDescriptor) Errno!() {
    let ret = syscall::syscall2(syscall::dup2, from.raw() as usize, to.raw() as usize);
    if ret < 0 {
        ret.syscall_error()!
    } else if ret != to.raw() as isize {
        Errno::Io!
    } else {
        !()
    }
}

pub fn wait(pid: ProcessId) Errno!WaitStatus {
    wait_with_options(pid, 0usize)
}

pub fn try_wait(pid: ProcessId) Errno! ?WaitStatus {
    let mut status: i32 = 0;
    let ret = wait4(pid, &mut status, types::wait_no_hang);
    if ret < 0 {
        ret.syscall_error()!
    } else if ret == 0 {
        !null
    } else if ret != pid.raw() as isize {
        Errno::Io!
    } else {
        !(?WaitStatus::init(status))
    }
}

pub fn kill(pid: ProcessId) Errno!() {
    kill_with(pid, types::sigterm)
}

pub fn kill_with(pid: ProcessId, signal: i32) Errno!() {
    let ret = syscall::syscall2(syscall::kill, pid.raw() as usize, signal as usize);
    ret.syscall_success()
}

fn wait_with_options(pid: ProcessId, options: usize) Errno!WaitStatus {
    let mut status: i32 = 0;
    let ret = wait4(pid, &mut status, options);
    if ret < 0 {
        ret.syscall_error()!
    } else if ret != pid.raw() as isize {
        Errno::Io!
    } else {
        !WaitStatus::init(status)
    }
}

fn wait4(pid: ProcessId, status: &mut i32, options: usize) isize {
    let ret = syscall::syscall4(
        syscall::wait4,
        pid.raw() as usize,
        status as usize,
        options,
        0usize,
    );
    ret
}

pub fn exit(code: i32) () {
    _ = syscall::syscall1(syscall::exit, code as usize);
    loop {}
}

extend SpawnErrorRecord {
    fn init(stage: SpawnStage, errno: Errno) SpawnErrorRecord {
        Self { stage: stage as i32, code: errno as i32 }
    }

    fn stage(&self) SpawnStage {
        self.stage as SpawnStage
    }

    fn errno(&self) Errno {
        Errno::from_code(self.code)
    }
}

extend SpawnPipe {
    fn closed() SpawnPipe {
        Self { read: null, write: null }
    }

    fn init(read: types::FileDescriptor, write: types::FileDescriptor) SpawnPipe {
        Self { read: ?read, write: ?write }
    }

    fn from_pipe(pipe: Pipe) SpawnPipe {
        SpawnPipe::init(pipe.read(), pipe.write())
    }

    fn open_close_on_exec() Errno!SpawnPipe {
        let pipe = linux_fd::pipe_close_on_exec().?;
        !SpawnPipe::from_pipe(pipe)
    }

    fn read(&self) Errno!types::FileDescriptor {
        match self.read {
            ?fd => {
                !fd
            },
            null => {
                Errno::Invalid!
            },
        }
    }

    fn write(&self) Errno!types::FileDescriptor {
        match self.write {
            ?fd => {
                !fd
            },
            null => {
                Errno::Invalid!
            },
        }
    }

    fn take_read(&mut self) ?types::FileDescriptor {
        let fd = self.read;
        self.read = null;
        fd
    }

    fn take_write(&mut self) ?types::FileDescriptor {
        let fd = self.write;
        self.write = null;
        fd
    }

    fn close_read(&mut self) () {
        match self.take_read() {
            ?fd => {
                _ = fd.close();
            },
            null => {},
        }
    }

    fn close_write(&mut self) () {
        match self.take_write() {
            ?fd => {
                _ = fd.close();
            },
            null => {},
        }
    }

    fn close_all(&mut self) () {
        self.close_read();
        self.close_write();
    }

    fn close_all_except(&mut self, options: SpawnOptions) () {
        match self.take_read() {
            ?fd => {
                if not isStandardTarget(fd, options) {
                    _ = fd.close();
                }
            },
            null => {},
        }
        match self.take_write() {
            ?fd => {
                if not isStandardTarget(fd, options) {
                    _ = fd.close();
                }
            },
            null => {},
        }
    }
}

fn isStandardTarget(fd: types::FileDescriptor, options: SpawnOptions) bool {
    (options.stdin() != StdIo::Inherit and fd.raw() == 0)
        or (options.stdout() != StdIo::Inherit and fd.raw() == 1)
        or (options.stderr() != StdIo::Inherit and fd.raw() == 2)
}

extend SpawnResources {
    fn init() SpawnResources {
        Self {
            stdin: SpawnPipe::closed(),
            stdout: SpawnPipe::closed(),
            stderr: SpawnPipe::closed(),
            error: SpawnPipe::closed(),
        }
    }

    fn close_all(&mut self) () {
        self.stdin.close_all();
        self.stdout.close_all();
        self.stderr.close_all();
        self.error.close_all();
    }
}
