using pkg::os::linux::syscall;
using pkg::os::linux::types;
using pkg::os::linux::fd as linux_fd;

using types::{Errno, OpenMode, Pipe, ProcessId, SpawnError, SpawnOptions, SpawnResult, SpawnStage, StdIo, WaitStatus};

struct SpawnPipe {
    read: ?types::FileDescriptor,
    write: ?types::FileDescriptor,
}

struct SpawnErrorRecord {
    stage: i32,
    code: i32,
}

pub fn spawn_raw(path: &u8, argv: &&u8, envp: &&u8) SpawnError!ProcessId {
    let result = spawn(path, argv, envp, SpawnOptions::init()).?;
    !result.pid()
}

pub fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnError!SpawnResult {
    let mut stdin_pipe = SpawnPipe::closed();
    let mut stdout_pipe = SpawnPipe::closed();
    let mut stderr_pipe = SpawnPipe::closed();
    defer stdin_pipe.close_all();
    defer stdout_pipe.close_all();
    defer stderr_pipe.close_all();
    if options.stdin() == StdIo::Pipe {
        stdin_pipe = SpawnPipe::open_close_on_exec().as_spawn_setup_error().?;
    }
    if options.stdout() == StdIo::Pipe {
        stdout_pipe = SpawnPipe::open_close_on_exec().as_spawn_setup_error().?;
    }
    if options.stderr() == StdIo::Pipe {
        stderr_pipe = SpawnPipe::open_close_on_exec().as_spawn_setup_error().?;
    }
    let mut error_pipe = SpawnPipe::open_close_on_exec().as_spawn_setup_error().?;
    defer error_pipe.close_all();
    let ret = syscall::syscall0(syscall::fork);
    if ret < 0 {
        SpawnError::Setup(ret.syscall_error())!
    } else if ret == 0 {
        error_pipe.close_read();
        match apply_stdio(options, &mut stdin_pipe, &mut stdout_pipe, &mut stderr_pipe) {
            !ok => {
                _ = ok;
            },
            error! => {
                report_spawn_error(&error_pipe, SpawnStage::Stdio, error);
                exit(127);
            },
        }
        match apply_cwd(options) {
            !ok => {
                _ = ok;
            },
            error! => {
                report_spawn_error(&error_pipe, SpawnStage::Cwd, error);
                exit(127);
            },
        }
        let exec_ret = syscall::syscall3(syscall::execve, path as usize, argv as usize, envp as usize);
        report_spawn_error(&error_pipe, SpawnStage::Exec, exec_ret.syscall_error());
        exit(127);
        SpawnError::Setup(Errno::Io)!
    } else {
        stdin_pipe.close_read();
        stdout_pipe.close_write();
        stderr_pipe.close_write();
        error_pipe.close_write();
        let pid = ProcessId::init(ret as i32);
        let error_read = match error_pipe.take_read() {
            ?fd => {
                fd
            },
            null => {
                reap_spawn_failure(pid);
                return SpawnError::Setup(Errno::Io)!;
            },
        };
        match read_spawn_error(error_read, pid).? {
            ?spawn_error => {
                reap_spawn_failure(pid);
                spawn_error!
            },
            null => {
                !SpawnResult::init(
                    pid,
                    stdin_pipe.take_write(),
                    stdout_pipe.take_read(),
                    stderr_pipe.take_read(),
                )
            },
        }
    }
}

fn report_spawn_error(pipe: &SpawnPipe, stage: SpawnStage, errno: Errno) () {
    match pipe.write() {
        !fd => {
            write_spawn_error(fd, stage, errno);
        },
        error! => {
            exit(127);
        },
    }
}

fn write_spawn_error(fd: types::FileDescriptor, stage: SpawnStage, errno: Errno) () {
    let mut record = SpawnErrorRecord::init(stage, errno);
    let mut bytes = &mut ((&mut record as &mut u8)[0..std::builtin::size[SpawnErrorRecord]()]);
    let mut written = 0usize;
    // The parent treats EOF before a record as successful close-on-exec.
    while written < bytes.len() {
        match fd.write_some(&bytes[written..]) {
            !amount => {
                if amount == 0usize {
                    return;
                }
                written += amount;
            },
            Errno::Interrupted! => {},
            error! => {
                _ = error;
                return;
            },
        }
    }
}

fn read_spawn_error(fd: types::FileDescriptor, pid: ProcessId) SpawnError! ?SpawnError {
    defer _ = fd.close();
    let mut record = SpawnErrorRecord::init(SpawnStage::Setup, Errno::Io);
    let mut bytes = &mut ((&mut record as &mut u8)[0..std::builtin::size[SpawnErrorRecord]()]);
    let mut read_len = 0usize;
    while read_len < bytes.len() {
        let amount = match fd.read_some(&mut bytes[read_len..]) {
            !amount => {
                amount
            },
            Errno::Interrupted! => {
                continue;
            },
            error! => {
                reap_spawn_failure(pid);
                return SpawnError::Setup(error)!;
            },
        };
        if amount == 0usize {
            if read_len == 0usize {
                return !null;
            }
            reap_spawn_failure(pid);
            return SpawnError::Setup(Errno::Io)!;
        }
        read_len += amount;
    }
    !(?SpawnError::from_stage(record.stage(), record.errno()))
}

fn reap_spawn_failure(pid: ProcessId) () {
    // A failed handshake still owns the forked child until wait succeeds.
    while true {
        match wait(pid) {
            !status => {
                _ = status;
                return;
            },
            Errno::Interrupted! => {},
            error! => {
                _ = error;
                return;
            },
        }
    }
}

fn apply_stdio(options: SpawnOptions, stdin_pipe: &mut SpawnPipe, stdout_pipe: &mut SpawnPipe, stderr_pipe: &mut SpawnPipe) Errno!() {
    let mut dev_null: ?types::FileDescriptor = null;
    if options.stdin() == StdIo::Ignore {
        let fd = open_dev_null().?;
        dev_null = ?fd;
        dup_to(fd, types::FileDescriptor::stdin()).?;
    } else if options.stdin() == StdIo::Pipe {
        dup_to(stdin_pipe.read().?, types::FileDescriptor::stdin()).?;
    }
    if options.stdout() == StdIo::Ignore {
        match dev_null {
            ?fd => {
                dup_to(fd, types::FileDescriptor::stdout()).?;
            },
            null => {
                let fd = open_dev_null().?;
                dev_null = ?fd;
                dup_to(fd, types::FileDescriptor::stdout()).?;
            },
        }
    } else if options.stdout() == StdIo::Pipe {
        dup_to(stdout_pipe.write().?, types::FileDescriptor::stdout()).?;
    }
    if options.stderr() == StdIo::Ignore {
        match dev_null {
            ?fd => {
                dup_to(fd, types::FileDescriptor::stderr()).?;
            },
            null => {
                let fd = open_dev_null().?;
                dev_null = ?fd;
                dup_to(fd, types::FileDescriptor::stderr()).?;
            },
        }
    } else if options.stderr() == StdIo::Pipe {
        dup_to(stderr_pipe.write().?, types::FileDescriptor::stderr()).?;
    }
    stdin_pipe.close_all();
    stdout_pipe.close_all();
    stderr_pipe.close_all();
    match dev_null {
        ?fd => {
            fd.close().?;
        },
        null => {},
    }
    !()
}

fn apply_cwd(options: SpawnOptions) Errno!() {
    match options.cwd() {
        ?path => {
            let ret = syscall::syscall1(syscall::chdir, path as usize);
            if ret < 0 {
                ret.syscall_error()!
            } else {
                !()
            }
        },
        null => {
            !()
        },
    }
}

fn open_dev_null() Errno!types::FileDescriptor {
    let path = b"/dev/null\0";
    let ret = syscall::syscall4(
        syscall::openat,
        types::at_fdcwd as usize,
        &path[0] as usize,
        OpenMode::ReadWrite as i32 as usize,
        0usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !types::FileDescriptor::init(ret as i32)
    }
}

fn dup_to(from: types::FileDescriptor, to: types::FileDescriptor) Errno!() {
    let ret = syscall::syscall2(syscall::dup2, from.raw() as usize, to.raw() as usize);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !()
    }
}

pub fn wait(pid: ProcessId) Errno!WaitStatus {
    wait_with_options(pid, 0usize)
}

pub fn try_wait(pid: ProcessId) Errno! ?WaitStatus {
    let mut status: i32 = 0;
    let ret = wait4(pid, &mut status, types::wait_no_hang);
    if ret < 0 {
        ret.syscall_error()!
    } else if ret == 0 {
        !null
    } else {
        !(?WaitStatus::init(status))
    }
}

pub fn kill(pid: ProcessId) Errno!() {
    kill_with(pid, types::sigterm)
}

pub fn kill_with(pid: ProcessId, signal: i32) Errno!() {
    let ret = syscall::syscall2(syscall::kill, pid.raw() as usize, signal as usize);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !()
    }
}

fn wait_with_options(pid: ProcessId, options: usize) Errno!WaitStatus {
    let mut status: i32 = 0;
    let ret = wait4(pid, &mut status, options);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !WaitStatus::init(status)
    }
}

fn wait4(pid: ProcessId, status: &mut i32, options: usize) isize {
    let ret = syscall::syscall4(
        syscall::wait4,
        pid.raw() as usize,
        status as usize,
        options,
        0usize,
    );
    ret
}

pub fn exit(code: i32) () {
    _ = syscall::syscall1(syscall::exit, code as usize);
    loop {}
}

extend SpawnErrorRecord {
    fn init(stage: SpawnStage, errno: Errno) SpawnErrorRecord {
        Self { stage: stage as i32, code: errno as i32 }
    }

    fn stage(&self) SpawnStage {
        self.stage as SpawnStage
    }

    fn errno(&self) Errno {
        Errno::from_code(self.code)
    }
}

extend SpawnPipe {
    fn closed() SpawnPipe {
        Self { read: null, write: null }
    }

    fn init(read: types::FileDescriptor, write: types::FileDescriptor) SpawnPipe {
        Self { read: ?read, write: ?write }
    }

    fn from_pipe(pipe: Pipe) SpawnPipe {
        SpawnPipe::init(pipe.read(), pipe.write())
    }

    fn open_close_on_exec() Errno!SpawnPipe {
        let pipe = linux_fd::pipe_close_on_exec().?;
        !SpawnPipe::from_pipe(pipe)
    }

    fn read(&self) Errno!types::FileDescriptor {
        match self.read {
            ?fd => {
                !fd
            },
            null => {
                Errno::Invalid!
            },
        }
    }

    fn write(&self) Errno!types::FileDescriptor {
        match self.write {
            ?fd => {
                !fd
            },
            null => {
                Errno::Invalid!
            },
        }
    }

    fn take_read(&mut self) ?types::FileDescriptor {
        let fd = self.read;
        self.read = null;
        fd
    }

    fn take_write(&mut self) ?types::FileDescriptor {
        let fd = self.write;
        self.write = null;
        fd
    }

    fn close_read(&mut self) () {
        match self.take_read() {
            ?fd => {
                _ = fd.close();
            },
            null => {},
        }
    }

    fn close_write(&mut self) () {
        match self.take_write() {
            ?fd => {
                _ = fd.close();
            },
            null => {},
        }
    }

    fn close_all(&mut self) () {
        self.close_read();
        self.close_write();
    }
}

extend[T] Errno!T {
    fn as_spawn_setup_error(self) SpawnError!T {
        match self {
            !value => {
                !value
            },
            error! => SpawnError::Setup(error)!,
        }
    }
}
