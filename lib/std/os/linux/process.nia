using pkg::os::linux::syscall;
using pkg::os::linux::types;
using pkg::os::linux::fd as linux_fd;

using types::{Errno, OpenMode, Pipe, ProcessId, SpawnError, SpawnOptions, SpawnResult, SpawnStage, StdIo, WaitStatus};

struct SpawnErrorRecord {
    stage: i32,
    code: i32,
}

pub fn spawn_raw(path: &u8, argv: &&u8, envp: &&u8) SpawnError!ProcessId {
    let result = spawn(path, argv, envp, SpawnOptions::init()).?;
    !result.pid()
}

pub fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnError!SpawnResult {
    var stdin_pipe: ?Pipe = null;
    var stdout_pipe: ?Pipe = null;
    var stderr_pipe: ?Pipe = null;
    var cleanup_stdin_pipe = false;
    var cleanup_stdout_pipe = false;
    var cleanup_stderr_pipe = false;
    defer if cleanup_stdin_pipe {
        close_pipe(stdin_pipe);
    };
    defer if cleanup_stdout_pipe {
        close_pipe(stdout_pipe);
    };
    defer if cleanup_stderr_pipe {
        close_pipe(stderr_pipe);
    };
    if options.stdin() == StdIo::Pipe {
        stdin_pipe = ?linux_fd::pipe_close_on_exec().as_spawn_setup_error().?;
        cleanup_stdin_pipe = true;
    }
    if options.stdout() == StdIo::Pipe {
        stdout_pipe = ?linux_fd::pipe_close_on_exec().as_spawn_setup_error().?;
        cleanup_stdout_pipe = true;
    }
    if options.stderr() == StdIo::Pipe {
        stderr_pipe = ?linux_fd::pipe_close_on_exec().as_spawn_setup_error().?;
        cleanup_stderr_pipe = true;
    }
    let error_pipe = linux_fd::pipe_close_on_exec().as_spawn_setup_error().?;
    var cleanup_error_pipe = true;
    defer if cleanup_error_pipe {
        close_pipe(?error_pipe);
    };
    let ret = syscall::syscall0(syscall::fork);
    if ret < 0 {
        SpawnError::from_errno(ret.syscall_error())!
    } else if ret == 0 {
        _ = error_pipe.read().close();
        if let !ok = apply_stdio(options, stdin_pipe, stdout_pipe, stderr_pipe) {
            _ = ok;
        } else error! {
            write_spawn_error(error_pipe.write(), SpawnStage::Stdio, error);
            exit(127);
        }
        if let !ok = apply_cwd(options) {
            _ = ok;
        } else error! {
            write_spawn_error(error_pipe.write(), SpawnStage::Cwd, error);
            exit(127);
        }
        let exec_ret = syscall::syscall3(syscall::execve, path as usize, argv as usize, envp as usize);
        write_spawn_error(error_pipe.write(), SpawnStage::Exec, exec_ret.syscall_error());
        exit(127);
        SpawnError::Invalid!
    } else {
        close_child_pipe_ends(stdin_pipe, stdout_pipe, stderr_pipe);
        cleanup_error_pipe = false;
        _ = error_pipe.write().close();
        let pid = ProcessId::init(ret as i32);
        if let ?spawn_error = read_spawn_error(error_pipe.read(), pid).? {
            _ = wait(pid);
            spawn_error!
        } else null {
            cleanup_stdin_pipe = false;
            cleanup_stdout_pipe = false;
            cleanup_stderr_pipe = false;
            !SpawnResult::init(
                pid,
                parent_stdin(stdin_pipe),
                parent_stdout(stdout_pipe),
                parent_stderr(stderr_pipe),
            )
        }
    }
}

fn close_pipe(pipe: ?Pipe) void {
    if let ?value = pipe {
        _ = value.read().close();
        _ = value.write().close();
    } else null {}
}

fn close_child_pipe_ends(stdin: ?Pipe, stdout: ?Pipe, stderr: ?Pipe) void {
    if let ?pipe = stdin {
        _ = pipe.read().close();
    } else null {}
    if let ?pipe = stdout {
        _ = pipe.write().close();
    } else null {}
    if let ?pipe = stderr {
        _ = pipe.write().close();
    } else null {}
}

fn parent_stdin(pipe: ?Pipe) ?types::FileDescriptor {
    if let ?value = pipe {
        ?value.write()
    } else null {
        null
    }
}

fn parent_stdout(pipe: ?Pipe) ?types::FileDescriptor {
    if let ?value = pipe {
        ?value.read()
    } else null {
        null
    }
}

fn parent_stderr(pipe: ?Pipe) ?types::FileDescriptor {
    if let ?value = pipe {
        ?value.read()
    } else null {
        null
    }
}

fn write_spawn_error(fd: types::FileDescriptor, stage: SpawnStage, errno: Errno) void {
    var record = SpawnErrorRecord::init(stage, errno);
    var bytes = &mut ((&mut record as &mut u8)[0..@size[SpawnErrorRecord]()]);
    _ = fd.write_some(bytes);
}

fn read_spawn_error(fd: types::FileDescriptor, pid: ProcessId) SpawnError! ?SpawnError {
    defer _ = fd.close();
    var record = SpawnErrorRecord::init(SpawnStage::Setup, Errno::Io);
    var bytes = &mut ((&mut record as &mut u8)[0..@size[SpawnErrorRecord]()]);
    var read_len = 0usize;
    while read_len < bytes.len() {
        let amount = fd.read_some(&mut bytes[read_len..]).as_spawn_setup_error().?;
        if amount == 0usize {
            if read_len == 0usize {
                return !null;
            }
            _ = wait(pid);
            return SpawnError::Io!;
        }
        read_len += amount;
    }
    !(?SpawnError::from_stage(record.stage(), record.errno()))
}

fn apply_stdio(options: SpawnOptions, stdin_pipe: ?Pipe, stdout_pipe: ?Pipe, stderr_pipe: ?Pipe) Errno!void {
    var dev_null: ?types::FileDescriptor = null;
    if options.stdin() == StdIo::Ignore {
        dev_null = ?open_dev_null().?;
        dup_to(dev_null, types::FileDescriptor::stdin()).?;
    } else if options.stdin() == StdIo::Pipe {
        dup_to(pipe_read(stdin_pipe), types::FileDescriptor::stdin()).?;
    }
    if options.stdout() == StdIo::Ignore {
        if let ?fd = dev_null {
            dup_to(?fd, types::FileDescriptor::stdout()).?;
        } else null {
            dev_null = ?open_dev_null().?;
            dup_to(dev_null, types::FileDescriptor::stdout()).?;
        }
    } else if options.stdout() == StdIo::Pipe {
        dup_to(pipe_write(stdout_pipe), types::FileDescriptor::stdout()).?;
    }
    if options.stderr() == StdIo::Ignore {
        if let ?fd = dev_null {
            dup_to(?fd, types::FileDescriptor::stderr()).?;
        } else null {
            dev_null = ?open_dev_null().?;
            dup_to(dev_null, types::FileDescriptor::stderr()).?;
        }
    } else if options.stderr() == StdIo::Pipe {
        dup_to(pipe_write(stderr_pipe), types::FileDescriptor::stderr()).?;
    }
    close_pipe(stdin_pipe);
    close_pipe(stdout_pipe);
    close_pipe(stderr_pipe);
    if let ?fd = dev_null {
        fd.close().?;
    } else null {}
    !{}
}

fn pipe_read(pipe: ?Pipe) ?types::FileDescriptor {
    if let ?value = pipe {
        ?value.read()
    } else null {
        null
    }
}

fn pipe_write(pipe: ?Pipe) ?types::FileDescriptor {
    if let ?value = pipe {
        ?value.write()
    } else null {
        null
    }
}

fn apply_cwd(options: SpawnOptions) Errno!void {
    if let ?path = options.cwd() {
        let ret = syscall::syscall1(syscall::chdir, path as usize);
        if ret < 0 {
            ret.syscall_error()!
        } else {
            !{}
        }
    } else null {
        !{}
    }
}

fn open_dev_null() Errno!types::FileDescriptor {
    let path = b"/dev/null\0";
    let ret = syscall::syscall4(
        syscall::openat,
        types::at_fdcwd as usize,
        &path.*[0] as usize,
        OpenMode::ReadWrite as i32 as usize,
        0usize,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !types::FileDescriptor::init(ret as i32)
    }
}

fn dup_to(from: ?types::FileDescriptor, to: types::FileDescriptor) Errno!void {
    let fd = if let ?value = from {
        value
    } else null {
        return Errno::Invalid!;
    };
    let ret = syscall::syscall2(syscall::dup2, fd.raw() as usize, to.raw() as usize);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

pub fn wait(pid: ProcessId) Errno!WaitStatus {
    wait_with_options(pid, 0usize)
}

pub fn try_wait(pid: ProcessId) Errno! ?WaitStatus {
    var status: i32 = 0;
    let ret = wait4(pid, &mut status, types::wait_no_hang);
    if ret < 0 {
        ret.syscall_error()!
    } else if ret == 0 {
        !null
    } else {
        !(?WaitStatus::init(status))
    }
}

pub fn kill(pid: ProcessId) Errno!void {
    kill_with(pid, types::sigterm)
}

pub fn kill_with(pid: ProcessId, signal: i32) Errno!void {
    let ret = syscall::syscall2(syscall::kill, pid.raw() as usize, signal as usize);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !{}
    }
}

fn wait_with_options(pid: ProcessId, options: usize) Errno!WaitStatus {
    var status: i32 = 0;
    let ret = wait4(pid, &mut status, options);
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !WaitStatus::init(status)
    }
}

fn wait4(pid: ProcessId, status: &mut i32, options: usize) isize {
    let ret = syscall::syscall4(
        syscall::wait4,
        pid.raw() as usize,
        status as usize,
        options,
        0usize,
    );
    ret
}

pub fn exit(code: i32) void {
    _ = syscall::syscall1(syscall::exit, code as usize);
    loop {}
}

extend SpawnErrorRecord {
    fn init(stage: SpawnStage, errno: Errno) SpawnErrorRecord {
        { stage: stage as i32, code: errno as i32 }
    }

    fn stage(&self) SpawnStage {
        self.stage as SpawnStage
    }

    fn errno(&self) Errno {
        Errno::from_code(self.code)
    }
}

extend[T] Errno!T {
    fn as_spawn_setup_error(self) SpawnError!T {
        if let !value = self {
            !value
        } else error! {
            SpawnError::from_errno(error)!
        }
    }
}
