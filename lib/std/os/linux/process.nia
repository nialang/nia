using pkg::os::linux::syscall;
using pkg::os::linux::types;
using pkg::os::linux::fd as linuxFd;

using types::{Errno, OpenMode, Pipe, ProcessId, SpawnAttempt, SpawnError, SpawnOptions, SpawnResult, SpawnStage, StdIo, WaitStatus};

struct SpawnPipe {
    read: ?types::FileDescriptor,
    write: ?types::FileDescriptor,
}

struct SpawnResources {
    stdin: SpawnPipe,
    stdout: SpawnPipe,
    stderr: SpawnPipe,
    error: SpawnPipe,
}

struct SpawnErrorRecord {
    stage: i32,
    code: i32,
}

pub fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    let mut resources: SpawnResources = .init();
    let result = spawnWithResources(path, argv, envp, options, &mut resources);
    resources.closeAll();
    result
}

fn spawnWithResources(
    path: &u8,
    argv: &&u8,
    envp: &&u8,
    options: SpawnOptions,
    resources: &mut SpawnResources,
) SpawnAttempt {
    if options.stdin() == StdIo::Pipe {
        resources.stdin = match SpawnPipe::openCloseOnExec() {
            !pipe => pipe,
            error! => return .failure(.Setup(error)),
        };
    }
    if options.stdout() == StdIo::Pipe {
        resources.stdout = match SpawnPipe::openCloseOnExec() {
            !pipe => pipe,
            error! => return .failure(.Setup(error)),
        };
    }
    if options.stderr() == StdIo::Pipe {
        resources.stderr = match SpawnPipe::openCloseOnExec() {
            !pipe => pipe,
            error! => return .failure(.Setup(error)),
        };
    }
    resources.error = match SpawnPipe::openCloseOnExec() {
        !pipe => pipe,
        error! => return .failure(.Setup(error)),
    };
    let ret = syscall::syscall0(syscall::fork);
    if ret < 0 {
        .failure(.Setup(ret.syscallError()))
    } else if ret == 0 {
        resources.error.closeRead();
        if applyStdio(options, &mut resources.stdin, &mut resources.stdout, &mut resources.stderr) is error! {
            reportSpawnError(&resources.error, .Stdio, error);
            exit(127);
        }
        if applyCwd(options) is error! {
            reportSpawnError(&resources.error, .Cwd, error);
            exit(127);
        }
        let execRet = syscall::syscall3(syscall::execve, path as usize, argv as usize, envp as usize);
        reportSpawnError(&resources.error, .Exec, execRet.syscallError());
        exit(127);
        .failure(.Setup(.Io))
    } else {
        resources.stdin.closeRead();
        resources.stdout.closeWrite();
        resources.stderr.closeWrite();
        resources.error.closeWrite();
        let pid = match ProcessId::fromSyscall(ret) {
            !pid => pid,
            error! => return .failure(.Setup(error)),
        };
        let errorRead = if resources.error.takeRead() is ?fd {
            fd
        } else {
            return failedSpawnAttempt(pid, .Setup(.Io));
        };
        match readSpawnError(errorRead) {
            !(?spawnError) => {
                failedSpawnAttempt(pid, spawnError)
            },
            !null => {
                .success(.init(
                    pid,
                    resources.stdin.takeWrite(),
                    resources.stdout.takeRead(),
                    resources.stderr.takeRead(),
                ))
            },
            error! => {
                failedSpawnAttempt(pid, error)
            },
        }
    }
}

fn failedSpawnAttempt(pid: ProcessId, error: SpawnError) SpawnAttempt {
    if reapSpawnFailure(pid) is reapError! {
        return .reapFailure(error, pid, reapError);
    }
    .failure(error)
}

fn reportSpawnError(pipe: &SpawnPipe, stage: SpawnStage, errno: Errno) () {
    if pipe.write() is !fd {
        writeSpawnError(fd, stage, errno);
    } else {
        exit(127);
    }
}

fn writeSpawnError(fd: types::FileDescriptor, stage: SpawnStage, errno: Errno) () {
    let mut record: SpawnErrorRecord = .init(stage, errno);
    let mut bytes = &mut ((&mut record as &mut u8)[0..std::builtin::size[SpawnErrorRecord]()]);
    let mut written: usize = 0;
    // The parent treats EOF before a record as successful close-on-exec.
    while written < bytes.len() {
        match fd.writeSome(&bytes[written..]) {
            !amount => {
                if amount == 0 {
                    return;
                }
                written += amount;
            },
            .Interrupted! => {},
            error! => {
                return;
            },
        }
    }
}

fn readSpawnError(fd: types::FileDescriptor) SpawnError! ?SpawnError {
    let mut record: SpawnErrorRecord = .init(.Setup, .Io);
    let mut bytes = &mut ((&mut record as &mut u8)[0..std::builtin::size[SpawnErrorRecord]()]);
    let mut readLen: usize = 0;
    while readLen < bytes.len() {
        let amount = match fd.readSome(&mut bytes[readLen..]) {
            !amount => {
                amount
            },
            .Interrupted! => {
                continue;
            },
            error! => {
                return finishSpawnError(fd, .Setup(error)!);
            },
        };
        if amount == 0 {
            if readLen == 0 {
                return finishSpawnError(fd, !null);
            }
            return finishSpawnError(fd, .Setup(.Io)!);
        }
        readLen += amount;
    }
    finishSpawnError(fd, !(?SpawnError::fromStage(record.stage(), record.errno())))
}

fn finishSpawnError(
    fd: types::FileDescriptor,
    result: SpawnError! ?SpawnError,
) SpawnError! ?SpawnError {
    match result {
        !value => {
            match fd.close() {
                !ok => {
                    _ = ok;
                    !value
                },
                error! => {
                    .Setup(error)!
                },
            }
        },
        error! => {
            _ = fd.close();
            error!
        },
    }
}

fn reapSpawnFailure(pid: ProcessId) Errno!() {
    // A failed handshake still owns the forked child until wait succeeds.
    while true {
        match wait(pid) {
            !status => {
                _ = status;
                return !();
            },
            .Interrupted! => {},
            .NoChild! => {
                // The kernel confirms that no waitable child owner remains.
                return !();
            },
            error! => {
                return error!;
            },
        }
    }
    !()
}

extend SpawnAttempt {
    pub fn finish(&mut self) SpawnError!SpawnResult {
        if self.pendingReap is ?pid {
            if self.pendingReapError is ?cause {
                self.pendingReapError = null;
                return self.reapError(pid, cause)!;
            }
            if reapSpawnFailure(pid) is cause! {
                return self.reapError(pid, cause)!;
            }
            self.pendingReap = null;
        }
        match self.result {
            ?result => {
                self.result = null;
                !result
            },
            null => {
                let error = match self.error {
                    ?cause => cause,
                    null => .Setup(.Invalid),
                };
                self.error = null;
                error!
            },
        }
    }

    fn reapError(&self, pid: ProcessId, cause: Errno) SpawnError {
        let primary = match self.error {
            ?error => error,
            null => .Setup(.Invalid),
        };
        .Reap {
            stage: primary.stage(),
            primary: primary.primary(),
            cause: cause,
            pid: pid,
        }
    }
}

fn applyStdio(options: SpawnOptions, stdinPipe: &mut SpawnPipe, stdoutPipe: &mut SpawnPipe, stderrPipe: &mut SpawnPipe) Errno!() {
    let mut devNull: ?types::FileDescriptor = null;
    if options.stdin() == StdIo::Ignore {
        let fd = openDevNull().?;
        devNull = ?fd;
        dupTo(fd, types::FileDescriptor::stdin()).?;
    } else if options.stdin() == StdIo::Pipe {
        dupTo(stdinPipe.read().?, types::FileDescriptor::stdin()).?;
    }
    if options.stdout() == StdIo::Ignore {
        match devNull {
            ?fd => {
                dupTo(fd, types::FileDescriptor::stdout()).?;
            },
            null => {
                let fd = openDevNull().?;
                devNull = ?fd;
                dupTo(fd, types::FileDescriptor::stdout()).?;
            },
        }
    } else if options.stdout() == StdIo::Pipe {
        dupTo(stdoutPipe.write().?, types::FileDescriptor::stdout()).?;
    }
    if options.stderr() == StdIo::Ignore {
        match devNull {
            ?fd => {
                dupTo(fd, types::FileDescriptor::stderr()).?;
            },
            null => {
                let fd = openDevNull().?;
                devNull = ?fd;
                dupTo(fd, types::FileDescriptor::stderr()).?;
            },
        }
    } else if options.stderr() == StdIo::Pipe {
        dupTo(stderrPipe.write().?, types::FileDescriptor::stderr()).?;
    }
    stdinPipe.closeAllExcept(options);
    stdoutPipe.closeAllExcept(options);
    stderrPipe.closeAllExcept(options);
    if devNull is ?fd {
        if not isStandardTarget(fd, options) {
            fd.close().?;
        }
    }
    !()
}

fn applyCwd(options: SpawnOptions) Errno!() {
    if options.cwd() is ?path {
        let ret = syscall::syscall1(syscall::chdir, path as usize);
        ret.syscallSuccess()
    } else {
        !()
    }
}

fn openDevNull() Errno!types::FileDescriptor {
    let path = b"/dev/null\0";
    let ret = syscall::syscall4(
        syscall::openat,
        types::atFdCwd as usize,
        &path[0] as usize,
        OpenMode::ReadWrite as i32 as usize,
        0,
    );
    if ret < 0 {
        ret.syscallError()!
    } else {
        !types::FileDescriptor::fromSyscall(ret).?
    }
}

fn dupTo(from: types::FileDescriptor, to: types::FileDescriptor) Errno!() {
    let ret = syscall::syscall2(syscall::dup2, from.raw() as usize, to.raw() as usize);
    if ret < 0 {
        ret.syscallError()!
    } else if ret != to.raw() as isize {
        .Io!
    } else {
        !()
    }
}

pub fn wait(pid: ProcessId) Errno!WaitStatus {
    waitWithOptions(pid, 0)
}

pub fn tryWait(pid: ProcessId) Errno! ?WaitStatus {
    let mut status: i32 = 0;
    let ret = wait4(pid, &mut status, types::waitNoHang);
    if ret < 0 {
        ret.syscallError()!
    } else if ret == 0 {
        !null
    } else if ret != pid.raw() as isize {
        .Io!
    } else {
        !(?.init(status))
    }
}

pub fn kill(pid: ProcessId) Errno!() {
    killWith(pid, types::sigTerm)
}

pub fn killWith(pid: ProcessId, signal: i32) Errno!() {
    let ret = syscall::syscall2(syscall::kill, pid.raw() as usize, signal as usize);
    ret.syscallSuccess()
}

fn waitWithOptions(pid: ProcessId, options: usize) Errno!WaitStatus {
    let mut status: i32 = 0;
    let ret = wait4(pid, &mut status, options);
    if ret < 0 {
        ret.syscallError()!
    } else if ret != pid.raw() as isize {
        .Io!
    } else {
        !.init(status)
    }
}

fn wait4(pid: ProcessId, status: &mut i32, options: usize) isize {
    let ret = syscall::syscall4(
        syscall::wait4,
        pid.raw() as usize,
        status as usize,
        options,
        0,
    );
    ret
}

pub fn exit(code: i32) () {
    _ = syscall::syscall1(syscall::exit, code as usize);
    loop {}
}

extend SpawnErrorRecord {
    fn init(stage: SpawnStage, errno: Errno) SpawnErrorRecord {
        .{ stage: stage as i32, code: errno as i32 }
    }

    fn stage(&self) SpawnStage {
        self.stage as SpawnStage
    }

    fn errno(&self) Errno {
        Errno::fromCode(self.code)
    }
}

extend SpawnPipe {
    fn closed() SpawnPipe {
        .{ read: null, write: null }
    }

    fn init(read: types::FileDescriptor, write: types::FileDescriptor) SpawnPipe {
        .{ read: ?read, write: ?write }
    }

    fn fromPipe(pipe: Pipe) SpawnPipe {
        .init(pipe.read(), pipe.write())
    }

    fn openCloseOnExec() Errno!SpawnPipe {
        let pipe = linuxFd::pipeCloseOnExec().?;
        !SpawnPipe::fromPipe(pipe)
    }

    fn read(&self) Errno!types::FileDescriptor {
        if self.read is ?fd { !fd } else { .Invalid! }
    }

    fn write(&self) Errno!types::FileDescriptor {
        if self.write is ?fd { !fd } else { .Invalid! }
    }

    fn takeRead(&mut self) ?types::FileDescriptor {
        let fd = self.read;
        self.read = null;
        fd
    }

    fn takeWrite(&mut self) ?types::FileDescriptor {
        let fd = self.write;
        self.write = null;
        fd
    }

    fn closeRead(&mut self) () {
        if self.takeRead() is ?fd {
            _ = fd.close();
        }
    }

    fn closeWrite(&mut self) () {
        if self.takeWrite() is ?fd {
            _ = fd.close();
        }
    }

    fn closeAll(&mut self) () {
        self.closeRead();
        self.closeWrite();
    }

    fn closeAllExcept(&mut self, options: SpawnOptions) () {
        if self.takeRead() is ?fd {
            if not isStandardTarget(fd, options) {
                _ = fd.close();
            }
        }
        if self.takeWrite() is ?fd {
            if not isStandardTarget(fd, options) {
                _ = fd.close();
            }
        }
    }
}

fn isStandardTarget(fd: types::FileDescriptor, options: SpawnOptions) bool {
    (options.stdin() != StdIo::Inherit and fd.raw() == 0)
        or (options.stdout() != StdIo::Inherit and fd.raw() == 1)
        or (options.stderr() != StdIo::Inherit and fd.raw() == 2)
}

extend SpawnResources {
    fn init() SpawnResources {
        .{
            stdin: .closed(),
            stdout: .closed(),
            stderr: .closed(),
            error: .closed(),
        }
    }

    fn closeAll(&mut self) () {
        self.stdin.closeAll();
        self.stdout.closeAll();
        self.stderr.closeAll();
        self.error.closeAll();
    }
}
