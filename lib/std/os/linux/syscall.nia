@[if arch == "x86_64"]
using root::os::linux::x86_64::syscall as platform;
@[if arch == "x86"]
using root::os::linux::x86::syscall as platform;
@[if arch == "aarch64"]
using root::os::linux::aarch64::syscall as platform;

pub using platform::{
    chdir,
    clock_gettime,
    close,
    dup3,
    execve,
    fdatasync,
    fchmod,
    clone,
    fcntl,
    ftruncate,
    getdents64,
    getcwd,
    getrandom,
    kill,
    fsync,
    lseek,
    mkdirat,
    mmap,
    munmap,
    openat,
    openat2,
    pipe2,
    read,
    renameat,
    statx,
    wait4,
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6,
    unlinkat,
    write,
};

// Linux terminates the calling thread with exit and the whole thread group
// with exit_group. std::process::exit uses the latter.
pub using platform::{exit, exit_group};
