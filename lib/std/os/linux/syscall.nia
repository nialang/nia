comptime if @builtin().target.arch == "x86_64" {
    using std::os::linux::x86_64::syscall as platform;
}

pub using platform::{
    close,
    fdatasync,
    exit,
    ftruncate,
    getdents64,
    getrandom,
    fsync,
    lseek,
    mkdirat,
    mmap,
    munmap,
    openat,
    read,
    renameat,
    statx,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6,
    unlinkat,
    write,
};
