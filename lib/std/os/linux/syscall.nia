comptime if @builtin().target.arch == "x86_64" {
    import std.os.linux.x86_64.syscall as platform;
}

pub using platform::{
    close,
    exit,
    mkdirat,
    mmap,
    munmap,
    openat,
    read,
    renameat,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall6,
    unlinkat,
    write,
};
