using pkg::math;
using pkg::os::linux::syscall;
using pkg::os::linux::types;

using types::Errno;

const nativePageSize: usize = 4096;

pub struct MappedPages {
    ptr: &mut u8,
    releasePtr: &mut u8,
    releaseSize: usize,
}

extend MappedPages {
    pub fn ptr(&self) &mut u8 {
        self.ptr
    }

    pub fn releasePtr(&self) &mut u8 {
        self.releasePtr
    }

    pub fn releaseSize(&self) usize {
        self.releaseSize
    }
}

fn rawMapPages(len: usize) Errno!&mut u8 {
    let protReadWrite: usize = 3;
    let privateAnonymous: usize = 34;
    let ret = syscall::syscall6(
        syscall::mmap,
        0,
        len,
        protReadWrite,
        privateAnonymous,
        (-1) as usize,
        0,
    );
    // i686 mmap pointers may have the sign bit set; only the Linux errno
    // range denotes failure for a syscall result.
    if ret < 0 and ret >= -4095 {
        ret.syscallError()!
    } else if ret == 0 {
        Errno::Io!
    } else {
        !((ret as usize) as &mut u8)
    }
}

fn rawUnmapPages(ptr: &mut u8, len: usize) Errno!() {
    let ret = syscall::syscall3(syscall::munmap, ptr as usize, len, 0);
    ret.syscallSuccess()
}

// A mapping remains owned until validation publishes MappedPages.
fn rejectMappedRange(ptr: &mut u8, len: usize) Errno!MappedPages {
    rawUnmapPages(ptr, len).?;
    Errno::OutOfRange!
}

pub fn pageSize() usize {
    nativePageSize
}

pub fn pageAlignedLen(len: usize) Errno!usize {
    if len.alignForward(pageSize()) is ?value {
        return !value;
    }
    Errno::OutOfRange!
}

pub fn mapPages(len: usize, align: usize) Errno!MappedPages {
    if len == 0 {
        return Errno::Invalid!;
    }
    if align == 0 or not align.isPowerOfTwo() {
        return Errno::Invalid!;
    }

    let alignedLen = pageAlignedLen(len).?;
    let mut extra: usize = 0;
    if align > pageSize() {
        extra = align - pageSize();
    }
    let mapLen = match alignedLen.checkedAdd(extra) {
        ?value => {
            value
        },
        null => {
            return Errno::OutOfRange!;
        },
    };
    let mapped = rawMapPages(mapLen).?;
    let mappedAddr = mapped as usize;
    if mappedAddr.checkedAdd(mapLen) is null {
        return rejectMappedRange(mapped, mapLen);
    }
    let resultAddr = match mappedAddr.alignForward(align) {
        ?value => value,
        null => {
            return rejectMappedRange(mapped, mapLen);
        },
    };
    !MappedPages {
        ptr: resultAddr as &mut u8,
        releasePtr: mapped,
        releaseSize: mapLen,
    }
}

pub fn unmapPages(ptr: &mut u8, len: usize) Errno!() {
    if len == 0 {
        Errno::Invalid!
    } else {
        let alignedLen = pageAlignedLen(len).?;
        rawUnmapPages(ptr, alignedLen)
    }
}
