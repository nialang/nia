using pkg::math;
using pkg::os::linux::syscall;
using pkg::os::linux::types;

using types::Errno;

const native_page_size: usize = 4096usize;

fn raw_map_pages(len: usize) Errno!&mut u8 {
    let prot_read_write = 3usize;
    let private_anonymous = 34usize;
    let ret = syscall::syscall6(
        syscall::mmap,
        0,
        len,
        prot_read_write,
        private_anonymous,
        (-1isize) as usize,
        0,
    );
    if ret < 0 {
        ret.syscall_error()!
    } else {
        !((ret as usize) as &mut u8)
    }
}

fn raw_unmap_pages(ptr: &mut u8, len: usize) Errno!() {
    let ret = syscall::syscall3(syscall::munmap, ptr as usize, len, 0);
    ret.syscall_success()
}

pub fn page_size() usize {
    native_page_size
}

pub fn page_aligned_len(len: usize) Errno!usize {
    match len.align_forward(page_size()) {
        ?value => {
            !value
        },
        null => {
            Errno::OutOfRange!
        },
    }
}

pub fn map_pages(len: usize, align: usize) Errno!&mut u8 {
    if len == 0 {
        return Errno::Invalid!;
    }
    if align == 0 or not align.is_power_of_two() {
        return Errno::Invalid!;
    }

    let aligned_len = page_aligned_len(len).?;
    let mut extra = 0usize;
    if align > page_size() {
        extra = align - page_size();
    }
    let map_len = match aligned_len.checked_add(extra) {
        ?value => {
            value
        },
        null => {
            return Errno::OutOfRange!;
        },
    };
    let mapped = raw_map_pages(map_len).?;
    let mapped_addr = mapped as usize;
    match mapped_addr.checked_add(map_len) {
        ?value => {
            _ = value;
        },
        null => {
            match raw_unmap_pages(mapped, map_len) {
                !ok => {
                    _ = ok;
                },
                error! => {},
            }
            return Errno::OutOfRange!;
        },
    }
    let mut result_addr: usize;
    match mapped_addr.align_forward(align) {
        ?value => {
            result_addr = value;
        },
        null => {
                match raw_unmap_pages(mapped, map_len) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {},
                }
                return Errno::OutOfRange!;
        },
    }

    let drop_len = result_addr - mapped_addr;
    if drop_len != 0 {
        raw_unmap_pages(mapped, drop_len).?;
    }

    let remaining_len = map_len - drop_len;
    if remaining_len > aligned_len {
        let suffixAddr = match result_addr.checked_add(aligned_len) {
            ?value => value,
            null => {
                match raw_unmap_pages(mapped, map_len) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {},
                }
                return Errno::OutOfRange!;
            },
        };
        let suffix = suffixAddr as &mut u8;
        raw_unmap_pages(suffix, remaining_len - aligned_len).?;
    }

    !(result_addr as &mut u8)
}

pub fn unmap_pages(ptr: &mut u8, len: usize) Errno!() {
    if len == 0 {
        Errno::Invalid!
    } else {
        let aligned_len = page_aligned_len(len).?;
        raw_unmap_pages(ptr, aligned_len)
    }
}
