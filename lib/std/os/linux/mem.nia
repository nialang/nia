using pkg::math;
using pkg::os::linux::syscall;
using pkg::os::linux::types;

using types::Errno;

const native_page_size: usize = 4096usize;

pub struct MappedPages {
    ptr: &mut u8,
    releasePtr: &mut u8,
    releaseSize: usize,
}

extend MappedPages {
    pub fn ptr(&self) &mut u8 {
        self.ptr
    }

    pub fn releasePtr(&self) &mut u8 {
        self.releasePtr
    }

    pub fn releaseSize(&self) usize {
        self.releaseSize
    }
}

fn raw_map_pages(len: usize) Errno!&mut u8 {
    let prot_read_write = 3usize;
    let private_anonymous = 34usize;
    let ret = syscall::syscall6(
        syscall::mmap,
        0,
        len,
        prot_read_write,
        private_anonymous,
        (-1isize) as usize,
        0,
    );
    // i686 mmap pointers may have the sign bit set; only the Linux errno
    // range denotes failure for a syscall result.
    if ret < 0isize and ret >= -4095isize {
        ret.syscall_error()!
    } else if ret == 0isize {
        Errno::Io!
    } else {
        !((ret as usize) as &mut u8)
    }
}

fn raw_unmap_pages(ptr: &mut u8, len: usize) Errno!() {
    let ret = syscall::syscall3(syscall::munmap, ptr as usize, len, 0);
    ret.syscall_success()
}

// A mapping remains owned until validation publishes MappedPages.
fn reject_mapped_range(ptr: &mut u8, len: usize) Errno!MappedPages {
    raw_unmap_pages(ptr, len).?;
    Errno::OutOfRange!
}

pub fn page_size() usize {
    native_page_size
}

pub fn page_aligned_len(len: usize) Errno!usize {
    match len.alignForward(page_size()) {
        ?value => {
            !value
        },
        null => {
            Errno::OutOfRange!
        },
    }
}

pub fn map_pages(len: usize, align: usize) Errno!MappedPages {
    if len == 0 {
        return Errno::Invalid!;
    }
    if align == 0 or not align.isPowerOfTwo() {
        return Errno::Invalid!;
    }

    let aligned_len = page_aligned_len(len).?;
    let mut extra = 0usize;
    if align > page_size() {
        extra = align - page_size();
    }
    let map_len = match aligned_len.checkedAdd(extra) {
        ?value => {
            value
        },
        null => {
            return Errno::OutOfRange!;
        },
    };
    let mapped = raw_map_pages(map_len).?;
    let mapped_addr = mapped as usize;
    match mapped_addr.checkedAdd(map_len) {
        ?value => { _ = value; },
        null => {
            return reject_mapped_range(mapped, map_len);
        },
    }
    let result_addr = match mapped_addr.alignForward(align) {
        ?value => value,
        null => {
            return reject_mapped_range(mapped, map_len);
        },
    };
    !MappedPages {
        ptr: result_addr as &mut u8,
        releasePtr: mapped,
        releaseSize: map_len,
    }
}

pub fn unmap_pages(ptr: &mut u8, len: usize) Errno!() {
    if len == 0 {
        Errno::Invalid!
    } else {
        let aligned_len = page_aligned_len(len).?;
        raw_unmap_pages(ptr, aligned_len)
    }
}
