using root::math;
using root::os::linux::syscall;
using root::os::linux::types;
using root::option;

using types::Errno;

const nativePageSize: usize = 4096;

pub struct MappedPages {
    ptr: &mut u8,
    releasePtr: &mut u8,
    releaseSize: usize,
}

extend MappedPages {
    pub fun ptr(&self) &mut u8 {
        self.ptr
    }

    pub fun releasePtr(&self) &mut u8 {
        self.releasePtr
    }

    pub fun releaseSize(&self) usize {
        self.releaseSize
    }
}

fun rawMapPages(len: usize) Errno!&mut u8 {
    let protReadWrite: usize = 3;
    let privateAnonymous: usize = 34;
    let ret = syscall::syscall6(
        syscall::mmap,
        0,
        len,
        protReadWrite,
        privateAnonymous,
        (-1) as usize,
        0,
    );
    // i686 mmap pointers may have the sign bit set; only the Linux errno
    // range denotes failure for a syscall result.
    if ret < 0 and ret >= -4095 {
        ret.syscallError()!
    } else if ret == 0 {
        .Io!
    } else {
        !((ret as usize) as &mut u8)
    }
}

fun rawUnmapPages(ptr: &mut u8, len: usize) Errno!() {
    let ret = syscall::syscall3(syscall::munmap, ptr as usize, len, 0);
    ret.syscallSuccess()
}

// A mapping remains owned until validation publishes MappedPages.
fun rejectMappedRange(ptr: &mut u8, len: usize) Errno!MappedPages {
    rawUnmapPages(ptr, len).?;
    .OutOfRange!
}

pub fun pageSize() usize {
    nativePageSize
}

pub fun pageAlignedLen(len: usize) Errno!usize {
    if len.alignForward(pageSize()) is ?value {
        return !value;
    }
    .OutOfRange!
}

pub fun mapPages(len: usize, align: usize) Errno!MappedPages {
    if len == 0 {
        return .Invalid!;
    }
    if align == 0 or not align.isPowerOfTwo() {
        return .Invalid!;
    }

    let alignedLen = pageAlignedLen(len).?;
    let mut extra: usize = 0;
    if align > pageSize() {
        extra = align - pageSize();
    }
    let mapLen = alignedLen.checkedAdd(extra).okOr(Errno::OutOfRange).?;
    let mapped = rawMapPages(mapLen).?;
    let mappedAddr = mapped as usize;
    if mappedAddr.checkedAdd(mapLen) is null {
        return rejectMappedRange(mapped, mapLen);
    }
    let resultAddr = match mappedAddr.alignForward(align) {
        ?value => value,
        null => {
            return rejectMappedRange(mapped, mapLen);
        },
    };
    !.{
        ptr: resultAddr as &mut u8,
        releasePtr: mapped,
        releaseSize: mapLen,
    }
}

pub fun unmapPages(ptr: &mut u8, len: usize) Errno!() {
    if len == 0 {
        .Invalid!
    } else {
        let alignedLen = pageAlignedLen(len).?;
        rawUnmapPages(ptr, alignedLen)
    }
}
