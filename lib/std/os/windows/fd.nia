using pkg::os::windows::bindings::{
    invalidHandle,
    errorBrokenPipe,
    errorHandleEof,
    GetLastError,
    stdInputHandle,
    stdOutputHandle,
    stdErrorHandle,
    fileFlagBackupSemantics,
    fileFlagOpenReparsePoint,
    genericRead,
    genericWrite,
    fileShareRead,
    fileShareWrite,
    fileShareDelete,
    createNew,
    createAlways,
    openExisting,
    openAlways,
    truncateExisting,
    fileBegin,
    fileCurrent,
    fileEnd,
    fileAttributeReadonly,
    GetStdHandle,
    WriteFile,
    ReadFile,
    CloseHandle,
    SetFilePointerEx,
    SetFileInformationByHandle,
    FileEndOfFileInfo,
    fileEndOfFileInfo,
    FlushFileBuffers,
    GetCurrentDirectoryW,
    GetFileAttributesW,
    SetFileAttributesW,
    invalidFileAttributes,
    maxPathUnits,
    CreateFileW,
    CreateDirectoryW,
    DeleteFileW,
    RemoveDirectoryW,
    MoveFileExW,
};
using pkg::os::windows::types::{
    Errno,
    OpenMode,
    SeekWhence,
    FileMetadata,
    FileDescriptor,
};
using pkg::os::windows::error::{
    lastError,
    errno,
};
using pkg::os::windows::path::{
    pathFromHandle,
    handlePath,
    handlePathLength,
    isPathWithin,
    joinPath,
};
using pkg::os::windows::encoding::{
    wideToUtf8,
};
using pkg::os::windows::stat::{
    metadataHandle,
};

extend FileDescriptor {
    pub fun init(handle: usize) FileDescriptor { .{ handle } }
    pub fun stdin() FileDescriptor { .init(GetStdHandle(stdInputHandle)) }
    pub fun stdout() FileDescriptor { .init(GetStdHandle(stdOutputHandle)) }
    pub fun stderr() FileDescriptor { .init(GetStdHandle(stdErrorHandle)) }
    pub fun raw(&self) usize { self.handle }

    pub fun writeSome(&self, bytes: &[u8]) Errno!usize {
        if bytes.len() > u32::MAX as usize { return .OutOfRange!; }
        let mut written: u32 = 0;
        if WriteFile(self.handle, bytes.ptr(), bytes.len() as u32, &mut written, 0) == 0 {
            return lastError()!;
        }
        !(written as usize)
    }

    pub fun readSome(&self, bytes: &mut [u8]) Errno!usize {
        if bytes.len() > u32::MAX as usize { return .OutOfRange!; }
        let mut read: u32 = 0;
        if ReadFile(self.handle, bytes.ptrMut(), bytes.len() as u32, &mut read, 0) == 0 {
            let code = GetLastError();
            if code == errorBrokenPipe or code == errorHandleEof { return !0; }
            return errno(code)!;
        }
        !(read as usize)
    }

    pub fun close(&self) Errno!() {
        if self.handle == 0 or self.handle == invalidHandle { return .BadFd!; }
        if CloseHandle(self.handle) == 0 { return lastError()!; }
        !()
    }

    pub fun seek(&self, offset: i64, whence: SeekWhence) Errno!u64 {
        let method = match whence { .Start => fileBegin, .Current => fileCurrent, .End => fileEnd, _ => return .Invalid!, };
        let mut position: i64 = 0;
        if SetFilePointerEx(self.handle, offset, &mut position, method) == 0 { return lastError()!; }
        if position < 0 { return .OutOfRange!; }
        !(position as u64)
    }

    pub fun truncate(&self, len: u64) Errno!() {
        if len > i64::MAX as u64 { return .OutOfRange!; }
        let info: FileEndOfFileInfo = .{ endOfFile: len as i64 };
        if SetFileInformationByHandle(
            self.handle, fileEndOfFileInfo, (&info) as usize,
            pkg::builtin::size[FileEndOfFileInfo]() as u32,
        ) == 0 { return lastError()!; }
        !()
    }

    pub fun setPermissions(&self, permissions: u32) Errno!() {
        let mut storage: [u16; maxPathUnits] = [0; maxPathUnits];
        let path = handlePath(self.handle, &mut storage[..]).?;
        let mut attributes = GetFileAttributesW(path);
        if attributes == invalidFileAttributes { return lastError()!; }
        if (permissions & 0o222) == 0 { attributes = attributes | fileAttributeReadonly; }
        else { attributes = attributes & 0xfffffffe; }
        if SetFileAttributesW(path, attributes) == 0 { return lastError()!; }
        !()
    }
    pub fun sync(&self) Errno!() {
        if FlushFileBuffers(self.handle) == 0 { return lastError()!; }
        !()
    }
    pub fun syncData(&self) Errno!() { self.sync() }
    pub fun metadata(&self) Errno!FileMetadata { metadataHandle(self.handle) }
}

pub fun cwd() FileDescriptor {
    let path: [u16; 2] = [46, 0];
    .init(CreateFileW(
        &path[0],
        0,
        fileShareRead | fileShareWrite | fileShareDelete,
        0,
        openExisting,
        fileFlagBackupSemantics,
        0,
    ))
}

pub fun getCwd(buffer: &mut [u8]) Errno!&[u8] {
    if buffer.len() == 0 { return .Invalid!; }
    let mut storage: [u16; maxPathUnits] = [0; maxPathUnits];
    let length = GetCurrentDirectoryW(storage.len() as u32, &mut storage[0]);
    if length == 0 { return lastError()!; }
    if length as usize >= storage.len() { return .TooLong!; }
    let written = wideToUtf8(&storage[0..length as usize], buffer).?;
    !&buffer[0..written]
}

pub fun openAt(dir: FileDescriptor, path: &u8, mode: OpenMode, create: bool, truncate: bool, exclusive: bool, permissions: u32) Errno!FileDescriptor {
    openAtBeneath(dir, path, mode, false, create, truncate, exclusive, permissions, true)
}

pub fun openAtBeneath(dir: FileDescriptor, path: &u8, mode: OpenMode, directory: bool, create: bool, truncate: bool, exclusive: bool, permissions: u32, followSymlinks: bool) Errno!FileDescriptor {
    let mut storage: [u16; maxPathUnits] = [0; maxPathUnits];
    let native = pathFromHandle(dir, path, &mut storage[..]).?;
    let access = if directory { 0 } else { match mode { .ReadOnly => genericRead, .WriteOnly => genericWrite, .ReadWrite => genericRead | genericWrite, _ => return .Invalid!, } };
    let disposition = if create and exclusive { createNew } else if create and truncate { createAlways } else if create { openAlways } else if truncate { truncateExisting } else { openExisting };
    let mut flags = if directory { fileFlagBackupSemantics } else { 0 };
    if not followSymlinks { flags = flags | fileFlagOpenReparsePoint; }
    let handle = CreateFileW(native, access, fileShareRead | fileShareWrite | fileShareDelete, 0, disposition, flags, 0);
    if handle == invalidHandle { return lastError()!; }
    let mut rootStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let rootLength = handlePathLength(dir.handle, &mut rootStorage[..]);
    let mut candidateStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let candidateLength = handlePathLength(handle, &mut candidateStorage[..]);
    let within = match (rootLength, candidateLength) {
        (!root, !candidate) => isPathWithin(&rootStorage[0], root, &candidateStorage[0], candidate),
        _ => false,
    };
    if not within {
        _ = CloseHandle(handle);
        return .SymlinkLoop!;
    }
    if directory {
        let metadata = match metadataHandle(handle) {
            !value => value,
            error! => {
                _ = CloseHandle(handle);
                return error!;
            },
        };
        if metadata.kind() != .Directory {
            _ = CloseHandle(handle);
            return .NotDir!;
        }
    } else if not followSymlinks {
        let metadata = match metadataHandle(handle) {
            !value => value,
            error! => {
                _ = CloseHandle(handle);
                return error!;
            },
        };
        if metadata.kind() == .Symlink {
            _ = CloseHandle(handle);
            return .SymlinkLoop!;
        }
    }
    !.init(handle)
}

// The final component of a `*AtBeneath` mutation is joined to a parent that
// was already checked against the capability root, so it must name one entry
// of that parent. Windows also treats `\`, a drive prefix (`C:`), and an
// alternate data stream (`name:stream`) as path syntax, and `..` would leave
// the parent; any of them would reach past the containment check.
fun checkEntryName(name: &u8) Errno!() {
    if name[0] == 0 { return .Invalid!; }
    if name[0] == b'.' and (name[1] == 0 or (name[1] == b'.' and name[2] == 0)) {
        return .Invalid!;
    }
    let mut index: usize = 0;
    while name[index] != 0 {
        let byte = name[index];
        if byte == 92 or byte == b'/' or byte == b':' { return .Invalid!; }
        index += 1;
    }
    !()
}

fun createDirPath(parent: &u16, name: &u8) Errno!() {
    checkEntryName(name).?;
    let mut storage: [u16; maxPathUnits] = [0; maxPathUnits];
    let fullPath = joinPath(parent, name, &mut storage[..]).?;
    if CreateDirectoryW(fullPath, 0) == 0 { return lastError()!; }
    !()
}

fun deletePath(parent: &u16, name: &u8, directory: bool) Errno!() {
    checkEntryName(name).?;
    let mut storage: [u16; maxPathUnits] = [0; maxPathUnits];
    let fullPath = joinPath(parent, name, &mut storage[..]).?;
    if directory {
        if RemoveDirectoryW(fullPath) == 0 { return lastError()!; }
    } else if DeleteFileW(fullPath) == 0 {
        return lastError()!;
    }
    !()
}

fun renamePath(oldParent: &u16, oldName: &u8, newParent: &u16, newName: &u8) Errno!() {
    checkEntryName(oldName).?;
    checkEntryName(newName).?;
    let mut oldStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let oldPath = joinPath(oldParent, oldName, &mut oldStorage[..]).?;
    let mut newStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let newPath = joinPath(newParent, newName, &mut newStorage[..]).?;
    if MoveFileExW(oldPath, newPath, 1) == 0 { return lastError()!; }
    !()
}

pub fun createDirAtBeneath(dir: FileDescriptor, parent: &u8, name: &u8, permissions: u32) Errno!() {
    _ = permissions;
    let parentHandle = openAtBeneath(
        dir,
        parent,
        .ReadOnly,
        true,
        false,
        false,
        false,
        0,
        false,
    ).?;
    let mut parentStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let parentPath = handlePath(parentHandle.handle, &mut parentStorage[..]);
    let result = match parentPath {
        !parentPath => createDirPath(parentPath, name),
        error! => error!,
    };
    result.cleanupAfter(parentHandle.close())
}

pub fun deleteAtBeneath(dir: FileDescriptor, parent: &u8, name: &u8, directory: bool) Errno!() {
    let parentHandle = openAtBeneath(
        dir,
        parent,
        .ReadOnly,
        true,
        false,
        false,
        false,
        0,
        false,
    ).?;
    let mut parentStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let parentPath = handlePath(parentHandle.handle, &mut parentStorage[..]);
    let result = match parentPath {
        !parentPath => deletePath(parentPath, name, directory),
        error! => error!,
    };
    result.cleanupAfter(parentHandle.close())
}

pub fun renameAtBeneath(oldDir: FileDescriptor, oldParent: &u8, oldName: &u8, newDir: FileDescriptor, newParent: &u8, newName: &u8) Errno!() {
    let oldParentHandle = openAtBeneath(
        oldDir,
        oldParent,
        .ReadOnly,
        true,
        false,
        false,
        false,
        0,
        false,
    ).?;
    let newParentHandle = match openAtBeneath(
        newDir,
        newParent,
        .ReadOnly,
        true,
        false,
        false,
        false,
        0,
        false,
    ) {
        !handle => handle,
        error! => {
            _ = oldParentHandle.close();
            return error!;
        },
    };
    let mut oldParentStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let oldParentPath = handlePath(oldParentHandle.handle, &mut oldParentStorage[..]);
    let mut newParentStorage: [u16; maxPathUnits] = [0; maxPathUnits];
    let newParentPath = handlePath(newParentHandle.handle, &mut newParentStorage[..]);
    let result = match (oldParentPath, newParentPath) {
        (!oldParentPath, !newParentPath) => renamePath(oldParentPath, oldName, newParentPath, newName),
        (error!, _) => error!,
        (_, error!) => error!,
    };
    result
        .cleanupAfter(oldParentHandle.close())
        .cleanupAfter(newParentHandle.close())
}
