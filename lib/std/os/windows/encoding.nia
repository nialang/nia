using pkg::os::windows::bindings::{
    codePageUtf8,
    multiByteErrInvalidChars,
    MultiByteToWideChar,
    wideCharErrInvalidChars,
    WideCharToMultiByte,
};
using pkg::os::windows::types::{
    Errno,
};
using pkg::os::windows::error::{
    lastError,
};

pub(pkg) fn cStringLen(path: &u8) usize {
    let mut length: usize = 0;
    while path[length] != 0 { length += 1; }
    length
}

pub(pkg) fn utf8ToWide(text: &u8, storage: &mut [u16]) Errno!&u16 {
    if storage.len() == 0 { return .Invalid!; }
    let length = cStringLen(text);
    if length == 0 { storage[0] = 0; return !&storage[0]; }
    if storage.len() == 1 { return .TooLong!; }
    if length > i32::MAX as usize or storage.len() > i32::MAX as usize { return .TooLong!; }
    let written = MultiByteToWideChar(
        codePageUtf8,
        multiByteErrInvalidChars,
        text,
        length as i32,
        &mut storage[0],
        (storage.len() - 1) as i32,
    );
    if written == 0 { return lastError()!; }
    if written as usize >= storage.len() { return .TooLong!; }
    storage[written as usize] = 0;
    !&storage[0]
}

pub(pkg) fn wideStringLen(text: &u16) usize {
    let mut length: usize = 0;
    while text[length] != 0 { length += 1; }
    length
}

// Convert an explicit UTF-16 slice without a terminator. Reject malformed
// input instead of replacing names with a different filesystem identity.
pub(pkg) fn wideToUtf8(text: &[u16], storage: &mut [u8]) Errno!usize {
    if text.len() == 0 { return !0; }
    if text.len() > i32::MAX as usize { return .TooLong!; }
    let required = WideCharToMultiByte(
        codePageUtf8, wideCharErrInvalidChars, text.ptr(), text.len() as i32,
        0usize as &mut u8, 0, 0, 0,
    );
    if required == 0 { return lastError()!; }
    if required as usize > storage.len() { return .TooLong!; }
    let written = WideCharToMultiByte(
        codePageUtf8, wideCharErrInvalidChars, text.ptr(), text.len() as i32,
        storage.ptrMut(), required, 0, 0,
    );
    if written == 0 { return lastError()!; }
    !(written as usize)
}
