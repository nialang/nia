pub extern fun MoveFileExW(oldPath: &u16, newPath: &u16, flags: u32) i32;
pub extern fun GetFileAttributesW(path: &u16) u32;
pub extern fun SetFileAttributesW(path: &u16, attributes: u32) i32;
pub extern fun FindFirstFileW(pattern: &u16, data: &mut FindData) usize;
pub extern fun FindNextFileW(search: usize, data: &mut FindData) i32;
pub extern fun FindClose(search: usize) i32;
// ProcessPrng is the documented process random number generator; it always
// succeeds and returns TRUE.
pub extern fun ProcessPrng(buffer: &mut u8, length: usize) i32;
pub extern fun ExitProcess(code: u32) ();
pub extern fun WaitForSingleObject(handle: usize, milliseconds: u32) u32;
pub extern fun GetExitCodeProcess(handle: usize, code: &mut u32) i32;
pub extern fun TerminateProcess(handle: usize, code: u32) i32;
pub extern fun CreatePipe(read: &mut usize, write: &mut usize, security: &mut SecurityAttributes, size: u32) i32;
pub extern fun SetHandleInformation(handle: usize, mask: u32, flags: u32) i32;
pub extern fun GetCurrentProcess() usize;
