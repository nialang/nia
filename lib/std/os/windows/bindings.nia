    codePage: u32,
    flags: u32,
    source: &u16,
    sourceLength: i32,
    destination: &mut u8,
    capacity: i32,
    defaultChar: usize,
    usedDefaultChar: usize,
) i32;
pub extern fun CreateFileW(
    path: &u16,
    access: u32,
    share: u32,
    security: usize,
    disposition: u32,
    flags: u32,
    template: usize,
) usize;
pub extern fun CreateDirectoryW(path: &u16, security: usize) i32;
pub extern fun DeleteFileW(path: &u16) i32;
