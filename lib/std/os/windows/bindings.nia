pub const errorNotEnoughMemory: u32 = 8;
pub const errorInvalidData: u32 = 13;
pub const errorOutofmemory: u32 = 14;
pub const errorAlreadyExists: u32 = 183;
pub const errorFileNotFound: u32 = 2;
pub const errorPathNotFound: u32 = 3;
pub const errorNoMoreFiles: u32 = 18;
pub const errorDirectory: u32 = 267;
pub const errorNotSupported: u32 = 50;
pub const errorFilenameExcedRange: u32 = 206;
pub const errorInvalidName: u32 = 123;
pub const invalidFileAttributes: u32 = 0xffffffff;
pub const fileNameNormalized: u32 = 0;
pub const getFileExInfoStandard: u32 = 0;
pub const fileAttributeReadonly: u32 = 0x1;
pub const handleFlagInherit: u32 = 1;
pub const duplicateSameAccess: u32 = 2;
pub const startupUseStdHandles: u32 = 0x100;
pub const createUnicodeEnvironment: u32 = 0x400;
pub const nullDeviceAccess: u32 = 0xc0000000;
pub const codePageUtf8: u32 = 65001;
pub const multiByteErrInvalidChars: u32 = 8;
pub const wideCharErrInvalidChars: u32 = 0x80;
pub const maxPathUnits: usize = 32768;
pub const findDataNameUnits: usize = 260;
pub const findDataAlternateUnits: usize = 14;
pub const fileAttributeNormal: u32 = 0x80;
pub const fileAttributeReparsePoint: u32 = 0x400;

pub extern fun GetLastError() u32;
pub extern fun GetStdHandle(which: i32) usize;
pub extern fun WriteFile(
    handle: usize,
    buffer: &u8,
    length: u32,
    written: &mut u32,
    overlapped: usize,
) i32;
pub extern fun ReadFile(
    handle: usize,
    buffer: &mut u8,
    length: u32,
    read: &mut u32,
    overlapped: usize,
) i32;
pub extern fun CloseHandle(handle: usize) i32;
pub extern fun SetFilePointerEx(handle: usize, distance: i64, result: &mut i64, method: u32) i32;
pub const fileEndOfFileInfo: u32 = 6;
pub extern struct FileEndOfFileInfo { endOfFile: i64 }
pub extern fun SetFileInformationByHandle(handle: usize, infoClass: u32, info: usize, size: u32) i32;
pub const fileAttributeTagInfo: u32 = 9;
pub extern struct FileAttributeTagInfo { attributes: u32, reparseTag: u32 }
pub extern fun GetFileInformationByHandleEx(handle: usize, infoClass: u32, info: &mut FileAttributeTagInfo, size: u32) i32;
// Symbolic links and junctions set this tag bit; cloud placeholders and other
// storage reparse points name ordinary files and directories.
pub const reparseTagNameSurrogate: u32 = 0x20000000;
pub extern fun FlushFileBuffers(handle: usize) i32;
pub extern fun GetCurrentDirectoryW(length: u32, buffer: &mut u16) u32;
pub extern fun GetFinalPathNameByHandleW(
    handle: usize,
    buffer: &mut u16,
    length: u32,
    flags: u32,
) u32;
pub extern fun CompareStringOrdinal(
    first: &u16,
    firstLength: i32,
    second: &u16,
    secondLength: i32,
    ignoreCase: i32,
) i32;
pub extern fun VirtualAlloc(address: usize, size: usize, allocationType: u32, protection: u32) usize;
pub extern fun VirtualFree(address: usize, size: usize, freeType: u32) i32;
pub extern fun GetSystemInfo(info: &mut SystemInfo) ();
pub extern fun GetFileInformationByHandle(handle: usize, info: &mut ByHandleFileInformation) i32;
