using root::builtin::Len;
using root::os::windows::bindings::{fileNameNormalized, GetFinalPathNameByHandleW, CompareStringOrdinal};
using root::os::windows::types::{Errno, FileDescriptor};
using root::os::windows::error::lastError;
using root::os::windows::encoding::{utf8ToWide, wideStringLen};

pub(root) fun handlePath(handle: usize, storage: &mut [u16]) Errno!&u16 {
    _ = handlePathLength(handle, storage).?;
    !&storage[0]
}

pub(root) fun handlePathLength(handle: usize, storage: &mut [u16]) Errno!usize {
    if storage.len() == 0 or storage.len() > u32::MAX as usize { return .TooLong!; }
    let length = GetFinalPathNameByHandleW(handle, storage.ptrMut(), storage.len() as u32, fileNameNormalized);
    if length == 0 { return lastError()!; }
    if length as usize >= storage.len() { return .TooLong!; }
    !(length as usize)
}

pub(root) fun isPathWithin(base: &u16, baseLength: usize, candidate: &u16, candidateLength: usize) bool {
    let mut baseStart: usize = 0;
    let mut baseLen = baseLength;
    let mut candidateStart: usize = 0;
    let mut candidateLen = candidateLength;

    // Strip \\?\ prefix if present on base
    if baseLen >= 4 and base[0] == 92 and base[1] == 92 and base[2] == 63 and base[3] == 92 {
        baseStart = 4;
        baseLen -= 4;
    }

    // Strip \\?\ prefix if present on candidate
    if candidateLen >= 4 and candidate[0] == 92 and candidate[1] == 92 and candidate[2] == 63 and candidate[3] == 92 {
        candidateStart = 4;
        candidateLen -= 4;
    }

    if candidateLen < baseLen { return false; }
    if CompareStringOrdinal(&base[baseStart], baseLen as i32, &candidate[candidateStart], baseLen as i32, 1) != 2 { return false; }
    candidateLen == baseLen or base[baseStart + baseLen - 1] == 92 or base[baseStart + baseLen - 1] == 47 or candidate[candidateStart + baseLen] == 92 or candidate[candidateStart + baseLen] == 47
}

// Paths stay in UTF-16 between the handle lookup and the native operation.
pub(root) fun pathFromHandle(dir: FileDescriptor, path: &u8, storage: &mut [u16]) Errno!&u16 {
    if path[0] == 92 or path[0] == b'/' or (path[0] != 0 and path[1] == b':') {
        _ = utf8ToWide(path, storage).?;
        normalizeSeparators(storage);
        return !&storage[0];
    }
    _ = handlePath(dir.handle, storage).?;
    if path[0] == 0 or (path[0] == b'.' and path[1] == 0) { return !&storage[0]; }
    let length = wideStringLen(&storage[0]);
    appendPath(storage, length, path)
}

pub(root) fun joinPath(parent: &u16, child: &u8, storage: &mut [u16]) Errno!&u16 {
    let length = wideStringLen(parent);
    if length >= storage.len() { return .TooLong!; }
    let mut index: usize = 0;
    while index < length {
        storage[index] = parent[index];
        index += 1;
    }
    storage[length] = 0;
    appendPath(storage, length, child)
}

fun appendPath(storage: &mut [u16], length: usize, child: &u8) Errno!&u16 {
    let mut offset = length;
    if offset != 0 and storage[offset - 1] != 92 and storage[offset - 1] != 47 {
        if offset + 1 >= storage.len() { return .TooLong!; }
        storage[offset] = 92;
        offset += 1;
    }
    _ = utf8ToWide(child, &mut storage[offset..]).?;
    normalizeSeparators(storage);
    !&storage[0]
}

pub(root) fun normalizeSeparators(storage: &mut [u16]) () {
    let mut index: usize = 0;
    while index < storage.len() and storage[index] != 0 {
        if storage[index] == 47 { storage[index] = 92; }
        index += 1;
    }
}
