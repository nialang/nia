comptime if @builtin().target.arch == "x86_64" {
    import std.os.linux.x86_64.syscall;
}

pub comptime let max_path_bytes: usize = 4096usize;

pub enum Error: i32 {
    PermissionDenied = 1,
    NoEntry = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    NoMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    Exists = 17,
    Invalid = 22,
    NoSpace = 28,
    BrokenPipe = 32,
    OutOfRange = 34,
    _,
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub struct FileDescriptor {
    fd: i32,
}

pub fn error(code: i32) Error {
    code as Error
}

fn syscall_error(ret: isize) Error {
    error((0isize - ret) as i32)
}

extend FileDescriptor {
    pub fn init(fd: i32) FileDescriptor {
        { fd: fd }
    }

    pub fn stdin() FileDescriptor {
        FileDescriptor::init(0)
    }

    pub fn stdout() FileDescriptor {
        FileDescriptor::init(1)
    }

    pub fn stderr() FileDescriptor {
        FileDescriptor::init(2)
    }

    pub fn raw(&self) i32 {
        self.fd
    }

    pub fn write_some(&self, bytes: &[u8]) Error!usize {
        var ptr = bytes.get_ptr_read();
        var ret = syscall::syscall3(1, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            syscall_error(ret)!
        } else {
            !(ret as usize)
        }
    }

    pub fn read_some(&self, bytes: &mut [u8]) Error!usize {
        var ptr = bytes.get_ptr();
        var ret = syscall::syscall3(0, self.fd as usize, ptr as usize, bytes.len());
        if ret < 0 {
            syscall_error(ret)!
        } else {
            !(ret as usize)
        }
    }

    pub fn close(&self) Error!void {
        var ret = syscall::syscall1(3, self.fd as usize);
        if ret < 0 {
            syscall_error(ret)!
        } else {
            !{}
        }
    }
}

pub fn cwd() FileDescriptor {
    FileDescriptor::init(-100)
}

pub fn open_at(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileDescriptor {
    var flags = mode as i32;
    if create {
        flags = flags + 0o100;
    }
    if exclusive {
        flags = flags + 0o200;
    }
    if truncate {
        flags = flags + 0o1000;
    }

    var ret = syscall::syscall4(
        257,
        dir.raw() as usize,
        path as usize,
        flags as usize,
        permissions as usize,
    );
    if ret < 0 {
        syscall_error(ret)!
    } else {
        !FileDescriptor::init(ret as i32)
    }
}

pub fn map_pages(len: usize, align: usize) Error!&mut u8 {
    if align == 0 {
        return Error::Invalid!;
    }
    if align > 4096 {
        return Error::Invalid!;
    }
    var prot_read_write = 3usize;
    var private_anonymous = 34usize;
    var ret = syscall::syscall6(
        9,
        0,
        len,
        prot_read_write,
        private_anonymous,
        (-1isize) as usize,
        0,
    );
    if ret < 0 {
        syscall_error(ret)!
    } else {
        !((ret as usize) as &mut u8)
    }
}

pub fn unmap_pages(ptr: &mut u8, len: usize) Error!void {
    var ret = syscall::syscall3(11, ptr as usize, len, 0);
    if ret < 0 {
        syscall_error(ret)!
    } else {
        !{}
    }
}

pub fn exit(code: i32) void {
    _ = syscall::syscall1(60, code as usize);
    loop {}
}
