pub(pkg) module fd;
pub(pkg) module mem;
pub(pkg) module process;
pub(pkg) module random;
pub(pkg) module stat;
pub(pkg) module syscall;
pub(pkg) module types;
pub(pkg) module x86_64;

using pkg::os::linux::fd;
using pkg::os::linux::mem as memory;
using pkg::os::linux::process;
using pkg::os::linux::random as random_impl;
using pkg::os::linux::stat;
using pkg::os::linux::types;

pub using types::{
    DirectoryEntry,
    Errno,
    FileDescriptor,
    FileKind,
    FileMetadata,
    OpenMode,
    ProcessId,
    SeekWhence,
    SpawnError,
    SpawnOptions,
    SpawnResult,
    StdIo,
    Timestamp,
    WaitStatus,
};

pub const max_path_bytes: usize = types::max_path_bytes;

pub fn sigterm() i32 {
    types::sigterm
}

pub fn cwd() FileDescriptor {
    fd::cwd()
}

pub fn getcwd(buffer: &mut [u8]) Errno!&[u8] {
    fd::getcwd(buffer)
}

pub fn page_size() usize {
    memory::page_size()
}

pub fn page_aligned_len(len: usize) Errno!usize {
    memory::page_aligned_len(len)
}

pub fn open_at(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Errno!FileDescriptor {
    fd::open_at(dir, path, mode, create, truncate, exclusive, permissions)
}

pub fn open_at_beneath(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    follow_symlinks: bool,
) Errno!FileDescriptor {
    fd::open_at_beneath(
        dir,
        path,
        mode,
        directory,
        create,
        truncate,
        exclusive,
        permissions,
        follow_symlinks,
    )
}

pub fn create_dir_at_beneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Errno!() {
    fd::create_dir_at_beneath(dir, parent, name, permissions)
}

pub fn delete_at_beneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    directory: bool,
) Errno!() {
    fd::delete_at_beneath(dir, parent, name, directory)
}

pub fn rename_at_beneath(
    old_dir: FileDescriptor,
    old_parent: &u8,
    old_name: &u8,
    new_dir: FileDescriptor,
    new_parent: &u8,
    new_name: &u8,
) Errno!() {
    fd::rename_at_beneath(
        old_dir,
        old_parent,
        old_name,
        new_dir,
        new_parent,
        new_name,
    )
}

pub fn metadata_at_beneath(dir: FileDescriptor, path: &u8, follow_symlinks: bool) Errno!FileMetadata {
    stat::metadata_at_beneath(dir, path, follow_symlinks)
}

pub fn dir_entry_at(buffer: &[u8], offset: usize) ?DirectoryEntry {
    fd::dir_entry_at(buffer, offset)
}

pub fn dir_entry_next_offset(buffer: &[u8], offset: usize) ?usize {
    fd::dir_entry_next_offset(buffer, offset)
}

pub fn map_pages(len: usize, align: usize) Errno!&mut u8 {
    memory::map_pages(len, align)
}

pub fn unmap_pages(ptr: &mut u8, len: usize) Errno!() {
    memory::unmap_pages(ptr, len)
}

pub fn random(bytes: &mut [u8]) Errno!() {
    random_impl::random(bytes)
}

pub fn spawn_raw(path: &u8, argv: &&u8, envp: &&u8) SpawnError!ProcessId {
    process::spawn_raw(path, argv, envp)
}

pub fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnError!SpawnResult {
    process::spawn(path, argv, envp, options)
}

pub fn wait(pid: ProcessId) Errno!WaitStatus {
    process::wait(pid)
}

pub fn try_wait(pid: ProcessId) Errno! ?WaitStatus {
    process::try_wait(pid)
}

pub fn kill(pid: ProcessId) Errno!() {
    process::kill_with(pid, types::sigterm)
}

pub fn kill_with(pid: ProcessId, signal: i32) Errno!() {
    process::kill_with(pid, signal)
}

pub fn exit(code: i32) () {
    process::exit(code);
}
