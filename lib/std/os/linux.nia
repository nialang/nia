pub(root) module fd;
pub(root) module mem;
pub(root) module process;
pub(root) module random;
pub(root) module stat;
pub(root) module syscall;
pub(root) module types;
@[if arch == "x86_64"]
pub(root) module x86_64;
@[if arch == "x86"]
pub(root) module x86;
@[if arch == "aarch64"]
pub(root) module aarch64;

using root::os::linux::fd;
using root::os::linux::mem as memory;
using root::os::linux::process;
using root::os::linux::random as randomImpl;
using root::os::linux::stat;
using root::os::linux::types;

pub using memory::MappedPages;

pub struct DirectoryReader {}

pub fun initDirectoryReader() DirectoryReader { .{} }

pub fun closeDirectoryReader(reader: &mut DirectoryReader) Errno!() {
    _ = reader;
    !()
}

pub fun readDirEntries(reader: &mut DirectoryReader, handle: FileDescriptor, buffer: &mut [u8]) Errno!usize {
    _ = reader;
    handle.readDirEntries(buffer)
}

pub using types::{
    DirectoryEntry,
    Errno,
    FileDescriptor,
    FileKind,
    FileMetadata,
    OpenMode,
    ProcessId,
    SeekWhence,
    SpawnAttempt,
    SpawnError,
    SpawnOptions,
    SpawnResult,
    SpawnStage,
    StdIo,
    Timestamp,
    WaitStatus,
};

pub const maxPathBytes: usize = types::maxPathBytes;

pub fun sigTerm() i32 {
    types::sigTerm
}

pub fun cwd() FileDescriptor {
    fd::cwd()
}

pub fun getCwd(buffer: &mut [u8]) Errno!&[u8] {
    fd::getCwd(buffer)
}

pub fun pageSize() usize {
    memory::pageSize()
}

pub fun pageAlignedLen(len: usize) Errno!usize {
    memory::pageAlignedLen(len)
}

pub fun openAt(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Errno!FileDescriptor {
    fd::openAt(dir, path, mode, create, truncate, exclusive, permissions)
}

pub fun openAtBeneath(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    followSymlinks: bool,
) Errno!FileDescriptor {
    fd::openAtBeneath(
        dir,
        path,
        mode,
        directory,
        create,
        truncate,
        exclusive,
        permissions,
        followSymlinks,
    )
}

pub fun createDirAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Errno!() {
    fd::createDirAtBeneath(dir, parent, name, permissions)
}

pub fun deleteAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    directory: bool,
) Errno!() {
    fd::deleteAtBeneath(dir, parent, name, directory)
}

pub fun renameAtBeneath(
    oldDir: FileDescriptor,
    oldParent: &u8,
    oldName: &u8,
    newDir: FileDescriptor,
    newParent: &u8,
    newName: &u8,
) Errno!() {
    fd::renameAtBeneath(
        oldDir,
        oldParent,
        oldName,
        newDir,
        newParent,
        newName,
    )
}

pub fun metadataAtBeneath(dir: FileDescriptor, path: &u8, followSymlinks: bool) Errno!FileMetadata {
    stat::metadataAtBeneath(dir, path, followSymlinks)
}

pub fun dirEntryAt(handle: FileDescriptor, buffer: &[u8], offset: usize) Errno!DirectoryEntry {
    fd::dirEntryAt(handle, buffer, offset)
}

pub fun dirEntryNextOffset(buffer: &[u8], offset: usize) ?usize {
    fd::dirEntryNextOffset(buffer, offset)
}

pub fun mapPages(len: usize, align: usize) Errno!MappedPages {
    memory::mapPages(len, align)
}

pub fun unmapPages(ptr: &mut u8, len: usize) Errno!() {
    memory::unmapPages(ptr, len)
}

pub fun random(bytes: &mut [u8]) Errno!() {
    randomImpl::random(bytes)
}

pub fun spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    process::spawn(path, argv, envp, options)
}

pub fun wait(pid: ProcessId) Errno!WaitStatus {
    process::wait(pid)
}

pub fun tryWait(pid: ProcessId) Errno! ?WaitStatus {
    process::tryWait(pid)
}

pub fun kill(pid: ProcessId) Errno!() {
    process::killWith(pid, types::sigTerm)
}

pub fun killWith(pid: ProcessId, signal: i32) Errno!() {
    process::killWith(pid, signal)
}

pub fun exit(code: i32) () {
    process::exit(code);
}
