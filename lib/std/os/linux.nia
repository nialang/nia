import std.os.linux.fd;
import std.os.linux.mem as memory;
import std.os.linux.process;
import std.os.linux.types;

pub using types::{Error, FileDescriptor, OpenMode, SeekWhence};

pub comptime let max_path_bytes: usize = types::max_path_bytes;

pub fn cwd() FileDescriptor {
    fd::cwd()
}

pub fn page_size() usize {
    memory::page_size()
}

pub fn page_aligned_len(len: usize) Error!usize {
    memory::page_aligned_len(len)
}

pub fn open_at(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileDescriptor {
    fd::open_at(dir, path, mode, create, truncate, exclusive, permissions)
}

pub fn open_dir_at(dir: FileDescriptor, path: &u8, follow_symlinks: bool) Error!FileDescriptor {
    fd::open_dir_at(dir, path, follow_symlinks)
}

pub fn create_dir_at(dir: FileDescriptor, path: &u8, permissions: u32) Error!void {
    fd::create_dir_at(dir, path, permissions)
}

pub fn delete_file_at(dir: FileDescriptor, path: &u8) Error!void {
    fd::delete_file_at(dir, path)
}

pub fn delete_dir_at(dir: FileDescriptor, path: &u8) Error!void {
    fd::delete_dir_at(dir, path)
}

pub fn rename_at(
    old_dir: FileDescriptor,
    old_path: &u8,
    new_dir: FileDescriptor,
    new_path: &u8,
) Error!void {
    fd::rename_at(old_dir, old_path, new_dir, new_path)
}

pub fn map_pages(len: usize, align: usize) Error!&mut u8 {
    memory::map_pages(len, align)
}

pub fn unmap_pages(ptr: &mut u8, len: usize) Error!void {
    memory::unmap_pages(ptr, len)
}

pub fn exit(code: i32) void {
    process::exit(code);
}
