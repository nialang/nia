pub(pkg) module fd;
pub(pkg) module mem;
pub(pkg) module process;
pub(pkg) module random;
pub(pkg) module stat;
pub(pkg) module syscall;
pub(pkg) module types;
@[if arch == "x86_64"]
pub(pkg) module x86_64;
@[if arch == "x86"]
pub(pkg) module x86;

using pkg::os::linux::fd;
using pkg::os::linux::mem as memory;
using pkg::os::linux::process;
using pkg::os::linux::random as randomImpl;
using pkg::os::linux::stat;
using pkg::os::linux::types;

pub using memory::MappedPages;

pub using types::{
    DirectoryEntry,
    Errno,
    FileDescriptor,
    FileKind,
    FileMetadata,
    OpenMode,
    ProcessId,
    SeekWhence,
    SpawnAttempt,
    SpawnError,
    SpawnOptions,
    SpawnResult,
    SpawnStage,
    StdIo,
    Timestamp,
    WaitStatus,
};

pub const maxPathBytes: usize = types::maxPathBytes;

pub fn sigTerm() i32 {
    types::sigTerm
}

pub fn cwd() FileDescriptor {
    fd::cwd()
}

pub fn getCwd(buffer: &mut [u8]) Errno!&[u8] {
    fd::getCwd(buffer)
}

pub fn pageSize() usize {
    memory::pageSize()
}

pub fn pageAlignedLen(len: usize) Errno!usize {
    memory::pageAlignedLen(len)
}

pub fn openAt(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Errno!FileDescriptor {
    fd::openAt(dir, path, mode, create, truncate, exclusive, permissions)
}

pub fn openAtBeneath(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    followSymlinks: bool,
) Errno!FileDescriptor {
    fd::openAtBeneath(
        dir,
        path,
        mode,
        directory,
        create,
        truncate,
        exclusive,
        permissions,
        followSymlinks,
    )
}

pub fn createDirAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Errno!() {
    fd::createDirAtBeneath(dir, parent, name, permissions)
}

pub fn deleteAtBeneath(
    dir: FileDescriptor,
    parent: &u8,
    name: &u8,
    directory: bool,
) Errno!() {
    fd::deleteAtBeneath(dir, parent, name, directory)
}

pub fn renameAtBeneath(
    oldDir: FileDescriptor,
    oldParent: &u8,
    oldName: &u8,
    newDir: FileDescriptor,
    newParent: &u8,
    newName: &u8,
) Errno!() {
    fd::renameAtBeneath(
        oldDir,
        oldParent,
        oldName,
        newDir,
        newParent,
        newName,
    )
}

pub fn metadataAtBeneath(dir: FileDescriptor, path: &u8, followSymlinks: bool) Errno!FileMetadata {
    stat::metadataAtBeneath(dir, path, followSymlinks)
}

pub fn dirEntryAt(buffer: &[u8], offset: usize) ?DirectoryEntry {
    fd::dirEntryAt(buffer, offset)
}

pub fn dirEntryNextOffset(buffer: &[u8], offset: usize) ?usize {
    fd::dirEntryNextOffset(buffer, offset)
}

pub fn mapPages(len: usize, align: usize) Errno!MappedPages {
    memory::mapPages(len, align)
}

pub fn unmapPages(ptr: &mut u8, len: usize) Errno!() {
    memory::unmapPages(ptr, len)
}

pub fn random(bytes: &mut [u8]) Errno!() {
    randomImpl::random(bytes)
}

pub fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    process::spawn(path, argv, envp, options)
}

pub fn wait(pid: ProcessId) Errno!WaitStatus {
    process::wait(pid)
}

pub fn tryWait(pid: ProcessId) Errno! ?WaitStatus {
    process::tryWait(pid)
}

pub fn kill(pid: ProcessId) Errno!() {
    process::killWith(pid, types::sigTerm)
}

pub fn killWith(pid: ProcessId, signal: i32) Errno!() {
    process::killWith(pid, signal)
}

pub fn exit(code: i32) () {
    process::exit(code);
}
