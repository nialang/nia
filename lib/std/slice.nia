// Borrowed slice operations and iterators.
//
// Slice adapters borrow their backing storage without changing its lifetime.
// Iterators validate checked element offsets and addresses before moving their
// front or back bound; an impossible address returns `null` without consuming
// the pending element.
// Allocator-taking operations return independent owned results.

using root::cmp;
using root::iter;
using root::iter::range;
using root::math;

// Compare borrowed values without requiring callers to move keys out of a
// slice. Built-in Ord operations supply the natural ordering convenience API.
fun ordCompare[T](left: &T, right: &T) cmp::Ordering
where T: Sized + Ord[T]
{
    if left.* < right.* {
        .Less
    } else if left.* > right.* {
        .Greater
    } else {
        .Equal
    }
}

fun swapAt[T](items: &mut [T], left: usize, right: usize) ()
where T: Sized
{
    if left != right {
        let temporary = items[left];
        items[left] = items[right];
        items[right] = temporary;
    }
}

fun reverseRange[T](items: &mut [T], start: usize, end: usize) ()
where T: Sized
{
    let mut left = start;
    let mut right = end;
    while left < right {
        right -= 1;
        if left >= right {
            break;
        }
        swapAt(items, left, right);
        left += 1;
    }
}

fun rotateRange[T](items: &mut [T], start: usize, middle: usize, end: usize) ()
where T: Sized
{
    if start == middle or middle == end {
        return;
    }
    reverseRange(items, start, middle);
    reverseRange(items, middle, end);
    reverseRange(items, start, end);
}

fun lowerBoundRange[T](
    items: &[T],
    start: usize,
    end: usize,
    value: &T,
    compare: &Fun(&T, &T) cmp::Ordering,
) usize
where T: Sized
{
    let mut low = start;
    let mut high = end;
    while low < high {
        let middle = low + (high - low) / 2;
        if compare(&items[middle], value) is .Less {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    low
}

fun upperBoundRange[T](
    items: &[T],
    start: usize,
    end: usize,
    value: &T,
    compare: &Fun(&T, &T) cmp::Ordering,
) usize
where T: Sized
{
    let mut low = start;
    let mut high = end;
    while low < high {
        let middle = low + (high - low) / 2;
        if compare(&items[middle], value) is .Greater {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}

// Stable in-place merge sort. The rotation-based merge needs no allocator and
// keeps equal elements in their original order. Its worst-case running time is
// O(n log^2 n); this avoids hidden allocation and fallible-cleanup ownership.
fun stableSortRange[T](
    items: &mut [T],
    start: usize,
    end: usize,
    compare: &Fun(&T, &T) cmp::Ordering,
) ()
where T: Sized
{
    if end - start < 2 {
        return;
    }
    let middle = start + (end - start) / 2;
    stableSortRange(items, start, middle, compare);
    stableSortRange(items, middle, end, compare);
    stableMergeRange(items, start, middle, end, compare);
}

fun stableMergeRange[T](
    items: &mut [T],
    start: usize,
    middle: usize,
    end: usize,
    compare: &Fun(&T, &T) cmp::Ordering,
) ()
where T: Sized
{
    if start == middle or middle == end {
        return;
    }
    if end - start == 2 {
        if compare(&items[middle], &items[start]) is .Less {
            swapAt(items, start, middle);
        }
        return;
    }

    let leftLength = middle - start;
    let rightLength = end - middle;
    let (firstCut, secondCut) = if leftLength > rightLength {
        let first = start + leftLength / 2;
        (first, lowerBoundRange(items, middle, end, &items[first], compare))
    } else {
        let second = middle + rightLength / 2;
        (upperBoundRange(items, start, middle, &items[second], compare), second)
    };

    let newMiddle = firstCut + (secondCut - middle);
    rotateRange(items, firstCut, middle, secondCut);
    stableMergeRange(items, start, firstCut, newMiddle, compare);
    stableMergeRange(items, newMiddle, secondCut, end, compare);
}

fun siftDown[T](
    items: &mut [T],
    start: usize,
    rootIndex: usize,
    count: usize,
    compare: &Fun(&T, &T) cmp::Ordering,
) ()
where T: Sized
{
    let mut parent = rootIndex;
    while count > 1 {
        // A parent with children is at most (count - 2) / 2, so this
        // multiplication and addition stay within the slice's index range.
        let child = parent * 2 + 1;
        if child >= count {
            break;
        }
        let mut largest = child;
        let rightChild = child + 1;
        if rightChild < count and compare(&items[start + child], &items[start + rightChild]) is .Less {
            largest = rightChild;
        }
        if compare(&items[start + parent], &items[start + largest]) is .Less {
            swapAt(items, start + parent, start + largest);
            parent = largest;
        } else {
            break;
        }
    }
}

fun heapSort[T](items: &mut [T], compare: &Fun(&T, &T) cmp::Ordering) ()
where T: Sized
{
    let count = items.len();
    if count < 2 {
        return;
    }

    let mut parent = count / 2;
    while parent > 0 {
        parent -= 1;
        siftDown(items, 0, parent, count, compare);
    }

    let mut remaining = count;
    while remaining > 1 {
        remaining -= 1;
        swapAt(items, 0, remaining);
        siftDown(items, 0, 0, remaining, compare);
    }
}

pub struct SliceIter[T]
where T: Sized
{
    ptr: &T,
    len: usize,
    index: usize,
}

pub struct SliceIterMut[T]
where T: Sized
{
    ptr: &mut T,
    len: usize,
    index: usize,
}

pub struct SliceSplit[T]
where T: Sized + Eq[T]
{
    remaining: &[T],
    separator: &[T],
    done: bool,
}

extend[T] SliceIter[T]
where T: Sized
{
    fun fromRawParts(ptr: &T, len: usize) SliceIter[T] {
        .{ ptr, len, index: 0 }
    }

    pub fun len(&self) usize {
        self.len - self.index
    }

    pub fun isEmpty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceIterMut[T]
where T: Sized
{
    fun fromRawParts(ptr: &mut T, len: usize) SliceIterMut[T] {
        .{ ptr, len, index: 0 }
    }

    pub fun len(&self) usize {
        self.len - self.index
    }

    pub fun isEmpty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceSplit[T]
where T: Sized + Eq[T]
{
    fun init(items: &[T], separator: &[T]) SliceSplit[T] {
        .{ remaining: items, separator, done: false }
    }
}

extend[T] SliceIter[T] : Iterator
where T: Sized
{
    type Item = &T;

    pub fun next(&mut self) ?&T {
        if self.index >= self.len {
            null
        } else {
            let offset = match self.index.checkedMul(root::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checkedAdd(offset) {
                ?value => value,
                null => return null,
            };
            let item = address as &T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIter[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fun nextBack(&mut self) ?[SliceIter[T] as Iterator]::Item {
        if self.index >= self.len {
            null
        } else {
            let backIndex = self.len - 1;
            let offset = match backIndex.checkedMul(root::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checkedAdd(offset) {
                ?value => value,
                null => return null,
            };
            self.len = backIndex;
            ?(address as &T)
        }
    }
}

extend[T] SliceIterMut[T] : Iterator
where T: Sized
{
    type Item = &mut T;

    pub fun next(&mut self) ?&mut T {
        if self.index >= self.len {
            null
        } else {
            let offset = match self.index.checkedMul(root::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checkedAdd(offset) {
                ?value => value,
                null => return null,
            };
            let item = address as &mut T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIterMut[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fun nextBack(&mut self) ?[SliceIterMut[T] as Iterator]::Item {
        if self.index >= self.len {
            null
        } else {
            let backIndex = self.len - 1;
            let offset = match backIndex.checkedMul(root::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checkedAdd(offset) {
                ?value => value,
                null => return null,
            };
            self.len = backIndex;
            ?(address as &mut T)
        }
    }
}

extend[T] SliceSplit[T] : Iterator
where T: Sized + Eq[T]
{
    type Item = &[T];

    pub fun next(&mut self) ?&[T] {
        if self.done {
            return null;
        }
        if self.separator.isEmpty() {
            self.done = true;
            return ?self.remaining;
        }

        if self.remaining.find(self.separator) is ?index {
            let items = self.remaining;
            self.remaining = &items[(index + self.separator.len())..];
            ?&items[0..index]
        } else {
            self.done = true;
            ?self.remaining
        }
    }
}

extend[T] [T]
where T: Sized
{
    pub fun isEmpty(&self) bool {
        self.len() == 0
    }

    pub fun get(&self, index: usize) ?&T {
        if index >= self.len() {
            null
        } else {
            ?&self[index]
        }
    }

    pub fun getMut(&mut self, index: usize) ?&mut T {
        if index >= self.len() {
            null
        } else {
            ?&mut self[index]
        }
    }

    pub fun first(&self) ?&T {
        self.get(0)
    }

    pub fun firstMut(&mut self) ?&mut T {
        self.getMut(0)
    }

    pub fun last(&self) ?&T {
        if self.len() == 0 {
            null
        } else {
            self.get(self.len() - 1)
        }
    }

    pub fun lastMut(&mut self) ?&mut T {
        if self.len() == 0 {
            null
        } else {
            self.getMut(self.len() - 1)
        }
    }

    pub fun getRange(&self, start: usize, end: usize) ?&[T] {
        if start > end or end > self.len() {
            null
        } else {
            ?&self[start..end]
        }
    }

    pub fun getRangeMut(&mut self, start: usize, end: usize) ?&mut [T] {
        if start > end or end > self.len() {
            null
        } else {
            ?&mut self[start..end]
        }
    }

    pub fun copyFrom(&mut self, source: &[T]) usize {
        let mut count = self.len();
        if source.len() < count {
            count = source.len();
        }
        root::builtin::memmove(&mut self[0..count], &source[0..count]);
        count
    }

    pub fun iter(&self) SliceIter[T] {
        .fromRawParts(self.ptr(), self.len())
    }

    pub fun iterMut(&mut self) SliceIterMut[T] {
        .fromRawParts(self.ptrMut(), self.len())
    }
}

extend[T] [T]
where T: Sized + Eq[T]
{
    pub fun equals(&self, other: &[T]) bool {
        if self.len() != other.len() {
            return false;
        }

        for index in 0..self.len() {
            if self[index] != other[index] {
                return false;
            }
        }
        true
    }

    pub fun startsWith(&self, prefix: &[T]) bool {
        if prefix.len() > self.len() {
            return false;
        }
        (&self[0..prefix.len()]).equals(prefix)
    }

    pub fun endsWith(&self, suffix: &[T]) bool {
        if suffix.len() > self.len() {
            return false;
        }
        (&self[(self.len() - suffix.len())..]).equals(suffix)
    }

    pub fun find(&self, needle: &[T]) ?usize {
        if needle.isEmpty() {
            return ?0;
        }
        if needle.len() > self.len() {
            return null;
        }

        let lastStart = self.len() - needle.len();
        for index in 0..=lastStart {
            if (&self[index..(index + needle.len())]).equals(needle) {
                return ?index;
            }
        }
        null
    }

    pub fun contains(&self, needle: &[T]) bool {
        if self.find(needle) is ?_ {
            true
        } else {
            false
        }
    }

    pub fun split(&self, separator: &[T]) SliceSplit[T] {
        .init(self, separator)
    }
}

extend[T] [T]
where T: Sized + Ord[T]
{
    pub fun compare(&self, other: &[T]) cmp::Ordering {
        let mut len = self.len();
        if other.len() < len {
            len = other.len();
        }

        for index in 0..len {
            if self[index] < other[index] {
                return .Less;
            }
            if self[index] > other[index] {
                return .Greater;
            }
        }

        if self.len() < other.len() {
            .Less
        } else if self.len() > other.len() {
            .Greater
        } else {
            .Equal
        }
    }
}

// Comparator-based operations do not require Ord and never move values out of
// the slice. A comparator orders its first value relative to its second value.
extend[T] [T]
where T: Sized
{
    pub fun sortBy(&mut self, compare: &Fun(&T, &T) cmp::Ordering) () {
        stableSortRange(self, 0, self.len(), compare);
    }

    pub fun sortUnstableBy(&mut self, compare: &Fun(&T, &T) cmp::Ordering) () {
        heapSort(self, compare);
    }

    pub fun binarySearchBy(&self, compare: &Fun(&T) cmp::Ordering) ?usize {
        let mut low: usize = 0;
        let mut high = self.len();
        while low < high {
            let middle = low + (high - low) / 2;
            match compare(&self[middle]) {
                .Less => low = middle + 1,
                .Equal => return ?middle,
                .Greater => high = middle,
            }
        }
        null
    }

    pub fun lowerBoundBy(&self, compare: &Fun(&T) cmp::Ordering) usize {
        let mut low: usize = 0;
        let mut high = self.len();
        while low < high {
            let middle = low + (high - low) / 2;
            if compare(&self[middle]) is .Less {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        low
    }

    pub fun upperBoundBy(&self, compare: &Fun(&T) cmp::Ordering) usize {
        let mut low: usize = 0;
        let mut high = self.len();
        while low < high {
            let middle = low + (high - low) / 2;
            if compare(&self[middle]) is .Greater {
                high = middle;
            } else {
                low = middle + 1;
            }
        }
        low
    }

    pub fun equalRangeBy(&self, compare: &Fun(&T) cmp::Ordering) iter::Range[usize] {
        .init(self.lowerBoundBy(compare), self.upperBoundBy(compare))
    }

    pub fun partitionPoint(&self, predicate: &Fun(&T) bool) usize {
        let mut low: usize = 0;
        let mut high = self.len();
        while low < high {
            let middle = low + (high - low) / 2;
            if predicate(&self[middle]) {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        low
    }

    pub fun isSortedBy(&self, compare: &Fun(&T, &T) cmp::Ordering) bool {
        if self.len() < 2 {
            return true;
        }
        for index in 1..self.len() {
            if compare(&self[index], &self[index - 1]) is .Less {
                return false;
            }
        }
        true
    }
}

extend[T] [T]
where T: Sized + Ord[T]
{
    // Stable sort preserves the order of elements that compare equal.
    pub fun sort(&mut self) () {
        let compare = \left: &T, right: &T -> ordCompare(left, right);
        self.sortBy(&compare);
    }

    // In-place heapsort has O(n log n) worst-case time and constant auxiliary
    // memory. It is intentionally unstable.
    pub fun sortUnstable(&mut self) () {
        let compare = \left: &T, right: &T -> ordCompare(left, right);
        self.sortUnstableBy(&compare);
    }

    pub fun binarySearch(&self, value: &T) ?usize {
        let compare = \[value] item: &T -> ordCompare(item, value);
        self.binarySearchBy(&compare)
    }

    pub fun lowerBound(&self, value: &T) usize {
        let compare = \[value] item: &T -> ordCompare(item, value);
        self.lowerBoundBy(&compare)
    }

    pub fun upperBound(&self, value: &T) usize {
        let compare = \[value] item: &T -> ordCompare(item, value);
        self.upperBoundBy(&compare)
    }

    pub fun equalRange(&self, value: &T) iter::Range[usize] {
        .init(self.lowerBound(value), self.upperBound(value))
    }

    pub fun isSorted(&self) bool {
        let compare = \left: &T, right: &T -> ordCompare(left, right);
        self.isSortedBy(&compare)
    }
}

extend[T] [T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fun iter(&self) SliceIter[T] {
        .fromRawParts(self.ptr(), self.len())
    }
}

extend[T] &[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fun iter(&self) SliceIter[T] {
        .fromRawParts(self.*.ptr(), self.*.len())
    }
}

extend[T] &mut [T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fun iter(&self) SliceIter[T] {
        .fromRawParts(self.*.ptr(), self.*.len())
    }
}
