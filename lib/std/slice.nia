// Borrowed slice operations and iterators.
//
// Slice adapters never own or extend the lifetime of their backing storage.
// Allocator-taking operations return independent owned results.

using pkg::cmp;
using pkg::iter;
using pkg::iter::range;
using pkg::math;

pub struct SliceIter[T]
where T: Sized
{
    ptr: &T,
    len: usize,
    index: usize,
}

pub struct SliceIterMut[T]
where T: Sized
{
    ptr: &mut T,
    len: usize,
    index: usize,
}

pub struct SliceSplit[T]
where T: Sized + Eq[T]
{
    remaining: &[T],
    separator: &[T],
    done: bool,
}

extend[T] SliceIter[T]
where T: Sized
{
    fn fromRawParts(ptr: &T, len: usize) SliceIter[T] {
        Self { ptr, len, index: 0 }
    }

    pub fn len(&self) usize {
        self.len - self.index
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceIterMut[T]
where T: Sized
{
    fn fromRawParts(ptr: &mut T, len: usize) SliceIterMut[T] {
        Self { ptr, len, index: 0 }
    }

    pub fn len(&self) usize {
        self.len - self.index
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceSplit[T]
where T: Sized + Eq[T]
{
    fn init(items: &[T], separator: &[T]) SliceSplit[T] {
        Self { remaining: items, separator, done: false }
    }
}

extend[T] SliceIter[T] : Iterator
where T: Sized
{
    type Item = &T;

    pub fn next(&mut self) ?&T {
        if self.index >= self.len {
            null
        } else {
            let offset = match self.index.checked_mul(std::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checked_add(offset) {
                ?value => value,
                null => return null,
            };
            let item = address as &T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIter[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fn nextBack(&mut self) ?[SliceIter[T] as Iterator]::Item {
        if self.index >= self.len {
            null
        } else {
            self.len -= 1;
            let offset = match self.len.checked_mul(std::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checked_add(offset) {
                ?value => value,
                null => return null,
            };
            ?(address as &T)
        }
    }
}

extend[T] SliceIterMut[T] : Iterator
where T: Sized
{
    type Item = &mut T;

    pub fn next(&mut self) ?&mut T {
        if self.index >= self.len {
            null
        } else {
            let offset = match self.index.checked_mul(std::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checked_add(offset) {
                ?value => value,
                null => return null,
            };
            let item = address as &mut T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIterMut[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fn nextBack(&mut self) ?[SliceIterMut[T] as Iterator]::Item {
        if self.index >= self.len {
            null
        } else {
            self.len -= 1;
            let offset = match self.len.checked_mul(std::builtin::size[T]()) {
                ?value => value,
                null => return null,
            };
            let address = match (self.ptr as usize).checked_add(offset) {
                ?value => value,
                null => return null,
            };
            ?(address as &mut T)
        }
    }
}

extend[T] SliceSplit[T] : Iterator
where T: Sized + Eq[T]
{
    type Item = &[T];

    pub fn next(&mut self) ?&[T] {
        if self.done {
            return null;
        }
        if self.separator.isEmpty() {
            self.done = true;
            return ?self.remaining;
        }

        if self.remaining.find(self.separator) is ?index {
            let items = self.remaining;
            self.remaining = &items[(index + self.separator.len())..];
            ?&items[0..index]
        } else {
            self.done = true;
            ?self.remaining
        }
    }
}

extend[T] [T]
where T: Sized
{
    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn get(&self, index: usize) ?&T {
        if index >= self.len() {
            null
        } else {
            ?&self[index]
        }
    }

    pub fn getMut(&mut self, index: usize) ?&mut T {
        if index >= self.len() {
            null
        } else {
            ?&mut self[index]
        }
    }

    pub fn first(&self) ?&T {
        self.get(0)
    }

    pub fn firstMut(&mut self) ?&mut T {
        self.getMut(0)
    }

    pub fn last(&self) ?&T {
        if self.len() == 0 {
            null
        } else {
            self.get(self.len() - 1)
        }
    }

    pub fn lastMut(&mut self) ?&mut T {
        if self.len() == 0 {
            null
        } else {
            self.getMut(self.len() - 1)
        }
    }

    pub fn getRange(&self, start: usize, end: usize) ?&[T] {
        if start > end or end > self.len() {
            null
        } else {
            ?&self[start..end]
        }
    }

    pub fn getRangeMut(&mut self, start: usize, end: usize) ?&mut [T] {
        if start > end or end > self.len() {
            null
        } else {
            ?&mut self[start..end]
        }
    }

    pub fn copyFrom(&mut self, source: &[T]) usize {
        let mut count = self.len();
        if source.len() < count {
            count = source.len();
        }
        std::builtin::memmove(&mut self[0..count], &source[0..count]);
        count
    }

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.ptr(), self.len())
    }

    pub fn iterMut(&mut self) SliceIterMut[T] {
        SliceIterMut[T]::fromRawParts(self.ptrMut(), self.len())
    }
}

extend[T] [T]
where T: Sized + Eq[T]
{
    pub fn equals(&self, other: &[T]) bool {
        if self.len() != other.len() {
            return false;
        }

        for index in 0..self.len() {
            if self[index] != other[index] {
                return false;
            }
        }
        true
    }

    pub fn startsWith(&self, prefix: &[T]) bool {
        if prefix.len() > self.len() {
            return false;
        }
        (&self[0..prefix.len()]).equals(prefix)
    }

    pub fn endsWith(&self, suffix: &[T]) bool {
        if suffix.len() > self.len() {
            return false;
        }
        (&self[(self.len() - suffix.len())..]).equals(suffix)
    }

    pub fn find(&self, needle: &[T]) ?usize {
        if needle.isEmpty() {
            return ?0;
        }
        if needle.len() > self.len() {
            return null;
        }

        let lastStart = self.len() - needle.len();
        for index in 0..=lastStart {
            if (&self[index..(index + needle.len())]).equals(needle) {
                return ?index;
            }
        }
        null
    }

    pub fn contains(&self, needle: &[T]) bool {
        if self.find(needle) is ?index {
            _ = index;
            true
        } else {
            false
        }
    }

    pub fn split(&self, separator: &[T]) SliceSplit[T] {
        SliceSplit[T]::init(self, separator)
    }
}

extend[T] [T]
where T: Sized + Ord[T]
{
    pub fn compare(&self, other: &[T]) cmp::Ordering {
        let mut len = self.len();
        if other.len() < len {
            len = other.len();
        }

        for index in 0..len {
            if self[index] < other[index] {
                return cmp::Ordering::Less;
            }
            if self[index] > other[index] {
                return cmp::Ordering::Greater;
            }
        }

        if self.len() < other.len() {
            cmp::Ordering::Less
        } else if self.len() > other.len() {
            cmp::Ordering::Greater
        } else {
            cmp::Ordering::Equal
        }
    }
}

extend[T] [T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.ptr(), self.len())
    }
}

extend[T] &[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.*.ptr(), self.*.len())
    }
}

extend[T] &mut [T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.*.ptr(), self.*.len())
    }
}
