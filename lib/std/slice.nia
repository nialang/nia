using pkg::iter;

pub struct SliceIter[T]
where T: Sized
{
    ptr: &T,
    len: usize,
    index: usize,
}

pub struct SliceIterMut[T]
where T: Sized
{
    ptr: &mut T,
    len: usize,
    index: usize,
}

extend[T] SliceIter[T]
where T: Sized
{
    pub fn init(items: &[T]) SliceIter[T] {
        { ptr: items.ptr(), len: items.len(), index: 0 }
    }

    pub fn from_raw_parts(ptr: &T, len: usize) SliceIter[T] {
        { ptr: ptr, len: len, index: 0 }
    }

    pub fn len(&self) usize {
        self.len - self.index
    }

    pub fn is_empty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceIterMut[T]
where T: Sized
{
    pub fn init(items: &mut [T]) SliceIterMut[T] {
        { ptr: items.ptr_mut(), len: items.len(), index: 0 }
    }

    pub fn from_raw_parts(ptr: &mut T, len: usize) SliceIterMut[T] {
        { ptr: ptr, len: len, index: 0 }
    }

    pub fn len(&self) usize {
        self.len - self.index
    }

    pub fn is_empty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceIter[T] : Iterator
where T: Sized
{
    type Item = &T;

    pub fn next(&mut self) ?&T {
        if self.index >= self.len {
            null
        } else {
            let item = (self.ptr as usize + self.index * std::builtin::size[T]()) as &T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIter[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fn next_back(&mut self) ?&T {
        if self.index >= self.len {
            null
        } else {
            self.len -= 1usize;
            ?((self.ptr as usize + self.len * std::builtin::size[T]()) as &T)
        }
    }
}

extend[T] SliceIter[T]
where T: Sized
{
    pub fn rev(self) iter::Rev[SliceIter[T]] {
        iter::Rev[SliceIter[T]]::init(self)
    }
}

extend[T] SliceIterMut[T] : Iterator
where T: Sized
{
    type Item = &mut T;

    pub fn next(&mut self) ?&mut T {
        if self.index >= self.len {
            null
        } else {
            let item = (self.ptr as usize + self.index * std::builtin::size[T]()) as &mut T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIterMut[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fn next_back(&mut self) ?&mut T {
        if self.index >= self.len {
            null
        } else {
            self.len -= 1usize;
            ?((self.ptr as usize + self.len * std::builtin::size[T]()) as &mut T)
        }
    }
}

extend[T] SliceIterMut[T]
where T: Sized
{
    pub fn rev(self) iter::Rev[SliceIterMut[T]] {
        iter::Rev[SliceIterMut[T]]::init(self)
    }
}

extend[T] [T]
where T: Sized
{
    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::from_raw_parts(self.ptr(), self.len())
    }

    pub fn iter_mut(&mut self) SliceIterMut[T] {
        SliceIterMut[T]::from_raw_parts(self.ptr_mut(), self.len())
    }
}

extend[T] [T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::from_raw_parts(self.ptr(), self.len())
    }
}
