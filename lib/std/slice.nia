using pkg::iter;

pub struct SliceIter[T]
where T: Sized
{
    ptr: &T,
    len: usize,
    index: usize,
}

pub struct SliceIterMut[T]
where T: Sized
{
    ptr: &mut T,
    len: usize,
    index: usize,
}

extend[T] SliceIter[T]
where T: Sized
{
    fn fromRawParts(ptr: &T, len: usize) SliceIter[T] {
        { ptr: ptr, len: len, index: 0 }
    }

    pub fn len(&self) usize {
        self.len - self.index
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceIterMut[T]
where T: Sized
{
    fn fromRawParts(ptr: &mut T, len: usize) SliceIterMut[T] {
        { ptr: ptr, len: len, index: 0 }
    }

    pub fn len(&self) usize {
        self.len - self.index
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }
}

extend[T] SliceIter[T] : Iterator
where T: Sized
{
    type Item = &T;

    pub fn next(&mut self) ?&T {
        if self.index >= self.len {
            null
        } else {
            let item = (self.ptr as usize + self.index * std::builtin::size[T]()) as &T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIter[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fn nextBack(&mut self) ?[SliceIter[T] as Iterator]::Item {
        if self.index >= self.len {
            null
        } else {
            self.len -= 1;
            ?((self.ptr as usize + self.len * std::builtin::size[T]()) as &T)
        }
    }
}

extend[T] SliceIterMut[T] : Iterator
where T: Sized
{
    type Item = &mut T;

    pub fn next(&mut self) ?&mut T {
        if self.index >= self.len {
            null
        } else {
            let item = (self.ptr as usize + self.index * std::builtin::size[T]()) as &mut T;
            self.index += 1;
            ?item
        }
    }
}

extend[T] SliceIterMut[T] : iter::DoubleEndedIterator
where T: Sized
{
    pub fn nextBack(&mut self) ?[SliceIterMut[T] as Iterator]::Item {
        if self.index >= self.len {
            null
        } else {
            self.len -= 1;
            ?((self.ptr as usize + self.len * std::builtin::size[T]()) as &mut T)
        }
    }
}

extend[T] [T]
where T: Sized
{
    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn get(&self, index: usize) ?&T {
        if index >= self.len() {
            null
        } else {
            ?&self[index]
        }
    }

    pub fn getMut(&mut self, index: usize) ?&mut T {
        if index >= self.len() {
            null
        } else {
            ?&mut self[index]
        }
    }

    pub fn first(&self) ?&T {
        self.get(0)
    }

    pub fn firstMut(&mut self) ?&mut T {
        self.getMut(0)
    }

    pub fn last(&self) ?&T {
        if self.len() == 0 {
            null
        } else {
            self.get(self.len() - 1)
        }
    }

    pub fn lastMut(&mut self) ?&mut T {
        if self.len() == 0 {
            null
        } else {
            self.getMut(self.len() - 1)
        }
    }

    pub fn getRange(&self, start: usize, end: usize) ?&[T] {
        if start > end or end > self.len() {
            null
        } else {
            ?&self[start..end]
        }
    }

    pub fn getRangeMut(&mut self, start: usize, end: usize) ?&mut [T] {
        if start > end or end > self.len() {
            null
        } else {
            ?&mut self[start..end]
        }
    }

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.ptr(), self.len())
    }

    pub fn iterMut(&mut self) SliceIterMut[T] {
        SliceIterMut[T]::fromRawParts(self.ptr_mut(), self.len())
    }
}

extend[T] [T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.ptr(), self.len())
    }
}

extend[T] &[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.*.ptr(), self.*.len())
    }
}

extend[T] &mut [T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = SliceIter[T];

    pub fn iter(&self) SliceIter[T] {
        SliceIter[T]::fromRawParts(self.*.ptr(), self.*.len())
    }
}
