// Non-short-circuiting cleanup error accumulation.
//
//     attempt(a); attempt(b); finish()
//       run a       run b       report first failure
//
// The accumulator records the first failure without allocating. Resource
// ownership stays with each operation, so a failed owner remains available for
// a later deinit retry.
//
// An owner that tracks its own liveness stays active when `deinit` returns an
// error and is marked inactive only after cleanup succeeds, preserving a valid
// retry path. `if value is pattern` follows the same ownership model as
// `match`.

using root::option;

pub struct CleanupAccumulator[Failure] {
    firstFailure: ?Failure,
}

extend[Failure] CleanupAccumulator[Failure] {
    // Start an empty, allocation-free cleanup report.
    pub fun init() CleanupAccumulator[Failure] {
        .{ firstFailure: null }
    }

    // Record a failure while always allowing the caller to attempt later work.
    pub fun attempt(&mut self, result: Failure!()) () {
        if result is err! and self.firstFailure is null {
            self.firstFailure = ?err;
        }
    }

    // Query whether every attempted cleanup has succeeded so far.
    pub fun isClean(&self) bool {
        self.firstFailure.isNull()
    }

    // Return the first recorded failure after all cleanup attempts are complete.
    pub fun finish(self) Failure!() {
        if self.firstFailure is ?err { err! } else { !() }
    }
}
