// Nia standard prelude.
//
// This module is automatically wildcard-imported into every module at the
// lowest lookup priority. Keep canonical definitions in their owning modules
// and re-export only names that should be ambient language vocabulary.

pub using pkg::builtin::{
    Add,
    BitAnd,
    BitNot,
    BitOr,
    BitXor,
    Char,
    Deref,
    DerefMut,
    Div,
    End,
    Eq,
    Index,
    IndexMut,
    Iterable,
    Iterator,
    Len,
    Mul,
    Neg,
    Not,
    Ord,
    Ptr,
    PtrMut,
    Rem,
    Shl,
    Shr,
    Sized,
    Slice,
    SliceMut,
    Start,
    Sub,
    Unsized,
    align,
    asm,
    atomic_load,
    atomic_rmw,
    atomic_store,
    bitmask,
    clz,
    cmpxchg_strong,
    cmpxchg_weak,
    ctz,
    embed,
    error,
    extract,
    fence,
    insert,
    load_unaligned,
    memcpy,
    memmove,
    memset,
    offset,
    popcount,
    size,
    splat,
    trap,
};
