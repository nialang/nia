using entry;
using pkg::io;
using pkg::os;
using pkg::process;

fn call_user_main(init: process::Init) process::ExitCode {
    if let !ok = entry::main(init) {
        _ = ok;
        process::ExitCode::Success
    } else error! {
        error
    }
}

extern fn nia_start_stack(stack: &usize) void {
    let argc = stack.*;
    let argv = (stack as usize + @size[usize]()) as &&u8;
    let envp = (stack as usize + @size[usize]() * (argc + 2)) as &&u8;
    let mut runtime_io = io::BlockingIo::init();
    let init = process::Init::init(argc, argv, envp, &mut runtime_io);
    let exit = call_user_main(init);
    os::exit(exit as i32);
    loop {}
}

@[naked]
pub extern fn _start() void {
    @asm({
        code:
            b\\mov rdi, rsp
            \\call nia_start_stack
            \\ud2
        ,
        clobbers: [b"rdi", b"rax", b"rcx", b"r11", b"memory"],
        options: [b"volatile"],
    });
    loop {}
}
