// Small, composable assertions and an explicit in-process test runner.
//
// A failed assertion is an ordinary typed error. Test runners can attach
// context, accumulate failures, or convert it to their own suite result
// without requiring a language-level test attribute or process trap.

using root::fmt;
using root::builtin::IntoError;
using root::mem;
using root::source::{SourceLocation, callerLocation};

pub(root) module failing_allocator;
using root::test::failing_allocator;
pub using failing_allocator::FailingAllocator;

pub enum Error {
    AssertionFailed(SourceLocation) = 1,
    ValuesEqual(SourceLocation) = 2,
    ValuesNotEqual(SourceLocation) = 3,
    Memory(mem::Error) = 4,
}

// Preserve the allocation cause. Errors that own rollback resources must be
// handled by the test before propagation rather than converted generically.
extend mem::Error : IntoError[Error] {
    const fun intoError(self) Error { .Memory(self) }
}

extend Error : fmt::Format {
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        match self.* {
            .AssertionFailed(location) => {
                location.format(formatter).?;
                formatter.writeText(": assertion failed")
            },
            .ValuesEqual(location) => {
                location.format(formatter).?;
                formatter.writeText(": values are equal")
            },
            .ValuesNotEqual(location) => {
                location.format(formatter).?;
                formatter.writeText(": values are not equal")
            },
            .Memory(cause) => {
                formatter.writeText("memory operation failed (mem::Error ").?;
                formatter.writeSigned(cause as i32 as i128).?;
                formatter.writeText(")")
            },
        }
    }
}

pub enum CaseStatus: i32 {
    Passed = 0,
    Failed = 1,
    Skipped = 2,
    _
}

// One named test function. The runner borrows the record, name, and callback,
// so a suite can keep its case table in static storage.
pub struct Case {
    name: &[char],
    callback: &Fun() Error!(),
}

pub struct CaseResult {
    name: &[char],
    status: CaseStatus,
    error: ?Error,
}

pub struct RunSummary {
    total: usize,
    passed: usize,
    failed: usize,
    skipped: usize,
}

// Runs a borrowed, caller-owned case table and returns a RunSummary. It
// continues after failures unless `withFailFast` is selected, and performs no
// hidden allocation or file discovery.
pub struct Runner {
    cases: &[Case],
    failFast: bool,
}

fun ignoreResult(result: CaseResult) () {
    _ = result;
    ()
}

extend Case {
    pub fun init(name: &[char], callback: &Fun() Error!()) Case {
        .{ name, callback }
    }

    pub fun name(&self) &[char] {
        self.name
    }

    pub fun run(&self) CaseResult {
        match (self.callback)() {
            !() => .{ name: self.name, status: .Passed, error: null },
            error! => .{ name: self.name, status: .Failed, error: ?error },
        }
    }
}

extend CaseResult {
    fun skipped(name: &[char]) CaseResult {
        .{ name: name, status: .Skipped, error: null }
    }

    pub fun name(&self) &[char] {
        self.name
    }

    pub fun status(&self) CaseStatus {
        self.status
    }

    pub fun error(&self) ?Error {
        self.error
    }

    pub fun isPassed(&self) bool {
        if self.status is (.Passed) { true } else { false }
    }

    pub fun isFailed(&self) bool {
        if self.status is (.Failed) { true } else { false }
    }

    pub fun isSkipped(&self) bool {
        if self.status is (.Skipped) { true } else { false }
    }
}

extend RunSummary {
    pub fun init() RunSummary {
        .{ total: 0, passed: 0, failed: 0, skipped: 0 }
    }

    pub fun total(&self) usize {
        self.total
    }

    pub fun passed(&self) usize {
        self.passed
    }

    pub fun failed(&self) usize {
        self.failed
    }

    pub fun skipped(&self) usize {
        self.skipped
    }

    pub fun isSuccessful(&self) bool {
        self.failed == 0
    }
}

extend Runner {
    pub fun init(cases: &[Case]) Runner {
        .{ cases, failFast: false }
    }

    pub fun withFailFast(self) Runner {
        .{ cases: self.cases, failFast: true }
    }

    pub fun run(self) RunSummary {
        self.runWith(&ignoreResult)
    }

    // Run every selected case and report each result to a caller-owned
    // callback. A mutable callable view lets reporters accumulate output or
    // counters in explicitly borrowed state without requiring allocation.
    pub fun runWith(self, reporter: &mut Fun(CaseResult) ()) RunSummary {
        let mut summary = RunSummary::init();
        let mut index: usize = 0;
        while index < self.cases.len() {
            let case = &self.cases[index];
            if self.failFast and summary.failed != 0 {
                reporter(CaseResult::skipped(case.name));
                summary.skipped += 1;
                index += 1;
                continue;
            }
            let result = case.run();
            let passed = result.isPassed();
            reporter(result);
            if passed {
                summary.passed += 1;
            } else {
                summary.failed += 1;
            }
            index += 1;
        }
        summary.total = summary.passed + summary.failed + summary.skipped;
        summary
    }
}

@[trackCaller]
pub fun expect(condition: bool) Error!() {
    if not condition {
        return .AssertionFailed(callerLocation())!;
    }
    !()
}

@[trackCaller]
pub fun expectEqual[T](actual: T, expected: T) Error!()
where T: Eq[T]
{
    if actual != expected {
        return .ValuesNotEqual(callerLocation())!;
    }
    !()
}

@[trackCaller]
pub fun expectNotEqual[T](actual: T, expected: T) Error!()
where T: Eq[T]
{
    if actual == expected {
        return .ValuesEqual(callerLocation())!;
    }
    !()
}

@[trackCaller]
pub fun fail() Error!() {
    .AssertionFailed(callerLocation())!
}

// The value of a successful result, or a failed assertion at the caller.
// The result's error type is not converted, so any error union can be
// checked without an `IntoError` implementation.
@[trackCaller]
pub fun expectOk[T, E](result: E!T) Error!T {
    match result {
        !value => !value,
        _! => .AssertionFailed(callerLocation())!,
    }
}

// The error of a failed result, or a failed assertion at the caller when
// the result succeeded. Pair it with `expectEqual` to check which error.
@[trackCaller]
pub fun expectError[T, E](result: E!T) Error!E {
    match result {
        !_ => .AssertionFailed(callerLocation())!,
        error! => !error,
    }
}

// The value of a present optional, or a failed assertion at the caller.
@[trackCaller]
pub fun expectSome[T](optional: ?T) Error!T {
    match optional {
        ?value => !value,
        null => .AssertionFailed(callerLocation())!,
    }
}

// A failed assertion at the caller unless `optional` is `null`.
@[trackCaller]
pub fun expectNull[T](optional: ?T) Error!() {
    if optional is ?_ {
        return .AssertionFailed(callerLocation())!;
    }
    !()
}
