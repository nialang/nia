// Compiler-backed operations exposed through the standard library.
//
// Submodules hold the source-level API shape and documentation. The root
// module re-exports the public builtin vocabulary so callers can use stable
// paths such as `std::builtin::size`.

pub module atomic;
pub module bits;
pub module control;
pub module error;
pub module iter;
pub module layout;
pub module marker;
pub module mem;
pub module ops;
pub module place;
pub module primitive;
pub module simd;
pub module target;

using root::builtin::atomic;
using root::builtin::bits;
using root::builtin::control;
using root::builtin::error as errorBuiltin;
using root::builtin::iter;
using root::builtin::layout;
using root::builtin::marker;
using root::builtin::mem;
using root::builtin::ops;
using root::builtin::place;
using root::builtin::primitive;
using root::builtin::simd;
using root::builtin::target;
using root::source;

pub using atomic::{
    atomicLoad,
    atomicRmw,
    atomicStore,
    cmpxchgStrong,
    cmpxchgWeak,
    fence,
};
pub using bits::{clz, ctz, popcount};
pub using control::{AsmConfig, AsmInputs, AsmOutputs, asm, embed, error, trap};
pub using errorBuiltin::IntoError;
pub using iter::{Iterable, Iterator};
pub using layout::{align, offset, size};
pub using marker::{Sized, Unsized};
pub using mem::{loadUnaligned, memcpy, memmove, memset};
pub using ops::{
    Add,
    BitAnd,
    BitNot,
    BitOr,
    BitXor,
    Div,
    Eq,
    Mul,
    Neg,
    Not,
    Ord,
    Rem,
    Shl,
    Shr,
    Sub,
};
pub using place::{
    Deref,
    DerefMut,
    Index,
    IndexMut,
    Len,
    Slice,
    SliceMut,
};
pub using primitive::charFromU32;
pub using simd::{bitmask, extract, insert, splat};
pub using source::callerLocation;
