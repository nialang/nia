// Compiler-backed operations exposed through the standard library.
//
// Submodules hold the source-level API shape and documentation. The root
// module re-exports the public builtin vocabulary so callers can use stable
// paths such as `std::builtin::size`.

pub module atomic;
pub module bits;
pub module control;
pub module iter;
pub module layout;
pub module marker;
pub module mem;
pub module ops;
pub module place;
pub module primitive;
pub module simd;
pub module target;

using pkg::builtin::atomic;
using pkg::builtin::bits;
using pkg::builtin::control;
using pkg::builtin::iter;
using pkg::builtin::layout;
using pkg::builtin::marker;
using pkg::builtin::mem;
using pkg::builtin::ops;
using pkg::builtin::place;
using pkg::builtin::primitive;
using pkg::builtin::simd;
using pkg::builtin::target;

pub using atomic::{
    atomic_load,
    atomic_rmw,
    atomic_store,
    cmpxchg_strong,
    cmpxchg_weak,
    fence,
};
pub using bits::{clz, ctz, popcount};
pub using control::{AsmConfig, AsmInputs, AsmOutputs, asm, embed, error, trap};
pub using iter::{Iterable, Iterator};
pub using layout::{align, offset, size};
pub using marker::{Sized, Unsized};
pub using mem::{load_unaligned, memcpy, memmove, memset};
pub using ops::{
    Add,
    BitAnd,
    BitNot,
    BitOr,
    BitXor,
    Div,
    Eq,
    Mul,
    Neg,
    Not,
    Ord,
    Rem,
    Shl,
    Shr,
    Sub,
};
pub using place::{
    Deref,
    DerefMut,
    Index,
    IndexMut,
    Len,
    Slice,
    SliceMut,
};
pub using primitive::charFromU32;
pub using simd::{bitmask, extract, insert, splat};
