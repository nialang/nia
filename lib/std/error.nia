// Typed error conversion and cleanup operations.
//
// `IntoError` is an infallible cause-preserving conversion used by `.?`.
// `cleanupAfter` combines an already-produced result with eagerly evaluated
// cleanup while keeping the operation failure primary.

pub module cleanup;

using pkg::error::cleanup;

pub using cleanup::CleanupAccumulator;

pub trait IntoError[Target] {
    const fn intoError(self) Target;
}

extend[Value, Failure] Failure!Value {
    // Combine a primary operation with cleanup that runs in either case.
    //
    //     operation     cleanup       result
    //     success       success       operation value
    //     success       failure       cleanup failure
    //     failure       success       operation failure
    //     failure       failure       operation failure
    //
    // Arguments are evaluated before a call, so `cleanup` has already run even
    // when `self` is a failure. This method combines results; resource retry
    // remains with the owner whose cleanup failed.
    pub fn cleanupAfter(self, cleanup: Failure!()) Failure!Value {
        match self {
            !value => {
                cleanup.?;
                !value
            },
            failure! => {
                _ = cleanup;
                failure!
            },
        }
    }
}
