// Typed error conversion and recovery operations.
//
// `IntoError` is an infallible cause-preserving conversion used by `.?`.
// `mapError` and `orElse` evaluate the receiver once and borrow their callback
// only for the active call; contextual domain information remains explicit.
// `cleanupAfter` combines an already-produced result with eagerly evaluated
// cleanup while keeping the operation failure primary.
// `map` transforms only a success payload, while `andThen` continues with a
// callback that returns another value in the same error union.

pub module cleanup;

using pkg::error::cleanup;

pub using cleanup::CleanupAccumulator;

pub trait IntoError[Target] {
    const fn intoError(self) Target;
}

extend[Value, Source] Source!Value {
    // Expose the active case when a boolean must be composed. Use an if-pattern
    // when the branch immediately consumes the success or error payload.
    pub fn isSuccess(&self) bool {
        let result = self.*;
        if result is !_ { true } else { false }
    }

    pub fn isError(&self) bool {
        let result = self.*;
        if result is _! { true } else { false }
    }

    // Transform a successful payload without touching the error path.
    pub fn map[Mapped](self, mapper: &Fn(Value) Mapped) Source!Mapped {
        match self {
            !value => {
                !mapper(value)
            },
            error! => {
                error!
            },
        }
    }

    // Continue a successful operation while preserving the original error.
    pub fn andThen[Mapped](self, next: &Fn(Value) Source!Mapped) Source!Mapped {
        match self {
            !value => {
                next(value)
            },
            error! => {
                error!
            },
        }
    }
}

extend[Value, Source, Target] Source!Value {
    pub fn mapError(self, mapper: &Fn(Source) Target) Target!Value {
        match self {
            !value => {
                !value
            },
            error! => {
                mapper(error)!
            },
        }
    }

    pub fn orElse(self, fallback: &Fn(Source) Target!Value) Target!Value {
        match self {
            !value => {
                !value
            },
            error! => {
                fallback(error)
            },
        }
    }
}

extend[Value, Failure] Failure!Value {
    // Combine a primary operation with cleanup that must run in either case.
    //
    //     operation     cleanup       result
    //     success       success       operation value
    //     success       failure       cleanup failure
    //     failure       success       operation failure
    //     failure       failure       operation failure
    //
    // Arguments are evaluated before a call, so `cleanup` has already run even
    // when `self` is a failure. This method combines results; it does not own or
    // retry resources whose cleanup failed.
    pub fn cleanupAfter(self, cleanup: Failure!()) Failure!Value {
        match self {
            !value => {
                cleanup.?;
                !value
            },
            failure! => {
                _ = cleanup;
                failure!
            },
        }
    }
}
