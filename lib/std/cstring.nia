using root::collections;
using root::builtin;
using root::fmt;
using root::math;
using root::mem;
using root::option;
using root::parse;
using root::slice;

pub enum CStringError: i32 {
    EmptyInput = 1,
    MissingTerminator = 2,
    InteriorNul = 3,
}

pub enum CStringBuildError {
    ContainsNul,
    Allocation(mem::Error),
}

extend mem::Error : builtin::IntoError[CStringBuildError] {
    const fun intoError(self) CStringBuildError {
        CStringBuildError::Allocation(self)
    }
}

pub struct CStringView {
    ptr: &u8,
    len: usize,
}

pub struct CString {
    bytes: collections::ArrayList[u8],
}

extend CString {
    pub fun init(allocator: &mut mem::Allocator) CStringBuildError!CString {
        let mut bytes = collections::ArrayList[u8]::initCapacity(allocator, 1).?;
        bytes.appendAssumeCapacity(0);
        !.{ bytes }
    }

    pub fun fromBytes(allocator: &mut mem::Allocator, bytes: &[u8]) CStringBuildError!CString {
        for &byte in bytes {
            if byte == 0 {
                return .ContainsNul!;
            }
        }
        let capacity = bytes.len().checkedAdd(1).okOr(mem::Error::OutOfMemory).?;
        let mut output = collections::ArrayList[u8]::initCapacity(allocator, capacity).?;
        output.appendSliceAssumeCapacity(bytes);
        output.appendAssumeCapacity(0);
        !.{ bytes: output }
    }

    pub fun fromView(allocator: &mut mem::Allocator, view: CStringView) CStringBuildError!CString {
        CString::fromBytes(allocator, view.bytes())
    }

    pub fun fromText(allocator: &mut mem::Allocator, text: &[char]) CStringBuildError!CString {
        let mut byteLen: usize = 0;
        for &ch in text {
            if ch.codepoint() == 0 {
                return .ContainsNul!;
            }
            byteLen = byteLen.checkedAdd(ch.encodeUtf8().byteLen())
                .okOr(mem::Error::OutOfMemory).?;
        }
        let capacity = byteLen.checkedAdd(1).okOr(mem::Error::OutOfMemory).?;
        let mut output = collections::ArrayList[u8]::initCapacity(allocator, capacity).?;
        for &ch in text {
            output.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
        }
        output.appendAssumeCapacity(0);
        !.{ bytes: output }
    }

    pub fun view(&self) CStringView {
        .fromParts(self.bytes.asSlice().ptr(), self.len())
    }

    pub fun rawPtr(&self) &u8 {
        self.bytes.asSlice().ptr()
    }

    pub fun bytes(&self) &[u8] {
        &self.bytes.asSlice()[0..self.bytes.len() - 1]
    }

    pub fun nulTerminatedBytes(&self) &[u8] {
        self.bytes.asSlice()
    }

    pub fun len(&self) usize {
        self.bytes.len() - 1
    }

    pub fun isEmpty(&self) bool {
        self.len() == 0
    }

    pub fun deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.bytes.deinit(allocator)
    }
}

extend CStringView {
    fun fromParts(ptr: &u8, len: usize) CStringView {
        .{ ptr, len }
    }

    // Startup arguments arrive with a guaranteed NUL terminator. This internal
    // boundary records that length; external data should use `fromBytes` for
    // bounded validation.
    pub(root) fun fromTerminatedPtr(ptr: &u8) CStringView {
        let mut len: usize = 0;
        while ptr[len] != 0 {
            len += 1;
        }
        .fromParts(ptr, len)
    }

    pub fun fromBytes(bytes: &[u8]) CStringError!CStringView {
        if bytes.len() == 0 {
            return .EmptyInput!;
        }
        if bytes[bytes.len() - 1] != 0 {
            return .MissingTerminator!;
        }
        for &byte in &bytes[0..bytes.len() - 1] {
            if byte == 0 {
                return .InteriorNul!;
            }
        }
        !.fromParts(bytes.ptr(), bytes.len() - 1)
    }

    pub fun rawPtr(&self) &u8 {
        self.ptr
    }

    pub fun len(&self) usize {
        self.len
    }

    pub fun bytes(&self) &[u8] {
        & self.ptr[0..self.len()]
    }

    pub fun nulTerminatedBytes(&self) &[u8] {
        &self.ptr[0..self.len + 1]
    }

    pub fun isEmpty(&self) bool {
        self.len() == 0
    }

    pub fun parse[T](self) [T as parse::From[CStringView]]::Error!T
    where T: parse::From[CStringView]
    {
        [T]::from(self)
    }

    pub fun parseRadix[T](self, radix: u32) [T as parse::FromRadix[CStringView]]::Error!T
    where T: parse::FromRadix[CStringView]
    {
        [T]::fromRadix(self, radix)
    }
}

extend CString : fmt::Format {
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.view().format(formatter)
    }

    fun formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.view().formatSpec(formatter, spec)
    }
}

extend CStringView : fmt::Format {
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        formatter.writeBytes(self.bytes())
    }

    fun formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        if spec.presentation() != fmt::FormatPresentation::Display or spec.signPlus() or spec.alternate() {
            return .InvalidTemplate!;
        }
        let contentWidth = formatter.precisionWidth(self.len(), spec);
        formatter.writePaddingBefore(contentWidth, spec).?;
        let bytes = self.bytes();
        let mut index: usize = 0;
        while index < bytes.len() and index < contentWidth {
            formatter.writeByte(bytes[index]).?;
            index += 1;
        }
        formatter.writePaddingAfter(contentWidth, spec)
    }
}

extend[T] T : parse::From[CStringView]
where T: parse::From[&[u8]]
{
    type Error = [T as parse::From[&[u8]]]::Error;

    fun from(input: CStringView) [T as parse::From[CStringView]]::Error!T {
        input.bytes().parse[T]()
    }
}

extend[T] T : parse::FromRadix[CStringView]
where T: parse::FromRadix[&[u8]]
{
    type Error = [T as parse::FromRadix[&[u8]]]::Error;

    fun fromRadix(input: CStringView, radix: u32) [T as parse::FromRadix[CStringView]]::Error!T {
        input.bytes().parseRadix[T](radix)
    }
}
