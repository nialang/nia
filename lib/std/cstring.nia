using pkg::fmt;

pub struct CStringView {
    ptr: &u8,
}

extend CStringView {
    pub fn from_ptr(ptr: &u8) CStringView {
        { ptr: ptr }
    }

    pub fn from_bytes(bytes: &[u8]) ?CStringView {
        if bytes.len() == 0usize {
            return null;
        }
        if bytes[bytes.len() - 1usize] != 0u8 {
            return null;
        }
        ?CStringView::from_ptr(bytes.ptr())
    }

    pub fn raw_ptr(&self) &u8 {
        self.ptr
    }

    pub fn len(&self) usize {
        let mut len = 0usize;
        while self.ptr[len] != 0u8 {
            len += 1usize;
        }
        len
    }

    pub fn bytes(&self) &[u8] {
        & self.ptr[0..self.len()]
    }

    pub fn is_empty(&self) bool {
        self.len() == 0usize
    }
}

extend CStringView : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        formatter.write_bytes(self.bytes())
    }

    fn format_spec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!void {
        if spec.presentation() != fmt::FormatPresentation::Display or spec.sign_plus() or spec.alternate() {
            return fmt::Error::InvalidTemplate!;
        }
        let content_width = formatter.precision_width(self.len(), spec);
        formatter.write_padding_before(content_width, spec).?;
        let bytes = self.bytes();
        let mut index = 0usize;
        while index < bytes.len() and index < content_width {
            formatter.write_byte(bytes[index]).?;
            index += 1usize;
        }
        formatter.write_padding_after(content_width, spec)
    }
}

extend[T] T : fmt::ParseFrom[CStringView]
where T: fmt::ParseFrom[&[u8]]
{
    fn parse_from(input: CStringView) fmt::ParseError!T {
        fmt::parse[T, &[u8]](input.bytes())
    }

    fn parse_radix_from(input: CStringView, radix: u32) fmt::ParseError!T {
        fmt::parse_radix[T, &[u8]](input.bytes(), radix)
    }
}
