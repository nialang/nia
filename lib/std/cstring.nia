using pkg::collections;
using pkg::error;
using pkg::fmt;
using pkg::math;
using pkg::mem;
using pkg::parse;
using pkg::slice;

pub enum CStringError: i32 {
    EmptyInput = 1,
    MissingTerminator = 2,
    InteriorNul = 3,
}

pub enum CStringBuildError {
    ContainsNul,
    Allocation(mem::Error),
}

extend mem::Error : error::IntoError[CStringBuildError] {
    const fn intoError(self) CStringBuildError {
        CStringBuildError::Allocation(self)
    }
}

pub struct CStringView {
    ptr: &u8,
    len: usize,
}

pub struct CString {
    bytes: collections::ArrayList[u8],
}

extend CString {
    pub fn init(allocator: &mut mem::Allocator) CStringBuildError!CString {
        let mut bytes = collections::ArrayList[u8]::initCapacity(allocator, 1).?;
        bytes.appendAssumeCapacity(0);
        !CString { bytes: bytes }
    }

    pub fn fromBytes(allocator: &mut mem::Allocator, bytes: &[u8]) CStringBuildError!CString {
        for &byte in bytes {
            if byte == 0 {
                return CStringBuildError::ContainsNul!;
            }
        }
        let capacity = match bytes.len().checkedAdd(1) {
            ?value => value,
            null => return CStringBuildError::Allocation(mem::Error::OutOfMemory)!,
        };
        let mut output = collections::ArrayList[u8]::initCapacity(allocator, capacity).?;
        output.appendSliceAssumeCapacity(bytes);
        output.appendAssumeCapacity(0);
        !CString { bytes: output }
    }

    pub fn fromView(allocator: &mut mem::Allocator, view: CStringView) CStringBuildError!CString {
        CString::fromBytes(allocator, view.bytes())
    }

    pub fn fromText(allocator: &mut mem::Allocator, text: &[char]) CStringBuildError!CString {
        let mut byteLen: usize = 0;
        for &ch in text {
            if ch.codepoint() == 0 {
                return CStringBuildError::ContainsNul!;
            }
            byteLen = match byteLen.checkedAdd(ch.encodeUtf8().byteLen()) {
                ?value => value,
                null => return CStringBuildError::Allocation(mem::Error::OutOfMemory)!,
            };
        }
        let capacity = match byteLen.checkedAdd(1) {
            ?value => value,
            null => return CStringBuildError::Allocation(mem::Error::OutOfMemory)!,
        };
        let mut output = collections::ArrayList[u8]::initCapacity(allocator, capacity).?;
        for &ch in text {
            output.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
        }
        output.appendAssumeCapacity(0);
        !CString { bytes: output }
    }

    pub fn view(&self) CStringView {
        CStringView::fromParts(self.bytes.asSlice().ptr(), self.len())
    }

    pub fn rawPtr(&self) &u8 {
        self.bytes.asSlice().ptr()
    }

    pub fn bytes(&self) &[u8] {
        &self.bytes.asSlice()[0..self.bytes.len() - 1]
    }

    pub fn nulTerminatedBytes(&self) &[u8] {
        self.bytes.asSlice()
    }

    pub fn len(&self) usize {
        self.bytes.len() - 1
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.bytes.deinit(allocator)
    }
}

extend CStringView {
    fn fromParts(ptr: &u8, len: usize) CStringView {
        Self { ptr: ptr, len: len }
    }

    // The process startup ABI guarantees each argv/envp entry is NUL-terminated.
    // This package-private boundary records that trusted length once; ordinary
    // callers must use `fromBytes`, which validates a bounded slice first.
    pub(pkg) fn fromTerminatedPtr(ptr: &u8) CStringView {
        let mut len: usize = 0;
        while ptr[len] != 0 {
            len += 1;
        }
        CStringView::fromParts(ptr, len)
    }

    pub fn fromBytes(bytes: &[u8]) CStringError!CStringView {
        if bytes.len() == 0 {
            return CStringError::EmptyInput!;
        }
        if bytes[bytes.len() - 1] != 0 {
            return CStringError::MissingTerminator!;
        }
        for &byte in &bytes[0..bytes.len() - 1] {
            if byte == 0 {
                return CStringError::InteriorNul!;
            }
        }
        !CStringView::fromParts(bytes.ptr(), bytes.len() - 1)
    }

    pub fn rawPtr(&self) &u8 {
        self.ptr
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn bytes(&self) &[u8] {
        & self.ptr[0..self.len()]
    }

    pub fn nulTerminatedBytes(&self) &[u8] {
        &self.ptr[0..self.len + 1]
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn parse[T](self) [T as parse::From[CStringView]]::Error!T
    where T: parse::From[CStringView]
    {
        [T]::from(self)
    }

    pub fn parseRadix[T](self, radix: u32) [T as parse::FromRadix[CStringView]]::Error!T
    where T: parse::FromRadix[CStringView]
    {
        [T]::fromRadix(self, radix)
    }
}

extend CString : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.view().format(formatter)
    }

    fn formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.view().formatSpec(formatter, spec)
    }
}

extend CStringView : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        formatter.writeBytes(self.bytes())
    }

    fn formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        if spec.presentation() != fmt::FormatPresentation::Display or spec.sign_plus() or spec.alternate() {
            return fmt::Error::InvalidTemplate!;
        }
        let contentWidth = formatter.precision_width(self.len(), spec);
        formatter.writePaddingBefore(contentWidth, spec).?;
        let bytes = self.bytes();
        let mut index: usize = 0;
        while index < bytes.len() and index < contentWidth {
            formatter.writeByte(bytes[index]).?;
            index += 1;
        }
        formatter.writePaddingAfter(contentWidth, spec)
    }
}

extend[T] T : parse::From[CStringView]
where T: parse::From[&[u8]]
{
    type Error = [T as parse::From[&[u8]]]::Error;

    fn from(input: CStringView) [T as parse::From[CStringView]]::Error!T {
        input.bytes().parse[T]()
    }
}

extend[T] T : parse::FromRadix[CStringView]
where T: parse::FromRadix[&[u8]]
{
    type Error = [T as parse::FromRadix[&[u8]]]::Error;

    fn fromRadix(input: CStringView, radix: u32) [T as parse::FromRadix[CStringView]]::Error!T {
        input.bytes().parseRadix[T](radix)
    }
}
