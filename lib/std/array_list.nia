import std.mem;

pub struct ArrayList[T]
where T: Sized
{
    items: &mut [T],
    capacity: usize,
}

fn dangling_slice[T](len: usize) &mut [T]
where T: Sized
{
    var ptr = @align[T]() as &mut T;
    &mut ptr[0..len]
}

extend[T] ArrayList[T]
where T: Sized
{
    pub fn init() ArrayList[T] {
        { items: dangling_slice[T](0), capacity: 0 }
    }

    pub fn init_capacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!ArrayList[T] {
        var list = ArrayList[T]::init();
        list.ensure_total_capacity_precise(allocator, capacity).?;
        !list
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.free_items(allocator).?;
        self.items = dangling_slice[T](0);
        self.capacity = 0;
        !{}
    }

    pub fn len(&self) usize {
        self.items.len()
    }

    pub fn capacity(&self) usize {
        self.capacity
    }

    pub fn is_empty(&self) bool {
        self.len() == 0
    }

    pub fn as_slice(&self) &[T] {
        & self.items[0..self.len()]
    }

    pub fn as_mut_slice(&mut self) &mut [T] {
        self.items
    }

    pub fn clear(&mut self) void {
        var ptr = self.items.get_ptr();
        self.items = &mut ptr[0..0];
    }

    pub fn clear_retaining_capacity(&mut self) void {
        self.clear();
    }

    pub fn clear_and_free(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.deinit(allocator)
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, value: T) mem::Error!void {
        let slot = self.add_one(allocator).?;
        slot.* = value;
        !{}
    }

    pub fn pop(&mut self) ?T {
        let len = self.len();
        if len == 0 {
            null
        } else {
            let next_len = len - 1usize;
            let value = self.items[next_len];
            var ptr = self.items.get_ptr();
            self.items = &mut ptr[0..next_len];
            ?value
        }
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        self.ensure_unused_capacity(allocator, additional)
    }

    pub fn reserve_exact(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        let len = self.len();
        let needed = len + additional;
        if needed < len {
            return mem::Error::OutOfMemory!;
        }
        self.ensure_total_capacity_precise(allocator, needed)
    }

    pub fn ensure_unused_capacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        let len = self.len();
        let needed = len + additional;
        if needed < len {
            return mem::Error::OutOfMemory!;
        }
        self.ensure_total_capacity(allocator, needed)
    }

    pub fn ensure_total_capacity(&mut self, allocator: &mut mem::Allocator, new_capacity: usize) mem::Error!void {
        if new_capacity <= self.capacity() {
            return !{};
        }
        let better_capacity = self.grown_capacity(new_capacity).?;
        self.ensure_total_capacity_precise(allocator, better_capacity)
    }

    pub fn ensure_total_capacity_precise(&mut self, allocator: &mut mem::Allocator, new_capacity: usize) mem::Error!void {
        if new_capacity <= self.capacity() {
            return !{};
        }
        self.grow_to_capacity(allocator, new_capacity).?;
        !{}
    }

    pub fn append_slice(&mut self, allocator: &mut mem::Allocator, items: &[T]) mem::Error!void {
        let out = self.add_many_as_slice(allocator, items.len()).?;
        copy_items[T](out, items);
        !{}
    }

    pub fn append_slice_assume_capacity(&mut self, items: &[T]) void {
        let out = self.add_many_as_slice_assume_capacity(items.len());
        copy_items[T](out, items);
    }

    pub fn add_one(&mut self, allocator: &mut mem::Allocator) mem::Error!&mut T {
        var items = self.add_many_as_slice(allocator, 1usize).?;
        !&mut items[0]
    }

    pub fn add_one_assume_capacity(&mut self) &mut T {
        var items = self.add_many_as_slice_assume_capacity(1usize);
        &mut items[0]
    }

    pub fn add_many_as_slice(&mut self, allocator: &mut mem::Allocator, count: usize) mem::Error!&mut [T] {
        self.ensure_unused_capacity(allocator, count).?;
        !self.add_many_as_slice_assume_capacity(count)
    }

    pub fn add_many_as_slice_assume_capacity(&mut self, count: usize) &mut [T] {
        let old_len = self.len();
        let new_len = old_len + count;
        var items = self.allocated_items();
        self.items = &mut items[0..new_len];
        &mut items[old_len..new_len]
    }

    pub fn shrink_retaining_capacity(&mut self, new_len: usize) void {
        if new_len < self.len() {
            var ptr = self.items.get_ptr();
            self.items = &mut ptr[0..new_len];
        }
    }

    fn grown_capacity(&self, needed: usize) mem::Error!usize {
        let elem_len = @size[T]();
        var init_capacity = 1usize;
        if elem_len != 0usize {
            init_capacity = 64usize / elem_len;
            if init_capacity == 0usize {
                init_capacity = 1usize;
            }
        }
        let half = needed / 2usize;
        let extra = half + init_capacity;
        if extra < half {
            return mem::Error::OutOfMemory!;
        }
        let capacity = needed + extra;
        if capacity < needed {
            return mem::Error::OutOfMemory!;
        }
        !capacity
    }

    fn grow_to_capacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        let old_block = self.allocated_block().?;
        let layout = mem::Layout::array[T](capacity).?;
        switch allocator.remap(old_block, layout) {
            ?block => {
                self.set_allocated_block(block, capacity);
                return !{};
            },
            null => {},
        }

        let new_block = allocator.alloc(layout).?;
        var new_items = block_items[T](new_block, capacity);
        copy_items[T](new_items, self.as_slice());
        switch allocator.free(old_block) {
            !ok => _ = ok,
            err! => {
                switch allocator.free(new_block) {
                    !ok => _ = ok,
                    error! => {},
                }
                return err!;
            },
        }
        self.set_allocated_block(new_block, capacity);
        !{}
    }

    fn free_items(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        let block = self.allocated_block().?;
        allocator.free(block)
    }

    fn allocated_items(&mut self) &mut [T] {
        var ptr = self.items.get_ptr() as &mut T;
        &mut ptr[0..self.capacity]
    }

    fn allocated_block(&self) mem::Error!mem::Block {
        let layout = mem::Layout::array[T](self.capacity).?;
        !mem::Block::init(self.items.get_ptr() as &mut u8, layout)
    }

    fn set_allocated_block(&mut self, block: mem::Block, capacity: usize) void {
        let len = self.len();
        var items = block_items[T](block, capacity);
        self.items = &mut items[0..len];
        self.capacity = capacity;
    }
}

fn block_items[T](block: mem::Block, len: usize) &mut [T]
where T: Sized
{
    var ptr = block.ptr() as &mut T;
    &mut ptr[0..len]
}

fn copy_items[T](to: &mut [T], from: &[T]) void
where T: Sized
{
    var index = 0usize;
    while index < from.len() {
        to[index] = from[index];
        index += 1usize;
    }
}
