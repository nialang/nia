extend i8 : CheckedAdd[i8] {
    type Output = i8;

    fn checked_add(self, rhs: i8) ?i8 {
        if rhs > 0i8 and self > i8::MAX - rhs {
            null
        } else if rhs < 0i8 and self < i8::MIN - rhs {
            null
        } else {
            ?(self + rhs)
        }
    }
}

extend i8 : CheckedSub[i8] {
    type Output = i8;

    fn checked_sub(self, rhs: i8) ?i8 {
        if rhs > 0i8 and self < i8::MIN + rhs {
            null
        } else if rhs < 0i8 and self > i8::MAX + rhs {
            null
        } else {
            ?(self - rhs)
        }
    }
}

extend i8 : CheckedMul[i8] {
    type Output = i8;

    fn checked_mul(self, rhs: i8) ?i8 {
        if self == 0i8 or rhs == 0i8 {
            ?0i8
        } else if self > 0i8 and rhs > 0i8 {
            if self > i8::MAX / rhs { null } else { ?(self * rhs) }
        } else if self > 0i8 and rhs < 0i8 {
            if rhs < i8::MIN / self { null } else { ?(self * rhs) }
        } else if self < 0i8 and rhs > 0i8 {
            if self < i8::MIN / rhs { null } else { ?(self * rhs) }
        } else {
            if self < i8::MAX / rhs { null } else { ?(self * rhs) }
        }
    }
}

extend i8 : CheckedDiv[i8] {
    type Output = i8;

    fn checked_div(self, rhs: i8) ?i8 {
        if rhs == 0i8 or (self == i8::MIN and rhs == -1i8) {
            null
        } else {
            ?(self / rhs)
        }
    }
}

extend i8 : CheckedRem[i8] {
    type Output = i8;

    fn checked_rem(self, rhs: i8) ?i8 {
        if rhs == 0i8 or (self == i8::MIN and rhs == -1i8) {
            null
        } else {
            ?(self % rhs)
        }
    }
}

extend i8 : CheckedNeg {
    type Output = i8;

    fn checked_neg(self) ?i8 {
        if self == i8::MIN {
            null
        } else {
            ?(0i8 - self)
        }
    }
}

extend i8 : CheckedAbs {
    type Output = i8;

    fn checked_abs(self) ?i8 {
        if self < 0i8 {
            self.checked_neg()
        } else {
            ?self
        }
    }
}

