extend usize {
    pub fn is_power_of_two(self) bool {
        if self == 0 {
            false
        } else {
            var n = self;
            while n > 1usize {
                if n % 2usize != 0usize {
                    return false;
                }
                n = n / 2usize;
            }
            true
        }
    }

    pub fn checked_add(self, rhs: usize) ?usize {
        let sum = self + rhs;
        if sum < self {
            null
        } else {
            ?sum
        }
    }

    pub fn checked_mul(self, rhs: usize) ?usize {
        if self == 0usize or rhs == 0usize {
            ?0usize
        } else {
            let product = self * rhs;
            if product / self != rhs {
                null
            } else {
                ?product
            }
        }
    }

    pub fn align_forward(self, align: usize) ?usize {
        if align == 0usize or not align.is_power_of_two() {
            return null;
        }
        let remainder = self % align;
        if remainder == 0usize {
            ?self
        } else {
            self.checked_add(align - remainder)
        }
    }
}
