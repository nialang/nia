pub trait CheckedAdd[Rhs] {
    type Output;

    fn checked_add(self, rhs: Rhs) ?[Self as CheckedAdd[Rhs]]::Output;
}

pub trait CheckedSub[Rhs] {
    type Output;

    fn checked_sub(self, rhs: Rhs) ?[Self as CheckedSub[Rhs]]::Output;
}

pub trait CheckedMul[Rhs] {
    type Output;

    fn checked_mul(self, rhs: Rhs) ?[Self as CheckedMul[Rhs]]::Output;
}

pub trait CheckedDiv[Rhs] {
    type Output;

    fn checked_div(self, rhs: Rhs) ?[Self as CheckedDiv[Rhs]]::Output;
}

pub trait CheckedRem[Rhs] {
    type Output;

    fn checked_rem(self, rhs: Rhs) ?[Self as CheckedRem[Rhs]]::Output;
}

pub trait CheckedNeg {
    type Output;

    fn checked_neg(self) ?[Self as CheckedNeg]::Output;
}

pub trait CheckedAbs {
    type Output;

    fn checked_abs(self) ?[Self as CheckedAbs]::Output;
}

extend u8 : CheckedAdd[u8] {
    type Output = u8;

    fn checked_add(self, rhs: u8) ?u8 {
        if self > u8::MAX - rhs {
            null
        } else {
            ?(self + rhs)
        }
    }
}

extend u8 : CheckedSub[u8] {
    type Output = u8;

    fn checked_sub(self, rhs: u8) ?u8 {
        if self < rhs {
            null
        } else {
            ?(self - rhs)
        }
    }
}

extend u8 : CheckedMul[u8] {
    type Output = u8;

    fn checked_mul(self, rhs: u8) ?u8 {
        if self == 0u8 or rhs == 0u8 {
            ?0u8
        } else if self > u8::MAX / rhs {
            null
        } else {
            ?(self * rhs)
        }
    }
}

extend u8 : CheckedDiv[u8] {
    type Output = u8;

    fn checked_div(self, rhs: u8) ?u8 {
        if rhs == 0u8 {
            null
        } else {
            ?(self / rhs)
        }
    }
}

extend u8 : CheckedRem[u8] {
    type Output = u8;

    fn checked_rem(self, rhs: u8) ?u8 {
        if rhs == 0u8 {
            null
        } else {
            ?(self % rhs)
        }
    }
}

