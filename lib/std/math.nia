// Checked arithmetic and alignment utilities.
//
// Traits and primitive implementations live in focused modules; this facade
// preserves the established `std::math` entry points.

pub(root) module alignment;
pub(root) module checked;
pub(root) module signed;
pub(root) module unsigned;

using root::math::alignment;
using root::math::checked;
using root::math::signed;
using root::math::unsigned;

pub using checked::{
    CheckedAdd,
    CheckedSub,
    CheckedMul,
    CheckedDiv,
    CheckedRem,
    CheckedNeg,
    CheckedAbs,
};
