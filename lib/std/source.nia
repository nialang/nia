// Stable source coordinates produced by the compiler.
//
// Coordinates refer to logical UTF-8 source identity rather than host paths.
// Lines and columns are one-based; columns count Unicode scalar values.

using root::fmt;

pub struct SourceLocation {
    file: &[u8],
    line: u32,
    column: u32,
}

extend SourceLocation {
    pub fun file(&self) &[u8] {
        self.file
    }

    pub fun line(&self) u32 {
        self.line
    }

    pub fun column(&self) u32 {
        self.column
    }
}

extend SourceLocation : fmt::Format {
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        formatter.writeBytes(self.file).?;
        formatter.writeByte(b':').?;
        formatter.writeUnsigned(self.line as u128).?;
        formatter.writeByte(b':').?;
        formatter.writeUnsigned(self.column as u128)
    }
}

// Returns this expression's lexical location, or the outermost tracked call
// site when evaluated in a `@[trackCaller]` function.
@[builtin("callerLocation")]
pub const fun callerLocation() SourceLocation;
