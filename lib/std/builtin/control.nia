// Control-flow and compile-time builtin functions.

// Terminates the current execution path immediately at comptime or runtime.
//
// `trap` returns `never`, so it can be used in branches that do not continue.
@[builtin("trap")]
pub const fun trap() never;

// Emits a compile-time diagnostic with a const string message.
@[builtin("error")]
pub const fun error(message: &[char]) never;

// Embeds a file at const. The compiler specializes the result to the byte
// array whose length matches the embedded file; `()` is only its declaration
// placeholder.
@[builtin("embed")]
pub const fun embed(path: &[char]) ();

// Compiler-checked inline assembly configuration.
@[builtin("AsmConfig")]
pub type AsmConfig;

// Target register or register-class inputs consumed by `AsmConfig`.
@[builtin("AsmInputs")]
pub type AsmInputs;

// Target register or register-class output places consumed by `AsmConfig`.
@[builtin("AsmOutputs")]
pub type AsmOutputs;

// Emits target inline assembly from a compiler-checked configuration literal.
@[builtin("asm")]
pub fun asm(config: AsmConfig) ();
