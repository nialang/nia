// Memory compiler intrinsics.

// Copies memory between non-overlapping slices.
@[builtin("memcpy")]
pub fun memcpy[T](dest: &mut [T], source: &[T]) ();

// Moves memory between possibly overlapping slices.
@[builtin("memmove")]
pub fun memmove[T](dest: &mut [T], source: &[T]) ();

// Sets bytes in a mutable byte slice.
@[builtin("memset")]
pub fun memset(dest: &mut [u8], value: u8) ();

// Loads `T` from a byte pointer without requiring alignment.
@[builtin("loadUnaligned")]
pub fun loadUnaligned[T](ptr: &u8) T;
