// Memory compiler intrinsics.

// Copies memory between non-overlapping slices.
@[builtin("memcpy")]
pub fn memcpy[T](dest: &mut [T], source: &[T]) void;

// Moves memory between possibly overlapping slices.
@[builtin("memmove")]
pub fn memmove[T](dest: &mut [T], source: &[T]) void;

// Sets bytes in a mutable byte slice.
@[builtin("memset")]
pub fn memset(dest: &mut [u8], value: u8) void;

// Loads `T` from a byte pointer without requiring alignment.
@[builtin("load_unaligned")]
pub fn load_unaligned[T](ptr: &u8) T;
