// Builtin declarations for primitive scalar types and associated values.

@[builtin("i8")]
pub type i8;

@[builtin("i16")]
pub type i16;

@[builtin("i32")]
pub type i32;

@[builtin("i64")]
pub type i64;

@[builtin("i128")]
pub type i128;

@[builtin("isize")]
pub type isize;

@[builtin("u8")]
pub type u8;

@[builtin("u16")]
pub type u16;

@[builtin("u32")]
pub type u32;

@[builtin("u64")]
pub type u64;

@[builtin("u128")]
pub type u128;

@[builtin("usize")]
pub type usize;

@[builtin("f32")]
pub type f32;

@[builtin("f64")]
pub type f64;

@[builtin("bool")]
pub type bool;

@[builtin("char")]
pub type char;

@[builtin("void")]
pub type void;

@[builtin("never")]
pub type never;

// Constructs a `char` only when `value` is a Unicode scalar value.
@[builtin("charFromU32")]
pub const fn charFromU32(value: u32) ?char;

@[builtin("i8")]
extend i8 {
    pub const MIN: i8;
    pub const MAX: i8;
}

@[builtin("i16")]
extend i16 {
    pub const MIN: i16;
    pub const MAX: i16;
}

@[builtin("i32")]
extend i32 {
    pub const MIN: i32;
    pub const MAX: i32;
}

@[builtin("i64")]
extend i64 {
    pub const MIN: i64;
    pub const MAX: i64;
}

@[builtin("i128")]
extend i128 {
    pub const MIN: i128;
    pub const MAX: i128;
}

@[builtin("isize")]
extend isize {
    pub const MIN: isize;
    pub const MAX: isize;
}

@[builtin("u8")]
extend u8 {
    pub const MIN: u8;
    pub const MAX: u8;
}

@[builtin("u16")]
extend u16 {
    pub const MIN: u16;
    pub const MAX: u16;
}

@[builtin("u32")]
extend u32 {
    pub const MIN: u32;
    pub const MAX: u32;
}

@[builtin("u64")]
extend u64 {
    pub const MIN: u64;
    pub const MAX: u64;
}

@[builtin("u128")]
extend u128 {
    pub const MIN: u128;
    pub const MAX: u128;
}

@[builtin("usize")]
extend usize {
    pub const MIN: usize;
    pub const MAX: usize;
}
