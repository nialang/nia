// Atomic compiler intrinsics.

// Atomic load.
@[builtin("atomicLoad")]
pub fun atomicLoad[T](ptr: &T, order: usize) T;

// Atomic store.
@[builtin("atomicStore")]
pub fun atomicStore[T](ptr: &mut T, value: T, order: usize) ();

// Atomic read-modify-write.
@[builtin("atomicRmw")]
pub fun atomicRmw[T](ptr: &mut T, op: usize, value: T, order: usize) T;

// Strong atomic compare-and-exchange.
@[builtin("cmpxchgStrong")]
pub fun cmpxchgStrong[T](ptr: &mut T, expected: T, desired: T, success: usize, failure: usize) ?T;

// Weak atomic compare-and-exchange.
@[builtin("cmpxchgWeak")]
pub fun cmpxchgWeak[T](ptr: &mut T, expected: T, desired: T, success: usize, failure: usize) ?T;

// Atomic fence.
@[builtin("fence")]
pub fun fence(order: usize) ();
