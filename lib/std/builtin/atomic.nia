// Atomic compiler intrinsics.

// Atomic load.
@[builtin("atomic_load")]
pub fn atomicLoad[T](ptr: &T, order: usize) T;

// Atomic store.
@[builtin("atomic_store")]
pub fn atomicStore[T](ptr: &mut T, value: T, order: usize) ();

// Atomic read-modify-write.
@[builtin("atomic_rmw")]
pub fn atomicRmw[T](ptr: &mut T, op: usize, value: T, order: usize) T;

// Strong atomic compare-and-exchange.
@[builtin("cmpxchg_strong")]
pub fn cmpxchgStrong[T](ptr: &mut T, expected: T, desired: T, success: usize, failure: usize) ?T;

// Weak atomic compare-and-exchange.
@[builtin("cmpxchg_weak")]
pub fn cmpxchgWeak[T](ptr: &mut T, expected: T, desired: T, success: usize, failure: usize) ?T;

// Atomic fence.
@[builtin("fence")]
pub fn fence(order: usize) ();
