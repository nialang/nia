// Place, pointer, indexing, slicing, and scalar helper builtin traits.

@[builtin("Deref")]
pub trait Deref {
    type Target;

    fn deref(&self) &[Self as Deref]::Target;
}

@[builtin("DerefMut")]
pub trait DerefMut : Deref {
    type Target;

    fn deref_mut(&mut self) &mut [Self as DerefMut]::Target;
}

@[builtin("Index")]
pub trait Index[R] {
    type Output;

    fn index(&self, index: R) &[Self as Index[R]]::Output;
}

@[builtin("IndexMut")]
pub trait IndexMut[R] : Index[R] {
    type Output;

    fn index_mut(&mut self, index: R) &mut [Self as IndexMut[R]]::Output;
}

@[builtin("Slice")]
pub trait Slice[R] {
    type Output;

    fn slice(&self, range: R) [Self as Slice[R]]::Output;
}

@[builtin("SliceMut")]
pub trait SliceMut[R] : Slice[R] {
    type Output;

    fn slice_mut(&mut self, range: R) [Self as SliceMut[R]]::Output;
}

@[builtin("Ptr")]
pub trait Ptr {
    type Target;

    fn ptr(&self) &[Self as Ptr]::Target;
}

@[builtin("PtrMut")]
pub trait PtrMut : Ptr {
    type Target;

    fn ptr_mut(&mut self) &mut [Self as PtrMut]::Target;
}

pub trait Len {
    const fn len(&self) usize;
}

@[builtin("Start")]
pub trait Start {
    type Output;

    fn start(&self) [Self as Start]::Output;
}

@[builtin("End")]
pub trait End {
    type Output;

    fn end(&self) [Self as End]::Output;
}

extend[T, N: usize] [N]T : Len {
    const fn len(&self) usize {
        N
    }
}

extend[T] [T] : Len {
    const fn len(&self) usize {
        sliceLen(&self)
    }
}

@[builtin("sliceLen")]
const fn sliceLen[T](value: &[T]) usize;

@[builtin("slice.Ptr")]
extend[T] [T] : Ptr {
    type Target = T;

    fn ptr(&self) &T;
}

@[builtin("slice.PtrMut")]
extend[T] [T] : PtrMut {
    type Target = T;

    fn ptr_mut(&mut self) &mut T;
}

@[builtin("range.Start")]
extend[T] T..T : Start {
    type Output = T;

    fn start(&self) T;
}

@[builtin("range.End")]
extend[T] T..T : End {
    type Output = T;

    fn end(&self) T;
}

@[builtin("range_inclusive.Start")]
extend[T] T..=T : Start {
    type Output = T;

    fn start(&self) T;
}

@[builtin("range_inclusive.End")]
extend[T] T..=T : End {
    type Output = T;

    fn end(&self) T;
}

@[builtin("range_from.Start")]
extend[T] T.. : Start {
    type Output = T;

    fn start(&self) T;
}

@[builtin("range_to.End")]
extend[T] ..T : End {
    type Output = T;

    fn end(&self) T;
}

@[builtin("range_to_inclusive.End")]
extend[T] ..=T : End {
    type Output = T;

    fn end(&self) T;
}
