// Place, pointer, indexing, slicing, and scalar helper builtin traits.

@[builtin("Deref")]
pub trait Deref {
    type Target;

    fun deref(&self) &[Self as Deref]::Target;
}

@[builtin("DerefMut")]
pub trait DerefMut : Deref {
    type Target;

    fun derefMut(&mut self) &mut [Self as DerefMut]::Target;
}

@[builtin("Index")]
pub trait Index[R] {
    type Output;

    fun index(&self, index: R) &[Self as Index[R]]::Output;
}

@[builtin("IndexMut")]
pub trait IndexMut[R] : Index[R] {
    type Output;

    fun indexMut(&mut self, index: R) &mut [Self as IndexMut[R]]::Output;
}

@[builtin("Slice")]
pub trait Slice[R] {
    type Output;

    fun slice(&self, range: R) [Self as Slice[R]]::Output;
}

@[builtin("SliceMut")]
pub trait SliceMut[R] : Slice[R] {
    type Output;

    fun sliceMut(&mut self, range: R) [Self as SliceMut[R]]::Output;
}

pub trait Len {
    const fun len(&self) usize;
}

extend[T, N: usize] [T; N] : Len {
    const fun len(&self) usize {
        N
    }
}

extend[T] [T] : Len {
    const fun len(&self) usize {
        sliceLen(&self)
    }
}

extend[T] &[T] : Len {
    const fun len(&self) usize {
        sliceLen(self)
    }
}

extend[T] &mut [T] : Len {
    const fun len(&self) usize {
        sliceLen(self)
    }
}

@[builtin("sliceLen")]
const fun sliceLen[T](value: &[T]) usize;
