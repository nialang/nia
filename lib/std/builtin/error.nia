// Error propagation builtin trait.
//
// Errors retain their domain cause. `IntoError` is for reviewed, infallible
// propagation; contextual operation, path, subject, and cleanup information is
// attached by the owning module.

@[builtin("IntoError")]
pub trait IntoError[Target] {
    // `.?` passes the location of the propagation, so a conversion can
    // record where an error crossed into `Target`.
    @[trackCaller]
    const fun intoError(self) Target;
}
