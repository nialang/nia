// Target configuration values exposed through std::builtin.

@[builtin("target.arch")]
pub const arch: &[char];

@[builtin("target.vendor")]
pub const vendor: &[char];

@[builtin("target.os")]
pub const os: &[char];

@[builtin("target.env")]
pub const env: &[char];

@[builtin("target.abi")]
pub const abi: &[char];

@[builtin("target.endian")]
pub const endian: &[char];

@[builtin("target.pointer_width")]
pub const pointer_width: usize;
