// Target configuration values exposed through std::builtin.

@[builtin("target.arch")]
pub comptime arch: &[char];

@[builtin("target.vendor")]
pub comptime vendor: &[char];

@[builtin("target.os")]
pub comptime os: &[char];

@[builtin("target.env")]
pub comptime env: &[char];

@[builtin("target.abi")]
pub comptime abi: &[char];

@[builtin("target.endian")]
pub comptime endian: &[char];

@[builtin("target.pointer_width")]
pub comptime pointer_width: usize;
