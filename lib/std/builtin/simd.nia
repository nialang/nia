// SIMD compiler intrinsics and traits for native vector types such as `u8x16`.

@[builtin("Simd")]
pub trait Simd {
    type Lane;
    const Lanes: usize;
}

@[builtin("SimdMask")]
pub trait SimdMask : Simd {}

// Creates a SIMD vector by splatting one lane value.
@[builtin("splat")]
pub const fun splat[V](value: [V as Simd]::Lane) V
where V: Simd;

// Extracts a SIMD lane.
@[builtin("extract")]
pub const fun extract[V](vector: V, index: usize) [V as Simd]::Lane
where V: Simd;

// Inserts a SIMD lane.
@[builtin("insert")]
pub const fun insert[V](vector: V, index: usize, value: [V as Simd]::Lane) V
where V: Simd;

// Converts a SIMD bool mask vector into a bitmask.
@[builtin("bitmask")]
pub const fun bitmask[V](vector: V) usize
where V: SimdMask;

// Builds a vector from lanes of `first` and `second`, which have the same
// vector type with `L` lanes. `indices` is a compile-time array with one entry
// per result lane: an index below `L` selects that lane of `first`, and an
// index from `L` to `2L - 1` selects lane `index - L` of `second`. The result
// has the operands' lane type and as many lanes as `indices` has entries; the
// compiler specializes the `V` below to that vector type.
@[builtin("shuffle")]
pub const fun shuffle[V, N: usize](first: V, second: V, indices: [usize; N]) V
where V: Simd;

// Looks up bytes of a 16-byte table: lane `i` of the result is lane
// `indices[i]` of `table`, or 0 when that index is 16 or more. Unlike
// `shuffle`, the indices are run-time values, which makes this the
// building block of byte classification and nibble lookups.
@[builtin("lookup16")]
pub const fun lookup16(table: u8x16, indices: u8x16) u8x16;
