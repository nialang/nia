// Operator builtin traits.

@[builtin("Add")]
pub trait Add[Rhs] {
    type Output;

    fun add(self, rhs: Rhs) [Self as Add[Rhs]]::Output;
}

@[builtin("Sub")]
pub trait Sub[Rhs] {
    type Output;

    fun sub(self, rhs: Rhs) [Self as Sub[Rhs]]::Output;
}

@[builtin("Mul")]
pub trait Mul[Rhs] {
    type Output;

    fun mul(self, rhs: Rhs) [Self as Mul[Rhs]]::Output;
}

@[builtin("Div")]
pub trait Div[Rhs] {
    type Output;

    fun div(self, rhs: Rhs) [Self as Div[Rhs]]::Output;
}

@[builtin("Rem")]
pub trait Rem[Rhs] {
    type Output;

    fun rem(self, rhs: Rhs) [Self as Rem[Rhs]]::Output;
}

@[builtin("Neg")]
pub trait Neg {
    type Output;

    fun neg(self) [Self as Neg]::Output;
}

@[builtin("Not")]
pub trait Not {
    fun logicalNot(self) bool;
}

@[builtin("BitNot")]
pub trait BitNot {
    type Output;

    fun bitNot(self) [Self as BitNot]::Output;
}

@[builtin("BitAnd")]
pub trait BitAnd[Rhs] {
    type Output;

    fun bitAnd(self, rhs: Rhs) [Self as BitAnd[Rhs]]::Output;
}

@[builtin("BitOr")]
pub trait BitOr[Rhs] {
    type Output;

    fun bitOr(self, rhs: Rhs) [Self as BitOr[Rhs]]::Output;
}

@[builtin("BitXor")]
pub trait BitXor[Rhs] {
    type Output;

    fun bitXor(self, rhs: Rhs) [Self as BitXor[Rhs]]::Output;
}

@[builtin("Shl")]
pub trait Shl[Rhs] {
    type Output;

    fun shl(self, rhs: Rhs) [Self as Shl[Rhs]]::Output;
}

@[builtin("Shr")]
pub trait Shr[Rhs] {
    type Output;

    fun shr(self, rhs: Rhs) [Self as Shr[Rhs]]::Output;
}

@[builtin("Eq")]
pub trait Eq[Rhs] {
    fun eq(self, rhs: Rhs) bool;

    fun ne(self, rhs: Rhs) bool;
}

@[builtin("Ord")]
pub trait Ord[Rhs] {
    fun lt(self, rhs: Rhs) bool;

    fun le(self, rhs: Rhs) bool;

    fun gt(self, rhs: Rhs) bool;

    fun ge(self, rhs: Rhs) bool;
}
