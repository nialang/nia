// External-command descriptors and their owned build-graph records.
//
// Public descriptors borrow caller data. ExternalCommandStep retains the
// complete command declaration so Build can validate and encode it after the
// build script returns.

using pkg::fs;
using pkg::mem;
using pkg::string;
using pkg::error::CleanupAccumulator;
using pkg::build::error;
using pkg::build::paths::{isValidBuildPath, isValidPackagePath};
using pkg::build::types;

using error::Error;
using types::{
    ActionResourceClass,
    BuildPathView,
    CommandArgument,
    CommandArgumentKind,
    CommandCachePolicy,
    CommandEnvironmentInput,
    CommandEnvironmentPolicy,
    ExecutableHandle,
    ExternalCommandOptions,
    ExternalCommandStep,
    ObjectHandle,
    OwnedCommandArgument,
    OwnedCommandEnvironmentInput,
    PackageHandle,
    StaticArchiveHandle,
};

extend CommandArgument {
    // Each constructor records the logical root used for dependency validation
    // and cache identity. Literal values intentionally declare no file input.
    pub fn literal(value: &[char]) CommandArgument {
        .{ kind: .Literal, payload: .{ value }, package: .init(0, 0) }
    }

    pub fn packageInput(package: PackageHandle, path: fs::PathView) CommandArgument {
        .{ kind: .PackageInput, payload: .{ value: path.text() }, package }
    }

    pub fn buildInput(path: BuildPathView) CommandArgument {
        .{ kind: .BuildInput, payload: .{ value: path.text() }, package: .init(0, 0) }
    }

    pub fn buildOutput(path: BuildPathView) CommandArgument {
        .{ kind: .BuildOutput, payload: .{ value: path.text() }, package: .init(0, 0) }
    }

    pub fn artifactInput(artifact: ExecutableHandle) CommandArgument {
        .{ kind: .ArtifactInput, payload: .{ artifact }, package: .init(0, 0) }
    }

    pub fn objectInput(object: ObjectHandle) CommandArgument {
        .{ kind: .ObjectInput, payload: .{ object }, package: .init(0, 0) }
    }

    pub fn staticArchiveInput(staticArchive: StaticArchiveHandle) CommandArgument {
        .{ kind: .StaticArchiveInput, payload: .{ staticArchive }, package: .init(0, 0) }
    }
}

pub(pkg) fn validateRunArguments(arguments: ?&[&[char]], index: usize) Error!() {
    if arguments is ?values {
        for &value in values.iter() {
            if runArgumentContainsNul(value) {
                return .Invalid {
                    operation: .Validate,
                    subject: .Step(index),
                }!;
            }
        }
    }
    !()
}

pub(pkg) fn validateExternalCommand(options: ExternalCommandOptions, index: usize) Error!() {
    if options.program.len() == 0
        or runArgumentContainsNul(options.program)
        or not isValidPackagePath(options.workingDirectory.text(), true)
    {
        return invalidStep(index);
    }
    match options.resourceClass {
        .Conservative, .Cpu, .Io => {},
        _ => return invalidStep(index),
    }
    match options.environmentPolicy {
        .Inherit, .Clear => {},
        _ => return invalidStep(index),
    }
    match options.cachePolicy {
        .Uncacheable => {},
        .DeclaredInputs => {
            if options.environmentPolicy != CommandEnvironmentPolicy::Clear {
                return invalidStep(index);
            }
        },
        _ => return invalidStep(index),
    }
    if options.environment is ?environment {
        let mut environmentIndex: usize = 0;
        while environmentIndex < environment.len() {
            let input = environment[environmentIndex];
            if environmentNameInvalid(input.name)
                or runArgumentContainsNul(input.value)
            {
                return invalidStep(index);
            }
            let mut priorIndex: usize = 0;
            while priorIndex < environmentIndex {
                if environment[priorIndex].name.equals(input.name) {
                    return invalidStep(index);
                }
                priorIndex += 1;
            }
            environmentIndex += 1;
        }
    }
    let mut hasOutput = false;
    if options.arguments is ?arguments {
        for &argument in arguments.iter() {
            if argument.kind == CommandArgumentKind::ArtifactInput
                or argument.kind == CommandArgumentKind::ObjectInput
                or argument.kind == CommandArgumentKind::StaticArchiveInput
            {
                continue;
            }
            let value = argument.payload.value;
            if runArgumentContainsNul(value) {
                return invalidStep(index);
            }
            if argument.kind == CommandArgumentKind::PackageInput
                and not isValidPackagePath(value, false)
            {
                return invalidStep(index);
            }
            if argument.kind == CommandArgumentKind::BuildInput
                and not isValidBuildPath(value)
            {
                return invalidStep(index);
            }
            if argument.kind == CommandArgumentKind::BuildOutput {
                if not isValidBuildPath(value) {
                    return invalidStep(index);
                }
                hasOutput = true;
            } else if not (argument.kind == CommandArgumentKind::Literal
                or argument.kind == CommandArgumentKind::PackageInput
                or argument.kind == CommandArgumentKind::BuildInput)
            {
                return invalidStep(index);
            }
        }
    }
    if options.cachePolicy == CommandCachePolicy::DeclaredInputs and not hasOutput {
        return invalidStep(index);
    }
    !()
}

fn invalidStep(index: usize) Error!() {
    .Invalid {
        operation: .Validate,
        subject: .Step(index),
    }!
}

fn runArgumentContainsNul(text: &[char]) bool {
    for &ch in text.iter() {
        if ch == '\0' {
            return true;
        }
    }
    false
}

fn environmentNameInvalid(text: &[char]) bool {
    if text.len() == 0 {
        return true;
    }
    for &ch in text.iter() {
        if ch == '\0' or ch == '=' {
            return true;
        }
    }
    false
}


extend ExternalCommandOptions {
    // Search commands inherit the process environment and are uncacheable by
    // default. Persistent reuse requires `withClearedEnvironment`, explicit
    // typed inputs/outputs, and `withDeclaredInputCache`.
    pub fn search(program: &[char]) ExternalCommandOptions {
        .{
            program,
            arguments: null,
            workingDirectory: .init(&""),
            resourceClass: .Conservative,
            environmentPolicy: .Inherit,
            cachePolicy: .Uncacheable,
            environment: null,
        }
    }

    pub fn withArguments(self, arguments: &[CommandArgument]) ExternalCommandOptions {
        .{
            program: self.program,
            arguments: ?arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withPackageWorkingDirectory(self, workingDirectory: fs::PathView) ExternalCommandOptions {
        .{
            program: self.program,
            arguments: self.arguments,
            workingDirectory: workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withResourceClass(self, resourceClass: ActionResourceClass) ExternalCommandOptions {
        .{
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withEnvironment(self, environment: &[CommandEnvironmentInput]) ExternalCommandOptions {
        .{
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: ?environment,
        }
    }

    pub fn withClearedEnvironment(self) ExternalCommandOptions {
        .{
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: .Clear,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withDeclaredInputCache(self) ExternalCommandOptions {
        .{
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: .DeclaredInputs,
            environment: self.environment,
        }
    }
}

extend CommandEnvironmentInput {
    pub fn init(name: &[char], value: &[char]) CommandEnvironmentInput {
        .{ name, value }
    }
}

extend OwnedCommandArgument {
    fn init(argument: CommandArgument) OwnedCommandArgument {
        if argument.kind == CommandArgumentKind::ArtifactInput {
            return .{
                kind: argument.kind,
                payload: .{ artifact: argument.payload.artifact },
                package: argument.package,
            };
        }
        if argument.kind == CommandArgumentKind::ObjectInput {
            return .{
                kind: argument.kind,
                payload: .{ object: argument.payload.object },
                package: argument.package,
            };
        }
        if argument.kind == CommandArgumentKind::StaticArchiveInput {
            return .{
                kind: argument.kind,
                payload: .{ staticArchive: argument.payload.staticArchive },
                package: argument.package,
            };
        }
        .{
            kind: argument.kind,
            payload: .{ value: .init() },
            package: argument.package,
        }
    }

    fn initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        value: &[char],
        index: usize,
    ) Error!() {
        self.payload.value = string::String::fromSlice(
            allocator,
            value,
        ).withBuildContext(.Retain, .Step(index)).?;
        !()
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        if self.kind == CommandArgumentKind::ArtifactInput
            or self.kind == CommandArgumentKind::ObjectInput
            or self.kind == CommandArgumentKind::StaticArchiveInput
        {
            return !();
        }
        self.payload.value.deinit(allocator).withBuildContext(.Release, .Step(index))
    }
}

extend OwnedCommandEnvironmentInput {
    fn init() OwnedCommandEnvironmentInput {
        .{ name: .init(), value: .init() }
    }

    fn initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        input: CommandEnvironmentInput,
        index: usize,
    ) Error!() {
        self.name = string::String::fromSlice(
            allocator,
            input.name,
        ).withBuildContext(.Retain, .Step(index)).?;
        self.value = string::String::fromSlice(
            allocator,
            input.value,
        ).withBuildContext(.Retain, .Step(index)).?;
        !()
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.value.deinit(allocator).withBuildContext(.Release, .Step(index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Step(index)));
        cleanup.finish()
    }
}

extend ExternalCommandStep {
    pub(pkg) fn init(options: ExternalCommandOptions) ExternalCommandStep {
        .{
            program: .init(),
            arguments: .init(),
            workingDirectory: .init(),
            resourceClass: options.resourceClass,
            environmentPolicy: options.environmentPolicy,
            cachePolicy: options.cachePolicy,
            environment: .init(),
        }
    }

    pub(pkg) fn initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        options: ExternalCommandOptions,
        index: usize,
    ) Error!() {
        self.program = string::String::fromSlice(
            allocator,
            options.program,
        ).withBuildContext(.Retain, .Step(index)).?;
        self.workingDirectory = fs::Path::fromView(
            allocator,
            options.workingDirectory,
        ).withBuildContext(.Retain, .Step(index)).?;
        if options.arguments is ?arguments {
            self.arguments.reserve(allocator, arguments.len()).withBuildContext(.Retain, .Step(index)).?;
            for &argument in arguments.iter() {
                self.arguments.appendAssumeCapacity(.init(argument));
                if argument.kind != CommandArgumentKind::ArtifactInput
                    and argument.kind != CommandArgumentKind::ObjectInput
                    and argument.kind != CommandArgumentKind::StaticArchiveInput
                {
                    let argumentIndex = self.arguments.len() - 1;
                    self.arguments.asMutSlice()[argumentIndex].initialize(
                        allocator,
                        argument.payload.value,
                        index,
                    ).?;
                }
            }
        }
        if options.environment is ?environment {
            self.environment.reserve(allocator, environment.len()).withBuildContext(.Retain, .Step(index)).?;
            for &input in environment.iter() {
                self.environment.appendAssumeCapacity(.init());
                let inputIndex = self.environment.len() - 1;
                self.environment.asMutSlice()[inputIndex].initialize(allocator, input, index).?;
            }
        }
        !()
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        let mut environmentElements: CleanupAccumulator[Error] = .init();
        let mut environmentIndex = self.environment.len();
        while environmentIndex != 0 {
            environmentIndex -= 1;
            environmentElements.attempt(
                self.environment.asMutSlice()[environmentIndex].deinit(allocator, index),
            );
        }
        if environmentElements.isClean() {
            cleanup.attempt(self.environment.deinit(allocator).withBuildContext(.Release, .Step(index)));
        } else {
            cleanup.attempt(environmentElements.finish());
        }
        let mut argumentElements: CleanupAccumulator[Error] = .init();
        let mut argumentIndex = self.arguments.len();
        while argumentIndex != 0 {
            argumentIndex -= 1;
            argumentElements.attempt(
                self.arguments.asMutSlice()[argumentIndex].deinit(allocator, index),
            );
        }
        if argumentElements.isClean() {
            cleanup.attempt(self.arguments.deinit(allocator).withBuildContext(.Release, .Step(index)));
        } else {
            cleanup.attempt(argumentElements.finish());
        }
        cleanup.attempt(self.workingDirectory.deinit(allocator).withBuildContext(.Release, .Step(index)));
        cleanup.attempt(self.program.deinit(allocator).withBuildContext(.Release, .Step(index)));
        cleanup.finish()
    }
}
