    pub(root) fun init(
        index: usize,
        rootModule: ModuleHandle,
        targetIndex: usize,
    ) StaticArchiveTarget {
        .{ index, name: .init(), rootModule, outputName: .init(), targetIndex }
    }

    pub(root) fun initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        outputName: &[char],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .StaticArchive(self.index)).?;
        self.outputName = string::String::fromSlice(allocator, outputName).withBuildContext(.Retain, .StaticArchive(self.index)).?;
        !()
