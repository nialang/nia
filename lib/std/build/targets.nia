extend TargetView {
    pub fn init(
        arch: &[char],
        vendor: &[char],
        os: &[char],
        env: &[char],
        abi: &[char],
        endian: &[char],
        pointerWidth: u32,
    ) TargetView {
        .{ arch, vendor, os, env, abi, endian, pointerWidth }
    }

    pub fn arch(&self) &[char] {
        self.arch
    }

    pub fn vendor(&self) &[char] {
        self.vendor
    }

    pub fn os(&self) &[char] {
        self.os
    }

    pub fn env(&self) &[char] {
        self.env
    }

    pub fn abi(&self) &[char] {
        self.abi
    }

    pub fn endian(&self) &[char] {
        self.endian
    }

    pub fn pointerWidth(&self) u32 {
        self.pointerWidth
    }

    pub fn equals(&self, other: TargetView) bool {
        self.arch.equals(other.arch)
            and self.vendor.equals(other.vendor)
            and self.os.equals(other.os)
            and self.env.equals(other.env)
            and self.abi.equals(other.abi)
            and self.endian.equals(other.endian)
            and self.pointerWidth == other.pointerWidth
    }
}

extend TargetStorage {
    pub(pkg) fn init(pointerWidth: u32) TargetStorage {
        .{
            arch: .init(),
            vendor: .init(),
            os: .init(),
            env: .init(),
            abi: .init(),
            endian: .init(),
            pointerWidth,
        }
    }

    pub(pkg) fn initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        target: TargetView,
        subject: Subject,
    ) Error!() {
        self.arch = string::String::fromSlice(allocator, target.arch).withBuildContext(.Retain, subject).?;
        self.vendor = string::String::fromSlice(allocator, target.vendor).withBuildContext(.Retain, subject).?;
        self.os = string::String::fromSlice(allocator, target.os).withBuildContext(.Retain, subject).?;
        self.env = string::String::fromSlice(allocator, target.env).withBuildContext(.Retain, subject).?;
        self.abi = string::String::fromSlice(allocator, target.abi).withBuildContext(.Retain, subject).?;
        self.endian = string::String::fromSlice(allocator, target.endian).withBuildContext(.Retain, subject).?;
        !()
    }

    pub(pkg) fn view(&self) TargetView {
        .init(
            self.arch.text(),
            self.vendor.text(),
            self.os.text(),
            self.env.text(),
            self.abi.text(),
            self.endian.text(),
            self.pointerWidth,
        )
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator, subject: Subject) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.endian.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.attempt(self.abi.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.attempt(self.env.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.attempt(self.os.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.attempt(self.vendor.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.attempt(self.arch.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.finish()
    }
}

extend ExecutableOptions {
    // Artifact target is the default. `forHost` is reserved for tools that must
    // execute during this build; arbitrary target construction is not exposed.
    pub fn init(name: &[char], rootModule: ModuleHandle) ExecutableOptions {
        .{
            name,
            rootModule,
            outputName: null,
            targetRole: .Artifact,
            staticArchives: null,
        }
    }

    pub fn withOutputName(self, outputName: &[char]) ExecutableOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?outputName,
            targetRole: self.targetRole,
            staticArchives: self.staticArchives,
        }
    }

    pub fn forHost(self) ExecutableOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            targetRole: .Host,
            staticArchives: self.staticArchives,
        }
    }

    pub fn withStaticArchives(self, staticArchives: &[StaticArchiveHandle]) ExecutableOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            targetRole: self.targetRole,
            staticArchives: ?staticArchives,
        }
    }
}

