            outputName: self.outputName,
            targetRole: .Host,
        }
    }
}

pub(pkg) fn executableOutputName(options: ExecutableOptions) &[char] {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

pub(pkg) fn objectOutputName(options: ObjectOptions) &[char] {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

pub(pkg) fn staticArchiveOutputName(options: StaticArchiveOptions) &[char] {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

pub(pkg) fn isValidStableName(name: &[char]) bool {
    if name.len() == 0 {
        return false;
    }
    for &ch in name.iter() {
        let code = ch as u32;
        let valid = (code >= 48 and code <= 57)
            or (code >= 65 and code <= 90)
            or (code >= 97 and code <= 122)
            or code == 45
            or code == 46
            or code == 95;
        if not valid {
            return false;
        }
    }
    true
}

pub(pkg) fn isValidOutputName(name: &[char]) bool {
    if name.len() == 0 {
        return false;
    }
    for &ch in name.iter() {
        let code = ch as u32;
        if code == 0 or code == 47 or code == 92 {
            return false;
        }
    }
    true
}
