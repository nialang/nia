            self.defines.reserve(allocator, values.len()).withBuildContext(.Retain, .StaticArchive(self.index)).?;
            for &value in values.iter() {
                self.defines.appendAssumeCapacity(string::String::fromSlice(allocator, value.name).withBuildContext(.Retain, .StaticArchive(self.index)).?);
            }
        }
        if systemLibraries is ?values {
            self.systemLibraries.reserve(allocator, values.len()).withBuildContext(.Retain, .StaticArchive(self.index)).?;
            for &value in values.iter() {
                self.systemLibraries.appendAssumeCapacity(.{ name: string::String::fromSlice(allocator, value.name).withBuildContext(.Retain, .StaticArchive(self.index)).?, mode: value.mode });
            }
        }
        !()
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        let mut libraries = self.systemLibraries.len();
        while libraries != 0 { libraries -= 1; cleanup.attempt(self.systemLibraries.asMutSlice()[libraries].name.deinit(allocator).withBuildContext(.Release, .StaticArchive(self.index))); }
        cleanup.attempt(self.systemLibraries.deinit(allocator).withBuildContext(.Release, .StaticArchive(self.index)));
        let mut defines = self.defines.len();
        while defines != 0 { defines -= 1; cleanup.attempt(self.defines.asMutSlice()[defines].deinit(allocator).withBuildContext(.Release, .StaticArchive(self.index))); }
        cleanup.attempt(self.defines.deinit(allocator).withBuildContext(.Release, .StaticArchive(self.index)));
        cleanup.attempt(self.outputName.deinit(allocator).withBuildContext(.Release, .StaticArchive(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .StaticArchive(self.index)));
        cleanup.finish()
    }
}

extend TargetView {
    pub fun init(name: &[char], endian: &[char], pointerWidth: u32) TargetView {
        .{ name, endian, pointerWidth }
    }

    // Canonical target name, such as `x86_64-pc-windows-msvc`.
    pub fun name(&self) &[char] {
        self.name
    }

    pub fun arch(&self) &[char] {
        self.component(0)
    }

    pub fun vendor(&self) &[char] {
        self.component(1)
    }

    pub fun os(&self) &[char] {
        self.component(2)
    }

    // Empty when the platform has no environment component.
    pub fun env(&self) &[char] {
        self.component(3)
    }

    pub fun endian(&self) &[char] {
        self.endian
    }

    pub fun pointerWidth(&self) u32 {
        self.pointerWidth
    }

    pub fun equals(&self, other: TargetView) bool {
        // The toolchain derives every other fact from the name.
        self.name.equals(other.name)
    }

    fun component(&self, index: usize) &[char] {
        let mut start: usize = 0;
        let mut current: usize = 0;
        let mut cursor: usize = 0;
        while cursor < self.name.len() {
            if self.name[cursor] == '-' {
                if current == index {
                    return &self.name[start..cursor];
                }
                current += 1;
                start = cursor + 1;
            }
            cursor += 1;
        }
        if current == index { &self.name[start..] } else { &self.name[self.name.len()..] }
    }
}

extend TargetStorage {
    pub(root) fun init(pointerWidth: u32) TargetStorage {
        .{ name: .init(), endian: .init(), pointerWidth }
    }

    pub(root) fun initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        target: TargetView,
        subject: Subject,
    ) Error!() {
        self.name = string::String::fromSlice(allocator, target.name).withBuildContext(.Retain, subject).?;
        self.endian = string::String::fromSlice(allocator, target.endian).withBuildContext(.Retain, subject).?;
        !()
    }

    pub(root) fun view(&self) TargetView {
        .init(self.name.text(), self.endian.text(), self.pointerWidth)
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator, subject: Subject) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.endian.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, subject));
        cleanup.finish()
    }
}

extend ExecutableOptions {
    // The invocation artifact target is the default. Select another maintained
    // target with `forTarget`: `b.hostTarget()` for tools that execute during
    // this build, or `b.target(name)` for an additional artifact target.
    pub fun init(name: &[char], rootModule: ModuleHandle) ExecutableOptions {
        .{
            name,
            rootModule,
            outputName: null,
            target: null,
            staticArchives: null,
            runtime: .Freestanding,
            linkage: .StaticPie,
            debugInfo: .None,
            panicStrategy: .Abort,
            lto: .Off,
            defines: null,
            systemLibraries: null,
        }
    }

    pub fun withOutputName(self, outputName: &[char]) ExecutableOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?outputName,
            target: self.target,
            staticArchives: self.staticArchives,
            runtime: self.runtime,
            linkage: self.linkage,
            debugInfo: self.debugInfo,
            panicStrategy: self.panicStrategy,
            lto: self.lto,
            defines: self.defines,
            systemLibraries: self.systemLibraries,
        }
    }

    pub fun forTarget(self, target: TargetView) ExecutableOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            target: ?target,
            staticArchives: self.staticArchives,
            runtime: self.runtime,
            linkage: self.linkage,
            debugInfo: self.debugInfo,
            panicStrategy: self.panicStrategy,
            lto: self.lto,
            defines: self.defines,
            systemLibraries: self.systemLibraries,
        }
    }

    pub fun withStaticArchives(self, staticArchives: &[StaticArchiveHandle]) ExecutableOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            target: self.target,
            staticArchives: ?staticArchives,
            runtime: self.runtime,
            linkage: self.linkage,
            debugInfo: self.debugInfo,
            panicStrategy: self.panicStrategy,
            lto: self.lto,
            defines: self.defines,
            systemLibraries: self.systemLibraries,
        }
    }

    // The default remains freestanding for existing build scripts.
    pub fun withRuntime(self, runtime: Runtime) ExecutableOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            target: self.target,
            staticArchives: self.staticArchives,
            runtime,
            linkage: self.linkage,
            debugInfo: self.debugInfo,
            panicStrategy: self.panicStrategy,
            lto: self.lto,
            defines: self.defines,
            systemLibraries: self.systemLibraries,
        }
    }

    pub fun withLinkage(self, linkage: Linkage) ExecutableOptions {
        .{ name: self.name, rootModule: self.rootModule, outputName: self.outputName, target: self.target, staticArchives: self.staticArchives, runtime: self.runtime, linkage, debugInfo: self.debugInfo, panicStrategy: self.panicStrategy, lto: self.lto, defines: self.defines, systemLibraries: self.systemLibraries }
    }

    pub fun withDebugInfo(self, debugInfo: DebugInfo) ExecutableOptions {
        .{ name: self.name, rootModule: self.rootModule, outputName: self.outputName, target: self.target, staticArchives: self.staticArchives, runtime: self.runtime, linkage: self.linkage, debugInfo, panicStrategy: self.panicStrategy, lto: self.lto, defines: self.defines, systemLibraries: self.systemLibraries }
    }

    pub fun withPanicStrategy(self, panicStrategy: PanicStrategy) ExecutableOptions {
        .{ name: self.name, rootModule: self.rootModule, outputName: self.outputName, target: self.target, staticArchives: self.staticArchives, runtime: self.runtime, linkage: self.linkage, debugInfo: self.debugInfo, panicStrategy, lto: self.lto, defines: self.defines, systemLibraries: self.systemLibraries }
    }

    pub fun withLto(self, lto: LtoMode) ExecutableOptions {
        .{ name: self.name, rootModule: self.rootModule, outputName: self.outputName, target: self.target, staticArchives: self.staticArchives, runtime: self.runtime, linkage: self.linkage, debugInfo: self.debugInfo, panicStrategy: self.panicStrategy, lto, defines: self.defines, systemLibraries: self.systemLibraries }
    }

    pub fun withDefines(self, defines: &[ArtifactDefine]) ExecutableOptions {
        .{ name: self.name, rootModule: self.rootModule, outputName: self.outputName, target: self.target, staticArchives: self.staticArchives, runtime: self.runtime, linkage: self.linkage, debugInfo: self.debugInfo, panicStrategy: self.panicStrategy, lto: self.lto, defines: ?defines, systemLibraries: self.systemLibraries }
    }

    pub fun withSystemLibraries(self, libraries: &[SystemLibrary]) ExecutableOptions {
        .{ name: self.name, rootModule: self.rootModule, outputName: self.outputName, target: self.target, staticArchives: self.staticArchives, runtime: self.runtime, linkage: self.linkage, debugInfo: self.debugInfo, panicStrategy: self.panicStrategy, lto: self.lto, defines: self.defines, systemLibraries: ?libraries }
    }
}

