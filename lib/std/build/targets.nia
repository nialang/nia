    pub(root) fun init(
        index: usize,
        rootModule: ModuleHandle,
        targetIndex: usize,
    ) StaticArchiveTarget {
        .{ index, name: .init(), rootModule, outputName: .init(), targetIndex, linkage: .Static, debugInfo: .None, panicStrategy: .Abort, lto: .Off, defines: .init(), systemLibraries: .init() }
