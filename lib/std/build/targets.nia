    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.outputName.deinit(allocator).withBuildContext(.Release, .Object(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Object(self.index)));
        cleanup.finish()
