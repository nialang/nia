// Build artifacts, target triples, and their declaration options.
//
// Public options are borrowed descriptors. The owned target records retain
// names and archive relationships until the build plan has been encoded.

using root::mem;
using root::string;
using root::error::CleanupAccumulator;
using root::build::error;
using root::build::types;

using error::Error;
using error::ErrorSubject as Subject;
using types::{
    ExecutableOptions,
    ExecutableTarget,
    ModuleHandle,
    ObjectOptions,
    ObjectTarget,
    StaticArchiveHandle,
    StaticArchiveOptions,
    StaticArchiveTarget,
    TargetStorage,
    TargetView,
    Runtime,
};

extend ExecutableTarget {
    pub(root) fun init(
        index: usize,
        rootModule: ModuleHandle,
        targetIndex: usize,
    ) ExecutableTarget {
        .{ index, name: .init(), rootModule, outputName: .init(), targetIndex, staticArchives: .init(), runtime: .Freestanding }
    }

    pub(root) fun initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        outputName: &[char],
        staticArchives: ?&[StaticArchiveHandle],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Executable(self.index)).?;
        self.outputName = string::String::fromSlice(allocator, outputName).withBuildContext(.Retain, .Executable(self.index)).?;
        if staticArchives is ?archives {
            self.staticArchives.reserve(
                allocator,
                archives.len(),
            ).withBuildContext(.Retain, .Executable(self.index)).?;
            for &archive in archives.iter() {
                self.staticArchives.appendAssumeCapacity(archive);
            }
        }
        !()
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.staticArchives.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        cleanup.attempt(self.outputName.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        cleanup.finish()
    }
}

extend ObjectTarget {
    pub(root) fun init(
        index: usize,
        rootModule: ModuleHandle,
        targetIndex: usize,
    ) ObjectTarget {
        .{ index, name: .init(), rootModule, outputName: .init(), targetIndex }
    }

    pub(root) fun initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        outputName: &[char],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Object(self.index)).?;
        self.outputName = string::String::fromSlice(allocator, outputName).withBuildContext(.Retain, .Object(self.index)).?;
        !()
