extend StaticArchiveOptions {
    pub fn init(name: &[char], rootModule: ModuleHandle) StaticArchiveOptions {
        .{
            name,
            rootModule,
            outputName: null,
            targetRole: .Artifact,
        }
    }

    pub fn withOutputName(self, outputName: &[char]) StaticArchiveOptions {
        .{
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?outputName,
            targetRole: self.targetRole,
        }
