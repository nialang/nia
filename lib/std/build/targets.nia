// Build artifacts, target triples, and their declaration options.
//
// Public options are borrowed descriptors. The owned target records retain
// names and archive relationships until the build plan has been encoded.

using root::mem;
using root::string;
using root::error::CleanupAccumulator;
using root::build::error;
using root::build::types;

using error::Error;
using error::ErrorSubject as Subject;
using types::{
    ExecutableOptions,
    ExecutableTarget,
    ModuleHandle,
    ObjectOptions,
    ObjectTarget,
    StaticArchiveHandle,
    StaticArchiveOptions,
    StaticArchiveTarget,
    TargetStorage,
    TargetView,
    Runtime,
    Linkage,
    DebugInfo,
    PanicStrategy,
    LtoMode,
    ArtifactDefine,
    SystemLibrary,
    SystemLibraryMode,
    OwnedSystemLibrary,
};

extend ArtifactDefine {
    pub fun init(name: &[char]) ArtifactDefine {
        .{ name }
    }
}

extend SystemLibrary {
    pub fun init(name: &[char], mode: SystemLibraryMode) SystemLibrary {
        .{ name, mode }
    }
}

extend ExecutableTarget {
    pub(root) fun init(
        index: usize,
        rootModule: ModuleHandle,
        targetIndex: usize,
    ) ExecutableTarget {
        .{ index, name: .init(), rootModule, outputName: .init(), targetIndex, staticArchives: .init(), runtime: .Freestanding, linkage: .StaticPie, debugInfo: .None, panicStrategy: .Abort, lto: .Off, defines: .init(), systemLibraries: .init(), test: false }
    }

    pub(root) fun initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        outputName: &[char],
        staticArchives: ?&[StaticArchiveHandle],
        linkage: Linkage,
        debugInfo: DebugInfo,
        panicStrategy: PanicStrategy,
        lto: LtoMode,
        defines: ?&[ArtifactDefine],
        systemLibraries: ?&[SystemLibrary],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Executable(self.index)).?;
        self.outputName = string::String::fromSlice(allocator, outputName).withBuildContext(.Retain, .Executable(self.index)).?;
        if staticArchives is ?archives {
            self.staticArchives.reserve(
                allocator,
                archives.len(),
            ).withBuildContext(.Retain, .Executable(self.index)).?;
            for &archive in archives.iter() {
                self.staticArchives.appendAssumeCapacity(archive);
            }
        }
        self.linkage = linkage;
        self.debugInfo = debugInfo;
        self.panicStrategy = panicStrategy;
        self.lto = lto;
        if defines is ?values {
            self.defines.reserve(allocator, values.len()).withBuildContext(.Retain, .Executable(self.index)).?;
            for &value in values.iter() {
                self.defines.appendAssumeCapacity(string::String::fromSlice(allocator, value.name).withBuildContext(.Retain, .Executable(self.index)).?);
            }
        }
        if systemLibraries is ?values {
            self.systemLibraries.reserve(allocator, values.len()).withBuildContext(.Retain, .Executable(self.index)).?;
            for &value in values.iter() {
                self.systemLibraries.appendAssumeCapacity(.{ name: string::String::fromSlice(allocator, value.name).withBuildContext(.Retain, .Executable(self.index)).?, mode: value.mode });
            }
        }
        !()
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        let mut libraries = self.systemLibraries.len();
        while libraries != 0 {
            libraries -= 1;
            cleanup.attempt(self.systemLibraries.asMutSlice()[libraries].name.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        }
        cleanup.attempt(self.systemLibraries.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        let mut defines = self.defines.len();
        while defines != 0 {
            defines -= 1;
            cleanup.attempt(self.defines.asMutSlice()[defines].deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        }
        cleanup.attempt(self.defines.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        cleanup.attempt(self.staticArchives.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        cleanup.attempt(self.outputName.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Executable(self.index)));
        cleanup.finish()
    }
}

extend ObjectTarget {
    pub(root) fun init(
        index: usize,
        rootModule: ModuleHandle,
        targetIndex: usize,
    ) ObjectTarget {
        .{ index, name: .init(), rootModule, outputName: .init(), targetIndex, linkage: .Static, debugInfo: .None, panicStrategy: .Abort, lto: .Off, defines: .init(), systemLibraries: .init() }
    }

    pub(root) fun initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        outputName: &[char],
        linkage: Linkage,
        debugInfo: DebugInfo,
        panicStrategy: PanicStrategy,
        lto: LtoMode,
        defines: ?&[ArtifactDefine],
        systemLibraries: ?&[SystemLibrary],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Object(self.index)).?;
        self.outputName = string::String::fromSlice(allocator, outputName).withBuildContext(.Retain, .Object(self.index)).?;
        self.linkage = linkage;
        self.debugInfo = debugInfo;
        self.panicStrategy = panicStrategy;
        self.lto = lto;
        if defines is ?values {
            self.defines.reserve(allocator, values.len()).withBuildContext(.Retain, .Object(self.index)).?;
            for &value in values.iter() {
                self.defines.appendAssumeCapacity(string::String::fromSlice(allocator, value.name).withBuildContext(.Retain, .Object(self.index)).?);
            }
        }
        if systemLibraries is ?values {
            self.systemLibraries.reserve(allocator, values.len()).withBuildContext(.Retain, .Object(self.index)).?;
            for &value in values.iter() {
                self.systemLibraries.appendAssumeCapacity(.{ name: string::String::fromSlice(allocator, value.name).withBuildContext(.Retain, .Object(self.index)).?, mode: value.mode });
            }
        }
        !()
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        let mut libraries = self.systemLibraries.len();
        while libraries != 0 { libraries -= 1; cleanup.attempt(self.systemLibraries.asMutSlice()[libraries].name.deinit(allocator).withBuildContext(.Release, .Object(self.index))); }
        cleanup.attempt(self.systemLibraries.deinit(allocator).withBuildContext(.Release, .Object(self.index)));
        let mut defines = self.defines.len();
        while defines != 0 { defines -= 1; cleanup.attempt(self.defines.asMutSlice()[defines].deinit(allocator).withBuildContext(.Release, .Object(self.index))); }
        cleanup.attempt(self.defines.deinit(allocator).withBuildContext(.Release, .Object(self.index)));
        cleanup.attempt(self.outputName.deinit(allocator).withBuildContext(.Release, .Object(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Object(self.index)));
        cleanup.finish()
    }
}

