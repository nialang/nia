using pkg::error;
using pkg::fmt;
using pkg::fs;
using pkg::mem;
using pkg::os;
using pkg::process;

pub enum ErrorOperation {
    Initialize,
    Retain,
    Release,
    Validate,
    Encode,
    Publish,
    AssembleCommand,
    ExecuteCommand,
    Report,
}

pub enum ErrorSubject {
    Build,
    PackageRoot,
    BuildDir,
    CacheDir,
    ToolchainExecutable,
    ToolchainResourceRoot,
    HostTarget,
    ArtifactTarget,
    BuildPlan,
    Steps,
    Dependencies,
    Modules,
    Executables,
    Step(usize),
    Module(usize),
    Executable(usize),
    ModuleImport(usize),
    Output,
    Compiler,
    Diagnostic,
    RequestedStep,
}

pub enum ErrorCause {
    Memory(mem::Error),
    Format(fmt::Error),
    FileSystem(fs::Error),
    Process(process::Error),
    Exit(process::Term),
}

pub enum Error {
    UnknownStep,
    Invalid { operation: ErrorOperation, subject: ErrorSubject },
    Failure { operation: ErrorOperation, subject: ErrorSubject, cause: ErrorCause },
    Internal(ErrorOperation),
    StepCycle { step: usize, dependency: usize },
    StepFailed(usize),
    MissingDefaultStep,
}

extend Error {
    pub fn asExitCode(self) process::ExitCode {
        switch self {
            Error::UnknownStep => process::exit(2),
            Error::Invalid { operation, subject } => {
                _ = operation;
                _ = subject;
                process::exit(22)
            },
            Error::Failure { operation, subject, cause } => {
                _ = operation;
                _ = subject;
                cause.asExitCode()
            },
            Error::Internal(operation) => {
                _ = operation;
                process::exit(255)
            },
            Error::StepCycle { step, dependency } => {
                _ = step;
                _ = dependency;
                process::exit(22)
            },
            Error::StepFailed(step) => {
                _ = step;
                process::exit(1)
            },
            Error::MissingDefaultStep => process::exit(22),
        }
    }
}

extend ErrorCause {
    fn asExitCode(self) process::ExitCode {
        switch self {
            ErrorCause::Memory(cause) => switch cause {
                mem::Error::OutOfMemory => process::exit(12),
                _ => process::exit(255),
            },
            ErrorCause::Format(cause) => switch cause {
                fmt::Error::Write => process::exit(5),
                _ => process::exit(255),
            },
            ErrorCause::FileSystem(cause) => switch cause {
                fs::Error::OutOfMemory => process::exit(12),
                _ => process::exit(5),
            },
            ErrorCause::Process(cause) => cause.asExitCode(),
            ErrorCause::Exit(cause) => {
                _ = cause;
                process::exit(1)
            },
        }
    }
}

extend[T] Error!T {
    pub fn exit(self) process::ExitCode!T {
        self.cast_error()
    }
}

extend Error : error::IntoError[process::ExitCode] {
    fn into_error(self) process::ExitCode {
        self.asExitCode()
    }
}

extend[T] fmt::Error!T {
    pub fn asBuildError(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::Format(cause),
            }!,
        }
    }
}

extend[T] fs::Error!T {
    pub fn asBuildError(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::FileSystem(cause),
            }!,
        }
    }
}

extend[T] process::Error!T {
    pub fn asBuildError(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::Process(cause),
            }!,
        }
    }
}

extend[T] mem::Error!T {
    pub fn asBuildError(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::Memory(cause),
            }!,
        }
    }
}

extend ErrorOperation : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        formatter.write_text(switch self.* {
            ErrorOperation::Initialize => &"initialize",
            ErrorOperation::Retain => &"retain",
            ErrorOperation::Release => &"release",
            ErrorOperation::Validate => &"validate",
            ErrorOperation::Encode => &"encode",
            ErrorOperation::Publish => &"publish",
            ErrorOperation::AssembleCommand => &"assemble command",
            ErrorOperation::ExecuteCommand => &"execute command",
            ErrorOperation::Report => &"report",
        })
    }
}

extend ErrorSubject : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        switch self.* {
            ErrorSubject::Build => formatter.write_text(&"build"),
            ErrorSubject::PackageRoot => formatter.write_text(&"package root"),
            ErrorSubject::BuildDir => formatter.write_text(&"build directory"),
            ErrorSubject::CacheDir => formatter.write_text(&"cache directory"),
            ErrorSubject::ToolchainExecutable => formatter.write_text(&"toolchain executable"),
            ErrorSubject::ToolchainResourceRoot => formatter.write_text(&"toolchain resource root"),
            ErrorSubject::HostTarget => formatter.write_text(&"host target"),
            ErrorSubject::ArtifactTarget => formatter.write_text(&"artifact target"),
            ErrorSubject::BuildPlan => formatter.write_text(&"build plan"),
            ErrorSubject::Steps => formatter.write_text(&"step collection"),
            ErrorSubject::Dependencies => formatter.write_text(&"dependency collection"),
            ErrorSubject::Modules => formatter.write_text(&"module collection"),
            ErrorSubject::Executables => formatter.write_text(&"executable collection"),
            ErrorSubject::Step(index) => writeIndexedSubject(formatter, &"step", index),
            ErrorSubject::Module(index) => writeIndexedSubject(formatter, &"module", index),
            ErrorSubject::Executable(index) => writeIndexedSubject(formatter, &"executable", index),
            ErrorSubject::ModuleImport(index) => writeIndexedSubject(formatter, &"module import", index),
            ErrorSubject::Output => formatter.write_text(&"output"),
            ErrorSubject::Compiler => formatter.write_text(&"compiler"),
            ErrorSubject::Diagnostic => formatter.write_text(&"diagnostic"),
            ErrorSubject::RequestedStep => formatter.write_text(&"requested step"),
        }
    }
}

extend ErrorCause : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        switch self.* {
            ErrorCause::Memory(cause) => {
                writeCausePrefix(formatter, &"memory").?;
                writeMemoryCause(formatter, cause)
            },
            ErrorCause::Format(cause) => {
                writeCausePrefix(formatter, &"format").?;
                writeFormatCause(formatter, cause)
            },
            ErrorCause::FileSystem(cause) => {
                writeCausePrefix(formatter, &"filesystem").?;
                writeFileSystemCause(formatter, cause)
            },
            ErrorCause::Process(cause) => {
                writeCausePrefix(formatter, &"process").?;
                writeProcessCause(formatter, cause)
            },
            ErrorCause::Exit(cause) => writeTermCause(formatter, cause),
        }
    }
}

extend Error : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        switch self.* {
            Error::UnknownStep => formatter.write_text(&"unknown requested step"),
            Error::Invalid { operation, subject } => {
                formatter.write_text(&"invalid ").?;
                subject.format(formatter).?;
                formatter.write_text(&" during ").?;
                operation.format(formatter)
            },
            Error::Failure { operation, subject, cause } => {
                operation.format(formatter).?;
                formatter.write_text(&" ").?;
                subject.format(formatter).?;
                formatter.write_text(&": ").?;
                cause.format(formatter)
            },
            Error::Internal(operation) => {
                formatter.write_text(&"internal build failure during ").?;
                operation.format(formatter)
            },
            Error::StepCycle { step, dependency } => {
                formatter.write_text(&"step cycle between ").?;
                formatter.write_unsigned(step as u128).?;
                formatter.write_text(&" and ").?;
                formatter.write_unsigned(dependency as u128)
            },
            Error::StepFailed(step) => {
                formatter.write_text(&"previously failed step ").?;
                formatter.write_unsigned(step as u128)
            },
            Error::MissingDefaultStep => formatter.write_text(&"build declares steps without a default"),
        }
    }
}

fn writeIndexedSubject(
    formatter: &mut fmt::Formatter,
    name: &[char],
    index: usize,
) fmt::Error!void {
    formatter.write_text(name).?;
    formatter.write_text(&"[").?;
    formatter.write_unsigned(index as u128).?;
    formatter.write_text(&"]")
}

fn writeCausePrefix(formatter: &mut fmt::Formatter, domain: &[char]) fmt::Error!void {
    formatter.write_text(domain).?;
    formatter.write_text(&"/")
}

fn writeTermCause(formatter: &mut fmt::Formatter, cause: process::Term) fmt::Error!void {
    formatter.write_text(&"command/").?;
    formatter.write_text(switch cause.kind() {
        process::TermKind::Exited => &"exit code ",
        process::TermKind::Signal => &"signal ",
        process::TermKind::Stopped => &"stopped by signal ",
        process::TermKind::Unknown => &"unknown status ",
    }).?;
    formatter.write_signed(cause.code() as i128)
}

fn writeMemoryCause(formatter: &mut fmt::Formatter, cause: mem::Error) fmt::Error!void {
    switch cause {
        mem::Error::Invalid => formatter.write_text(&"invalid"),
        mem::Error::InvalidAlignment => formatter.write_text(&"invalid alignment"),
        mem::Error::OutOfMemory => formatter.write_text(&"out of memory"),
        mem::Error::System => formatter.write_text(&"system"),
        _ => formatter.write_text(&"unknown"),
    }
}

fn writeFormatCause(formatter: &mut fmt::Formatter, cause: fmt::Error) fmt::Error!void {
    switch cause {
        fmt::Error::Write => formatter.write_text(&"write"),
        fmt::Error::InvalidTemplate => formatter.write_text(&"invalid template"),
        fmt::Error::MissingArgument => formatter.write_text(&"missing argument"),
        fmt::Error::ExtraArgument => formatter.write_text(&"extra argument"),
        _ => formatter.write_text(&"unknown"),
    }
}

fn writeFileSystemCause(formatter: &mut fmt::Formatter, cause: fs::Error) fmt::Error!void {
    switch cause {
        fs::Error::PermissionDenied => formatter.write_text(&"permission denied"),
        fs::Error::NotFound => formatter.write_text(&"not found"),
        fs::Error::OutOfMemory => formatter.write_text(&"out of memory"),
        fs::Error::AlreadyExists => formatter.write_text(&"already exists"),
        fs::Error::NotDir => formatter.write_text(&"not a directory"),
        fs::Error::IsDir => formatter.write_text(&"is a directory"),
        fs::Error::Invalid => formatter.write_text(&"invalid"),
        fs::Error::NoSpace => formatter.write_text(&"no space"),
        fs::Error::TooLong => formatter.write_text(&"too long"),
        fs::Error::Io => formatter.write_text(&"I/O"),
        _ => formatter.write_text(&"system"),
    }
}

fn writeProcessCause(formatter: &mut fmt::Formatter, cause: process::Error) fmt::Error!void {
    switch cause {
        process::Error::Allocation(cause) => {
            writeCausePrefix(formatter, &"allocation").?;
            writeMemoryCause(formatter, cause)
        },
        process::Error::Path(cause) => {
            writeCausePrefix(formatter, &"path").?;
            writePathCause(formatter, cause)
        },
        process::Error::ArgumentContainsNul(index) => {
            formatter.write_text(&"argument[").?;
            formatter.write_unsigned(index as u128).?;
            formatter.write_text(&"]/contains NUL")
        },
        process::Error::Environment { index, cause } => {
            formatter.write_text(&"environment[").?;
            formatter.write_unsigned(index as u128).?;
            formatter.write_text(&"]/").?;
            writeEnvEntryCause(formatter, cause)
        },
        process::Error::SpawnSetup(cause) => {
            writeCausePrefix(formatter, &"spawn setup").?;
            writeOsCause(formatter, cause)
        },
        process::Error::Spawn(cause) => {
            writeCausePrefix(formatter, &"spawn").?;
            writeSpawnCause(formatter, cause)
        },
        process::Error::Wait(cause) => {
            writeCausePrefix(formatter, &"wait").?;
            writeOsCause(formatter, cause)
        },
        process::Error::TryWait(cause) => {
            writeCausePrefix(formatter, &"try wait").?;
            writeOsCause(formatter, cause)
        },
        process::Error::Kill(cause) => {
            writeCausePrefix(formatter, &"kill").?;
            writeOsCause(formatter, cause)
        },
        process::Error::Close { stream, cause } => {
            writeCausePrefix(formatter, &"close").?;
            writeStdStream(formatter, stream).?;
            formatter.write_text(&"/").?;
            writeOsCause(formatter, cause)
        },
    }
}

fn writeEnvEntryCause(formatter: &mut fmt::Formatter, cause: process::EnvEntryError) fmt::Error!void {
    switch cause {
        process::EnvEntryError::EmptyName => formatter.write_text(&"empty name"),
        process::EnvEntryError::NameContainsEquals => formatter.write_text(&"name contains '='"),
        process::EnvEntryError::NameContainsNul => formatter.write_text(&"name contains NUL"),
        process::EnvEntryError::ValueContainsNul => formatter.write_text(&"value contains NUL"),
        process::EnvEntryError::DuplicateName(firstIndex) => {
            formatter.write_text(&"duplicates environment[").?;
            formatter.write_unsigned(firstIndex as u128).?;
            formatter.write_text(&"]")
        },
    }
}

fn writePathCause(formatter: &mut fmt::Formatter, cause: fs::PathError) fmt::Error!void {
    switch cause {
        fs::PathError::ContainsNul => formatter.write_text(&"contains NUL"),
        fs::PathError::TooLong => formatter.write_text(&"too long"),
        _ => formatter.write_text(&"unknown"),
    }
}

fn writeStdStream(formatter: &mut fmt::Formatter, stream: process::StdStream) fmt::Error!void {
    formatter.write_text(switch stream {
        process::StdStream::Stdin => &"stdin",
        process::StdStream::Stdout => &"stdout",
        process::StdStream::Stderr => &"stderr",
    })
}

fn writeOsCause(formatter: &mut fmt::Formatter, cause: os::Error) fmt::Error!void {
    formatter.write_text(switch cause {
        os::Error::PermissionDenied => &"permission denied",
        os::Error::NotFound => &"not found",
        os::Error::Interrupted => &"interrupted",
        os::Error::Io => &"I/O",
        os::Error::BadFd => &"bad file descriptor",
        os::Error::Again => &"try again",
        os::Error::OutOfMemory => &"out of memory",
        os::Error::Access => &"access denied",
        os::Error::Fault => &"bad address",
        os::Error::Busy => &"busy",
        os::Error::AlreadyExists => &"already exists",
        os::Error::CrossDevice => &"cross device",
        os::Error::NotDir => &"not a directory",
        os::Error::IsDir => &"is a directory",
        os::Error::Invalid => &"invalid",
        os::Error::NoSpace => &"no space",
        os::Error::ReadOnly => &"read only",
        os::Error::BrokenPipe => &"broken pipe",
        os::Error::OutOfRange => &"out of range",
        os::Error::TooLong => &"too long",
        os::Error::NotEmpty => &"not empty",
        os::Error::System => &"system",
        _ => &"unknown",
    })
}

fn writeSpawnCause(formatter: &mut fmt::Formatter, cause: os::SpawnError) fmt::Error!void {
    formatter.write_text(switch cause {
        os::SpawnError::PermissionDenied => &"permission denied",
        os::SpawnError::NotFound => &"not found",
        os::SpawnError::Interrupted => &"interrupted",
        os::SpawnError::Io => &"I/O",
        os::SpawnError::BadFd => &"bad file descriptor",
        os::SpawnError::Again => &"try again",
        os::SpawnError::OutOfMemory => &"out of memory",
        os::SpawnError::Access => &"access denied",
        os::SpawnError::Fault => &"bad address",
        os::SpawnError::Busy => &"busy",
        os::SpawnError::AlreadyExists => &"already exists",
        os::SpawnError::CrossDevice => &"cross device",
        os::SpawnError::NotDir => &"not a directory",
        os::SpawnError::IsDir => &"is a directory",
        os::SpawnError::Invalid => &"invalid",
        os::SpawnError::NoSpace => &"no space",
        os::SpawnError::ReadOnly => &"read only",
        os::SpawnError::BrokenPipe => &"broken pipe",
        os::SpawnError::OutOfRange => &"out of range",
        os::SpawnError::TooLong => &"too long",
        os::SpawnError::NotEmpty => &"not empty",
        os::SpawnError::Setup => &"setup",
        os::SpawnError::Stdio => &"standard I/O",
        os::SpawnError::Cwd => &"working directory",
        os::SpawnError::Exec => &"executable",
        os::SpawnError::System => &"system",
        _ => &"unknown",
    })
}
