    pub fun withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => .Failure {
                operation: operation,
                subject: subject,
                cause: .Io(cause),
            }!,
        }
    }
}

extend[T] process::Error!T {
    pub fun withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => .Failure {
                operation: operation,
                subject: subject,
                cause: .Process(cause),
            }!,
        }
    }
}

extend[T] mem::Error!T {
    pub fun withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => .Failure {
                operation: operation,
                subject: subject,
                cause: .Memory(cause),
            }!,
        }
    }
}
