using pkg::error;
using pkg::fmt;
using pkg::fs;
using pkg::mem;
using pkg::process;

pub enum Error: i32 {
    UnknownStep = 1,
    InvalidStep = 2,
    OutOfMemory = 3,
    Report = 4,
    Internal = 5,
    CommandFailed = 6,
    InvalidTarget = 7,
    StepCycle = 8,
    StepFailed = 9,
    MissingDefaultStep = 10,
    _,
}

extend Error {
    pub fn asExitCode(self) process::ExitCode {
        switch self {
            Error::UnknownStep => process::exit(2),
            Error::InvalidStep => process::exit(22),
            Error::OutOfMemory => process::exit(12),
            Error::Report => process::exit(5),
            Error::Internal => process::exit(255),
            Error::CommandFailed => process::exit(1),
            Error::InvalidTarget => process::exit(22),
            Error::StepCycle => process::exit(22),
            Error::StepFailed => process::exit(1),
            Error::MissingDefaultStep => process::exit(22),
            _ => process::exit(255),
        }
    }
}

extend[T] Error!T {
    pub fn exit(self) process::ExitCode!T {
        self.cast_error()
    }
}

extend Error : error::IntoError[process::ExitCode] {
    fn into_error(self) process::ExitCode {
        self.asExitCode()
    }
}

extend fmt::Error : error::IntoError[Error] {
    fn into_error(self) Error {
        switch self {
            fmt::Error::Write => Error::Report,
            fmt::Error::InvalidTemplate => Error::Internal,
            fmt::Error::MissingArgument => Error::Internal,
            fmt::Error::ExtraArgument => Error::Internal,
            _ => Error::Internal,
        }
    }
}

extend[T] fmt::Error!T {
    pub fn asBuildError(self) Error!T {
        self.cast_error()
    }
}

extend fs::Error : error::IntoError[Error] {
    fn into_error(self) Error {
        switch self {
            fs::Error::Invalid => Error::Report,
            fs::Error::Io => Error::Report,
            fs::Error::TooLong => Error::Report,
            fs::Error::NotFound => Error::Report,
            fs::Error::AlreadyExists => Error::Report,
            fs::Error::NotDir => Error::Report,
            fs::Error::IsDir => Error::Report,
            fs::Error::NoSpace => Error::Report,
            fs::Error::OutOfMemory => Error::OutOfMemory,
            _ => Error::Report,
        }
    }
}

extend[T] fs::Error!T {
    pub fn asBuildError(self) Error!T {
        self.cast_error()
    }
}

extend process::Error : error::IntoError[Error] {
    fn into_error(self) Error {
        switch self {
            process::Error::Invalid => Error::InvalidStep,
            process::Error::SpawnSetup => Error::Report,
            process::Error::SpawnStdio => Error::Report,
            process::Error::SpawnCwd => Error::Report,
            process::Error::SpawnExec => Error::Report,
            process::Error::Wait => Error::Report,
            process::Error::TryWait => Error::Report,
            process::Error::Kill => Error::Report,
            process::Error::CloseStdin => Error::Report,
            process::Error::CloseStdout => Error::Report,
            process::Error::CloseStderr => Error::Report,
            process::Error::System => Error::Report,
            _ => Error::Report,
        }
    }
}

extend[T] process::Error!T {
    pub fn asBuildError(self) Error!T {
        self.cast_error()
    }
}

extend mem::Error : error::IntoError[Error] {
    fn into_error(self) Error {
        switch self {
            mem::Error::OutOfMemory => Error::OutOfMemory,
            _ => Error::InvalidStep,
        }
    }
}

extend[T] mem::Error!T {
    pub fn asBuildError(self) Error!T {
        self.cast_error()
    }
}
