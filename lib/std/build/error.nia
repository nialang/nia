// Build-script construction, validation, handoff, and cleanup failures.
//
// Context records the attempted operation and owned subject while `ErrorCause`
// preserves allocation, formatting, filesystem, process, and exit failures.
// Ordinary build errors propagate explicitly; `Internal` is reserved for a
// violated build-library invariant.

using root::builtin;
using root::fmt;
using root::fs;
using root::io;
using root::mem;
using root::process;

pub enum ErrorOperation {
    Initialize,
    Retain,
    Release,
    Validate,
    Encode,
    Publish,
    AssembleCommand,
    ExecuteCommand,
    Report,
}

pub enum ErrorSubject {
    Build,
    PackageRoot,
    BuildDir,
    CacheDir,
    ToolchainExecutable,
    ToolchainResourceRoot,
    RunnerConfiguration,
    HostTarget,
    ArtifactTarget,
    Targets,
    BuildPlan,
    Steps,
    Dependencies,
    Packages,
    Modules,
    Executables,
    Objects,
    StaticArchives,
    Step(usize),
    Package(usize),
    Module(usize),
    Executable(usize),
    Object(usize),
    StaticArchive(usize),
    ModuleImport(usize),
    Output,
    Compiler,
    Diagnostic,
    RequestedStep,
}

pub enum ErrorCause {
    Memory(mem::Error),
    Format(fmt::Error),
    Io(io::Error),
    FileSystem(fs::Error),
    FileSystemOperation(fs::OperationError),
    Process(process::Error),
    Exit(process::Term),
}

pub enum Error {
    UnknownStep,
    Invalid { operation: ErrorOperation, subject: ErrorSubject },
    Failure { operation: ErrorOperation, subject: ErrorSubject, cause: ErrorCause },
    Internal(ErrorOperation),
    StepCycle { step: usize, dependency: usize },
    StepFailed(usize),
    MissingDefaultStep,
}

extend ErrorCause : builtin::IntoError[process::ExitCode] {
    const fun intoError(self) process::ExitCode {
        match self {
            .Memory(cause) => match cause {
                .OutOfMemory => process::ExitCode(12),
                _ => process::ExitCode(255),
            },
            .Format(cause) => match cause {
                .Write => process::ExitCode(5),
                _ => process::ExitCode(255),
            },
            .Io(_) => process::ExitCode(5),
            .FileSystem(cause) => match cause {
                .OutOfMemory => process::ExitCode(12),
                _ => process::ExitCode(5),
            },
            .FileSystemOperation(cause) => cause.intoError(),
            .Process(cause) => cause.intoError(),
            .Exit(_) => process::ExitCode(1),
        }
    }
}

extend Error : builtin::IntoError[process::ExitCode] {
    const fun intoError(self) process::ExitCode {
        match self {
            .UnknownStep => process::ExitCode(2),
            .Invalid { operation: _, subject: _ } => process::ExitCode(22),
            .Failure { operation: _, subject: _, cause } => cause.intoError(),
            .Internal(_) => process::ExitCode(255),
            .StepCycle { step: _, dependency: _ } => process::ExitCode(22),
            .StepFailed(_) => process::ExitCode(1),
            .MissingDefaultStep => process::ExitCode(22),
        }
    }
}

extend[T] fmt::Error!T {
    pub fun withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => .Failure {
                operation: operation,
                subject: subject,
                cause: .Format(cause),
            }!,
        }
    }
}

extend[T] fs::Error!T {
    pub fun withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => .Failure {
                operation: operation,
