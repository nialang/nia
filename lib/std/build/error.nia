// Build-script construction, validation, handoff, and cleanup failures.
//
// Context records the attempted operation and owned subject while `ErrorCause`
// preserves allocation, formatting, filesystem, process, and exit failures.
// Ordinary build errors propagate explicitly; `Internal` is reserved for a
// violated build-library invariant.

using pkg::error;
using pkg::fmt;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::process;

pub enum ErrorOperation {
    Initialize,
    Retain,
    Release,
    Validate,
    Encode,
    Publish,
    AssembleCommand,
    ExecuteCommand,
    Report,
}

pub enum ErrorSubject {
    Build,
    PackageRoot,
    BuildDir,
    CacheDir,
    ToolchainExecutable,
    ToolchainResourceRoot,
    RunnerConfiguration,
    HostTarget,
    ArtifactTarget,
    BuildPlan,
    Steps,
    Dependencies,
    Packages,
    Modules,
    Executables,
    Objects,
    StaticArchives,
    Step(usize),
    Package(usize),
    Module(usize),
    Executable(usize),
    Object(usize),
    StaticArchive(usize),
    ModuleImport(usize),
    Output,
    Compiler,
    Diagnostic,
    RequestedStep,
}

pub enum ErrorCause {
    Memory(mem::Error),
    Format(fmt::Error),
    FileSystem(fs::Error),
    FileSystemOperation(fs::OperationError),
    Process(process::Error),
    Exit(process::Term),
}

pub enum Error {
    UnknownStep,
    Invalid { operation: ErrorOperation, subject: ErrorSubject },
    Failure { operation: ErrorOperation, subject: ErrorSubject, cause: ErrorCause },
    Internal(ErrorOperation),
    StepCycle { step: usize, dependency: usize },
    StepFailed(usize),
    MissingDefaultStep,
}

extend Error {
    pub const fn asExitCode(self) process::ExitCode {
        match self {
            Error::UnknownStep => process::exit(2),
            Error::Invalid { operation: _, subject: _ } => {
                process::exit(22)
            },
            Error::Failure { operation: _, subject: _, cause } => {
                cause.asExitCode()
            },
            Error::Internal(_) => {
                process::exit(255)
            },
            Error::StepCycle { step: _, dependency: _ } => {
                process::exit(22)
            },
            Error::StepFailed(_) => {
                process::exit(1)
            },
            Error::MissingDefaultStep => process::exit(22),
        }
    }
}

extend ErrorCause {
    const fn asExitCode(self) process::ExitCode {
        match self {
            ErrorCause::Memory(cause) => match cause {
                .OutOfMemory => process::exit(12),
                _ => process::exit(255),
            },
            ErrorCause::Format(cause) => match cause {
                .Write => process::exit(5),
                _ => process::exit(255),
            },
            ErrorCause::FileSystem(cause) => match cause {
                .OutOfMemory => process::exit(12),
                _ => process::exit(5),
            },
            ErrorCause::FileSystemOperation(cause) => cause.asExitCode(),
            ErrorCause::Process(cause) => cause.asExitCode(),
            ErrorCause::Exit(_) => {
                process::exit(1)
            },
        }
    }
}

extend[T] Error!T {
    pub fn exit(self) process::ExitCode!T {
        self.mapError(&\cause: Error -> cause.into_error())
    }
}

extend Error : error::IntoError[process::ExitCode] {
    const fn into_error(self) process::ExitCode {
        self.asExitCode()
    }
}

extend[T] fmt::Error!T {
    pub fn withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::Format(cause),
            }!,
        }
    }
}

extend[T] fs::Error!T {
    pub fn withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::FileSystem(cause),
            }!,
        }
    }
}

extend[T] fs::OperationError!T {
    pub fn withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::FileSystemOperation(cause),
            }!,
        }
    }
}

extend[T] process::Error!T {
    pub fn withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::Process(cause),
            }!,
        }
    }
}

extend[T] mem::Error!T {
    pub fn withBuildContext(self, operation: ErrorOperation, subject: ErrorSubject) Error!T {
        match self {
            !value => !value,
            cause! => Error::Failure {
                operation: operation,
                subject: subject,
                cause: ErrorCause::Memory(cause),
            }!,
        }
    }
}

extend ErrorOperation : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        formatter.writeText(match self.* {
            .Initialize => &"initialize",
            .Retain => &"retain",
            .Release => &"release",
            .Validate => &"validate",
            .Encode => &"encode",
            .Publish => &"publish",
            .AssembleCommand => &"assemble command",
            .ExecuteCommand => &"execute command",
            .Report => &"report",
        })
    }
}

extend ErrorSubject : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        match self.* {
            .Build => formatter.writeText(&"build"),
            .PackageRoot => formatter.writeText(&"package root"),
            .BuildDir => formatter.writeText(&"build directory"),
            .CacheDir => formatter.writeText(&"cache directory"),
            .ToolchainExecutable => formatter.writeText(&"toolchain executable"),
            .ToolchainResourceRoot => formatter.writeText(&"toolchain resource root"),
            .RunnerConfiguration => formatter.writeText(&"build runner configuration"),
            .HostTarget => formatter.writeText(&"host target"),
            .ArtifactTarget => formatter.writeText(&"artifact target"),
            .BuildPlan => formatter.writeText(&"build plan"),
            .Steps => formatter.writeText(&"step collection"),
            .Dependencies => formatter.writeText(&"dependency collection"),
            .Packages => formatter.writeText(&"package collection"),
            .Modules => formatter.writeText(&"module collection"),
            .Executables => formatter.writeText(&"executable collection"),
            .Objects => formatter.writeText(&"object collection"),
            .StaticArchives => formatter.writeText(&"static archive collection"),
            .Step(index) => writeIndexedSubject(formatter, &"step", index),
            .Package(index) => writeIndexedSubject(formatter, &"package", index),
            .Module(index) => writeIndexedSubject(formatter, &"module", index),
            .Executable(index) => writeIndexedSubject(formatter, &"executable", index),
            .Object(index) => writeIndexedSubject(formatter, &"object", index),
            .StaticArchive(index) => writeIndexedSubject(formatter, &"static archive", index),
            .ModuleImport(index) => writeIndexedSubject(formatter, &"module import", index),
            .Output => formatter.writeText(&"output"),
            .Compiler => formatter.writeText(&"compiler"),
            .Diagnostic => formatter.writeText(&"diagnostic"),
            .RequestedStep => formatter.writeText(&"requested step"),
        }
    }
}

extend ErrorCause : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        match self.* {
            ErrorCause::Memory(cause) => {
                writeCausePrefix(formatter, &"memory").?;
                writeMemoryCause(formatter, cause)
            },
            ErrorCause::Format(cause) => {
                writeCausePrefix(formatter, &"format").?;
                writeFormatCause(formatter, cause)
            },
            ErrorCause::FileSystem(cause) => {
                writeCausePrefix(formatter, &"filesystem").?;
                writeFileSystemCause(formatter, cause)
            },
            ErrorCause::FileSystemOperation(cause) => {
                writeCausePrefix(formatter, &"filesystem").?;
                writeFileSystemOperationCause(formatter, cause)
            },
            ErrorCause::Process(cause) => {
                writeCausePrefix(formatter, &"process").?;
                writeProcessCause(formatter, cause)
            },
            ErrorCause::Exit(cause) => writeTermCause(formatter, cause),
        }
    }
}

extend Error : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        match self.* {
            Error::UnknownStep => formatter.writeText(&"unknown requested step"),
            Error::Invalid { operation, subject } => {
                formatter.writeText(&"invalid ").?;
                subject.format(formatter).?;
                formatter.writeText(&" during ").?;
                operation.format(formatter)
            },
            Error::Failure { operation, subject, cause } => {
                operation.format(formatter).?;
                formatter.writeText(&" ").?;
                subject.format(formatter).?;
                formatter.writeText(&": ").?;
                cause.format(formatter)
            },
            Error::Internal(operation) => {
                formatter.writeText(&"internal build failure during ").?;
                operation.format(formatter)
            },
            Error::StepCycle { step, dependency } => {
                formatter.writeText(&"step cycle between ").?;
                formatter.writeUnsigned(step as u128).?;
                formatter.writeText(&" and ").?;
                formatter.writeUnsigned(dependency as u128)
            },
            Error::StepFailed(step) => {
                formatter.writeText(&"previously failed step ").?;
                formatter.writeUnsigned(step as u128)
            },
            Error::MissingDefaultStep => formatter.writeText(&"build declares steps without a default"),
        }
    }
}

fn writeIndexedSubject(
    formatter: &mut fmt::Formatter,
    name: &[char],
    index: usize,
) fmt::Error!() {
    formatter.writeText(name).?;
    formatter.writeText(&"[").?;
    formatter.writeUnsigned(index as u128).?;
    formatter.writeText(&"]")
}

fn writeCausePrefix(formatter: &mut fmt::Formatter, domain: &[char]) fmt::Error!() {
    formatter.writeText(domain).?;
    formatter.writeText(&"/")
}

fn writeTermCause(formatter: &mut fmt::Formatter, cause: process::Term) fmt::Error!() {
    formatter.writeText(&"command/").?;
    formatter.writeText(match cause.kind() {
        .Exited => &"exit code ",
        .Signal => &"signal ",
        .Stopped => &"stopped by signal ",
        .Unknown => &"unknown status ",
    }).?;
    formatter.writeSigned(cause.code() as i128)
}

fn writeMemoryCause(formatter: &mut fmt::Formatter, cause: mem::Error) fmt::Error!() {
    match cause {
        .Invalid => formatter.writeText(&"invalid"),
        .InvalidAlignment => formatter.writeText(&"invalid alignment"),
        .OutOfMemory => formatter.writeText(&"out of memory"),
        .System => formatter.writeText(&"system"),
        _ => formatter.writeText(&"unknown"),
    }
}

fn writeFormatCause(formatter: &mut fmt::Formatter, cause: fmt::Error) fmt::Error!() {
    match cause {
        .Write => formatter.writeText(&"write"),
        .InvalidTemplate => formatter.writeText(&"invalid template"),
        .MissingArgument => formatter.writeText(&"missing argument"),
        .ExtraArgument => formatter.writeText(&"extra argument"),
        _ => formatter.writeText(&"unknown"),
    }
}

fn writeFileSystemCause(formatter: &mut fmt::Formatter, cause: fs::Error) fmt::Error!() {
    match cause {
        .PermissionDenied => formatter.writeText(&"permission denied"),
        .NotFound => formatter.writeText(&"not found"),
        .OutOfMemory => formatter.writeText(&"out of memory"),
        .AlreadyExists => formatter.writeText(&"already exists"),
        .NotDir => formatter.writeText(&"not a directory"),
        .IsDir => formatter.writeText(&"is a directory"),
        .Invalid => formatter.writeText(&"invalid"),
        .NoSpace => formatter.writeText(&"no space"),
        .TooLong => formatter.writeText(&"too long"),
        .Io => formatter.writeText(&"I/O"),
        _ => formatter.writeText(&"system"),
    }
}

fn writeFileSystemOperationCause(formatter: &mut fmt::Formatter, cause: fs::OperationError) fmt::Error!() {
    match cause {
        fs::OperationError::Path { operation, cause } => {
            writeFileSystemOperation(formatter, operation).?;
            formatter.writeText(&"/path/").?;
            writePathCause(formatter, cause)
        },
        fs::OperationError::System { operation, cause } => {
            writeFileSystemOperation(formatter, operation).?;
            formatter.writeText(&"/").?;
            writeFileSystemCause(formatter, cause)
        },
    }
}

fn writeFileSystemOperation(formatter: &mut fmt::Formatter, operation: fs::Operation) fmt::Error!() {
    formatter.writeText(match operation {
        fs::Operation::OpenFile => &"open file",
        fs::Operation::OpenDir => &"open directory",
        fs::Operation::CreateFile => &"create file",
        fs::Operation::CreateDir => &"create directory",
        fs::Operation::DeleteFile => &"delete file",
        fs::Operation::DeleteDir => &"delete directory",
        fs::Operation::Rename => &"rename",
        fs::Operation::Metadata => &"metadata",
    })
}

fn writeProcessCause(formatter: &mut fmt::Formatter, cause: process::Error) fmt::Error!() {
    match cause {
        process::Error::Allocation(cause) => {
            writeCausePrefix(formatter, &"allocation").?;
            writeMemoryCause(formatter, cause)
        },
        process::Error::Path(cause) => {
            writeCausePrefix(formatter, &"path").?;
            writePathCause(formatter, cause)
        },
        process::Error::ArgumentContainsNul(index) => {
            formatter.writeText(&"argument[").?;
            formatter.writeUnsigned(index as u128).?;
            formatter.writeText(&"]/contains NUL")
        },
        process::Error::Environment { index, cause } => {
            formatter.writeText(&"environment[").?;
            formatter.writeUnsigned(index as u128).?;
            formatter.writeText(&"]/").?;
            writeEnvEntryCause(formatter, cause)
        },
        process::Error::SpawnSetup(cause) => {
            writeCausePrefix(formatter, &"spawn setup").?;
            writeSystemCause(formatter, cause)
        },
        process::Error::Spawn(cause) => {
            writeCausePrefix(formatter, &"spawn").?;
            writeSpawnCause(formatter, cause)
        },
        process::Error::Wait(cause) => {
            writeCausePrefix(formatter, &"wait").?;
            writeSystemCause(formatter, cause)
        },
        process::Error::TryWait(cause) => {
            writeCausePrefix(formatter, &"try wait").?;
            writeSystemCause(formatter, cause)
        },
        process::Error::Kill(cause) => {
            writeCausePrefix(formatter, &"kill").?;
            writeSystemCause(formatter, cause)
        },
        process::Error::Close { stream, cause } => {
            writeCausePrefix(formatter, &"close").?;
            writeStdStream(formatter, stream).?;
            formatter.writeText(&"/").?;
            writeIoCause(formatter, cause)
        },
    }
}

fn writeEnvEntryCause(formatter: &mut fmt::Formatter, cause: process::EnvEntryError) fmt::Error!() {
    match cause {
        .EmptyName => formatter.writeText(&"empty name"),
        .NameContainsEquals => formatter.writeText(&"name contains '='"),
        .NameContainsNul => formatter.writeText(&"name contains NUL"),
        .ValueContainsNul => formatter.writeText(&"value contains NUL"),
        .DuplicateName(firstIndex) => {
            formatter.writeText(&"duplicates environment[").?;
            formatter.writeUnsigned(firstIndex as u128).?;
            formatter.writeText(&"]")
        },
    }
}

fn writePathCause(formatter: &mut fmt::Formatter, cause: fs::PathError) fmt::Error!() {
    match cause {
        .ContainsNul => formatter.writeText(&"contains NUL"),
        .Absolute => formatter.writeText(&"is absolute"),
        .ParentTraversal => formatter.writeText(&"contains parent traversal"),
        .MissingTerminator => formatter.writeText(&"missing terminator"),
        .TooLong => formatter.writeText(&"too long"),
        _ => formatter.writeText(&"unknown"),
    }
}

fn writeStdStream(formatter: &mut fmt::Formatter, stream: process::StdStream) fmt::Error!() {
    formatter.writeText(match stream {
        .Stdin => &"stdin",
        .Stdout => &"stdout",
        .Stderr => &"stderr",
    })
}

fn writeSystemCause(formatter: &mut fmt::Formatter, cause: process::SystemError) fmt::Error!() {
    formatter.writeText(match cause {
        .PermissionDenied => &"permission denied",
        .NotFound => &"not found",
        .Interrupted => &"interrupted",
        .Io => &"I/O",
        .BadFd => &"bad file descriptor",
        .NoChild => &"no child process",
        .Again => &"try again",
        .OutOfMemory => &"out of memory",
        .Access => &"access denied",
        .Fault => &"bad address",
        .Busy => &"busy",
        .AlreadyExists => &"already exists",
        .CrossDevice => &"cross device",
        .NotDir => &"not a directory",
        .IsDir => &"is a directory",
        .Invalid => &"invalid",
        .NoSpace => &"no space",
        .ReadOnly => &"read only",
        .BrokenPipe => &"broken pipe",
        .OutOfRange => &"out of range",
        .TooLong => &"too long",
        .NotEmpty => &"not empty",
        .System => &"system",
        _ => &"unknown",
    })
}

fn writeIoCause(formatter: &mut fmt::Formatter, cause: io::Error) fmt::Error!() {
    match cause {
        .EndOfStream => formatter.writeText(&"end of stream"),
        .ShortWrite => formatter.writeText(&"short write"),
        .Closed => formatter.writeText(&"closed"),
        .System(system) => formatter.writeText(match system {
            .PermissionDenied => &"permission denied",
            .NotFound => &"not found",
            .Interrupted => &"interrupted",
            .Io => &"I/O",
            .BadFd => &"bad file descriptor",
            .Again => &"try again",
            .OutOfMemory => &"out of memory",
            .Access => &"access denied",
            .Fault => &"bad address",
            .Busy => &"busy",
            .AlreadyExists => &"already exists",
            .CrossDevice => &"cross device",
            .NotDir => &"not a directory",
            .IsDir => &"is a directory",
            .Invalid => &"invalid",
            .NoSpace => &"no space",
            .ReadOnly => &"read only",
            .BrokenPipe => &"broken pipe",
            .OutOfRange => &"out of range",
            .TooLong => &"too long",
            .NotEmpty => &"not empty",
            .System => &"system",
            _ => &"unknown",
        }),
    }
}

fn writeSpawnCause(formatter: &mut fmt::Formatter, cause: process::SpawnError) fmt::Error!() {
    match cause {
        process::SpawnError::Setup(system) => {
            formatter.writeText(&"setup/").?;
            writeSystemCause(formatter, system)
        },
        process::SpawnError::Stdio(system) => {
            formatter.writeText(&"standard I/O/").?;
            writeSystemCause(formatter, system)
        },
        process::SpawnError::Cwd(system) => {
            formatter.writeText(&"working directory/").?;
            writeSystemCause(formatter, system)
        },
        process::SpawnError::Exec(system) => {
            formatter.writeText(&"executable/").?;
            writeSystemCause(formatter, system)
        },
        process::SpawnError::Reap { stage, primary, cause, pid } => {
            formatter.writeText(&"child reap pid ").?;
            formatter.writeSigned(pid.raw() as i128).?;
            formatter.writeText(&" after ").?;
            formatter.writeText(match stage {
                .Setup => &"setup",
                .Stdio => &"standard I/O",
                .Cwd => &"working directory",
                .Exec => &"executable",
                _ => &"unknown stage",
            }).?;
            formatter.writeText(&"/").?;
            writeSystemCause(formatter, primary).?;
            formatter.writeText(&": ").?;
            writeSystemCause(formatter, cause)
        },
    }
}
