// Build diagnostics output.
//
// Reporting is separate from Build state, so graph declaration and validation
// can remain independent of output streams.

using root::io;
using root::fmt;
using root::fmt::template;  // For .print() extension method
using root::build::error;

using error::Error;
using error::ErrorOperation as Operation;
using error::ErrorSubject as Subject;

pub(root) fun reportBuildError(error: Error) Error!() {
    let mut buffer: [u8; 1024] = [0; 1024];
    let mut stderr = io::FileWriter::stderr(buffer);
    stderr.print(
        &"build error: {}\n",
        &[error],
    ).withBuildContext(Operation::Report, Subject::Diagnostic).?;
    stderr.flush().withBuildContext(Operation::Report, Subject::Diagnostic)
}

pub(root) fun reportUnknownBuildStep(step: &[char]) Error!() {
    let mut buffer: [u8; 256] = [0; 256];
    let mut stderr = io::FileWriter::stderr(buffer);
    stderr.print(
        &"unknown build step `{}`\n",
        &[step],
    ).withBuildContext(Operation::Report, Subject::RequestedStep).?;
    stderr.flush().withBuildContext(Operation::Report, Subject::RequestedStep)
}
