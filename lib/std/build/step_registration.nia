// Build step declarations, producer edges, and dependency rollback.
//
// Payload ownership is implemented in steps.nia; this provider coordinates
// validated Build handles, retained step records, and their graph edges.

using root::build::artifacts;
using root::build::commands::{validateExternalCommand, validateRunArguments};
using root::build::error;
using root::build::queries::{
    findEmitObjectStep as findEmitObjectStepRecord,
    findEmitStaticArchiveStep as findEmitStaticArchiveStepRecord,
    findEmitStep as findEmitStepRecord,
    findStep as findStepRecord,
};
using root::build::paths::isValidBuildPath;
using root::build::steps;
using root::string;
using root::build::targets::isValidStableName;
using root::build::types;
using root::build::validation::{
    validateExecutableHandle as validateExecutableHandleValue,
    validateObjectHandle as validateObjectHandleValue,
    validatePackageHandle as validatePackageHandleValue,
    validateRunnableTarget,
    validateStaticArchiveHandle as validateStaticArchiveHandleValue,
    validateStepHandle as validateStepHandleValue,
};

using error::Error;
using error::ErrorOperation as Operation;
using error::ErrorSubject as Subject;
using types::{
    Build,
    BuildPathView,
    CommandArgument,
    CommandArgumentKind,
    ExecutableHandle,
    ExecutableOptions,
    ExternalCommandOptions,
    ObjectHandle,
    RunOptions,
    StepHandle,
    StepKind,
    StepPayload,
    StaticArchiveHandle,
    UncacheableStep,
    ModuleHandle,
};

extend Build {
    pub fun addAggregateStep(&mut self, name: &[char]) Error!StepHandle {
        self.addStepRecord(name, .Aggregate, .{ aggregate: .init() })
    }

    pub fun addUncacheableStep(&mut self, name: &[char], description: &[char]) Error!StepHandle {
        self.preparePendingStep(name, .Uncacheable).?;
        if self.pendingStep.initializeUncacheable(self.allocator, name, description) is primary! {
            _ = self.cleanupPendingStep();
            return primary!;
        }
        self.commitPendingStep()
    }

    pub fun addGeneratedFileStep(&mut self, name: &[char], output: BuildPathView, contents: &[u8]) Error!StepHandle {
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        if not output.isValid() or contents.len() > 67108864 {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(handle.index()),
            }!;
        }
        self.preparePendingStep(name, .GeneratedFile).?;
        if self.pendingStep.initializeGeneratedFile(
            self.allocator,
            name,
            output,
            contents,
        ) is primary! {
            _ = self.cleanupPendingStep();
            return primary!;
        }
        self.commitPendingStep()
    }

    pub fun addCheckExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        validateExecutableHandleValue(self.ownerId, self.executables.len(), target).?;
        self.addStepRecord(name, .CheckExecutable, .{ executable: .init(target) })
    }

    pub fun addEmitExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        validateExecutableHandleValue(self.ownerId, self.executables.len(), target).?;
        let archiveCount = self.executables.asSlice()[target.index()].staticArchives.len();
        self.dependencies.reserve(
            self.allocator,
            archiveCount,
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        let mut archiveIndex: usize = 0;
        while archiveIndex < archiveCount {
            let archive = self.executables.asSlice()[target.index()]
                .staticArchives.asSlice()[archiveIndex];
            if findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), archive) is null {
                return .Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(self.steps.len()),
                }!;
            }
            archiveIndex += 1;
        }
        let result = self.addStepRecord(
            name,
            .EmitExecutable,
            .{ executable: .init(target) },
        ).?;
        let dependencyStart = self.dependencies.len();
        if self.addExecutableArchiveDependencies(result, target) is primary! {
            while self.dependencies.len() > dependencyStart {
                _ = self.dependencies.pop();
            }
            _ = self.rollbackLastStep();
            return primary!;
        }
        !result
    }

    fun addExecutableArchiveDependencies(
        &mut self,
        step: StepHandle,
        target: ExecutableHandle,
    ) Error!() {
        let archives = self.executables.asSlice()[target.index()].staticArchives.asSlice();
        for &archive in archives.iter() {
            let producer = if findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), archive) is ?producer {
                producer
            } else {
                return .Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(step.index()),
                }!;
            };
            self.dependOn(step, producer).?;
        }
        !()
    }

    pub fun addEmitObjectStep(&mut self, name: &[char], target: ObjectHandle) Error!StepHandle {
        validateObjectHandleValue(self.ownerId, self.objects.len(), target).?;
        self.addStepRecord(name, .EmitObject, .{ object: .init(target) })
    }

    pub fun addEmitStaticArchiveStep(&mut self, name: &[char], target: StaticArchiveHandle) Error!StepHandle {
        validateStaticArchiveHandleValue(self.ownerId, self.staticArchives.len(), target).?;
        self.addStepRecord(name, .EmitStaticArchive, .{ staticArchive: .init(target) })
    }

    pub fun addRunExecutableStep(&mut self, name: &[char], options: RunOptions) Error!StepHandle {
        validateExecutableHandleValue(self.ownerId, self.executables.len(), options.target).?;
        let producer = if findEmitStepRecord(self.ownerId, self.steps.asSlice(), options.target) is ?producer {
            producer
        } else {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        };
        validateRunnableTarget(
            self.executables.asSlice()[options.target.index()].targetIndex,
            self.hostTarget,
            self.steps.len(),
        ).?;
        validateRunArguments(options.arguments, self.steps.len()).?;
        self.addRunStepRecord(name, options, .RunExecutable, producer)
    }

    pub fun addTestExecutableStep(&mut self, name: &[char], options: RunOptions) Error!StepHandle {
        validateExecutableHandleValue(self.ownerId, self.executables.len(), options.target).?;
        let producer = if findEmitStepRecord(self.ownerId, self.steps.asSlice(), options.target) is ?producer {
            producer
        } else {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        };
        validateRunnableTarget(
            self.executables.asSlice()[options.target.index()].targetIndex,
            self.hostTarget,
            self.steps.len(),
        ).?;
        validateRunArguments(options.arguments, self.steps.len()).?;
        self.addRunStepRecord(name, options, .TestExecutable, producer)
    }

    // A suite is one host executable whose root module may import any number of
    // test modules. The executable and test action are registered together;
    // source organization remains an ordinary Nia module concern. The suite's
    // step has the suite's name, and the `test` step depends on every suite;
    // the first suite declares it, so a script cannot declare its own `test`.
    pub fun addTestSuite(&mut self, name: &[char], rootModule: ModuleHandle) Error!StepHandle {
        self.addTestSuiteWithRuntime(name, rootModule, .Freestanding)
    }

    pub(root) fun addTestSuiteWithRuntime(
        &mut self,
        name: &[char],
        rootModule: ModuleHandle,
        runtime: types::Runtime,
    ) Error!StepHandle {
        let mut compileName = string::String::fromSlice(self.allocator, name)
            .withBuildContext(Operation::Retain, Subject::Step(self.steps.len())).?;
        let result = self.addOwnedTestSuite(name, rootModule, runtime, &mut compileName);
        let cleanup = compileName.deinit(self.allocator)
            .withBuildContext(Operation::Release, Subject::Step(self.steps.len()));
        result.cleanupAfter(cleanup)
    }

    fun addOwnedTestSuite(
        &mut self,
        name: &[char],
        rootModule: ModuleHandle,
        runtime: types::Runtime,
        compileName: &mut string::String,
    ) Error!StepHandle {
        compileName.append(self.allocator, ".compile")
            .withBuildContext(Operation::Retain, Subject::Step(self.steps.len())).?;
        let executable = self.addExecutable(
            ExecutableOptions::init(name, rootModule).forTarget(self.hostTarget()).withRuntime(runtime),
        ).?;
        self.executables.asMutSlice()[executable.index()].test = true;
        _ = self.addEmitExecutableStep(compileName.text(), executable).?;
        let suite = self.addTestExecutableStep(name, .init(executable)).?;
        let all = if self.testStep is ?step {
            step
        } else {
            let step = self.addAggregateStep("test").?;
            self.testStep = ?step;
            step
        };
        self.dependOn(all, suite).?;
        !suite
    }

    fun addRunStepRecord(
        &mut self,
        name: &[char],
        options: RunOptions,
        kind: StepKind,
        producer: StepHandle,
    ) Error!StepHandle {
        self.preparePendingRunStep(name, kind, options.target).?;
        if self.pendingStep.initializeRunExecutable(
            self.allocator,
            name,
            options.arguments,
        ) is primary! {
            _ = self.cleanupPendingStep();
            return primary!;
        }
        let result = self.commitPendingStep().?;
        self.finishStepDependency(result, producer)
    }

    pub fun addInstallExecutableStep(
        &mut self,
        name: &[char],
        target: ExecutableHandle,
        destination: BuildPathView,
    ) Error!StepHandle {
        validateExecutableHandleValue(self.ownerId, self.executables.len(), target).?;
        if not destination.isValid() {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        let producer = if findEmitStepRecord(self.ownerId, self.steps.asSlice(), target) is ?producer {
            producer
        } else {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        };
        self.prepareInstallExecutableStep(name, target).?;
        if self.pendingStep.initializeInstallExecutable(
            self.allocator,
            name,
            destination,
        ) is primary! {
            _ = self.cleanupPendingStep();
            return primary!;
        }
        let result = self.commitPendingStep().?;
        self.finishStepDependency(result, producer)
    }

    pub fun addInstallStaticArchiveStep(
        &mut self,
        name: &[char],
        target: StaticArchiveHandle,
        destination: BuildPathView,
    ) Error!StepHandle {
        validateStaticArchiveHandleValue(self.ownerId, self.staticArchives.len(), target).?;
        if not destination.isValid() {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        let producer = if findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), target) is ?producer {
            producer
        } else {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        };
        self.prepareInstallStaticArchiveStep(name, target).?;
        if self.pendingStep.initializeInstallStaticArchive(
            self.allocator,
            name,
            destination,
        ) is primary! {
            _ = self.cleanupPendingStep();
            return primary!;
        }
        let result = self.commitPendingStep().?;
        self.finishStepDependency(result, producer)
    }

    pub fun addExternalCommandStep(&mut self, name: &[char], options: ExternalCommandOptions) Error!StepHandle {
        validateExternalCommand(options, self.steps.len()).?;
        let mut artifactInputCount: usize = 0;
        if options.arguments is ?arguments {
            for &argument in arguments.iter() {
                if argument.kind is (.ArtifactInput) {
                    let target = argument.payload.artifact;
                    validateExecutableHandleValue(self.ownerId, self.executables.len(), target).?;
                    if findEmitStepRecord(self.ownerId, self.steps.asSlice(), target) is null {
                        return .Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Step(self.steps.len()),
                        }!;
                    }
                    artifactInputCount += 1;
                } else if argument.kind is (.ObjectInput) {
                    let target = argument.payload.object;
                    validateObjectHandleValue(self.ownerId, self.objects.len(), target).?;
                    if findEmitObjectStepRecord(self.ownerId, self.steps.asSlice(), target) is null {
                        return .Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Step(self.steps.len()),
                        }!;
                    }
                    artifactInputCount += 1;
                } else if argument.kind is (.StaticArchiveInput) {
                    let target = argument.payload.staticArchive;
                    validateStaticArchiveHandleValue(self.ownerId, self.staticArchives.len(), target).?;
                    if findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), target) is null {
                        return .Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Step(self.steps.len()),
                        }!;
                    }
                    artifactInputCount += 1;
                } else if argument.kind is (.PackageInput) {
                    validatePackageHandleValue(self.ownerId, self.packages.len(), argument.package).?;
                }
            }
        }
        if options.stdin is ?stdin {
            if stdin.kind is (.ArtifactInput) {
                validateExecutableHandleValue(self.ownerId, self.executables.len(), stdin.payload.artifact).?;
                if findEmitStepRecord(self.ownerId, self.steps.asSlice(), stdin.payload.artifact) is null {
                    return .Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Step(self.steps.len()),
                    }!;
                }
                artifactInputCount += 1;
            } else if stdin.kind is (.ObjectInput) {
                validateObjectHandleValue(self.ownerId, self.objects.len(), stdin.payload.object).?;
                if findEmitObjectStepRecord(self.ownerId, self.steps.asSlice(), stdin.payload.object) is null {
                    return .Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Step(self.steps.len()),
                    }!;
                }
                artifactInputCount += 1;
            } else if stdin.kind is (.StaticArchiveInput) {
                validateStaticArchiveHandleValue(self.ownerId, self.staticArchives.len(), stdin.payload.staticArchive).?;
                if findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), stdin.payload.staticArchive) is null {
                    return .Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Step(self.steps.len()),
                    }!;
                }
                artifactInputCount += 1;
            } else if stdin.kind is (.PackageInput) {
                validatePackageHandleValue(self.ownerId, self.packages.len(), stdin.package).?;
            }
        }
        self.dependencies.reserve(
            self.allocator,
            artifactInputCount,
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        self.prepareExternalCommandStep(name, options).?;
        if self.pendingStep.initializeExternalCommand(self.allocator, name, options) is primary! {
            _ = self.cleanupPendingStep();
            return primary!;
        }
        let result = self.commitPendingStep().?;
        let dependencyStart = self.dependencies.len();
        if self.addExternalCommandDependencies(result, options.arguments, options.stdin) is primary! {
            while self.dependencies.len() > dependencyStart {
                _ = self.dependencies.pop();
            }
            _ = self.rollbackLastStep();
            return primary!;
        }
        !result
    }

    fun addExternalCommandDependencies(
        &mut self,
        step: StepHandle,
        arguments: ?&[CommandArgument],
        stdin: ?CommandArgument,
    ) Error!() {
        if arguments is ?arguments {
            for &argument in arguments.iter() {
                if argument.kind is (.ArtifactInput) {
                    let producer = if findEmitStepRecord(self.ownerId, self.steps.asSlice(), argument.payload.artifact) is ?producer {
                        producer
                    } else {
                        return .Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Step(step.index()),
                        }!;
                    };
                    self.dependOn(step, producer).?;
                } else if argument.kind is (.ObjectInput) {
                    let producer = if findEmitObjectStepRecord(self.ownerId, self.steps.asSlice(), argument.payload.object) is ?producer {
                        producer
                    } else {
                        return .Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Step(step.index()),
                        }!;
                    };
                    self.dependOn(step, producer).?;
                } else if argument.kind is (.StaticArchiveInput) {
                    let producer = if findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), argument.payload.staticArchive) is ?producer {
                        producer
                    } else {
                        return .Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Step(step.index()),
                        }!;
                    };
                    self.dependOn(step, producer).?;
                }
            }
        }
        if stdin is ?stdin {
            if stdin.kind is (.ArtifactInput) {
                let producer = if findEmitStepRecord(self.ownerId, self.steps.asSlice(), stdin.payload.artifact) is ?producer {
                    producer
                } else {
                    return .Invalid { operation: Operation::Validate, subject: Subject::Step(step.index()) }!;
                };
                self.dependOn(step, producer).?;
            } else if stdin.kind is (.ObjectInput) {
                let producer = if findEmitObjectStepRecord(self.ownerId, self.steps.asSlice(), stdin.payload.object) is ?producer {
                    producer
                } else {
                    return .Invalid { operation: Operation::Validate, subject: Subject::Step(step.index()) }!;
                };
                self.dependOn(step, producer).?;
            } else if stdin.kind is (.StaticArchiveInput) {
                let producer = if findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), stdin.payload.staticArchive) is ?producer {
                    producer
                } else {
                    return .Invalid { operation: Operation::Validate, subject: Subject::Step(step.index()) }!;
                };
                self.dependOn(step, producer).?;
            }
        }
        !()
    }

    pub fun dependOn(&mut self, step: StepHandle, dependency: StepHandle) Error!() {
        validateStepHandleValue(self.ownerId, self.steps.len(), step).?;
        validateStepHandleValue(self.ownerId, self.steps.len(), dependency).?;
        if step.index() == dependency.index() {
            return .StepCycle {
                step: step.index(),
                dependency: dependency.index(),
            }!;
        }
        for &edge in self.dependencies.iter() {
            if edge.step.index() == step.index() and edge.dependency.index() == dependency.index() {
                return !();
            }
        }
        self.dependencies.push(
            self.allocator,
            .init(step, dependency),
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        self.planValidated = false;
        !()
    }

    pub fun setDefaultStep(&mut self, step: StepHandle) Error!() {
        validateStepHandleValue(self.ownerId, self.steps.len(), step).?;
        self.defaultStep = ?step;
        self.planValidated = false;
        !()
    }

    fun rollbackLastStep(&mut self) Error!() {
        match self.steps.pop() {
            ?step => {
                self.pendingStep = step;
                self.hasPendingStep = true;
                self.cleanupPendingStep()
            },
            null => .Invalid {
                operation: Operation::Release,
                subject: Subject::Steps,
            }!,
        }
    }

    fun addStepRecord(&mut self, name: &[char], kind: StepKind, payload: StepPayload) Error!StepHandle {
        self.prepareStepSlot(name).?;
        self.pendingStep = .initSimple(self.steps.len(), kind, payload);
        self.hasPendingStep = true;
        match self.pendingStep.initializeName(self.allocator, name) {
            !ok => _ = ok,
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        self.commitPendingStep()
    }

    fun preparePendingStep(&mut self, name: &[char], kind: StepKind) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = if kind is (.GeneratedFile) {
            .initGeneratedFile(self.steps.len())
        } else {
            .initUncacheable(self.steps.len())
        };
        self.hasPendingStep = true;
        !()
    }

    fun preparePendingRunStep(
        &mut self,
        name: &[char],
        kind: StepKind,
        target: ExecutableHandle,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = .initRunExecutable(self.steps.len(), kind, target);
        self.hasPendingStep = true;
        !()
    }

    fun prepareInstallExecutableStep(
        &mut self,
        name: &[char],
        target: ExecutableHandle,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = .initInstallExecutable(self.steps.len(), target);
        self.hasPendingStep = true;
        !()
    }

    fun prepareInstallStaticArchiveStep(
        &mut self,
        name: &[char],
        target: StaticArchiveHandle,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = .initInstallStaticArchive(self.steps.len(), target);
        self.hasPendingStep = true;
        !()
    }

    fun prepareExternalCommandStep(
        &mut self,
        name: &[char],
        options: ExternalCommandOptions,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = .initExternalCommand(self.steps.len(), options);
        self.hasPendingStep = true;
        !()
    }

    fun prepareStepSlot(&mut self, name: &[char]) Error!() {
        self.cleanupPendingStep().?;
        if not isValidStableName(name) {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        if findStepRecord(self.steps.asSlice(), name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Step(self.steps.len()),
            }!;
        }
        self.steps.reserve(self.allocator, 1).withBuildContext(Operation::Retain, Subject::Steps).?;
        !()
    }

    fun commitPendingStep(&mut self) Error!StepHandle {
        if not self.hasPendingStep {
            return .Internal(.Initialize)!;
        }
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        self.steps.appendAssumeCapacity(self.pendingStep);
        self.hasPendingStep = false;
        self.planValidated = false;
        !handle
    }

    fun finishStepDependency(
        &mut self,
        step: StepHandle,
        dependency: StepHandle,
    ) Error!StepHandle {
        if self.dependOn(step, dependency) is primary! {
            _ = self.rollbackLastStep();
            return primary!;
        }
        !step
    }

    pub(root) fun cleanupPendingStep(&mut self) Error!() {
        if not self.hasPendingStep {
            return !();
        }
        self.pendingStep.deinit(self.allocator).?;
        self.hasPendingStep = false;
        !()
    }
}
