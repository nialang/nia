// Package and module descriptors retained by a build graph.
//
// Borrowed options are copied into owned package/module records. Generated
// module roots stay build-relative and every import owns its name and path.
//
// Module imports are module-level declarations. `Build::addTestSuite` uses the
// same import model as an ordinary executable; there is no separate test
// import namespace. When an application root and a test root both use a
// package, the same `ModuleImport` descriptors may be reused in both
// `ModuleOptions`, while each root still declares its own visibility.

using root::fs;
using root::mem;
using root::string;
using root::error::CleanupAccumulator;
using root::build::error;
using root::build::paths::isValidBuildPath;
using root::build::types;

using error::Error;
using types::{
    BuildPathView,
    Module,
    ModuleImport,
    ModuleOptions,
    ModuleSourceRoot,
    OptimizationMode,
    OwnedModuleImport,
    Package,
    PackageHandle,
    PackageOptions,
};

extend ModuleOptions {
    pub fun init(name: &[char], rootSource: fs::PathView) ModuleOptions {
        .{
            name,
            sourceRoot: .Package,
            package: null,
            rootSource,
            optimization: null,
            imports: null,
        }
    }

    pub fun fromPackage(
        name: &[char],
        package: PackageHandle,
        rootSource: fs::PathView,
    ) ModuleOptions {
        .{
            name,
            sourceRoot: .Package,
            package: ?package,
            rootSource,
            optimization: null,
            imports: null,
        }
    }

    pub fun fromBuild(name: &[char], rootSource: BuildPathView) ModuleOptions {
        .{
            name,
            sourceRoot: .Build,
            package: null,
            rootSource: .init(rootSource.text()),
            optimization: null,
            imports: null,
        }
    }

    pub fun withOptimization(self, optimization: OptimizationMode) ModuleOptions {
        .{
            name: self.name,
            sourceRoot: self.sourceRoot,
            package: self.package,
            rootSource: self.rootSource,
            optimization: ?optimization,
            imports: self.imports,
        }
    }

    pub fun withImports(self, imports: &[ModuleImport]) ModuleOptions {
        .{
            name: self.name,
            sourceRoot: self.sourceRoot,
            package: self.package,
            rootSource: self.rootSource,
            optimization: self.optimization,
            imports: ?imports,
        }
    }
}

extend PackageOptions {
    pub fun init(name: &[char], path: fs::PathView) PackageOptions {
        .{ name, path, manifestDependency: false }
    }

    pub(root) fun dependency(name: &[char]) PackageOptions {
        .{ name, path: fs::PathView::init(""), manifestDependency: true }
    }
}

extend Package {
    pub(root) fun init(index: usize) Package {
        .{ index, name: .init(), path: .init(), manifestDependency: false }
    }

    pub(root) fun initialize(&mut self, allocator: &mut mem::Allocator, options: PackageOptions) Error!() {
        self.name = string::String::fromSlice(allocator, options.name).withBuildContext(.Retain, .Package(self.index)).?;
        self.path = fs::Path::fromView(allocator, options.path).withBuildContext(.Retain, .Package(self.index)).?;
        self.manifestDependency = options.manifestDependency;
        !()
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.path.deinit(allocator).withBuildContext(.Release, .Package(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Package(self.index)));
        cleanup.finish()
    }
}

extend Module {
    pub(root) fun init(
        index: usize,
        sourceRoot: ModuleSourceRoot,
        package: PackageHandle,
        optimization: OptimizationMode,
    ) Module {
        .{ index, name: .init(), sourceRoot, package, rootSource: .init(), optimization, imports: .init() }
    }

    pub(root) fun initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        rootSource: fs::PathView,
        imports: ?&[ModuleImport],
        ownerId: usize,
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Module(self.index)).?;
        self.rootSource = fs::Path::fromView(allocator, rootSource).withBuildContext(.Retain, .Module(self.index)).?;
        let items = if imports is ?values { values } else { &[] };
        self.imports.reserve(allocator, items.len()).withBuildContext(.Retain, .Modules).?;
        let mut index: usize = 0;
        for &import in items.iter() {
            self.imports.appendAssumeCapacity(.init(import, index, ownerId));
            self.imports.asMutSlice()[index].initialize(allocator, import).?;
            index += 1;
        }
        !()
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        let mut elements: CleanupAccumulator[Error] = .init();
        let mut index = self.imports.len();
        while index != 0 {
            index -= 1;
            elements.attempt(self.imports.asMutSlice()[index].deinit(allocator));
        }
        if elements.isClean() {
            cleanup.attempt(self.imports.deinit(allocator).withBuildContext(.Release, .Module(self.index)));
        } else {
            cleanup.attempt(elements.finish());
        }
        cleanup.attempt(self.rootSource.deinit(allocator).withBuildContext(.Release, .Module(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Module(self.index)));
        cleanup.finish()
    }
}

extend ModuleImport {
    pub fun init(name: &[char], path: fs::PathView) ModuleImport {
        .{
            name,
            sourceRoot: .Package,
            package: null,
            path,
        }
    }

    pub fun fromPackage(
        name: &[char],
        package: PackageHandle,
        path: fs::PathView,
    ) ModuleImport {
        .{
            name,
            sourceRoot: .Package,
            package: ?package,
            path,
        }
    }

    pub fun fromBuild(name: &[char], path: BuildPathView) ModuleImport {
        .{
            name,
            sourceRoot: .Build,
            package: null,
            path: .init(path.text()),
        }
    }
}

extend OwnedModuleImport {
    pub(root) fun init(
        import: ModuleImport,
        index: usize,
        ownerId: usize,
    ) OwnedModuleImport {
        .{
            index,
            name: .init(),
            sourceRoot: import.sourceRoot,
            package: if import.package is ?package { package } else { .init(ownerId, 0) },
            path: .init(),
        }
    }

    pub(root) fun initialize(&mut self, allocator: &mut mem::Allocator, import: ModuleImport) Error!() {
        self.name = string::String::fromSlice(allocator, import.name).withBuildContext(.Retain, .ModuleImport(self.index)).?;
        self.path = fs::Path::fromView(allocator, import.path).withBuildContext(.Retain, .ModuleImport(self.index)).?;
        !()
    }

    pub(root) fun deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.path.deinit(allocator).withBuildContext(.Release, .ModuleImport(self.index)));
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .ModuleImport(self.index)));
        cleanup.finish()
    }
}

pub(root) fun validateModuleImports(imports: ?&[ModuleImport]) Error!() {
    if imports is ?items {
        let mut index: usize = 0;
        for &import in items.iter() {
            if not isValidModuleImportName(import.name) {
                return .Invalid {
                    operation: .Validate,
                    subject: .ModuleImport(index),
                }!;
            }
            if import.sourceRoot == ModuleSourceRoot::Build
                and not isValidBuildPath(import.path.text())
            {
                return .Invalid {
                    operation: .Validate,
                    subject: .ModuleImport(index),
                }!;
            }
            let mut oldIndex: usize = 0;
            while oldIndex < index {
                if items[oldIndex].name.equals(import.name) {
                    return .Invalid {
                        operation: .Validate,
                        subject: .ModuleImport(index),
                    }!;
                }
                oldIndex += 1;
            }
            index += 1;
        }
    }
    !()
}

fun isValidModuleImportName(name: &[char]) bool {
    if name.len() == 0 {
        return false;
    }
    if name.equals("entry") or name.equals("root") {
        return false;
    }
    for &ch in name.iter() {
        let code = ch as u32;
        let valid = (code >= 48 and code <= 57)
            or (code >= 65 and code <= 90)
            or (code >= 97 and code <= 122)
            or code == 95
            or code == 45;
        if not valid {
            return false;
        }
    }
    true
}
