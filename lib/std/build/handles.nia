    pub(root) fun ownerId(&self) usize { self.ownerId }
    pub(root) fun index(&self) usize { self.index }
}

extend StaticArchiveHandle {
    pub(root) fun init(ownerId: usize, index: usize) StaticArchiveHandle {
        .{ ownerId, index }
    }

    pub(root) fun ownerId(&self) usize { self.ownerId }
    pub(root) fun index(&self) usize { self.index }
}

extend ModuleHandle {
    pub(root) fun init(ownerId: usize, index: usize) ModuleHandle {
        .{ ownerId, index }
