    pub(pkg) fn init(ownerId: usize, index: usize) ObjectHandle {
        .{ ownerId, index }
    }

    pub(pkg) fn ownerId(&self) usize { self.ownerId }
    pub(pkg) fn index(&self) usize { self.index }
}

extend StaticArchiveHandle {
    pub(pkg) fn init(ownerId: usize, index: usize) StaticArchiveHandle {
        .{ ownerId, index }
    }

    pub(pkg) fn ownerId(&self) usize { self.ownerId }
    pub(pkg) fn index(&self) usize { self.index }
}

extend ModuleHandle {
    pub(pkg) fn init(ownerId: usize, index: usize) ModuleHandle {
        .{ ownerId, index }
    }

    pub(pkg) fn ownerId(&self) usize { self.ownerId }
