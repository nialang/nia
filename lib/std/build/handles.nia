    pub(pkg) fn init(ownerId: usize, index: usize) PackageHandle {
        .{ ownerId, index }
    }

    pub(pkg) fn ownerId(&self) usize { self.ownerId }
    pub(pkg) fn index(&self) usize { self.index }
}

extend StepDependency {
    pub fn init(step: StepHandle, dependency: StepHandle) StepDependency {
        .{ step, dependency }
    }
}
