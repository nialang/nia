// Build-local capabilities and initialization handoff.
//
// Handles pair a dense index with the owning Build identity. They identify live
// graph entries; serialized plans use the retained records instead.

using root::build::error;
using root::build::types;

using error::Error;
using types::{
    Build,
    BuildInitAttempt,
    ExecutableHandle,
    ModuleHandle,
    ObjectHandle,
    PackageHandle,
    StaticArchiveHandle,
    StepDependency,
    StepHandle,
};

extend BuildInitAttempt {
    pub(root) fun init(build: Build) BuildInitAttempt {
        .{ build, primary: null, active: true }
    }

    pub fun finish(&mut self) Error!Build {
        if not self.active {
            return .Internal(.Initialize)!;
        }
        if self.primary is ?primary {
            if self.build.deinit() is cleanup! {
                return cleanup!;
            }
            self.active = false;
            primary!
        } else {
            self.active = false;
            !self.build
        }
    }
}

extend StepHandle {
    pub(root) fun init(ownerId: usize, index: usize) StepHandle {
        .{ ownerId, index }
    }

    pub(root) fun ownerId(&self) usize { self.ownerId }
    pub(root) fun index(&self) usize { self.index }
}

extend ExecutableHandle {
    pub(root) fun init(ownerId: usize, index: usize) ExecutableHandle {
        .{ ownerId, index }
    }

    pub(root) fun ownerId(&self) usize { self.ownerId }
    pub(root) fun index(&self) usize { self.index }
}

