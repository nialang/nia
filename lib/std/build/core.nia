        self.validateRunnableExecutable(options.target, self.steps.len()).?;
        validateRunArguments(options.arguments, self.steps.len()).?;
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut payload = RunExecutableStep::init(self.allocator, options, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(name, StepKind::TestExecutable, StepPayload { runExecutable: payload }).?;
        transferred = true;
        let mut committed = false;
        defer if not committed {
            self.rollbackLastStep().?;
        };
        self.dependOn(result, producer).?;
        committed = true;
        !result
    }

    pub fn addInstallExecutableStep(
        &mut self,
        name: &[char],
        target: ExecutableHandle,
        destination: BuildPathView,
    ) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        if not destination.isValid() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        let producer = match self.findEmitStep(target) {
            ?producer => producer,
            null => return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!,
        };
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut payload = InstallExecutableStep::init(
            self.allocator,
            target,
            destination,
            handle.index(),
        ).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(
            name,
            StepKind::InstallExecutable,
            StepPayload { installExecutable: payload },
        ).?;
        transferred = true;
        let mut committed = false;
        defer if not committed {
            self.rollbackLastStep().?;
        };
        self.dependOn(result, producer).?;
        committed = true;
        !result
    }

