extend Step {
    fn init(
        allocator: &mut mem::Allocator,
        name: string::StringView,
        kind: StepKind,
        payload: StepPayload,
        index: usize,
    ) Error!Step {
        let ownedName = string::StringBuf::from_slice(allocator, name.text()).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !{
            index: index,
            name: ownedName,
            kind: kind,
            payload: payload,
            state: StepState::Pending,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(self.index))
    }
}

extend ModuleOptions {
    pub fn init(name: &[char], rootSource: fs::PathView) ModuleOptions {
        {
            name: string::StringView::init(name),
            rootSource: rootSource,
            optimization: OptimizationMode::O2,
            imports: null,
        }
    }

    pub fn withOptimization(self, optimization: OptimizationMode) ModuleOptions {
        {
            name: self.name,
            rootSource: self.rootSource,
            optimization: optimization,
            imports: self.imports,
        }
    }

    pub fn withImports(self, imports: &[ModuleImport]) ModuleOptions {
