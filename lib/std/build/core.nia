extend TargetView {
    pub fn init(
        arch: string::StringView,
        vendor: string::StringView,
        os: string::StringView,
        env: string::StringView,
        abi: string::StringView,
        endian: string::StringView,
        pointerWidth: u32,
    ) TargetView {
        {
            arch: arch,
            vendor: vendor,
            os: os,
            env: env,
            abi: abi,
            endian: endian,
            pointerWidth: pointerWidth,
        }
    }

    pub fn arch(&self) string::StringView {
        self.arch
    }

    pub fn vendor(&self) string::StringView {
        self.vendor
    }

    pub fn os(&self) string::StringView {
        self.os
    }

    pub fn env(&self) string::StringView {
        self.env
    }

    pub fn abi(&self) string::StringView {
        self.abi
    }

    pub fn endian(&self) string::StringView {
        self.endian
    }

    pub fn pointerWidth(&self) u32 {
        self.pointerWidth
    }

    pub fn equals(&self, other: TargetView) bool {
        mem::equal[char](self.arch.text(), other.arch.text())
            and mem::equal[char](self.vendor.text(), other.vendor.text())
            and mem::equal[char](self.os.text(), other.os.text())
            and mem::equal[char](self.env.text(), other.env.text())
            and mem::equal[char](self.abi.text(), other.abi.text())
            and mem::equal[char](self.endian.text(), other.endian.text())
            and self.pointerWidth == other.pointerWidth
    }
}

extend TargetStorage {
    fn init(
        allocator: &mut mem::Allocator,
        target: TargetView,
        subject: Subject,
    ) Error!TargetStorage {
        let mut owned: TargetStorage = {
            arch: string::StringBuf::init(),
            vendor: string::StringBuf::init(),
            os: string::StringBuf::init(),
            env: string::StringBuf::init(),
            abi: string::StringBuf::init(),
            endian: string::StringBuf::init(),
            pointerWidth: target.pointerWidth,
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator, subject).?;
        };
        owned.arch = string::StringBuf::from_slice(allocator, target.arch.text()).asBuildError(Operation::Retain, subject).?;
        owned.vendor = string::StringBuf::from_slice(allocator, target.vendor.text()).asBuildError(Operation::Retain, subject).?;
        owned.os = string::StringBuf::from_slice(allocator, target.os.text()).asBuildError(Operation::Retain, subject).?;
        owned.env = string::StringBuf::from_slice(allocator, target.env.text()).asBuildError(Operation::Retain, subject).?;
        owned.abi = string::StringBuf::from_slice(allocator, target.abi.text()).asBuildError(Operation::Retain, subject).?;
        owned.endian = string::StringBuf::from_slice(allocator, target.endian.text()).asBuildError(Operation::Retain, subject).?;
        transferred = true;
        !owned
    }

    fn view(&self) TargetView {
        TargetView::init(
            self.arch.view(),
            self.vendor.view(),
            self.os.view(),
            self.env.view(),
            self.abi.view(),
            self.endian.view(),
            self.pointerWidth,
        )
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, subject: Subject) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.endian.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.abi.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.env.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.os.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.vendor.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.arch.deinit(allocator).asBuildError(Operation::Release, subject));
        cleanupResult(firstError)
    }
}

