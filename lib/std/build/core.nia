        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut payload = InstallStaticArchiveStep::init(
            self.allocator,
            target,
            destination,
            handle.index(),
        ).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(
            name,
            StepKind::InstallStaticArchive,
            StepPayload { installStaticArchive: payload },
        ).?;
        transferred = true;
        let mut committed = false;
        defer if not committed {
            self.rollbackLastStep().?;
        };
        self.dependOn(result, producer).?;
        committed = true;
        !result
    }

    pub fn addExternalCommandStep(&mut self, name: &[char], options: ExternalCommandOptions) Error!StepHandle {
        validateExternalCommand(options, self.steps.len()).?;
        let mut artifactInputCount: usize = 0;
        match options.arguments {
            ?arguments => {
                for &argument in arguments.iter() {
                    if argument.kind == CommandArgumentKind::ArtifactInput {
                        let target = argument.payload.artifact;
                        self.validateExecutableHandle(target).?;
                        match self.findEmitStep(target) {
                            ?producer => _ = producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(self.steps.len()),
                            }!,
                        }
                        artifactInputCount += 1;
                    } else if argument.kind == CommandArgumentKind::ObjectInput {
                        let target = argument.payload.object;
                        self.validateObjectHandle(target).?;
                        match self.findEmitObjectStep(target) {
                            ?producer => _ = producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(self.steps.len()),
                            }!,
                        }
                        artifactInputCount += 1;
                    } else if argument.kind == CommandArgumentKind::StaticArchiveInput {
                        let target = argument.payload.staticArchive;
                        self.validateStaticArchiveHandle(target).?;
                        match self.findEmitStaticArchiveStep(target) {
                            ?producer => _ = producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(self.steps.len()),
                            }!,
                        }
                        artifactInputCount += 1;
                    } else if argument.kind == CommandArgumentKind::PackageInput {
                        self.validatePackageHandle(argument.package).?;
                    }
                }
            },
            null => {},
        }
        self.dependencies.reserve(
            self.allocator,
            artifactInputCount,
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut payload = ExternalCommandStep::init(self.allocator, options, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(
            name,
            StepKind::ExternalCommand,
            StepPayload { externalCommand: payload },
        ).?;
        transferred = true;
        let dependencyStart = self.dependencies.len();
        let mut committed = false;
        defer if not committed {
            while self.dependencies.len() > dependencyStart {
                _ = self.dependencies.pop();
            }
            self.rollbackLastStep().?;
        };
        match options.arguments {
            ?arguments => {
                for &argument in arguments.iter() {
                    if argument.kind == CommandArgumentKind::ArtifactInput {
                        let producer = match self.findEmitStep(argument.payload.artifact) {
                            ?producer => producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(handle.index()),
                            }!,
                        };
                        self.dependOn(result, producer).?;
                    } else if argument.kind == CommandArgumentKind::ObjectInput {
                        let producer = match self.findEmitObjectStep(argument.payload.object) {
                            ?producer => producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(handle.index()),
                            }!,
                        };
                        self.dependOn(result, producer).?;
                    } else if argument.kind == CommandArgumentKind::StaticArchiveInput {
                        let producer = match self.findEmitStaticArchiveStep(argument.payload.staticArchive) {
                            ?producer => producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(handle.index()),
                            }!,
                        };
                        self.dependOn(result, producer).?;
                    }
                }
            },
            null => {},
        }
        committed = true;
        !result
    }

    pub fn dependOn(&mut self, step: StepHandle, dependency: StepHandle) Error!() {
        self.validateStepHandle(step).?;
        self.validateStepHandle(dependency).?;
        if step.index() == dependency.index() {
            return Error::StepCycle {
                step: step.index(),
                dependency: dependency.index(),
            }!;
        }
        for &edge in self.dependencies.iter() {
            if edge.step.index() == step.index() and edge.dependency.index() == dependency.index() {
                return !();
            }
        }
        self.dependencies.push(
            self.allocator,
            StepDependency::init(step, dependency),
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        self.planValidated = false;
        !()
    }

    pub fn setDefaultStep(&mut self, step: StepHandle) Error!() {
        self.validateStepHandle(step).?;
        self.defaultStep = ?step;
        self.planValidated = false;
        !()
    }

    // Modules and artifacts retain borrowed descriptors as owned plan records.
    // Build-rooted source paths are generated inputs and gain producer edges
    // during complete-graph validation.
    pub fn addModule(&mut self, options: ModuleOptions) Error!ModuleHandle {
        let handle = ModuleHandle::init(self.ownerId, self.modules.len());

        if options.sourceRoot == ModuleSourceRoot::Package {
            if options.package is ?package {
                self.validatePackageHandle(package).?;
            }
        }
        if options.imports is ?imports {
            for &import in imports.iter() {
                if import.sourceRoot == ModuleSourceRoot::Package {
                    if import.package is ?package {
                        self.validatePackageHandle(package).?;
                    }
                }
            }
        }
        validateModuleImports(options.imports).?;

        if options.sourceRoot == ModuleSourceRoot::Build
            and not isValidBuildPath(options.rootSource.text())
        {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        match self.findModule(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Module(handle.index()),
                }!;
            },
            null => {},
        }
        let optimization = match options.optimization {
            ?optimization => optimization,
            null => self.defaultOptimization,
        };
        let mut moduleRecord = Module::init(
            self.allocator,
            options,
            optimization,
            handle.index(),
            self.ownerId,
        ).?;
        let mut transferred = false;
        defer if not transferred {
            moduleRecord.deinit(self.allocator).?;
        };
        self.modules.push(self.allocator, moduleRecord).asBuildError(Operation::Retain, Subject::Modules).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }

    pub fn addExecutable(&mut self, options: ExecutableOptions) Error!ExecutableHandle {
        let handle = ExecutableHandle::init(self.ownerId, self.executables.len());
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        self.validateModuleHandle(options.rootModule).?;
        match options.staticArchives {
            ?archives => {
                let mut archiveIndex: usize = 0;
                while archiveIndex < archives.len() {
                    let archive = archives[archiveIndex];
                    self.validateStaticArchiveHandle(archive).?;
                    let archiveTarget = self.staticArchives.asSlice()[archive.index()];
                    if archiveTarget.targetRole != options.targetRole {
                        return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Executable(handle.index()),
                        }!;
                    }
                    let mut previous: usize = 0;
                    while previous < archiveIndex {
                        if archives[previous].index() == archive.index() {
                            return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Executable(handle.index()),
                            }!;
                        }
                        previous += 1;
                    }
                    archiveIndex += 1;
                }
            },
            null => {},
        }
        let outputName = executableOutputName(options);
        if not isValidOutputName(outputName) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        match self.findExecutable(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Executable(handle.index()),
                }!;
            },
            null => {},
        }
        match self.findObject(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Executable(handle.index()),
                }!;
            },
            null => {},
        }
        match self.findStaticArchive(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Executable(handle.index()),
                }!;
            },
            null => {},
        }
        let mut target = ExecutableTarget::init(self.allocator, options, outputName, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            target.deinit(self.allocator).?;
        };
        self.executables.push(self.allocator, target).asBuildError(Operation::Retain, Subject::Executables).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }

    pub fn addObject(&mut self, options: ObjectOptions) Error!ObjectHandle {
        let handle = ObjectHandle::init(self.ownerId, self.objects.len());
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Object(handle.index()),
            }!;
        }
        self.validateModuleHandle(options.rootModule).?;
        let outputName = objectOutputName(options);
        if not isValidOutputName(outputName) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Object(handle.index()),
            }!;
        }
        match self.findObject(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Object(handle.index()),
                }!;
            },
            null => {},
        }
        match self.findExecutable(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Object(handle.index()),
                }!;
            },
            null => {},
        }
        match self.findStaticArchive(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Object(handle.index()),
                }!;
            },
            null => {},
        }
        let mut target = ObjectTarget::init(self.allocator, options, outputName, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            target.deinit(self.allocator).?;
        };
        self.objects.push(self.allocator, target).asBuildError(Operation::Retain, Subject::Objects).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }

    pub fn addStaticArchive(&mut self, options: StaticArchiveOptions) Error!StaticArchiveHandle {
        let handle = StaticArchiveHandle::init(self.ownerId, self.staticArchives.len());
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::StaticArchive(handle.index()),
            }!;
        }
        self.validateModuleHandle(options.rootModule).?;
        let outputName = staticArchiveOutputName(options);
        if not isValidOutputName(outputName) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::StaticArchive(handle.index()),
            }!;
        }
        match self.findStaticArchive(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::StaticArchive(handle.index()),
                }!;
            },
            null => {},
        }
        match self.findExecutable(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::StaticArchive(handle.index()),
                }!;
            },
            null => {},
        }
        match self.findObject(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::StaticArchive(handle.index()),
                }!;
            },
            null => {},
        }
        let mut target = StaticArchiveTarget::init(self.allocator, options, outputName, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            target.deinit(self.allocator).?;
        };
        self.staticArchives.push(self.allocator, target).asBuildError(Operation::Retain, Subject::StaticArchives).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }

    pub fn requestedStep(&self) ?&[char] {
        if self.hasRequestedStep {
            ?self.requestedStep.text()
        } else {
            null
        }
    }

    pub fn validatePlan(&mut self) Error!() {
        if self.planValidated {
            return !();
        }
        self.selectedStep = null;
        match self.requestedStep() {
            ?step => {
                match self.findStep(step) {
                    ?selected => {
                        self.selectedStep = ?StepHandle::init(self.ownerId, selected.index);
                    },
                    null => {
                        self.reportUnknownStep(step).?;
                        return Error::UnknownStep!;
                    },
                }
            },
            null => {
                match self.defaultStep {
                    ?handle => {
                        self.selectedStep = ?handle;
                    },
                    null => {
                        if self.steps.len() != 0 {
                            return Error::MissingDefaultStep!;
                        }
                    },
                }
            },
        }
        self.ensureGeneratedModuleDependencies().?;
        self.validateDependencyGraph().?;
        self.planValidated = true;
        !()
    }

    fn ensureGeneratedModuleDependencies(&mut self) Error!() {
        let mut missingCount: usize = 0;
        let mut index: usize = 0;
        while index < self.steps.len() {
            let missing = self.missingGeneratedDependenciesForStep(index).?;
            missingCount = match missingCount.checked_add(missing) {
                ?value => value,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Dependencies,
                }!,
            };
            index += 1;
        }
        self.dependencies.reserve(
            self.allocator,
            missingCount,
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        index = 0;
        while index < self.steps.len() {
            self.addGeneratedDependenciesForStep(index).?;
            index += 1;
        }
        !()
    }

    fn compilerModuleIndexForStep(&self, index: usize) ?usize {
        let step = self.steps.asSlice()[index];
        match step.kind {
            StepKind::CheckExecutable => ?self.executables.asSlice()[
                step.payload.executable.target.index()
            ].rootModule.index(),
            StepKind::EmitExecutable => ?self.executables.asSlice()[
                step.payload.executable.target.index()
            ].rootModule.index(),
            StepKind::EmitObject => ?self.objects.asSlice()[
                step.payload.object.target.index()
            ].rootModule.index(),
            StepKind::EmitStaticArchive => ?self.staticArchives.asSlice()[
                step.payload.staticArchive.target.index()
            ].rootModule.index(),
            StepKind::TestExecutable => ?self.executables.asSlice()[
                step.payload.runExecutable.target.index()
            ].rootModule.index(),
            _ => null,
        }
    }

    fn missingGeneratedDependenciesForStep(&self, index: usize) Error!usize {
        let moduleIndex = match self.compilerModuleIndexForStep(index) {
            ?moduleIndex => moduleIndex,
            null => return !0,
        };
        let moduleRecord = self.modules.asSlice()[moduleIndex];
        let mut count: usize = 0;
        if moduleRecord.sourceRoot == ModuleSourceRoot::Build {
            let producer = self.requireGeneratedSourceProducer(
                moduleRecord.rootSource.text(),
                index,
                moduleIndex,
            ).?;
            if not self.hasDependency(index, producer.index()) {
                count = match count.checked_add(1) {
                    ?value => value,
                    null => return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Dependencies,
                    }!,
                };
            }
        }
        for &import in moduleRecord.imports.iter() {
            if import.sourceRoot == ModuleSourceRoot::Build {
                let producer = self.requireGeneratedSourceProducer(
                    import.path.text(),
                    index,
                    moduleIndex,
                ).?;
                if not self.hasDependency(index, producer.index()) {
                    count = match count.checked_add(1) {
                        ?value => value,
                        null => return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Dependencies,
                        }!,
                    };
                }
            }
        }
        !count
    }

    fn addGeneratedDependenciesForStep(&mut self, index: usize) Error!() {
        let moduleIndex = match self.compilerModuleIndexForStep(index) {
            ?moduleIndex => moduleIndex,
            null => return !(),
        };
        let moduleRecord = self.modules.asSlice()[moduleIndex];
        if moduleRecord.sourceRoot == ModuleSourceRoot::Build {
            let producer = self.requireGeneratedSourceProducer(
                moduleRecord.rootSource.text(),
                index,
                moduleIndex,
            ).?;
            self.dependOn(StepHandle::init(self.ownerId, index), producer).?;
        }
        let mut importIndex: usize = 0;
        while importIndex < moduleRecord.imports.len() {
            let import = moduleRecord.imports.asSlice()[importIndex];
            if import.sourceRoot == ModuleSourceRoot::Build {
                let producer = self.requireGeneratedSourceProducer(
                    import.path.text(),
                    index,
                    moduleIndex,
                ).?;
                self.dependOn(StepHandle::init(self.ownerId, index), producer).?;
            }
            importIndex += 1;
        }
        !()
    }

    fn requireGeneratedSourceProducer(
        &self,
        path: &[char],
        consumerIndex: usize,
        moduleIndex: usize,
    ) Error!StepHandle {
        match self.findGeneratedSourceProducer(path, consumerIndex) {
            ?producer => !producer,
            null => Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(moduleIndex),
            }!,
        }
    }

    fn hasDependency(&self, stepIndex: usize, dependencyIndex: usize) bool {
        for &edge in self.dependencies.iter() {
            if edge.step.index() == stepIndex
                and edge.dependency.index() == dependencyIndex
            {
                return true;
            }
        }
        false
    }

    fn findGeneratedSourceProducer(&self, path: &[char], consumerIndex: usize) ?StepHandle {
        let mut found: ?StepHandle = null;
        let mut index: usize = 0;
        for &step in self.steps.iter() {
            if index == consumerIndex {
                index += 1;
                continue;
            }
            let matches = if step.kind == StepKind::GeneratedFile {
                step.payload.generatedFile.output.text().equals(path)
            } else if step.kind == StepKind::ExternalCommand {
                let mut output = false;
                for &argument in step.payload.externalCommand.arguments.iter() {
                    if argument.kind == CommandArgumentKind::BuildOutput
                        and argument.payload.value.equals(path)
                    {
                        output = true;
                    }
                }
                output
            } else {
                false
            };
            if matches {
                match found {
                    ?old => {
                        _ = old;
                        return null;
                    },
                    null => found = ?StepHandle::init(self.ownerId, step.index),
                }
            }
            index += 1;
        }
        found
    }

    fn validateDependencyGraph(&mut self) Error!() {
        let mut indegree = collections::ArrayList[usize]::initCapacity(
            self.allocator,
            self.steps.len(),
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        defer indegree.deinit(self.allocator).asBuildError(Operation::Release, Subject::Dependencies).?;
        let mut index: usize = 0;
        while index < self.steps.len() {
            indegree.push(self.allocator, 0).asBuildError(Operation::Retain, Subject::Dependencies).?;
            index += 1;
        }
        for &edge in self.dependencies.iter() {
            let slot = &mut indegree.asMutSlice()[edge.step.index()];
            slot.* = match slot.*.checked_add(1) {
                ?value => value,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Dependencies,
                }!,
            };
        }

        let mut ready = collections::ArrayList[usize]::initCapacity(
            self.allocator,
            self.steps.len(),
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        defer ready.deinit(self.allocator).asBuildError(Operation::Release, Subject::Dependencies).?;
        index = 0;
        while index < indegree.len() {
            if indegree.asSlice()[index] == 0 {
                ready.push(self.allocator, index).asBuildError(Operation::Retain, Subject::Dependencies).?;
            }
            index += 1;
        }

        let mut cursor: usize = 0;
        while cursor < ready.len() {
            let completed = ready.asSlice()[cursor];
            cursor += 1;
            for &edge in self.dependencies.iter() {
                if edge.dependency.index() == completed {
                    let dependent = edge.step.index();
                    indegree.asMutSlice()[dependent] -= 1;
                    if indegree.asSlice()[dependent] == 0 {
                        ready.push(self.allocator, dependent).asBuildError(Operation::Retain, Subject::Dependencies).?;
                    }
                }
            }
        }
        if cursor != self.steps.len() {
            for &edge in self.dependencies.iter() {
                if indegree.asSlice()[edge.step.index()] != 0
                    and indegree.asSlice()[edge.dependency.index()] != 0
                {
                    return Error::StepCycle {
                        step: edge.step.index(),
                        dependency: edge.dependency.index(),
                    }!;
                }
            }
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Dependencies,
            }!;
        }
        !()
    }

    pub fn reportError(&mut self, error: Error) Error!() {
        let mut buffer: [u8; 1024] = [0; 1024];
        let mut stderr = io::FileWriter::stderr(&mut buffer);
        stderr.print(
            &"build error: {}\n",
            &[&error],
        ).asBuildError(Operation::Report, Subject::Diagnostic).?;
        stderr.flush().asBuildError(Operation::Report, Subject::Diagnostic)
    }

    fn findStep(&self, name: &[char]) ?Step {
        for &step in self.steps.iter() {
            if step.name.equals(name) {
                return ?step;
            }
        }
        null
    }

    fn findExecutable(&self, name: &[char]) ?ExecutableTarget {
        for &target in self.executables.iter() {
            if target.name.equals(name) {
                return ?target;
            }
        }
        null
    }

    fn findObject(&self, name: &[char]) ?ObjectTarget {
        for &target in self.objects.iter() {
            if target.name.equals(name) {
                return ?target;
            }
        }
        null
    }

    fn findStaticArchive(&self, name: &[char]) ?StaticArchiveTarget {
        for &target in self.staticArchives.iter() {
            if target.name.equals(name) {
                return ?target;
            }
        }
        null
    }

    fn findModule(&self, name: &[char]) ?Module {
        for &moduleRecord in self.modules.iter() {
            if moduleRecord.name.equals(name) {
                return ?moduleRecord;
            }
        }
        null
    }

    fn findEmitStep(&self, target: ExecutableHandle) ?StepHandle {
        for &step in self.steps.iter() {
            if step.kind == StepKind::EmitExecutable
                and step.payload.executable.target.ownerId() == target.ownerId()
                and step.payload.executable.target.index() == target.index()
            {
                return ?StepHandle::init(self.ownerId, step.index);
            }
        }
        null
    }

    fn findEmitObjectStep(&self, target: ObjectHandle) ?StepHandle {
        for &step in self.steps.iter() {
            if step.kind == StepKind::EmitObject
                and step.payload.object.target.ownerId() == target.ownerId()
                and step.payload.object.target.index() == target.index()
            {
                return ?StepHandle::init(self.ownerId, step.index);
            }
        }
        null
    }

    fn findEmitStaticArchiveStep(&self, target: StaticArchiveHandle) ?StepHandle {
        for &step in self.steps.iter() {
            if step.kind == StepKind::EmitStaticArchive
                and step.payload.staticArchive.target.ownerId() == target.ownerId()
                and step.payload.staticArchive.target.index() == target.index()
            {
                return ?StepHandle::init(self.ownerId, step.index);
            }
        }
        null
    }

    fn rollbackLastStep(&mut self) Error!() {
        match self.steps.pop() {
            ?step => {
                let mut owned = step;
                owned.deinit(self.allocator)
            },
            null => Error::Invalid {
                operation: Operation::Release,
                subject: Subject::Steps,
            }!,
        }
    }

    fn validateExecutableHandle(&self, handle: ExecutableHandle) Error!() {
        if handle.ownerId() != self.ownerId or handle.index() >= self.executables.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        !()
    }

    fn validateRunnableExecutable(&self, handle: ExecutableHandle, stepIndex: usize) Error!() {
        let role = self.executables.asSlice()[handle.index()].targetRole;
        // Run and test actions execute while constructing this build, so their
        // program must match the host. An artifact-role executable remains
        // runnable for native builds because both roles resolve to one target.
        let runsOnHost = match role {
            TargetRole::Host => true,
            TargetRole::Artifact => self.hostTarget.view().equals(self.artifactTarget.view()),
            _ => false,
        };
        if not runsOnHost {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(stepIndex),
            }!;
        }
        !()
    }

    fn validateObjectHandle(&self, handle: ObjectHandle) Error!() {
        if handle.ownerId() != self.ownerId or handle.index() >= self.objects.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Object(handle.index()),
            }!;
        }
        !()
    }

    fn validateStaticArchiveHandle(&self, handle: StaticArchiveHandle) Error!() {
        if handle.ownerId() != self.ownerId or handle.index() >= self.staticArchives.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::StaticArchive(handle.index()),
            }!;
        }
        !()
    }

    fn validatePackageHandle(&self, handle: PackageHandle) Error!() {
        if handle.ownerId != self.ownerId
            or handle.index > self.packages.len()
        {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Packages,
            }!;
        }
        !()
    }

    fn validateModuleHandle(&self, handle: ModuleHandle) Error!() {
        if handle.ownerId() != self.ownerId or handle.index() >= self.modules.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        !()
    }

    fn validateStepHandle(&self, handle: StepHandle) Error!() {
        if handle.ownerId() != self.ownerId or handle.index() >= self.steps.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(handle.index()),
            }!;
        }
        !()
    }

    fn reportUnknownStep(&mut self, step: &[char]) Error!() {
        let mut buffer: [u8; 256] = [0; 256];
        let mut stderr = io::FileWriter::stderr(&mut buffer);
        stderr.print(&"unknown build step `{}`\n", &[step]).asBuildError(Operation::Report, Subject::RequestedStep).?;
        stderr.flush().asBuildError(Operation::Report, Subject::RequestedStep)
    }

    fn addStepRecord(&mut self, name: &[char], kind: StepKind, payload: StepPayload) Error!StepHandle {
        if not isValidStableName(name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        match self.findStep(name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(self.steps.len()),
                }!;
            },
            null => {},
        }
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut step = Step::init(self.allocator, name, kind, payload, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            step.deinit(self.allocator).?;
        };
        self.steps.push(self.allocator, step).asBuildError(Operation::Retain, Subject::Steps).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }
}

extend StepHandle {
    fn init(ownerId: usize, index: usize) StepHandle {
        Self { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize {
        self.ownerId
    }

    fn index(&self) usize {
        self.index
    }
}

extend ExecutableHandle {
    fn init(ownerId: usize, index: usize) ExecutableHandle {
        Self { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize {
        self.ownerId
    }

    fn index(&self) usize {
        self.index
    }
}

extend ObjectHandle {
    fn init(ownerId: usize, index: usize) ObjectHandle {
        Self { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize { self.ownerId }
    fn index(&self) usize { self.index }
}

extend StaticArchiveHandle {
    fn init(ownerId: usize, index: usize) StaticArchiveHandle {
        Self { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize { self.ownerId }
    fn index(&self) usize { self.index }
}

extend ModuleHandle {
