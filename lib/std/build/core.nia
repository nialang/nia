};

static mut nextBuildOwnerId: usize = 1usize;

fn allocateBuildOwnerId() usize {
    let ownerId = atomicBuiltin::atomic_rmw[usize](
        &mut nextBuildOwnerId,
        atomic::Add,
        1usize,
        atomic::Monotonic,
    );
    if ownerId == 0usize {
        atomicBuiltin::atomic_rmw[usize](
            &mut nextBuildOwnerId,
            atomic::Add,
            1usize,
            atomic::Monotonic,
        )
    } else {
        ownerId
    }
}

extend BuildPaths {
    fn init(
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
    ) Error!BuildPaths {
        let mut paths: BuildPaths = {
            packageRoot: fs::PathBuf::init(),
            buildDir: fs::PathBuf::init(),
            cacheDir: fs::PathBuf::init(),
            toolchainExecutable: fs::PathBuf::init(),
            toolchainResourceRoot: fs::PathBuf::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            paths.deinit(allocator).?;
        };
        paths.packageRoot = fs::PathBuf::from_path(allocator, packageRoot).asBuildError(Operation::Retain, Subject::PackageRoot).?;
        paths.buildDir = fs::PathBuf::from_path(allocator, buildDir).asBuildError(Operation::Retain, Subject::BuildDir).?;
        paths.cacheDir = fs::PathBuf::from_path(allocator, cacheDir).asBuildError(Operation::Retain, Subject::CacheDir).?;
        paths.toolchainExecutable = fs::PathBuf::from_path(allocator, toolchainExecutable).asBuildError(Operation::Retain, Subject::ToolchainExecutable).?;
        paths.toolchainResourceRoot = fs::PathBuf::from_path(allocator, toolchainResourceRoot).asBuildError(Operation::Retain, Subject::ToolchainResourceRoot).?;
        transferred = true;
        !paths
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.toolchainResourceRoot.deinit(allocator).asBuildError(Operation::Release, Subject::ToolchainResourceRoot));
        rememberCleanupError(&mut firstError, self.toolchainExecutable.deinit(allocator).asBuildError(Operation::Release, Subject::ToolchainExecutable));
        rememberCleanupError(&mut firstError, self.cacheDir.deinit(allocator).asBuildError(Operation::Release, Subject::CacheDir));
        rememberCleanupError(&mut firstError, self.buildDir.deinit(allocator).asBuildError(Operation::Release, Subject::BuildDir));
        rememberCleanupError(&mut firstError, self.packageRoot.deinit(allocator).asBuildError(Operation::Release, Subject::PackageRoot));
        cleanupResult(firstError)
    }
}

extend Build {
    pub fn init(
        init: process::Init,
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
        hostTarget: TargetView,
        artifactTarget: TargetView,
        planSchemaVersion: u32,
        stepArgIndex: usize,
    ) Error!Build {
        let mut paths = BuildPaths::init(
            allocator,
            packageRoot,
            buildDir,
            cacheDir,
            toolchainExecutable,
            toolchainResourceRoot,
        ).?;
        let mut pathsTransferred = false;
        defer if not pathsTransferred {
            paths.deinit(allocator).?;
        };
        let mut ownedHostTarget = TargetStorage::init(allocator, hostTarget, Subject::HostTarget).?;
        let mut hostTargetTransferred = false;
        defer if not hostTargetTransferred {
            ownedHostTarget.deinit(allocator, Subject::HostTarget).?;
        };
        let mut ownedArtifactTarget = TargetStorage::init(allocator, artifactTarget, Subject::ArtifactTarget).?;
        let mut artifactTargetTransferred = false;
        defer if not artifactTargetTransferred {
            ownedArtifactTarget.deinit(allocator, Subject::ArtifactTarget).?;
        };
        pathsTransferred = true;
        hostTargetTransferred = true;
        artifactTargetTransferred = true;
        !{
            ownerId: allocateBuildOwnerId(),
            init: init,
            allocator: allocator,
            paths: paths,
            hostTarget: ownedHostTarget,
            artifactTarget: ownedArtifactTarget,
            planSchemaVersion: planSchemaVersion,
            stepArgIndex: stepArgIndex,
            defaultStep: null,
            selectedStep: null,
            planValidated: false,
            steps: collections::ArrayList[Step]::init(),
            dependencies: collections::ArrayList[StepDependency]::init(),
            modules: collections::ArrayList[Module]::init(),
            executables: collections::ArrayList[ExecutableTarget]::init(),
        }
    }

    pub fn deinit(&mut self) Error!void {
        let mut firstError: ?Error = null;
        let mut index = self.steps.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.steps.as_mut_slice()[index].deinit(self.allocator));
        }
        rememberCleanupError(&mut firstError, self.steps.deinit(self.allocator).asBuildError(Operation::Release, Subject::Steps));
        rememberCleanupError(&mut firstError, self.dependencies.deinit(self.allocator).asBuildError(Operation::Release, Subject::Dependencies));
        index = self.executables.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.executables.as_mut_slice()[index].deinit(self.allocator));
        }
        rememberCleanupError(&mut firstError, self.executables.deinit(self.allocator).asBuildError(Operation::Release, Subject::Executables));
        index = self.modules.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.modules.as_mut_slice()[index].deinit(self.allocator));
        }
        rememberCleanupError(&mut firstError, self.modules.deinit(self.allocator).asBuildError(Operation::Release, Subject::Modules));
        rememberCleanupError(&mut firstError, self.artifactTarget.deinit(self.allocator, Subject::ArtifactTarget));
        rememberCleanupError(&mut firstError, self.hostTarget.deinit(self.allocator, Subject::HostTarget));
        rememberCleanupError(&mut firstError, self.paths.deinit(self.allocator));
        cleanupResult(firstError)
    }

    pub fn io(&self) &mut io::Io[Error = os::Error] {
        self.init.io()
    }

    pub fn packageRoot(&self) fs::PathView {
        self.paths.packageRoot.view()
    }

    pub fn buildDir(&self) fs::PathView {
        self.paths.buildDir.view()
    }

    pub fn cacheDir(&self) fs::PathView {
        self.paths.cacheDir.view()
    }

    pub fn toolchainExecutable(&self) fs::PathView {
        self.paths.toolchainExecutable.view()
    }

    pub fn toolchainResourceRoot(&self) fs::PathView {
        self.paths.toolchainResourceRoot.view()
    }

    pub fn hostTarget(&self) TargetView {
        self.hostTarget.view()
    }

    pub fn artifactTarget(&self) TargetView {
        self.artifactTarget.view()
    }

    pub fn addAggregateStep(&mut self, name: &[char]) Error!StepHandle {
        self.addStepRecord(string::StringView::init(name), StepKind::Aggregate, { aggregate: AggregateStep::init() })
    }

    pub fn addUncacheableStep(&mut self, name: &[char], description: &[char]) Error!StepHandle {
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut payload = UncacheableStep::init(self.allocator, string::StringView::init(description), handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(string::StringView::init(name), StepKind::Uncacheable, { uncacheable: payload }).?;
        transferred = true;
        !result
    }

    pub fn addGeneratedFileStep(&mut self, name: &[char], output: BuildPathView, contents: &[u8]) Error!StepHandle {
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        if not output.isValid() or contents.len() > 67108864usize {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(handle.index()),
            }!;
        }
        let mut payload = GeneratedFileStep::init(self.allocator, output, contents, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(string::StringView::init(name), StepKind::GeneratedFile, { generatedFile: payload }).?;
        transferred = true;
        !result
    }

    pub fn addCheckExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        self.addStepRecord(string::StringView::init(name), StepKind::CheckExecutable, { executable: ExecutableStep::init(target) })
    }

    pub fn addEmitExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        self.addStepRecord(string::StringView::init(name), StepKind::EmitExecutable, { executable: ExecutableStep::init(target) })
    }

    pub fn dependOn(&mut self, step: StepHandle, dependency: StepHandle) Error!void {
        self.validateStepHandle(step).?;
        self.validateStepHandle(dependency).?;
        if step.index() == dependency.index() {
            return Error::StepCycle {
                step: step.index(),
                dependency: dependency.index(),
            }!;
        }
        for &edge in self.dependencies.iter() {
            if edge.step.index() == step.index() and edge.dependency.index() == dependency.index() {
                return !{};
            }
        }
        self.dependencies.push(
            self.allocator,
            StepDependency::init(step, dependency),
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        self.planValidated = false;
        !{}
    }

    pub fn setDefaultStep(&mut self, step: StepHandle) Error!void {
        self.validateStepHandle(step).?;
        self.defaultStep = ?step;
        self.planValidated = false;
        !{}
    }

    pub fn addModule(&mut self, options: ModuleOptions) Error!ModuleHandle {
        validateModuleImports(options.imports).?;
        let handle = ModuleHandle::init(self.ownerId, self.modules.len());
        if options.sourceRoot == ModuleSourceRoot::Build
            and not isValidBuildPath(options.rootSource.string())
        {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        switch self.findModule(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Module(handle.index()),
                }!;
            },
            null => {},
        }
        let mut moduleRecord = Module::init(self.allocator, options, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            moduleRecord.deinit(self.allocator).?;
        };
        self.modules.push(self.allocator, moduleRecord).asBuildError(Operation::Retain, Subject::Modules).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }

    pub fn addExecutable(&mut self, options: ExecutableOptions) Error!ExecutableHandle {
        let handle = ExecutableHandle::init(self.ownerId, self.executables.len());
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        self.validateModuleHandle(options.rootModule).?;
        if options.runtime != Runtime::Freestanding {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        let outputName = executableOutputName(options);
        if not isValidOutputName(outputName) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        switch self.findExecutable(options.name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Executable(handle.index()),
                }!;
            },
            null => {},
        }
        let mut target = ExecutableTarget::init(self.allocator, options, outputName, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            target.deinit(self.allocator).?;
        };
        self.executables.push(self.allocator, target).asBuildError(Operation::Retain, Subject::Executables).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }

    pub fn requestedStep(&self) ?process::Arg {
        self.init.args().get(self.stepArgIndex)
    }

    pub fn validatePlan(&mut self) Error!void {
        if self.planValidated {
            return !{};
        }
        self.selectedStep = null;
        switch self.requestedStep() {
            ?step => {
                switch self.findStepArg(step) {
                    ?handle => {
                        self.selectedStep = ?handle;
                    },
                    null => {
                        self.reportUnknownStep(step).?;
                        return Error::UnknownStep!;
                    },
                }
            },
            null => {
                switch self.defaultStep {
                    ?handle => {
                        self.selectedStep = ?handle;
                    },
                    null => {
                        if self.steps.len() != 0usize {
                            return Error::MissingDefaultStep!;
                        }
                    },
                }
            },
        }
        self.validateDependencyGraph().?;
        self.planValidated = true;
        !{}
    }

    fn validateDependencyGraph(&mut self) Error!void {
        let mut indegree = collections::ArrayList[usize]::init_capacity(
            self.allocator,
            self.steps.len(),
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        defer indegree.deinit(self.allocator).asBuildError(Operation::Release, Subject::Dependencies).?;
        let mut index = 0usize;
        while index < self.steps.len() {
            indegree.push(self.allocator, 0usize).asBuildError(Operation::Retain, Subject::Dependencies).?;
            index += 1usize;
        }
        for &edge in self.dependencies.iter() {
            indegree.as_mut_slice()[edge.step.index()] += 1usize;
        }

        let mut ready = collections::ArrayList[usize]::init_capacity(
            self.allocator,
            self.steps.len(),
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        defer ready.deinit(self.allocator).asBuildError(Operation::Release, Subject::Dependencies).?;
        index = 0usize;
        while index < indegree.len() {
            if indegree.as_slice()[index] == 0usize {
                ready.push(self.allocator, index).asBuildError(Operation::Retain, Subject::Dependencies).?;
            }
            index += 1usize;
        }

        let mut cursor = 0usize;
        while cursor < ready.len() {
            let completed = ready.as_slice()[cursor];
            cursor += 1usize;
            for &edge in self.dependencies.iter() {
                if edge.dependency.index() == completed {
                    let dependent = edge.step.index();
                    indegree.as_mut_slice()[dependent] -= 1usize;
                    if indegree.as_slice()[dependent] == 0usize {
                        ready.push(self.allocator, dependent).asBuildError(Operation::Retain, Subject::Dependencies).?;
                    }
                }
            }
        }
        if cursor != self.steps.len() {
            for &edge in self.dependencies.iter() {
                if indegree.as_slice()[edge.step.index()] != 0usize
                    and indegree.as_slice()[edge.dependency.index()] != 0usize
                {
                    return Error::StepCycle {
                        step: edge.step.index(),
                        dependency: edge.dependency.index(),
                    }!;
                }
            }
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Dependencies,
            }!;
        }
        !{}
    }

    pub fn reportError(&mut self, error: Error) Error!void {
        let mut buffer: [1024]u8 = [_]u8[0; 1024];
        let mut stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print(
            &"build error: {}\n",
            &[&error],
        ).asBuildError(Operation::Report, Subject::Diagnostic).?;
        stderr.flush().asBuildError(Operation::Report, Subject::Diagnostic)
    }

    fn findStep(&self, name: string::StringView) ?Step {
        for &step in self.steps.iter() {
            if mem::equal[char](step.name.text(), name.text()) {
                return ?step;
            }
        }
        null
    }

    fn findStepArg(&self, arg: process::Arg) ?StepHandle {
        let mut index = 0usize;
        for &step in self.steps.iter() {
            if argMatchesText(arg, step.name.text()) {
                return ?StepHandle::init(self.ownerId, index);
            }
            index += 1usize;
        }
        null
    }

    fn findExecutable(&self, name: string::StringView) ?ExecutableTarget {
        for &target in self.executables.iter() {
            if mem::equal[char](target.name.text(), name.text()) {
                return ?target;
            }
        }
        null
    }

    fn findModule(&self, name: string::StringView) ?Module {
        for &moduleRecord in self.modules.iter() {
            if mem::equal[char](moduleRecord.name.text(), name.text()) {
                return ?moduleRecord;
            }
        }
        null
    }

    fn validateExecutableHandle(&self, handle: ExecutableHandle) Error!void {
        if handle.ownerId() != self.ownerId or handle.index() >= self.executables.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        !{}
    }

    fn validateModuleHandle(&self, handle: ModuleHandle) Error!void {
        if handle.ownerId() != self.ownerId or handle.index() >= self.modules.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        !{}
    }

    fn validateStepHandle(&self, handle: StepHandle) Error!void {
        if handle.ownerId() != self.ownerId or handle.index() >= self.steps.len() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(handle.index()),
            }!;
        }
        !{}
    }

    fn reportUnknownStep(&mut self, step: process::Arg) Error!void {
        let mut buffer: [256]u8 = [_]u8[0; 256];
        let mut stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print(&"unknown build step `{}`\n", &[&step]).asBuildError(Operation::Report, Subject::RequestedStep).?;
        stderr.flush().asBuildError(Operation::Report, Subject::RequestedStep)
    }

    fn addStepRecord(&mut self, name: string::StringView, kind: StepKind, payload: StepPayload) Error!StepHandle {
        if not isValidStableName(name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        switch self.findStep(name) {
            ?old => {
                _ = old;
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(self.steps.len()),
                }!;
            },
            null => {},
        }
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut step = Step::init(self.allocator, name, kind, payload, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            step.deinit(self.allocator).?;
        };
        self.steps.push(self.allocator, step).asBuildError(Operation::Retain, Subject::Steps).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }
}

extend StepHandle {
    fn init(ownerId: usize, index: usize) StepHandle {
        { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize {
        self.ownerId
    }

    fn index(&self) usize {
        self.index
    }
}

extend ExecutableHandle {
    fn init(ownerId: usize, index: usize) ExecutableHandle {
        { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize {
        self.ownerId
    }

    fn index(&self) usize {
        self.index
    }
}

extend ModuleHandle {
    fn init(ownerId: usize, index: usize) ModuleHandle {
        { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize {
        self.ownerId
    }

    fn index(&self) usize {
        self.index
    }
}

extend StepDependency {
    pub fn init(step: StepHandle, dependency: StepHandle) StepDependency {
        { step: step, dependency: dependency }
    }
}

extend AggregateStep {
    fn init() AggregateStep {
        { marker: 0u8 }
    }
}

extend UncacheableStep {
    fn init(allocator: &mut mem::Allocator, description: string::StringView, index: usize) Error!UncacheableStep {
        let owned = string::StringBuf::from_slice(allocator, description.text()).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !{ description: owned }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        self.description.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index))
    }
}

extend GeneratedFileStep {
    fn init(
        allocator: &mut mem::Allocator,
        output: BuildPathView,
        contents: &[u8],
        index: usize,
    ) Error!GeneratedFileStep {
        let mut generated: GeneratedFileStep = {
            output: string::StringBuf::init(),
            contents: collections::ArrayList[u8]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            generated.deinit(allocator, index).?;
        };
        generated.output = string::StringBuf::from_slice(allocator, output.text()).asBuildError(Operation::Retain, Subject::Step(index)).?;
        generated.contents.append_slice(allocator, contents).asBuildError(Operation::Retain, Subject::Step(index)).?;
        transferred = true;
        !generated
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.contents.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)));
        rememberCleanupError(&mut firstError, self.output.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)));
        cleanupResult(firstError)
    }
}

extend ExecutableStep {
    fn init(target: ExecutableHandle) ExecutableStep {
        { target: target }
    }
}

extend Step {
    fn init(
        allocator: &mut mem::Allocator,
        name: string::StringView,
        kind: StepKind,
        payload: StepPayload,
        index: usize,
    ) Error!Step {
        let ownedName = string::StringBuf::from_slice(allocator, name.text()).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !{
            index: index,
            name: ownedName,
            kind: kind,
            payload: payload,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        if self.kind == StepKind::Uncacheable {
            rememberCleanupError(&mut firstError, self.payload.uncacheable.deinit(allocator, self.index));
        }
        if self.kind == StepKind::GeneratedFile {
            rememberCleanupError(&mut firstError, self.payload.generatedFile.deinit(allocator, self.index));
        }
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(self.index)));
        cleanupResult(firstError)
    }
}

extend ModuleOptions {
    pub fn init(name: &[char], rootSource: fs::PathView) ModuleOptions {
        {
            name: string::StringView::init(name),
            sourceRoot: ModuleSourceRoot::Package,
            rootSource: rootSource,
            optimization: OptimizationMode::O2,
            imports: null,
        }
    }

    pub fn fromBuild(name: &[char], rootSource: BuildPathView) ModuleOptions {
        {
            name: string::StringView::init(name),
            sourceRoot: ModuleSourceRoot::Build,
            rootSource: fs::PathView::init(rootSource.text()),
            optimization: OptimizationMode::O2,
            imports: null,
        }
    }

    pub fn withOptimization(self, optimization: OptimizationMode) ModuleOptions {
        {
            name: self.name,
            sourceRoot: self.sourceRoot,
            rootSource: self.rootSource,
            optimization: optimization,
            imports: self.imports,
        }
    }

    pub fn withImports(self, imports: &[ModuleImport]) ModuleOptions {
        {
            name: self.name,
            sourceRoot: self.sourceRoot,
            rootSource: self.rootSource,
            optimization: self.optimization,
            imports: ?imports,
        }
    }
}

extend BuildPathView {
    pub fn init(path: &[char]) BuildPathView {
        { path: string::StringView::init(path) }
    }

    pub fn text(&self) &[char] {
        self.path.text()
    }

    fn isValid(&self) bool {
        isValidBuildPath(self.path)
    }
}

extend Module {
    fn init(allocator: &mut mem::Allocator, options: ModuleOptions, index: usize) Error!Module {
        let mut moduleRecord: Module = {
            index: index,
            name: string::StringBuf::init(),
            sourceRoot: options.sourceRoot,
            rootSource: fs::PathBuf::init(),
            optimization: options.optimization,
            imports: collections::ArrayList[OwnedModuleImport]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            moduleRecord.deinit(allocator).?;
        };
        moduleRecord.name = string::StringBuf::from_slice(allocator, options.name.text()).asBuildError(Operation::Retain, Subject::Module(index)).?;
        moduleRecord.rootSource = fs::PathBuf::from_path(allocator, options.rootSource).asBuildError(Operation::Retain, Subject::Module(index)).?;
        moduleRecord.imports = cloneModuleImports(allocator, options.imports).?;
        transferred = true;
        !moduleRecord
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        let mut index = self.imports.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.imports.as_mut_slice()[index].deinit(allocator));
        }
        rememberCleanupError(&mut firstError, self.imports.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        rememberCleanupError(&mut firstError, self.rootSource.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        cleanupResult(firstError)
    }
}

extend ModuleImport {
    pub fn init(name: &[char], path: fs::PathView) ModuleImport {
        {
            name: string::StringView::init(name),
            path: path,
        }
    }
}

extend OwnedModuleImport {
    fn init(allocator: &mut mem::Allocator, import: ModuleImport, index: usize) Error!OwnedModuleImport {
        let mut owned: OwnedModuleImport = {
            index: index,
            name: string::StringBuf::init(),
            path: fs::PathBuf::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator).?;
        };
        owned.name = string::StringBuf::from_slice(allocator, import.name.text()).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        owned.path = fs::PathBuf::from_path(allocator, import.path).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        transferred = true;
        !owned
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.path.deinit(allocator).asBuildError(Operation::Release, Subject::ModuleImport(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::ModuleImport(self.index)));
        cleanupResult(firstError)
    }
}

extend ExecutableTarget {
    pub fn init(
        allocator: &mut mem::Allocator,
        options: ExecutableOptions,
        outputName: string::StringView,
        index: usize,
    ) Error!ExecutableTarget {
        let mut target: ExecutableTarget = {
            index: index,
            name: string::StringBuf::init(),
            rootModule: options.rootModule,
            outputName: string::StringBuf::init(),
            runtime: options.runtime,
            targetRole: TargetRole::Artifact,
        };
        let mut transferred = false;
        defer if not transferred {
            target.deinit(allocator).?;
        };
        target.name = string::StringBuf::from_slice(allocator, options.name.text()).asBuildError(Operation::Retain, Subject::Executable(index)).?;
        target.outputName = string::StringBuf::from_slice(allocator, outputName.text()).asBuildError(Operation::Retain, Subject::Executable(index)).?;
        transferred = true;
        !target
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.outputName.deinit(allocator).asBuildError(Operation::Release, Subject::Executable(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Executable(self.index)));
        cleanupResult(firstError)
    }
}

extend TargetView {
    pub fn init(
        arch: string::StringView,
        vendor: string::StringView,
        os: string::StringView,
        env: string::StringView,
        abi: string::StringView,
        endian: string::StringView,
        pointerWidth: u32,
    ) TargetView {
        {
            arch: arch,
            vendor: vendor,
            os: os,
            env: env,
            abi: abi,
            endian: endian,
            pointerWidth: pointerWidth,
        }
    }

    pub fn arch(&self) string::StringView {
        self.arch
    }

    pub fn vendor(&self) string::StringView {
        self.vendor
    }

    pub fn os(&self) string::StringView {
        self.os
    }

    pub fn env(&self) string::StringView {
        self.env
    }

    pub fn abi(&self) string::StringView {
        self.abi
    }

    pub fn endian(&self) string::StringView {
        self.endian
    }

    pub fn pointerWidth(&self) u32 {
        self.pointerWidth
    }

    pub fn equals(&self, other: TargetView) bool {
        mem::equal[char](self.arch.text(), other.arch.text())
            and mem::equal[char](self.vendor.text(), other.vendor.text())
            and mem::equal[char](self.os.text(), other.os.text())
            and mem::equal[char](self.env.text(), other.env.text())
            and mem::equal[char](self.abi.text(), other.abi.text())
            and mem::equal[char](self.endian.text(), other.endian.text())
            and self.pointerWidth == other.pointerWidth
    }
}

extend TargetStorage {
    fn init(
        allocator: &mut mem::Allocator,
        target: TargetView,
        subject: Subject,
    ) Error!TargetStorage {
        let mut owned: TargetStorage = {
            arch: string::StringBuf::init(),
            vendor: string::StringBuf::init(),
            os: string::StringBuf::init(),
            env: string::StringBuf::init(),
            abi: string::StringBuf::init(),
            endian: string::StringBuf::init(),
            pointerWidth: target.pointerWidth,
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator, subject).?;
        };
        owned.arch = string::StringBuf::from_slice(allocator, target.arch.text()).asBuildError(Operation::Retain, subject).?;
        owned.vendor = string::StringBuf::from_slice(allocator, target.vendor.text()).asBuildError(Operation::Retain, subject).?;
        owned.os = string::StringBuf::from_slice(allocator, target.os.text()).asBuildError(Operation::Retain, subject).?;
        owned.env = string::StringBuf::from_slice(allocator, target.env.text()).asBuildError(Operation::Retain, subject).?;
        owned.abi = string::StringBuf::from_slice(allocator, target.abi.text()).asBuildError(Operation::Retain, subject).?;
        owned.endian = string::StringBuf::from_slice(allocator, target.endian.text()).asBuildError(Operation::Retain, subject).?;
        transferred = true;
        !owned
    }

    fn view(&self) TargetView {
        TargetView::init(
            self.arch.view(),
            self.vendor.view(),
            self.os.view(),
            self.env.view(),
            self.abi.view(),
            self.endian.view(),
            self.pointerWidth,
        )
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, subject: Subject) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.endian.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.abi.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.env.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.os.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.vendor.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.arch.deinit(allocator).asBuildError(Operation::Release, subject));
        cleanupResult(firstError)
    }
}

extend ExecutableOptions {
    pub fn init(name: &[char], rootModule: ModuleHandle) ExecutableOptions {
        {
            name: string::StringView::init(name),
            rootModule: rootModule,
            outputName: null,
            runtime: Runtime::Freestanding,
        }
    }

    pub fn withOutputName(self, outputName: &[char]) ExecutableOptions {
        {
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?string::StringView::init(outputName),
            runtime: self.runtime,
        }
    }

    pub fn withRuntime(self, runtime: Runtime) ExecutableOptions {
        {
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            runtime: runtime,
        }
    }
}

fn executableOutputName(options: ExecutableOptions) string::StringView {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

extend OptimizationMode {
    fn argv(self) &u8 {
        static o0 = b"-O0\0";
        static o1 = b"-O1\0";
        static o2 = b"-O2\0";
        static o3 = b"-O3\0";
        static os = b"-Os\0";
        static oz = b"-Oz\0";
        switch self {
            OptimizationMode::O0 => &o0[0],
            OptimizationMode::O1 => &o1[0],
            OptimizationMode::O2 => &o2[0],
            OptimizationMode::O3 => &o3[0],
            OptimizationMode::Os => &os[0],
            OptimizationMode::Oz => &oz[0],
            _ => &o2[0],
        }
    }
}

extend Runtime {
    fn argv(self) &u8 {
        static bare = b"--runtime=bare\0";
        static freestanding = b"--runtime=freestanding\0";
        switch self {
            Runtime::Bare => &bare[0],
            Runtime::Freestanding => &freestanding[0],
            _ => &freestanding[0],
        }
    }
}

fn isValidStableName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48u32 and code <= 57u32)
            or (code >= 65u32 and code <= 90u32)
            or (code >= 97u32 and code <= 122u32)
            or code == 45u32
            or code == 46u32
            or code == 95u32;
        if not valid {
            return false;
        }
    }
    true
}

fn isValidOutputName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    for &ch in name.text().iter() {
        let code = ch as u32;
        if code == 0u32 or code == 47u32 or code == 92u32 {
            return false;
        }
    }
    true
}

fn isValidBuildPath(path: string::StringView) bool {
    let text = path.text();
    if text.len() == 0usize or text[0usize] == '/' or text[text.len() - 1usize] == '/' {
        return false;
    }
    let mut componentStart = 0usize;
    let mut index = 0usize;
    while index <= text.len() {
        if index == text.len() or text[index] == '/' {
            let componentLen = index - componentStart;
            if componentLen == 0usize
                or (componentLen == 1usize and text[componentStart] == '.')
                or (componentLen == 2usize
                    and text[componentStart] == '.'
                    and text[componentStart + 1usize] == '.')
            {
                return false;
            }
            componentStart = index + 1usize;
        } else if text[index] == '\\' or text[index] == '\0' {
            return false;
        }
        index += 1usize;
    }
    true
}

fn validateModuleImports(imports: ?&[ModuleImport]) Error!void {
    switch imports {
        ?items => {
            let mut index = 0usize;
            for &import in items.iter() {
                if not isValidModuleImportName(import.name) {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::ModuleImport(index),
                    }!;
                }
                let mut oldIndex = 0usize;
                while oldIndex < index {
                    if mem::equal[char](items[oldIndex].name.text(), import.name.text()) {
                        return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::ModuleImport(index),
                        }!;
                    }
                    oldIndex += 1usize;
                }
                index += 1usize;
            }
        },
        null => {},
    }
    !{}
}

fn cloneModuleImports(
    allocator: &mut mem::Allocator,
    imports: ?&[ModuleImport],
) Error!collections::ArrayList[OwnedModuleImport] {
    let items = if imports is ?values {
        values
    } else {
        &[]
    };
    let mut owned = collections::ArrayList[OwnedModuleImport]::init_capacity(
        allocator,
        items.len(),
    ).asBuildError(Operation::Retain, Subject::Modules).?;
    let mut transferred = false;
    defer if not transferred {
        deinitModuleImports(&mut owned, allocator).?;
    };
    let mut index = 0usize;
    for &import in items.iter() {
        let mut ownedImport = OwnedModuleImport::init(allocator, import, index).?;
        let mut importTransferred = false;
        defer if not importTransferred {
            ownedImport.deinit(allocator).?;
        };
        owned.push(allocator, ownedImport).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        importTransferred = true;
        index += 1usize;
    }
    transferred = true;
    !owned
}

fn deinitModuleImports(
    imports: &mut collections::ArrayList[OwnedModuleImport],
    allocator: &mut mem::Allocator,
) Error!void {
    let mut firstError: ?Error = null;
    let mut index = imports.len();
    while index != 0usize {
        index -= 1usize;
        rememberCleanupError(&mut firstError, imports.as_mut_slice()[index].deinit(allocator));
    }
    rememberCleanupError(&mut firstError, imports.deinit(allocator).asBuildError(Operation::Release, Subject::Modules));
    cleanupResult(firstError)
}

fn isValidModuleImportName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    if mem::equal[char](text, &"entry") or mem::equal[char](text, &"pkg") {
        return false;
    }
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48u32 and code <= 57u32)
            or (code >= 65u32 and code <= 90u32)
            or (code >= 97u32 and code <= 122u32)
            or code == 95u32
            or code == 45u32;
        if not valid {
            return false;
        }
    }
    true
}

fn argMatchesText(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    let mut byteIndex = 0usize;
    for &ch in text.iter() {
        let encoded = ch.encode_utf8();
        let encodedBytes = encoded.bytes();
        for &encodedByte in encodedBytes.iter() {
            if byteIndex >= bytes.len() or bytes[byteIndex] != encodedByte {
                return false;
            }
            byteIndex += 1usize;
        }
    }
    byteIndex == bytes.len()
}

fn rememberCleanupError(firstError: &mut ?Error, result: Error!void) void {
    switch result {
        !ok => {
            _ = ok;
        },
        err! => {
            if firstError.* is null {
                firstError.* = ?err;
            }
        },
    }
}

fn cleanupResult(firstError: ?Error) Error!void {
    if firstError is ?err {
        err!
    } else {
        !{}
    }
}
