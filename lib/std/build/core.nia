        rememberCleanupError(&mut firstError, self.abi.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.env.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.os.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.vendor.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.arch.deinit(allocator).asBuildError(Operation::Release, subject));
        cleanupResult(firstError)
    }
}

extend ExecutableOptions {
    pub fn init(name: &[char], rootModule: ModuleHandle) ExecutableOptions {
        {
            name: string::StringView::init(name),
            rootModule: rootModule,
            outputName: null,
            runtime: Runtime::Freestanding,
        }
    }

    pub fn withOutputName(self, outputName: &[char]) ExecutableOptions {
        {
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?string::StringView::init(outputName),
            runtime: self.runtime,
        }
    }

    pub fn withRuntime(self, runtime: Runtime) ExecutableOptions {
        {
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            runtime: runtime,
        }
    }
}

fn executableOutputName(options: ExecutableOptions) string::StringView {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

extend OptimizationMode {
    fn argv(self) &u8 {
        static o0 = b"-O0\0";
        static o1 = b"-O1\0";
        static o2 = b"-O2\0";
        static o3 = b"-O3\0";
        static os = b"-Os\0";
        static oz = b"-Oz\0";
        switch self {
            OptimizationMode::O0 => &o0[0],
            OptimizationMode::O1 => &o1[0],
            OptimizationMode::O2 => &o2[0],
            OptimizationMode::O3 => &o3[0],
            OptimizationMode::Os => &os[0],
            OptimizationMode::Oz => &oz[0],
            _ => &o2[0],
        }
    }
}

extend Runtime {
    fn argv(self) &u8 {
        static bare = b"--runtime=bare\0";
        static freestanding = b"--runtime=freestanding\0";
        switch self {
            Runtime::Bare => &bare[0],
            Runtime::Freestanding => &freestanding[0],
            _ => &freestanding[0],
        }
    }
}

fn isValidStableName(name: string::StringView) bool {
    if name.len() == 0 {
        return false;
    }
    let text = name.text();
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48 and code <= 57)
            or (code >= 65 and code <= 90)
            or (code >= 97 and code <= 122)
            or code == 45
            or code == 46
            or code == 95;
        if not valid {
            return false;
        }
    }
    true
}

fn isValidOutputName(name: string::StringView) bool {
    if name.len() == 0 {
        return false;
    }
    for &ch in name.text().iter() {
        let code = ch as u32;
        if code == 0 or code == 47 or code == 92 {
            return false;
        }
    }
    true
}

fn isValidBuildPath(path: string::StringView) bool {
    let text = path.text();
    if text.len() == 0 or text[0] == '/' or text[text.len() - 1] == '/' {
        return false;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index <= text.len() {
        if index == text.len() or text[index] == '/' {
            let componentLen = index - componentStart;
            if componentLen == 0
                or (componentLen == 1 and text[componentStart] == '.')
                or (componentLen == 2
                    and text[componentStart] == '.'
                    and text[componentStart + 1] == '.')
            {
                return false;
            }
            componentStart = index + 1;
        } else if text[index] == '\\' or text[index] == '\0' {
            return false;
        }
        index += 1;
    }
    true
}

fn validateModuleImports(imports: ?&[ModuleImport]) Error!void {
    switch imports {
        ?items => {
            let mut index: usize = 0;
            for &import in items.iter() {
                if not isValidModuleImportName(import.name) {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::ModuleImport(index),
                    }!;
                }
                let mut oldIndex: usize = 0;
                while oldIndex < index {
                    if mem::equal[char](items[oldIndex].name.text(), import.name.text()) {
                        return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::ModuleImport(index),
                        }!;
                    }
                    oldIndex += 1;
                }
                index += 1;
            }
        },
        null => {},
    }
    !{}
}

fn cloneModuleImports(
    allocator: &mut mem::Allocator,
    imports: ?&[ModuleImport],
) Error!collections::ArrayList[OwnedModuleImport] {
    let items = if imports is ?values {
        values
    } else {
        &[]
    };
    let mut owned = collections::ArrayList[OwnedModuleImport]::init_capacity(
        allocator,
        items.len(),
    ).asBuildError(Operation::Retain, Subject::Modules).?;
    let mut transferred = false;
    defer if not transferred {
        deinitModuleImports(&mut owned, allocator).?;
    };
    let mut index: usize = 0;
    for &import in items.iter() {
        let mut ownedImport = OwnedModuleImport::init(allocator, import, index).?;
        let mut importTransferred = false;
        defer if not importTransferred {
            ownedImport.deinit(allocator).?;
        };
        owned.push(allocator, ownedImport).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        importTransferred = true;
        index += 1;
    }
    transferred = true;
    !owned
}

fn deinitModuleImports(
    imports: &mut collections::ArrayList[OwnedModuleImport],
    allocator: &mut mem::Allocator,
) Error!void {
    let mut firstError: ?Error = null;
    let mut index = imports.len();
    while index != 0 {
        index -= 1;
        rememberCleanupError(&mut firstError, imports.as_mut_slice()[index].deinit(allocator));
    }
    rememberCleanupError(&mut firstError, imports.deinit(allocator).asBuildError(Operation::Release, Subject::Modules));
    cleanupResult(firstError)
}

fn isValidModuleImportName(name: string::StringView) bool {
    if name.len() == 0 {
        return false;
    }
    let text = name.text();
    if mem::equal[char](text, &"entry") or mem::equal[char](text, &"pkg") {
        return false;
    }
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48 and code <= 57)
            or (code >= 65 and code <= 90)
            or (code >= 97 and code <= 122)
            or code == 95
            or code == 45;
        if not valid {
            return false;
        }
    }
    true
}

fn argMatchesText(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    let mut byteIndex: usize = 0;
    for &ch in text.iter() {
        let encoded = ch.encode_utf8();
        let encodedBytes = encoded.bytes();
        for &encodedByte in encodedBytes.iter() {
            if byteIndex >= bytes.len() or bytes[byteIndex] != encodedByte {
                return false;
            }
            byteIndex += 1;
        }
    }
    byteIndex == bytes.len()
}

fn rememberCleanupError(firstError: &mut ?Error, result: Error!void) void {
    switch result {
        !ok => {
            _ = ok;
        },
        err! => {
            if firstError.* is null {
                firstError.* = ?err;
            }
        },
    }
}

fn cleanupResult(firstError: ?Error) Error!void {
    if firstError is ?err {
        err!
    } else {
        !{}
    }
}
