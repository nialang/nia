using pkg::collections;
using pkg::cstr;
using pkg::process;
using pkg::fmt;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::os;
using pkg::build::error;
using pkg::build::types;

using error::Error;
using types::{
    Build,
    Step,
    StepFn,
    StepHandle,
    StepDependency,
    StepKind,
    StepState,
    CustomStep,
    ExecutableHandle,
    ExecutableStep,
    ExecutableTarget,
    StepPayload,
};

pub fn noop_step(b: &mut Build) Error!void {
    _ = b;
    !{}
}

extend Build {
    pub fn init(
        init: process::Init,
        allocator: &mut mem::Allocator,
        package_root: fs::Path,
        build_dir: fs::Path,
        cache_dir: fs::Path,
        toolchain_executable: fs::Path,
        step_arg_index: usize,
    ) Build {
        {
            init: init,
            allocator: allocator,
            package_root: package_root,
            build_dir: build_dir,
            cache_dir: cache_dir,
            toolchain_executable: toolchain_executable,
            step_arg_index: step_arg_index,
            default_step: null,
            steps: collections::ArrayList[Step]::init(),
            dependencies: collections::ArrayList[StepDependency]::init(),
            executables: collections::ArrayList[ExecutableTarget]::init(),
        }
    }

    pub fn deinit(&mut self) Error!void {
        self.executables.deinit(self.allocator).as_build_error().?;
        self.dependencies.deinit(self.allocator).as_build_error().?;
        self.steps.deinit(self.allocator).as_build_error()
    }

    pub fn io(&self) &mut io::Io[Error = os::Error] {
        self.init.io()
    }

    pub fn package_root(&self) fs::Path {
        self.package_root
    }

    pub fn build_dir(&self) fs::Path {
        self.build_dir
    }

    pub fn cache_dir(&self) fs::Path {
        self.cache_dir
    }

    pub fn toolchain_executable(&self) fs::Path {
        self.toolchain_executable
    }

    pub fn add_step(&mut self, name: &[char], run: StepFn) Error!StepHandle {
        self.add_step_record(Step::custom(name, run))
    }

    pub fn add_check_executable_step(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validate_executable_handle(target).?;
        self.add_step_record(Step::check_executable(name, target))
    }

    pub fn add_emit_executable_step(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validate_executable_handle(target).?;
        self.add_step_record(Step::emit_executable(name, target))
    }

    pub fn depend_on(&mut self, step: StepHandle, dependency: StepHandle) Error!void {
        if step.index() >= self.steps.len() or dependency.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        if step.index() == dependency.index() {
            return Error::StepCycle!;
        }
        var index = 0usize;
        while index < self.dependencies.len() {
            let edge = self.dependencies.as_slice()[index];
            if edge.step.index() == step.index() and edge.dependency.index() == dependency.index() {
                return !{};
            }
            index += 1usize;
        }
        self.dependencies.push(
            self.allocator,
            StepDependency::init(step, dependency),
        ).as_build_error()
    }

    pub fn set_default_step(&mut self, step: StepHandle) Error!void {
        if step.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        self.default_step = ?step;
        !{}
    }

    pub fn add_executable(&mut self, name: &[char], source: fs::Path) Error!ExecutableHandle {
        if not is_valid_target_name(name) {
            return Error::InvalidTarget!;
        }
        if let ?old = self.find_executable(name) {
            _ = old;
            return Error::InvalidTarget!;
        } else null {}
        let handle = ExecutableHandle::init(self.executables.len());
        self.executables.push(
            self.allocator,
            ExecutableTarget::init(name, source),
        ).as_build_error().?;
        !handle
    }

    fn check_executable(&mut self, handle: ExecutableHandle) Error!void {
        let target = self.executable_target(handle).?;
        self.check_exe(target.source)
    }

    fn emit_executable(&mut self, handle: ExecutableHandle) Error!void {
        let target = self.executable_target(handle).?;
        var output_text = collections::ArrayList[char]::init();
        defer output_text.deinit(self.allocator).as_build_error().?;
        let output_path = self.build_dir.join_component_into(
            self.allocator,
            target.name,
            &mut output_text,
        ).as_build_error().?;
        var output_path_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let output = output_path.encode(&mut output_path_storage[..]).as_build_error().?;
        self.emit_exe(target.source, output)
    }

    fn check_exe(&mut self, source: fs::Path) Error!void {
        var toolchain_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        var source_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let toolchain = self.toolchain_executable.encode(&mut toolchain_storage[..]).as_build_error().?;
        let source_arg = source.encode(&mut source_storage[..]).as_build_error().?;
        let check_arg = b"check\0";
        let exe_arg = b"--exe\0";
        var argv: [5]&u8 = [
            toolchain.ptr(),
            &check_arg.*[0],
            &exe_arg.*[0],
            source_arg.ptr(),
            0usize as &u8,
        ];
        self.run_toolchain_argv(toolchain, &argv[0])
    }

    fn emit_exe(&mut self, source: fs::Path, output: fs::EncodedPath) Error!void {
        var toolchain_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        var source_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        var cache_dir_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let toolchain = self.toolchain_executable.encode(&mut toolchain_storage[..]).as_build_error().?;
        let source_arg = source.encode(&mut source_storage[..]).as_build_error().?;
        let cache_dir_arg = self.cache_dir.encode(&mut cache_dir_storage[..]).as_build_error().?;
        let emit_arg = b"emit\0";
        let exe_arg = b"--exe\0";
        let output_arg = b"-o\0";
        let cache_dir_flag = b"--cache-dir\0";
        var argv: [9]&u8 = [
            toolchain.ptr(),
            &emit_arg.*[0],
            &exe_arg.*[0],
            source_arg.ptr(),
            &output_arg.*[0],
            output.ptr(),
            &cache_dir_flag.*[0],
            cache_dir_arg.ptr(),
            0usize as &u8,
        ];
        self.run_toolchain_argv(toolchain, &argv[0])
    }

    fn executable_target(&self, handle: ExecutableHandle) Error!ExecutableTarget {
        if handle.index() >= self.executables.len() {
            return Error::InvalidTarget!;
        }
        !self.executables.as_slice()[handle.index()]
    }

    fn run_toolchain_argv(&mut self, toolchain: fs::EncodedPath, argv: &&u8) Error!void {
        var command = process::Command::init(cstr::CStr::from_ptr(toolchain.ptr()), argv, self.init.raw_envp());
        let term = command.run().as_build_error().?;
        if not term.exited_success() {
            return Error::CommandFailed!;
        }
        !{}
    }

    pub fn requested_step(&self) ?process::Arg {
        self.init.args().get(self.step_arg_index)
    }

    pub fn run_requested_step(&mut self) Error!void {
        if let ?step = self.requested_step() {
            if let ?handle = self.find_step_arg(step) {
                return self.run_step(handle);
            } else null {}
            self.report_unknown_step(step).?;
            return Error::UnknownStep!;
        } else null {}
        if let ?handle = self.default_step {
            return self.run_step(handle);
        } else null {}
        if self.steps.len() != 0usize {
            return Error::MissingDefaultStep!;
        }
        !{}
    }

    fn run_step(&mut self, handle: StepHandle) Error!void {
        if handle.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        let state = self.steps.as_slice()[handle.index()].state;
        switch state {
            StepState::Done => return !{},
            StepState::Running => return Error::StepCycle!,
            StepState::Failed => return Error::StepFailed!,
            _ => {}
        }

        self.set_step_state(handle, StepState::Running);

        var index = 0usize;
        while index < self.dependencies.len() {
            let edge = self.dependencies.as_slice()[index];
            if edge.step.index() == handle.index() {
                if let !ok = self.run_step(edge.dependency) {
                    _ = ok;
                } else err! {
                    self.set_step_state(handle, StepState::Failed);
                    return err!;
                }
            }
            index += 1usize;
        }

        let step = self.steps.as_slice()[handle.index()];
        if let !ok = self.run_step_payload(step) {
            _ = ok;
        } else err! {
            self.set_step_state(handle, StepState::Failed);
            return err!;
        }

        self.set_step_state(handle, StepState::Done);
        !{}
    }

    fn run_step_payload(&mut self, step: Step) Error!void {
        switch step.kind {
            StepKind::Custom => (step.payload.custom.run)(self),
            StepKind::CheckExecutable => self.check_executable(step.payload.executable.target),
            StepKind::EmitExecutable => self.emit_executable(step.payload.executable.target),
        }
    }

    fn set_step_state(&mut self, handle: StepHandle, state: StepState) void {
        var steps = self.steps.as_mut_slice();
        steps[handle.index()].state = state;
    }

    fn find_step(&self, name: &[char]) ?Step {
        var index = 0usize;
        while index < self.steps.len() {
            let step = self.steps.as_slice()[index];
            if mem::equal[char](step.name, name) {
                return ?step;
            }
            index += 1usize;
        }
        null
    }

    fn find_step_arg(&self, arg: process::Arg) ?StepHandle {
        var index = 0usize;
        while index < self.steps.len() {
            let step = self.steps.as_slice()[index];
            if arg_matches_text(arg, step.name) {
                return ?StepHandle::init(index);
            }
            index += 1usize;
        }
        null
    }

    fn find_executable(&self, name: &[char]) ?ExecutableTarget {
        var index = 0usize;
        while index < self.executables.len() {
            let target = self.executables.as_slice()[index];
            if mem::equal[char](target.name, name) {
                return ?target;
            }
            index += 1usize;
        }
        null
    }

    fn validate_executable_handle(&self, handle: ExecutableHandle) Error!void {
        if handle.index() >= self.executables.len() {
            return Error::InvalidTarget!;
        }
        !{}
    }

    fn report_unknown_step(&mut self, step: process::Arg) Error!void {
        var buffer: [256]u8 = [_]u8[0; 256];
        var stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print("unknown build step `{}`\n", &[&step]).as_build_error().?;
        stderr.flush().as_build_error()
    }

    fn add_step_record(&mut self, step: Step) Error!StepHandle {
        if step.name.len() == 0usize {
            return Error::InvalidStep!;
        }
        if let ?old = self.find_step(step.name) {
            _ = old;
            return Error::InvalidStep!;
        } else null {}
        let handle = StepHandle::init(self.steps.len());
        self.steps.push(self.allocator, step).as_build_error().?;
        !handle
    }
}

extend StepHandle {
    fn init(index: usize) StepHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend ExecutableHandle {
    fn init(index: usize) ExecutableHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend StepDependency {
    pub fn init(step: StepHandle, dependency: StepHandle) StepDependency {
        { step: step, dependency: dependency }
    }
}

extend CustomStep {
    fn init(run: StepFn) CustomStep {
        { run: run }
    }
}

extend ExecutableStep {
    fn init(target: ExecutableHandle) ExecutableStep {
        { target: target }
    }
}

extend Step {
    fn init(name: &[char], kind: StepKind, payload: StepPayload) Step {
        {
            name: name,
            kind: kind,
            payload: payload,
            state: StepState::Pending,
        }
    }

    fn custom(name: &[char], run: StepFn) Step {
        Step::init(name, StepKind::Custom, { custom: CustomStep::init(run) })
    }

    fn check_executable(name: &[char], target: ExecutableHandle) Step {
        Step::init(name, StepKind::CheckExecutable, { executable: ExecutableStep::init(target) })
    }

    fn emit_executable(name: &[char], target: ExecutableHandle) Step {
        Step::init(name, StepKind::EmitExecutable, { executable: ExecutableStep::init(target) })
    }
}

extend ExecutableTarget {
    pub fn init(name: &[char], source: fs::Path) ExecutableTarget {
        { name: name, source: source }
    }
}

fn is_valid_target_name(name: &[char]) bool {
    if name.len() == 0usize {
        return false;
    }
    var index = 0usize;
    while index < name.len() {
        let code = name[index] as u32;
        if code == 0u32 or code == 47u32 or code == 92u32 {
            return false;
        }
        index += 1usize;
    }
    true
}

fn arg_matches_text(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    var byte_index = 0usize;
    var char_index = 0usize;
    while char_index < text.len() {
        let encoded = text[char_index].encode_utf8();
        let encoded_bytes = encoded.bytes();
        var encoded_index = 0usize;
        while encoded_index < encoded_bytes.len() {
            if byte_index >= bytes.len() or bytes[byte_index] != encoded_bytes[encoded_index] {
                return false;
            }
            byte_index += 1usize;
            encoded_index += 1usize;
        }
        char_index += 1usize;
    }
    byte_index == bytes.len()
}
