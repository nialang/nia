extend OwnedCommandArgument {
    fn init(
        allocator: &mut mem::Allocator,
        argument: CommandArgument,
        index: usize,
    ) Error!OwnedCommandArgument {
        let value = string::StringBuf::from_slice(
            allocator,
            argument.value.text(),
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !{ kind: argument.kind, value: value }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        self.value.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index))
    }
}

extend OwnedCommandEnvironmentInput {
    fn init(
        allocator: &mut mem::Allocator,
        input: CommandEnvironmentInput,
        index: usize,
    ) Error!OwnedCommandEnvironmentInput {
        let mut name = string::StringBuf::from_slice(
            allocator,
            input.name.text(),
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        let mut nameTransferred = false;
        defer if not nameTransferred {
            name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)).?;
        };
        let value = string::StringBuf::from_slice(
            allocator,
            input.value.text(),
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        nameTransferred = true;
        !{ name: name, value: value }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(
            &mut firstError,
            self.value.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        rememberCleanupError(
            &mut firstError,
            self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        cleanupResult(firstError)
    }
}

extend ExternalCommandStep {
    fn init(
        allocator: &mut mem::Allocator,
        options: ExternalCommandOptions,
        index: usize,
    ) Error!ExternalCommandStep {
        let mut command: ExternalCommandStep = {
            program: string::StringBuf::init(),
            arguments: collections::ArrayList[OwnedCommandArgument]::init(),
            workingDirectory: fs::PathBuf::init(),
            resourceClass: options.resourceClass,
            environmentPolicy: options.environmentPolicy,
            cachePolicy: options.cachePolicy,
            environment: collections::ArrayList[OwnedCommandEnvironmentInput]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            command.deinit(allocator, index).?;
        };
        command.program = string::StringBuf::from_slice(
            allocator,
            options.program.text(),
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        command.workingDirectory = fs::PathBuf::from_path(
            allocator,
            options.workingDirectory,
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        switch options.arguments {
            ?arguments => {
                command.arguments = collections::ArrayList[OwnedCommandArgument]::init_capacity(
                    allocator,
                    arguments.len(),
                ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                for &argument in arguments.iter() {
                    let mut owned = OwnedCommandArgument::init(allocator, argument, index).?;
                    let mut argumentTransferred = false;
                    defer if not argumentTransferred {
                        owned.deinit(allocator, index).?;
                    };
                    command.arguments.push(allocator, owned).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    argumentTransferred = true;
                }
            },
            null => {},
        }
        switch options.environment {
            ?environment => {
                command.environment = collections::ArrayList[OwnedCommandEnvironmentInput]::init_capacity(
                    allocator,
                    environment.len(),
                ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                for &input in environment.iter() {
                    let mut owned = OwnedCommandEnvironmentInput::init(allocator, input, index).?;
                    let mut inputTransferred = false;
                    defer if not inputTransferred {
                        owned.deinit(allocator, index).?;
                    };
                    command.environment.push(allocator, owned).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    inputTransferred = true;
                }
            },
            null => {},
        }
        transferred = true;
        !command
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        let mut firstError: ?Error = null;
        let mut environmentIndex = self.environment.len();
        while environmentIndex != 0 {
            environmentIndex -= 1;
            rememberCleanupError(
                &mut firstError,
                self.environment.as_mut_slice()[environmentIndex].deinit(allocator, index),
            );
        }
        rememberCleanupError(
            &mut firstError,
            self.environment.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        let mut argumentIndex = self.arguments.len();
        while argumentIndex != 0 {
            argumentIndex -= 1;
            rememberCleanupError(
                &mut firstError,
                self.arguments.as_mut_slice()[argumentIndex].deinit(allocator, index),
            );
        }
        rememberCleanupError(
            &mut firstError,
            self.arguments.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        rememberCleanupError(
            &mut firstError,
            self.workingDirectory.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        rememberCleanupError(
            &mut firstError,
            self.program.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        cleanupResult(firstError)
    }
}

extend Step {
    fn init(
        allocator: &mut mem::Allocator,
        name: string::StringView,
        kind: StepKind,
        payload: StepPayload,
        index: usize,
    ) Error!Step {
        let ownedName = string::StringBuf::from_slice(allocator, name.text()).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !{
            index: index,
            name: ownedName,
            kind: kind,
            payload: payload,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        if self.kind == StepKind::Uncacheable {
            rememberCleanupError(&mut firstError, self.payload.uncacheable.deinit(allocator, self.index));
        }
        if self.kind == StepKind::GeneratedFile {
            rememberCleanupError(&mut firstError, self.payload.generatedFile.deinit(allocator, self.index));
        }
        if self.kind == StepKind::RunExecutable {
            rememberCleanupError(&mut firstError, self.payload.runExecutable.deinit(allocator, self.index));
        }
        if self.kind == StepKind::ExternalCommand {
            rememberCleanupError(&mut firstError, self.payload.externalCommand.deinit(allocator, self.index));
        }
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(self.index)));
        cleanupResult(firstError)
    }
}

fn validateRunArguments(arguments: ?&[string::StringView], index: usize) Error!void {
    switch arguments {
        ?values => {
            for &value in values.iter() {
                if runArgumentContainsNul(value.text()) {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Step(index),
                    }!;
                }
            }
        },
        null => {},
    }
    !{}
}

fn validateExternalCommand(options: ExternalCommandOptions, index: usize) Error!void {
    if options.program.text().len() == 0
        or runArgumentContainsNul(options.program.text())
        or not isValidPackagePath(options.workingDirectory.string(), true)
    {
        return invalidStep(index);
    }
    switch options.resourceClass {
        ActionResourceClass::Conservative => {},
        ActionResourceClass::Cpu => {},
        ActionResourceClass::Io => {},
        _ => return invalidStep(index),
    }
    switch options.environmentPolicy {
        CommandEnvironmentPolicy::Inherit => {},
        CommandEnvironmentPolicy::Clear => {},
        _ => return invalidStep(index),
    }
    switch options.cachePolicy {
        CommandCachePolicy::Uncacheable => {},
        CommandCachePolicy::DeclaredInputs => {
            if options.environmentPolicy != CommandEnvironmentPolicy::Clear {
                return invalidStep(index);
            }
        },
        _ => return invalidStep(index),
    }
    switch options.environment {
        ?environment => {
            let mut environmentIndex: usize = 0;
            while environmentIndex < environment.len() {
                let input = environment[environmentIndex];
                if environmentNameInvalid(input.name.text())
                    or runArgumentContainsNul(input.value.text())
                {
                    return invalidStep(index);
                }
                let mut priorIndex: usize = 0;
                while priorIndex < environmentIndex {
                    if mem::equal[char](environment[priorIndex].name.text(), input.name.text()) {
                        return invalidStep(index);
                    }
                    priorIndex += 1;
                }
                environmentIndex += 1;
            }
        },
        null => {},
    }
    let mut hasOutput = false;
    switch options.arguments {
        ?arguments => {
            for &argument in arguments.iter() {
                if runArgumentContainsNul(argument.value.text()) {
                    return invalidStep(index);
                }
                if argument.kind == CommandArgumentKind::PackageInput
                    and not isValidPackagePath(argument.value, false)
                {
                    return invalidStep(index);
                }
                if argument.kind == CommandArgumentKind::BuildInput
                    and not isValidBuildPath(argument.value)
                {
                    return invalidStep(index);
                }
                if argument.kind == CommandArgumentKind::BuildOutput {
                    if not isValidBuildPath(argument.value) {
                        return invalidStep(index);
                    }
                    hasOutput = true;
                }
            }
        },
        null => {},
    }
    if options.cachePolicy == CommandCachePolicy::DeclaredInputs and not hasOutput {
        return invalidStep(index);
    }
    !{}
}

fn invalidStep(index: usize) Error!void {
    Error::Invalid {
        operation: Operation::Validate,
        subject: Subject::Step(index),
    }!
}

fn isValidPackagePath(path: string::StringView, allowEmpty: bool) bool {
    if path.text().len() == 0 {
        return allowEmpty;
    }
    isValidBuildPath(path)
}

fn runArgumentContainsNul(text: &[char]) bool {
    for &ch in text.iter() {
        if ch == '\0' {
            return true;
        }
    }
    false
}

fn environmentNameInvalid(text: &[char]) bool {
    if text.len() == 0 {
        return true;
    }
    for &ch in text.iter() {
        if ch == '\0' or ch == '=' {
            return true;
        }
    }
    false
}

