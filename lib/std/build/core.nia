static mut nextBuildOwnerId: usize = 1;
static mut buildOwnerIdExhausted: usize = 0;

fn allocateBuildOwnerId() ?usize {
    if atomicBuiltin::atomic_load[usize](&buildOwnerIdExhausted, atomic::SeqCst) != 0 {
        return null;
    }
    let ownerId = atomicBuiltin::atomic_rmw[usize](
        &mut nextBuildOwnerId,
        atomic::Add,
        1,
        atomic::Monotonic,
    );
    if ownerId == 0 or ownerId == usize::MAX {
        atomicBuiltin::atomic_store[usize](&mut buildOwnerIdExhausted, 1, atomic::SeqCst);
        null
    } else {
        ?ownerId
    }
}

extend BuildPaths {
    fn init(
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
    ) Error!BuildPaths {
        let mut paths: BuildPaths = BuildPaths {
            packageRoot: fs::Path::init(),
            buildDir: fs::Path::init(),
            cacheDir: fs::Path::init(),
            toolchainExecutable: fs::Path::init(),
            toolchainResourceRoot: fs::Path::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            paths.deinit(allocator).?;
        };
        paths.packageRoot = fs::Path::fromView(allocator, packageRoot).asBuildError(Operation::Retain, Subject::PackageRoot).?;
        paths.buildDir = fs::Path::fromView(allocator, buildDir).asBuildError(Operation::Retain, Subject::BuildDir).?;
        paths.cacheDir = fs::Path::fromView(allocator, cacheDir).asBuildError(Operation::Retain, Subject::CacheDir).?;
        paths.toolchainExecutable = fs::Path::fromView(allocator, toolchainExecutable).asBuildError(Operation::Retain, Subject::ToolchainExecutable).?;
        paths.toolchainResourceRoot = fs::Path::fromView(allocator, toolchainResourceRoot).asBuildError(Operation::Retain, Subject::ToolchainResourceRoot).?;
        transferred = true;
        !paths
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.toolchainResourceRoot.deinit(allocator).asBuildError(Operation::Release, Subject::ToolchainResourceRoot));
        rememberCleanupError(&mut firstError, self.toolchainExecutable.deinit(allocator).asBuildError(Operation::Release, Subject::ToolchainExecutable));
        rememberCleanupError(&mut firstError, self.cacheDir.deinit(allocator).asBuildError(Operation::Release, Subject::CacheDir));
        rememberCleanupError(&mut firstError, self.buildDir.deinit(allocator).asBuildError(Operation::Release, Subject::BuildDir));
        rememberCleanupError(&mut firstError, self.packageRoot.deinit(allocator).asBuildError(Operation::Release, Subject::PackageRoot));
        cleanupResult(firstError)
    }
}

extend Build {
    // The generated runner supplies these values from the resolved toolchain
    // invocation. Ordinary build scripts receive the initialized value and do
    // not construct alternate roots, targets, or protocol versions.
    pub fn init(
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
        hostTarget: TargetView,
        artifactTarget: TargetView,
        defaultOptimization: OptimizationMode,
        planSchemaVersion: u32,
        requestedStep: ?&[char],
    ) Error!Build {
        let mut paths = BuildPaths::init(
            allocator,
            packageRoot,
            buildDir,
            cacheDir,
            toolchainExecutable,
            toolchainResourceRoot,
        ).?;
        let mut pathsTransferred = false;
        defer if not pathsTransferred {
            paths.deinit(allocator).?;
        };
        let mut ownedHostTarget = TargetStorage::init(allocator, hostTarget, Subject::HostTarget).?;
        let mut hostTargetTransferred = false;
        defer if not hostTargetTransferred {
            ownedHostTarget.deinit(allocator, Subject::HostTarget).?;
        };
        let mut ownedArtifactTarget = TargetStorage::init(allocator, artifactTarget, Subject::ArtifactTarget).?;
        let mut artifactTargetTransferred = false;
        defer if not artifactTargetTransferred {
            ownedArtifactTarget.deinit(allocator, Subject::ArtifactTarget).?;
        };
        let mut ownedRequestedStep = string::String::init();
        let mut hasRequestedStep = false;
        if requestedStep is ?step {
            ownedRequestedStep = string::String::fromSlice(allocator, step).asBuildError(
                Operation::Retain,
                Subject::RequestedStep,
            ).?;
            hasRequestedStep = true;
        }
        let mut requestedStepTransferred = false;
        defer if not requestedStepTransferred {
            ownedRequestedStep.deinit(allocator).asBuildError(
                Operation::Release,
                Subject::RequestedStep,
            ).?;
        };
        pathsTransferred = true;
        hostTargetTransferred = true;
        artifactTargetTransferred = true;
        requestedStepTransferred = true;
        let ownerId = match allocateBuildOwnerId() {
            ?value => value,
            null => return Error::Internal(Operation::Initialize)!,
        };
        !Self {
            ownerId: ownerId,
            allocator: allocator,
            paths: paths,
            hostTarget: ownedHostTarget,
            artifactTarget: ownedArtifactTarget,
            defaultOptimization: defaultOptimization,
            planSchemaVersion: planSchemaVersion,
            requestedStep: ownedRequestedStep,
            hasRequestedStep: hasRequestedStep,
            defaultStep: null,
            selectedStep: null,
            planValidated: false,
            steps: collections::ArrayList[Step]::init(),
            dependencies: collections::ArrayList[StepDependency]::init(),
            packages: collections::ArrayList[Package]::init(),
            modules: collections::ArrayList[Module]::init(),
            executables: collections::ArrayList[ExecutableTarget]::init(),
            objects: collections::ArrayList[ObjectTarget]::init(),
            staticArchives: collections::ArrayList[StaticArchiveTarget]::init(),
        }
    }

    pub fn deinit(&mut self) Error!() {
        let mut firstError: ?Error = null;
        let mut elementError: ?Error = null;
        let mut index = self.steps.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut elementError, self.steps.asMutSlice()[index].deinit(self.allocator));
        }
        if elementError is null {
            rememberCleanupError(&mut firstError, self.steps.deinit(self.allocator).asBuildError(Operation::Release, Subject::Steps));
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        rememberCleanupError(&mut firstError, self.dependencies.deinit(self.allocator).asBuildError(Operation::Release, Subject::Dependencies));
        elementError = null;
        index = self.packages.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut elementError, self.packages.asMutSlice()[index].deinit(self.allocator));
        }
        if elementError is null {
            rememberCleanupError(&mut firstError, self.packages.deinit(self.allocator).asBuildError(Operation::Release, Subject::Packages));
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        elementError = null;
        index = self.executables.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut elementError, self.executables.asMutSlice()[index].deinit(self.allocator));
        }
        if elementError is null {
            rememberCleanupError(&mut firstError, self.executables.deinit(self.allocator).asBuildError(Operation::Release, Subject::Executables));
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        elementError = null;
        index = self.objects.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut elementError, self.objects.asMutSlice()[index].deinit(self.allocator));
        }
        if elementError is null {
            rememberCleanupError(&mut firstError, self.objects.deinit(self.allocator).asBuildError(Operation::Release, Subject::Objects));
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        elementError = null;
        index = self.staticArchives.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut elementError, self.staticArchives.asMutSlice()[index].deinit(self.allocator));
        }
        if elementError is null {
            rememberCleanupError(&mut firstError, self.staticArchives.deinit(self.allocator).asBuildError(Operation::Release, Subject::StaticArchives));
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        elementError = null;
        index = self.modules.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut elementError, self.modules.asMutSlice()[index].deinit(self.allocator));
        }
        if elementError is null {
            rememberCleanupError(&mut firstError, self.modules.deinit(self.allocator).asBuildError(Operation::Release, Subject::Modules));
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        rememberCleanupError(&mut firstError, self.artifactTarget.deinit(self.allocator, Subject::ArtifactTarget));
        rememberCleanupError(&mut firstError, self.hostTarget.deinit(self.allocator, Subject::HostTarget));
        rememberCleanupError(
            &mut firstError,
            self.requestedStep.deinit(self.allocator).asBuildError(
                Operation::Release,
                Subject::RequestedStep,
            ),
        );
        rememberCleanupError(&mut firstError, self.paths.deinit(self.allocator));
        cleanupResult(firstError)
    }

    pub fn packageRoot(&self) fs::PathView {
        self.paths.packageRoot.view()
    }

    pub fn rootPackage(&self) PackageHandle {
        PackageHandle::init(self.ownerId, 0)
    }

    pub fn addPackage(&mut self, options: PackageOptions) Error!PackageHandle {
        let packageIndex = match self.packages.len().checked_add(1) {
            ?value => value,
            null => return Error::Failure {
                operation: Operation::Retain,
                subject: Subject::Packages,
                cause: error::ErrorCause::Memory(mem::Error::OutOfMemory),
            }!,
        };
        let handle = PackageHandle::init(self.ownerId, packageIndex);
        if options.name.equals(&"root")
            or not isValidStableName(options.name)
            or not isValidPackagePath(options.root.text(), false)
        {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Package(handle.index()),
            }!;
        }
        for &package in self.packages.iter() {
            if package.name.equals(options.name) or package.root.view().text().equals(options.root.text()) {
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Package(handle.index()),
                }!;
            }
        }
        let mut package = Package::init(self.allocator, options, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            package.deinit(self.allocator).?;
        };
        self.packages.push(self.allocator, package).asBuildError(Operation::Retain, Subject::Packages).?;
        transferred = true;
        self.planValidated = false;
        !handle
    }

    pub fn buildDir(&self) fs::PathView {
        self.paths.buildDir.view()
    }

    pub fn cacheDir(&self) fs::PathView {
        self.paths.cacheDir.view()
    }

    pub fn toolchainExecutable(&self) fs::PathView {
        self.paths.toolchainExecutable.view()
    }

    pub fn toolchainResourceRoot(&self) fs::PathView {
        self.paths.toolchainResourceRoot.view()
    }

    pub fn hostTarget(&self) TargetView {
        self.hostTarget.view()
    }

    pub fn artifactTarget(&self) TargetView {
        self.artifactTarget.view()
    }

    // Steps declare graph work only. Execution, process ownership, output
    // publication, caching, and cancellation belong to the Rust coordinator.
    pub fn addAggregateStep(&mut self, name: &[char]) Error!StepHandle {
        self.addStepRecord(name, StepKind::Aggregate, StepPayload { aggregate: AggregateStep::init() })
    }

    pub fn addUncacheableStep(&mut self, name: &[char], description: &[char]) Error!StepHandle {
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut payload = UncacheableStep::init(self.allocator, description, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(name, StepKind::Uncacheable, StepPayload { uncacheable: payload }).?;
        transferred = true;
        !result
    }

    pub fn addGeneratedFileStep(&mut self, name: &[char], output: BuildPathView, contents: &[u8]) Error!StepHandle {
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        if not output.isValid() or contents.len() > 67108864 {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(handle.index()),
            }!;
        }
        let mut payload = GeneratedFileStep::init(self.allocator, output, contents, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(name, StepKind::GeneratedFile, StepPayload { generatedFile: payload }).?;
        transferred = true;
        !result
    }

    pub fn addCheckExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        self.addStepRecord(name, StepKind::CheckExecutable, StepPayload { executable: ExecutableStep::init(target) })
    }

    pub fn addEmitExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        let archiveCount = self.executables.asSlice()[target.index()].staticArchives.len();
        self.dependencies.reserve(
            self.allocator,
            archiveCount,
        ).asBuildError(Operation::Retain, Subject::Dependencies).?;
        let mut archiveIndex: usize = 0;
        while archiveIndex < archiveCount {
            let archive = self.executables.asSlice()[target.index()]
                .staticArchives.asSlice()[archiveIndex];
            match self.findEmitStaticArchiveStep(archive) {
                ?producer => _ = producer,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(self.steps.len()),
                }!,
            }
            archiveIndex += 1;
        }
        let result = self.addStepRecord(
            name,
            StepKind::EmitExecutable,
            StepPayload { executable: ExecutableStep::init(target) },
        ).?;
        let dependencyStart = self.dependencies.len();
        let mut committed = false;
        defer if not committed {
            while self.dependencies.len() > dependencyStart {
                _ = self.dependencies.pop();
            }
            self.rollbackLastStep().?;
        };
        archiveIndex = 0;
        while archiveIndex < archiveCount {
            let archive = self.executables.asSlice()[target.index()]
                .staticArchives.asSlice()[archiveIndex];
            let producer = match self.findEmitStaticArchiveStep(archive) {
                ?producer => producer,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(result.index()),
                }!,
            };
            self.dependOn(result, producer).?;
            archiveIndex += 1;
        }
        committed = true;
        !result
    }

    pub fn addEmitObjectStep(&mut self, name: &[char], target: ObjectHandle) Error!StepHandle {
        self.validateObjectHandle(target).?;
        self.addStepRecord(name, StepKind::EmitObject, StepPayload { object: ObjectStep::init(target) })
    }

    pub fn addEmitStaticArchiveStep(&mut self, name: &[char], target: StaticArchiveHandle) Error!StepHandle {
        self.validateStaticArchiveHandle(target).?;
        self.addStepRecord(name, StepKind::EmitStaticArchive, StepPayload { staticArchive: StaticArchiveStep::init(target) })
    }

    pub fn addRunExecutableStep(&mut self, name: &[char], options: RunOptions) Error!StepHandle {
        self.validateExecutableHandle(options.target).?;
        let producer = match self.findEmitStep(options.target) {
            ?producer => producer,
            null => return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!,
        };
        self.validateRunnableExecutable(options.target, self.steps.len()).?;
        validateRunArguments(options.arguments, self.steps.len()).?;
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        let mut payload = RunExecutableStep::init(self.allocator, options, handle.index()).?;
        let mut transferred = false;
        defer if not transferred {
            payload.deinit(self.allocator, handle.index()).?;
        };
        let result = self.addStepRecord(name, StepKind::RunExecutable, StepPayload { runExecutable: payload }).?;
        transferred = true;
        let mut committed = false;
        defer if not committed {
            self.rollbackLastStep().?;
        };
        self.dependOn(result, producer).?;
        committed = true;
        !result
    }

    pub fn addTestExecutableStep(&mut self, name: &[char], options: RunOptions) Error!StepHandle {
        self.validateExecutableHandle(options.target).?;
        let producer = match self.findEmitStep(options.target) {
