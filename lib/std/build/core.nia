// Package and module declarations plus complete build-graph validation.
//
// Insertions reserve the record list before initializing a Build-owned pending
// package or module. Partial owners remain reachable if initialization or
// cleanup fails, so retries and `Build::deinit` can release every field without
// replacing the primary error. Module records retain all import names and
// paths in allocator-owned storage.
//
// Graph validation stores indegrees and the ready queue on `Build`. Both
// scratch owners are released after every pass; a validation error remains
// primary, and failed releases can be retried by the next pass or deinit.

using root::collections;
using root::fs;
using root::mem;
using root::string;
using root::build::error;
using root::error::CleanupAccumulator;
using root::build::artifacts;
using root::build::dependencies::{findGeneratedSourceProducer, hasDependency};
using root::build::diagnostics::{reportBuildError, reportUnknownBuildStep};
using root::build::handles;
using root::build::modules::validateModuleImports;
using root::build::paths::{isValidBuildPath, isValidPackagePath};
using root::build::queries::{
    findExecutable as findExecutableRecord,
    findModule as findModuleRecord,
    findStep as findStepRecord,
};
using root::build::step_registration;
using root::build::targets::isValidStableName;
using root::build::types;
using root::build::validation::{
    validatePackageHandle as validatePackageHandleValue,
};

using error::Error;
using error::ErrorOperation as Operation;
using error::ErrorSubject as Subject;
using types::{
    Build,
    StepHandle,
    RunOptions,
    Module,
    ModuleSourceRoot,
    ModuleHandle,
    ModuleOptions,
    ExecutableHandle,
    PackageHandle,
    PackageOptions,
    ExecutableOptions,
    ExecutableTarget,
};

extend Build {
    pub fun packageRoot(&self) fs::PathView {
        self.paths.packageRoot.view()
    }

    pub fun rootPackage(&self) PackageHandle {
        .init(self.ownerId, 0)
    }

    pub fun addPackage(&mut self, options: PackageOptions) Error!PackageHandle {
        self.cleanupPendingPackage().?;
        let packageIndex = match self.packages.len().checkedAdd(1) {
            ?value => value,
            null => return .Failure {
                operation: Operation::Retain,
                subject: Subject::Packages,
                cause: .Memory(.OutOfMemory),
            }!,
        };
        let handle = PackageHandle::init(self.ownerId, packageIndex);
        if options.name.equals(&"root")
            or not isValidStableName(options.name)
            or (not options.manifestDependency and not isValidPackagePath(options.path.text(), false))
        {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Package(handle.index()),
            }!;
        }
        for &package in self.packages.iter() {
            if package.name.equals(options.name)
                or (not package.manifestDependency
                    and not options.manifestDependency
                    and package.path.view().text().equals(options.path.text()))
            {
                return .Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Package(handle.index()),
                }!;
            }
        }
        self.packages.reserve(self.allocator, 1).withBuildContext(Operation::Retain, Subject::Packages).?;
        self.pendingPackage = .init(handle.index());
        self.hasPendingPackage = true;
        if self.pendingPackage.initialize(self.allocator, options) is primary! {
            _ = self.cleanupPendingPackage();
            return primary!;
        }
        self.packages.appendAssumeCapacity(self.pendingPackage);
        self.hasPendingPackage = false;
        self.planValidated = false;
        !handle
    }

    // Resolves an already declared package dependency by its manifest name.
    // The host resolves this marker against the root manifest and selected
    // checkout; build scripts never provide dependency filesystem paths.
    pub fun addDependency(&mut self, name: &[char]) Error!PackageHandle {
        self.addPackage(PackageOptions::dependency(name))
    }

    pub(root) fun cleanupPendingPackage(&mut self) Error!() {
        if not self.hasPendingPackage {
            return !();
        }
        self.pendingPackage.deinit(self.allocator).?;
        self.hasPendingPackage = false;
        !()
    }

    pub fun buildDir(&self) fs::PathView {
        self.paths.buildDir.view()
    }

    pub fun cacheDir(&self) fs::PathView {
        self.paths.cacheDir.view()
    }

    pub fun toolchainExecutable(&self) fs::PathView {
        self.paths.toolchainExecutable.view()
    }

    pub fun toolchainResourceRoot(&self) fs::PathView {
        self.paths.toolchainResourceRoot.view()
    }

    // Modules and artifacts retain borrowed descriptors as owned plan records.
    // Build-rooted source paths are generated inputs and gain producer edges
    // during complete-graph validation.
    pub fun addModule(&mut self, options: ModuleOptions) Error!ModuleHandle {
        self.cleanupPendingModule().?;
        let handle = ModuleHandle::init(self.ownerId, self.modules.len());

        if options.sourceRoot is (.Package) {
            if options.package is ?package {
                validatePackageHandleValue(self.ownerId, self.packages.len(), package).?;
            }
        }
        if options.imports is ?imports {
            for &import in imports.iter() {
                if import.sourceRoot is (.Package) {
                    if import.package is ?package {
                        validatePackageHandleValue(self.ownerId, self.packages.len(), package).?;
                    }
                }
            }
        }
        validateModuleImports(options.imports).?;

        if options.sourceRoot == ModuleSourceRoot::Build
            and not isValidBuildPath(options.rootSource.text())
        {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        if not isValidStableName(options.name) {
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        if findModuleRecord(self.modules.asSlice(), options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Module(handle.index()),
            }!;
        }
        let optimization = match options.optimization {
            ?optimization => optimization,
            null => self.defaultOptimization,
        };
        self.modules.reserve(self.allocator, 1).withBuildContext(Operation::Retain, Subject::Modules).?;
        self.pendingModule = .init(
            handle.index(),
            options.sourceRoot,
            match options.package {
                ?package => package,
                null => .init(self.ownerId, 0),
            },
            optimization,
        );
        self.hasPendingModule = true;
        if self.pendingModule.initialize(
            self.allocator,
            options.name,
            options.rootSource,
            options.imports,
            self.ownerId,
        ) is primary! {
            _ = self.cleanupPendingModule();
            return primary!;
        }
        self.modules.appendAssumeCapacity(self.pendingModule);
        self.hasPendingModule = false;
        self.planValidated = false;
        !handle
    }

    pub(root) fun cleanupPendingModule(&mut self) Error!() {
        if not self.hasPendingModule {
            return !();
        }
        self.pendingModule.deinit(self.allocator).?;
        self.hasPendingModule = false;
        !()
    }

    pub fun requestedStep(&self) ?&[char] {
        if self.hasRequestedStep {
            ?self.requestedStep.text()
        } else {
            null
        }
    }

    pub fun validatePlan(&mut self) Error!() {
        if self.planValidated {
            return !();
        }
        self.selectedStep = null;
        if self.requestedStep() is ?step {
            if findStepRecord(self.steps.asSlice(), step) is ?selected {
                self.selectedStep = ?.init(self.ownerId, selected.index);
            } else {
                reportUnknownBuildStep(step).?;
                return .UnknownStep!;
            }
        } else if self.listSteps {
            // Listing runs nothing.
        } else if self.defaultStep is ?handle {
            self.selectedStep = ?handle;
        } else if self.steps.len() != 0 {
            return .MissingDefaultStep!;
        }
        self.ensureGeneratedModuleDependencies().?;
        self.validateDependencyGraph().?;
        self.planValidated = true;
        !()
    }

    fun ensureGeneratedModuleDependencies(&mut self) Error!() {
        let mut missingCount: usize = 0;
        let mut index: usize = 0;
        while index < self.steps.len() {
            let missing = self.missingGeneratedDependenciesForStep(index).?;
            missingCount = match missingCount.checkedAdd(missing) {
                ?value => value,
                null => return .Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Dependencies,
                }!,
            };
            index += 1;
        }
        self.dependencies.reserve(
            self.allocator,
            missingCount,
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        index = 0;
        while index < self.steps.len() {
            self.addGeneratedDependenciesForStep(index).?;
            index += 1;
        }
        !()
    }

    fun compilerModuleIndexForStep(&self, index: usize) ?usize {
        let step = self.steps.asSlice()[index];
        match step.kind {
            .CheckExecutable => ?self.executables.asSlice()[
                step.payload.executable.target.index()
            ].rootModule.index(),
            .EmitExecutable => ?self.executables.asSlice()[
                step.payload.executable.target.index()
            ].rootModule.index(),
            .EmitObject => ?self.objects.asSlice()[
                step.payload.object.target.index()
            ].rootModule.index(),
            .EmitStaticArchive => ?self.staticArchives.asSlice()[
                step.payload.staticArchive.target.index()
            ].rootModule.index(),
            .TestExecutable => ?self.executables.asSlice()[
                step.payload.runExecutable.target.index()
            ].rootModule.index(),
            _ => null,
        }
    }

    fun missingGeneratedDependenciesForStep(&self, index: usize) Error!usize {
        let moduleIndex = match self.compilerModuleIndexForStep(index) {
            ?moduleIndex => moduleIndex,
            null => return !0,
        };
        let moduleRecord = self.modules.asSlice()[moduleIndex];
        let mut count: usize = 0;
        if moduleRecord.sourceRoot is (.Build) {
            let producer = self.requireGeneratedSourceProducer(
                moduleRecord.rootSource.text(),
                index,
                moduleIndex,
            ).?;
            if not hasDependency(self.dependencies.asSlice(), index, producer.index()) {
                count = match count.checkedAdd(1) {
                    ?value => value,
                    null => return .Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Dependencies,
                    }!,
                };
            }
        }
        for &import in moduleRecord.imports.iter() {
            if import.sourceRoot is (.Build) {
                let producer = self.requireGeneratedSourceProducer(
                    import.path.text(),
                    index,
                    moduleIndex,
                ).?;
                if not hasDependency(self.dependencies.asSlice(), index, producer.index()) {
                    count = match count.checkedAdd(1) {
                        ?value => value,
                        null => return .Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Dependencies,
                        }!,
                    };
                }
            }
        }
        !count
    }

    fun addGeneratedDependenciesForStep(&mut self, index: usize) Error!() {
        let moduleIndex = match self.compilerModuleIndexForStep(index) {
            ?moduleIndex => moduleIndex,
            null => return !(),
        };
        let moduleRecord = self.modules.asSlice()[moduleIndex];
        if moduleRecord.sourceRoot is (.Build) {
            let producer = self.requireGeneratedSourceProducer(
                moduleRecord.rootSource.text(),
                index,
                moduleIndex,
            ).?;
            self.dependOn(.init(self.ownerId, index), producer).?;
        }
        let mut importIndex: usize = 0;
        while importIndex < moduleRecord.imports.len() {
            let import = moduleRecord.imports.asSlice()[importIndex];
            if import.sourceRoot is (.Build) {
                let producer = self.requireGeneratedSourceProducer(
                    import.path.text(),
                    index,
                    moduleIndex,
                ).?;
                self.dependOn(.init(self.ownerId, index), producer).?;
            }
            importIndex += 1;
        }
        !()
    }

    fun requireGeneratedSourceProducer(
        &self,
        path: &[char],
        consumerIndex: usize,
        moduleIndex: usize,
    ) Error!StepHandle {
        if findGeneratedSourceProducer(self.ownerId, self.steps.asSlice(), path, consumerIndex) is ?producer {
            !producer
        } else {
            .Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(moduleIndex),
            }!
        }
    }

    fun validateDependencyGraph(&mut self) Error!() {
        self.cleanupValidationScratch().?;
        let operation = self.validateDependencyGraphWithScratch();
        let cleanup = self.cleanupValidationScratch();
        operation.cleanupAfter(cleanup)
    }

    fun validateDependencyGraphWithScratch(&mut self) Error!() {
        self.validationIndegree = collections::ArrayList[usize]::initCapacity(
            self.allocator,
            self.steps.len(),
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        let mut index: usize = 0;
        while index < self.steps.len() {
            self.validationIndegree.push(self.allocator, 0).withBuildContext(Operation::Retain, Subject::Dependencies).?;
            index += 1;
        }
        for &edge in self.dependencies.iter() {
            let slot = &mut self.validationIndegree.asMutSlice()[edge.step.index()];
            slot.* = match slot.*.checkedAdd(1) {
                ?value => value,
                null => return .Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Dependencies,
                }!,
            };
        }

        self.validationReady = collections::ArrayList[usize]::initCapacity(
            self.allocator,
            self.steps.len(),
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        index = 0;
        while index < self.validationIndegree.len() {
            if self.validationIndegree.asSlice()[index] == 0 {
                self.validationReady.push(self.allocator, index).withBuildContext(Operation::Retain, Subject::Dependencies).?;
            }
            index += 1;
        }

        let mut cursor: usize = 0;
        while cursor < self.validationReady.len() {
            let completed = self.validationReady.asSlice()[cursor];
            cursor += 1;
            for &edge in self.dependencies.iter() {
                if edge.dependency.index() == completed {
                    let dependent = edge.step.index();
                    self.validationIndegree.asMutSlice()[dependent] -= 1;
                    if self.validationIndegree.asSlice()[dependent] == 0 {
                        self.validationReady.push(self.allocator, dependent).withBuildContext(Operation::Retain, Subject::Dependencies).?;
                    }
                }
            }
        }
        if cursor != self.steps.len() {
            for &edge in self.dependencies.iter() {
                if self.validationIndegree.asSlice()[edge.step.index()] != 0
                    and self.validationIndegree.asSlice()[edge.dependency.index()] != 0
                {
                    return .StepCycle {
                        step: edge.step.index(),
                        dependency: edge.dependency.index(),
                    }!;
                }
            }
            return .Invalid {
                operation: Operation::Validate,
                subject: Subject::Dependencies,
            }!;
        }
        !()
    }

    fun cleanupValidationScratch(&mut self) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.validationReady.deinit(self.allocator).withBuildContext(
            Operation::Release,
            Subject::Dependencies,
        ));
        cleanup.attempt(self.validationIndegree.deinit(self.allocator).withBuildContext(
            Operation::Release,
            Subject::Dependencies,
        ));
        cleanup.finish()
    }

    pub fun reportError(&mut self, error: Error) Error!() {
        reportBuildError(error)
    }

    // An `[[executable]]` from nia.toml: an emit step named after it and a
    // `run-<name>` step. Only the build runner calls this, before build.nia.
    pub fun declareManifestExecutable(
        &mut self,
        name: &[char],
        rootSource: fs::PathView,
        runtime: types::Runtime,
    ) Error!() {
        let rootModule = self.addModule(ModuleOptions::init(name, rootSource)).?;
        let executable = self.addExecutable(ExecutableOptions::init(name, rootModule).withRuntime(runtime)).?;
        let emit = self.addEmitExecutableStep(name, executable).?;
        let mut runName = string::String::fromSlice(self.allocator, &"run-")
            .withBuildContext(Operation::Retain, Subject::Step(self.steps.len())).?;
        let result = self.declareManifestRun(&mut runName, name, executable);
        let cleanup = runName.deinit(self.allocator)
            .withBuildContext(Operation::Release, Subject::Step(self.steps.len()));
        result.cleanupAfter(cleanup).?;
        self.addToAllStep(emit)
    }

    fun declareManifestRun(
        &mut self,
        runName: &mut string::String,
        name: &[char],
        executable: ExecutableHandle,
    ) Error!() {
        runName.append(self.allocator, name)
            .withBuildContext(Operation::Retain, Subject::Step(self.steps.len())).?;
        _ = self.addRunExecutableStep(runName.text(), RunOptions::init(executable)).?;
        !()
    }

    // A `[[test]]` from nia.toml: a suite like `addTestSuite`.
    pub fun declareManifestTest(
        &mut self,
        name: &[char],
        rootSource: fs::PathView,
        runtime: types::Runtime,
    ) Error!() {
        let rootModule = self.addModule(ModuleOptions::init(name, rootSource)).?;
        let suite = self.addTestSuiteWithRuntime(name, rootModule, runtime).?;
        self.addToAllStep(suite)
    }

    // `all` builds every manifest executable and runs every suite; it is the
    // default step until build.nia chooses another.
    fun addToAllStep(&mut self, step: StepHandle) Error!() {
        let all = if self.allStep is ?existing {
            existing
        } else {
            let created = self.addAggregateStep(&"all").?;
            self.allStep = ?created;
            self.defaultStep = ?created;
            created
        };
        self.dependOn(all, step)
    }

    // The handle of an artifact nia.toml declares, for use in build.nia.
    pub fun executable(&self, name: &[char]) Error!ExecutableHandle {
        if findExecutableRecord(self.executables.asSlice(), name) is ?target {
            return !ExecutableHandle::init(self.ownerId, target.index);
        }
        .Invalid { operation: Operation::Validate, subject: Subject::Executables }!
    }

    // The handle of a declared step, such as `test`, `all`, or `run-<name>`.
    pub fun step(&self, name: &[char]) Error!StepHandle {
        if findStepRecord(self.steps.asSlice(), name) is ?step {
            return !StepHandle::init(self.ownerId, step.index);
        }
        .Invalid { operation: Operation::Validate, subject: Subject::Steps }!
    }

}
