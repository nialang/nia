}

extend PackageHandle {
    pub(pkg) fn init(ownerId: usize, index: usize) PackageHandle {
        { ownerId: ownerId, index: index }
    }

    pub(pkg) fn ownerId(&self) usize {
        self.ownerId
    }

    pub(pkg) fn index(&self) usize {
        self.index
    }
}

extend PackageOptions {
    pub fn init(name: &[char], root: fs::PathView) PackageOptions {
        { name: name, root: root }
    }
}

extend Package {
    fn init(allocator: &mut mem::Allocator, options: PackageOptions, index: usize) Error!Package {
        let mut package: Package = {
            index: index,
            name: string::String::init(),
            root: fs::PathBuf::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            package.deinit(allocator).?;
        };
        package.name = string::String::fromSlice(allocator, options.name).asBuildError(Operation::Retain, Subject::Package(index)).?;
        package.root = fs::PathBuf::fromView(allocator, options.root).asBuildError(Operation::Retain, Subject::Package(index)).?;
        transferred = true;
        !package
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.root.deinit(allocator).asBuildError(Operation::Release, Subject::Package(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Package(self.index)));
        cleanupResult(firstError)
    }
}

extend Module {
    fn init(
        allocator: &mut mem::Allocator,
        options: ModuleOptions,
        optimization: OptimizationMode,
        index: usize,
    ) Error!Module {
        let mut moduleRecord: Module = {
            index: index,
            name: string::String::init(),
            sourceRoot: options.sourceRoot,
            rootSource: fs::PathBuf::init(),
            optimization: optimization,
            imports: collections::ArrayList[OwnedModuleImport]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            moduleRecord.deinit(allocator).?;
        };
        moduleRecord.name = string::String::fromSlice(allocator, options.name).asBuildError(Operation::Retain, Subject::Module(index)).?;
        moduleRecord.rootSource = fs::PathBuf::fromView(allocator, options.rootSource).asBuildError(Operation::Retain, Subject::Module(index)).?;
        moduleRecord.imports = cloneModuleImports(allocator, options.imports).?;
        transferred = true;
        !moduleRecord
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        let mut index = self.imports.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut firstError, self.imports.asMutSlice()[index].deinit(allocator));
        }
        rememberCleanupError(&mut firstError, self.imports.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        rememberCleanupError(&mut firstError, self.rootSource.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        cleanupResult(firstError)
    }
}

extend ModuleImport {
    pub fn init(name: &[char], path: fs::PathView) ModuleImport {
        {
            name: name,
            sourceRoot: ModuleSourceRoot::Package,
            path: path,
        }
    }

    pub fn fromBuild(name: &[char], path: BuildPathView) ModuleImport {
        {
            name: name,
            sourceRoot: ModuleSourceRoot::Build,
            path: fs::PathView::init(path.text()),
        }
    }
}

extend OwnedModuleImport {
    fn init(allocator: &mut mem::Allocator, import: ModuleImport, index: usize) Error!OwnedModuleImport {
        let mut owned: OwnedModuleImport = {
            index: index,
            name: string::String::init(),
            sourceRoot: import.sourceRoot,
            path: fs::PathBuf::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator).?;
        };
        owned.name = string::String::fromSlice(allocator, import.name).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        owned.path = fs::PathBuf::fromView(allocator, import.path).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        transferred = true;
        !owned
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.path.deinit(allocator).asBuildError(Operation::Release, Subject::ModuleImport(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::ModuleImport(self.index)));
        cleanupResult(firstError)
    }
}

extend ExecutableTarget {
    pub fn init(
        allocator: &mut mem::Allocator,
        options: ExecutableOptions,
        outputName: &[char],
        index: usize,
    ) Error!ExecutableTarget {
        let mut target: ExecutableTarget = {
            index: index,
            name: string::String::init(),
            rootModule: options.rootModule,
            outputName: string::String::init(),
            targetRole: TargetRole::Artifact,
        };
        let mut transferred = false;
        defer if not transferred {
            target.deinit(allocator).?;
        };
        target.name = string::String::fromSlice(allocator, options.name).asBuildError(Operation::Retain, Subject::Executable(index)).?;
        target.outputName = string::String::fromSlice(allocator, outputName).asBuildError(Operation::Retain, Subject::Executable(index)).?;
        transferred = true;
        !target
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.outputName.deinit(allocator).asBuildError(Operation::Release, Subject::Executable(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Executable(self.index)));
        cleanupResult(firstError)
    }
}

extend TargetView {
    pub fn init(
        arch: &[char],
        vendor: &[char],
        os: &[char],
        env: &[char],
        abi: &[char],
        endian: &[char],
        pointerWidth: u32,
    ) TargetView {
        {
            arch: arch,
            vendor: vendor,
            os: os,
            env: env,
            abi: abi,
            endian: endian,
            pointerWidth: pointerWidth,
        }
    }

    pub fn arch(&self) &[char] {
        self.arch
    }

    pub fn vendor(&self) &[char] {
        self.vendor
    }

    pub fn os(&self) &[char] {
        self.os
    }

    pub fn env(&self) &[char] {
        self.env
    }

    pub fn abi(&self) &[char] {
        self.abi
    }

    pub fn endian(&self) &[char] {
        self.endian
    }

    pub fn pointerWidth(&self) u32 {
        self.pointerWidth
    }

    pub fn equals(&self, other: TargetView) bool {
        self.arch.equals(other.arch)
            and self.vendor.equals(other.vendor)
            and self.os.equals(other.os)
            and self.env.equals(other.env)
            and self.abi.equals(other.abi)
            and self.endian.equals(other.endian)
            and self.pointerWidth == other.pointerWidth
    }
}

extend TargetStorage {
    fn init(
        allocator: &mut mem::Allocator,
        target: TargetView,
        subject: Subject,
    ) Error!TargetStorage {
        let mut owned: TargetStorage = {
            arch: string::String::init(),
            vendor: string::String::init(),
            os: string::String::init(),
            env: string::String::init(),
            abi: string::String::init(),
            endian: string::String::init(),
            pointerWidth: target.pointerWidth,
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator, subject).?;
        };
        owned.arch = string::String::fromSlice(allocator, target.arch).asBuildError(Operation::Retain, subject).?;
        owned.vendor = string::String::fromSlice(allocator, target.vendor).asBuildError(Operation::Retain, subject).?;
        owned.os = string::String::fromSlice(allocator, target.os).asBuildError(Operation::Retain, subject).?;
        owned.env = string::String::fromSlice(allocator, target.env).asBuildError(Operation::Retain, subject).?;
        owned.abi = string::String::fromSlice(allocator, target.abi).asBuildError(Operation::Retain, subject).?;
        owned.endian = string::String::fromSlice(allocator, target.endian).asBuildError(Operation::Retain, subject).?;
        transferred = true;
        !owned
    }

    fn view(&self) TargetView {
        TargetView::init(
            self.arch.text(),
            self.vendor.text(),
            self.os.text(),
            self.env.text(),
            self.abi.text(),
            self.endian.text(),
            self.pointerWidth,
        )
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, subject: Subject) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.endian.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.abi.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.env.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.os.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.vendor.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.arch.deinit(allocator).asBuildError(Operation::Release, subject));
        cleanupResult(firstError)
    }
}

extend ExecutableOptions {
    pub fn init(name: &[char], rootModule: ModuleHandle) ExecutableOptions {
        {
            name: name,
            rootModule: rootModule,
            outputName: null,
        }
    }

    pub fn withOutputName(self, outputName: &[char]) ExecutableOptions {
        {
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?outputName,
        }
    }
}

fn executableOutputName(options: ExecutableOptions) &[char] {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

extend OptimizationMode {
    fn argv(self) &u8 {
        static o0 = b"-O0\0";
        static o1 = b"-O1\0";
        static o2 = b"-O2\0";
        static o3 = b"-O3\0";
        static os = b"-Os\0";
        static oz = b"-Oz\0";
        switch self {
            OptimizationMode::O0 => &o0[0],
            OptimizationMode::O1 => &o1[0],
            OptimizationMode::O2 => &o2[0],
            OptimizationMode::O3 => &o3[0],
            OptimizationMode::Os => &os[0],
            OptimizationMode::Oz => &oz[0],
            _ => &o2[0],
        }
    }
}

fn isValidStableName(name: &[char]) bool {
    if name.len() == 0 {
        return false;
    }
    for &ch in name.iter() {
        let code = ch as u32;
        let valid = (code >= 48 and code <= 57)
            or (code >= 65 and code <= 90)
            or (code >= 97 and code <= 122)
            or code == 45
            or code == 46
            or code == 95;
        if not valid {
            return false;
        }
    }
    true
}

fn isValidOutputName(name: &[char]) bool {
    if name.len() == 0 {
        return false;
    }
    for &ch in name.iter() {
        let code = ch as u32;
        if code == 0 or code == 47 or code == 92 {
            return false;
        }
    }
    true
}

fn isValidBuildPath(text: &[char]) bool {
    if text.len() == 0 or text[0] == '/' or text[text.len() - 1] == '/' {
        return false;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index <= text.len() {
        if index == text.len() or text[index] == '/' {
            let componentLen = index - componentStart;
            if componentLen == 0
                or (componentLen == 1 and text[componentStart] == '.')
                or (componentLen == 2
                    and text[componentStart] == '.'
                    and text[componentStart + 1] == '.')
            {
                return false;
            }
            componentStart = index + 1;
        } else if text[index] == '\\' or text[index] == '\0' {
            return false;
        }
        index += 1;
    }
    true
}

fn validateModuleImports(imports: ?&[ModuleImport]) Error!void {
    switch imports {
        ?items => {
            let mut index: usize = 0;
            for &import in items.iter() {
                if not isValidModuleImportName(import.name) {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::ModuleImport(index),
                    }!;
                }
                if import.sourceRoot == ModuleSourceRoot::Build
                    and not isValidBuildPath(import.path.text())
                {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::ModuleImport(index),
                    }!;
                }
                let mut oldIndex: usize = 0;
                while oldIndex < index {
                    if items[oldIndex].name.equals(import.name) {
                        return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::ModuleImport(index),
                        }!;
                    }
                    oldIndex += 1;
                }
                index += 1;
            }
        },
        null => {},
    }
    !{}
}

fn cloneModuleImports(
    allocator: &mut mem::Allocator,
    imports: ?&[ModuleImport],
) Error!collections::ArrayList[OwnedModuleImport] {
    let items = if imports is ?values {
        values
    } else {
        &[]
    };
    let mut owned = collections::ArrayList[OwnedModuleImport]::initCapacity(
        allocator,
        items.len(),
    ).asBuildError(Operation::Retain, Subject::Modules).?;
    let mut transferred = false;
    defer if not transferred {
        deinitModuleImports(&mut owned, allocator).?;
    };
    let mut index: usize = 0;
    for &import in items.iter() {
        let mut ownedImport = OwnedModuleImport::init(allocator, import, index).?;
        let mut importTransferred = false;
        defer if not importTransferred {
            ownedImport.deinit(allocator).?;
        };
        owned.push(allocator, ownedImport).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        importTransferred = true;
        index += 1;
    }
    transferred = true;
    !owned
}

fn deinitModuleImports(
    imports: &mut collections::ArrayList[OwnedModuleImport],
    allocator: &mut mem::Allocator,
) Error!void {
    let mut firstError: ?Error = null;
    let mut index = imports.len();
    while index != 0 {
        index -= 1;
        rememberCleanupError(&mut firstError, imports.asMutSlice()[index].deinit(allocator));
    }
    rememberCleanupError(&mut firstError, imports.deinit(allocator).asBuildError(Operation::Release, Subject::Modules));
    cleanupResult(firstError)
}

fn isValidModuleImportName(name: &[char]) bool {
    if name.len() == 0 {
        return false;
    }
    if name.equals(&"entry") or name.equals(&"pkg") {
        return false;
    }
    for &ch in name.iter() {
        let code = ch as u32;
        let valid = (code >= 48 and code <= 57)
            or (code >= 65 and code <= 90)
            or (code >= 97 and code <= 122)
            or code == 95
            or code == 45;
        if not valid {
            return false;
        }
    }
    true
}

fn argMatchesText(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    let mut byteIndex: usize = 0;
    for &ch in text.iter() {
        let encoded = ch.encodeUtf8();
        let encodedBytes = encoded.bytes();
        for &encodedByte in encodedBytes.iter() {
            if byteIndex >= bytes.len() or bytes[byteIndex] != encodedByte {
                return false;
            }
            byteIndex += 1;
        }
    }
    byteIndex == bytes.len()
}

fn rememberCleanupError(firstError: &mut ?Error, result: Error!void) void {
    switch result {
        !ok => {
            _ = ok;
        },
        err! => {
            if firstError.* is null {
                firstError.* = ?err;
            }
        },
    }
}

fn cleanupResult(firstError: ?Error) Error!void {
    if firstError is ?err {
        err!
    } else {
        !{}
    }
}
