        Self { ownerId: ownerId, index: index }
    }

    fn ownerId(&self) usize {
        self.ownerId
    }

    fn index(&self) usize {
        self.index
    }
}

extend StepDependency {
    pub fn init(step: StepHandle, dependency: StepHandle) StepDependency {
        Self { step: step, dependency: dependency }
    }
}

extend AggregateStep {
    fn init() AggregateStep {
        Self { marker: 0 }
    }
}

extend UncacheableStep {
    fn init(allocator: &mut mem::Allocator, description: &[char], index: usize) Error!UncacheableStep {
        let owned = string::String::fromSlice(allocator, description).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !Self { description: owned }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        self.description.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index))
    }
}

extend GeneratedFileStep {
    fn init(
        allocator: &mut mem::Allocator,
        output: BuildPathView,
        contents: &[u8],
        index: usize,
    ) Error!GeneratedFileStep {
        let mut generated: GeneratedFileStep = GeneratedFileStep {
            output: string::String::init(),
            contents: collections::ArrayList[u8]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            generated.deinit(allocator, index).?;
        };
        generated.output = string::String::fromSlice(allocator, output.text()).asBuildError(Operation::Retain, Subject::Step(index)).?;
        generated.contents.appendSlice(allocator, contents).asBuildError(Operation::Retain, Subject::Step(index)).?;
        transferred = true;
        !generated
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.contents.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)));
        rememberCleanupError(&mut firstError, self.output.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)));
        cleanupResult(firstError)
    }
}

extend ExecutableStep {
    fn init(target: ExecutableHandle) ExecutableStep {
        Self { target: target }
    }
}

extend ObjectStep {
    fn init(target: ObjectHandle) ObjectStep {
