    ExecutableTarget,
    BuildPaths,
    StepPayload,
};

pub fn noopStep(b: &mut Build) Error!void {
    _ = b;
    !{}
}

extend BuildPaths {
    fn init(
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
    ) Error!BuildPaths {
        let mut paths: BuildPaths = {
            packageRoot: fs::PathBuf::init(),
            buildDir: fs::PathBuf::init(),
            cacheDir: fs::PathBuf::init(),
            toolchainExecutable: fs::PathBuf::init(),
            toolchainResourceRoot: fs::PathBuf::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            paths.deinit(allocator).?;
        };
        paths.packageRoot = fs::PathBuf::from_path(allocator, packageRoot).asBuildError().?;
        paths.buildDir = fs::PathBuf::from_path(allocator, buildDir).asBuildError().?;
        paths.cacheDir = fs::PathBuf::from_path(allocator, cacheDir).asBuildError().?;
        paths.toolchainExecutable = fs::PathBuf::from_path(allocator, toolchainExecutable).asBuildError().?;
        paths.toolchainResourceRoot = fs::PathBuf::from_path(allocator, toolchainResourceRoot).asBuildError().?;
        transferred = true;
        !paths
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.toolchainResourceRoot.deinit(allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.toolchainExecutable.deinit(allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.cacheDir.deinit(allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.buildDir.deinit(allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.packageRoot.deinit(allocator).asBuildError());
        cleanupResult(firstError)
    }
}

extend Build {
    pub fn init(
        init: process::Init,
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
        actionReporting: bool,
        stepArgIndex: usize,
    ) Error!Build {
        let paths = BuildPaths::init(
            allocator,
            packageRoot,
            buildDir,
            cacheDir,
            toolchainExecutable,
            toolchainResourceRoot,
        ).?;
        !{
            init: init,
            allocator: allocator,
            paths: paths,
            actionReporting: actionReporting,
            stepArgIndex: stepArgIndex,
            defaultStep: null,
            steps: collections::ArrayList[Step]::init(),
            dependencies: collections::ArrayList[StepDependency]::init(),
            modules: collections::ArrayList[Module]::init(),
            executables: collections::ArrayList[ExecutableTarget]::init(),
            stepsStarted: 0usize,
            stepsSucceeded: 0usize,
            stepsFailed: 0usize,
            customActions: 0usize,
            checkActions: 0usize,
            emitActions: 0usize,
            compilerInvocations: 0usize,
        }
    }

    pub fn deinit(&mut self) Error!void {
        let mut firstError: ?Error = null;
        let mut index = self.steps.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.steps.as_mut_slice()[index].deinit(self.allocator));
        }
        rememberCleanupError(&mut firstError, self.steps.deinit(self.allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.dependencies.deinit(self.allocator).asBuildError());
        index = self.executables.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.executables.as_mut_slice()[index].deinit(self.allocator));
        }
        rememberCleanupError(&mut firstError, self.executables.deinit(self.allocator).asBuildError());
        index = self.modules.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.modules.as_mut_slice()[index].deinit(self.allocator));
        }
        rememberCleanupError(&mut firstError, self.modules.deinit(self.allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.paths.deinit(self.allocator));
        cleanupResult(firstError)
    }

    pub fn io(&self) &mut io::Io[Error = os::Error] {
        self.init.io()
    }

    pub fn packageRoot(&self) fs::PathView {
        self.paths.packageRoot.view()
    }

    pub fn buildDir(&self) fs::PathView {
        self.paths.buildDir.view()
    }

    pub fn cacheDir(&self) fs::PathView {
        self.paths.cacheDir.view()
    }

    pub fn toolchainExecutable(&self) fs::PathView {
        self.paths.toolchainExecutable.view()
    }

    pub fn toolchainResourceRoot(&self) fs::PathView {
        self.paths.toolchainResourceRoot.view()
    }

    pub fn addStep(&mut self, name: &[char], run: StepFn) Error!StepHandle {
        self.addStepRecord(string::StringView::init(name), StepKind::Custom, { custom: CustomStep::init(run) })
    }

    pub fn addCheckExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        self.addStepRecord(string::StringView::init(name), StepKind::CheckExecutable, { executable: ExecutableStep::init(target) })
    }

    pub fn addEmitExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        self.addStepRecord(string::StringView::init(name), StepKind::EmitExecutable, { executable: ExecutableStep::init(target) })
    }

    pub fn dependOn(&mut self, step: StepHandle, dependency: StepHandle) Error!void {
        if step.index() >= self.steps.len() or dependency.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        if step.index() == dependency.index() {
            return Error::StepCycle!;
        }
        for &edge in self.dependencies.iter() {
            if edge.step.index() == step.index() and edge.dependency.index() == dependency.index() {
                return !{};
            }
        }
        self.dependencies.push(
            self.allocator,
            StepDependency::init(step, dependency),
        ).asBuildError()
    }

    pub fn setDefaultStep(&mut self, step: StepHandle) Error!void {
        if step.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        self.defaultStep = ?step;
        !{}
    }

    pub fn addModule(&mut self, options: ModuleOptions) Error!ModuleHandle {
        validateModuleImports(options.imports).?;
        let handle = ModuleHandle::init(self.modules.len());
        let mut moduleRecord = Module::init(self.allocator, options).?;
        let mut transferred = false;
        defer if not transferred {
            moduleRecord.deinit(self.allocator).?;
        };
        self.modules.push(self.allocator, moduleRecord).asBuildError().?;
        transferred = true;
        !handle
    }

    pub fn addExecutable(&mut self, options: ExecutableOptions) Error!ExecutableHandle {
        if not isValidTargetName(options.name) {
            return Error::InvalidTarget!;
        }
        self.validateModuleHandle(options.rootModule).?;
        if options.runtime != Runtime::Freestanding {
            return Error::InvalidTarget!;
        }
        let outputName = executableOutputName(options);
        if not isValidTargetName(outputName) {
            return Error::InvalidTarget!;
        }
        switch self.findExecutable(options.name) {
            ?old => {
                _ = old;
                return Error::InvalidTarget!;
            },
            null => {},
        }
        let handle = ExecutableHandle::init(self.executables.len());
        let mut target = ExecutableTarget::init(self.allocator, options, outputName).?;
        let mut transferred = false;
        defer if not transferred {
            target.deinit(self.allocator).?;
        };
        self.executables.push(self.allocator, target).asBuildError().?;
        transferred = true;
        !handle
    }

    fn checkExecutable(&mut self, handle: ExecutableHandle) Error!void {
        let target = self.executableTarget(handle).?;
        let moduleRecord = self.buildModule(target.rootModule).?;
        self.checkExe(moduleRecord, target.runtime)
    }

    fn emitExecutable(&mut self, handle: ExecutableHandle) Error!void {
        let target = self.executableTarget(handle).?;
        let moduleRecord = self.buildModule(target.rootModule).?;
        let mut outputPath = fs::PathBuf::from_path(self.allocator, self.paths.buildDir.view()).asBuildError().?;
        defer outputPath.deinit(self.allocator).asBuildError().?;
        outputPath.join_component(self.allocator, target.outputName.text()).asBuildError().?;
        let mut outputPathStorage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let output = outputPath.encode(&mut outputPathStorage[..]).asBuildError().?;
        self.emitExe(moduleRecord, output, target.runtime)
    }

    fn checkExe(&mut self, moduleRecord: Module, runtime: Runtime) Error!void {
        let mut sourceStorage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let sourceArg = moduleRecord.rootSource.encode(&mut sourceStorage[..]).asBuildError().?;
        let checkArg = b"check\0";
        let runtimeArg = runtime.argv();
        let optimizationArg = moduleRecord.optimization.argv();
        self.runToolchainModuleArgs(&[
            &checkArg[0],
            sourceArg.ptr(),
            runtimeArg,
            optimizationArg,
        ], moduleRecord.imports.as_slice(), &[])
    }

    fn emitExe(
        &mut self,
        moduleRecord: Module,
        output: fs::EncodedPath,
        runtime: Runtime,
    ) Error!void {
        let mut sourceStorage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let mut cacheDirStorage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let sourceArg = moduleRecord.rootSource.encode(&mut sourceStorage[..]).asBuildError().?;
        let cacheDirArg = self.paths.cacheDir.encode(&mut cacheDirStorage[..]).asBuildError().?;
        let emitArg = b"emit\0";
        let exeArg = b"--exe\0";
        let outputArg = b"-o\0";
        let cacheDirFlag = b"--cache-dir\0";
        let runtimeArg = runtime.argv();
        let optimizationArg = moduleRecord.optimization.argv();
        self.runToolchainModuleArgs(&[
            &emitArg[0],
            &exeArg[0],
            sourceArg.ptr(),
            runtimeArg,
            optimizationArg,
        ], moduleRecord.imports.as_slice(), &[
            &outputArg[0],
            output.ptr(),
            &cacheDirFlag[0],
            cacheDirArg.ptr(),
        ])
    }

    fn executableTarget(&self, handle: ExecutableHandle) Error!ExecutableTarget {
        if handle.index() >= self.executables.len() {
            return Error::InvalidTarget!;
        }
        !self.executables.as_slice()[handle.index()]
    }

    fn buildModule(&self, handle: ModuleHandle) Error!Module {
        if handle.index() >= self.modules.len() {
            return Error::InvalidTarget!;
        }
        !self.modules.as_slice()[handle.index()]
    }

    fn runToolchainArgs(&mut self, args: &[&u8]) Error!void {
        self.compilerInvocations += 1usize;
        let term = command::run_path_args(
            self.paths.toolchainExecutable.view(),
            args,
            self.init.raw_envp(),
        ).asBuildError().?;
        if not term.exited_success() {
            return Error::CommandFailed!;
        }
        !{}
    }

    fn runToolchainModuleArgs(
        &mut self,
        head: &[&u8],
        imports: &[OwnedModuleImport],
        tail: &[&u8],
    ) Error!void {
        static timings = b"--timings=detail\0";
        static timingFormat = b"--timings-format=json\0";
        static resourceRootFlag = b"--resource-root\0";
        let mut resourceRootStorage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let resourceRootArg = self.paths.toolchainResourceRoot.encode(&mut resourceRootStorage[..]).asBuildError().?;
        let mut importStorage: [16][os::max_path_bytes]u8 = [[0u8; os::max_path_bytes]; 16];
        let mut argStorage: [48]&u8 = [0usize as &u8; 48];
        let mut argv = ArgList::init(&mut argStorage[..]);
        argv.push_ptrs(head).asBuildError().?;
        appendModuleImportArgs(&mut argv, imports, &mut importStorage[..]).?;
        argv.push_ptrs(tail).asBuildError().?;
        argv.push_ptr(&resourceRootFlag[0]).asBuildError().?;
        argv.push_ptr(resourceRootArg.ptr()).asBuildError().?;
        if self.actionReporting {
            argv.push_ptr(&timings[0]).asBuildError().?;
            argv.push_ptr(&timingFormat[0]).asBuildError().?;
        }
        self.runToolchainArgs(&argStorage[0..argv.len()])
    }

    pub fn requestedStep(&self) ?process::Arg {
        self.init.args().get(self.stepArgIndex)
    }

    pub fn runRequestedStep(&mut self) Error!void {
        switch self.requestedStep() {
            ?step => {
                switch self.findStepArg(step) {
                    ?handle => {
                        return self.runStep(handle);
                    },
                    null => {},
                }
                self.reportUnknownStep(step).?;
                return Error::UnknownStep!;
            },
            null => {},
        }
        switch self.defaultStep {
            ?handle => {
                return self.runStep(handle);
            },
            null => {},
        }
        if self.steps.len() != 0usize {
            return Error::MissingDefaultStep!;
        }
        !{}
    }

    fn runStep(&mut self, handle: StepHandle) Error!void {
        if handle.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        let state = self.steps.as_slice()[handle.index()].state;
        switch state {
            StepState::Done => return !{},
            StepState::Running => return Error::StepCycle!,
            StepState::Failed => return Error::StepFailed!,
            _ => {}
        }

        self.setStepState(handle, StepState::Running);
        self.stepsStarted += 1usize;

        for &edge in self.dependencies.iter() {
            if edge.step.index() == handle.index() {
                switch self.runStep(edge.dependency) {
                    !ok => {
                        _ = ok;
                    },
                    err! => {
                        self.setStepState(handle, StepState::Failed);
                        self.stepsFailed += 1usize;
                        return err!;
                    },
                }
            }
        }

        let step = self.steps.as_slice()[handle.index()];
        switch self.runStepPayload(step) {
            !ok => {
                _ = ok;
            },
            err! => {
                self.setStepState(handle, StepState::Failed);
                self.stepsFailed += 1usize;
                return err!;
            },
        }

        self.setStepState(handle, StepState::Done);
        self.stepsSucceeded += 1usize;
        !{}
    }

    fn runStepPayload(&mut self, step: Step) Error!void {
        switch step.kind {
            StepKind::Custom => {
                self.customActions += 1usize;
                (step.payload.custom.run)(self)
            },
            StepKind::CheckExecutable => {
                self.checkActions += 1usize;
                self.checkExecutable(step.payload.executable.target)
            },
            StepKind::EmitExecutable => {
                self.emitActions += 1usize;
                self.emitExecutable(step.payload.executable.target)
            },
        }
    }

    pub fn reportActions(&mut self, success: bool) Error!void {
        if not self.actionReporting {
            return !{};
        }
        let mut buffer: [1024]u8 = [_]u8[0; 1024];
        let mut stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print(
            &"{{\"schema_version\":1,\"kind\":\"nia-build-actions\",\"success\":{},\"counters\":{{\"declared_steps\":{},\"declared_dependencies\":{},\"declared_modules\":{},\"declared_executables\":{},\"steps_started\":{},\"steps_succeeded\":{},\"steps_failed\":{},\"custom_actions\":{},\"check_actions\":{},\"emit_actions\":{},\"compiler_invocations\":{}}}}}\n",
            &[
                &success,
                &self.steps.len(),
                &self.dependencies.len(),
                &self.modules.len(),
                &self.executables.len(),
                &self.stepsStarted,
                &self.stepsSucceeded,
                &self.stepsFailed,
                &self.customActions,
                &self.checkActions,
                &self.emitActions,
                &self.compilerInvocations,
            ],
        ).asBuildError().?;
        stderr.flush().asBuildError()
    }

    fn setStepState(&mut self, handle: StepHandle, state: StepState) void {
        let mut steps = self.steps.as_mut_slice();
        steps[handle.index()].state = state;
    }

    fn findStep(&self, name: string::StringView) ?Step {
        for &step in self.steps.iter() {
            if mem::equal[char](step.name.text(), name.text()) {
                return ?step;
            }
        }
        null
    }

    fn findStepArg(&self, arg: process::Arg) ?StepHandle {
        let mut index = 0usize;
        for &step in self.steps.iter() {
            if argMatchesText(arg, step.name.text()) {
                return ?StepHandle::init(index);
            }
            index += 1usize;
        }
        null
    }

    fn findExecutable(&self, name: string::StringView) ?ExecutableTarget {
        for &target in self.executables.iter() {
            if mem::equal[char](target.name.text(), name.text()) {
                return ?target;
            }
        }
        null
    }

    fn validateExecutableHandle(&self, handle: ExecutableHandle) Error!void {
        if handle.index() >= self.executables.len() {
            return Error::InvalidTarget!;
        }
        !{}
    }

    fn validateModuleHandle(&self, handle: ModuleHandle) Error!void {
        if handle.index() >= self.modules.len() {
            return Error::InvalidTarget!;
        }
        !{}
    }

    fn reportUnknownStep(&mut self, step: process::Arg) Error!void {
        let mut buffer: [256]u8 = [_]u8[0; 256];
        let mut stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print(&"unknown build step `{}`\n", &[&step]).asBuildError().?;
        stderr.flush().asBuildError()
    }

    fn addStepRecord(&mut self, name: string::StringView, kind: StepKind, payload: StepPayload) Error!StepHandle {
        if name.len() == 0usize {
            return Error::InvalidStep!;
        }
        switch self.findStep(name) {
            ?old => {
                _ = old;
                return Error::InvalidStep!;
            },
            null => {},
        }
        let handle = StepHandle::init(self.steps.len());
        let mut step = Step::init(self.allocator, name, kind, payload).?;
        let mut transferred = false;
        defer if not transferred {
            step.deinit(self.allocator).?;
        };
        self.steps.push(self.allocator, step).asBuildError().?;
        transferred = true;
        !handle
    }
}

extend StepHandle {
    fn init(index: usize) StepHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend ExecutableHandle {
    fn init(index: usize) ExecutableHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend ModuleHandle {
    fn init(index: usize) ModuleHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend StepDependency {
    pub fn init(step: StepHandle, dependency: StepHandle) StepDependency {
        { step: step, dependency: dependency }
    }
}

extend CustomStep {
    fn init(run: StepFn) CustomStep {
        { run: run }
    }
}

extend ExecutableStep {
    fn init(target: ExecutableHandle) ExecutableStep {
        { target: target }
    }
}

extend Step {
    fn init(
        allocator: &mut mem::Allocator,
        name: string::StringView,
        kind: StepKind,
        payload: StepPayload,
    ) Error!Step {
        let ownedName = string::StringBuf::from_slice(allocator, name.text()).asBuildError().?;
        !{
            name: ownedName,
            kind: kind,
            payload: payload,
            state: StepState::Pending,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        self.name.deinit(allocator).asBuildError()
    }
}

extend ModuleOptions {
    pub fn init(rootSource: fs::PathView) ModuleOptions {
        {
            rootSource: rootSource,
            optimization: OptimizationMode::O2,
            imports: null,
        }
    }

    pub fn withOptimization(self, optimization: OptimizationMode) ModuleOptions {
        {
            rootSource: self.rootSource,
            optimization: optimization,
            imports: self.imports,
        }
    }

    pub fn withImports(self, imports: &[ModuleImport]) ModuleOptions {
        {
            rootSource: self.rootSource,
            optimization: self.optimization,
            imports: ?imports,
        }
    }
}

extend Module {
    pub fn init(allocator: &mut mem::Allocator, options: ModuleOptions) Error!Module {
        let mut moduleRecord: Module = {
            rootSource: fs::PathBuf::init(),
            optimization: options.optimization,
            imports: collections::ArrayList[OwnedModuleImport]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            moduleRecord.deinit(allocator).?;
        };
        moduleRecord.rootSource = fs::PathBuf::from_path(allocator, options.rootSource).asBuildError().?;
        moduleRecord.imports = cloneModuleImports(allocator, options.imports).?;
        transferred = true;
        !moduleRecord
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        let mut index = self.imports.len();
        while index != 0usize {
            index -= 1usize;
            rememberCleanupError(&mut firstError, self.imports.as_mut_slice()[index].deinit(allocator));
        }
        rememberCleanupError(&mut firstError, self.imports.deinit(allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.rootSource.deinit(allocator).asBuildError());
        cleanupResult(firstError)
    }
}

extend ModuleImport {
    pub fn init(name: &[char], path: fs::PathView) ModuleImport {
        {
            name: string::StringView::init(name),
            path: path,
        }
    }
}

extend OwnedModuleImport {
    fn init(allocator: &mut mem::Allocator, import: ModuleImport) Error!OwnedModuleImport {
        let mut owned: OwnedModuleImport = {
            name: string::StringBuf::init(),
            path: fs::PathBuf::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator).?;
        };
        owned.name = string::StringBuf::from_slice(allocator, import.name.text()).asBuildError().?;
        owned.path = fs::PathBuf::from_path(allocator, import.path).asBuildError().?;
        transferred = true;
        !owned
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.path.deinit(allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError());
        cleanupResult(firstError)
    }
}

extend ExecutableTarget {
    pub fn init(
        allocator: &mut mem::Allocator,
        options: ExecutableOptions,
        outputName: string::StringView,
    ) Error!ExecutableTarget {
        let mut target: ExecutableTarget = {
            name: string::StringBuf::init(),
            rootModule: options.rootModule,
            outputName: string::StringBuf::init(),
            runtime: options.runtime,
        };
        let mut transferred = false;
        defer if not transferred {
            target.deinit(allocator).?;
        };
        target.name = string::StringBuf::from_slice(allocator, options.name.text()).asBuildError().?;
        target.outputName = string::StringBuf::from_slice(allocator, outputName.text()).asBuildError().?;
        transferred = true;
        !target
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.outputName.deinit(allocator).asBuildError());
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError());
        cleanupResult(firstError)
    }
}

extend ExecutableOptions {
    pub fn init(name: &[char], rootModule: ModuleHandle) ExecutableOptions {
        {
            name: string::StringView::init(name),
            rootModule: rootModule,
            outputName: null,
            runtime: Runtime::Freestanding,
        }
    }

    pub fn withOutputName(self, outputName: &[char]) ExecutableOptions {
        {
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?string::StringView::init(outputName),
            runtime: self.runtime,
        }
    }

    pub fn withRuntime(self, runtime: Runtime) ExecutableOptions {
        {
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            runtime: runtime,
        }
    }
}

fn executableOutputName(options: ExecutableOptions) string::StringView {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

extend OptimizationMode {
    fn argv(self) &u8 {
        static o0 = b"-O0\0";
        static o1 = b"-O1\0";
        static o2 = b"-O2\0";
        static o3 = b"-O3\0";
        static os = b"-Os\0";
        static oz = b"-Oz\0";
        switch self {
            OptimizationMode::O0 => &o0[0],
            OptimizationMode::O1 => &o1[0],
            OptimizationMode::O2 => &o2[0],
            OptimizationMode::O3 => &o3[0],
            OptimizationMode::Os => &os[0],
            OptimizationMode::Oz => &oz[0],
            _ => &o2[0],
        }
    }
}

extend Runtime {
    fn argv(self) &u8 {
        static bare = b"--runtime=bare\0";
        static freestanding = b"--runtime=freestanding\0";
        switch self {
            Runtime::Bare => &bare[0],
            Runtime::Freestanding => &freestanding[0],
            _ => &freestanding[0],
        }
    }
}

fn isValidTargetName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    for &ch in text.iter() {
        let code = ch as u32;
        if code == 0u32 or code == 47u32 or code == 92u32 {
            return false;
        }
    }
    true
}

fn validateModuleImports(imports: ?&[ModuleImport]) Error!void {
    switch imports {
        ?items => {
            for &import in items.iter() {
                if not isValidModuleImportName(import.name) {
                    return Error::InvalidTarget!;
                }
            }
        },
        null => {},
    }
    !{}
}

fn cloneModuleImports(
    allocator: &mut mem::Allocator,
    imports: ?&[ModuleImport],
) Error!collections::ArrayList[OwnedModuleImport] {
    let items = if imports is ?values {
        values
    } else {
        &[]
    };
    let mut owned = collections::ArrayList[OwnedModuleImport]::init_capacity(
        allocator,
        items.len(),
    ).asBuildError().?;
    let mut transferred = false;
    defer if not transferred {
        deinitModuleImports(&mut owned, allocator).?;
    };
    for &import in items.iter() {
        let mut ownedImport = OwnedModuleImport::init(allocator, import).?;
        let mut importTransferred = false;
        defer if not importTransferred {
            ownedImport.deinit(allocator).?;
        };
        owned.push(allocator, ownedImport).asBuildError().?;
        importTransferred = true;
    }
    transferred = true;
    !owned
}

fn deinitModuleImports(
    imports: &mut collections::ArrayList[OwnedModuleImport],
    allocator: &mut mem::Allocator,
) Error!void {
    let mut firstError: ?Error = null;
    let mut index = imports.len();
    while index != 0usize {
        index -= 1usize;
        rememberCleanupError(&mut firstError, imports.as_mut_slice()[index].deinit(allocator));
    }
    rememberCleanupError(&mut firstError, imports.deinit(allocator).asBuildError());
    cleanupResult(firstError)
}

fn isValidModuleImportName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    if mem::equal[char](text, &"entry") or mem::equal[char](text, &"pkg") {
        return false;
    }
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48u32 and code <= 57u32)
            or (code >= 65u32 and code <= 90u32)
            or (code >= 97u32 and code <= 122u32)
            or code == 95u32
            or code == 45u32;
        if not valid {
            return false;
        }
    }
    true
}

fn appendModuleImportArgs(
    argv: &mut ArgList,
    imports: &[OwnedModuleImport],
    storage: &mut [[os::max_path_bytes]u8],
) Error!void {
    if imports.len() > 16usize {
        return Error::InvalidTarget!;
    }
    static moduleFlag = b"--module\0";
    let mut index = 0usize;
    for &import in imports.iter() {
        argv.push_ptr(&moduleFlag[0]).asBuildError().?;
        let arg = encodeModuleImport(import, &mut storage[index][..]).?;
        argv.push_ptr(arg.ptr()).asBuildError().?;
        index += 1usize;
    }
    !{}
}

fn encodeModuleImport(import: OwnedModuleImport, storage: &mut [u8]) Error!fs::EncodedPath {
    let mut out = 0usize;
    out = appendCharsToBytes(import.name.text(), storage, out).?;
    if out >= storage.len() {
        return Error::InvalidTarget!;
    }
    storage[out] = b'=';
    out += 1usize;
    out = appendCharsToBytes(import.path.text(), storage, out).?;
    if out >= storage.len() {
        return Error::InvalidTarget!;
    }
    storage[out] = 0u8;
    !fs::EncodedPath::init(storage.ptr(), out)
}

fn appendCharsToBytes(text: &[char], storage: &mut [u8], start: usize) Error!usize {
    let mut out = start;
    for &ch in text.iter() {
        if ch as u32 == 0u32 {
            return Error::InvalidTarget!;
        }
        let encoded = ch.encode_utf8();
        let bytes = encoded.bytes();
        for &byte in bytes.iter() {
            if out >= storage.len() {
                return Error::InvalidTarget!;
            }
            storage[out] = byte;
            out += 1usize;
        }
    }
    !out
}

fn argMatchesText(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    let mut byteIndex = 0usize;
    for &ch in text.iter() {
        let encoded = ch.encode_utf8();
        let encodedBytes = encoded.bytes();
        for &encodedByte in encodedBytes.iter() {
            if byteIndex >= bytes.len() or bytes[byteIndex] != encodedByte {
                return false;
            }
            byteIndex += 1usize;
        }
    }
    byteIndex == bytes.len()
}

fn rememberCleanupError(firstError: &mut ?Error, result: Error!void) void {
    switch result {
        !ok => {
            _ = ok;
        },
        err! => {
            if firstError.* is null {
                firstError.* = ?err;
            }
        },
    }
}

fn cleanupResult(firstError: ?Error) Error!void {
    if firstError is ?err {
        err!
    } else {
        !{}
    }
}
