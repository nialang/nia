extend UncacheableStep {
    fn init(allocator: &mut mem::Allocator, description: &[char], index: usize) Error!UncacheableStep {
        let owned = string::String::fromSlice(allocator, description).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !{ description: owned }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        self.description.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index))
    }
}

extend GeneratedFileStep {
    fn init(
        allocator: &mut mem::Allocator,
        output: BuildPathView,
        contents: &[u8],
        index: usize,
    ) Error!GeneratedFileStep {
        let mut generated: GeneratedFileStep = {
            output: string::String::init(),
            contents: collections::ArrayList[u8]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            generated.deinit(allocator, index).?;
        };
        generated.output = string::String::fromSlice(allocator, output.text()).asBuildError(Operation::Retain, Subject::Step(index)).?;
        generated.contents.appendSlice(allocator, contents).asBuildError(Operation::Retain, Subject::Step(index)).?;
        transferred = true;
        !generated
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.contents.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)));
        rememberCleanupError(&mut firstError, self.output.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)));
        cleanupResult(firstError)
    }
}

extend ExecutableStep {
    fn init(target: ExecutableHandle) ExecutableStep {
        { target: target }
    }
}

extend RunOptions {
    pub fn init(target: ExecutableHandle) RunOptions {
        {
            target: target,
            arguments: null,
        }
    }

    pub fn withArguments(self, arguments: &[&[char]]) RunOptions {
        {
            target: self.target,
            arguments: ?arguments,
        }
    }
}

extend RunExecutableStep {
    fn init(
        allocator: &mut mem::Allocator,
        options: RunOptions,
        index: usize,
    ) Error!RunExecutableStep {
        let mut run: RunExecutableStep = {
            target: options.target,
            arguments: collections::ArrayList[string::String]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            run.deinit(allocator, index).?;
        };
        switch options.arguments {
            ?arguments => {
                run.arguments = collections::ArrayList[string::String]::initCapacity(
                    allocator,
                    arguments.len(),
                ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                for &argument in arguments.iter() {
                    let mut owned = string::String::fromSlice(
                        allocator,
                        argument,
                    ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    let mut argumentTransferred = false;
                    defer if not argumentTransferred {
                        owned.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)).?;
                    };
                    run.arguments.push(allocator, owned).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    argumentTransferred = true;
                }
            },
            null => {},
        }
        transferred = true;
        !run
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!void {
        let mut firstError: ?Error = null;
        let mut argumentIndex = self.arguments.len();
        while argumentIndex != 0 {
            argumentIndex -= 1;
            rememberCleanupError(
                &mut firstError,
                self.arguments.asMutSlice()[argumentIndex]
                    .deinit(allocator)
                    .asBuildError(Operation::Release, Subject::Step(index)),
            );
        }
        rememberCleanupError(
            &mut firstError,
            self.arguments.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        cleanupResult(firstError)
    }
}

