extend TargetView {
    pub fn init(
        arch: &[char],
        vendor: &[char],
        os: &[char],
        env: &[char],
        abi: &[char],
        endian: &[char],
        pointerWidth: u32,
    ) TargetView {
        Self {
            arch: arch,
            vendor: vendor,
            os: os,
            env: env,
            abi: abi,
            endian: endian,
            pointerWidth: pointerWidth,
        }
    }

    pub fn arch(&self) &[char] {
        self.arch
    }

    pub fn vendor(&self) &[char] {
        self.vendor
    }

    pub fn os(&self) &[char] {
        self.os
    }

    pub fn env(&self) &[char] {
        self.env
    }

    pub fn abi(&self) &[char] {
        self.abi
    }

    pub fn endian(&self) &[char] {
        self.endian
    }

    pub fn pointerWidth(&self) u32 {
        self.pointerWidth
    }

    pub fn equals(&self, other: TargetView) bool {
        self.arch.equals(other.arch)
            and self.vendor.equals(other.vendor)
            and self.os.equals(other.os)
            and self.env.equals(other.env)
            and self.abi.equals(other.abi)
            and self.endian.equals(other.endian)
            and self.pointerWidth == other.pointerWidth
    }
}

extend TargetStorage {
    fn init(
        allocator: &mut mem::Allocator,
        target: TargetView,
        subject: Subject,
    ) Error!TargetStorage {
        let mut owned: TargetStorage = TargetStorage {
            arch: string::String::init(),
            vendor: string::String::init(),
            os: string::String::init(),
            env: string::String::init(),
            abi: string::String::init(),
            endian: string::String::init(),
            pointerWidth: target.pointerWidth,
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator, subject).?;
        };
        owned.arch = string::String::fromSlice(allocator, target.arch).asBuildError(Operation::Retain, subject).?;
        owned.vendor = string::String::fromSlice(allocator, target.vendor).asBuildError(Operation::Retain, subject).?;
        owned.os = string::String::fromSlice(allocator, target.os).asBuildError(Operation::Retain, subject).?;
        owned.env = string::String::fromSlice(allocator, target.env).asBuildError(Operation::Retain, subject).?;
        owned.abi = string::String::fromSlice(allocator, target.abi).asBuildError(Operation::Retain, subject).?;
        owned.endian = string::String::fromSlice(allocator, target.endian).asBuildError(Operation::Retain, subject).?;
        transferred = true;
        !owned
    }

    fn view(&self) TargetView {
        TargetView::init(
            self.arch.text(),
            self.vendor.text(),
            self.os.text(),
            self.env.text(),
            self.abi.text(),
            self.endian.text(),
            self.pointerWidth,
        )
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, subject: Subject) Error!() {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.endian.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.abi.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.env.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.os.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.vendor.deinit(allocator).asBuildError(Operation::Release, subject));
        rememberCleanupError(&mut firstError, self.arch.deinit(allocator).asBuildError(Operation::Release, subject));
        cleanupResult(firstError)
    }
}

extend ExecutableOptions {
    // Artifact target is the default. `forHost` is reserved for tools that must
    // execute during this build; arbitrary target construction is not exposed.
    pub fn init(name: &[char], rootModule: ModuleHandle) ExecutableOptions {
        Self {
            name: name,
            rootModule: rootModule,
            outputName: null,
            targetRole: TargetRole::Artifact,
            staticArchives: null,
        }
    }

    pub fn withOutputName(self, outputName: &[char]) ExecutableOptions {
        Self {
            name: self.name,
            rootModule: self.rootModule,
            outputName: ?outputName,
            targetRole: self.targetRole,
            staticArchives: self.staticArchives,
        }
    }

    pub fn forHost(self) ExecutableOptions {
        Self {
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            targetRole: TargetRole::Host,
            staticArchives: self.staticArchives,
        }
    }

    pub fn withStaticArchives(self, staticArchives: &[StaticArchiveHandle]) ExecutableOptions {
        Self {
            name: self.name,
            rootModule: self.rootModule,
            outputName: self.outputName,
            targetRole: self.targetRole,
            staticArchives: ?staticArchives,
        }
    }
}

