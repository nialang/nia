    fn init(
        allocator: &mut mem::Allocator,
        target: ExecutableHandle,
        destination: BuildPathView,
        index: usize,
    ) Error!InstallExecutableStep {
        let owned = string::String::fromSlice(
            allocator,
            destination.text(),
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !Self {
            target: target,
            destination: owned,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        self.destination.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index))
    }
}

extend InstallStaticArchiveStep {
    fn init(
        allocator: &mut mem::Allocator,
        target: StaticArchiveHandle,
        destination: BuildPathView,
        index: usize,
    ) Error!InstallStaticArchiveStep {
        let owned = string::String::fromSlice(
            allocator,
            destination.text(),
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !Self {
            target: target,
            destination: owned,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        self.destination.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index))
    }
}

extend RunExecutableStep {
    fn init(
        allocator: &mut mem::Allocator,
        options: RunOptions,
        index: usize,
    ) Error!RunExecutableStep {
        let mut run: RunExecutableStep = RunExecutableStep {
            target: options.target,
            arguments: collections::ArrayList[string::String]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            run.deinit(allocator, index).?;
        };
        match options.arguments {
            ?arguments => {
                run.arguments = collections::ArrayList[string::String]::initCapacity(
                    allocator,
                    arguments.len(),
                ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                for &argument in arguments.iter() {
                    let mut owned = string::String::fromSlice(
                        allocator,
                        argument,
                    ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    let mut argumentTransferred = false;
                    defer if not argumentTransferred {
                        owned.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)).?;
                    };
                    run.arguments.push(allocator, owned).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    argumentTransferred = true;
                }
            },
            null => {},
        }
        transferred = true;
        !run
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut firstError: ?Error = null;
        let mut elementError: ?Error = null;
        let mut argumentIndex = self.arguments.len();
        while argumentIndex != 0 {
            argumentIndex -= 1;
            rememberCleanupError(
                &mut elementError,
                self.arguments.asMutSlice()[argumentIndex]
                    .deinit(allocator)
                    .asBuildError(Operation::Release, Subject::Step(index)),
            );
        }
        if elementError is null {
            rememberCleanupError(
                &mut firstError,
                self.arguments.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
            );
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        cleanupResult(firstError)
    }
}

extend CommandArgument {
    // Each constructor records the logical root used for dependency validation
    // and cache identity. Literal values intentionally declare no file input.
    pub fn literal(value: &[char]) CommandArgument {
        Self {
            kind: CommandArgumentKind::Literal,
            payload: CommandArgumentPayload { value },
            package: PackageHandle::init(0, 0),
        }
    }

    pub fn packageInput(package: PackageHandle, path: fs::PathView) CommandArgument {
        Self {
            kind: CommandArgumentKind::PackageInput,
            payload: CommandArgumentPayload { value: path.text() },
            package: package,
        }
    }

    pub fn buildInput(path: BuildPathView) CommandArgument {
        Self {
            kind: CommandArgumentKind::BuildInput,
            payload: CommandArgumentPayload { value: path.text() },
            package: PackageHandle::init(0, 0),
        }
    }

    pub fn buildOutput(path: BuildPathView) CommandArgument {
        Self {
            kind: CommandArgumentKind::BuildOutput,
            payload: CommandArgumentPayload { value: path.text() },
            package: PackageHandle::init(0, 0),
        }
    }

    pub fn artifactInput(artifact: ExecutableHandle) CommandArgument {
        Self {
            kind: CommandArgumentKind::ArtifactInput,
            payload: CommandArgumentPayload { artifact },
            package: PackageHandle::init(0, 0),
        }
    }

    pub fn objectInput(object: ObjectHandle) CommandArgument {
        Self {
            kind: CommandArgumentKind::ObjectInput,
            payload: CommandArgumentPayload { object },
            package: PackageHandle::init(0, 0),
        }
    }

    pub fn staticArchiveInput(staticArchive: StaticArchiveHandle) CommandArgument {
        Self {
            kind: CommandArgumentKind::StaticArchiveInput,
            payload: CommandArgumentPayload { staticArchive },
            package: PackageHandle::init(0, 0),
        }
    }
}

extend ExternalCommandOptions {
    // Search commands inherit the process environment and are uncacheable by
    // default. Persistent reuse requires `withClearedEnvironment`, explicit
    // typed inputs/outputs, and `withDeclaredInputCache`.
    pub fn search(program: &[char]) ExternalCommandOptions {
        Self {
            program: program,
            arguments: null,
            workingDirectory: fs::PathView::init(&""),
            resourceClass: ActionResourceClass::Conservative,
            environmentPolicy: CommandEnvironmentPolicy::Inherit,
            cachePolicy: CommandCachePolicy::Uncacheable,
            environment: null,
        }
    }

    pub fn withArguments(self, arguments: &[CommandArgument]) ExternalCommandOptions {
        Self {
            program: self.program,
            arguments: ?arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withPackageWorkingDirectory(self, workingDirectory: fs::PathView) ExternalCommandOptions {
        Self {
            program: self.program,
            arguments: self.arguments,
            workingDirectory: workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withResourceClass(self, resourceClass: ActionResourceClass) ExternalCommandOptions {
        Self {
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withEnvironment(self, environment: &[CommandEnvironmentInput]) ExternalCommandOptions {
        Self {
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: self.cachePolicy,
            environment: ?environment,
        }
    }

    pub fn withClearedEnvironment(self) ExternalCommandOptions {
        Self {
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: CommandEnvironmentPolicy::Clear,
            cachePolicy: self.cachePolicy,
            environment: self.environment,
        }
    }

    pub fn withDeclaredInputCache(self) ExternalCommandOptions {
        Self {
            program: self.program,
            arguments: self.arguments,
            workingDirectory: self.workingDirectory,
            resourceClass: self.resourceClass,
            environmentPolicy: self.environmentPolicy,
            cachePolicy: CommandCachePolicy::DeclaredInputs,
            environment: self.environment,
        }
    }
}

extend CommandEnvironmentInput {
    pub fn init(name: &[char], value: &[char]) CommandEnvironmentInput {
        Self {
            name: name,
            value: value,
        }
    }
}

extend OwnedCommandArgument {
    fn init(
        allocator: &mut mem::Allocator,
        argument: CommandArgument,
        index: usize,
    ) Error!OwnedCommandArgument {
        if argument.kind == CommandArgumentKind::ArtifactInput {
            return !Self {
                kind: argument.kind,
                payload: OwnedCommandArgumentPayload { artifact: argument.payload.artifact },
                package: argument.package,
            };
        }
        if argument.kind == CommandArgumentKind::ObjectInput {
            return !Self {
                kind: argument.kind,
                payload: OwnedCommandArgumentPayload { object: argument.payload.object },
                package: argument.package,
            };
        }
        if argument.kind == CommandArgumentKind::StaticArchiveInput {
            return !Self {
                kind: argument.kind,
                payload: OwnedCommandArgumentPayload { staticArchive: argument.payload.staticArchive },
                package: argument.package,
            };
        }
        let value = string::String::fromSlice(
            allocator,
            argument.payload.value,
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !Self {
            kind: argument.kind,
            payload: OwnedCommandArgumentPayload { value },
            package: argument.package,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        if self.kind == CommandArgumentKind::ArtifactInput
            or self.kind == CommandArgumentKind::ObjectInput
            or self.kind == CommandArgumentKind::StaticArchiveInput
        {
            return !();
        }
        self.payload.value.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index))
    }
}

extend OwnedCommandEnvironmentInput {
    fn init(
        allocator: &mut mem::Allocator,
        input: CommandEnvironmentInput,
        index: usize,
    ) Error!OwnedCommandEnvironmentInput {
        let mut name = string::String::fromSlice(
            allocator,
            input.name,
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        let mut nameTransferred = false;
        defer if not nameTransferred {
            name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)).?;
        };
        let value = string::String::fromSlice(
            allocator,
            input.value,
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        nameTransferred = true;
        !Self { name: name, value: value }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut firstError: ?Error = null;
        rememberCleanupError(
            &mut firstError,
            self.value.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        rememberCleanupError(
            &mut firstError,
            self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        cleanupResult(firstError)
    }
}

extend ExternalCommandStep {
    fn init(
        allocator: &mut mem::Allocator,
        options: ExternalCommandOptions,
        index: usize,
    ) Error!ExternalCommandStep {
        let mut command: ExternalCommandStep = ExternalCommandStep {
            program: string::String::init(),
            arguments: collections::ArrayList[OwnedCommandArgument]::init(),
            workingDirectory: fs::Path::init(),
            resourceClass: options.resourceClass,
            environmentPolicy: options.environmentPolicy,
            cachePolicy: options.cachePolicy,
            environment: collections::ArrayList[OwnedCommandEnvironmentInput]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            command.deinit(allocator, index).?;
        };
        command.program = string::String::fromSlice(
            allocator,
            options.program,
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        command.workingDirectory = fs::Path::fromView(
            allocator,
            options.workingDirectory,
        ).asBuildError(Operation::Retain, Subject::Step(index)).?;
        match options.arguments {
            ?arguments => {
                command.arguments = collections::ArrayList[OwnedCommandArgument]::initCapacity(
                    allocator,
                    arguments.len(),
                ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                for &argument in arguments.iter() {
                    let mut owned = OwnedCommandArgument::init(allocator, argument, index).?;
                    let mut argumentTransferred = false;
                    defer if not argumentTransferred {
                        owned.deinit(allocator, index).?;
                    };
                    command.arguments.push(allocator, owned).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    argumentTransferred = true;
                }
            },
            null => {},
        }
        match options.environment {
            ?environment => {
                command.environment = collections::ArrayList[OwnedCommandEnvironmentInput]::initCapacity(
                    allocator,
                    environment.len(),
                ).asBuildError(Operation::Retain, Subject::Step(index)).?;
                for &input in environment.iter() {
                    let mut owned = OwnedCommandEnvironmentInput::init(allocator, input, index).?;
                    let mut inputTransferred = false;
                    defer if not inputTransferred {
                        owned.deinit(allocator, index).?;
                    };
                    command.environment.push(allocator, owned).asBuildError(Operation::Retain, Subject::Step(index)).?;
                    inputTransferred = true;
                }
            },
            null => {},
        }
        transferred = true;
        !command
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut firstError: ?Error = null;
        let mut elementError: ?Error = null;
        let mut environmentIndex = self.environment.len();
        while environmentIndex != 0 {
            environmentIndex -= 1;
            rememberCleanupError(
                &mut elementError,
                self.environment.asMutSlice()[environmentIndex].deinit(allocator, index),
            );
        }
        if elementError is null {
            rememberCleanupError(
                &mut firstError,
                self.environment.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
            );
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        elementError = null;
        let mut argumentIndex = self.arguments.len();
        while argumentIndex != 0 {
            argumentIndex -= 1;
            rememberCleanupError(
                &mut elementError,
                self.arguments.asMutSlice()[argumentIndex].deinit(allocator, index),
            );
        }
        if elementError is null {
            rememberCleanupError(
                &mut firstError,
                self.arguments.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
            );
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        rememberCleanupError(
            &mut firstError,
            self.workingDirectory.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        rememberCleanupError(
            &mut firstError,
            self.program.deinit(allocator).asBuildError(Operation::Release, Subject::Step(index)),
        );
        cleanupResult(firstError)
    }
}

extend Step {
    fn init(
        allocator: &mut mem::Allocator,
        name: &[char],
        kind: StepKind,
        payload: StepPayload,
        index: usize,
    ) Error!Step {
        let ownedName = string::String::fromSlice(allocator, name).asBuildError(Operation::Retain, Subject::Step(index)).?;
        !Self {
            index: index,
            name: ownedName,
            kind: kind,
            payload: payload,
        }
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut firstError: ?Error = null;
        if self.kind == StepKind::Uncacheable {
            rememberCleanupError(&mut firstError, self.payload.uncacheable.deinit(allocator, self.index));
        }
        if self.kind == StepKind::GeneratedFile {
            rememberCleanupError(&mut firstError, self.payload.generatedFile.deinit(allocator, self.index));
        }
        if self.kind == StepKind::RunExecutable or self.kind == StepKind::TestExecutable {
            rememberCleanupError(&mut firstError, self.payload.runExecutable.deinit(allocator, self.index));
        }
        if self.kind == StepKind::InstallExecutable {
            rememberCleanupError(&mut firstError, self.payload.installExecutable.deinit(allocator, self.index));
        }
        if self.kind == StepKind::InstallStaticArchive {
            rememberCleanupError(&mut firstError, self.payload.installStaticArchive.deinit(allocator, self.index));
        }
        if self.kind == StepKind::ExternalCommand {
            rememberCleanupError(&mut firstError, self.payload.externalCommand.deinit(allocator, self.index));
        }
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Step(self.index)));
        cleanupResult(firstError)
    }
}

fn validateRunArguments(arguments: ?&[&[char]], index: usize) Error!() {
    match arguments {
        ?values => {
            for &value in values.iter() {
                if runArgumentContainsNul(value) {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Step(index),
                    }!;
                }
            }
        },
        null => {},
    }
    !()
}

fn validateExternalCommand(options: ExternalCommandOptions, index: usize) Error!() {
    if options.program.len() == 0
        or runArgumentContainsNul(options.program)
        or not isValidPackagePath(options.workingDirectory.text(), true)
    {
        return invalidStep(index);
    }
    match options.resourceClass {
        ActionResourceClass::Conservative => {},
        ActionResourceClass::Cpu => {},
        ActionResourceClass::Io => {},
        _ => return invalidStep(index),
    }
    match options.environmentPolicy {
        CommandEnvironmentPolicy::Inherit => {},
        CommandEnvironmentPolicy::Clear => {},
        _ => return invalidStep(index),
    }
    match options.cachePolicy {
        CommandCachePolicy::Uncacheable => {},
        CommandCachePolicy::DeclaredInputs => {
            if options.environmentPolicy != CommandEnvironmentPolicy::Clear {
                return invalidStep(index);
            }
        },
        _ => return invalidStep(index),
    }
    match options.environment {
        ?environment => {
            let mut environmentIndex: usize = 0;
            while environmentIndex < environment.len() {
                let input = environment[environmentIndex];
                if environmentNameInvalid(input.name)
                    or runArgumentContainsNul(input.value)
                {
                    return invalidStep(index);
                }
                let mut priorIndex: usize = 0;
                while priorIndex < environmentIndex {
                    if environment[priorIndex].name.equals(input.name) {
                        return invalidStep(index);
                    }
                    priorIndex += 1;
                }
                environmentIndex += 1;
            }
        },
        null => {},
    }
    let mut hasOutput = false;
    match options.arguments {
        ?arguments => {
            for &argument in arguments.iter() {
                if argument.kind == CommandArgumentKind::ArtifactInput
                    or argument.kind == CommandArgumentKind::ObjectInput
                    or argument.kind == CommandArgumentKind::StaticArchiveInput
                {
                    continue;
                }
                let value = argument.payload.value;
                if runArgumentContainsNul(value) {
                    return invalidStep(index);
                }
                if argument.kind == CommandArgumentKind::PackageInput
                    and not isValidPackagePath(value, false)
                {
                    return invalidStep(index);
                }
                if argument.kind == CommandArgumentKind::BuildInput
                    and not isValidBuildPath(value)
                {
                    return invalidStep(index);
                }
                if argument.kind == CommandArgumentKind::BuildOutput {
                    if not isValidBuildPath(value) {
                        return invalidStep(index);
                    }
                    hasOutput = true;
                } else if not (argument.kind == CommandArgumentKind::Literal
                    or argument.kind == CommandArgumentKind::PackageInput
                    or argument.kind == CommandArgumentKind::BuildInput)
                {
                    return invalidStep(index);
                }
            }
        },
        null => {},
    }
    if options.cachePolicy == CommandCachePolicy::DeclaredInputs and not hasOutput {
        return invalidStep(index);
    }
    !()
}

fn invalidStep(index: usize) Error!() {
    Error::Invalid {
        operation: Operation::Validate,
        subject: Subject::Step(index),
    }!
}

fn isValidPackagePath(path: &[char], allowEmpty: bool) bool {
    if path.len() == 0 {
        return allowEmpty;
    }
    isValidBuildPath(path)
}

fn runArgumentContainsNul(text: &[char]) bool {
    for &ch in text.iter() {
        if ch == '\0' {
            return true;
        }
    }
    false
}

fn environmentNameInvalid(text: &[char]) bool {
    if text.len() == 0 {
        return true;
    }
    for &ch in text.iter() {
        if ch == '\0' or ch == '=' {
            return true;
        }
    }
    false
}

extend ModuleOptions {
    pub fn init(name: &[char], rootSource: fs::PathView) ModuleOptions {
        Self {
            name: name,
            sourceRoot: ModuleSourceRoot::Package,
            package: null,
            rootSource: rootSource,
            optimization: null,
            imports: null,
        }
    }

    pub fn fromPackage(
        name: &[char],
        package: PackageHandle,
        rootSource: fs::PathView,
    ) ModuleOptions {
        Self {
            name: name,
            sourceRoot: ModuleSourceRoot::Package,
            package: ?package,
            rootSource: rootSource,
            optimization: null,
            imports: null,
        }
    }

    pub fn fromBuild(name: &[char], rootSource: BuildPathView) ModuleOptions {
        Self {
            name: name,
            sourceRoot: ModuleSourceRoot::Build,
            package: null,
            rootSource: fs::PathView::init(rootSource.text()),
            optimization: null,
            imports: null,
        }
    }

    pub fn withOptimization(self, optimization: OptimizationMode) ModuleOptions {
        Self {
            name: self.name,
            sourceRoot: self.sourceRoot,
            package: self.package,
            rootSource: self.rootSource,
            optimization: ?optimization,
            imports: self.imports,
        }
    }

    pub fn withImports(self, imports: &[ModuleImport]) ModuleOptions {
        Self {
            name: self.name,
            sourceRoot: self.sourceRoot,
            package: self.package,
            rootSource: self.rootSource,
            optimization: self.optimization,
            imports: ?imports,
        }
    }
}

extend BuildPathView {
    pub fn init(path: &[char]) BuildPathView {
        Self { path: path }
    }

    pub fn text(&self) &[char] {
        self.path
    }

    fn isValid(&self) bool {
        isValidBuildPath(self.path)
    }
}

extend PackageHandle {
    pub(pkg) fn init(ownerId: usize, index: usize) PackageHandle {
        Self { ownerId: ownerId, index: index }
    }

    pub(pkg) fn ownerId(&self) usize {
        self.ownerId
    }

    pub(pkg) fn index(&self) usize {
        self.index
    }
}

extend PackageOptions {
    pub fn init(name: &[char], root: fs::PathView) PackageOptions {
        Self { name: name, root: root }
    }
}

extend Package {
    fn init(allocator: &mut mem::Allocator, options: PackageOptions, index: usize) Error!Package {
        let mut package: Package = Package {
            index: index,
            name: string::String::init(),
            root: fs::Path::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            package.deinit(allocator).?;
        };
        package.name = string::String::fromSlice(allocator, options.name).asBuildError(Operation::Retain, Subject::Package(index)).?;
        package.root = fs::Path::fromView(allocator, options.root).asBuildError(Operation::Retain, Subject::Package(index)).?;
        transferred = true;
        !package
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.root.deinit(allocator).asBuildError(Operation::Release, Subject::Package(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Package(self.index)));
        cleanupResult(firstError)
    }
}

extend Module {
    fn init(
        allocator: &mut mem::Allocator,
        options: ModuleOptions,
        optimization: OptimizationMode,
        index: usize,
        ownerId: usize,
    ) Error!Module {
        let mut moduleRecord: Module = Module {
            index: index,
            name: string::String::init(),
            sourceRoot: options.sourceRoot,
            package: match options.package {
                ?package => package,
                null => PackageHandle::init(ownerId, 0),
            },
            rootSource: fs::Path::init(),
            optimization: optimization,
            imports: collections::ArrayList[OwnedModuleImport]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            moduleRecord.deinit(allocator).?;
        };
        moduleRecord.name = string::String::fromSlice(allocator, options.name).asBuildError(Operation::Retain, Subject::Module(index)).?;
        moduleRecord.rootSource = fs::Path::fromView(allocator, options.rootSource).asBuildError(Operation::Retain, Subject::Module(index)).?;
        moduleRecord.imports = cloneModuleImports(allocator, options.imports, ownerId).?;
        transferred = true;
        !moduleRecord
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut firstError: ?Error = null;
        let mut elementError: ?Error = null;
        let mut index = self.imports.len();
        while index != 0 {
            index -= 1;
            rememberCleanupError(&mut elementError, self.imports.asMutSlice()[index].deinit(allocator));
        }
        if elementError is null {
            rememberCleanupError(&mut firstError, self.imports.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        } else {
            rememberCleanupError(&mut firstError, cleanupResult(elementError));
        }
        rememberCleanupError(&mut firstError, self.rootSource.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Module(self.index)));
        cleanupResult(firstError)
    }
}

extend ModuleImport {
    pub fn init(name: &[char], path: fs::PathView) ModuleImport {
        Self {
            name: name,
            sourceRoot: ModuleSourceRoot::Package,
            package: null,
            path: path,
        }
    }

    pub fn fromPackage(
        name: &[char],
        package: PackageHandle,
        path: fs::PathView,
    ) ModuleImport {
        Self {
            name: name,
            sourceRoot: ModuleSourceRoot::Package,
            package: ?package,
            path: path,
        }
    }

    pub fn fromBuild(name: &[char], path: BuildPathView) ModuleImport {
        Self {
            name: name,
            sourceRoot: ModuleSourceRoot::Build,
            package: null,
            path: fs::PathView::init(path.text()),
        }
    }
}

extend OwnedModuleImport {
    fn init(
        allocator: &mut mem::Allocator,
        import: ModuleImport,
        index: usize,
        ownerId: usize,
    ) Error!OwnedModuleImport {
        let mut owned: OwnedModuleImport = OwnedModuleImport {
            index: index,
            name: string::String::init(),
            sourceRoot: import.sourceRoot,
            package: match import.package {
                ?package => package,
                null => PackageHandle::init(ownerId, 0),
            },
            path: fs::Path::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            owned.deinit(allocator).?;
        };
        owned.name = string::String::fromSlice(allocator, import.name).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        owned.path = fs::Path::fromView(allocator, import.path).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        transferred = true;
        !owned
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.path.deinit(allocator).asBuildError(Operation::Release, Subject::ModuleImport(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::ModuleImport(self.index)));
        cleanupResult(firstError)
    }
}

extend ExecutableTarget {
    pub fn init(
        allocator: &mut mem::Allocator,
        options: ExecutableOptions,
        outputName: &[char],
        index: usize,
    ) Error!ExecutableTarget {
        let mut target: ExecutableTarget = ExecutableTarget {
            index: index,
            name: string::String::init(),
            rootModule: options.rootModule,
            outputName: string::String::init(),
            targetRole: options.targetRole,
            staticArchives: collections::ArrayList[StaticArchiveHandle]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            target.deinit(allocator).?;
        };
        target.name = string::String::fromSlice(allocator, options.name).asBuildError(Operation::Retain, Subject::Executable(index)).?;
        target.outputName = string::String::fromSlice(allocator, outputName).asBuildError(Operation::Retain, Subject::Executable(index)).?;
        match options.staticArchives {
            ?archives => {
                target.staticArchives.reserve(
                    allocator,
                    archives.len(),
                ).asBuildError(Operation::Retain, Subject::Executable(index)).?;
                for &archive in archives.iter() {
                    target.staticArchives.push(
                        allocator,
                        archive,
                    ).asBuildError(Operation::Retain, Subject::Executable(index)).?;
                }
            },
            null => {},
        }
        transferred = true;
        !target
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.staticArchives.deinit(allocator).asBuildError(Operation::Release, Subject::Executable(self.index)));
        rememberCleanupError(&mut firstError, self.outputName.deinit(allocator).asBuildError(Operation::Release, Subject::Executable(self.index)));
        rememberCleanupError(&mut firstError, self.name.deinit(allocator).asBuildError(Operation::Release, Subject::Executable(self.index)));
        cleanupResult(firstError)
    }
}

