using pkg::collections;
using pkg::process;
using pkg::process::command;
using pkg::process::term;
using pkg::process::types::ArgList;
using pkg::fmt;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::os;
using pkg::slice;
using pkg::string;
using pkg::build::error;
using pkg::build::types;

using error::Error;
using types::{
    Build,
    Step,
    StepFn,
    StepHandle,
    StepDependency,
    StepKind,
    StepState,
    CustomStep,
    ExecutableHandle,
    ExecutableStep,
    Module,
    ModuleHandle,
    ModuleImport,
    ModuleOptions,
    OptimizationMode,
    Runtime,
    ExecutableOptions,
    ExecutableTarget,
    StepPayload,
};

pub fn noop_step(b: &mut Build) Error!void {
    _ = b;
    !{}
}

extend Build {
    pub fn init(
        init: process::Init,
        allocator: &mut mem::Allocator,
        package_root: fs::PathView,
        build_dir: fs::PathView,
        cache_dir: fs::PathView,
        toolchain_executable: fs::PathView,
        action_reporting: bool,
        step_arg_index: usize,
    ) Build {
        {
            init: init,
            allocator: allocator,
            package_root: package_root,
            build_dir: build_dir,
            cache_dir: cache_dir,
            toolchain_executable: toolchain_executable,
            action_reporting: action_reporting,
            step_arg_index: step_arg_index,
            default_step: null,
            steps: collections::ArrayList[Step]::init(),
            dependencies: collections::ArrayList[StepDependency]::init(),
            modules: collections::ArrayList[Module]::init(),
            executables: collections::ArrayList[ExecutableTarget]::init(),
            steps_started: 0usize,
            steps_succeeded: 0usize,
            steps_failed: 0usize,
            custom_actions: 0usize,
            check_actions: 0usize,
            emit_actions: 0usize,
            compiler_invocations: 0usize,
        }
    }

    pub fn deinit(&mut self) Error!void {
        self.executables.deinit(self.allocator).as_build_error().?;
        for module_record in self.modules.as_mut_slice().iter_mut() {
            module_record.deinit(self.allocator).?;
        }
        self.modules.deinit(self.allocator).as_build_error().?;
        self.dependencies.deinit(self.allocator).as_build_error().?;
        self.steps.deinit(self.allocator).as_build_error()
    }

    pub fn io(&self) &mut io::Io[Error = os::Error] {
        self.init.io()
    }

    pub fn package_root(&self) fs::PathView {
        self.package_root
    }

    pub fn build_dir(&self) fs::PathView {
        self.build_dir
    }

    pub fn cache_dir(&self) fs::PathView {
        self.cache_dir
    }

    pub fn toolchain_executable(&self) fs::PathView {
        self.toolchain_executable
    }

    pub fn add_step(&mut self, name: &[char], run: StepFn) Error!StepHandle {
        self.add_step_record(Step::custom(string::StringView::init(name), run))
    }

    pub fn add_check_executable_step(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validate_executable_handle(target).?;
        self.add_step_record(Step::check_executable(string::StringView::init(name), target))
    }

    pub fn add_emit_executable_step(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validate_executable_handle(target).?;
        self.add_step_record(Step::emit_executable(string::StringView::init(name), target))
    }

    pub fn depend_on(&mut self, step: StepHandle, dependency: StepHandle) Error!void {
        if step.index() >= self.steps.len() or dependency.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        if step.index() == dependency.index() {
            return Error::StepCycle!;
        }
        for &edge in self.dependencies.iter() {
            if edge.step.index() == step.index() and edge.dependency.index() == dependency.index() {
                return !{};
            }
        }
        self.dependencies.push(
            self.allocator,
            StepDependency::init(step, dependency),
        ).as_build_error()
    }

    pub fn set_default_step(&mut self, step: StepHandle) Error!void {
        if step.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        self.default_step = ?step;
        !{}
    }

    pub fn add_module(&mut self, options: ModuleOptions) Error!ModuleHandle {
        validate_module_imports(options.imports).?;
        let handle = ModuleHandle::init(self.modules.len());
        let module_record = Module::init(self.allocator, options).?;
        self.modules.push(
            self.allocator,
            module_record,
        ).as_build_error().?;
        !handle
    }

    pub fn add_executable(&mut self, options: ExecutableOptions) Error!ExecutableHandle {
        if not is_valid_target_name(options.name) {
            return Error::InvalidTarget!;
        }
        self.validate_module_handle(options.root_module).?;
        if options.runtime != Runtime::Freestanding {
            return Error::InvalidTarget!;
        }
        let output_name = executable_output_name(options);
        if not is_valid_target_name(output_name) {
            return Error::InvalidTarget!;
        }
        switch self.find_executable(options.name) {
            ?old => {
                _ = old;
                return Error::InvalidTarget!;
            },
            null => {},
        }
        let handle = ExecutableHandle::init(self.executables.len());
        self.executables.push(
            self.allocator,
            ExecutableTarget::init(options, output_name),
        ).as_build_error().?;
        !handle
    }

    fn check_executable(&mut self, handle: ExecutableHandle) Error!void {
        let target = self.executable_target(handle).?;
        let mod_record = self.build_module(target.root_module).?;
        self.check_exe(mod_record, target.runtime)
    }

    fn emit_executable(&mut self, handle: ExecutableHandle) Error!void {
        let target = self.executable_target(handle).?;
        let mod_record = self.build_module(target.root_module).?;
        let mut output_path = fs::PathBuf::from_path(self.allocator, self.build_dir).as_build_error().?;
        defer output_path.deinit(self.allocator).as_build_error().?;
        output_path.join_component(self.allocator, target.output_name.text()).as_build_error().?;
        let mut output_path_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let output = output_path.encode(&mut output_path_storage[..]).as_build_error().?;
        self.emit_exe(mod_record, output, target.runtime)
    }

    fn check_exe(&mut self, mod_record: Module, runtime: Runtime) Error!void {
        let mut source_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let source_arg = mod_record.root_source.encode(&mut source_storage[..]).as_build_error().?;
        let check_arg = b"check\0";
        let runtime_arg = runtime.argv();
        let optimization_arg = mod_record.optimization.argv();
        self.run_toolchain_module_args(&[
            &check_arg[0],
            source_arg.ptr(),
            runtime_arg,
            optimization_arg,
        ], mod_record.imports, &[])
    }

    fn emit_exe(
        &mut self,
        mod_record: Module,
        output: fs::EncodedPath,
        runtime: Runtime,
    ) Error!void {
        let mut source_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let mut cache_dir_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let source_arg = mod_record.root_source.encode(&mut source_storage[..]).as_build_error().?;
        let cache_dir_arg = self.cache_dir.encode(&mut cache_dir_storage[..]).as_build_error().?;
        let emit_arg = b"emit\0";
        let exe_arg = b"--exe\0";
        let output_arg = b"-o\0";
        let cache_dir_flag = b"--cache-dir\0";
        let runtime_arg = runtime.argv();
        let optimization_arg = mod_record.optimization.argv();
        self.run_toolchain_module_args(&[
            &emit_arg[0],
            &exe_arg[0],
            source_arg.ptr(),
            runtime_arg,
            optimization_arg,
        ], mod_record.imports, &[
            &output_arg[0],
            output.ptr(),
            &cache_dir_flag[0],
            cache_dir_arg.ptr(),
        ])
    }

    fn executable_target(&self, handle: ExecutableHandle) Error!ExecutableTarget {
        if handle.index() >= self.executables.len() {
            return Error::InvalidTarget!;
        }
        !self.executables.as_slice()[handle.index()]
    }

    fn build_module(&self, handle: ModuleHandle) Error!Module {
        if handle.index() >= self.modules.len() {
            return Error::InvalidTarget!;
        }
        !self.modules.as_slice()[handle.index()]
    }

    fn run_toolchain_args(&mut self, args: &[&u8]) Error!void {
        self.compiler_invocations += 1usize;
        let term = command::run_path_args(
            self.toolchain_executable,
            args,
            self.init.raw_envp(),
        ).as_build_error().?;
        if not term.exited_success() {
            return Error::CommandFailed!;
        }
        !{}
    }

    fn run_toolchain_module_args(
        &mut self,
        head: &[&u8],
        imports: &[ModuleImport],
        tail: &[&u8],
    ) Error!void {
        static timings = b"--timings=detail\0";
        static timing_format = b"--timings-format=json\0";
        let mut import_storage: [16][os::max_path_bytes]u8 = [[0u8; os::max_path_bytes]; 16];
        let mut arg_storage: [48]&u8 = [0usize as &u8; 48];
        let mut argv = ArgList::init(&mut arg_storage[..]);
        argv.push_ptrs(head).as_build_error().?;
        append_module_import_args(&mut argv, imports, &mut import_storage[..]).?;
        argv.push_ptrs(tail).as_build_error().?;
        if self.action_reporting {
            argv.push_ptr(&timings[0]).as_build_error().?;
            argv.push_ptr(&timing_format[0]).as_build_error().?;
        }
        self.run_toolchain_args(&arg_storage[0..argv.len()])
    }

    pub fn requested_step(&self) ?process::Arg {
        self.init.args().get(self.step_arg_index)
    }

    pub fn run_requested_step(&mut self) Error!void {
        switch self.requested_step() {
            ?step => {
                switch self.find_step_arg(step) {
                    ?handle => {
                        return self.run_step(handle);
                    },
                    null => {},
                }
                self.report_unknown_step(step).?;
                return Error::UnknownStep!;
            },
            null => {},
        }
        switch self.default_step {
            ?handle => {
                return self.run_step(handle);
            },
            null => {},
        }
        if self.steps.len() != 0usize {
            return Error::MissingDefaultStep!;
        }
        !{}
    }

    fn run_step(&mut self, handle: StepHandle) Error!void {
        if handle.index() >= self.steps.len() {
            return Error::InvalidStep!;
        }
        let state = self.steps.as_slice()[handle.index()].state;
        switch state {
            StepState::Done => return !{},
            StepState::Running => return Error::StepCycle!,
            StepState::Failed => return Error::StepFailed!,
            _ => {}
        }

        self.set_step_state(handle, StepState::Running);
        self.steps_started += 1usize;

        for &edge in self.dependencies.iter() {
            if edge.step.index() == handle.index() {
                switch self.run_step(edge.dependency) {
                    !ok => {
                        _ = ok;
                    },
                    err! => {
                        self.set_step_state(handle, StepState::Failed);
                        self.steps_failed += 1usize;
                        return err!;
                    },
                }
            }
        }

        let step = self.steps.as_slice()[handle.index()];
        switch self.run_step_payload(step) {
            !ok => {
                _ = ok;
            },
            err! => {
                self.set_step_state(handle, StepState::Failed);
                self.steps_failed += 1usize;
                return err!;
            },
        }

        self.set_step_state(handle, StepState::Done);
        self.steps_succeeded += 1usize;
        !{}
    }

    fn run_step_payload(&mut self, step: Step) Error!void {
        switch step.kind {
            StepKind::Custom => {
                self.custom_actions += 1usize;
                (step.payload.custom.run)(self)
            },
            StepKind::CheckExecutable => {
                self.check_actions += 1usize;
                self.check_executable(step.payload.executable.target)
            },
            StepKind::EmitExecutable => {
                self.emit_actions += 1usize;
                self.emit_executable(step.payload.executable.target)
            },
        }
    }

    pub fn report_actions(&mut self, success: bool) Error!void {
        if not self.action_reporting {
            return !{};
        }
        let mut buffer: [1024]u8 = [_]u8[0; 1024];
        let mut stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print(
            &"{{\"schema_version\":1,\"kind\":\"nia-build-actions\",\"success\":{},\"counters\":{{\"declared_steps\":{},\"declared_dependencies\":{},\"declared_modules\":{},\"declared_executables\":{},\"steps_started\":{},\"steps_succeeded\":{},\"steps_failed\":{},\"custom_actions\":{},\"check_actions\":{},\"emit_actions\":{},\"compiler_invocations\":{}}}}}\n",
            &[
                &success,
                &self.steps.len(),
                &self.dependencies.len(),
                &self.modules.len(),
                &self.executables.len(),
                &self.steps_started,
                &self.steps_succeeded,
                &self.steps_failed,
                &self.custom_actions,
                &self.check_actions,
                &self.emit_actions,
                &self.compiler_invocations,
            ],
        ).as_build_error().?;
        stderr.flush().as_build_error()
    }

    fn set_step_state(&mut self, handle: StepHandle, state: StepState) void {
        let mut steps = self.steps.as_mut_slice();
        steps[handle.index()].state = state;
    }

    fn find_step(&self, name: string::StringView) ?Step {
        for &step in self.steps.iter() {
            if mem::equal[char](step.name.text(), name.text()) {
                return ?step;
            }
        }
        null
    }

    fn find_step_arg(&self, arg: process::Arg) ?StepHandle {
        let mut index = 0usize;
        for &step in self.steps.iter() {
            if arg_matches_text(arg, step.name.text()) {
                return ?StepHandle::init(index);
            }
            index += 1usize;
        }
        null
    }

    fn find_executable(&self, name: string::StringView) ?ExecutableTarget {
        for &target in self.executables.iter() {
            if mem::equal[char](target.name.text(), name.text()) {
                return ?target;
            }
        }
        null
    }

    fn validate_executable_handle(&self, handle: ExecutableHandle) Error!void {
        if handle.index() >= self.executables.len() {
            return Error::InvalidTarget!;
        }
        !{}
    }

    fn validate_module_handle(&self, handle: ModuleHandle) Error!void {
        if handle.index() >= self.modules.len() {
            return Error::InvalidTarget!;
        }
        !{}
    }

    fn report_unknown_step(&mut self, step: process::Arg) Error!void {
        let mut buffer: [256]u8 = [_]u8[0; 256];
        let mut stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print(&"unknown build step `{}`\n", &[&step]).as_build_error().?;
        stderr.flush().as_build_error()
    }

    fn add_step_record(&mut self, step: Step) Error!StepHandle {
        if step.name.len() == 0usize {
            return Error::InvalidStep!;
        }
        switch self.find_step(step.name) {
            ?old => {
                _ = old;
                return Error::InvalidStep!;
            },
            null => {},
        }
        let handle = StepHandle::init(self.steps.len());
        self.steps.push(self.allocator, step).as_build_error().?;
        !handle
    }
}

extend StepHandle {
    fn init(index: usize) StepHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend ExecutableHandle {
    fn init(index: usize) ExecutableHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend ModuleHandle {
    fn init(index: usize) ModuleHandle {
        { index: index }
    }

    fn index(&self) usize {
        self.index
    }
}

extend StepDependency {
    pub fn init(step: StepHandle, dependency: StepHandle) StepDependency {
        { step: step, dependency: dependency }
    }
}

extend CustomStep {
    fn init(run: StepFn) CustomStep {
        { run: run }
    }
}

extend ExecutableStep {
    fn init(target: ExecutableHandle) ExecutableStep {
        { target: target }
    }
}

extend Step {
    fn init(name: string::StringView, kind: StepKind, payload: StepPayload) Step {
        {
            name: name,
            kind: kind,
            payload: payload,
            state: StepState::Pending,
        }
    }

    fn custom(name: string::StringView, run: StepFn) Step {
        Step::init(name, StepKind::Custom, { custom: CustomStep::init(run) })
    }

    fn check_executable(name: string::StringView, target: ExecutableHandle) Step {
        Step::init(name, StepKind::CheckExecutable, { executable: ExecutableStep::init(target) })
    }

    fn emit_executable(name: string::StringView, target: ExecutableHandle) Step {
        Step::init(name, StepKind::EmitExecutable, { executable: ExecutableStep::init(target) })
    }
}

extend ModuleOptions {
    pub fn init(root_source: fs::PathView) ModuleOptions {
        {
            root_source: root_source,
            optimization: OptimizationMode::O2,
            imports: null,
        }
    }

    pub fn with_optimization(self, optimization: OptimizationMode) ModuleOptions {
        {
            root_source: self.root_source,
            optimization: optimization,
            imports: self.imports,
        }
    }

    pub fn with_imports(self, imports: &[ModuleImport]) ModuleOptions {
        {
            root_source: self.root_source,
            optimization: self.optimization,
            imports: ?imports,
        }
    }
}

extend Module {
    pub fn init(allocator: &mut mem::Allocator, options: ModuleOptions) Error!Module {
        let imports = clone_module_imports(allocator, options.imports).?;
        !{
            root_source: options.root_source,
            optimization: options.optimization,
            imports: imports,
        }
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        allocator.free_slice[ModuleImport](self.imports).as_build_error()
    }
}

extend ModuleImport {
    pub fn init(name: &[char], path: fs::PathView) ModuleImport {
        {
            name: string::StringView::init(name),
            path: path,
        }
    }
}

extend ExecutableTarget {
    pub fn init(options: ExecutableOptions, output_name: string::StringView) ExecutableTarget {
        {
            name: options.name,
            root_module: options.root_module,
            output_name: output_name,
            runtime: options.runtime,
        }
    }
}

extend ExecutableOptions {
    pub fn init(name: &[char], root_module: ModuleHandle) ExecutableOptions {
        {
            name: string::StringView::init(name),
            root_module: root_module,
            output_name: null,
            runtime: Runtime::Freestanding,
        }
    }

    pub fn with_output_name(self, output_name: &[char]) ExecutableOptions {
        {
            name: self.name,
            root_module: self.root_module,
            output_name: ?string::StringView::init(output_name),
            runtime: self.runtime,
        }
    }

    pub fn with_runtime(self, runtime: Runtime) ExecutableOptions {
        {
            name: self.name,
            root_module: self.root_module,
            output_name: self.output_name,
            runtime: runtime,
        }
    }
}

fn executable_output_name(options: ExecutableOptions) string::StringView {
    if options.output_name is ?name {
        name
    } else {
        options.name
    }
}

extend OptimizationMode {
    fn argv(self) &u8 {
        static o0 = b"-O0\0";
        static o1 = b"-O1\0";
        static o2 = b"-O2\0";
        static o3 = b"-O3\0";
        static os = b"-Os\0";
        static oz = b"-Oz\0";
        switch self {
            OptimizationMode::O0 => &o0[0],
            OptimizationMode::O1 => &o1[0],
            OptimizationMode::O2 => &o2[0],
            OptimizationMode::O3 => &o3[0],
            OptimizationMode::Os => &os[0],
            OptimizationMode::Oz => &oz[0],
            _ => &o2[0],
        }
    }
}

extend Runtime {
    fn argv(self) &u8 {
        static bare = b"--runtime=bare\0";
        static freestanding = b"--runtime=freestanding\0";
        switch self {
            Runtime::Bare => &bare[0],
            Runtime::Freestanding => &freestanding[0],
            _ => &freestanding[0],
        }
    }
}

fn is_valid_target_name(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    for &ch in text.iter() {
        let code = ch as u32;
        if code == 0u32 or code == 47u32 or code == 92u32 {
            return false;
        }
    }
    true
}

fn validate_module_imports(imports: ?&[ModuleImport]) Error!void {
    switch imports {
        ?items => {
            for &import in items.iter() {
                if not is_valid_module_import_name(import.name) {
                    return Error::InvalidTarget!;
                }
            }
        },
        null => {},
    }
    !{}
}

fn clone_module_imports(
    allocator: &mut mem::Allocator,
    imports: ?&[ModuleImport],
) Error!&mut [ModuleImport] {
    switch imports {
        ?items => {
            if items.len() == 0usize {
                let mut empty = 1usize as &mut ModuleImport;
                return !&mut empty[0..0];
            }
            let mut owned = allocator.alloc_slice[ModuleImport](items.len()).as_build_error().?;
            mem::copy_forwards[ModuleImport](owned, items);
            !owned
        },
        null => {
            let mut empty = 1usize as &mut ModuleImport;
            !&mut empty[0..0]
        },
    }
}

fn is_valid_module_import_name(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    if mem::equal[char](text, &"entry") or mem::equal[char](text, &"pkg") {
        return false;
    }
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48u32 and code <= 57u32)
            or (code >= 65u32 and code <= 90u32)
            or (code >= 97u32 and code <= 122u32)
            or code == 95u32
            or code == 45u32;
        if not valid {
            return false;
        }
    }
    true
}

fn append_module_import_args(
    argv: &mut ArgList,
    imports: &[ModuleImport],
    storage: &mut [[os::max_path_bytes]u8],
) Error!void {
    if imports.len() > 16usize {
        return Error::InvalidTarget!;
    }
    static module_flag = b"--module\0";
    let mut index = 0usize;
    for &import in imports.iter() {
        argv.push_ptr(&module_flag[0]).as_build_error().?;
        let arg = encode_module_import(import, &mut storage[index][..]).?;
        argv.push_ptr(arg.ptr()).as_build_error().?;
        index += 1usize;
    }
    !{}
}

fn encode_module_import(import: ModuleImport, storage: &mut [u8]) Error!fs::EncodedPath {
    let mut out = 0usize;
    out = append_chars_to_bytes(import.name.text(), storage, out).?;
    if out >= storage.len() {
        return Error::InvalidTarget!;
    }
    storage[out] = b'=';
    out += 1usize;
    out = append_chars_to_bytes(import.path.text(), storage, out).?;
    if out >= storage.len() {
        return Error::InvalidTarget!;
    }
    storage[out] = 0u8;
    !fs::EncodedPath::init(storage.ptr(), out)
}

fn append_chars_to_bytes(text: &[char], storage: &mut [u8], start: usize) Error!usize {
    let mut out = start;
    for &ch in text.iter() {
        if ch as u32 == 0u32 {
            return Error::InvalidTarget!;
        }
        let encoded = ch.encode_utf8();
        let bytes = encoded.bytes();
        for &byte in bytes.iter() {
            if out >= storage.len() {
                return Error::InvalidTarget!;
            }
            storage[out] = byte;
            out += 1usize;
        }
    }
    !out
}

fn arg_matches_text(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    let mut byte_index = 0usize;
    for &ch in text.iter() {
        let encoded = ch.encode_utf8();
        let encoded_bytes = encoded.bytes();
        for &encoded_byte in encoded_bytes.iter() {
            if byte_index >= bytes.len() or bytes[byte_index] != encoded_byte {
                return false;
            }
            byte_index += 1usize;
        }
    }
    byte_index == bytes.len()
}
