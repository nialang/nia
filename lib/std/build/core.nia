extend Build {
    pub fn packageRoot(&self) fs::PathView {
        self.paths.packageRoot.view()
    }

    pub fn rootPackage(&self) PackageHandle {
        PackageHandle::init(self.ownerId, 0)
    }

    pub fn addPackage(&mut self, options: PackageOptions) Error!PackageHandle {
        self.cleanupPendingPackage().?;
        let packageIndex = match self.packages.len().checkedAdd(1) {
            ?value => value,
            null => return Error::Failure {
                operation: Operation::Retain,
                subject: Subject::Packages,
                cause: error::ErrorCause::Memory(mem::Error::OutOfMemory),
            }!,
        };
        let handle = PackageHandle::init(self.ownerId, packageIndex);
        if options.name.equals(&"root")
            or not isValidStableName(options.name)
            or not isValidPackagePath(options.root.text(), false)
        {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Package(handle.index()),
            }!;
        }
        for &package in self.packages.iter() {
            if package.name.equals(options.name) or package.root.view().text().equals(options.root.text()) {
                return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Package(handle.index()),
                }!;
            }
        }
        self.packages.reserve(self.allocator, 1usize).withBuildContext(Operation::Retain, Subject::Packages).?;
        self.pendingPackage = Package::init(handle.index());
        self.hasPendingPackage = true;
        match self.pendingPackage.initialize(self.allocator, options) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingPackage();
                return primary!;
            },
        }
        self.packages.appendAssumeCapacity(self.pendingPackage);
        self.hasPendingPackage = false;
        self.planValidated = false;
        !handle
    }

    pub(pkg) fn cleanupPendingPackage(&mut self) Error!() {
        if not self.hasPendingPackage {
            return !();
        }
        self.pendingPackage.deinit(self.allocator).?;
        self.hasPendingPackage = false;
        !()
    }

    pub fn buildDir(&self) fs::PathView {
        self.paths.buildDir.view()
    }

    pub fn cacheDir(&self) fs::PathView {
        self.paths.cacheDir.view()
    }

    pub fn toolchainExecutable(&self) fs::PathView {
        self.paths.toolchainExecutable.view()
    }

    pub fn toolchainResourceRoot(&self) fs::PathView {
        self.paths.toolchainResourceRoot.view()
    }

    pub fn hostTarget(&self) TargetView {
        self.hostTarget.view()
    }

    pub fn artifactTarget(&self) TargetView {
        self.artifactTarget.view()
    }

    // Steps declare graph work only. Execution, process ownership, output
    // publication, caching, and cancellation belong to the Rust coordinator.
    pub fn addAggregateStep(&mut self, name: &[char]) Error!StepHandle {
        self.addStepRecord(name, StepKind::Aggregate, StepPayload { aggregate: .init() })
    }

    pub fn addUncacheableStep(&mut self, name: &[char], description: &[char]) Error!StepHandle {
        self.preparePendingStep(name, StepKind::Uncacheable).?;
        match self.pendingStep.initializeUncacheable(self.allocator, name, description) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        self.commitPendingStep()
    }

    pub fn addGeneratedFileStep(&mut self, name: &[char], output: BuildPathView, contents: &[u8]) Error!StepHandle {
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        if not output.isValid() or contents.len() > 67108864 {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(handle.index()),
            }!;
        }
        self.preparePendingStep(name, StepKind::GeneratedFile).?;
        match self.pendingStep.initializeGeneratedFile(
            self.allocator,
            name,
            output,
            contents,
        ) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        self.commitPendingStep()
    }

    pub fn addCheckExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        self.addStepRecord(name, StepKind::CheckExecutable, StepPayload { executable: ExecutableStep::init(target) })
    }

    pub fn addEmitExecutableStep(&mut self, name: &[char], target: ExecutableHandle) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        let archiveCount = self.executables.asSlice()[target.index()].staticArchives.len();
        self.dependencies.reserve(
            self.allocator,
            archiveCount,
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        let mut archiveIndex: usize = 0;
        while archiveIndex < archiveCount {
            let archive = self.executables.asSlice()[target.index()]
                .staticArchives.asSlice()[archiveIndex];
            match self.findEmitStaticArchiveStep(archive) {
                ?producer => _ = producer,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(self.steps.len()),
                }!,
            }
            archiveIndex += 1;
        }
        let result = self.addStepRecord(
            name,
            StepKind::EmitExecutable,
            StepPayload { executable: ExecutableStep::init(target) },
        ).?;
        let dependencyStart = self.dependencies.len();
        match self.addExecutableArchiveDependencies(result, target) {
            !ok => {
                _ = ok;
                !result
            },
            primary! => {
                while self.dependencies.len() > dependencyStart {
                    _ = self.dependencies.pop();
                }
                _ = self.rollbackLastStep();
                primary!
            },
        }
    }

    fn addExecutableArchiveDependencies(
        &mut self,
        step: StepHandle,
        target: ExecutableHandle,
    ) Error!() {
        let archives = self.executables.asSlice()[target.index()].staticArchives.asSlice();
        for &archive in archives.iter() {
            let producer = match self.findEmitStaticArchiveStep(archive) {
                ?producer => producer,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Step(step.index()),
                }!,
            };
            self.dependOn(step, producer).?;
        }
        !()
    }

    pub fn addEmitObjectStep(&mut self, name: &[char], target: ObjectHandle) Error!StepHandle {
        self.validateObjectHandle(target).?;
        self.addStepRecord(name, StepKind::EmitObject, StepPayload { object: ObjectStep::init(target) })
    }

    pub fn addEmitStaticArchiveStep(&mut self, name: &[char], target: StaticArchiveHandle) Error!StepHandle {
        self.validateStaticArchiveHandle(target).?;
        self.addStepRecord(name, StepKind::EmitStaticArchive, StepPayload { staticArchive: StaticArchiveStep::init(target) })
    }

    pub fn addRunExecutableStep(&mut self, name: &[char], options: RunOptions) Error!StepHandle {
        self.validateExecutableHandle(options.target).?;
        let producer = match self.findEmitStep(options.target) {
            ?producer => producer,
            null => return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!,
        };
        self.validateRunnableExecutable(options.target, self.steps.len()).?;
        validateRunArguments(options.arguments, self.steps.len()).?;
        self.addRunStepRecord(name, options, StepKind::RunExecutable, producer)
    }

    pub fn addTestExecutableStep(&mut self, name: &[char], options: RunOptions) Error!StepHandle {
        self.validateExecutableHandle(options.target).?;
        let producer = match self.findEmitStep(options.target) {
            ?producer => producer,
            null => return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!,
        };
        self.validateRunnableExecutable(options.target, self.steps.len()).?;
        validateRunArguments(options.arguments, self.steps.len()).?;
        self.addRunStepRecord(name, options, StepKind::TestExecutable, producer)
    }

    fn addRunStepRecord(
        &mut self,
        name: &[char],
        options: RunOptions,
        kind: StepKind,
        producer: StepHandle,
    ) Error!StepHandle {
        self.preparePendingRunStep(name, kind, options.target).?;
        match self.pendingStep.initializeRunExecutable(
            self.allocator,
            name,
            options.arguments,
        ) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        let result = self.commitPendingStep().?;
        self.finishStepDependency(result, producer)
    }

    pub fn addInstallExecutableStep(
        &mut self,
        name: &[char],
        target: ExecutableHandle,
        destination: BuildPathView,
    ) Error!StepHandle {
        self.validateExecutableHandle(target).?;
        if not destination.isValid() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        let producer = match self.findEmitStep(target) {
            ?producer => producer,
            null => return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!,
        };
        self.prepareInstallExecutableStep(name, target).?;
        match self.pendingStep.initializeInstallExecutable(
            self.allocator,
            name,
            destination,
        ) {
            !ok => _ = ok,
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        let result = self.commitPendingStep().?;
        self.finishStepDependency(result, producer)
    }

    pub fn addInstallStaticArchiveStep(
        &mut self,
        name: &[char],
        target: StaticArchiveHandle,
        destination: BuildPathView,
    ) Error!StepHandle {
        self.validateStaticArchiveHandle(target).?;
        if not destination.isValid() {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        let producer = match self.findEmitStaticArchiveStep(target) {
            ?producer => producer,
            null => return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!,
        };
        self.prepareInstallStaticArchiveStep(name, target).?;
        match self.pendingStep.initializeInstallStaticArchive(
            self.allocator,
            name,
            destination,
        ) {
            !ok => _ = ok,
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        let result = self.commitPendingStep().?;
        self.finishStepDependency(result, producer)
    }

    pub fn addExternalCommandStep(&mut self, name: &[char], options: ExternalCommandOptions) Error!StepHandle {
        validateExternalCommand(options, self.steps.len()).?;
        let mut artifactInputCount: usize = 0;
        if options.arguments is ?arguments {
            for &argument in arguments.iter() {
                if argument.kind == CommandArgumentKind::ArtifactInput {
                        let target = argument.payload.artifact;
                        self.validateExecutableHandle(target).?;
                        match self.findEmitStep(target) {
                            ?producer => _ = producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(self.steps.len()),
                            }!,
                        }
                        artifactInputCount += 1;
                } else if argument.kind == CommandArgumentKind::ObjectInput {
                        let target = argument.payload.object;
                        self.validateObjectHandle(target).?;
                        match self.findEmitObjectStep(target) {
                            ?producer => _ = producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(self.steps.len()),
                            }!,
                        }
                        artifactInputCount += 1;
                } else if argument.kind == CommandArgumentKind::StaticArchiveInput {
                        let target = argument.payload.staticArchive;
                        self.validateStaticArchiveHandle(target).?;
                        match self.findEmitStaticArchiveStep(target) {
                            ?producer => _ = producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(self.steps.len()),
                            }!,
                        }
                        artifactInputCount += 1;
                } else if argument.kind == CommandArgumentKind::PackageInput {
                        self.validatePackageHandle(argument.package).?;
                }
            }
        }
        self.dependencies.reserve(
            self.allocator,
            artifactInputCount,
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        self.prepareExternalCommandStep(name, options).?;
        match self.pendingStep.initializeExternalCommand(self.allocator, name, options) {
            !ok => _ = ok,
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        let result = self.commitPendingStep().?;
        let dependencyStart = self.dependencies.len();
        match self.addExternalCommandDependencies(result, options.arguments) {
            !ok => {
                _ = ok;
                !result
            },
            primary! => {
                while self.dependencies.len() > dependencyStart {
                    _ = self.dependencies.pop();
                }
                _ = self.rollbackLastStep();
                primary!
            },
        }
    }

    fn addExternalCommandDependencies(
        &mut self,
        step: StepHandle,
        arguments: ?&[CommandArgument],
    ) Error!() {
        if arguments is ?arguments {
            for &argument in arguments.iter() {
                if argument.kind == CommandArgumentKind::ArtifactInput {
                        let producer = match self.findEmitStep(argument.payload.artifact) {
                            ?producer => producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(step.index()),
                            }!,
                        };
                        self.dependOn(step, producer).?;
                } else if argument.kind == CommandArgumentKind::ObjectInput {
                        let producer = match self.findEmitObjectStep(argument.payload.object) {
                            ?producer => producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(step.index()),
                            }!,
                        };
                        self.dependOn(step, producer).?;
                } else if argument.kind == CommandArgumentKind::StaticArchiveInput {
                        let producer = match self.findEmitStaticArchiveStep(argument.payload.staticArchive) {
                            ?producer => producer,
                            null => return Error::Invalid {
                                operation: Operation::Validate,
                                subject: Subject::Step(step.index()),
                            }!,
                        };
                        self.dependOn(step, producer).?;
                }
            }
        }
        !()
    }

    pub fn dependOn(&mut self, step: StepHandle, dependency: StepHandle) Error!() {
        self.validateStepHandle(step).?;
        self.validateStepHandle(dependency).?;
        if step.index() == dependency.index() {
            return Error::StepCycle {
                step: step.index(),
                dependency: dependency.index(),
            }!;
        }
        for &edge in self.dependencies.iter() {
            if edge.step.index() == step.index() and edge.dependency.index() == dependency.index() {
                return !();
            }
        }
        self.dependencies.push(
            self.allocator,
            StepDependency::init(step, dependency),
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        self.planValidated = false;
        !()
    }

    pub fn setDefaultStep(&mut self, step: StepHandle) Error!() {
        self.validateStepHandle(step).?;
        self.defaultStep = ?step;
        self.planValidated = false;
        !()
    }

    // Modules and artifacts retain borrowed descriptors as owned plan records.
    // Build-rooted source paths are generated inputs and gain producer edges
    // during complete-graph validation.
    pub fn addModule(&mut self, options: ModuleOptions) Error!ModuleHandle {
        self.cleanupPendingModule().?;
        let handle = ModuleHandle::init(self.ownerId, self.modules.len());

        if options.sourceRoot == ModuleSourceRoot::Package {
            if options.package is ?package {
                self.validatePackageHandle(package).?;
            }
        }
        if options.imports is ?imports {
            for &import in imports.iter() {
                if import.sourceRoot == ModuleSourceRoot::Package {
                    if import.package is ?package {
                        self.validatePackageHandle(package).?;
                    }
                }
            }
        }
        validateModuleImports(options.imports).?;

        if options.sourceRoot == ModuleSourceRoot::Build
            and not isValidBuildPath(options.rootSource.text())
        {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(handle.index()),
            }!;
        }
        if self.findModule(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Module(handle.index()),
            }!;
        }
        let optimization = match options.optimization {
            ?optimization => optimization,
            null => self.defaultOptimization,
        };
        self.modules.reserve(self.allocator, 1usize).withBuildContext(Operation::Retain, Subject::Modules).?;
        self.pendingModule = Module::init(
            handle.index(),
            options.sourceRoot,
            match options.package {
                ?package => package,
                null => PackageHandle::init(self.ownerId, 0usize),
            },
            optimization,
        );
        self.hasPendingModule = true;
        match self.pendingModule.initialize(
            self.allocator,
            options.name,
            options.rootSource,
            options.imports,
            self.ownerId,
        ) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingModule();
                return primary!;
            },
        }
        self.modules.appendAssumeCapacity(self.pendingModule);
        self.hasPendingModule = false;
        self.planValidated = false;
        !handle
    }

    pub(pkg) fn cleanupPendingModule(&mut self) Error!() {
        if not self.hasPendingModule {
            return !();
        }
        self.pendingModule.deinit(self.allocator).?;
        self.hasPendingModule = false;
        !()
    }

    pub fn addExecutable(&mut self, options: ExecutableOptions) Error!ExecutableHandle {
        self.cleanupPendingExecutable().?;
        let handle = ExecutableHandle::init(self.ownerId, self.executables.len());
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        self.validateModuleHandle(options.rootModule).?;
        if options.staticArchives is ?archives {
            let mut archiveIndex: usize = 0;
            while archiveIndex < archives.len() {
                let archive = archives[archiveIndex];
                self.validateStaticArchiveHandle(archive).?;
                let archiveTarget = self.staticArchives.asSlice()[archive.index()];
                if archiveTarget.targetRole != options.targetRole {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Executable(handle.index()),
                    }!;
                }
                let mut previous: usize = 0;
                while previous < archiveIndex {
                    if archives[previous].index() == archive.index() {
                        return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Executable(handle.index()),
                        }!;
                    }
                    previous += 1;
                }
                archiveIndex += 1;
            }
        }
        let outputName = executableOutputName(options);
        if not isValidOutputName(outputName) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Executable(handle.index()),
            }!;
        }
        if self.findExecutable(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Executable(handle.index()),
            }!;
        }
        if self.findObject(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Executable(handle.index()),
            }!;
        }
        if self.findStaticArchive(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Executable(handle.index()),
            }!;
        }
        self.executables.reserve(self.allocator, 1usize).withBuildContext(Operation::Retain, Subject::Executables).?;
        self.pendingExecutable = ExecutableTarget::init(
            handle.index(),
            options.rootModule,
            options.targetRole,
        );
        self.hasPendingExecutable = true;
        match self.pendingExecutable.initialize(
            self.allocator,
            options.name,
            outputName,
            options.staticArchives,
        ) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingExecutable();
                return primary!;
            },
        }
        self.executables.appendAssumeCapacity(self.pendingExecutable);
        self.hasPendingExecutable = false;
        self.planValidated = false;
        !handle
    }

    pub(pkg) fn cleanupPendingExecutable(&mut self) Error!() {
        if not self.hasPendingExecutable {
            return !();
        }
        self.pendingExecutable.deinit(self.allocator).?;
        self.hasPendingExecutable = false;
        !()
    }

    pub fn addObject(&mut self, options: ObjectOptions) Error!ObjectHandle {
        self.cleanupPendingObject().?;
        let handle = ObjectHandle::init(self.ownerId, self.objects.len());
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Object(handle.index()),
            }!;
        }
        self.validateModuleHandle(options.rootModule).?;
        let outputName = objectOutputName(options);
        if not isValidOutputName(outputName) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Object(handle.index()),
            }!;
        }
        if self.findObject(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Object(handle.index()),
            }!;
        }
        if self.findExecutable(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Object(handle.index()),
            }!;
        }
        if self.findStaticArchive(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Object(handle.index()),
            }!;
        }
        self.objects.reserve(self.allocator, 1usize).withBuildContext(Operation::Retain, Subject::Objects).?;
        self.pendingObject = ObjectTarget::init(
            handle.index(),
            options.rootModule,
            options.targetRole,
        );
        self.hasPendingObject = true;
        match self.pendingObject.initialize(self.allocator, options.name, outputName) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingObject();
                return primary!;
            },
        }
        self.objects.appendAssumeCapacity(self.pendingObject);
        self.hasPendingObject = false;
        self.planValidated = false;
        !handle
    }

    pub(pkg) fn cleanupPendingObject(&mut self) Error!() {
        if not self.hasPendingObject {
            return !();
        }
        self.pendingObject.deinit(self.allocator).?;
        self.hasPendingObject = false;
        !()
    }

    pub fn addStaticArchive(&mut self, options: StaticArchiveOptions) Error!StaticArchiveHandle {
        self.cleanupPendingStaticArchive().?;
        let handle = StaticArchiveHandle::init(self.ownerId, self.staticArchives.len());
        if not isValidStableName(options.name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::StaticArchive(handle.index()),
            }!;
        }
        self.validateModuleHandle(options.rootModule).?;
        let outputName = staticArchiveOutputName(options);
        if not isValidOutputName(outputName) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::StaticArchive(handle.index()),
            }!;
        }
        if self.findStaticArchive(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .StaticArchive(handle.index()),
            }!;
        }
        if self.findExecutable(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .StaticArchive(handle.index()),
            }!;
        }
        if self.findObject(options.name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .StaticArchive(handle.index()),
            }!;
        }
        self.staticArchives.reserve(self.allocator, 1usize).withBuildContext(Operation::Retain, Subject::StaticArchives).?;
        self.pendingStaticArchive = StaticArchiveTarget::init(
            handle.index(),
            options.rootModule,
            options.targetRole,
        );
        self.hasPendingStaticArchive = true;
        match self.pendingStaticArchive.initialize(self.allocator, options.name, outputName) {
            !ok => {
                _ = ok;
            },
            primary! => {
                _ = self.cleanupPendingStaticArchive();
                return primary!;
            },
        }
        self.staticArchives.appendAssumeCapacity(self.pendingStaticArchive);
        self.hasPendingStaticArchive = false;
        self.planValidated = false;
        !handle
    }

    pub(pkg) fn cleanupPendingStaticArchive(&mut self) Error!() {
        if not self.hasPendingStaticArchive {
            return !();
        }
        self.pendingStaticArchive.deinit(self.allocator).?;
        self.hasPendingStaticArchive = false;
        !()
    }

    pub fn requestedStep(&self) ?&[char] {
        if self.hasRequestedStep {
            ?self.requestedStep.text()
        } else {
            null
        }
    }

    pub fn validatePlan(&mut self) Error!() {
        if self.planValidated {
            return !();
        }
        self.selectedStep = null;
        match self.requestedStep() {
            ?step => {
                match self.findStep(step) {
                    ?selected => {
                        self.selectedStep = ?StepHandle::init(self.ownerId, selected.index);
                    },
                    null => {
                        self.reportUnknownStep(step).?;
                        return Error::UnknownStep!;
                    },
                }
            },
            null => {
                match self.defaultStep {
                    ?handle => {
                        self.selectedStep = ?handle;
                    },
                    null => {
                        if self.steps.len() != 0 {
                            return Error::MissingDefaultStep!;
                        }
                    },
                }
            },
        }
        self.ensureGeneratedModuleDependencies().?;
        self.validateDependencyGraph().?;
        self.planValidated = true;
        !()
    }

    fn ensureGeneratedModuleDependencies(&mut self) Error!() {
        let mut missingCount: usize = 0;
        let mut index: usize = 0;
        while index < self.steps.len() {
            let missing = self.missingGeneratedDependenciesForStep(index).?;
            missingCount = match missingCount.checkedAdd(missing) {
                ?value => value,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Dependencies,
                }!,
            };
            index += 1;
        }
        self.dependencies.reserve(
            self.allocator,
            missingCount,
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        index = 0;
        while index < self.steps.len() {
            self.addGeneratedDependenciesForStep(index).?;
            index += 1;
        }
        !()
    }

    fn compilerModuleIndexForStep(&self, index: usize) ?usize {
        let step = self.steps.asSlice()[index];
        match step.kind {
            .CheckExecutable => ?self.executables.asSlice()[
                step.payload.executable.target.index()
            ].rootModule.index(),
            .EmitExecutable => ?self.executables.asSlice()[
                step.payload.executable.target.index()
            ].rootModule.index(),
            .EmitObject => ?self.objects.asSlice()[
                step.payload.object.target.index()
            ].rootModule.index(),
            .EmitStaticArchive => ?self.staticArchives.asSlice()[
                step.payload.staticArchive.target.index()
            ].rootModule.index(),
            .TestExecutable => ?self.executables.asSlice()[
                step.payload.runExecutable.target.index()
            ].rootModule.index(),
            _ => null,
        }
    }

    fn missingGeneratedDependenciesForStep(&self, index: usize) Error!usize {
        let moduleIndex = match self.compilerModuleIndexForStep(index) {
            ?moduleIndex => moduleIndex,
            null => return !0,
        };
        let moduleRecord = self.modules.asSlice()[moduleIndex];
        let mut count: usize = 0;
        if moduleRecord.sourceRoot == ModuleSourceRoot::Build {
            let producer = self.requireGeneratedSourceProducer(
                moduleRecord.rootSource.text(),
                index,
                moduleIndex,
            ).?;
            if not hasDependency(self.dependencies.asSlice(), index, producer.index()) {
                count = match count.checkedAdd(1) {
                    ?value => value,
                    null => return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::Dependencies,
                    }!,
                };
            }
        }
        for &import in moduleRecord.imports.iter() {
            if import.sourceRoot == ModuleSourceRoot::Build {
                let producer = self.requireGeneratedSourceProducer(
                    import.path.text(),
                    index,
                    moduleIndex,
                ).?;
                if not hasDependency(self.dependencies.asSlice(), index, producer.index()) {
                    count = match count.checkedAdd(1) {
                        ?value => value,
                        null => return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::Dependencies,
                        }!,
                    };
                }
            }
        }
        !count
    }

    fn addGeneratedDependenciesForStep(&mut self, index: usize) Error!() {
        let moduleIndex = match self.compilerModuleIndexForStep(index) {
            ?moduleIndex => moduleIndex,
            null => return !(),
        };
        let moduleRecord = self.modules.asSlice()[moduleIndex];
        if moduleRecord.sourceRoot == ModuleSourceRoot::Build {
            let producer = self.requireGeneratedSourceProducer(
                moduleRecord.rootSource.text(),
                index,
                moduleIndex,
            ).?;
            self.dependOn(StepHandle::init(self.ownerId, index), producer).?;
        }
        let mut importIndex: usize = 0;
        while importIndex < moduleRecord.imports.len() {
            let import = moduleRecord.imports.asSlice()[importIndex];
            if import.sourceRoot == ModuleSourceRoot::Build {
                let producer = self.requireGeneratedSourceProducer(
                    import.path.text(),
                    index,
                    moduleIndex,
                ).?;
                self.dependOn(StepHandle::init(self.ownerId, index), producer).?;
            }
            importIndex += 1;
        }
        !()
    }

    fn requireGeneratedSourceProducer(
        &self,
        path: &[char],
        consumerIndex: usize,
        moduleIndex: usize,
    ) Error!StepHandle {
        match findGeneratedSourceProducer(self.ownerId, self.steps.asSlice(), path, consumerIndex) {
            ?producer => !producer,
            null => Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Module(moduleIndex),
            }!,
        }
    }

    fn validateDependencyGraph(&mut self) Error!() {
        self.cleanupValidationScratch().?;
        let operation = self.validateDependencyGraphWithScratch();
        let cleanup = self.cleanupValidationScratch();
        match operation {
            !ok => {
                _ = ok;
                cleanup
            },
            primary! => {
                _ = cleanup;
                primary!
            },
        }
    }

    fn validateDependencyGraphWithScratch(&mut self) Error!() {
        self.validationIndegree = collections::ArrayList[usize]::initCapacity(
            self.allocator,
            self.steps.len(),
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        let mut index: usize = 0;
        while index < self.steps.len() {
            self.validationIndegree.push(self.allocator, 0).withBuildContext(Operation::Retain, Subject::Dependencies).?;
            index += 1;
        }
        for &edge in self.dependencies.iter() {
            let slot = &mut self.validationIndegree.asMutSlice()[edge.step.index()];
            slot.* = match slot.*.checkedAdd(1) {
                ?value => value,
                null => return Error::Invalid {
                    operation: Operation::Validate,
                    subject: Subject::Dependencies,
                }!,
            };
        }

        self.validationReady = collections::ArrayList[usize]::initCapacity(
            self.allocator,
            self.steps.len(),
        ).withBuildContext(Operation::Retain, Subject::Dependencies).?;
        index = 0;
        while index < self.validationIndegree.len() {
            if self.validationIndegree.asSlice()[index] == 0 {
                self.validationReady.push(self.allocator, index).withBuildContext(Operation::Retain, Subject::Dependencies).?;
            }
            index += 1;
        }

        let mut cursor: usize = 0;
        while cursor < self.validationReady.len() {
            let completed = self.validationReady.asSlice()[cursor];
            cursor += 1;
            for &edge in self.dependencies.iter() {
                if edge.dependency.index() == completed {
                    let dependent = edge.step.index();
                    self.validationIndegree.asMutSlice()[dependent] -= 1;
                    if self.validationIndegree.asSlice()[dependent] == 0 {
                        self.validationReady.push(self.allocator, dependent).withBuildContext(Operation::Retain, Subject::Dependencies).?;
                    }
                }
            }
        }
        if cursor != self.steps.len() {
            for &edge in self.dependencies.iter() {
                if self.validationIndegree.asSlice()[edge.step.index()] != 0
                    and self.validationIndegree.asSlice()[edge.dependency.index()] != 0
                {
                    return Error::StepCycle {
                        step: edge.step.index(),
                        dependency: edge.dependency.index(),
                    }!;
                }
            }
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Dependencies,
            }!;
        }
        !()
    }

    fn cleanupValidationScratch(&mut self) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.validationReady.deinit(self.allocator).withBuildContext(
            Operation::Release,
            Subject::Dependencies,
        ));
        cleanup.attempt(self.validationIndegree.deinit(self.allocator).withBuildContext(
            Operation::Release,
            Subject::Dependencies,
        ));
        cleanup.finish()
    }

    pub fn reportError(&mut self, error: Error) Error!() {
        reportBuildError(error)
    }

    fn findStep(&self, name: &[char]) ?Step {
        findStepRecord(self.steps.asSlice(), name)
    }

    fn findExecutable(&self, name: &[char]) ?ExecutableTarget {
        findExecutableRecord(self.executables.asSlice(), name)
    }

    fn findObject(&self, name: &[char]) ?ObjectTarget {
        findObjectRecord(self.objects.asSlice(), name)
    }

    fn findStaticArchive(&self, name: &[char]) ?StaticArchiveTarget {
        findStaticArchiveRecord(self.staticArchives.asSlice(), name)
    }

    fn findModule(&self, name: &[char]) ?Module {
        findModuleRecord(self.modules.asSlice(), name)
    }

    fn findEmitStep(&self, target: ExecutableHandle) ?StepHandle {
        findEmitStepRecord(self.ownerId, self.steps.asSlice(), target)
    }

    fn findEmitObjectStep(&self, target: ObjectHandle) ?StepHandle {
        findEmitObjectStepRecord(self.ownerId, self.steps.asSlice(), target)
    }

    fn findEmitStaticArchiveStep(&self, target: StaticArchiveHandle) ?StepHandle {
        findEmitStaticArchiveStepRecord(self.ownerId, self.steps.asSlice(), target)
    }

    fn rollbackLastStep(&mut self) Error!() {
        match self.steps.pop() {
            ?step => {
                self.pendingStep = step;
                self.hasPendingStep = true;
                self.cleanupPendingStep()
            },
            null => Error::Invalid {
                operation: Operation::Release,
                subject: Subject::Steps,
            }!,
        }
    }

    fn validateExecutableHandle(&self, handle: ExecutableHandle) Error!() {
        validateExecutableHandleValue(self.ownerId, self.executables.len(), handle)
    }

    fn validateRunnableExecutable(&self, handle: ExecutableHandle, stepIndex: usize) Error!() {
        let role = self.executables.asSlice()[handle.index()].targetRole;
        validateRunnableTarget(
            role,
            self.hostTarget.view(),
            self.artifactTarget.view(),
            stepIndex,
        )
    }

    fn validateObjectHandle(&self, handle: ObjectHandle) Error!() {
        validateObjectHandleValue(self.ownerId, self.objects.len(), handle)
    }

    fn validateStaticArchiveHandle(&self, handle: StaticArchiveHandle) Error!() {
        validateStaticArchiveHandleValue(self.ownerId, self.staticArchives.len(), handle)
    }

    fn validatePackageHandle(&self, handle: PackageHandle) Error!() {
        validatePackageHandleValue(self.ownerId, self.packages.len(), handle)
    }

    fn validateModuleHandle(&self, handle: ModuleHandle) Error!() {
        validateModuleHandleValue(self.ownerId, self.modules.len(), handle)
    }

    fn validateStepHandle(&self, handle: StepHandle) Error!() {
        validateStepHandleValue(self.ownerId, self.steps.len(), handle)
    }

    fn reportUnknownStep(&mut self, step: &[char]) Error!() {
        reportUnknownBuildStep(step)
    }

    fn addStepRecord(&mut self, name: &[char], kind: StepKind, payload: StepPayload) Error!StepHandle {
        self.prepareStepSlot(name).?;
        self.pendingStep = Step::initSimple(self.steps.len(), kind, payload);
        self.hasPendingStep = true;
        match self.pendingStep.initializeName(self.allocator, name) {
            !ok => _ = ok,
            primary! => {
                _ = self.cleanupPendingStep();
                return primary!;
            },
        }
        self.commitPendingStep()
    }

    fn preparePendingStep(&mut self, name: &[char], kind: StepKind) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = if kind == StepKind::GeneratedFile {
            Step::initGeneratedFile(self.steps.len())
        } else {
            Step::initUncacheable(self.steps.len())
        };
        self.hasPendingStep = true;
        !()
    }

    fn preparePendingRunStep(
        &mut self,
        name: &[char],
        kind: StepKind,
        target: ExecutableHandle,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = Step::initRunExecutable(self.steps.len(), kind, target);
        self.hasPendingStep = true;
        !()
    }

    fn prepareInstallExecutableStep(
        &mut self,
        name: &[char],
        target: ExecutableHandle,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = Step::initInstallExecutable(self.steps.len(), target);
        self.hasPendingStep = true;
        !()
    }

    fn prepareInstallStaticArchiveStep(
        &mut self,
        name: &[char],
        target: StaticArchiveHandle,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = Step::initInstallStaticArchive(self.steps.len(), target);
        self.hasPendingStep = true;
        !()
    }

    fn prepareExternalCommandStep(
        &mut self,
        name: &[char],
        options: ExternalCommandOptions,
    ) Error!() {
        self.prepareStepSlot(name).?;
        self.pendingStep = Step::initExternalCommand(self.steps.len(), options);
        self.hasPendingStep = true;
        !()
    }

    fn prepareStepSlot(&mut self, name: &[char]) Error!() {
        self.cleanupPendingStep().?;
        if not isValidStableName(name) {
            return Error::Invalid {
                operation: Operation::Validate,
                subject: Subject::Step(self.steps.len()),
            }!;
        }
        if self.findStep(name) is ?_ {
            return .Invalid {
                operation: .Validate,
                subject: .Step(self.steps.len()),
            }!;
        }
        self.steps.reserve(self.allocator, 1usize).withBuildContext(Operation::Retain, Subject::Steps).?;
        !()
    }

    fn commitPendingStep(&mut self) Error!StepHandle {
        if not self.hasPendingStep {
            return Error::Internal(Operation::Initialize)!;
        }
        let handle = StepHandle::init(self.ownerId, self.steps.len());
        self.steps.appendAssumeCapacity(self.pendingStep);
        self.hasPendingStep = false;
        self.planValidated = false;
        !handle
    }

    fn finishStepDependency(
        &mut self,
        step: StepHandle,
        dependency: StepHandle,
    ) Error!StepHandle {
        match self.dependOn(step, dependency) {
            !ok => {
                _ = ok;
                !step
            },
            primary! => {
                _ = self.rollbackLastStep();
                primary!
            },
        }
    }

    pub(pkg) fn cleanupPendingStep(&mut self) Error!() {
        if not self.hasPendingStep {
            return !();
        }
        self.pendingStep.deinit(self.allocator).?;
        self.hasPendingStep = false;
        !()
    }
}
