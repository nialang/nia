}

fn executableOutputName(options: ExecutableOptions) string::StringView {
    if options.outputName is ?name {
        name
    } else {
        options.name
    }
}

extend OptimizationMode {
    fn argv(self) &u8 {
        static o0 = b"-O0\0";
        static o1 = b"-O1\0";
        static o2 = b"-O2\0";
        static o3 = b"-O3\0";
        static os = b"-Os\0";
        static oz = b"-Oz\0";
        switch self {
            OptimizationMode::O0 => &o0[0],
            OptimizationMode::O1 => &o1[0],
            OptimizationMode::O2 => &o2[0],
            OptimizationMode::O3 => &o3[0],
            OptimizationMode::Os => &os[0],
            OptimizationMode::Oz => &oz[0],
            _ => &o2[0],
        }
    }
}

extend Runtime {
    fn argv(self) &u8 {
        static bare = b"--runtime=bare\0";
        static freestanding = b"--runtime=freestanding\0";
        switch self {
            Runtime::Bare => &bare[0],
            Runtime::Freestanding => &freestanding[0],
            _ => &freestanding[0],
        }
    }
}

fn isValidStableName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48u32 and code <= 57u32)
            or (code >= 65u32 and code <= 90u32)
            or (code >= 97u32 and code <= 122u32)
            or code == 45u32
            or code == 46u32
            or code == 95u32;
        if not valid {
            return false;
        }
    }
    true
}

fn isValidOutputName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    for &ch in name.text().iter() {
        let code = ch as u32;
        if code == 0u32 or code == 47u32 or code == 92u32 {
            return false;
        }
    }
    true
}

fn validateModuleImports(imports: ?&[ModuleImport]) Error!void {
    switch imports {
        ?items => {
            let mut index = 0usize;
            for &import in items.iter() {
                if not isValidModuleImportName(import.name) {
                    return Error::Invalid {
                        operation: Operation::Validate,
                        subject: Subject::ModuleImport(index),
                    }!;
                }
                let mut oldIndex = 0usize;
                while oldIndex < index {
                    if mem::equal[char](items[oldIndex].name.text(), import.name.text()) {
                        return Error::Invalid {
                            operation: Operation::Validate,
                            subject: Subject::ModuleImport(index),
                        }!;
                    }
                    oldIndex += 1usize;
                }
                index += 1usize;
            }
        },
        null => {},
    }
    !{}
}

fn cloneModuleImports(
    allocator: &mut mem::Allocator,
    imports: ?&[ModuleImport],
) Error!collections::ArrayList[OwnedModuleImport] {
    let items = if imports is ?values {
        values
    } else {
        &[]
    };
    let mut owned = collections::ArrayList[OwnedModuleImport]::init_capacity(
        allocator,
        items.len(),
    ).asBuildError(Operation::Retain, Subject::Modules).?;
    let mut transferred = false;
    defer if not transferred {
        deinitModuleImports(&mut owned, allocator).?;
    };
    let mut index = 0usize;
    for &import in items.iter() {
        let mut ownedImport = OwnedModuleImport::init(allocator, import, index).?;
        let mut importTransferred = false;
        defer if not importTransferred {
            ownedImport.deinit(allocator).?;
        };
        owned.push(allocator, ownedImport).asBuildError(Operation::Retain, Subject::ModuleImport(index)).?;
        importTransferred = true;
        index += 1usize;
    }
    transferred = true;
    !owned
}

fn deinitModuleImports(
    imports: &mut collections::ArrayList[OwnedModuleImport],
    allocator: &mut mem::Allocator,
) Error!void {
    let mut firstError: ?Error = null;
    let mut index = imports.len();
    while index != 0usize {
        index -= 1usize;
        rememberCleanupError(&mut firstError, imports.as_mut_slice()[index].deinit(allocator));
    }
    rememberCleanupError(&mut firstError, imports.deinit(allocator).asBuildError(Operation::Release, Subject::Modules));
    cleanupResult(firstError)
}

fn isValidModuleImportName(name: string::StringView) bool {
    if name.len() == 0usize {
        return false;
    }
    let text = name.text();
    if mem::equal[char](text, &"entry") or mem::equal[char](text, &"pkg") {
        return false;
    }
    for &ch in text.iter() {
        let code = ch as u32;
        let valid = (code >= 48u32 and code <= 57u32)
            or (code >= 65u32 and code <= 90u32)
            or (code >= 97u32 and code <= 122u32)
            or code == 95u32
            or code == 45u32;
        if not valid {
            return false;
        }
    }
    true
}

fn appendModuleImportArgs(
    allocator: &mut mem::Allocator,
    argv: &mut collections::ArrayList[&u8],
    imports: &EncodedModuleImports,
) Error!void {
    static moduleFlag = b"--module\0";
    let mut index = 0usize;
    while index < imports.len() {
        argv.push(allocator, &moduleFlag[0]).asBuildError(Operation::AssembleCommand, Subject::ModuleImport(index)).?;
        argv.push(allocator, imports.arg(index)).asBuildError(Operation::AssembleCommand, Subject::ModuleImport(index)).?;
        index += 1usize;
    }
    !{}
}

fn appendCharsToBytes(
    allocator: &mut mem::Allocator,
    text: &[char],
    storage: &mut collections::ArrayList[u8],
    subject: Subject,
) Error!void {
    for &ch in text.iter() {
        if ch as u32 == 0u32 {
            return Error::Invalid {
                operation: Operation::Encode,
                subject: subject,
            }!;
        }
        let encoded = ch.encode_utf8();
        storage.append_slice(allocator, encoded.bytes()).asBuildError(Operation::AssembleCommand, subject).?;
    }
    !{}
}

extend EncodedModuleImports {
    fn init(
        allocator: &mut mem::Allocator,
        imports: &[OwnedModuleImport],
    ) Error!EncodedModuleImports {
        let mut encoded: EncodedModuleImports = {
            bytes: collections::ArrayList[u8]::init(),
            offsets: collections::ArrayList[usize]::init(),
        };
        let mut transferred = false;
        defer if not transferred {
            encoded.deinit(allocator).?;
        };
        let mut index = 0usize;
        for &import in imports.iter() {
            let subject = Subject::ModuleImport(index);
            encoded.offsets.push(allocator, encoded.bytes.len()).asBuildError(Operation::AssembleCommand, subject).?;
            appendCharsToBytes(allocator, import.name.text(), &mut encoded.bytes, subject).?;
            encoded.bytes.push(allocator, b'=').asBuildError(Operation::AssembleCommand, subject).?;
            appendCharsToBytes(allocator, import.path.text(), &mut encoded.bytes, subject).?;
            encoded.bytes.push(allocator, 0u8).asBuildError(Operation::AssembleCommand, subject).?;
            index += 1usize;
        }
        transferred = true;
        !encoded
    }

    fn len(&self) usize {
        self.offsets.len()
    }

    fn arg(&self, index: usize) &u8 {
        let offset = self.offsets.as_slice()[index];
        &self.bytes.as_slice()[offset]
    }

    fn deinit(&mut self, allocator: &mut mem::Allocator) Error!void {
        let mut firstError: ?Error = null;
        rememberCleanupError(&mut firstError, self.bytes.deinit(allocator).asBuildError(Operation::Release, Subject::Compiler));
        rememberCleanupError(&mut firstError, self.offsets.deinit(allocator).asBuildError(Operation::Release, Subject::Compiler));
        cleanupResult(firstError)
    }
}

fn argMatchesText(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    let mut byteIndex = 0usize;
    for &ch in text.iter() {
        let encoded = ch.encode_utf8();
        let encodedBytes = encoded.bytes();
        for &encodedByte in encodedBytes.iter() {
            if byteIndex >= bytes.len() or bytes[byteIndex] != encodedByte {
                return false;
            }
            byteIndex += 1usize;
        }
    }
    byteIndex == bytes.len()
}

fn rememberCleanupError(firstError: &mut ?Error, result: Error!void) void {
    switch result {
        !ok => {
            _ = ok;
        },
        err! => {
            if firstError.* is null {
                firstError.* = ?err;
            }
        },
    }
}

fn cleanupResult(firstError: ?Error) Error!void {
    if firstError is ?err {
        err!
    } else {
        !{}
    }
}
