// Reverse-order release for Build-owned record lists.
//
// A list is deinitialized only after every element released successfully. If
// one element fails, the list remains attached so a later cleanup attempt can
// reach the residual owner. Each helper still attempts every element and
// returns the first cleanup error, matching Build's aggregate policy.

using pkg::collections;
using pkg::mem;
using pkg::error::CleanupAccumulator;
using pkg::build::error::{Error, ErrorOperation as Operation, ErrorSubject as Subject};
using pkg::build::types::{
    ExecutableTarget,
    Module,
    ObjectTarget,
    Package,
    StaticArchiveTarget,
    Step,
};

pub(pkg) fn releaseSteps(
    allocator: &mut mem::Allocator,
    records: &mut collections::ArrayList[Step],
) Error!() {
    let mut cleanup: CleanupAccumulator[Error] = .init();
    let mut index = records.len();
    while index != 0 {
        index -= 1;
        cleanup.attempt(records.asMutSlice()[index].deinit(allocator));
    }
    if cleanup.isClean() {
        cleanup.attempt(records.deinit(allocator).withBuildContext(Operation::Release, Subject::Steps));
    }
    cleanup.finish()
}

