// Reverse-order release for Build-owned record lists.
//
// A list is deinitialized only after every element released successfully. If
// one element fails, the list remains attached so a later cleanup attempt can
// reach the residual owner. The shared helper still attempts every element
// and returns the first cleanup error, matching Build's aggregate policy.

using root::collections;
using root::builtin::Sized;
using root::mem;
using root::error::CleanupAccumulator;
using root::build::error::{Error, ErrorOperation as Operation, ErrorSubject as Subject};
using root::build::types::{
    ExecutableTarget,
    Module,
    ObjectTarget,
    Package,
    StaticArchiveTarget,
    Step,
    TargetStorage,
};

pub(root) trait OwnedBuildRecord {
    fun deinitOwned(
        &mut self,
        allocator: &mut mem::Allocator,
    ) Error!();
}

extend Step : OwnedBuildRecord {
    fun deinitOwned(&mut self, allocator: &mut mem::Allocator) Error!() {
        self.deinit(allocator)
    }
}

extend Package : OwnedBuildRecord {
    fun deinitOwned(&mut self, allocator: &mut mem::Allocator) Error!() {
        self.deinit(allocator)
    }
}

extend ExecutableTarget : OwnedBuildRecord {
    fun deinitOwned(&mut self, allocator: &mut mem::Allocator) Error!() {
        self.deinit(allocator)
    }
}

extend ObjectTarget : OwnedBuildRecord {
    fun deinitOwned(&mut self, allocator: &mut mem::Allocator) Error!() {
        self.deinit(allocator)
    }
}

extend StaticArchiveTarget : OwnedBuildRecord {
    fun deinitOwned(&mut self, allocator: &mut mem::Allocator) Error!() {
        self.deinit(allocator)
    }
}

extend Module : OwnedBuildRecord {
    fun deinitOwned(&mut self, allocator: &mut mem::Allocator) Error!() {
        self.deinit(allocator)
    }
}

extend TargetStorage : OwnedBuildRecord {
    fun deinitOwned(&mut self, allocator: &mut mem::Allocator) Error!() {
        self.deinit(allocator, Subject::Targets)
    }
}

// Reverse release keeps parent storage alive until every record is clean. If
// one field fails to release, the caller can retry against the same list.
pub(root) fun releaseRecords[T](
    allocator: &mut mem::Allocator,
    records: &mut collections::ArrayList[T],
    subject: Subject,
) Error!()
where T: Sized + OwnedBuildRecord
{
    let mut cleanup: CleanupAccumulator[Error] = .init();
    let mut index = records.len();
    while index != 0 {
        index -= 1;
        cleanup.attempt(records.asMutSlice()[index].deinitOwned(allocator));
    }
    if cleanup.isClean() {
        cleanup.attempt(records.deinit(allocator).withBuildContext(Operation::Release, subject));
    }
    cleanup.finish()
}
