// Read-only lookups over retained build records.
//
// Record scans live here so query policy stays independent from mutation.

using root::build::types;

using types::{
    ExecutableHandle,
    ExecutableTarget,
    Module,
    ObjectHandle,
    ObjectTarget,
    StaticArchiveHandle,
    StaticArchiveTarget,
    Step,
    StepHandle,
    StepKind,
};

pub(root) fun findStep(steps: &[Step], name: &[char]) ?Step {
    for &step in steps.iter() {
        if step.name.equals(name) {
            return ?step;
        }
    }
    null
}

pub(root) fun findExecutable(targets: &[ExecutableTarget], name: &[char]) ?ExecutableTarget {
    for &target in targets.iter() {
        if target.name.equals(name) {
            return ?target;
        }
    }
    null
}

pub(root) fun findObject(targets: &[ObjectTarget], name: &[char]) ?ObjectTarget {
    for &target in targets.iter() {
        if target.name.equals(name) {
            return ?target;
        }
    }
    null
}

pub(root) fun findStaticArchive(targets: &[StaticArchiveTarget], name: &[char]) ?StaticArchiveTarget {
    for &target in targets.iter() {
        if target.name.equals(name) {
            return ?target;
        }
    }
    null
}

pub(root) fun findModule(modules: &[Module], name: &[char]) ?Module {
    for &moduleRecord in modules.iter() {
        if moduleRecord.name.equals(name) {
            return ?moduleRecord;
        }
    }
    null
}

pub(root) fun findEmitStep(
    ownerId: usize,
    steps: &[Step],
    target: ExecutableHandle,
) ?StepHandle {
    for &step in steps.iter() {
        if step.kind == StepKind::EmitExecutable
            and step.payload.executable.target.ownerId() == target.ownerId()
            and step.payload.executable.target.index() == target.index()
        {
            return ?.init(ownerId, step.index);
        }
    }
    null
}

pub(root) fun findEmitObjectStep(
    ownerId: usize,
    steps: &[Step],
    target: ObjectHandle,
) ?StepHandle {
    for &step in steps.iter() {
        if step.kind == StepKind::EmitObject
            and step.payload.object.target.ownerId() == target.ownerId()
            and step.payload.object.target.index() == target.index()
        {
            return ?.init(ownerId, step.index);
        }
    }
    null
}

pub(root) fun findEmitStaticArchiveStep(
    ownerId: usize,
    steps: &[Step],
    target: StaticArchiveHandle,
) ?StepHandle {
    for &step in steps.iter() {
        if step.kind == StepKind::EmitStaticArchive
            and step.payload.staticArchive.target.ownerId() == target.ownerId()
            and step.payload.staticArchive.target.index() == target.index()
        {
            return ?.init(ownerId, step.index);
        }
    }
    null
}
