// Build ownership identity.
//
// Every live Build receives a process-wide owner ID. Handles carry that ID so
// the graph can reject values borrowed from a different Build instance.

using root::atomic;
using root::builtin::atomic as atomicBuiltin;

static mut nextBuildOwnerId: usize = 1;

pub(root) fun allocateBuildOwnerId() ?usize {
    let mut candidate = atomicBuiltin::atomicLoad[usize](
        &nextBuildOwnerId,
        atomic::Monotonic,
    );
    // Keep MAX as a permanent exhausted sentinel. A compare-exchange loop
    // prevents both wraparound and duplicate IDs when callers race at the end.
    while candidate != usize::MAX {
        match atomicBuiltin::cmpxchgStrong[usize](
            &mut nextBuildOwnerId,
            candidate,
            candidate + 1,
            atomic::Monotonic,
            atomic::Monotonic,
        ) {
            null => return ?candidate,
            ?observed => candidate = observed,
        }
    }
    null
}
