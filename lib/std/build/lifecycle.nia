// Build construction and complete graph teardown.
//
// The public constructor returns an attempt so partially retained state stays
// reachable until cleanup has succeeded. All lifecycle helpers are package
// visible because Build's declaration and its other ownership operations live
// in separate implementation modules.

using pkg::collections;
using pkg::fs;
using pkg::mem;
using pkg::string;
using pkg::error::CleanupAccumulator;
using pkg::build::error;
using pkg::build::handles;
using pkg::build::ownership::allocateBuildOwnerId;
using pkg::build::records_cleanup::{
    releaseExecutables,
    releaseModules,
    releaseObjects,
    releasePackages,
    releaseStaticArchives,
    releaseSteps,
};
using pkg::build::steps;
using pkg::build::types;

using error::Error;
using error::ErrorOperation as Operation;
using error::ErrorSubject as Subject;
using types::{
    Build,
    BuildInitAttempt,
    BuildPaths,
    ExecutableTarget,
    Module,
    ModuleHandle,
    ModuleSourceRoot,
    ObjectTarget,
    OptimizationMode,
    Package,
    PackageHandle,
    StaticArchiveTarget,
    Step,
    StepDependency,
    TargetRole,
    TargetStorage,
    TargetView,
};

extend Build {
    // The generated runner supplies these values from the resolved toolchain
    // invocation. Ordinary build scripts receive the initialized value and do
    // not construct alternate roots, targets, or protocol versions.
    pub fn init(
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
        hostTarget: TargetView,
        artifactTarget: TargetView,
        defaultOptimization: OptimizationMode,
        planSchemaVersion: u32,
        requestedStep: ?&[char],
    ) BuildInitAttempt {
        let ownerId = match allocateBuildOwnerId() {
            ?value => value,
            null => 0usize,
        };
        let build = Self {
            ownerId: ownerId,
            allocator: allocator,
            paths: BuildPaths::init(),
            hostTarget: TargetStorage::init(hostTarget.pointerWidth),
            artifactTarget: TargetStorage::init(artifactTarget.pointerWidth),
            defaultOptimization: defaultOptimization,
            planSchemaVersion: planSchemaVersion,
            requestedStep: string::String::init(),
            hasRequestedStep: false,
            defaultStep: null,
            selectedStep: null,
            planValidated: false,
            steps: collections::ArrayList[Step]::init(),
            pendingStep: Step::initAggregate(0usize),
            hasPendingStep: false,
            dependencies: collections::ArrayList[StepDependency]::init(),
            packages: collections::ArrayList[Package]::init(),
            pendingPackage: Package::init(0usize),
            hasPendingPackage: false,
            modules: collections::ArrayList[Module]::init(),
            pendingModule: Module::init(
                0usize,
                ModuleSourceRoot::Package,
                PackageHandle::init(ownerId, 0usize),
                defaultOptimization,
            ),
            hasPendingModule: false,
            executables: collections::ArrayList[ExecutableTarget]::init(),
            pendingExecutable: ExecutableTarget::init(
                0usize,
                ModuleHandle::init(ownerId, 0usize),
                TargetRole::Artifact,
            ),
            hasPendingExecutable: false,
            objects: collections::ArrayList[ObjectTarget]::init(),
            pendingObject: ObjectTarget::init(
                0usize,
                ModuleHandle::init(ownerId, 0usize),
                TargetRole::Artifact,
            ),
            hasPendingObject: false,
            staticArchives: collections::ArrayList[StaticArchiveTarget]::init(),
            pendingStaticArchive: StaticArchiveTarget::init(
                0usize,
                ModuleHandle::init(ownerId, 0usize),
                TargetRole::Artifact,
            ),
            hasPendingStaticArchive: false,
            validationIndegree: collections::ArrayList[usize]::init(),
            validationReady: collections::ArrayList[usize]::init(),
            planEncoding: collections::ArrayList[u8]::init(),
        };
        let mut attempt = BuildInitAttempt::init(build);
        if ownerId == 0usize {
            attempt.primary = ?Error::Internal(Operation::Initialize);
            return attempt;
        }
        match attempt.build.initialize(
            packageRoot,
            buildDir,
            cacheDir,
            toolchainExecutable,
            toolchainResourceRoot,
            hostTarget,
            artifactTarget,
            requestedStep,
        ) {
            !ok => {
                _ = ok;
            },
            primary! => attempt.primary = ?primary,
        }
        attempt
    }

    pub(pkg) fn initialize(
        &mut self,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
        hostTarget: TargetView,
        artifactTarget: TargetView,
        requestedStep: ?&[char],
    ) Error!() {
        self.paths.packageRoot = fs::Path::fromView(self.allocator, packageRoot).withBuildContext(Operation::Retain, Subject::PackageRoot).?;
        self.paths.buildDir = fs::Path::fromView(self.allocator, buildDir).withBuildContext(Operation::Retain, Subject::BuildDir).?;
        self.paths.cacheDir = fs::Path::fromView(self.allocator, cacheDir).withBuildContext(Operation::Retain, Subject::CacheDir).?;
        self.paths.toolchainExecutable = fs::Path::fromView(self.allocator, toolchainExecutable).withBuildContext(Operation::Retain, Subject::ToolchainExecutable).?;
        self.paths.toolchainResourceRoot = fs::Path::fromView(self.allocator, toolchainResourceRoot).withBuildContext(Operation::Retain, Subject::ToolchainResourceRoot).?;
        self.hostTarget.initialize(self.allocator, hostTarget, Subject::HostTarget).?;
        self.artifactTarget.initialize(self.allocator, artifactTarget, Subject::ArtifactTarget).?;
        if requestedStep is ?step {
            self.requestedStep = string::String::fromSlice(self.allocator, step).withBuildContext(
                Operation::Retain,
                Subject::RequestedStep,
            ).?;
            self.hasRequestedStep = true;
        }
        !()
    }

    pub fn deinit(&mut self) Error!() {
        let mut cleanup = CleanupAccumulator[Error]::init();
        cleanup.attempt(self.validationReady.deinit(self.allocator).withBuildContext(Operation::Release, Subject::Dependencies));
        cleanup.attempt(self.validationIndegree.deinit(self.allocator).withBuildContext(Operation::Release, Subject::Dependencies));
        cleanup.attempt(self.planEncoding.deinit(self.allocator).withBuildContext(Operation::Release, Subject::BuildPlan));
        cleanup.attempt(self.cleanupPendingPackage());
        cleanup.attempt(self.cleanupPendingModule());
        cleanup.attempt(self.cleanupPendingObject());
        cleanup.attempt(self.cleanupPendingStaticArchive());
        cleanup.attempt(self.cleanupPendingExecutable());
        cleanup.attempt(self.cleanupPendingStep());
        cleanup.attempt(releaseSteps(self.allocator, &mut self.steps));
        cleanup.attempt(self.dependencies.deinit(self.allocator).withBuildContext(Operation::Release, Subject::Dependencies));
        cleanup.attempt(releasePackages(self.allocator, &mut self.packages));
        cleanup.attempt(releaseExecutables(self.allocator, &mut self.executables));
        cleanup.attempt(releaseObjects(self.allocator, &mut self.objects));
        cleanup.attempt(releaseStaticArchives(self.allocator, &mut self.staticArchives));
        cleanup.attempt(releaseModules(self.allocator, &mut self.modules));
        cleanup.attempt(self.artifactTarget.deinit(self.allocator, Subject::ArtifactTarget));
        cleanup.attempt(self.hostTarget.deinit(self.allocator, Subject::HostTarget));
        cleanup.attempt(self.requestedStep.deinit(self.allocator).withBuildContext(
            Operation::Release,
            Subject::RequestedStep,
        ));
        cleanup.attempt(self.paths.deinit(self.allocator));
        cleanup.finish()
    }
}
