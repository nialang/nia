// Build construction and complete graph teardown.
//
// Initialization returns an attempt so partially owned state remains reachable
// until cleanup succeeds. Teardown reports the first failure after attempting
// every release and leaves failed owners available for a later retry.

using root::collections;
using root::fs;
using root::mem;
using root::string;
using root::error::CleanupAccumulator;
using root::build::error;
using root::build::handles;
using root::build::ownership::allocateBuildOwnerId;
using root::build::records_cleanup::{
    releaseExecutables,
    releaseModules,
    releaseObjects,
    releasePackages,
    releaseStaticArchives,
    releaseSteps,
    releaseTargets,
};
using root::build::steps;
using root::build::types;

using error::Error;
using error::ErrorOperation as Operation;
using error::ErrorSubject as Subject;
using types::{
    Build,
    BuildInitAttempt,
    ModuleSourceRoot,
    OptimizationMode,
    TargetStorage,
    TargetView,
};

extend Build {
    // These values describe the current package invocation and its resolved
    // toolchain. `targets` is the toolchain's maintained target matrix;
    // `hostTarget` and `artifactTarget` index it.
    pub fun init(
        allocator: &mut mem::Allocator,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
        targets: &[TargetView],
        hostTarget: usize,
        artifactTarget: usize,
        defaultOptimization: OptimizationMode,
        protocolEpoch: u32,
        requestedStep: ?&[char],
        listSteps: bool,
    ) BuildInitAttempt {
        let ownerId = if allocateBuildOwnerId() is ?value { value } else { 0 };
        let build: Build = .{
            ownerId: ownerId,
            allocator: allocator,
            paths: .init(),
            targets: .init(),
            hostTarget: hostTarget,
            artifactTarget: artifactTarget,
            defaultOptimization: defaultOptimization,
            protocolEpoch: protocolEpoch,
            requestedStep: .init(),
            hasRequestedStep: false,
            defaultStep: null,
            selectedStep: null,
            listSteps: listSteps,
            testStep: null,
            allStep: null,
            planValidated: false,
            steps: .init(),
            pendingStep: .initAggregate(0),
            hasPendingStep: false,
            dependencies: .init(),
            packages: .init(),
            pendingPackage: .init(0),
            hasPendingPackage: false,
            modules: .init(),
            pendingModule: .init(
                0,
                ModuleSourceRoot::Package,
                .init(ownerId, 0),
                defaultOptimization,
            ),
            hasPendingModule: false,
            executables: .init(),
            pendingExecutable: .init(
                0,
                .init(ownerId, 0),
                0,
            ),
            hasPendingExecutable: false,
            objects: .init(),
            pendingObject: .init(
                0,
                .init(ownerId, 0),
                0,
            ),
            hasPendingObject: false,
            staticArchives: .init(),
            pendingStaticArchive: .init(
                0,
                .init(ownerId, 0),
                0,
            ),
            hasPendingStaticArchive: false,
            validationIndegree: .init(),
            validationReady: .init(),
            configureObservationBytes: .init(),
            configureObservationCount: 0,
            environment: null,
            planEncoding: .init(),
        };
        let mut attempt = BuildInitAttempt::init(build);
        if ownerId == 0 {
            attempt.primary = ?.Internal(.Initialize);
            return attempt;
        }
        if attempt.build.initialize(
            packageRoot,
            buildDir,
            cacheDir,
            toolchainExecutable,
            toolchainResourceRoot,
            targets,
            requestedStep,
        ) is primary! {
            attempt.primary = ?primary;
        }
        attempt
    }

    pub(root) fun initialize(
        &mut self,
        packageRoot: fs::PathView,
        buildDir: fs::PathView,
        cacheDir: fs::PathView,
        toolchainExecutable: fs::PathView,
        toolchainResourceRoot: fs::PathView,
        targets: &[TargetView],
        requestedStep: ?&[char],
    ) Error!() {
        self.paths.packageRoot = fs::Path::fromView(self.allocator, packageRoot).withBuildContext(Operation::Retain, Subject::PackageRoot).?;
        self.paths.buildDir = fs::Path::fromView(self.allocator, buildDir).withBuildContext(Operation::Retain, Subject::BuildDir).?;
        self.paths.cacheDir = fs::Path::fromView(self.allocator, cacheDir).withBuildContext(Operation::Retain, Subject::CacheDir).?;
        self.paths.toolchainExecutable = fs::Path::fromView(self.allocator, toolchainExecutable).withBuildContext(Operation::Retain, Subject::ToolchainExecutable).?;
        self.paths.toolchainResourceRoot = fs::Path::fromView(self.allocator, toolchainResourceRoot).withBuildContext(Operation::Retain, Subject::ToolchainResourceRoot).?;
        self.initializeTargets(targets).?;
        if requestedStep is ?step {
            self.requestedStep = string::String::fromSlice(self.allocator, step).withBuildContext(
                Operation::Retain,
                Subject::RequestedStep,
            ).?;
            self.hasRequestedStep = true;
        }
        !()
    }

    // Each record is attached before its names are copied, so a failed copy
    // leaves a residual owner that `deinit` releases.
    fun initializeTargets(&mut self, targets: &[TargetView]) Error!() {
        if self.hostTarget >= targets.len() {
            return .Invalid { operation: .Validate, subject: .HostTarget }!;
        }
        if self.artifactTarget >= targets.len() {
            return .Invalid { operation: .Validate, subject: .ArtifactTarget }!;
        }
        let mut index: usize = 0;
        while index < targets.len() {
            let mut previous: usize = 0;
            while previous < index {
                if targets[previous].equals(targets[index]) {
                    return .Invalid { operation: .Validate, subject: .Targets }!;
                }
                previous += 1;
            }
            index += 1;
        }
        self.targets.reserve(self.allocator, targets.len()).withBuildContext(Operation::Retain, Subject::Targets).?;
        for &target in targets.iter() {
            self.targets.appendAssumeCapacity(TargetStorage::init(target.pointerWidth));
            let last = self.targets.len() - 1;
            self.targets.asMutSlice()[last].initialize(self.allocator, target, Subject::Targets).?;
        }
        !()
    }

    pub fun deinit(&mut self) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.validationReady.deinit(self.allocator).withBuildContext(Operation::Release, Subject::Dependencies));
        cleanup.attempt(self.validationIndegree.deinit(self.allocator).withBuildContext(Operation::Release, Subject::Dependencies));
        cleanup.attempt(self.configureObservationBytes.deinit(self.allocator).withBuildContext(Operation::Release, Subject::BuildPlan));
        cleanup.attempt(self.planEncoding.deinit(self.allocator).withBuildContext(Operation::Release, Subject::BuildPlan));
        cleanup.attempt(self.cleanupPendingPackage());
        cleanup.attempt(self.cleanupPendingModule());
        cleanup.attempt(self.cleanupPendingObject());
        cleanup.attempt(self.cleanupPendingStaticArchive());
        cleanup.attempt(self.cleanupPendingExecutable());
        cleanup.attempt(self.cleanupPendingStep());
        cleanup.attempt(releaseSteps(self.allocator, &mut self.steps));
        cleanup.attempt(self.dependencies.deinit(self.allocator).withBuildContext(Operation::Release, Subject::Dependencies));
        cleanup.attempt(releasePackages(self.allocator, &mut self.packages));
        cleanup.attempt(releaseExecutables(self.allocator, &mut self.executables));
        cleanup.attempt(releaseObjects(self.allocator, &mut self.objects));
        cleanup.attempt(releaseStaticArchives(self.allocator, &mut self.staticArchives));
        cleanup.attempt(releaseModules(self.allocator, &mut self.modules));
        cleanup.attempt(releaseTargets(self.allocator, &mut self.targets));
        cleanup.attempt(self.requestedStep.deinit(self.allocator).withBuildContext(
            Operation::Release,
            Subject::RequestedStep,
        ));
        cleanup.attempt(self.paths.deinit(self.allocator));
        cleanup.finish()
    }
}
