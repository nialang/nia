// Stateless validation rules for retained build-graph references.
//
// Each check receives the owning Build identity and the relevant handle count,
// so ownership validation stays independent of graph mutation.

using pkg::build::error;
using pkg::build::handles;
using pkg::build::targets;
using pkg::build::types;

using error::Error;
using types::{
    ExecutableHandle,
    ModuleHandle,
    ObjectHandle,
    PackageHandle,
    StaticArchiveHandle,
    StepHandle,
};

pub(pkg) fn validateExecutableHandle(
    ownerId: usize,
    count: usize,
    handle: ExecutableHandle,
) Error!() {
    if handle.ownerId() != ownerId or handle.index() >= count {
        return .Invalid {
            operation: .Validate,
            subject: .Executable(handle.index()),
        }!;
    }
    !()
}

pub(pkg) fn validateObjectHandle(
    ownerId: usize,
    count: usize,
    handle: ObjectHandle,
) Error!() {
    if handle.ownerId() != ownerId or handle.index() >= count {
        return .Invalid {
            operation: .Validate,
            subject: .Object(handle.index()),
        }!;
    }
    !()
}

pub(pkg) fn validateStaticArchiveHandle(
    ownerId: usize,
    count: usize,
    handle: StaticArchiveHandle,
) Error!() {
    if handle.ownerId() != ownerId or handle.index() >= count {
        return .Invalid {
            operation: .Validate,
            subject: .StaticArchive(handle.index()),
        }!;
    }
    !()
}

pub(pkg) fn validatePackageHandle(
    ownerId: usize,
    count: usize,
    handle: PackageHandle,
) Error!() {
    if handle.ownerId() != ownerId or handle.index() > count {
        return .Invalid {
            operation: .Validate,
            subject: .Packages,
        }!;
    }
    !()
}

pub(pkg) fn validateModuleHandle(
    ownerId: usize,
    count: usize,
    handle: ModuleHandle,
) Error!() {
    if handle.ownerId() != ownerId or handle.index() >= count {
        return .Invalid {
            operation: .Validate,
            subject: .Module(handle.index()),
        }!;
    }
    !()
}

pub(pkg) fn validateStepHandle(
    ownerId: usize,
    count: usize,
    handle: StepHandle,
) Error!() {
    if handle.ownerId() != ownerId or handle.index() >= count {
        return .Invalid {
            operation: .Validate,
            subject: .Step(handle.index()),
        }!;
    }
    !()
}

pub(pkg) fn validateRunnableTarget(
    targetIndex: usize,
    hostTarget: usize,
    stepIndex: usize,
) Error!() {
    // Run and test actions execute while constructing this build, so their
    // program must be built for the host. An executable without an explicit
    // target is runnable in a native build, where the invocation artifact
    // target is the host.
    if targetIndex != hostTarget {
        return .Invalid {
            operation: .Validate,
            subject: .Step(stepIndex),
        }!;
    }
    !()
}
