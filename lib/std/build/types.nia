using pkg::collections;
using pkg::fs;
using pkg::mem;
using pkg::process;
using pkg::string;
using pkg::build::error;

using error::Error;

pub type StepFn = &fn(&mut Build) Error!void;

pub enum StepKind: i32 {
    Custom = 1,
    CheckExecutable = 2,
    EmitExecutable = 3,
}

pub enum StepState: i32 {
    Pending = 1,
    Running = 2,
    Done = 3,
    Failed = 4,
    _
}

pub enum OptimizationMode: i32 {
    O0 = 0,
    O1 = 1,
    O2 = 2,
    O3 = 3,
    Os = 4,
    Oz = 5,
    _
}

pub enum Runtime: i32 {
    Bare = 1,
    Freestanding = 2,
    _
}

pub(pkg) enum TargetRole: i32 {
    Artifact = 1,
    _
}

pub struct TargetView {
    arch: string::StringView,
    vendor: string::StringView,
    os: string::StringView,
    env: string::StringView,
    abi: string::StringView,
    endian: string::StringView,
    pointerWidth: u32,
}

pub(pkg) struct TargetStorage {
    arch: string::StringBuf,
    vendor: string::StringBuf,
    os: string::StringBuf,
    env: string::StringBuf,
    abi: string::StringBuf,
    endian: string::StringBuf,
    pointerWidth: u32,
}

pub struct StepHandle {
    ownerId: usize,
    index: usize,
}

pub struct ExecutableHandle {
    ownerId: usize,
    index: usize,
}

pub struct ModuleHandle {
    ownerId: usize,
    index: usize,
}

pub struct CustomStep {
    run: StepFn,
}

pub struct ExecutableStep {
    target: ExecutableHandle,
}

pub union StepPayload {
    custom: CustomStep,
    executable: ExecutableStep,
}

pub struct Step {
    index: usize,
    name: string::StringBuf,
    kind: StepKind,
    payload: StepPayload,
    state: StepState,
}

pub struct StepDependency {
    step: StepHandle,
    dependency: StepHandle,
}

pub struct ModuleOptions {
    name: string::StringView,
    rootSource: fs::PathView,
    optimization: OptimizationMode,
    imports: ?&[ModuleImport],
}

pub struct Module {
    index: usize,
    name: string::StringBuf,
    rootSource: fs::PathBuf,
    optimization: OptimizationMode,
    imports: collections::ArrayList[OwnedModuleImport],
}

pub struct ModuleImport {
    name: string::StringView,
    path: fs::PathView,
}

pub struct OwnedModuleImport {
    index: usize,
    name: string::StringBuf,
    path: fs::PathBuf,
}

pub struct ExecutableOptions {
    name: string::StringView,
    rootModule: ModuleHandle,
    outputName: ?string::StringView,
    runtime: Runtime,
}

pub struct ExecutableTarget {
    index: usize,
    name: string::StringBuf,
    rootModule: ModuleHandle,
    outputName: string::StringBuf,
    runtime: Runtime,
    targetRole: TargetRole,
}

pub struct BuildPaths {
    packageRoot: fs::PathBuf,
    buildDir: fs::PathBuf,
    cacheDir: fs::PathBuf,
    toolchainExecutable: fs::PathBuf,
    toolchainResourceRoot: fs::PathBuf,
}

pub struct Build {
    ownerId: usize,
    init: process::Init,
    allocator: &mut mem::Allocator,
    paths: BuildPaths,
    hostTarget: TargetStorage,
    artifactTarget: TargetStorage,
    planSchemaVersion: u32,
    actionReporting: bool,
    stepArgIndex: usize,
    defaultStep: ?StepHandle,
    selectedStep: ?StepHandle,
    planValidated: bool,
    steps: collections::ArrayList[Step],
    dependencies: collections::ArrayList[StepDependency],
    modules: collections::ArrayList[Module],
    executables: collections::ArrayList[ExecutableTarget],
    stepsStarted: usize,
    stepsSucceeded: usize,
    stepsFailed: usize,
    customActions: usize,
    checkActions: usize,
    emitActions: usize,
    compilerInvocations: usize,
}
