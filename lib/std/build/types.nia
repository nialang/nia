using pkg::collections;
using pkg::fs;
using pkg::mem;
using pkg::string;
using pkg::build::error;

// Protocol-visible kinds have explicit tags. The final `_` keeps unknown
// persisted tags representable so the encoder can reject them explicitly;
// they must never fall back to an older or less constrained action contract.
pub enum StepKind: i32 {
    Aggregate = 1,
    CheckExecutable = 2,
    EmitExecutable = 3,
    EmitObject = 10,
    EmitStaticArchive = 11,
    GeneratedFile = 4,
    RunExecutable = 5,
    TestExecutable = 8,
    InstallExecutable = 9,
    InstallStaticArchive = 12,
    Uncacheable = 6,
    ExternalCommand = 7,
    _
}

pub enum OptimizationMode: i32 {
    O0 = 0,
    O1 = 1,
    O2 = 2,
    O3 = 3,
    Os = 4,
    Oz = 5,
    _
}

pub(pkg) enum TargetRole: i32 {
    Artifact = 1,
    Host = 2,
    _
}

pub(pkg) enum ModuleSourceRoot: i32 {
    Package = 1,
    Build = 2,
    _
}

// A build-root path is a lexical path below `.nia-build/`. It is not an
// arbitrary process path and cannot select package, cache, or toolchain files.
pub struct BuildPathView {
    path: &[char],
}

pub struct TargetView {
    arch: &[char],
    vendor: &[char],
    os: &[char],
    env: &[char],
    abi: &[char],
    endian: &[char],
    pointerWidth: u32,
}

pub(pkg) struct TargetStorage {
    arch: string::String,
    vendor: string::String,
    os: string::String,
    env: string::String,
    abi: string::String,
    endian: string::String,
    pointerWidth: u32,
}

// Handles are process-local capabilities owned by one `Build`. Their indices
// and owner ids never enter the serialized plan or persistent identities.
pub struct StepHandle {
    ownerId: usize,
    index: usize,
}

pub struct ExecutableHandle {
    ownerId: usize,
    index: usize,
}

pub struct ObjectHandle {
    ownerId: usize,
    index: usize,
}

pub struct StaticArchiveHandle {
    ownerId: usize,
    index: usize,
}

pub struct ModuleHandle {
    ownerId: usize,
    index: usize,
}

pub struct PackageHandle {
    ownerId: usize,
    index: usize,
}

pub struct PackageOptions {
    name: &[char],
    root: fs::PathView,
}

pub(pkg) struct Package {
    index: usize,
    name: string::String,
    root: fs::Path,
}

pub struct AggregateStep {
    marker: u8,
}

pub struct UncacheableStep {
    description: string::String,
}

pub struct GeneratedFileStep {
    output: string::String,
    contents: collections::ArrayList[u8],
}

pub struct ExecutableStep {
    target: ExecutableHandle,
}

pub struct ObjectStep {
    target: ObjectHandle,
}

pub struct StaticArchiveStep {
    target: StaticArchiveHandle,
}

pub struct RunOptions {
    target: ExecutableHandle,
    arguments: ?&[&[char]],
}

pub struct RunExecutableStep {
    target: ExecutableHandle,
    arguments: collections::ArrayList[string::String],
}

pub struct InstallExecutableStep {
    target: ExecutableHandle,
    destination: string::String,
}

pub struct InstallStaticArchiveStep {
    target: StaticArchiveHandle,
    destination: string::String,
}

pub enum CommandArgumentKind: i32 {
    Literal = 1,
    PackageInput = 2,
    BuildInput = 3,
    BuildOutput = 4,
    ArtifactInput = 5,
    ObjectInput = 6,
    StaticArchiveInput = 7,
    _
}

pub(pkg) union CommandArgumentPayload {
    value: &[char],
    artifact: ExecutableHandle,
    object: ObjectHandle,
    staticArchive: StaticArchiveHandle,
}

pub struct CommandArgument {
    kind: CommandArgumentKind,
    payload: CommandArgumentPayload,
    package: PackageHandle,
}

// Conservative actions reserve the complete ready-action capacity. Cpu and Io
// are explicit scheduling declarations; neither disables nested compiler or
// LLVM resource accounting.
pub enum ActionResourceClass: i32 {
    Conservative = 1,
    Cpu = 2,
    Io = 3,
    _
}

pub enum CommandEnvironmentPolicy: i32 {
    Inherit = 1,
    Clear = 2,
    _
}

// DeclaredInputs is an assertion by the build script that every semantic file
// input and output is represented by a typed `CommandArgument`. It is accepted
// only with a cleared environment and at least one declared output.
pub enum CommandCachePolicy: i32 {
    Uncacheable = 1,
    DeclaredInputs = 2,
    _
}

pub struct CommandEnvironmentInput {
    name: &[char],
    value: &[char],
}

pub struct ExternalCommandOptions {
    program: &[char],
    arguments: ?&[CommandArgument],
    workingDirectory: fs::PathView,
    resourceClass: ActionResourceClass,
    environmentPolicy: CommandEnvironmentPolicy,
    cachePolicy: CommandCachePolicy,
    environment: ?&[CommandEnvironmentInput],
}

pub(pkg) union OwnedCommandArgumentPayload {
    value: string::String,
    artifact: ExecutableHandle,
    object: ObjectHandle,
    staticArchive: StaticArchiveHandle,
}

pub(pkg) struct OwnedCommandArgument {
    kind: CommandArgumentKind,
    payload: OwnedCommandArgumentPayload,
    package: PackageHandle,
}

pub(pkg) struct OwnedCommandEnvironmentInput {
    name: string::String,
    value: string::String,
}

pub struct ExternalCommandStep {
    program: string::String,
    arguments: collections::ArrayList[OwnedCommandArgument],
    workingDirectory: fs::Path,
    resourceClass: ActionResourceClass,
    environmentPolicy: CommandEnvironmentPolicy,
    cachePolicy: CommandCachePolicy,
    environment: collections::ArrayList[OwnedCommandEnvironmentInput],
}

pub union StepPayload {
    aggregate: AggregateStep,
    executable: ExecutableStep,
    object: ObjectStep,
    staticArchive: StaticArchiveStep,
    generatedFile: GeneratedFileStep,
    runExecutable: RunExecutableStep,
    installExecutable: InstallExecutableStep,
    installStaticArchive: InstallStaticArchiveStep,
    externalCommand: ExternalCommandStep,
    uncacheable: UncacheableStep,
}

pub struct Step {
    index: usize,
    name: string::String,
    kind: StepKind,
    payload: StepPayload,
}

pub struct StepDependency {
    step: StepHandle,
    dependency: StepHandle,
}

// Module paths are package-rooted by default. `fromBuild` records generated
// roots and imports, whose exact producer must be in each consuming compiler
// step's dependency closure.
pub struct ModuleOptions {
    name: &[char],
    sourceRoot: ModuleSourceRoot,
    package: ?PackageHandle,
    rootSource: fs::PathView,
    optimization: ?OptimizationMode,
    imports: ?&[ModuleImport],
}

pub struct Module {
    index: usize,
    name: string::String,
    sourceRoot: ModuleSourceRoot,
    package: PackageHandle,
    rootSource: fs::Path,
    optimization: OptimizationMode,
    imports: collections::ArrayList[OwnedModuleImport],
}

pub struct ModuleImport {
    name: &[char],
    sourceRoot: ModuleSourceRoot,
    package: ?PackageHandle,
    path: fs::PathView,
}

pub struct OwnedModuleImport {
    index: usize,
    name: string::String,
    sourceRoot: ModuleSourceRoot,
    package: PackageHandle,
    path: fs::Path,
}

// Artifact descriptors borrow their name and module handles for one call. The
// `Build` retains owned copies and resolves the invocation artifact target
// unless the descriptor explicitly selects the host role.
pub struct ExecutableOptions {
    name: &[char],
    rootModule: ModuleHandle,
    outputName: ?&[char],
    targetRole: TargetRole,
    staticArchives: ?&[StaticArchiveHandle],
}

pub struct ExecutableTarget {
    index: usize,
    name: string::String,
    rootModule: ModuleHandle,
    outputName: string::String,
    targetRole: TargetRole,
    staticArchives: collections::ArrayList[StaticArchiveHandle],
}

pub struct ObjectOptions {
    name: &[char],
    rootModule: ModuleHandle,
    outputName: ?&[char],
    targetRole: TargetRole,
}

pub struct ObjectTarget {
    index: usize,
    name: string::String,
    rootModule: ModuleHandle,
    outputName: string::String,
    targetRole: TargetRole,
}

pub struct StaticArchiveOptions {
    name: &[char],
    rootModule: ModuleHandle,
    outputName: ?&[char],
    targetRole: TargetRole,
}

pub struct StaticArchiveTarget {
    index: usize,
    name: string::String,
    rootModule: ModuleHandle,
    outputName: string::String,
    targetRole: TargetRole,
}

pub struct BuildPaths {
    packageRoot: fs::Path,
    buildDir: fs::Path,
    cacheDir: fs::Path,
    toolchainExecutable: fs::Path,
    toolchainResourceRoot: fs::Path,
}

// BuildInitAttempt retains every partially initialized owner until finish can
// either transfer the complete Build or cleanly publish the initialization
// error. A cleanup failure leaves the attempt retryable.
pub struct BuildInitAttempt {
    build: Build,
    primary: ?error::Error,
    active: bool,
}

// `Build` owns the mutable declaration graph. Validation covers the complete
// graph, including unselected components, before the plan draft is published.
pub struct Build {
    ownerId: usize,
    allocator: &mut mem::Allocator,
    paths: BuildPaths,
    hostTarget: TargetStorage,
    artifactTarget: TargetStorage,
    defaultOptimization: OptimizationMode,
    planSchemaVersion: u32,
    requestedStep: string::String,
    hasRequestedStep: bool,
    defaultStep: ?StepHandle,
    selectedStep: ?StepHandle,
    planValidated: bool,
    steps: collections::ArrayList[Step],
    dependencies: collections::ArrayList[StepDependency],
    packages: collections::ArrayList[Package],
    pendingPackage: Package,
    hasPendingPackage: bool,
    modules: collections::ArrayList[Module],
    executables: collections::ArrayList[ExecutableTarget],
    objects: collections::ArrayList[ObjectTarget],
    pendingObject: ObjectTarget,
    hasPendingObject: bool,
    staticArchives: collections::ArrayList[StaticArchiveTarget],
    pendingStaticArchive: StaticArchiveTarget,
    hasPendingStaticArchive: bool,
    validationIndegree: collections::ArrayList[usize],
    validationReady: collections::ArrayList[usize],
    planEncoding: collections::ArrayList[u8],
}
