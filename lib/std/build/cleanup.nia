// Shared fallible-cleanup policy for owned build records.
//
// Teardown always attempts every release and preserves the first error. The
// owning record keeps any storage whose release failed so a later deinit can
// retry it.

using pkg::build::error::Error;

pub(pkg) fn rememberCleanupError(firstError: &mut ?Error, result: Error!()) () {
    if result is err! {
        if firstError.* is null {
            firstError.* = ?err;
        }
    }
}

pub(pkg) fn cleanupResult(firstError: ?Error) Error!() {
    if firstError is ?err { err! } else { !() }
}
