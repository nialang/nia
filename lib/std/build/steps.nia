// Owned payloads for build steps.
//
// Each payload retains only the data needed by its action. Fallible teardown
// visits every nested owner and reports the first failure, leaving unreleased
// list storage attached for a later Build::deinit retry.

using pkg::collections;
using pkg::mem;
using pkg::string;
using pkg::error::CleanupAccumulator;
using pkg::build::commands;
using pkg::build::error;
using pkg::build::types;

using error::Error;
using types::{
    AggregateStep,
    BuildPathView,
    ExternalCommandOptions,
    ExecutableHandle,
    ExecutableStep,
    GeneratedFileStep,
    InstallExecutableStep,
    InstallStaticArchiveStep,
    ObjectHandle,
    ObjectStep,
    RunExecutableStep,
    RunOptions,
    StaticArchiveHandle,
    StaticArchiveStep,
    Step,
    StepKind,
    StepPayload,
    UncacheableStep,
};

extend AggregateStep {
    pub(pkg) fn init() AggregateStep {
        .{ marker: 0 }
    }
}

extend UncacheableStep {
    pub(pkg) fn init() UncacheableStep {
        .{ description: .init() }
    }

    pub(pkg) fn initialize(&mut self, allocator: &mut mem::Allocator, description: &[char], index: usize) Error!() {
        self.description = string::String::fromSlice(allocator, description)
            .withBuildContext(.Retain, .Step(index)).?;
        !()
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        self.description.deinit(allocator).withBuildContext(.Release, .Step(index))
    }
}

extend GeneratedFileStep {
    pub(pkg) fn init() GeneratedFileStep {
        .{ output: .init(), contents: .init() }
    }

    pub(pkg) fn initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        output: BuildPathView,
        contents: &[u8],
        index: usize,
    ) Error!() {
        self.output = string::String::fromSlice(allocator, output.text())
            .withBuildContext(.Retain, .Step(index)).?;
        self.contents.appendSlice(allocator, contents)
            .withBuildContext(.Retain, .Step(index)).?;
        !()
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.contents.deinit(allocator).withBuildContext(.Release, .Step(index)));
        cleanup.attempt(self.output.deinit(allocator).withBuildContext(.Release, .Step(index)));
        cleanup.finish()
    }
}

extend ExecutableStep {
    pub(pkg) fn init(target: ExecutableHandle) ExecutableStep { .{ target } }
}

extend ObjectStep {
    pub(pkg) fn init(target: ObjectHandle) ObjectStep { .{ target } }
}

extend StaticArchiveStep {
    pub(pkg) fn init(target: StaticArchiveHandle) StaticArchiveStep { .{ target } }
}

extend RunOptions {
    pub fn init(target: ExecutableHandle) RunOptions {
        .{ target, arguments: null }
    }

    pub fn withArguments(self, arguments: &[&[char]]) RunOptions {
        .{ target: self.target, arguments: ?arguments }
    }
}

extend InstallExecutableStep {
    pub(pkg) fn init(target: ExecutableHandle) InstallExecutableStep {
        .{ target, destination: .init() }
    }

    pub(pkg) fn initialize(&mut self, allocator: &mut mem::Allocator, destination: BuildPathView, index: usize) Error!() {
        self.destination = string::String::fromSlice(allocator, destination.text())
            .withBuildContext(.Retain, .Step(index)).?;
        !()
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        self.destination.deinit(allocator).withBuildContext(.Release, .Step(index))
    }
}

extend InstallStaticArchiveStep {
    pub(pkg) fn init(target: StaticArchiveHandle) InstallStaticArchiveStep {
        .{ target, destination: .init() }
    }

    pub(pkg) fn initialize(&mut self, allocator: &mut mem::Allocator, destination: BuildPathView, index: usize) Error!() {
        self.destination = string::String::fromSlice(allocator, destination.text())
            .withBuildContext(.Retain, .Step(index)).?;
        !()
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        self.destination.deinit(allocator).withBuildContext(.Release, .Step(index))
    }
}

extend RunExecutableStep {
    pub(pkg) fn init(target: ExecutableHandle) RunExecutableStep {
        .{ target, arguments: .init() }
    }

    pub(pkg) fn initialize(
        &mut self,
        allocator: &mut mem::Allocator,
        arguments: ?&[&[char]],
        index: usize,
    ) Error!() {
        if arguments is ?values {
            self.arguments.reserve(allocator, values.len())
                .withBuildContext(.Retain, .Step(index)).?;
            for &argument in values.iter() {
                self.arguments.appendAssumeCapacity(.init());
                let argumentIndex = self.arguments.len() - 1;
                self.arguments.asMutSlice()[argumentIndex] = string::String::fromSlice(
                    allocator,
                    argument,
                ).withBuildContext(.Retain, .Step(index)).?;
            }
        }
        !()
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator, index: usize) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        let mut elements: CleanupAccumulator[Error] = .init();
        let mut argumentIndex = self.arguments.len();
        while argumentIndex != 0 {
            argumentIndex -= 1;
            elements.attempt(
                self.arguments.asMutSlice()[argumentIndex]
                    .deinit(allocator)
                    .withBuildContext(.Release, .Step(index)),
            );
        }
        if elements.isClean() {
            cleanup.attempt(self.arguments.deinit(allocator).withBuildContext(.Release, .Step(index)));
        } else {
            cleanup.attempt(elements.finish());
        }
        cleanup.finish()
    }
}

extend Step {
    pub(pkg) fn initSimple(index: usize, kind: StepKind, payload: StepPayload) Step {
        .{ index, name: .init(), kind, payload }
    }

    pub(pkg) fn initAggregate(index: usize) Step {
        .{ index, name: .init(), kind: .Aggregate, payload: .{ aggregate: .init() } }
    }

    pub(pkg) fn initGeneratedFile(index: usize) Step {
        .{ index, name: .init(), kind: .GeneratedFile, payload: .{ generatedFile: .init() } }
    }

    pub(pkg) fn initUncacheable(index: usize) Step {
        .{ index, name: .init(), kind: .Uncacheable, payload: .{ uncacheable: .init() } }
    }

    pub(pkg) fn initRunExecutable(
        index: usize,
        kind: StepKind,
        target: ExecutableHandle,
    ) Step {
        .{ index, name: .init(), kind, payload: .{ runExecutable: .init(target) } }
    }

    pub(pkg) fn initInstallExecutable(index: usize, target: ExecutableHandle) Step {
        .{ index, name: .init(), kind: .InstallExecutable, payload: .{ installExecutable: .init(target) } }
    }

    pub(pkg) fn initInstallStaticArchive(index: usize, target: StaticArchiveHandle) Step {
        .{ index, name: .init(), kind: .InstallStaticArchive, payload: .{ installStaticArchive: .init(target) } }
    }

    pub(pkg) fn initExternalCommand(index: usize, options: ExternalCommandOptions) Step {
        .{ index, name: .init(), kind: .ExternalCommand, payload: .{ externalCommand: .init(options) } }
    }

    pub(pkg) fn initializeGeneratedFile(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        output: BuildPathView,
        contents: &[u8],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Step(self.index)).?;
        self.payload.generatedFile.initialize(allocator, output, contents, self.index)
    }

    pub(pkg) fn initializeUncacheable(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        description: &[char],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Step(self.index)).?;
        self.payload.uncacheable.initialize(allocator, description, self.index)
    }

    pub(pkg) fn initializeRunExecutable(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        arguments: ?&[&[char]],
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Step(self.index)).?;
        self.payload.runExecutable.initialize(allocator, arguments, self.index)
    }

    pub(pkg) fn initializeInstallExecutable(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        destination: BuildPathView,
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Step(self.index)).?;
        self.payload.installExecutable.initialize(allocator, destination, self.index)
    }

    pub(pkg) fn initializeInstallStaticArchive(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        destination: BuildPathView,
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Step(self.index)).?;
        self.payload.installStaticArchive.initialize(allocator, destination, self.index)
    }

    pub(pkg) fn initializeExternalCommand(
        &mut self,
        allocator: &mut mem::Allocator,
        name: &[char],
        options: ExternalCommandOptions,
    ) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Step(self.index)).?;
        self.payload.externalCommand.initialize(allocator, options, self.index)
    }

    pub(pkg) fn initializeName(&mut self, allocator: &mut mem::Allocator, name: &[char]) Error!() {
        self.name = string::String::fromSlice(allocator, name).withBuildContext(.Retain, .Step(self.index)).?;
        !()
    }

    pub(pkg) fn deinit(&mut self, allocator: &mut mem::Allocator) Error!() {
        let mut cleanup: CleanupAccumulator[Error] = .init();
        if self.kind is (.Uncacheable) {
            cleanup.attempt(self.payload.uncacheable.deinit(allocator, self.index));
        }
        if self.kind is (.GeneratedFile) {
            cleanup.attempt(self.payload.generatedFile.deinit(allocator, self.index));
        }
        if self.kind == StepKind::RunExecutable or self.kind == StepKind::TestExecutable {
            cleanup.attempt(self.payload.runExecutable.deinit(allocator, self.index));
        }
        if self.kind is (.InstallExecutable) {
            cleanup.attempt(self.payload.installExecutable.deinit(allocator, self.index));
        }
        if self.kind is (.InstallStaticArchive) {
            cleanup.attempt(self.payload.installStaticArchive.deinit(allocator, self.index));
        }
        if self.kind is (.ExternalCommand) {
            cleanup.attempt(self.payload.externalCommand.deinit(allocator, self.index));
        }
        cleanup.attempt(self.name.deinit(allocator).withBuildContext(.Release, .Step(self.index)));
        cleanup.finish()
    }
}
