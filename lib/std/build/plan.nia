using pkg::collections;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::string;
using pkg::build::error;
using pkg::build::types;

using error::Error;
using error::ErrorOperation as Operation;
using error::ErrorSubject as Subject;
using types::{
    Build,
    ExecutableTarget,
    Module,
    OptimizationMode,
    Step,
    StepKind,
    ModuleSourceRoot,
    CommandArgumentKind,
    ActionResourceClass,
    CommandEnvironmentPolicy,
    CommandCachePolicy,
    TargetView,
};

const maxPlanBytes: usize = 67108864;
const maxItems: usize = 100000;
const maxStringBytes: usize = 1048576;

struct PlanEncoder {
    allocator: &mut mem::Allocator,
    bytes: collections::ArrayList[u8],
}

extend PlanEncoder {
    fn init(allocator: &mut mem::Allocator) PlanEncoder {
        {
            allocator: allocator,
            bytes: collections::ArrayList[u8]::init(),
        }
    }

    fn deinit(&mut self) Error!void {
        self.bytes.deinit(self.allocator).asBuildError(Operation::Release, Subject::BuildPlan)
    }

    fn data(&self) &[u8] {
        self.bytes.asSlice()
    }

    fn writeBytes(&mut self, value: &[u8]) Error!void {
        if value.len() > maxPlanBytes - self.bytes.len() {
            return invalidPlan();
        }
        self.bytes.appendSlice(self.allocator, value).asBuildError(Operation::Encode, Subject::BuildPlan)
    }

    fn writeU8(&mut self, value: u8) Error!void {
        if self.bytes.len() == maxPlanBytes {
            return invalidPlan();
        }
        self.bytes.push(self.allocator, value).asBuildError(Operation::Encode, Subject::BuildPlan)
    }

    fn writeU32(&mut self, value: u32) Error!void {
        let encoded: [4]u8 = [
            value as u8,
            (value >> 8) as u8,
            (value >> 16) as u8,
            (value >> 24) as u8,
        ];
        self.writeBytes(&encoded)
    }

    fn writeCount(&mut self, value: usize) Error!void {
        if value > maxItems {
            return invalidPlan();
        }
        self.writeU32(value as u32)
    }

    fn writeString(&mut self, value: &[char]) Error!void {
        let byteLen = utf8Length(value).?;
        self.writeU32(byteLen as u32).?;
        for &ch in value.iter() {
            self.writeBytes(ch.encodeUtf8().bytes()).?;
        }
        !{}
    }

    fn writeRootPackage(&mut self) Error!void {
        self.writeString(&"root")
    }

    fn writeNodeKey(&mut self, name: &[char]) Error!void {
        self.writeRootPackage().?;
        self.writeString(name)
    }

    fn writePackagePath(&mut self, path: fs::PathView) Error!void {
        self.writeU8(0).?;
        self.writeRootPackage().?;
        self.writeLogicalPathText(path.text())
    }

    fn writeBuildPath(&mut self, path: &[char]) Error!void {
        self.writeU8(1).?;
        self.writeLogicalPathText(path)
    }

    fn writeArtifactPath(&mut self, name: &[char]) Error!void {
        self.writeU8(4).?;
        self.writeNodeKey(name).?;
        self.writeString(&"")
    }

    fn writePackageRootPath(&mut self) Error!void {
        self.writeU8(0).?;
        self.writeRootPackage().?;
        self.writeString(&"")
    }

    fn writeLogicalPathText(&mut self, path: &[char]) Error!void {
        if not isValidLogicalPath(path) {
            return invalidPlan();
        }
        self.writeString(path)
    }

    fn writeTarget(&mut self, target: TargetView) Error!void {
        if target.arch().len() == 0
            or target.os().len() == 0
            or containsNul(target.arch())
            or containsNul(target.vendor())
            or containsNul(target.os())
            or containsNul(target.env())
            or containsNul(target.abi())
            or containsNul(target.endian())
            or not (textEquals(target.endian(), &"little")
                or textEquals(target.endian(), &"big"))
            or not (target.pointerWidth() == 8
                or target.pointerWidth() == 16
                or target.pointerWidth() == 32
                or target.pointerWidth() == 64
                or target.pointerWidth() == 128)
        {
            return invalidPlan();
        }
        self.writeString(target.arch()).?;
        self.writeString(target.vendor()).?;
        self.writeString(target.os()).?;
        self.writeString(target.env()).?;
        self.writeString(target.abi()).?;
        self.writeString(target.endian()).?;
        self.writeU32(target.pointerWidth())
    }

    fn writeOptimization(&mut self, optimization: OptimizationMode) Error!void {
        self.writeU8(switch optimization {
            OptimizationMode::O0 => 0,
            OptimizationMode::O1 => 1,
            OptimizationMode::O2 => 2,
            OptimizationMode::O3 => 3,
            OptimizationMode::Os => 4,
            OptimizationMode::Oz => 5,
            _ => return invalidPlan(),
        })
    }

    fn writeResourceClass(&mut self, resourceClass: ActionResourceClass) Error!void {
        self.writeU8(switch resourceClass {
            ActionResourceClass::Conservative => 0,
            ActionResourceClass::Cpu => 1,
            ActionResourceClass::Io => 2,
            _ => return invalidPlan(),
        })
    }

    fn writeCommandEnvironmentPolicy(&mut self, policy: CommandEnvironmentPolicy) Error!void {
        self.writeU8(switch policy {
            CommandEnvironmentPolicy::Inherit => 0,
            CommandEnvironmentPolicy::Clear => 1,
            _ => return invalidPlan(),
        })
    }

    fn writeCommandCachePolicy(&mut self, policy: CommandCachePolicy) Error!void {
        self.writeU8(switch policy {
            CommandCachePolicy::Uncacheable => 0,
            CommandCachePolicy::DeclaredInputs => 1,
            _ => return invalidPlan(),
        })
    }

    fn writeModule(&mut self, moduleRecord: Module) Error!void {
        self.writeNodeKey(moduleRecord.name.text()).?;
        switch moduleRecord.sourceRoot {
            ModuleSourceRoot::Package => self.writePackagePath(moduleRecord.rootSource.view()).?,
            ModuleSourceRoot::Build => self.writeBuildPath(moduleRecord.rootSource.text()).?,
            _ => return invalidPlan(),
        }
        self.writeOptimization(moduleRecord.optimization).?;
        self.writeCount(moduleRecord.imports.len()).?;
        for &import in moduleRecord.imports.iter() {
            self.writeString(import.name.text()).?;
            switch import.sourceRoot {
                ModuleSourceRoot::Package => self.writePackagePath(import.path.view()).?,
                ModuleSourceRoot::Build => self.writeBuildPath(import.path.text()).?,
                _ => return invalidPlan(),
            }
        }
        !{}
    }

    fn writeArtifact(&mut self, target: ExecutableTarget, modules: &[Module]) Error!void {
        let moduleRecord = modules[target.rootModule.index];
        self.writeNodeKey(target.name.text()).?;
        self.writeNodeKey(moduleRecord.name.text()).?;
        self.writeBuildPath(target.outputName.text()).?;
        self.writeU8(1)
    }

    fn writeAction(
        &mut self,
        step: Step,
        modules: &[Module],
        executables: &[ExecutableTarget],
        artifactTarget: TargetView,
    ) Error!void {
        self.writeNodeKey(step.name.text()).?;
        switch step.kind {
            StepKind::Aggregate => self.writeU8(4),
            StepKind::GeneratedFile => {
                self.writeU8(3).?;
                self.writeBuildPath(step.payload.generatedFile.output.text()).?;
                self.writeU32(step.payload.generatedFile.contents.len() as u32).?;
                self.writeBytes(step.payload.generatedFile.contents.asSlice())
            },
            StepKind::Uncacheable => {
                self.writeU8(5).?;
                self.writeString(step.payload.uncacheable.description.text())
            },
            StepKind::CheckExecutable => {
                let target = executables[step.payload.executable.target.index];
                let moduleRecord = modules[target.rootModule.index];
                self.writeU8(0).?;
                self.writeNodeKey(moduleRecord.name.text()).?;
                self.writeTarget(artifactTarget).?;
                self.writeU8(1)
            },
            StepKind::EmitExecutable => {
                let target = executables[step.payload.executable.target.index];
                self.writeU8(1).?;
                self.writeNodeKey(target.name.text()).?;
                self.writeTarget(artifactTarget)
            },
            StepKind::RunExecutable => {
                let run = step.payload.runExecutable;
                let target = executables[run.target.index];
                self.writeU8(2).?;
                self.writeResourceClass(ActionResourceClass::Conservative).?;
                self.writeCommandEnvironmentPolicy(CommandEnvironmentPolicy::Inherit).?;
                self.writeCommandCachePolicy(CommandCachePolicy::Uncacheable).?;
                self.writeU8(0).?;
                self.writeArtifactPath(target.name.text()).?;
                self.writeCount(run.arguments.len()).?;
                for &argument in run.arguments.iter() {
                    self.writeU8(0).?;
                    self.writeString(argument.text()).?;
                }
                self.writePackageRootPath().?;
                self.writeCount(0).?;
                self.writeCount(0).?;
                self.writeCount(0)
            },
            StepKind::ExternalCommand => {
                let command = step.payload.externalCommand;
                self.writeU8(2).?;
                self.writeResourceClass(command.resourceClass).?;
                self.writeCommandEnvironmentPolicy(command.environmentPolicy).?;
                self.writeCommandCachePolicy(command.cachePolicy).?;
                self.writeU8(1).?;
                self.writeString(command.program.text()).?;
                self.writeCount(command.arguments.len()).?;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::Literal {
                        self.writeU8(0).?;
                        self.writeString(argument.payload.value.text()).?;
                    } else if argument.kind == CommandArgumentKind::PackageInput {
                        self.writeU8(1).?;
                        self.writePackagePath(fs::PathView::init(argument.payload.value.text())).?;
                    } else if argument.kind == CommandArgumentKind::BuildInput {
                        self.writeU8(1).?;
                        self.writeBuildPath(argument.payload.value.text()).?;
                    } else if argument.kind == CommandArgumentKind::ArtifactInput {
                        let target = executables[argument.payload.artifact.index];
                        self.writeU8(1).?;
                        self.writeArtifactPath(target.name.text()).?;
                    } else if argument.kind == CommandArgumentKind::BuildOutput {
                        self.writeU8(2).?;
                        self.writeBuildPath(argument.payload.value.text()).?;
                    } else {
                        return invalidPlan();
                    }
                }
                self.writePackagePath(command.workingDirectory.view()).?;
                self.writeCount(command.environment.len()).?;
                for &input in command.environment.iter() {
                    self.writeString(input.name.text()).?;
                    self.writeU8(1).?;
                    self.writeString(input.value.text()).?;
                }
                let mut inputCount: usize = 0;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::PackageInput
                        or argument.kind == CommandArgumentKind::BuildInput
                        or argument.kind == CommandArgumentKind::ArtifactInput
                    {
                        inputCount += 1;
                    }
                }
                self.writeCount(inputCount).?;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::PackageInput {
                        self.writePackagePath(fs::PathView::init(argument.payload.value.text())).?;
                    } else if argument.kind == CommandArgumentKind::BuildInput {
                        self.writeBuildPath(argument.payload.value.text()).?;
                    } else if argument.kind == CommandArgumentKind::ArtifactInput {
                        let target = executables[argument.payload.artifact.index];
                        self.writeArtifactPath(target.name.text()).?;
                    }
                }
                let mut outputCount: usize = 0;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::BuildOutput {
                        outputCount += 1;
                    }
                }
                self.writeCount(outputCount).?;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::BuildOutput {
                        self.writeBuildPath(argument.payload.value.text()).?;
                    }
                }
                !{}
            },
            _ => invalidPlan(),
        }
    }

    fn writeStep(&mut self, build: &Build, step: Step) Error!void {
        self.writeNodeKey(step.name.text()).?;
        self.writeNodeKey(step.name.text()).?;
        let mut dependencyCount: usize = 0;
        for &edge in build.dependencies.iter() {
            if edge.step.index == step.index {
                dependencyCount += 1;
            }
        }
        self.writeCount(dependencyCount).?;
        for &edge in build.dependencies.iter() {
            if edge.step.index == step.index {
                let dependency = build.steps.asSlice()[edge.dependency.index];
                self.writeNodeKey(dependency.name.text()).?;
            }
        }
        !{}
    }

    fn writeOptionalStep(&mut self, build: &Build, handle: ?types::StepHandle) Error!void {
        switch handle {
            ?step => {
                self.writeU8(1).?;
                self.writeNodeKey(build.steps.asSlice()[step.index].name.text())
            },
            null => self.writeU8(0),
        }
    }

    fn writeBuild(&mut self, build: &Build) Error!void {
        self.writeBytes(&b"NIA-PLN\0"[..]).?;
        self.writeU32(build.planSchemaVersion).?;
        self.writeRootPackage().?;
        self.writeCount(1).?;
        self.writeRootPackage().?;
        self.writeTarget(build.hostTarget()).?;
        self.writeTarget(build.artifactTarget()).?;
        self.writeCount(build.modules.len()).?;
        for &moduleRecord in build.modules.iter() {
            self.writeModule(moduleRecord).?;
        }
        self.writeCount(build.executables.len()).?;
        for &target in build.executables.iter() {
            self.writeArtifact(target, build.modules.asSlice()).?;
        }
        self.writeCount(build.steps.len()).?;
        for &step in build.steps.iter() {
            self.writeAction(
                step,
                build.modules.asSlice(),
                build.executables.asSlice(),
                build.artifactTarget(),
            ).?;
        }
        self.writeCount(build.steps.len()).?;
        for &step in build.steps.iter() {
            self.writeStep(build, step).?;
        }
        self.writeOptionalStep(build, build.defaultStep).?;
        self.writeOptionalStep(build, build.selectedStep)
    }
}

extend Build {
    pub fn writePlanDraft(&mut self, path: fs::PathView) Error!void {
        self.validatePlan().?;
        let mut encoder = PlanEncoder::init(self.allocator);
        defer encoder.deinit().?;
        encoder.writeBuild(self).?;

        let mut file = fs::File::create(path, fs::CreateOptions::exclusive()).asBuildError(Operation::Publish, Subject::BuildPlan).?;
        let mut fileOpen = true;
        defer if fileOpen {
            file.close().asBuildError(Operation::Release, Subject::BuildPlan).?;
        };
        let mut buffer: [4096]u8 = [_]u8[0; 4096];
        let mut writer = file.writer(&mut buffer).asBuildError(Operation::Publish, Subject::BuildPlan).?;
        writer.writeAll(encoder.data()).asBuildError(Operation::Publish, Subject::BuildPlan).?;
        writer.flush().asBuildError(Operation::Publish, Subject::BuildPlan).?;
        file.sync().asBuildError(Operation::Publish, Subject::BuildPlan).?;
        file.close().asBuildError(Operation::Release, Subject::BuildPlan).?;
        fileOpen = false;
        !{}
    }
}

fn utf8Length(text: &[char]) Error!usize {
    let mut len: usize = 0;
    for &ch in text.iter() {
        let encodedLen = ch.encodeUtf8().byteLen();
        if encodedLen > maxStringBytes - len {
            return invalidPlan();
        }
        len += encodedLen;
    }
    !len
}

fn isValidLogicalPath(text: &[char]) bool {
    if text.len() == 0 {
        return true;
    }
    if text[0] == '/' or text[text.len() - 1] == '/' {
        return false;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index <= text.len() {
        if index == text.len() or text[index] == '/' {
            let componentLen = index - componentStart;
            if componentLen == 0
                or (componentLen == 1 and text[componentStart] == '.')
                or (componentLen == 2
                    and text[componentStart] == '.'
                    and text[componentStart + 1] == '.')
            {
                return false;
            }
            componentStart = index + 1;
        } else if text[index] == '\\' or text[index] == '\0' {
            return false;
        }
        index += 1;
    }
    true
}

fn containsNul(text: &[char]) bool {
    for &ch in text.iter() {
        if ch == '\0' {
            return true;
        }
    }
    false
}

fn textEquals(left: &[char], right: &[char]) bool {
    left.equals(right)
}

fn invalidPlan[T]() Error!T {
    Error::Invalid {
        operation: Operation::Validate,
        subject: Subject::BuildPlan,
    }!
}
