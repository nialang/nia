// Canonical build-plan draft encoding used by the generated runner.
//
// Encoding is bounded and deterministic. The Rust decoder validates the
// registered schema and freezes the complete graph again before execution, so
// this module is a handoff owner rather than an action executor.

using pkg::collections;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::string;
using pkg::build::error;
using pkg::build::types;

using error::Error;
using error::ErrorOperation as Operation;
using error::ErrorSubject as Subject;
using types::{
    Build,
    ExecutableTarget,
    ObjectTarget,
    StaticArchiveTarget,
    Module,
    OptimizationMode,
    Step,
    StepKind,
    ModuleSourceRoot,
    CommandArgumentKind,
    ActionResourceClass,
    CommandEnvironmentPolicy,
    CommandCachePolicy,
    TargetView,
    TargetRole,
    PackageHandle,
};

const maxPlanBytes: usize = 67108864;
const maxItems: usize = 100000;
const maxStringBytes: usize = 1048576;

struct PlanEncoder {
    allocator: &mut mem::Allocator,
    bytes: collections::ArrayList[u8],
}

extend PlanEncoder {
    fn init(allocator: &mut mem::Allocator) PlanEncoder {
        Self {
            allocator: allocator,
            bytes: .init(),
        }
    }

    fn intoBytes(self) collections::ArrayList[u8] {
        self.bytes
    }

    fn writeBytes(&mut self, value: &[u8]) Error!() {
        if value.len() > maxPlanBytes - self.bytes.len() {
            return invalidPlan();
        }
        self.bytes.appendSlice(self.allocator, value).withBuildContext(Operation::Encode, Subject::BuildPlan)
    }

    fn writeBlob(&mut self, value: &[u8]) Error!() {
        if value.len() > u32::MAX as usize {
            return invalidPlan();
        }
        self.writeU32(value.len() as u32).?;
        self.writeBytes(value)
    }

    fn writeU8(&mut self, value: u8) Error!() {
        if self.bytes.len() == maxPlanBytes {
            return invalidPlan();
        }
        self.bytes.push(self.allocator, value).withBuildContext(Operation::Encode, Subject::BuildPlan)
    }

    fn writeU32(&mut self, value: u32) Error!() {
        let encoded: [u8; 4] = [
            value as u8,
            (value >> 8) as u8,
            (value >> 16) as u8,
            (value >> 24) as u8,
        ];
        self.writeBytes(&encoded)
    }

    fn writeCount(&mut self, value: usize) Error!() {
        if value > maxItems {
            return invalidPlan();
        }
        self.writeU32(value as u32)
    }

    // Every protocol count is bounded before it is narrowed to u32. Keeping
    // the addition checked also prevents a forged in-memory build from
    // wrapping an aggregate count before writeCount can reject it.
    fn addCount(left: usize, right: usize) Error!usize {
        let value = match left.checkedAdd(right) {
            ?value => value,
            null => return invalidPlan(),
        };
        if value > maxItems {
            return invalidPlan();
        }
        !value
    }

    fn writeString(&mut self, value: &[char]) Error!() {
        let byteLen = utf8Length(value).?;
        self.writeU32(byteLen as u32).?;
        for &ch in value.iter() {
            self.writeBytes(ch.encodeUtf8().bytes()).?;
        }
        !()
    }

    fn writeRootPackage(&mut self) Error!() {
        self.writeString(&"root")
    }

    fn writePackageKey(&mut self, package: PackageHandle, packages: &[types::Package]) Error!() {
        if packageIndex(package) == 0 {
            return self.writeRootPackage();
        }
        let index = packageIndex(package) - 1;
        if index >= packages.len() {
            return invalidPlan();
        }
        self.writeString(packages[index].name.text())
    }

    fn writeNodeKey(&mut self, package: PackageHandle, name: &[char], packages: &[types::Package]) Error!() {
        self.writePackageKey(package, packages).?;
        self.writeString(name)
    }

    fn writePackagePath(&mut self, package: PackageHandle, path: fs::PathView, packages: &[types::Package]) Error!() {
        self.writeU8(0).?;
        self.writePackageKey(package, packages).?;
        self.writeLogicalPathText(path.text())
    }

    fn writeBuildPath(&mut self, path: &[char]) Error!() {
        self.writeU8(1).?;
        self.writeLogicalPathText(path)
    }

    fn writeArtifactPath(&mut self, name: &[char], packages: &[types::Package]) Error!() {
        self.writeU8(4).?;
        self.writeNodeKey(PackageHandle::init(0, 0), name, packages).?;
        self.writeString(&"")
    }

    fn writePackageRootPath(&mut self, packages: &[types::Package]) Error!() {
        self.writeU8(0).?;
        self.writePackageKey(PackageHandle::init(0, 0), packages).?;
        self.writeString(&"")
    }

    fn writeLogicalPathText(&mut self, path: &[char]) Error!() {
        if not isValidLogicalPath(path) {
            return invalidPlan();
        }
        self.writeString(path)
    }

    fn writeTarget(&mut self, target: TargetView) Error!() {
        if target.arch().len() == 0
            or target.os().len() == 0
            or containsNul(target.arch())
            or containsNul(target.vendor())
            or containsNul(target.os())
            or containsNul(target.env())
            or containsNul(target.abi())
            or containsNul(target.endian())
            or not (textEquals(target.endian(), &"little")
                or textEquals(target.endian(), &"big"))
            or not (target.pointerWidth() == 8
                or target.pointerWidth() == 16
                or target.pointerWidth() == 32
                or target.pointerWidth() == 64
                or target.pointerWidth() == 128)
        {
            return invalidPlan();
        }
        self.writeString(target.arch()).?;
        self.writeString(target.vendor()).?;
        self.writeString(target.os()).?;
        self.writeString(target.env()).?;
        self.writeString(target.abi()).?;
        self.writeString(target.endian()).?;
        self.writeU32(target.pointerWidth())
    }

    fn writeOptimization(&mut self, optimization: OptimizationMode) Error!() {
        self.writeU8(match optimization {
            .O0 => 0,
            .O1 => 1,
            .O2 => 2,
            .O3 => 3,
            .Os => 4,
            .Oz => 5,
            _ => return invalidPlan(),
        })
    }

    fn writeResourceClass(&mut self, resourceClass: ActionResourceClass) Error!() {
        self.writeU8(match resourceClass {
            .Conservative => 0,
            .Cpu => 1,
            .Io => 2,
            _ => return invalidPlan(),
        })
    }

    fn writeCommandEnvironmentPolicy(&mut self, policy: CommandEnvironmentPolicy) Error!() {
        self.writeU8(match policy {
            .Inherit => 0,
            .Clear => 1,
            _ => return invalidPlan(),
        })
    }

    fn writeCommandCachePolicy(&mut self, policy: CommandCachePolicy) Error!() {
        self.writeU8(match policy {
            .Uncacheable => 0,
            .DeclaredInputs => 1,
            _ => return invalidPlan(),
        })
    }

    fn writeModule(&mut self, moduleRecord: Module, packages: &[types::Package]) Error!() {
        self.writeNodeKey(PackageHandle::init(0, 0), moduleRecord.name.text(), packages).?;
        match moduleRecord.sourceRoot {
            .Package => self.writePackagePath(moduleRecord.package, moduleRecord.rootSource.view(), packages).?,
            .Build => self.writeBuildPath(moduleRecord.rootSource.text()).?,
            _ => return invalidPlan(),
        }
        self.writeOptimization(moduleRecord.optimization).?;
        self.writeCount(moduleRecord.imports.len()).?;
        for &import in moduleRecord.imports.iter() {
            self.writeString(import.name.text()).?;
            match import.sourceRoot {
                .Package => self.writePackagePath(import.package, import.path.view(), packages).?,
                .Build => self.writeBuildPath(import.path.text()).?,
                _ => return invalidPlan(),
            }
        }
        !()
    }

    fn writeArtifact(&mut self, target: ExecutableTarget, modules: &[Module], packages: &[types::Package]) Error!() {
        let moduleRecord = modules[target.rootModule.index];
        self.writeNodeKey(PackageHandle::init(0, 0), target.name.text(), packages).?;
        self.writeNodeKey(PackageHandle::init(0, 0), moduleRecord.name.text(), packages).?;
        self.writeU8(0).?;
        self.writeBuildPath(target.outputName.text()).?;
        self.writeU8(1)
    }

    fn writeObjectArtifact(&mut self, target: ObjectTarget, modules: &[Module], packages: &[types::Package]) Error!() {
        let moduleRecord = modules[target.rootModule.index];
        self.writeNodeKey(PackageHandle::init(0, 0), target.name.text(), packages).?;
        self.writeNodeKey(PackageHandle::init(0, 0), moduleRecord.name.text(), packages).?;
        self.writeU8(1).?;
        self.writeBuildPath(target.outputName.text()).?;
        self.writeU8(0)
    }

    fn writeStaticArchiveArtifact(&mut self, target: StaticArchiveTarget, modules: &[Module], packages: &[types::Package]) Error!() {
        let moduleRecord = modules[target.rootModule.index];
        self.writeNodeKey(PackageHandle::init(0, 0), target.name.text(), packages).?;
        self.writeNodeKey(PackageHandle::init(0, 0), moduleRecord.name.text(), packages).?;
        self.writeU8(2).?;
        self.writeBuildPath(target.outputName.text()).?;
        self.writeU8(0)
    }

    fn writeAction(
        &mut self,
        step: Step,
        modules: &[Module],
        executables: &[ExecutableTarget],
        objects: &[ObjectTarget],
        staticArchives: &[StaticArchiveTarget],
        hostTarget: TargetView,
        artifactTarget: TargetView,
        packages: &[types::Package],
    ) Error!() {
        self.writeNodeKey(PackageHandle::init(0, 0), step.name.text(), packages).?;
        match step.kind {
            .Aggregate => self.writeU8(4),
            .GeneratedFile => {
                self.writeU8(3).?;
                self.writeBuildPath(step.payload.generatedFile.output.text()).?;
                self.writeBlob(step.payload.generatedFile.contents.asSlice())
            },
            .Uncacheable => {
                self.writeU8(5).?;
                self.writeString(step.payload.uncacheable.description.text())
            },
            .CheckExecutable => {
                let target = executables[step.payload.executable.target.index];
                let moduleRecord = modules[target.rootModule.index];
                self.writeU8(0).?;
                self.writeNodeKey(PackageHandle::init(0, 0), moduleRecord.name.text(), packages).?;
                self.writeTarget(targetForRole(target.targetRole, hostTarget, artifactTarget).?).?;
                self.writeU8(1)
            },
            .EmitExecutable => {
                let target = executables[step.payload.executable.target.index];
                self.writeU8(1).?;
                self.writeNodeKey(PackageHandle::init(0, 0), target.name.text(), packages).?;
                self.writeTarget(targetForRole(target.targetRole, hostTarget, artifactTarget).?).?;
                self.writeCount(target.staticArchives.len()).?;
                for &archive in target.staticArchives.iter() {
                    let archiveTarget = staticArchives[archive.index];
                    self.writeNodeKey(PackageHandle::init(0, 0), archiveTarget.name.text(), packages).?;
                }
                !()
            },
            .EmitObject => {
                let target = objects[step.payload.object.target.index];
                self.writeU8(1).?;
                self.writeNodeKey(PackageHandle::init(0, 0), target.name.text(), packages).?;
                self.writeTarget(targetForRole(target.targetRole, hostTarget, artifactTarget).?).?;
                self.writeCount(0)
            },
            .EmitStaticArchive => {
                let target = staticArchives[step.payload.staticArchive.target.index];
                self.writeU8(1).?;
                self.writeNodeKey(PackageHandle::init(0, 0), target.name.text(), packages).?;
                self.writeTarget(targetForRole(target.targetRole, hostTarget, artifactTarget).?).?;
                self.writeCount(0)
            },
            .RunExecutable => {
                let run = step.payload.runExecutable;
                let target = executables[run.target.index];
                self.writeU8(2).?;
                self.writeResourceClass(ActionResourceClass::Conservative).?;
                self.writeCommandEnvironmentPolicy(CommandEnvironmentPolicy::Inherit).?;
                self.writeCommandCachePolicy(CommandCachePolicy::Uncacheable).?;
                self.writeU8(0).?;
                self.writeArtifactPath(target.name.text(), packages).?;
                self.writeCount(run.arguments.len()).?;
                for &argument in run.arguments.iter() {
                    self.writeU8(0).?;
                    self.writeString(argument.text()).?;
                }
                self.writePackageRootPath(packages).?;
                self.writeCount(0).?;
                self.writeCount(0).?;
                self.writeCount(0)
            },
            .TestExecutable => {
                let run = step.payload.runExecutable;
                let target = executables[run.target.index];
                self.writeU8(7).?;
                self.writeResourceClass(ActionResourceClass::Cpu).?;
                self.writeCommandEnvironmentPolicy(CommandEnvironmentPolicy::Inherit).?;
                self.writeCommandCachePolicy(CommandCachePolicy::Uncacheable).?;
                self.writeU8(0).?;
                self.writeArtifactPath(target.name.text(), packages).?;
                self.writeCount(run.arguments.len()).?;
                for &argument in run.arguments.iter() {
                    self.writeU8(0).?;
                    self.writeString(argument.text()).?;
                }
                self.writePackageRootPath(packages).?;
                self.writeCount(0).?;
                self.writeCount(0).?;
                self.writeCount(0)
            },
            .InstallExecutable => {
                let install = step.payload.installExecutable;
                let target = executables[install.target.index];
                self.writeU8(6).?;
                self.writeNodeKey(
                    PackageHandle::init(0, 0),
                    target.name.text(),
                    packages,
                ).?;
                self.writeBuildPath(install.destination.text())
            },
            .InstallStaticArchive => {
                let install = step.payload.installStaticArchive;
                let target = staticArchives[install.target.index];
                self.writeU8(6).?;
                self.writeNodeKey(
                    PackageHandle::init(0, 0),
                    target.name.text(),
                    packages,
                ).?;
                self.writeBuildPath(install.destination.text())
            },
            .ExternalCommand => {
                let command = step.payload.externalCommand;
                self.writeU8(2).?;
                self.writeResourceClass(command.resourceClass).?;
                self.writeCommandEnvironmentPolicy(command.environmentPolicy).?;
                self.writeCommandCachePolicy(command.cachePolicy).?;
                self.writeU8(1).?;
                self.writeString(command.program.text()).?;
                self.writeCount(command.arguments.len()).?;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::Literal {
                        self.writeU8(0).?;
                        self.writeString(argument.payload.value.text()).?;
                    } else if argument.kind == CommandArgumentKind::PackageInput {
                        self.writeU8(1).?;
                        self.writePackagePath(argument.package, fs::PathView::init(argument.payload.value.text()), packages).?;
                    } else if argument.kind == CommandArgumentKind::BuildInput {
                        self.writeU8(1).?;
                        self.writeBuildPath(argument.payload.value.text()).?;
                    } else if argument.kind == CommandArgumentKind::ArtifactInput {
                        let target = executables[argument.payload.artifact.index];
                        self.writeU8(1).?;
                        self.writeArtifactPath(target.name.text(), packages).?;
                    } else if argument.kind == CommandArgumentKind::ObjectInput {
                        let target = objects[argument.payload.object.index];
                        self.writeU8(1).?;
                        self.writeArtifactPath(target.name.text(), packages).?;
                    } else if argument.kind == CommandArgumentKind::StaticArchiveInput {
                        let target = staticArchives[argument.payload.staticArchive.index];
                        self.writeU8(1).?;
                        self.writeArtifactPath(target.name.text(), packages).?;
                    } else if argument.kind == CommandArgumentKind::BuildOutput {
                        self.writeU8(2).?;
                        self.writeBuildPath(argument.payload.value.text()).?;
                    } else {
                        return invalidPlan();
                    }
                }
                self.writePackagePath(PackageHandle::init(0, 0), command.workingDirectory.view(), packages).?;
                self.writeCount(command.environment.len()).?;
                for &input in command.environment.iter() {
                    self.writeString(input.name.text()).?;
                    self.writeU8(1).?;
                    self.writeString(input.value.text()).?;
                }
                let mut inputCount: usize = 0;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::PackageInput
                        or argument.kind == CommandArgumentKind::BuildInput
                        or argument.kind == CommandArgumentKind::ArtifactInput
                        or argument.kind == CommandArgumentKind::ObjectInput
                        or argument.kind == CommandArgumentKind::StaticArchiveInput
                    {
                        inputCount = PlanEncoder::addCount(inputCount, 1).?;
                    }
                }
                self.writeCount(inputCount).?;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::PackageInput {
                        self.writePackagePath(argument.package, fs::PathView::init(argument.payload.value.text()), packages).?;
                    } else if argument.kind == CommandArgumentKind::BuildInput {
                        self.writeBuildPath(argument.payload.value.text()).?;
                    } else if argument.kind == CommandArgumentKind::ArtifactInput {
                        let target = executables[argument.payload.artifact.index];
                        self.writeArtifactPath(target.name.text(), packages).?;
                    } else if argument.kind == CommandArgumentKind::ObjectInput {
                        let target = objects[argument.payload.object.index];
                        self.writeArtifactPath(target.name.text(), packages).?;
                    } else if argument.kind == CommandArgumentKind::StaticArchiveInput {
                        let target = staticArchives[argument.payload.staticArchive.index];
                        self.writeArtifactPath(target.name.text(), packages).?;
                    }
                }
                let mut outputCount: usize = 0;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::BuildOutput {
                        outputCount = PlanEncoder::addCount(outputCount, 1).?;
                    }
                }
                self.writeCount(outputCount).?;
                for &argument in command.arguments.iter() {
                    if argument.kind == CommandArgumentKind::BuildOutput {
                        self.writeBuildPath(argument.payload.value.text()).?;
                    }
                }
                !()
            },
            _ => invalidPlan(),
        }
    }

    fn writeStep(&mut self, build: &Build, step: Step, packages: &[types::Package]) Error!() {
        self.writeNodeKey(PackageHandle::init(0, 0), step.name.text(), packages).?;
        self.writeNodeKey(PackageHandle::init(0, 0), step.name.text(), packages).?;
        let mut dependencyCount: usize = 0;
        for &edge in build.dependencies.iter() {
            if edge.step.index == step.index {
                dependencyCount = PlanEncoder::addCount(dependencyCount, 1).?;
            }
        }
        self.writeCount(dependencyCount).?;
        for &edge in build.dependencies.iter() {
            if edge.step.index == step.index {
                let dependency = build.steps.asSlice()[edge.dependency.index];
                self.writeNodeKey(PackageHandle::init(0, 0), dependency.name.text(), packages).?;
            }
        }
        !()
    }

    fn writeOptionalStep(&mut self, build: &Build, handle: ?types::StepHandle, packages: &[types::Package]) Error!() {
        match handle {
            ?step => {
                self.writeU8(1).?;
                self.writeNodeKey(PackageHandle::init(0, 0), build.steps.asSlice()[step.index].name.text(), packages)
            },
            null => self.writeU8(0),
        }
    }

    fn writeBuild(&mut self, build: &Build) Error!() {
        self.writeBytes(&b"NIA-PLN\0"[..]).?;
        self.writeU32(build.planSchemaVersion).?;
        self.writeRootPackage().?;
        let packageCount = PlanEncoder::addCount(build.packages.len(), 1).?;
        self.writeCount(packageCount).?;
        self.writeRootPackage().?;
        self.writeString(&"").?;
        for &package in build.packages.iter() {
            self.writeString(package.name.text()).?;
            self.writeString(package.root.text()).?;
        }
        self.writeTarget(build.hostTarget()).?;
        self.writeTarget(build.artifactTarget()).?;
        self.writeCount(build.modules.len()).?;
        for &moduleRecord in build.modules.iter() {
            self.writeModule(moduleRecord, build.packages.asSlice()).?;
        }
        let executableCount = PlanEncoder::addCount(build.executables.len(), build.objects.len()).?;
        let artifactCount = PlanEncoder::addCount(executableCount, build.staticArchives.len()).?;
        self.writeCount(artifactCount).?;
        for &target in build.executables.iter() {
            self.writeArtifact(target, build.modules.asSlice(), build.packages.asSlice()).?;
        }
        for &target in build.objects.iter() {
            self.writeObjectArtifact(target, build.modules.asSlice(), build.packages.asSlice()).?;
        }
        for &target in build.staticArchives.iter() {
            self.writeStaticArchiveArtifact(target, build.modules.asSlice(), build.packages.asSlice()).?;
        }
        self.writeCount(build.steps.len()).?;
        for &step in build.steps.iter() {
            self.writeAction(
                step,
                build.modules.asSlice(),
                build.executables.asSlice(),
                build.objects.asSlice(),
                build.staticArchives.asSlice(),
                build.hostTarget(),
                build.artifactTarget(),
                build.packages.asSlice(),
            ).?;
        }
        self.writeCount(build.steps.len()).?;
        for &step in build.steps.iter() {
            self.writeStep(build, step, build.packages.asSlice()).?;
        }
        self.writeOptionalStep(build, build.defaultStep, build.packages.asSlice()).?;
        self.writeOptionalStep(build, build.selectedStep, build.packages.asSlice())
    }
}

fn targetForRole(
    role: TargetRole,
    hostTarget: TargetView,
    artifactTarget: TargetView,
) Error!TargetView {
    match role {
        .Artifact => !artifactTarget,
        .Host => !hostTarget,
        _ => invalidPlan(),
    }
}

extend Build {
    fn cleanupPlanEncoding(&mut self) Error!() {
        self.planEncoding.deinit(self.allocator).withBuildContext(Operation::Release, Subject::BuildPlan)
    }

    pub fn writePlanDraft(&mut self, path: fs::PathView) Error!() {
        self.validatePlan().?;
        self.cleanupPlanEncoding().?;
        let mut encoder = PlanEncoder::init(self.allocator);
        let operation = encoder.writeBuild(self);
        self.planEncoding = encoder.intoBytes();
        if operation is primary! {
            return primary!;
        }

        let mut file = fs::File::create(path, fs::CreateOptions::exclusive()).withBuildContext(Operation::Publish, Subject::BuildPlan).?;
        let mut primary: ?Error = null;
        let mut buffer: [u8; 4096] = [0; 4096];
        let mut writer = match file.writer(&mut buffer).withBuildContext(Operation::Publish, Subject::BuildPlan) {
            !value => value,
            error! => {
                _ = file.close().withBuildContext(Operation::Release, Subject::BuildPlan);
                return error!;
            },
        };
        rememberPrimary(
            &mut primary,
            writer.writeAll(self.planEncoding.asSlice()).withBuildContext(Operation::Publish, Subject::BuildPlan),
        );
        rememberPrimary(&mut primary, writer.flush().withBuildContext(Operation::Publish, Subject::BuildPlan));
        rememberPrimary(&mut primary, file.sync().withBuildContext(Operation::Publish, Subject::BuildPlan));
        // File::close consumes its handle before the syscall, even when the
        // syscall reports an error, so this close is attempted exactly once.
        rememberPrimary(&mut primary, file.close().withBuildContext(Operation::Release, Subject::BuildPlan));
        if primary is ?error {
            return error!;
        }
        return self.cleanupPlanEncoding();
    }
}

fn utf8Length(text: &[char]) Error!usize {
    let mut len: usize = 0;
    for &ch in text.iter() {
        let encodedLen = ch.encodeUtf8().byteLen();
        if encodedLen > maxStringBytes - len {
            return invalidPlan();
        }
        len += encodedLen;
    }
    !len
}

fn isValidLogicalPath(text: &[char]) bool {
    if text.len() == 0 {
        return true;
    }
    if text[0] == '/' or text[text.len() - 1] == '/' {
        return false;
    }
    let mut componentStart: usize = 0;
    let mut index: usize = 0;
    while index < text.len() {
        if text[index] == '/' {
            let componentLen = index - componentStart;
            if componentLen == 0
                or (componentLen == 1 and text[componentStart] == '.')
                or (componentLen == 2
                    and text[componentStart] == '.'
                    and text[componentStart + 1] == '.')
            {
                return false;
            }
            componentStart = index + 1;
        } else if text[index] == '\\' or text[index] == '\0' {
            return false;
        }
        index += 1;
    }
    let componentLen = text.len() - componentStart;
    componentLen != 0
        and not (componentLen == 1 and text[componentStart] == '.')
        and not (componentLen == 2
            and text[componentStart] == '.'
            and text[componentStart + 1] == '.')
}

fn containsNul(text: &[char]) bool {
    for &ch in text.iter() {
        if ch == '\0' {
            return true;
        }
    }
    false
}

fn textEquals(left: &[char], right: &[char]) bool {
    left.equals(right)
}

fn packageIndex(package: PackageHandle) usize {
    if package.ownerId() == 0 {
        0
    } else {
        package.index
    }
}

fn invalidPlan[T]() Error!T {
    Error::Invalid {
        operation: Operation::Validate,
        subject: Subject::BuildPlan,
    }!
}

fn rememberPrimary(firstError: &mut ?Error, result: Error!()) () {
    if result is err! {
        if firstError.* is null {
            firstError.* = ?err;
        }
    }
}
