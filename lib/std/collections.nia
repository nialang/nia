// Allocator-explicit owned collections and their borrowed iterators.
//
// Collection values are independent of the allocator that manages their
// storage. Operations that grow, clone, transfer, or release data receive that
// allocator at the call boundary.
//
// Fallible `deinit` attempts every independently owned allocation and retains
// each one whose release fails. A partially completed `deinit` leaves the value
// in cleanup-only state: retry `deinit` with the same allocator rather than
// using the value again. Ordered maps and sets retain key order during every
// mutation, so their iterators are deterministic without a separate sort pass.

pub(root) module array_list;
pub(root) module hash_map;
pub(root) module hash_set;
pub(root) module tree_map;
pub(root) module tree_set;

using root::collections::array_list;
