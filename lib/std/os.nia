pub(pkg) module linux;

@[if os == "linux"]
using pkg::os::linux as platform;
using pkg::error;
using pkg::option;

pub(pkg) const maxPathBytes: usize = platform::maxPathBytes;

pub(pkg) enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    NoChild = 10,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    Unsupported = 38,
    SymlinkLoop = 40,
    NotEmpty = 39,
    System = 255,
    _,
}

pub(pkg) enum SpawnError {
    Setup(Error),
    Stdio(Error),
    Cwd(Error),
    Exec(Error),
    Reap {
        stage: SpawnStage,
        primary: Error,
        cause: Error,
        pid: ProcessId,
    },
}

pub(pkg) enum SpawnStage: i32 {
    Setup = 1,
    Stdio = 2,
    Cwd = 3,
    Exec = 4,
    _,
}

pub(pkg) enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub(pkg) enum SeekWhence: usize {
    Start = 0,
    Current = 1,
    End = 2,
    _,
}

pub(pkg) enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub(pkg) enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub(pkg) struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub(pkg) struct FileMetadata {
    kind: FileKind,
    fileId: ?u64,
    linkCount: ?u32,
    size: u64,
    permissions: u32,
    preferredBlockSize: u32,
    accessed: ?Timestamp,
    modified: Timestamp,
    statusChanged: ?Timestamp,
}

pub(pkg) struct DirectoryEntry {
    kind: FileKind,
    name: &[u8],
}

pub(pkg) struct DirectoryReader {
    buffer: &mut [u8],
    start: usize,
    end: usize,
    done: bool,
}

pub(pkg) struct FileHandle {
    platform: platform::FileDescriptor,
}

pub(pkg) struct ProcessId {
    platform: platform::ProcessId,
}

pub(pkg) struct WaitStatus {
    platform: platform::WaitStatus,
}

pub(pkg) struct SpawnResult {
    platform: platform::SpawnResult,
}

pub(pkg) struct SpawnAttempt {
    platform: platform::SpawnAttempt,
}

pub(pkg) struct SpawnOptions {
    platform: platform::SpawnOptions,
}

pub(pkg) fn pageSize() usize {
    platform::pageSize()
}

pub(pkg) fn pageAlignedLen(len: usize) Error!usize {
    !(platform::pageAlignedLen(len).?)
}

pub(pkg) fn cwd() FileHandle {
    FileHandle::fromPlatform(platform::cwd())
}

pub(pkg) fn getCwd(buffer: &mut [u8]) Error!&[u8] {
    !(platform::getCwd(buffer).?)
}

pub(pkg) fn openAt(
    dir: FileHandle,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileHandle {
    let platformMode = mode.asPlatformOpenMode().?;
    let handle = platform::openAt(
        dir.platform(),
        path,
        platformMode,
        create,
        truncate,
        exclusive,
        permissions,
    ).?;
    !FileHandle::fromPlatform(handle)
}

pub(pkg) fn openAtBeneath(
    dir: FileHandle,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    followSymlinks: bool,
) Error!FileHandle {
    let platformMode = mode.asPlatformOpenMode().?;
    let handle = platform::openAtBeneath(
        dir.platform(),
        path,
        platformMode,
        directory,
        create,
        truncate,
        exclusive,
        permissions,
        followSymlinks,
    ).?;
    !FileHandle::fromPlatform(handle)
}

pub(pkg) fn createDirAtBeneath(
    dir: FileHandle,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Error!() {
    !(platform::createDirAtBeneath(
        dir.platform(),
        parent,
        name,
        permissions,
    ).?)
}

pub(pkg) fn deleteAtBeneath(dir: FileHandle, parent: &u8, name: &u8, directory: bool) Error!() {
    !(platform::deleteAtBeneath(dir.platform(), parent, name, directory).?)
}

pub(pkg) fn renameAtBeneath(
    oldDir: FileHandle,
    oldParent: &u8,
    oldName: &u8,
    newDir: FileHandle,
    newParent: &u8,
    newName: &u8,
) Error!() {
    !(platform::renameAtBeneath(
        oldDir.platform(),
        oldParent,
        oldName,
        newDir.platform(),
        newParent,
        newName,
    ).?)
}

pub(pkg) fn metadataAtBeneath(dir: FileHandle, path: &u8, followSymlinks: bool) Error!FileMetadata {
    let metadata = platform::metadataAtBeneath(
        dir.platform(),
        path,
        followSymlinks,
    ).?;
    !metadata.asOsMetadata()
}

pub(pkg) fn mapPages(len: usize, align: usize) Error!platform::MappedPages {
    !(platform::mapPages(len, align).?)
}

pub(pkg) fn unmapPages(ptr: &mut u8, len: usize) Error!() {
    !(platform::unmapPages(ptr, len).?)
}

pub(pkg) fn random(bytes: &mut [u8]) Error!() {
    !(platform::random(bytes).?)
}

pub(pkg) fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    SpawnAttempt::fromPlatform(platform::spawn(path, argv, envp, options.platform()))
}

pub(pkg) fn wait(pid: ProcessId) Error!WaitStatus {
    let status = platform::wait(pid.platform()).?;
    !WaitStatus::fromPlatform(status)
}

pub(pkg) fn tryWait(pid: ProcessId) Error! ?WaitStatus {
    let status = platform::tryWait(pid.platform()).?;
    !status.map(&\value -> WaitStatus::fromPlatform(value))
}

pub(pkg) fn killWith(pid: ProcessId, signal: i32) Error!() {
    !(platform::killWith(pid.platform(), signal).?)
}

pub(pkg) fn exit(code: i32) () {
    platform::exit(code);
}

extend platform::Errno : error::IntoError[Error] {
    const fn intoError(self) Error {
        match self {
            .PermissionDenied => .PermissionDenied,
            .NoEntry => .NotFound,
            .Interrupted => .Interrupted,
            .Io => .Io,
            .BadFd => .BadFd,
            .NoChild => .NoChild,
            .Again => .Again,
            .NoMemory => .OutOfMemory,
            .Access => .Access,
            .Fault => .Fault,
            .Busy => .Busy,
            .Exists => .AlreadyExists,
            .CrossDevice => .CrossDevice,
            .NotDir => .NotDir,
            .IsDir => .IsDir,
            .Invalid => .Invalid,
            .NoSpace => .NoSpace,
            .ReadOnly => .ReadOnly,
            .BrokenPipe => .BrokenPipe,
            .OutOfRange => .OutOfRange,
            .TooLong => .TooLong,
            .Unsupported => .Unsupported,
            .SymlinkLoop => .SymlinkLoop,
            .NotEmpty => .NotEmpty,
            _ => .System,
        }
    }
}

extend platform::SpawnError : error::IntoError[SpawnError] {
    const fn intoError(self) SpawnError {
        match self {
            .Setup(cause) => .Setup(cause.intoError()),
            .Stdio(cause) => .Stdio(cause.intoError()),
            .Cwd(cause) => .Cwd(cause.intoError()),
            .Exec(cause) => .Exec(cause.intoError()),
            .Reap { stage, primary, cause, pid } => .Reap {
                stage: stage.asSpawnStage(),
                primary: primary.intoError(),
                cause: cause.intoError(),
                pid: ProcessId::fromPlatform(pid),
            },
        }
    }
}

extend platform::SpawnStage {
    const fn asSpawnStage(self) SpawnStage {
        match self {
            .Setup => .Setup,
            .Stdio => .Stdio,
            .Cwd => .Cwd,
            .Exec => .Exec,
            _ => .Setup,
        }
    }
}

extend SpawnAttempt {
    fn fromPlatform(platform: platform::SpawnAttempt) SpawnAttempt {
        .{ platform }
    }

    pub(pkg) fn finish(&mut self) SpawnError!SpawnResult {
        let result = self.platform.finish().?;
        !SpawnResult::fromPlatform(result)
    }
}

extend OpenMode {
    fn asPlatformOpenMode(self) Error!platform::OpenMode {
        match self {
            .ReadOnly => !platform::OpenMode::ReadOnly,
            .WriteOnly => !platform::OpenMode::WriteOnly,
            .ReadWrite => !platform::OpenMode::ReadWrite,
            _ => Error::Invalid!,
        }
    }
}

extend SeekWhence {
    fn asPlatformSeekWhence(self) Error!platform::SeekWhence {
        match self {
            .Start => !platform::SeekWhence::Start,
            .Current => !platform::SeekWhence::Current,
            .End => !platform::SeekWhence::End,
            _ => Error::Invalid!,
        }
    }
}

extend platform::FileKind {
    fn asOsFileKind(self) FileKind {
        match self {
            .BlockDevice => .BlockDevice,
            .CharacterDevice => .CharacterDevice,
            .Directory => .Directory,
            .NamedPipe => .NamedPipe,
            .Symlink => .Symlink,
            .File => .File,
            .UnixSocket => .UnixSocket,
            _ => .Unknown,
        }
    }
}

extend platform::Timestamp {
    fn asOsTimestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend platform::FileMetadata {
    fn asOsMetadata(&self) FileMetadata {
        FileMetadata::init(
            self.kind().asOsFileKind(),
            ?self.inode(),
            ?self.nlink(),
            self.size(),
            self.mode() & 0o7777,
            self.blockSize(),
            self.atime().map(&\value -> value.asOsTimestamp()),
            self.mtime().asOsTimestamp(),
            ?self.ctime().asOsTimestamp(),
        )
    }
}

extend platform::DirectoryEntry {
    fn asOsDirectoryEntry(&self) DirectoryEntry {
        DirectoryEntry::init(self.kind().asOsFileKind(), self.name())
    }
}

extend Timestamp {
    pub(pkg) fn init(seconds: i64, nanos: u32) Timestamp {
        .{ seconds, nanos }
    }

    pub(pkg) fn seconds(&self) i64 {
        self.seconds
    }

    pub(pkg) fn nanos(&self) u32 {
        self.nanos
    }
}

extend DirectoryEntry {
    pub(pkg) fn init(kind: FileKind, name: &[u8]) DirectoryEntry {
        .{ kind, name }
    }

    pub(pkg) fn kind(&self) FileKind {
        self.kind
    }

    pub(pkg) fn name(&self) &[u8] {
        self.name
    }
}

extend DirectoryReader {
    pub(pkg) fn init(buffer: &mut [u8]) DirectoryReader {
        .{ buffer, start: 0, end: 0, done: false }
    }

    pub(pkg) fn isDone(&self) bool {
        self.done
    }

    pub(pkg) fn next(&mut self, handle: FileHandle) ?(Error!DirectoryEntry) {
        if self.done {
            return null;
        }
        if self.start >= self.end {
            let result = handle.readDirEntries(self.buffer);
            if result is !value {
                self.start = 0;
                self.end = value;
            }
            if result is err! {
                return ?(err!);
            }
            if self.end == 0 {
                self.done = true;
                return null;
            }
        }

        let entry = if platform::dirEntryAt(&self.buffer[0..self.end], self.start) is ?value {
            value.asOsDirectoryEntry()
        } else {
            return ?(Error::Invalid!);
        };
        if platform::dirEntryNextOffset(&self.buffer[0..self.end], self.start) is ?value {
            self.start = value;
        } else {
            return ?(Error::Invalid!);
        }
        ?(!entry)
    }
}

extend FileMetadata {
    pub(pkg) fn init(
        kind: FileKind,
        fileId: ?u64,
        linkCount: ?u32,
        size: u64,
        permissions: u32,
        preferredBlockSize: u32,
        accessed: ?Timestamp,
        modified: Timestamp,
        statusChanged: ?Timestamp,
    ) FileMetadata {
        .{ kind, fileId, linkCount, size, permissions, preferredBlockSize, accessed, modified, statusChanged }
    }

    pub(pkg) fn kind(&self) FileKind {
        self.kind
    }

    pub(pkg) fn fileId(&self) ?u64 {
        self.fileId
    }

    pub(pkg) fn linkCount(&self) ?u32 {
        self.linkCount
    }

    pub(pkg) fn size(&self) u64 {
        self.size
    }

    pub(pkg) fn permissions(&self) u32 {
        self.permissions
    }

    pub(pkg) fn preferredBlockSize(&self) u32 {
        self.preferredBlockSize
    }

    pub(pkg) fn accessed(&self) ?Timestamp {
        self.accessed
    }

    pub(pkg) fn modified(&self) Timestamp {
        self.modified
    }

    pub(pkg) fn statusChanged(&self) ?Timestamp {
        self.statusChanged
    }
}

extend FileHandle {
    fn fromPlatform(platform: platform::FileDescriptor) FileHandle {
        .{ platform }
    }

    fn platform(&self) platform::FileDescriptor {
        self.platform
    }

    pub(pkg) fn stdin() FileHandle {
        FileHandle::fromPlatform(platform::FileDescriptor::stdin())
    }

    pub(pkg) fn stdout() FileHandle {
        FileHandle::fromPlatform(platform::FileDescriptor::stdout())
    }

    pub(pkg) fn stderr() FileHandle {
        FileHandle::fromPlatform(platform::FileDescriptor::stderr())
    }

    pub(pkg) fn writeSome(&self, bytes: &[u8]) Error!usize {
        let n = self.platform().writeSome(bytes).?;
        if n > bytes.len() {
            return Error::Invalid!;
        }
        !n
    }

    pub(pkg) fn readSome(&self, bytes: &mut [u8]) Error!usize {
        let n = self.platform().readSome(bytes).?;
        if n > bytes.len() {
            return Error::Invalid!;
        }
        !n
    }

    pub(pkg) fn close(&self) Error!() {
        !(self.platform().close().?)
    }

    pub(pkg) fn seek(&self, offset: i64, whence: SeekWhence) Error!u64 {
        let platformWhence = whence.asPlatformSeekWhence().?;
        !(self.platform().seek(
            offset,
            platformWhence,
        ).?)
    }

    pub(pkg) fn truncate(&self, len: u64) Error!() {
        !(self.platform().truncate(len).?)
    }

    pub(pkg) fn setPermissions(&self, permissions: u32) Error!() {
        !(self.platform().setPermissions(permissions).?)
    }

    pub(pkg) fn sync(&self) Error!() {
        !(self.platform().sync().?)
    }

    pub(pkg) fn syncData(&self) Error!() {
        !(self.platform().syncData().?)
    }

    pub(pkg) fn metadata(&self) Error!FileMetadata {
        let metadata = self.platform().metadata().?;
        !metadata.asOsMetadata()
    }

    fn readDirEntries(&self, buffer: &mut [u8]) Error!usize {
        let n = self.platform().readDirEntries(buffer).?;
        if n > buffer.len() {
            return Error::Invalid!;
        }
        !n
    }
}

extend ProcessId {
    const fn fromPlatform(platform: platform::ProcessId) ProcessId {
        .{ platform }
    }

    fn platform(&self) platform::ProcessId {
        self.platform
    }

    pub(pkg) fn raw(&self) i32 {
        self.platform().raw()
    }

    pub(pkg) fn fromRaw(raw: i32) ProcessId {
        ProcessId::fromPlatform(platform::ProcessId::init(raw))
    }
}

extend WaitStatus {
    fn fromPlatform(platform: platform::WaitStatus) WaitStatus {
        .{ platform }
    }

    fn platform(&self) platform::WaitStatus {
        self.platform
    }

    pub(pkg) fn raw(&self) i32 {
        self.platform().raw()
    }

    pub(pkg) fn exited(&self) bool {
        self.platform().exited()
    }

    pub(pkg) fn signaled(&self) bool {
        self.platform().signaled()
    }

    pub(pkg) fn stopped(&self) bool {
        self.platform().stopped()
    }

    pub(pkg) fn exitCode(&self) ?i32 {
        self.platform().exitCode()
    }

    pub(pkg) fn signal(&self) ?i32 {
        self.platform().signal()
    }

    pub(pkg) fn stopSignal(&self) ?i32 {
        self.platform().stopSignal()
    }
}

extend SpawnResult {
    fn fromPlatform(platform: platform::SpawnResult) SpawnResult {
        .{ platform }
    }

    fn platform(&self) platform::SpawnResult {
        self.platform
    }

    pub(pkg) fn pid(&self) ProcessId {
        ProcessId::fromPlatform(self.platform().pid())
    }

    pub(pkg) fn stdin(&self) ?FileHandle {
        self.platform().stdin().map(&\handle -> FileHandle::fromPlatform(handle))
    }

    pub(pkg) fn stdout(&self) ?FileHandle {
        self.platform().stdout().map(&\handle -> FileHandle::fromPlatform(handle))
    }

    pub(pkg) fn stderr(&self) ?FileHandle {
        self.platform().stderr().map(&\handle -> FileHandle::fromPlatform(handle))
    }
}

extend StdIo {
    fn asPlatformStdio(self) Error!platform::StdIo {
        match self {
            .Inherit => !platform::StdIo::Inherit,
            .Ignore => !platform::StdIo::Ignore,
            .Pipe => !platform::StdIo::Pipe,
        }
    }
}

extend SpawnOptions {
    pub(pkg) fn init() SpawnOptions {
        .{ platform: .init() }
    }

    fn platform(&self) platform::SpawnOptions {
        self.platform
    }

    pub(pkg) fn setStdin(&mut self, behavior: StdIo) Error!() {
        self.platform.setStdin(behavior.asPlatformStdio().?);
        !()
    }

    pub(pkg) fn setStdout(&mut self, behavior: StdIo) Error!() {
        self.platform.setStdout(behavior.asPlatformStdio().?);
        !()
    }

    pub(pkg) fn setStderr(&mut self, behavior: StdIo) Error!() {
        self.platform.setStderr(behavior.asPlatformStdio().?);
        !()
    }

    pub(pkg) fn setCwd(&mut self, path: &u8) () {
        self.platform.setCwd(path);
    }
}
