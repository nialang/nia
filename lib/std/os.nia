pub(pkg) module linux;

@[if os == "linux"]
using pkg::os::linux as platform;

pub comptime let max_path_bytes: usize = platform::max_path_bytes;

pub enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    NotEmpty = 39,
    System = 255,
    _,
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub enum SeekWhence: usize {
    Start = 0,
    Current = 1,
    End = 2,
    _,
}

pub enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub struct FileMetadata {
    kind: FileKind,
    file_id: ?u64,
    link_count: ?u32,
    size: u64,
    permissions: u32,
    preferred_block_size: u32,
    accessed: ?Timestamp,
    modified: Timestamp,
    status_changed: ?Timestamp,
}

pub struct DirectoryEntry {
    kind: FileKind,
    name: &[u8],
}

pub struct DirectoryReader {
    handle: FileHandle,
    buffer: &mut [u8],
    start: usize,
    end: usize,
    done: bool,
}

pub struct FileHandle {
    platform: platform::FileDescriptor,
}

pub struct ProcessId {
    platform: platform::ProcessId,
}

pub struct WaitStatus {
    platform: platform::WaitStatus,
}

pub struct SpawnResult {
    platform: platform::SpawnResult,
}

pub struct SpawnOptions {
    platform: platform::SpawnOptions,
}

pub fn page_size() usize {
    platform::page_size()
}

pub fn page_aligned_len(len: usize) Error!usize {
    platform::page_aligned_len(len).as_os_error()
}

pub fn cwd() FileHandle {
    FileHandle::from_platform(platform::cwd())
}

pub fn getcwd(buffer: &mut [u8]) Error!&[u8] {
    platform::getcwd(buffer).as_os_error()
}

pub fn open_at(
    dir: FileHandle,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileHandle {
    let handle = platform::open_at(
        dir.platform(),
        path,
        mode.as_platform_open_mode(),
        create,
        truncate,
        exclusive,
        permissions,
    ).as_os_error().?;
    !FileHandle::from_platform(handle)
}

pub fn open_dir_at(dir: FileHandle, path: &u8, follow_symlinks: bool) Error!FileHandle {
    let handle = platform::open_dir_at(
        dir.platform(),
        path,
        follow_symlinks,
    ).as_os_error().?;
    !FileHandle::from_platform(handle)
}

pub fn create_dir_at(dir: FileHandle, path: &u8, permissions: u32) Error!void {
    platform::create_dir_at(dir.platform(), path, permissions).as_os_error()
}

pub fn delete_file_at(dir: FileHandle, path: &u8) Error!void {
    platform::delete_file_at(dir.platform(), path).as_os_error()
}

pub fn delete_dir_at(dir: FileHandle, path: &u8) Error!void {
    platform::delete_dir_at(dir.platform(), path).as_os_error()
}

pub fn rename_at(
    old_dir: FileHandle,
    old_path: &u8,
    new_dir: FileHandle,
    new_path: &u8,
) Error!void {
    platform::rename_at(
        old_dir.platform(),
        old_path,
        new_dir.platform(),
        new_path,
    ).as_os_error()
}

pub fn metadata_at(dir: FileHandle, path: &u8, follow_symlinks: bool) Error!FileMetadata {
    let metadata = platform::metadata_at(
        dir.platform(),
        path,
        follow_symlinks,
    ).as_os_error().?;
    !metadata.as_os_metadata()
}

pub fn map_pages(len: usize, align: usize) Error!&mut u8 {
    platform::map_pages(len, align).as_os_error()
}

pub fn unmap_pages(ptr: &mut u8, len: usize) Error!void {
    platform::unmap_pages(ptr, len).as_os_error()
}

pub fn random(bytes: &mut [u8]) Error!void {
    platform::random(bytes).as_os_error()
}

pub fn spawn_raw(path: &u8, argv: &&u8, envp: &&u8) Error!ProcessId {
    let pid = platform::spawn_raw(path, argv, envp).as_os_error().?;
    !ProcessId::from_platform(pid)
}

pub fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) Error!SpawnResult {
    let result = platform::spawn(path, argv, envp, options.platform()).as_os_error().?;
    !SpawnResult::from_platform(result)
}

pub fn wait(pid: ProcessId) Error!WaitStatus {
    let status = platform::wait(pid.platform()).as_os_error().?;
    !WaitStatus::from_platform(status)
}

pub fn try_wait(pid: ProcessId) Error! ?WaitStatus {
    let status = platform::try_wait(pid.platform()).as_os_error().?;
    if let ?value = status {
        !(?WaitStatus::from_platform(value))
    } else null {
        !null
    }
}

pub fn kill(pid: ProcessId) Error!void {
    platform::kill(pid.platform()).as_os_error()
}

pub fn exit(code: i32) void {
    platform::exit(code);
}

extend platform::Errno {
    fn as_os_error(self) Error {
        switch self {
            platform::Errno::PermissionDenied => Error::PermissionDenied,
            platform::Errno::NoEntry => Error::NotFound,
            platform::Errno::Interrupted => Error::Interrupted,
            platform::Errno::Io => Error::Io,
            platform::Errno::BadFd => Error::BadFd,
            platform::Errno::Again => Error::Again,
            platform::Errno::NoMemory => Error::OutOfMemory,
            platform::Errno::Access => Error::Access,
            platform::Errno::Fault => Error::Fault,
            platform::Errno::Busy => Error::Busy,
            platform::Errno::Exists => Error::AlreadyExists,
            platform::Errno::CrossDevice => Error::CrossDevice,
            platform::Errno::NotDir => Error::NotDir,
            platform::Errno::IsDir => Error::IsDir,
            platform::Errno::Invalid => Error::Invalid,
            platform::Errno::NoSpace => Error::NoSpace,
            platform::Errno::ReadOnly => Error::ReadOnly,
            platform::Errno::BrokenPipe => Error::BrokenPipe,
            platform::Errno::OutOfRange => Error::OutOfRange,
            platform::Errno::TooLong => Error::TooLong,
            platform::Errno::NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend[T] platform::Errno!T {
    fn as_os_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            error.as_os_error()!
        }
    }
}

extend OpenMode {
    fn as_platform_open_mode(self) platform::OpenMode {
        switch self {
            OpenMode::ReadOnly => platform::OpenMode::ReadOnly,
            OpenMode::WriteOnly => platform::OpenMode::WriteOnly,
            OpenMode::ReadWrite => platform::OpenMode::ReadWrite,
            _ => platform::OpenMode::ReadOnly,
        }
    }
}

extend SeekWhence {
    fn as_platform_seek_whence(self) platform::SeekWhence {
        switch self {
            SeekWhence::Start => platform::SeekWhence::Start,
            SeekWhence::Current => platform::SeekWhence::Current,
            SeekWhence::End => platform::SeekWhence::End,
            _ => platform::SeekWhence::Start,
        }
    }
}

extend platform::FileKind {
    fn as_os_file_kind(self) FileKind {
        switch self {
            platform::FileKind::BlockDevice => FileKind::BlockDevice,
            platform::FileKind::CharacterDevice => FileKind::CharacterDevice,
            platform::FileKind::Directory => FileKind::Directory,
            platform::FileKind::NamedPipe => FileKind::NamedPipe,
            platform::FileKind::Symlink => FileKind::Symlink,
            platform::FileKind::File => FileKind::File,
            platform::FileKind::UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend platform::Timestamp {
    fn as_os_timestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend platform::FileMetadata {
    fn as_os_metadata(&self) FileMetadata {
        var accessed: ?Timestamp = null;
        if let ?value = self.atime() {
            accessed = ?value.as_os_timestamp();
        } else null {}
        FileMetadata::init(
            self.kind().as_os_file_kind(),
            ?self.inode(),
            ?self.nlink(),
            self.size(),
            self.mode() & 0o7777u32,
            self.block_size(),
            accessed,
            self.mtime().as_os_timestamp(),
            ?self.ctime().as_os_timestamp(),
        )
    }
}

extend platform::DirectoryEntry {
    fn as_os_directory_entry(&self) DirectoryEntry {
        DirectoryEntry::init(self.kind().as_os_file_kind(), self.name())
    }
}

extend Timestamp {
    pub fn init(seconds: i64, nanos: u32) Timestamp {
        { seconds: seconds, nanos: nanos }
    }

    pub fn seconds(&self) i64 {
        self.seconds
    }

    pub fn nanos(&self) u32 {
        self.nanos
    }
}

extend DirectoryEntry {
    pub fn init(kind: FileKind, name: &[u8]) DirectoryEntry {
        { kind: kind, name: name }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn name(&self) &[u8] {
        self.name
    }
}

extend DirectoryReader {
    pub fn init(handle: FileHandle, buffer: &mut [u8]) DirectoryReader {
        { handle: handle, buffer: buffer, start: 0, end: 0, done: false }
    }

    pub fn next(&mut self) ?(Error!DirectoryEntry) {
        if self.done {
            return null;
        }
        if self.start >= self.end {
            self.start = 0;
            if let !value = self.handle.read_dir_entries(self.buffer) {
                self.end = value;
            } else err! {
                return ?(err!);
            }
            if self.end == 0 {
                self.done = true;
                return null;
            }
        }

        let entry = if let ?value = platform::dir_entry_at(&self.buffer[0..self.end], self.start) {
            value.as_os_directory_entry()
        } else null {
            return ?(Error::Invalid!);
        };
        self.start = if let ?value = platform::dir_entry_next_offset(&self.buffer[0..self.end], self.start) {
            value
        } else null {
            return ?(Error::Invalid!);
        };
        ?(!entry)
    }
}

extend FileMetadata {
    pub fn init(
        kind: FileKind,
        file_id: ?u64,
        link_count: ?u32,
        size: u64,
        permissions: u32,
        preferred_block_size: u32,
        accessed: ?Timestamp,
        modified: Timestamp,
        status_changed: ?Timestamp,
    ) FileMetadata {
        {
            kind: kind,
            file_id: file_id,
            link_count: link_count,
            size: size,
            permissions: permissions,
            preferred_block_size: preferred_block_size,
            accessed: accessed,
            modified: modified,
            status_changed: status_changed,
        }
    }

    pub fn kind(&self) FileKind {
        self.kind
    }

    pub fn file_id(&self) ?u64 {
        self.file_id
    }

    pub fn link_count(&self) ?u32 {
        self.link_count
    }

    pub fn size(&self) u64 {
        self.size
    }

    pub fn permissions(&self) u32 {
        self.permissions
    }

    pub fn preferred_block_size(&self) u32 {
        self.preferred_block_size
    }

    pub fn accessed(&self) ?Timestamp {
        self.accessed
    }

    pub fn modified(&self) Timestamp {
        self.modified
    }

    pub fn status_changed(&self) ?Timestamp {
        self.status_changed
    }
}

extend FileHandle {
    fn from_platform(platform: platform::FileDescriptor) FileHandle {
        { platform: platform }
    }

    fn platform(&self) platform::FileDescriptor {
        self.platform
    }

    pub fn stdin() FileHandle {
        FileHandle::from_platform(platform::FileDescriptor::stdin())
    }

    pub fn stdout() FileHandle {
        FileHandle::from_platform(platform::FileDescriptor::stdout())
    }

    pub fn stderr() FileHandle {
        FileHandle::from_platform(platform::FileDescriptor::stderr())
    }

    pub fn write_some(&self, bytes: &[u8]) Error!usize {
        self.platform().write_some(bytes).as_os_error()
    }

    pub fn read_some(&self, bytes: &mut [u8]) Error!usize {
        self.platform().read_some(bytes).as_os_error()
    }

    pub fn close(&self) Error!void {
        self.platform().close().as_os_error()
    }

    pub fn seek(&self, offset: i64, whence: SeekWhence) Error!u64 {
        self.platform().seek(
            offset,
            whence.as_platform_seek_whence(),
        ).as_os_error()
    }

    pub fn truncate(&self, len: u64) Error!void {
        self.platform().truncate(len).as_os_error()
    }

    pub fn sync(&self) Error!void {
        self.platform().sync().as_os_error()
    }

    pub fn sync_data(&self) Error!void {
        self.platform().sync_data().as_os_error()
    }

    pub fn metadata(&self) Error!FileMetadata {
        let metadata = self.platform().metadata().as_os_error().?;
        !metadata.as_os_metadata()
    }

    fn read_dir_entries(&self, buffer: &mut [u8]) Error!usize {
        self.platform().read_dir_entries(buffer).as_os_error()
    }
}

extend ProcessId {
    fn from_platform(platform: platform::ProcessId) ProcessId {
        { platform: platform }
    }

    fn platform(&self) platform::ProcessId {
        self.platform
    }

    pub fn raw(&self) i32 {
        self.platform().raw()
    }
}

extend WaitStatus {
    fn from_platform(platform: platform::WaitStatus) WaitStatus {
        { platform: platform }
    }

    fn platform(&self) platform::WaitStatus {
        self.platform
    }

    pub fn raw(&self) i32 {
        self.platform().raw()
    }

    pub fn exited(&self) bool {
        self.platform().exited()
    }

    pub fn signaled(&self) bool {
        self.platform().signaled()
    }

    pub fn stopped(&self) bool {
        self.platform().stopped()
    }

    pub fn exit_code(&self) ?i32 {
        self.platform().exit_code()
    }

    pub fn signal(&self) ?i32 {
        self.platform().signal()
    }

    pub fn stop_signal(&self) ?i32 {
        self.platform().stop_signal()
    }
}

extend SpawnResult {
    fn from_platform(platform: platform::SpawnResult) SpawnResult {
        { platform: platform }
    }

    fn platform(&self) platform::SpawnResult {
        self.platform
    }

    pub fn pid(&self) ProcessId {
        ProcessId::from_platform(self.platform().pid())
    }

    pub fn stdin(&self) ?FileHandle {
        if let ?handle = self.platform().stdin() {
            ?FileHandle::from_platform(handle)
        } else null {
            null
        }
    }

    pub fn stdout(&self) ?FileHandle {
        if let ?handle = self.platform().stdout() {
            ?FileHandle::from_platform(handle)
        } else null {
            null
        }
    }

    pub fn stderr(&self) ?FileHandle {
        if let ?handle = self.platform().stderr() {
            ?FileHandle::from_platform(handle)
        } else null {
            null
        }
    }
}

extend StdIo {
    fn as_platform_stdio(self) platform::StdIo {
        switch self {
            StdIo::Inherit => platform::StdIo::Inherit,
            StdIo::Ignore => platform::StdIo::Ignore,
            StdIo::Pipe => platform::StdIo::Pipe,
            _ => platform::StdIo::Inherit,
        }
    }
}

extend SpawnOptions {
    pub fn init() SpawnOptions {
        { platform: platform::SpawnOptions::init() }
    }

    fn platform(&self) platform::SpawnOptions {
        self.platform
    }

    pub fn set_stdin(&mut self, behavior: StdIo) void {
        self.platform.set_stdin(behavior.as_platform_stdio());
    }

    pub fn set_stdout(&mut self, behavior: StdIo) void {
        self.platform.set_stdout(behavior.as_platform_stdio());
    }

    pub fn set_stderr(&mut self, behavior: StdIo) void {
        self.platform.set_stderr(behavior.as_platform_stdio());
    }
}
