pub(pkg) module linux;

@[if os == "linux"]
using pkg::os::linux as platform;
using pkg::error;

pub(pkg) const maxPathBytes: usize = platform::maxPathBytes;

pub(pkg) enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    NoChild = 10,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    Unsupported = 38,
    SymlinkLoop = 40,
    NotEmpty = 39,
    System = 255,
    _,
}

pub(pkg) enum SpawnError {
    Setup(Error),
    Stdio(Error),
    Cwd(Error),
    Exec(Error),
    Reap {
        stage: SpawnStage,
        primary: Error,
        cause: Error,
        pid: ProcessId,
    },
}

pub(pkg) enum SpawnStage: i32 {
    Setup = 1,
    Stdio = 2,
    Cwd = 3,
    Exec = 4,
    _,
}

pub(pkg) enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub(pkg) enum SeekWhence: usize {
    Start = 0,
    Current = 1,
    End = 2,
    _,
}

pub(pkg) enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub(pkg) enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub(pkg) struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub(pkg) struct FileMetadata {
    kind: FileKind,
    file_id: ?u64,
    link_count: ?u32,
    size: u64,
    permissions: u32,
    preferred_block_size: u32,
    accessed: ?Timestamp,
    modified: Timestamp,
    status_changed: ?Timestamp,
}

pub(pkg) struct DirectoryEntry {
    kind: FileKind,
    name: &[u8],
}

pub(pkg) struct DirectoryReader {
    buffer: &mut [u8],
    start: usize,
    end: usize,
    done: bool,
}

pub(pkg) struct FileHandle {
    platform: platform::FileDescriptor,
}

pub(pkg) struct ProcessId {
    platform: platform::ProcessId,
}

pub(pkg) struct WaitStatus {
    platform: platform::WaitStatus,
}

pub(pkg) struct SpawnResult {
    platform: platform::SpawnResult,
}

pub(pkg) struct SpawnAttempt {
    platform: platform::SpawnAttempt,
}

pub(pkg) struct SpawnOptions {
    platform: platform::SpawnOptions,
}

pub(pkg) fn pageSize() usize {
    platform::pageSize()
}

pub(pkg) fn pageAlignedLen(len: usize) Error!usize {
    !(platform::pageAlignedLen(len).?)
}

pub(pkg) fn cwd() FileHandle {
    FileHandle::fromPlatform(platform::cwd())
}

pub(pkg) fn getcwd(buffer: &mut [u8]) Error!&[u8] {
    !(platform::getcwd(buffer).?)
}

pub(pkg) fn openAt(
    dir: FileHandle,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileHandle {
    let platform_mode = mode.asPlatformOpenMode().?;
    let handle = platform::open_at(
        dir.platform(),
        path,
        platform_mode,
        create,
        truncate,
        exclusive,
        permissions,
    ).?;
    !FileHandle::fromPlatform(handle)
}

pub(pkg) fn openAtBeneath(
    dir: FileHandle,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    followSymlinks: bool,
) Error!FileHandle {
    let platformMode = mode.asPlatformOpenMode().?;
    let handle = platform::open_at_beneath(
        dir.platform(),
        path,
        platformMode,
        directory,
        create,
        truncate,
        exclusive,
        permissions,
        followSymlinks,
    ).?;
    !FileHandle::fromPlatform(handle)
}

pub(pkg) fn createDirAtBeneath(
    dir: FileHandle,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Error!() {
    !(platform::create_dir_at_beneath(
        dir.platform(),
        parent,
        name,
        permissions,
    ).?)
}

pub(pkg) fn deleteAtBeneath(dir: FileHandle, parent: &u8, name: &u8, directory: bool) Error!() {
    !(platform::delete_at_beneath(dir.platform(), parent, name, directory).?)
}

pub(pkg) fn renameAtBeneath(
    old_dir: FileHandle,
    old_parent: &u8,
    old_name: &u8,
    new_dir: FileHandle,
    new_parent: &u8,
    new_name: &u8,
) Error!() {
    !(platform::rename_at_beneath(
        old_dir.platform(),
        old_parent,
        old_name,
        new_dir.platform(),
        new_parent,
        new_name,
    ).?)
}

pub(pkg) fn metadataAtBeneath(dir: FileHandle, path: &u8, followSymlinks: bool) Error!FileMetadata {
    let metadata = platform::metadataAtBeneath(
        dir.platform(),
        path,
        followSymlinks,
    ).?;
    !metadata.asOsMetadata()
}

pub(pkg) fn mapPages(len: usize, align: usize) Error!platform::MappedPages {
    !(platform::mapPages(len, align).?)
}

pub(pkg) fn unmapPages(ptr: &mut u8, len: usize) Error!() {
    !(platform::unmapPages(ptr, len).?)
}

pub(pkg) fn random(bytes: &mut [u8]) Error!() {
    !(platform::random(bytes).?)
}

pub(pkg) fn spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    SpawnAttempt::fromPlatform(platform::spawn(path, argv, envp, options.platform()))
}

pub(pkg) fn wait(pid: ProcessId) Error!WaitStatus {
    let status = platform::wait(pid.platform()).?;
    !WaitStatus::fromPlatform(status)
}

pub(pkg) fn tryWait(pid: ProcessId) Error! ?WaitStatus {
    let status = platform::try_wait(pid.platform()).?;
    match status {
        ?value => {
            !(?WaitStatus::fromPlatform(value))
        },
        null => {
            !null
        },
    }
}

pub(pkg) fn killWith(pid: ProcessId, signal: i32) Error!() {
    !(platform::kill_with(pid.platform(), signal).?)
}

pub(pkg) fn exit(code: i32) () {
    platform::exit(code);
}

extend platform::Errno : error::IntoError[Error] {
    const fn intoError(self) Error {
        match self {
            .PermissionDenied => Error::PermissionDenied,
            .NoEntry => Error::NotFound,
            .Interrupted => Error::Interrupted,
            .Io => Error::Io,
            .BadFd => Error::BadFd,
            .NoChild => Error::NoChild,
            .Again => Error::Again,
            .NoMemory => Error::OutOfMemory,
            .Access => Error::Access,
            .Fault => Error::Fault,
            .Busy => Error::Busy,
            .Exists => Error::AlreadyExists,
            .CrossDevice => Error::CrossDevice,
            .NotDir => Error::NotDir,
            .IsDir => Error::IsDir,
            .Invalid => Error::Invalid,
            .NoSpace => Error::NoSpace,
            .ReadOnly => Error::ReadOnly,
            .BrokenPipe => Error::BrokenPipe,
            .OutOfRange => Error::OutOfRange,
            .TooLong => Error::TooLong,
            .Unsupported => Error::Unsupported,
            .SymlinkLoop => Error::SymlinkLoop,
            .NotEmpty => Error::NotEmpty,
            _ => Error::System,
        }
    }
}

extend platform::SpawnError : error::IntoError[SpawnError] {
    const fn intoError(self) SpawnError {
        match self {
            .Setup(cause) => SpawnError::Setup(cause.intoError()),
            .Stdio(cause) => SpawnError::Stdio(cause.intoError()),
            .Cwd(cause) => SpawnError::Cwd(cause.intoError()),
            .Exec(cause) => SpawnError::Exec(cause.intoError()),
            .Reap { stage, primary, cause, pid } => SpawnError::Reap {
                stage: stage.asSpawnStage(),
                primary: primary.intoError(),
                cause: cause.intoError(),
                pid: ProcessId::fromPlatform(pid),
            },
        }
    }
}

extend platform::SpawnStage {
    const fn asSpawnStage(self) SpawnStage {
        match self {
            .Setup => SpawnStage::Setup,
            .Stdio => SpawnStage::Stdio,
            .Cwd => SpawnStage::Cwd,
            .Exec => SpawnStage::Exec,
            _ => SpawnStage::Setup,
        }
    }
}

extend SpawnAttempt {
    fn fromPlatform(platform: platform::SpawnAttempt) SpawnAttempt {
        Self { platform: platform }
    }

    pub(pkg) fn finish(&mut self) SpawnError!SpawnResult {
        let result = self.platform.finish().?;
        !SpawnResult::fromPlatform(result)
    }
}

extend OpenMode {
    fn asPlatformOpenMode(self) Error!platform::OpenMode {
        match self {
            .ReadOnly => !platform::OpenMode::ReadOnly,
            .WriteOnly => !platform::OpenMode::WriteOnly,
            .ReadWrite => !platform::OpenMode::ReadWrite,
            _ => Error::Invalid!,
        }
    }
}

extend SeekWhence {
    fn asPlatformSeekWhence(self) Error!platform::SeekWhence {
        match self {
            .Start => !platform::SeekWhence::Start,
            .Current => !platform::SeekWhence::Current,
            .End => !platform::SeekWhence::End,
            _ => Error::Invalid!,
        }
    }
}

extend platform::FileKind {
    fn asOsFileKind(self) FileKind {
        match self {
            .BlockDevice => FileKind::BlockDevice,
            .CharacterDevice => FileKind::CharacterDevice,
            .Directory => FileKind::Directory,
            .NamedPipe => FileKind::NamedPipe,
            .Symlink => FileKind::Symlink,
            .File => FileKind::File,
            .UnixSocket => FileKind::UnixSocket,
            _ => FileKind::Unknown,
        }
    }
}

extend platform::Timestamp {
    fn asOsTimestamp(&self) Timestamp {
        Timestamp::init(self.seconds(), self.nanos())
    }
}

extend platform::FileMetadata {
    fn asOsMetadata(&self) FileMetadata {
        let mut accessed: ?Timestamp = null;
        if self.atime() is ?value {
            accessed = ?value.asOsTimestamp();
        }
        FileMetadata::init(
            self.kind().asOsFileKind(),
            ?self.inode(),
            ?self.nlink(),
            self.size(),
            self.mode() & 0o7777u32,
            self.blockSize(),
            accessed,
            self.mtime().asOsTimestamp(),
            ?self.ctime().asOsTimestamp(),
        )
    }
}

extend platform::DirectoryEntry {
    fn asOsDirectoryEntry(&self) DirectoryEntry {
        DirectoryEntry::init(self.kind().asOsFileKind(), self.name())
    }
}

extend Timestamp {
    pub(pkg) fn init(seconds: i64, nanos: u32) Timestamp {
        Self { seconds: seconds, nanos: nanos }
    }

    pub(pkg) fn seconds(&self) i64 {
        self.seconds
    }

    pub(pkg) fn nanos(&self) u32 {
        self.nanos
    }
}

extend DirectoryEntry {
    pub(pkg) fn init(kind: FileKind, name: &[u8]) DirectoryEntry {
        Self { kind: kind, name: name }
    }

    pub(pkg) fn kind(&self) FileKind {
        self.kind
    }

    pub(pkg) fn name(&self) &[u8] {
        self.name
    }
}

extend DirectoryReader {
    pub(pkg) fn init(buffer: &mut [u8]) DirectoryReader {
        Self { buffer: buffer, start: 0, end: 0, done: false }
    }

    pub(pkg) fn isDone(&self) bool {
        self.done
    }

    pub(pkg) fn next(&mut self, handle: FileHandle) ?(Error!DirectoryEntry) {
        if self.done {
            return null;
        }
        if self.start >= self.end {
            match handle.readDirEntries(self.buffer) {
                !value => {
                    self.start = 0;
                    self.end = value;
                },
                err! => {
                    return ?(err!);
                },
            }
            if self.end == 0 {
                self.done = true;
                return null;
            }
        }

        let entry = match platform::dir_entry_at(&self.buffer[0..self.end], self.start) {
            ?value => {
                value.asOsDirectoryEntry()
            },
            null => {
                return ?(Error::Invalid!);
            },
        };
        self.start = match platform::dir_entry_next_offset(&self.buffer[0..self.end], self.start) {
            ?value => {
                value
            },
            null => {
                return ?(Error::Invalid!);
            },
        };
        ?(!entry)
    }
}

extend FileMetadata {
    pub(pkg) fn init(
        kind: FileKind,
        file_id: ?u64,
        link_count: ?u32,
        size: u64,
        permissions: u32,
        preferred_block_size: u32,
        accessed: ?Timestamp,
        modified: Timestamp,
        status_changed: ?Timestamp,
    ) FileMetadata {
        Self {
            kind: kind,
            file_id: file_id,
            link_count: link_count,
            size: size,
            permissions: permissions,
            preferred_block_size: preferred_block_size,
            accessed: accessed,
            modified: modified,
            status_changed: status_changed,
        }
    }

    pub(pkg) fn kind(&self) FileKind {
        self.kind
    }

    pub(pkg) fn fileId(&self) ?u64 {
        self.file_id
    }

    pub(pkg) fn linkCount(&self) ?u32 {
        self.link_count
    }

    pub(pkg) fn size(&self) u64 {
        self.size
    }

    pub(pkg) fn permissions(&self) u32 {
        self.permissions
    }

    pub(pkg) fn preferredBlockSize(&self) u32 {
        self.preferred_block_size
    }

    pub(pkg) fn accessed(&self) ?Timestamp {
        self.accessed
    }

    pub(pkg) fn modified(&self) Timestamp {
        self.modified
    }

    pub(pkg) fn statusChanged(&self) ?Timestamp {
        self.status_changed
    }
}

extend FileHandle {
    fn fromPlatform(platform: platform::FileDescriptor) FileHandle {
        Self { platform: platform }
    }

    fn platform(&self) platform::FileDescriptor {
        self.platform
    }

    pub(pkg) fn stdin() FileHandle {
        FileHandle::fromPlatform(platform::FileDescriptor::stdin())
    }

    pub(pkg) fn stdout() FileHandle {
        FileHandle::fromPlatform(platform::FileDescriptor::stdout())
    }

    pub(pkg) fn stderr() FileHandle {
        FileHandle::fromPlatform(platform::FileDescriptor::stderr())
    }

    pub(pkg) fn writeSome(&self, bytes: &[u8]) Error!usize {
        let n = self.platform().write_some(bytes).?;
        if n > bytes.len() {
            return Error::Invalid!;
        }
        !n
    }

    pub(pkg) fn readSome(&self, bytes: &mut [u8]) Error!usize {
        let n = self.platform().read_some(bytes).?;
        if n > bytes.len() {
            return Error::Invalid!;
        }
        !n
    }

    pub(pkg) fn close(&self) Error!() {
        !(self.platform().close().?)
    }

    pub(pkg) fn seek(&self, offset: i64, whence: SeekWhence) Error!u64 {
        let platform_whence = whence.asPlatformSeekWhence().?;
        !(self.platform().seek(
            offset,
            platform_whence,
        ).?)
    }

    pub(pkg) fn truncate(&self, len: u64) Error!() {
        !(self.platform().truncate(len).?)
    }

    pub(pkg) fn setPermissions(&self, permissions: u32) Error!() {
        !(self.platform().set_permissions(permissions).?)
    }

    pub(pkg) fn sync(&self) Error!() {
        !(self.platform().sync().?)
    }

    pub(pkg) fn syncData(&self) Error!() {
        !(self.platform().sync_data().?)
    }

    pub(pkg) fn metadata(&self) Error!FileMetadata {
        let metadata = self.platform().metadata().?;
        !metadata.asOsMetadata()
    }

    fn readDirEntries(&self, buffer: &mut [u8]) Error!usize {
        let n = self.platform().read_dir_entries(buffer).?;
        if n > buffer.len() {
            return Error::Invalid!;
        }
        !n
    }
}

extend ProcessId {
    const fn fromPlatform(platform: platform::ProcessId) ProcessId {
        Self { platform: platform }
    }

    fn platform(&self) platform::ProcessId {
        self.platform
    }

    pub(pkg) fn raw(&self) i32 {
        self.platform().raw()
    }

    pub(pkg) fn fromRaw(raw: i32) ProcessId {
        ProcessId::fromPlatform(platform::ProcessId::init(raw))
    }
}

