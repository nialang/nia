using root::builtin::Len;
pub(root) module linux;
pub(root) module windows;
pub(root) module macos;

@[if os == "linux"]
using root::os::linux as platform;
@[if os == "windows"]
using root::os::windows as platform;
@[if os == "macos"]
using root::os::macos as platform;
using root::builtin;
using root::option;

pub(root) const maxPathBytes: usize = platform::maxPathBytes;

pub(root) enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    NoChild = 10,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    Unsupported = 38,
    SymlinkLoop = 40,
    NotEmpty = 39,
    System = 255,
    _,
}

pub(root) enum SpawnError {
    Setup(Error),
    Stdio(Error),
    Cwd(Error),
    Exec(Error),
    Reap {
        stage: SpawnStage,
        primary: Error,
        cause: Error,
        pid: ProcessId,
    },
}

pub(root) enum SpawnStage: i32 {
    Setup = 1,
    Stdio = 2,
    Cwd = 3,
    Exec = 4,
    _,
}

pub(root) enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub(root) enum SeekWhence: usize {
    Start = 0,
    Current = 1,
    End = 2,
    _,
}

pub(root) enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub(root) enum FileKind: i32 {
    BlockDevice = 1,
    CharacterDevice = 2,
    Directory = 3,
    NamedPipe = 4,
    Symlink = 5,
    File = 6,
    UnixSocket = 7,
    Unknown = 255,
    _,
}

pub(root) struct Timestamp {
    seconds: i64,
    nanos: u32,
}

pub(root) struct FileMetadata {
    kind: FileKind,
    fileId: ?u64,
    linkCount: ?u32,
    size: u64,
    permissions: u32,
    preferredBlockSize: u32,
    accessed: ?Timestamp,
    modified: Timestamp,
    statusChanged: ?Timestamp,
}

pub(root) struct DirectoryEntry {
    kind: FileKind,
    name: &[u8],
    size: u64,
}

pub(root) struct DirectoryReader {
    buffer: &mut [u8],
    start: usize,
    end: usize,
    done: bool,
    platform: platform::DirectoryReader,
}

pub(root) struct FileHandle {
    platform: platform::FileDescriptor,
}

pub(root) struct ProcessId {
    platform: platform::ProcessId,
}

pub(root) struct WaitStatus {
    platform: platform::WaitStatus,
}

pub(root) struct SpawnResult {
    platform: platform::SpawnResult,
}

pub(root) struct SpawnAttempt {
    platform: platform::SpawnAttempt,
}

pub(root) struct SpawnOptions {
    platform: platform::SpawnOptions,
}

pub(root) fun pageSize() usize {
    platform::pageSize()
}

pub(root) fun pageAlignedLen(len: usize) Error!usize {
    !(platform::pageAlignedLen(len).?)
}

pub(root) fun cwd() FileHandle {
    .fromPlatform(platform::cwd())
}

pub(root) fun getCwd(buffer: &mut [u8]) Error!&[u8] {
    !(platform::getCwd(buffer).?)
}

pub(root) fun openAt(
    dir: FileHandle,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileHandle {
    let platformMode = mode.asPlatformOpenMode().?;
    let handle = platform::openAt(
        dir.platform(),
        path,
        platformMode,
        create,
        truncate,
        exclusive,
        permissions,
    ).?;
    !.fromPlatform(handle)
}

pub(root) fun openAtBeneath(
    dir: FileHandle,
    path: &u8,
    mode: OpenMode,
    directory: bool,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
    followSymlinks: bool,
) Error!FileHandle {
    let platformMode = mode.asPlatformOpenMode().?;
    let handle = platform::openAtBeneath(
        dir.platform(),
        path,
        platformMode,
        directory,
        create,
        truncate,
        exclusive,
        permissions,
        followSymlinks,
    ).?;
    !.fromPlatform(handle)
}

pub(root) fun createDirAtBeneath(
    dir: FileHandle,
    parent: &u8,
    name: &u8,
    permissions: u32,
) Error!() {
    !(platform::createDirAtBeneath(
        dir.platform(),
        parent,
        name,
        permissions,
    ).?)
}

pub(root) fun deleteAtBeneath(dir: FileHandle, parent: &u8, name: &u8, directory: bool) Error!() {
    !(platform::deleteAtBeneath(dir.platform(), parent, name, directory).?)
}

pub(root) fun renameAtBeneath(
    oldDir: FileHandle,
    oldParent: &u8,
    oldName: &u8,
    newDir: FileHandle,
    newParent: &u8,
    newName: &u8,
) Error!() {
    !(platform::renameAtBeneath(
        oldDir.platform(),
        oldParent,
        oldName,
        newDir.platform(),
        newParent,
        newName,
    ).?)
}

pub(root) fun metadataAtBeneath(dir: FileHandle, path: &u8, followSymlinks: bool) Error!FileMetadata {
    let metadata = platform::metadataAtBeneath(
        dir.platform(),
        path,
        followSymlinks,
    ).?;
    !metadata.asOsMetadata()
}

pub(root) fun initPlatformDirectoryReader() platform::DirectoryReader {
    platform::initDirectoryReader()
}

pub(root) fun mapPages(len: usize, align: usize) Error!platform::MappedPages {
    !(platform::mapPages(len, align).?)
}

pub(root) fun unmapPages(ptr: &mut u8, len: usize) Error!() {
    !(platform::unmapPages(ptr, len).?)
}

pub(root) fun random(bytes: &mut [u8]) Error!() {
    !(platform::random(bytes).?)
}

pub(root) fun spawn(path: &u8, argv: &&u8, envp: &&u8, options: SpawnOptions) SpawnAttempt {
    .fromPlatform(platform::spawn(path, argv, envp, options.platform()))
}

pub(root) fun wait(pid: ProcessId) Error!WaitStatus {
    let status = platform::wait(pid.platform()).?;
    !.fromPlatform(status)
}

pub(root) fun tryWait(pid: ProcessId) Error! ?WaitStatus {
    let status = platform::tryWait(pid.platform()).?;
    !status.map(\value: platform::WaitStatus -> WaitStatus::fromPlatform(value))
}

pub(root) fun killWith(pid: ProcessId, signal: i32) Error!() {
    !(platform::killWith(pid.platform(), signal).?)
}

// Public runtime primitive used by the toolchain-owned startup template.
pub fun exit(code: i32) () {
    platform::exit(code);
}

extend platform::Errno : builtin::IntoError[Error] {
    const fun intoError(self) Error {
        match self {
            .PermissionDenied => .PermissionDenied,
            .NoEntry => .NotFound,
            .Interrupted => .Interrupted,
            .Io => .Io,
            .BadFd => .BadFd,
            .NoChild => .NoChild,
            .Again => .Again,
            .NoMemory => .OutOfMemory,
            .Access => .Access,
            .Fault => .Fault,
            .Busy => .Busy,
            .Exists => .AlreadyExists,
            .CrossDevice => .CrossDevice,
            .NotDir => .NotDir,
            .IsDir => .IsDir,
            .Invalid => .Invalid,
            .NoSpace => .NoSpace,
            .ReadOnly => .ReadOnly,
            .BrokenPipe => .BrokenPipe,
            .OutOfRange => .OutOfRange,
            .TooLong => .TooLong,
            .Unsupported => .Unsupported,
            .SymlinkLoop => .SymlinkLoop,
            .NotEmpty => .NotEmpty,
            _ => .System,
        }
    }
}

extend platform::SpawnError : builtin::IntoError[SpawnError] {
    const fun intoError(self) SpawnError {
        match self {
            .Setup(cause) => .Setup(cause.intoError()),
            .Stdio(cause) => .Stdio(cause.intoError()),
            .Cwd(cause) => .Cwd(cause.intoError()),
            .Exec(cause) => .Exec(cause.intoError()),
            .Reap { stage, primary, cause, pid } => .Reap {
                stage: stage.asSpawnStage(),
                primary: primary.intoError(),
                cause: cause.intoError(),
                pid: ProcessId::fromPlatform(pid),
            },
        }
    }
}

extend platform::SpawnStage {
    const fun asSpawnStage(self) SpawnStage {
        match self {
            .Setup => .Setup,
            .Stdio => .Stdio,
            .Cwd => .Cwd,
            .Exec => .Exec,
            _ => .Setup,
        }
    }
}

extend SpawnAttempt {
    fun fromPlatform(platform: platform::SpawnAttempt) SpawnAttempt {
        .{ platform }
    }

    pub(root) fun finish(&mut self) SpawnError!SpawnResult {
        let result = self.platform.finish().?;
        !.fromPlatform(result)
    }
}

extend OpenMode {
    fun asPlatformOpenMode(self) Error!platform::OpenMode {
        match self {
            .ReadOnly => !.ReadOnly,
            .WriteOnly => !.WriteOnly,
            .ReadWrite => !.ReadWrite,
            _ => .Invalid!,
        }
    }
}

extend SeekWhence {
    fun asPlatformSeekWhence(self) Error!platform::SeekWhence {
        match self {
            .Start => !.Start,
            .Current => !.Current,
            .End => !.End,
            _ => .Invalid!,
        }
    }
}

extend platform::FileKind {
    fun asOsFileKind(self) FileKind {
        match self {
            .BlockDevice => .BlockDevice,
            .CharacterDevice => .CharacterDevice,
            .Directory => .Directory,
            .NamedPipe => .NamedPipe,
            .Symlink => .Symlink,
            .File => .File,
            .UnixSocket => .UnixSocket,
            _ => .Unknown,
        }
    }
}

extend platform::Timestamp {
    fun asOsTimestamp(&self) Timestamp {
        .init(self.seconds(), self.nanos())
    }
}

extend platform::FileMetadata {
    fun asOsMetadata(&self) FileMetadata {
        .init(
            self.kind().asOsFileKind(),
            ?self.inode(),
            ?self.nlink(),
            self.size(),
            self.mode() & 0o7777,
            self.blockSize(),
            self.atime().map[Timestamp, _](\value: platform::Timestamp -> value.asOsTimestamp()),
            self.mtime().asOsTimestamp(),
            self.ctime().map[Timestamp, _](\value: platform::Timestamp -> value.asOsTimestamp()),
        )
    }
}

extend platform::DirectoryEntry {
    fun asOsDirectoryEntry(&self) DirectoryEntry {
        .init(self.kind().asOsFileKind(), self.name(), self.size())
    }
}

extend Timestamp {
    pub(root) fun init(seconds: i64, nanos: u32) Timestamp {
        .{ seconds, nanos }
    }

    pub(root) fun seconds(&self) i64 {
        self.seconds
    }

    pub(root) fun nanos(&self) u32 {
        self.nanos
    }
}

extend DirectoryEntry {
    pub(root) fun init(kind: FileKind, name: &[u8], size: u64) DirectoryEntry {
        .{ kind, name, size }
    }

    pub(root) fun kind(&self) FileKind {
        self.kind
    }

    pub(root) fun name(&self) &[u8] {
        self.name
    }

    pub(root) fun size(&self) u64 {
        self.size
    }
}

extend DirectoryReader {
    pub(root) fun init(buffer: &mut [u8]) DirectoryReader {
        .{ buffer, start: 0, end: 0, done: false, platform: initPlatformDirectoryReader() }
    }

    pub(root) fun close(&mut self) Error!() {
        self.done = true;
        self.start = 0;
        self.end = 0;
        !(platform::closeDirectoryReader(&mut self.platform).?)
    }

    pub(root) fun isDone(&self) bool {
        self.done
    }

    pub(root) fun next(&mut self, handle: FileHandle) ?(Error!DirectoryEntry) {
        if self.done {
            return null;
        }
        if self.start >= self.end {
            let result = handle.readDirEntries(&mut self.platform, self.buffer);
            if result is !value {
                self.start = 0;
                self.end = value;
            }
            if result is err! {
                _ = self.close();
                return ?(err!);
            }
            if self.end == 0 {
                self.done = true;
                return null;
            }
        }

        let entry = match platform::dirEntryAt(handle.platform(), &self.buffer[0..self.end], self.start) {
            !value => value.asOsDirectoryEntry(),
            error! => {
                _ = self.close();
                return ?(error.intoError()!);
            },
        };
        if platform::dirEntryNextOffset(&self.buffer[0..self.end], self.start) is ?value {
            self.start = value;
        } else {
            return ?(Error::Invalid!);
        }
        ?(!entry)
    }
}

extend FileMetadata {
    pub(root) fun init(
        kind: FileKind,
        fileId: ?u64,
        linkCount: ?u32,
        size: u64,
        permissions: u32,
        preferredBlockSize: u32,
        accessed: ?Timestamp,
        modified: Timestamp,
        statusChanged: ?Timestamp,
    ) FileMetadata {
        .{ kind, fileId, linkCount, size, permissions, preferredBlockSize, accessed, modified, statusChanged }
    }

    pub(root) fun kind(&self) FileKind {
        self.kind
    }

    pub(root) fun fileId(&self) ?u64 {
        self.fileId
    }

    pub(root) fun linkCount(&self) ?u32 {
        self.linkCount
    }

    pub(root) fun size(&self) u64 {
        self.size
    }

    pub(root) fun permissions(&self) u32 {
        self.permissions
    }

    pub(root) fun preferredBlockSize(&self) u32 {
        self.preferredBlockSize
    }

    pub(root) fun accessed(&self) ?Timestamp {
        self.accessed
    }

    pub(root) fun modified(&self) Timestamp {
        self.modified
    }

    pub(root) fun statusChanged(&self) ?Timestamp {
        self.statusChanged
    }
}

extend FileHandle {
    fun fromPlatform(platform: platform::FileDescriptor) FileHandle {
        .{ platform }
    }

    fun platform(&self) platform::FileDescriptor {
        self.platform
    }

    pub(root) fun stdin() FileHandle {
        .fromPlatform(platform::FileDescriptor::stdin())
    }

    pub(root) fun stdout() FileHandle {
        .fromPlatform(platform::FileDescriptor::stdout())
    }

    pub(root) fun stderr() FileHandle {
        .fromPlatform(platform::FileDescriptor::stderr())
    }

    pub(root) fun writeSome(&self, bytes: &[u8]) Error!usize {
        let n = self.platform().writeSome(bytes).?;
        if n > bytes.len() {
            return .Invalid!;
        }
        !n
    }

    pub(root) fun readSome(&self, bytes: &mut [u8]) Error!usize {
        let n = self.platform().readSome(bytes).?;
        if n > bytes.len() {
            return .Invalid!;
        }
        !n
    }

    pub(root) fun close(&self) Error!() {
        !(self.platform().close().?)
    }

    pub(root) fun seek(&self, offset: i64, whence: SeekWhence) Error!u64 {
        let platformWhence = whence.asPlatformSeekWhence().?;
        !(self.platform().seek(
            offset,
            platformWhence,
        ).?)
    }

    pub(root) fun truncate(&self, len: u64) Error!() {
        !(self.platform().truncate(len).?)
    }

    pub(root) fun setPermissions(&self, permissions: u32) Error!() {
        !(self.platform().setPermissions(permissions).?)
    }

    pub(root) fun sync(&self) Error!() {
        !(self.platform().sync().?)
    }

    pub(root) fun syncData(&self) Error!() {
        !(self.platform().syncData().?)
    }

    pub(root) fun metadata(&self) Error!FileMetadata {
        let metadata = self.platform().metadata().?;
        !metadata.asOsMetadata()
    }

    fun readDirEntries(&self, reader: &mut platform::DirectoryReader, buffer: &mut [u8]) Error!usize {
        let n = platform::readDirEntries(reader, self.platform(), buffer).?;
        if n > buffer.len() {
            return .Invalid!;
        }
        !n
    }
}

extend ProcessId {
    const fun fromPlatform(platform: platform::ProcessId) ProcessId {
        .{ platform }
    }

    const fun platform(&self) platform::ProcessId {
        self.platform
    }

    pub(root) const fun raw(&self) i32 {
        self.platform().raw()
    }

    pub(root) const fun fromRaw(raw: i32) ProcessId {
        .fromPlatform(platform::ProcessId::init(raw))
    }
}

extend WaitStatus {
    fun fromPlatform(platform: platform::WaitStatus) WaitStatus {
        .{ platform }
    }

    fun platform(&self) platform::WaitStatus {
        self.platform
    }

    pub(root) fun raw(&self) i32 {
        self.platform().raw()
    }

    pub(root) fun exited(&self) bool {
        self.platform().exited()
    }

    pub(root) fun signaled(&self) bool {
        self.platform().signaled()
    }

    pub(root) fun stopped(&self) bool {
        self.platform().stopped()
    }

    pub(root) fun exitCode(&self) ?i32 {
        self.platform().exitCode()
    }

    pub(root) fun signal(&self) ?i32 {
        self.platform().signal()
    }

    pub(root) fun stopSignal(&self) ?i32 {
        self.platform().stopSignal()
    }
}

extend SpawnResult {
    fun fromPlatform(platform: platform::SpawnResult) SpawnResult {
        .{ platform }
    }

    fun platform(&self) platform::SpawnResult {
        self.platform
    }

    pub(root) fun pid(&self) ProcessId {
        .fromPlatform(self.platform().pid())
    }

    pub(root) fun stdin(&self) ?FileHandle {
        self.platform().stdin().map[FileHandle, _](\handle: platform::FileDescriptor -> FileHandle::fromPlatform(handle))
    }

    pub(root) fun stdout(&self) ?FileHandle {
        self.platform().stdout().map[FileHandle, _](\handle: platform::FileDescriptor -> FileHandle::fromPlatform(handle))
    }

    pub(root) fun stderr(&self) ?FileHandle {
        self.platform().stderr().map[FileHandle, _](\handle: platform::FileDescriptor -> FileHandle::fromPlatform(handle))
    }
}

extend StdIo {
    fun asPlatformStdio(self) Error!platform::StdIo {
        match self {
            .Inherit => !.Inherit,
            .Ignore => !.Ignore,
            .Pipe => !.Pipe,
        }
    }
}

extend SpawnOptions {
    pub(root) fun init() SpawnOptions {
        .{ platform: .init() }
    }

    fun platform(&self) platform::SpawnOptions {
        self.platform
    }

    pub(root) fun setStdin(&mut self, behavior: StdIo) Error!() {
        self.platform.setStdin(behavior.asPlatformStdio().?);
        !()
    }

    pub(root) fun setStdout(&mut self, behavior: StdIo) Error!() {
        self.platform.setStdout(behavior.asPlatformStdio().?);
        !()
    }

    pub(root) fun setStderr(&mut self, behavior: StdIo) Error!() {
        self.platform.setStderr(behavior.asPlatformStdio().?);
        !()
    }

    pub(root) fun setCwd(&mut self, path: &u8) () {
        self.platform.setCwd(path);
    }
}
