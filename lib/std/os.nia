    fn fromPlatform(platform: platform::WaitStatus) WaitStatus {
        Self { platform: platform }
    }

    fn platform(&self) platform::WaitStatus {
        self.platform
    }

    pub(pkg) fn raw(&self) i32 {
        self.platform().raw()
    }

    pub(pkg) fn exited(&self) bool {
        self.platform().exited()
    }

    pub(pkg) fn signaled(&self) bool {
        self.platform().signaled()
    }

    pub(pkg) fn stopped(&self) bool {
        self.platform().stopped()
    }

    pub(pkg) fn exitCode(&self) ?i32 {
        self.platform().exitCode()
    }

    pub(pkg) fn signal(&self) ?i32 {
        self.platform().signal()
    }

    pub(pkg) fn stopSignal(&self) ?i32 {
        self.platform().stopSignal()
    }
}

extend SpawnResult {
    fn fromPlatform(platform: platform::SpawnResult) SpawnResult {
        Self { platform: platform }
    }

    fn platform(&self) platform::SpawnResult {
        self.platform
    }

    pub(pkg) fn pid(&self) ProcessId {
        ProcessId::fromPlatform(self.platform().pid())
    }

    pub(pkg) fn stdin(&self) ?FileHandle {
        match self.platform().stdin() {
            ?handle => {
                ?FileHandle::fromPlatform(handle)
            },
            null => {
                null
            },
        }
    }

    pub(pkg) fn stdout(&self) ?FileHandle {
        match self.platform().stdout() {
            ?handle => {
                ?FileHandle::fromPlatform(handle)
            },
            null => {
                null
            },
        }
    }

    pub(pkg) fn stderr(&self) ?FileHandle {
        match self.platform().stderr() {
            ?handle => {
                ?FileHandle::fromPlatform(handle)
            },
            null => {
                null
            },
        }
    }
}

extend StdIo {
    fn asPlatformStdio(self) Error!platform::StdIo {
        match self {
            .Inherit => !platform::StdIo::Inherit,
            .Ignore => !platform::StdIo::Ignore,
            .Pipe => !platform::StdIo::Pipe,
        }
    }
}

extend SpawnOptions {
    pub(pkg) fn init() SpawnOptions {
        Self { platform: .init() }
    }

    fn platform(&self) platform::SpawnOptions {
        self.platform
    }

    pub(pkg) fn setStdin(&mut self, behavior: StdIo) Error!() {
        self.platform.setStdin(behavior.asPlatformStdio().?);
        !()
    }

    pub(pkg) fn setStdout(&mut self, behavior: StdIo) Error!() {
        self.platform.setStdout(behavior.asPlatformStdio().?);
        !()
    }

    pub(pkg) fn setStderr(&mut self, behavior: StdIo) Error!() {
        self.platform.setStderr(behavior.asPlatformStdio().?);
        !()
    }

    pub(pkg) fn setCwd(&mut self, path: &u8) () {
        self.platform.setCwd(path);
    }
}
