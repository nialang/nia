comptime if @builtin().target.os == "linux" {
    import std.os.linux as platform;
}

pub using platform::{Error, FileDescriptor, OpenMode, SeekWhence};

pub comptime let max_path_bytes: usize = platform::max_path_bytes;

pub fn page_size() usize {
    platform::page_size()
}

pub fn page_aligned_len(len: usize) Error!usize {
    platform::page_aligned_len(len)
}

pub fn cwd() FileDescriptor {
    platform::cwd()
}

pub fn open_at(
    dir: FileDescriptor,
    path: &u8,
    mode: OpenMode,
    create: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
) Error!FileDescriptor {
    platform::open_at(dir, path, mode, create, truncate, exclusive, permissions)
}

pub fn open_dir_at(dir: FileDescriptor, path: &u8, follow_symlinks: bool) Error!FileDescriptor {
    platform::open_dir_at(dir, path, follow_symlinks)
}

pub fn create_dir_at(dir: FileDescriptor, path: &u8, permissions: u32) Error!void {
    platform::create_dir_at(dir, path, permissions)
}

pub fn delete_file_at(dir: FileDescriptor, path: &u8) Error!void {
    platform::delete_file_at(dir, path)
}

pub fn delete_dir_at(dir: FileDescriptor, path: &u8) Error!void {
    platform::delete_dir_at(dir, path)
}

pub fn rename_at(
    old_dir: FileDescriptor,
    old_path: &u8,
    new_dir: FileDescriptor,
    new_path: &u8,
) Error!void {
    platform::rename_at(old_dir, old_path, new_dir, new_path)
}

pub fn map_pages(len: usize, align: usize) Error!&mut u8 {
    platform::map_pages(len, align)
}

pub fn unmap_pages(ptr: &mut u8, len: usize) Error!void {
    platform::unmap_pages(ptr, len)
}

pub fn exit(code: i32) void {
    platform::exit(code);
}
