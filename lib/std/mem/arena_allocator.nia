using pkg::math;
using pkg::mem::allocator;
using pkg::mem::types;

using allocator::Allocator;
using types::{Block, Error, Layout};

struct ArenaChunk {
    block: Block,
    end_index: usize,
    next: ?&mut ArenaChunk,
}

pub struct ArenaAllocator {
    child: &mut Allocator,
    used_list: ?&mut ArenaChunk,
    free_list: ?&mut ArenaChunk,
}

extend ArenaAllocator {
    pub fn init(child: &mut Allocator) ArenaAllocator {
        { child: child, used_list: null, free_list: null }
    }

    pub fn deinit(&mut self) Error!void {
        let used = self.used_list;
        let free = self.free_list;
        self.used_list = null;
        self.free_list = null;
        self.free_detached_lists(used, free)
    }

    pub fn reset(&mut self) Error!void {
        self.deinit()
    }

    pub fn reset_retain_capacity(&mut self) Error!void {
        self.move_used_to_free_list();
        !{}
    }

    pub fn reset_retain_with_limit(&mut self, limit: usize) Error!void {
        self.move_used_to_free_list();
        self.trim_free_list(limit).?;
        !{}
    }

    pub fn query_capacity(&self) usize {
        let used = self.list_capacity(self.used_list);
        let free = self.list_capacity(self.free_list);
        if ?total = used.checked_add(free) {
            total
        } or null {
            usize::MAX
        }
    }

    pub fn query_used(&self) usize {
        self.list_used(self.used_list)
    }
}

extend ArenaAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) Error!Block {
        if layout.is_empty() {
            return !Block::empty(layout);
        }

        if ?block = self.alloc_from_optional_chunk(self.used_list, layout) {
            return !block;
        } or null {
        }

        if mut ?chunk = self.pop_free_chunk(layout) {
            chunk.next = self.used_list;
            self.used_list = ?chunk;
            if ?block = alloc_from_chunk(chunk, layout) {
                return !block;
            } or null {
                return Error::OutOfMemory!;
            }
        } or null {
        }

        let prev_capacity = if ?chunk = self.used_list {
            chunk_payload_capacity(chunk)
        } or null {
            0usize
        };
        let mut chunk = self.allocate_chunk(layout, prev_capacity).?;
        chunk.next = self.used_list;
        self.used_list = ?chunk;
        if ?block = alloc_from_chunk(chunk, layout) {
            !block
        } or null {
            Error::OutOfMemory!
        }
    }

    pub fn resize(&mut self, block: Block, new_layout: Layout) bool {
        if block.align() != new_layout.align() {
            return false;
        }
        if block.is_empty() {
            return new_layout.is_empty();
        }
        let mut first = if ?chunk = self.used_list {
            chunk
        } or null {
            return false;
        };
        if not self.owns_block(block) {
            return false;
        }
        if not chunk_owns_block(first, block) or not is_last_allocation(first, block) {
            return new_layout.size() <= block.size();
        }
        if new_layout.size() <= block.size() {
            first.end_index -= block.size() - new_layout.size();
            return true;
        }

        let add = new_layout.size() - block.size();
        let new_end = if ?value = first.end_index.checked_add(add) {
            value
        } or null {
            return false;
        };
        if new_end > chunk_payload_capacity(first) {
            return false;
        }
        first.end_index = new_end;
        true
    }

    pub fn remap(&mut self, block: Block, new_layout: Layout) ?Block {
        if self.resize(block, new_layout) {
            ?Block::init(block.ptr(), new_layout)
        } else if block.is_empty() and new_layout.is_empty() {
            ?Block::empty(new_layout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) Error!void {
        if block.is_empty() {
            return !{};
        }
        let mut first = if ?chunk = self.used_list {
            chunk
        } or null {
            return Error::Invalid!;
        };
        if not self.owns_block(block) {
            return Error::Invalid!;
        }
        if chunk_owns_block(first, block) and is_last_allocation(first, block) {
            first.end_index -= block.size();
        }
        !{}
    }
}

extend ArenaAllocator {
    fn allocate_chunk(&mut self, layout: Layout, prev_capacity: usize) Error!&mut ArenaChunk {
        let payload_capacity = chunk_capacity_for(layout, prev_capacity).?;
        let total_size = if ?value = std::builtin::size[ArenaChunk]().checked_add(payload_capacity) {
            value
        } or null {
            return Error::OutOfMemory!;
        };
        let block_align = max_usize(std::builtin::align[ArenaChunk](), layout.align());
        let block_layout = Layout::init(total_size, block_align).?;
        let block = self.child.alloc(block_layout).?;
        let mut chunk = block.ptr() as &mut ArenaChunk;
        chunk.* = { block: block, end_index: 0, next: null };
        !chunk
    }

    fn alloc_from_optional_chunk(&mut self, maybe_chunk: ?&mut ArenaChunk, layout: Layout) ?Block {
        if ?chunk = maybe_chunk {
            alloc_from_chunk(chunk, layout)
        } or null {
            null
        }
    }

    fn pop_free_chunk(&mut self, layout: Layout) ?&mut ArenaChunk {
        let mut best: ?&mut ArenaChunk = null;
        let mut best_prev: ?&mut ArenaChunk = null;
        let mut best_waste = usize::MAX;
        let mut closest: ?&mut ArenaChunk = null;
        let mut closest_prev: ?&mut ArenaChunk = null;
        let mut closest_shortage = usize::MAX;
        let mut prev: ?&mut ArenaChunk = null;
        let mut current = self.free_list;

        while true {
            if mut ?chunk = current {
                if ?end = chunk_fit_end(chunk, layout) {
                    let capacity = chunk_payload_capacity(chunk);
                    if end <= capacity {
                        let waste = capacity - end;
                        if waste < best_waste {
                            best = ?chunk;
                            best_prev = prev;
                            best_waste = waste;
                        }
                    } else {
                        let shortage = end - capacity;
                        if shortage < closest_shortage {
                            closest = ?chunk;
                            closest_prev = prev;
                            closest_shortage = shortage;
                        }
                    }
                } or null {}
                prev = ?chunk;
                current = chunk.next;
            } or null {
                let mut selected = if ?chunk = best {
                    chunk
                } or null {
                    let mut fallback = if ?chunk = closest {
                        chunk
                    } or null {
                        return null;
                    };
                    if not self.grow_free_chunk(fallback, layout) {
                        return null;
                    }
                    fallback
                };
                let selected_prev = if ?chunk = best {
                    _ = chunk;
                    best_prev
                } or null {
                    closest_prev
                };
                if ?before = selected_prev {
                    let mut before = before;
                    before.next = selected.next;
                } or null {
                    self.free_list = selected.next;
                }
                selected.next = null;
                selected.end_index = 0;
                return ?selected;
            }
        }
        null
    }

    fn grow_free_chunk(&mut self, chunk: &mut ArenaChunk, layout: Layout) bool {
        let end = if ?value = chunk_fit_end(chunk, layout) {
            value
        } or null {
            return false;
        };
        if end <= chunk_payload_capacity(chunk) {
            return true;
        }
        let new_size = if ?value = std::builtin::size[ArenaChunk]().checked_add(end) {
            value
        } or null {
            return false;
        };
        let block_align = max_usize(chunk.block.align(), layout.align());
        let new_layout = if !value = Layout::init(new_size, block_align) {
            value
        } or error! {
            return false;
        };
        if self.child.resize(chunk.block, new_layout) {
            chunk.block = Block::init(chunk.block.ptr(), new_layout);
            true
        } else {
            false
        }
    }

    fn owns_block(&self, block: Block) bool {
        if block.is_empty() {
            return true;
        }
        if self.list_owns_block(self.used_list, block) {
            return true;
        }
        self.list_owns_block(self.free_list, block)
    }

    fn list_owns_block(&self, first: ?&mut ArenaChunk, block: Block) bool {
        let mut current = first;
        while true {
            if mut ?chunk = current {
                if chunk_owns_block(chunk, block) {
                    return true;
                }
                current = chunk.next;
            } or null {
                return false;
            }
        }
        false
    }

    fn move_used_to_free_list(&mut self) void {
        let mut current = self.used_list;
        self.used_list = null;
        while true {
            if mut ?chunk = current {
                let next = chunk.next;
                chunk.end_index = 0;
                chunk.next = self.free_list;
                self.free_list = ?chunk;
                current = next;
            } or null {
                return;
            }
        }
    }

    fn trim_free_list(&mut self, limit: usize) Error!void {
        let mut kept = 0usize;
        let mut current = self.free_list;
        let mut previous: ?&mut ArenaChunk = null;
        let mut failed = false;
        let mut first_error = Error::Invalid;

        while true {
            if ?chunk = current {
                let mut chunk = chunk;
                let capacity = chunk_payload_capacity(chunk);
                let next = chunk.next;
                let next_kept = if ?value = kept.checked_add(capacity) {
                    value
                } or null {
                    usize::MAX
                };
                if kept >= limit or next_kept > limit {
                    if !ok = self.child.free(chunk.block) {
                        _ = ok;
                        if ?prev = previous {
                            let mut prev = prev;
                            prev.next = next;
                        } or null {
                            self.free_list = next;
                        }
                    } or err! {
                        if not failed {
                            first_error = err;
                            failed = true;
                        }
                        previous = ?chunk;
                    }
                } else {
                    kept = next_kept;
                    previous = ?chunk;
                }
                current = next;
            } or null {
                if failed {
                    return first_error!;
                }
                return !{};
            }
        }
        !{}
    }

    fn free_detached_lists(&mut self, first: ?&mut ArenaChunk, second: ?&mut ArenaChunk) Error!void {
        let mut failed = false;
        let mut first_error = Error::Invalid;

        if !ok = self.free_chunk_list(first) {
            _ = ok;
        } or err! {
            first_error = err;
            failed = true;
        }

        if !ok = self.free_chunk_list(second) {
            _ = ok;
        } or err! {
            if not failed {
                first_error = err;
                failed = true;
            }
        }

        if failed {
            first_error!
        } else {
            !{}
        }
    }

    fn free_chunk_list(&mut self, first: ?&mut ArenaChunk) Error!void {
        let mut current = first;
        let mut failed = false;
        let mut first_error = Error::Invalid;
        while true {
            if ?chunk = current {
                let mut chunk = chunk;
                let next = chunk.next;
                chunk.next = null;
                if !ok = self.child.free(chunk.block) {
                    _ = ok;
                } or err! {
                    chunk.end_index = 0;
                    chunk.next = self.free_list;
                    self.free_list = ?chunk;
                    if not failed {
                        first_error = err;
                        failed = true;
                    }
                }
                current = next;
            } or null {
                if failed {
                    return first_error!;
                }
                return !{};
            }
        }
        !{}
    }

    fn list_capacity(&self, first: ?&mut ArenaChunk) usize {
        let mut total = 0usize;
        let mut current = first;
        while true {
            if ?chunk = current {
                total = if ?value = total.checked_add(chunk_payload_capacity(chunk)) {
                    value
                } or null {
                    usize::MAX
                };
                current = chunk.next;
            } or null {
                return total;
            }
        }
        total
    }

    fn list_used(&self, first: ?&mut ArenaChunk) usize {
        let mut total = 0usize;
        let mut current = first;
        while true {
            if ?chunk = current {
                total = if ?value = total.checked_add(chunk.end_index) {
                    value
                } or null {
                    usize::MAX
                };
                current = chunk.next;
            } or null {
                return total;
            }
        }
        total
    }
}

fn alloc_from_chunk(chunk: &mut ArenaChunk, layout: Layout) ?Block {
    let payload_base = chunk_payload_base(chunk);
    let current = if ?value = payload_base.checked_add(chunk.end_index) {
        value
    } or null {
        return null;
    };
    let aligned = if ?value = current.align_forward(layout.align()) {
        value
    } or null {
        return null;
    };
    let offset = aligned - payload_base;
    let new_end = if ?value = offset.checked_add(layout.size()) {
        value
    } or null {
        return null;
    };
    if new_end > chunk_payload_capacity(chunk) {
        null
    } else {
        chunk.end_index = new_end;
        ?Block::init(aligned as &mut u8, layout)
    }
}

fn chunk_fit_end(chunk: &mut ArenaChunk, layout: Layout) ?usize {
    let payload_base = chunk_payload_base(chunk);
    let aligned = if ?value = payload_base.align_forward(layout.align()) {
        value
    } or null {
        return null;
    };
    let offset = aligned - payload_base;
    offset.checked_add(layout.size())
}

fn is_last_allocation(chunk: &mut ArenaChunk, block: Block) bool {
    let payload_base = chunk_payload_base(chunk);
    let cursor = if ?value = payload_base.checked_add(chunk.end_index) {
        value
    } or null {
        return false;
    };
    let block_end = if ?value = (block.ptr() as usize).checked_add(block.size()) {
        value
    } or null {
        return false;
    };
    block_end == cursor
}

fn chunk_owns_block(chunk: &mut ArenaChunk, block: Block) bool {
    if block.is_empty() {
        return true;
    }
    let base = chunk_payload_base(chunk);
    let limit = if ?value = base.checked_add(chunk_payload_capacity(chunk)) {
        value
    } or null {
        return false;
    };
    let addr = block.ptr() as usize;
    if addr < base {
        return false;
    }
    let end = if ?value = addr.checked_add(block.size()) {
        value
    } or null {
        return false;
    };
    end <= limit
}

fn chunk_payload_base(chunk: &mut ArenaChunk) usize {
    chunk.block.ptr() as usize + std::builtin::size[ArenaChunk]()
}

fn chunk_payload_capacity(chunk: &mut ArenaChunk) usize {
    if chunk.block.size() <= std::builtin::size[ArenaChunk]() {
        0usize
    } else {
        chunk.block.size() - std::builtin::size[ArenaChunk]()
    }
}

fn chunk_capacity_for(layout: Layout, prev_capacity: usize) Error!usize {
    let min_with_padding = if ?value = layout.size().checked_add(layout.align()) {
        value
    } or null {
        return Error::OutOfMemory!;
    };
    let grown = if ?value = prev_capacity.checked_add(prev_capacity / 2usize) {
        value
    } or null {
        usize::MAX
    };
    let grown_with_slop = if ?value = grown.checked_add(16usize) {
        value
    } or null {
        usize::MAX
    };
    if grown_with_slop > min_with_padding {
        !grown_with_slop
    } else {
        !min_with_padding
    }
}

fn max_usize(left: usize, right: usize) usize {
    if left > right {
        left
    } else {
        right
    }
}
