using pkg::cmp;
using pkg::math;
using pkg::mem::allocator;
using pkg::mem::types;

using allocator::Allocator;
using types::{Block, Error, Layout};

struct ArenaChunk {
    block: Block,
    endIndex: usize,
    next: ?&mut ArenaChunk,
}

pub struct ArenaAllocator {
    child: &mut Allocator,
    usedList: ?&mut ArenaChunk,
    freeList: ?&mut ArenaChunk,
}

extend ArenaAllocator {
    pub fn init(child: &mut Allocator) ArenaAllocator {
        Self { child, usedList: null, freeList: null }
    }

    pub fn deinit(&mut self) Error!() {
        let used = self.usedList;
        let free = self.freeList;
        self.usedList = null;
        self.freeList = null;
        self.freeDetachedLists(used, free)
    }

    pub fn reset(&mut self) Error!() {
        self.moveUsedToFreeList();
        !()
    }

    pub fn capacity(&self) usize {
        let used = self.listCapacity(self.usedList);
        let free = self.listCapacity(self.freeList);
        match used.checkedAdd(free) {
            ?total => {
                total
            },
            null => {
                usize::MAX
            },
        }
    }

    pub fn used(&self) usize {
        self.listUsed(self.usedList)
    }
}

extend ArenaAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) Error!Block {
        if layout.isEmpty() {
            return !Block::empty(layout);
        }

        if self.allocFromOptionalChunk(self.usedList, layout) is ?block {
            return !block;
        }

        if self.popFreeChunk(layout) is mut ?chunk {
            chunk.next = self.usedList;
            self.usedList = ?chunk;
            match allocFromChunk(chunk, layout) {
                ?block => {
                    return !block;
                },
                null => {
                    return Error::OutOfMemory!;
                }
            }
        }

        let prevCapacity = match self.usedList {
            ?chunk => {
                chunkPayloadCapacity(chunk)
            },
            null => {
                0
            },
        };
        let mut chunk = self.allocateChunk(layout, prevCapacity).?;
        chunk.next = self.usedList;
        self.usedList = ?chunk;
        match allocFromChunk(chunk, layout) {
            ?block => {
                !block
            },
            null => {
                Error::OutOfMemory!
            },
        }
    }

    pub fn resize(&mut self, block: Block, newLayout: Layout) bool {
        if block.align() != newLayout.align() {
            return false;
        }
        if block.isEmpty() {
            return newLayout.isEmpty();
        }
        let mut first = match self.usedList {
            ?chunk => {
                chunk
            },
            null => {
                return false;
            },
        };
        if not self.ownsBlock(block) {
            return false;
        }
        if not chunkOwnsBlock(first, block) or not isLastAllocation(first, block) {
            return newLayout.size() <= block.size();
        }
        if newLayout.size() <= block.size() {
            first.endIndex -= block.size() - newLayout.size();
            return true;
        }

        let add = newLayout.size() - block.size();
        let newEnd = match first.endIndex.checkedAdd(add) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        if newEnd > chunkPayloadCapacity(first) {
            return false;
        }
        first.endIndex = newEnd;
        true
    }

    pub fn remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            ?block.withLayout(newLayout)
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?Block::empty(newLayout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) Error!() {
        if block.isEmpty() {
            return !();
        }
        let mut first = match self.usedList {
            ?chunk => {
                chunk
            },
            null => {
                return Error::Invalid!;
            },
        };
        if not self.ownsBlock(block) {
            return Error::Invalid!;
        }
        if chunkOwnsBlock(first, block) and isLastAllocation(first, block) {
            first.endIndex -= block.size();
        }
        !()
    }
}

extend ArenaAllocator {
    fn allocateChunk(&mut self, layout: Layout, prevCapacity: usize) Error!&mut ArenaChunk {
        let payloadCapacity = chunkCapacityFor(layout, prevCapacity).?;
        let totalSize = match std::builtin::size[ArenaChunk]().checkedAdd(payloadCapacity) {
            ?value => {
                value
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        let blockAlign = cmp::max(std::builtin::align[ArenaChunk](), layout.align());
        let blockLayout = Layout::init(totalSize, blockAlign).?;
        let block = self.child.alloc(blockLayout).?;
        let mut chunk = block.ptr() as &mut ArenaChunk;
        chunk.* = ArenaChunk { block, endIndex: 0, next: null };
        !chunk
    }

    fn allocFromOptionalChunk(&mut self, maybeChunk: ?&mut ArenaChunk, layout: Layout) ?Block {
        if maybeChunk is ?chunk {
            return allocFromChunk(chunk, layout);
        }
        null
    }

    fn popFreeChunk(&mut self, layout: Layout) ?&mut ArenaChunk {
        let mut best: ?&mut ArenaChunk = null;
        let mut bestPrev: ?&mut ArenaChunk = null;
        let mut bestWaste = usize::MAX;
        let mut closest: ?&mut ArenaChunk = null;
        let mut closestPrev: ?&mut ArenaChunk = null;
        let mut closestShortage = usize::MAX;
        let mut prev: ?&mut ArenaChunk = null;
        let mut current = self.freeList;

        while true {
            match current {
                mut ?chunk => {
                    if chunkFitEnd(chunk, layout) is ?end {
                        let capacity = chunkPayloadCapacity(chunk);
                        if end <= capacity {
                            let waste = capacity - end;
                            if waste < bestWaste {
                                best = ?chunk;
                                bestPrev = prev;
                                bestWaste = waste;
                            }
                        } else {
                            let shortage = end - capacity;
                            if shortage < closestShortage {
                                closest = ?chunk;
                                closestPrev = prev;
                                closestShortage = shortage;
                            }
                        }
                    }
                    prev = ?chunk;
                    current = chunk.next;
                },
                null => {
                    let mut selected = match best {
                        ?chunk => {
                            chunk
                        },
                        null => {
                            let mut fallback = match closest {
                                ?chunk => {
                                    chunk
                                },
                                null => {
                                    return null;
                                },
                            };
                            if not self.growFreeChunk(fallback, layout) {
                                return null;
                            }
                            fallback
                        },
                    };
                    let selectedPrev = match best {
                        ?chunk => {
                            _ = chunk;
                            bestPrev
                        },
                        null => {
                            closestPrev
                        },
                    };
                    match selectedPrev {
                        ?before => {
                            let mut before = before;
                            before.next = selected.next;
                        },
                        null => {
                            self.freeList = selected.next;
                        },
                    }
                    selected.next = null;
                    selected.endIndex = 0;
                    return ?selected;
                },
            }
        }
        null
    }

    fn growFreeChunk(&mut self, chunk: &mut ArenaChunk, layout: Layout) bool {
        let end = match chunkFitEnd(chunk, layout) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        if end <= chunkPayloadCapacity(chunk) {
            return true;
        }
        let newSize = match std::builtin::size[ArenaChunk]().checkedAdd(end) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        let blockAlign = cmp::max(chunk.block.align(), layout.align());
        let newLayout = match Layout::init(newSize, blockAlign) {
            !value => {
                value
            },
            error! => {
                return false;
            },
        };
        if self.child.resize(chunk.block, newLayout) {
            chunk.block = chunk.block.withLayout(newLayout);
            true
        } else {
            false
        }
    }

    fn ownsBlock(&self, block: Block) bool {
        if block.isEmpty() {
            return true;
        }
        if self.listOwnsBlock(self.usedList, block) {
            return true;
        }
        self.listOwnsBlock(self.freeList, block)
    }

    fn listOwnsBlock(&self, first: ?&mut ArenaChunk, block: Block) bool {
        let mut current = first;
        while true {
            match current {
                mut ?chunk => {
                    if chunkOwnsBlock(chunk, block) {
                        return true;
                    }
                    current = chunk.next;
                },
                null => {
                    return false;
                },
            }
        }
        false
    }

    fn moveUsedToFreeList(&mut self) () {
        let mut current = self.usedList;
        self.usedList = null;
        while true {
            match current {
                mut ?chunk => {
                    let next = chunk.next;
                    chunk.endIndex = 0;
                    chunk.next = self.freeList;
                    self.freeList = ?chunk;
                    current = next;
                },
                null => {
                    return;
                },
            }
        }
    }

    fn freeDetachedLists(&mut self, first: ?&mut ArenaChunk, second: ?&mut ArenaChunk) Error!() {
        let mut failed = false;
        let mut firstError = Error::Invalid;

        match self.freeChunkList(first) {
            !ok => {
                _ = ok;
            },
            err! => {
                firstError = err;
                failed = true;
            },
        }

        match self.freeChunkList(second) {
            !ok => {
                _ = ok;
            },
            err! => {
                if not failed {
                    firstError = err;
                    failed = true;
                }
            },
        }

        if failed {
            firstError!
        } else {
            !()
        }
    }

    fn freeChunkList(&mut self, first: ?&mut ArenaChunk) Error!() {
        let mut current = first;
        let mut failed = false;
        let mut firstError = Error::Invalid;
        while true {
            match current {
                ?chunk => {
                    let mut chunk = chunk;
                    let next = chunk.next;
                    chunk.next = null;
                    match self.child.free(chunk.block) {
                        !ok => {
                            _ = ok;
                        },
                        err! => {
                            chunk.endIndex = 0;
                            chunk.next = self.freeList;
                            self.freeList = ?chunk;
                            if not failed {
                                firstError = err;
                                failed = true;
                            }
                        },
                    }
                    current = next;
                },
                null => {
                    if failed {
                        return firstError!;
                    }
                    return !();
                },
            }
        }
        !()
    }

    fn listCapacity(&self, first: ?&mut ArenaChunk) usize {
        let mut total: usize = 0;
        let mut current = first;
        while true {
            match current {
                ?chunk => {
                    total = match total.checkedAdd(chunkPayloadCapacity(chunk)) {
                        ?value => {
                            value
                        },
                        null => {
                            usize::MAX
                        },
                    };
                    current = chunk.next;
                },
                null => {
                    return total;
                },
            }
        }
        total
    }

    fn listUsed(&self, first: ?&mut ArenaChunk) usize {
        let mut total: usize = 0;
        let mut current = first;
        while true {
            match current {
                ?chunk => {
                    total = match total.checkedAdd(chunk.endIndex) {
                        ?value => {
                            value
                        },
                        null => {
                            usize::MAX
                        },
                    };
                    current = chunk.next;
                },
                null => {
                    return total;
                },
            }
        }
        total
    }
}

fn allocFromChunk(chunk: &mut ArenaChunk, layout: Layout) ?Block {
    let payloadBase = match chunkPayloadBase(chunk) {
        ?value => value,
        null => return null,
    };
    let current = match payloadBase.checkedAdd(chunk.endIndex) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let aligned = match current.alignForward(layout.align()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let offset = aligned - payloadBase;
    let newEnd = match offset.checkedAdd(layout.size()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    if newEnd > chunkPayloadCapacity(chunk) {
        null
    } else {
        chunk.endIndex = newEnd;
        ?Block::init(aligned as &mut u8, layout)
    }
}

fn chunkFitEnd(chunk: &mut ArenaChunk, layout: Layout) ?usize {
    let payloadBase = match chunkPayloadBase(chunk) {
        ?value => value,
        null => return null,
    };
    let aligned = match payloadBase.alignForward(layout.align()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let offset = aligned - payloadBase;
    offset.checkedAdd(layout.size())
}

fn isLastAllocation(chunk: &mut ArenaChunk, block: Block) bool {
    let payloadBase = match chunkPayloadBase(chunk) {
        ?value => value,
        null => return false,
    };
    let cursor = match payloadBase.checkedAdd(chunk.endIndex) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    let blockEnd = match (block.ptr() as usize).checkedAdd(block.size()) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    blockEnd == cursor
}

fn chunkOwnsBlock(chunk: &mut ArenaChunk, block: Block) bool {
    if block.isEmpty() {
        return true;
    }
    let base = match chunkPayloadBase(chunk) {
        ?value => value,
        null => return false,
    };
    let limit = match base.checkedAdd(chunkPayloadCapacity(chunk)) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    let addr = block.ptr() as usize;
    if addr < base {
        return false;
    }
    let end = match addr.checkedAdd(block.size()) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    end <= limit
}

fn chunkPayloadBase(chunk: &mut ArenaChunk) ?usize {
    (chunk.block.ptr() as usize).checkedAdd(std::builtin::size[ArenaChunk]())
}

fn chunkPayloadCapacity(chunk: &mut ArenaChunk) usize {
    if chunk.block.size() <= std::builtin::size[ArenaChunk]() {
        0
    } else {
        chunk.block.size() - std::builtin::size[ArenaChunk]()
    }
}

fn chunkCapacityFor(layout: Layout, prevCapacity: usize) Error!usize {
    let minWithPadding = match layout.size().checkedAdd(layout.align()) {
        ?value => {
            value
        },
        null => {
            return Error::OutOfMemory!;
        },
    };
    let grown = match prevCapacity.checkedAdd(prevCapacity / 2) {
        ?value => {
            value
        },
        null => {
            usize::MAX
        },
    };
    let grownWithSlop = match grown.checkedAdd(16) {
        ?value => {
            value
        },
        null => {
            usize::MAX
        },
    };
    if grownWithSlop > minWithPadding {
        !grownWithSlop
    } else {
        !minWithPadding
    }
}
