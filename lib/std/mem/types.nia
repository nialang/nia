using pkg::math;

pub enum Error: i32 {
    Invalid = 1,
    InvalidAlignment = 2,
    OutOfMemory = 3,
    System = 4,
    _,
}

pub struct Layout {
    size: usize,
    align: usize,
}

pub struct Block {
    ptr: &mut u8,
    layout: Layout,
}

extend Layout {
    pub fn init(size: usize, align: usize) Error!Layout {
        if align == 0 {
            Error::InvalidAlignment!
        } else if not align.is_power_of_two() {
            Error::InvalidAlignment!
        } else {
            !{ size: size, align: align }
        }
    }

    pub fn of[T]() Error!Layout
    where T: Sized
    {
        Layout::init(std::builtin::size[T](), std::builtin::align[T]())
    }

    pub fn array[T](count: usize) Error!Layout
    where T: Sized
    {
        let elemLen = std::builtin::size[T]();
        let size = switch elemLen.checked_mul(count) {
            ?value => {
                value
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        Layout::init(size, std::builtin::align[T]())
    }

    pub fn size(&self) usize {
        self.size
    }

    pub fn align(&self) usize {
        self.align
    }

    pub fn isEmpty(&self) bool {
        self.size == 0
    }
}

extend Block {
    pub fn init(ptr: &mut u8, layout: Layout) Block {
        { ptr: ptr, layout: layout }
    }

    pub fn empty(layout: Layout) Block {
        Block::init(layout.align() as &mut u8, layout)
    }

    pub fn ptr(&self) &mut u8 {
        self.ptr
    }

    pub fn layout(&self) Layout {
        self.layout
    }

    pub fn size(&self) usize {
        self.layout.size()
    }

    pub fn align(&self) usize {
        self.layout.align()
    }

    pub fn isEmpty(&self) bool {
        self.layout.isEmpty()
    }

    pub fn bytes(&self) &mut [u8] {
        &mut self.ptr[0..self.size()]
    }

    pub fn asSlice[T](&self) &mut [T]
    where T: Sized
    {
        let mut ptr = self.ptr as &mut T;
        let elemSize = std::builtin::size[T]();
        if elemSize == 0 {
            &mut ptr[0..0]
        } else {
            &mut ptr[0..(self.size() / elemSize)]
        }
    }
}
