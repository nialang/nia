using pkg::math;

pub enum Error: i32 {
    Invalid = 1,
    InvalidAlignment = 2,
    OutOfMemory = 3,
    System = 4,
    Leak = 5,
    _,
}

pub struct Layout {
    size: usize,
    align: usize,
}

pub struct Block {
    ptr: &mut u8,
    layout: Layout,
    releasePtr: &mut u8,
    releaseSize: usize,
}

extend Layout {
    pub fun init(size: usize, align: usize) Error!Layout {
        if align == 0 {
            .InvalidAlignment!
        } else if not align.isPowerOfTwo() {
            .InvalidAlignment!
        } else {
            !.{ size, align }
        }
    }

    pub fun of[T]() Error!Layout
    where T: Sized
    {
        Layout::init(pkg::builtin::size[T](), pkg::builtin::align[T]())
    }

    pub fun array[T](count: usize) Error!Layout
    where T: Sized
    {
        let elemLen = pkg::builtin::size[T]();
        let size = match elemLen.checkedMul(count) {
            ?value => {
                value
            },
            null => {
                return .OutOfMemory!;
            },
        };
        Layout::init(size, pkg::builtin::align[T]())
    }

    pub fun size(&self) usize {
        self.size
    }

    pub fun align(&self) usize {
        self.align
    }

    pub fun isEmpty(&self) bool {
        self.size == 0
    }
}

extend Block {
    pub fun init(ptr: &mut u8, layout: Layout) Block {
        .{ ptr, layout, releasePtr: ptr, releaseSize: layout.size() }
    }

    pub(pkg) fun initWithRelease(
        ptr: &mut u8,
        layout: Layout,
        releasePtr: &mut u8,
        releaseSize: usize,
    ) Block {
        .{ ptr, layout, releasePtr, releaseSize }
    }

    pub(pkg) fun withLayout(&self, layout: Layout) Block {
        Block::initWithRelease(self.ptr, layout, self.releasePtr, self.releaseSize)
    }

    pub fun empty(layout: Layout) Block {
        Block::init(layout.align() as &mut u8, layout)
    }

    pub fun ptr(&self) &mut u8 {
        self.ptr
    }

    pub(pkg) fun releasePtr(&self) &mut u8 {
        self.releasePtr
    }

    pub(pkg) fun releaseSize(&self) usize {
        self.releaseSize
    }

    pub fun layout(&self) Layout {
        self.layout
    }

    pub fun size(&self) usize {
        self.layout.size()
    }

    pub fun align(&self) usize {
        self.layout.align()
    }

    pub fun isEmpty(&self) bool {
        self.layout.isEmpty()
    }

    pub fun bytes(&self) &mut [u8] {
        &mut self.ptr[0..self.size()]
    }

    pub fun asSlice[T](&self) &mut [T]
    where T: Sized
    {
        let mut ptr = self.ptr as &mut T;
        let elemSize = pkg::builtin::size[T]();
        if elemSize == 0 {
            &mut ptr[0..0]
        } else {
            &mut ptr[0..(self.size() / elemSize)]
        }
    }
}
