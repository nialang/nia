using pkg::math;
using pkg::mem::allocator;
using pkg::mem::types;

using allocator::Allocator;
using types::{Block, Error, Layout};

pub struct FixedBufferAllocator {
    buffer: &mut [u8],
    endIndex: usize,
}

extend FixedBufferAllocator {
    pub fn init(buffer: &mut [u8]) FixedBufferAllocator {
        { buffer: buffer, endIndex: 0 }
    }

    pub fn reset(&mut self) void {
        self.endIndex = 0;
    }

    pub fn used(&self) usize {
        self.endIndex
    }

    pub fn capacity(&self) usize {
        self.buffer.len()
    }

    pub fn remaining(&self) usize {
        self.capacity() - self.used()
    }

    fn ownsBlock(&self, block: Block) bool {
        if block.isEmpty() {
            return true;
        }
        let base = self.buffer.ptr() as usize;
        let limit = switch base.checked_add(self.buffer.len()) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        let addr = block.ptr() as usize;
        if addr < base {
            return false;
        }
        let end = switch addr.checked_add(block.size()) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        end <= limit
    }

    fn isLastAllocation(&self, block: Block) bool {
        if block.isEmpty() {
            return false;
        }
        let base = self.buffer.ptr() as usize;
        let cursor = switch base.checked_add(self.endIndex) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        let blockEnd = switch (block.ptr() as usize).checked_add(block.size()) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        blockEnd == cursor
    }
}

extend FixedBufferAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) Error!Block {
        if layout.isEmpty() {
            return !Block::empty(layout);
        }

        let base = self.buffer.ptrMut() as usize;
        let current = switch base.checked_add(self.endIndex) {
            ?value => {
                value
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        let aligned = switch current.align_forward(layout.align()) {
            ?value => {
                value
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        let offset = aligned - base;
        let newEnd = switch offset.checked_add(layout.size()) {
            ?value => {
                value
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        if newEnd > self.buffer.len() {
            return Error::OutOfMemory!;
        }

        self.endIndex = newEnd;
        !Block::init(aligned as &mut u8, layout)
    }

    pub fn resize(&mut self, block: Block, newLayout: Layout) bool {
        if block.align() != newLayout.align() {
            return false;
        }
        if block.isEmpty() {
            return newLayout.isEmpty();
        }
        if not self.ownsBlock(block) {
            return false;
        }
        if not self.isLastAllocation(block) {
            return newLayout.size() <= block.size();
        }
        if newLayout.size() <= block.size() {
            self.endIndex -= block.size() - newLayout.size();
            return true;
        }

        let add = newLayout.size() - block.size();
        let newEnd = switch self.endIndex.checked_add(add) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        if newEnd > self.buffer.len() {
            return false;
        }
        self.endIndex = newEnd;
        true
    }

    pub fn remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            ?Block::init(block.ptr(), newLayout)
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?Block::empty(newLayout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) Error!void {
        if block.isEmpty() {
            return !{};
        }
        if not self.ownsBlock(block) {
            return Error::Invalid!;
        }
        if self.isLastAllocation(block) {
            self.endIndex -= block.size();
        }
        !{}
    }
}
