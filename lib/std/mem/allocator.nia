using pkg::mem::types;
using pkg::result;
using pkg::slice;

using types::{Block, Error, Layout};

pub enum ReallocError {
    Allocation(Error),
    OldFree(Error),
    Rollback {
        primary: Error,
        replacement: Block,
        replacementError: Error,
    },
}

pub struct SliceAllocation[T]
where T: Sized
{
    block: Block,
    len: usize,
}

pub trait Allocator {
    fn alloc(&mut self, layout: Layout) Error!Block;

    fn free(&mut self, block: Block) Error!();

    fn resize(&mut self, block: Block, newLayout: Layout) bool {
        _ = self;
        if block.align() != newLayout.align() {
            return false;
        }
        block.size() == newLayout.size()
    }

    fn remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            // Resizing changes the logical view, not the allocator's release
            // range. Preserve that range for the caller's eventual free.
            ?block.withLayout(newLayout)
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?.empty(newLayout)
        } else {
            null
        }
    }

    // A rollback error carries the replacement block when both fallible frees
    // fail. The caller still owns the original block passed by value.
    fn realloc(&mut self, block: Block, newLayout: Layout) ReallocError!Block {
        if self.remap(block, newLayout) is ?newBlock {
            return !newBlock;
        }
        let newBlock = self.alloc(newLayout)
            .mapError(&\cause: Error -> ReallocError::Allocation(cause)).?;
        block.copyPrefixTo(newBlock);
        if self.free(block) is oldError! {
            if self.free(newBlock) is replacementError! {
                return .Rollback {
                    primary: oldError,
                    replacement: newBlock,
                    replacementError: replacementError,
                }!;
            }
            return .OldFree(oldError)!;
        }
        !newBlock
    }

    fn allocBytes(&mut self, len: usize, align: usize) Error!Block {
        let layout = Layout::init(len, align).?;
        self.alloc(layout)
    }
}

extend Allocator {
    pub fn allocSlice[T](&mut self, len: usize) Error!SliceAllocation[T]
    where T: Sized
    {
        let layout = Layout::array[T](len).?;
        let block = self.alloc(layout).?;
        !.{ block, len }
    }
}

extend[T] SliceAllocation[T]
where T: Sized
{
    pub(pkg) fn fromBlock(block: Block, len: usize) SliceAllocation[T] {
        .{ block, len }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub(pkg) fn intoBlock(self) Block {
        self.block
    }

    pub fn asSlice(&self) &[T] {
        let ptr = self.block.ptr() as &mut T;
        &ptr[0..self.len]
    }

    pub fn asMutSlice(&mut self) &mut [T] {
        let mut ptr = self.block.ptr() as &mut T;
        &mut ptr[0..self.len]
    }

    pub fn deinit(&mut self, allocator: &mut Allocator) Error!() {
        let block = self.block;
        allocator.free(block).?;
        self.block = Block::empty(Layout::array[T](0).?);
        self.len = 0;
        !()
    }
}

fn danglingSlice[T](len: usize) &mut [T]
where T: Sized
{
    let mut ptr = std::builtin::align[T]() as &mut T;
    &mut ptr[0..len]
}

extend Block {
    fn copyPrefixTo(&self, to: Block) () {
        let mut count = self.size();
        if count > to.size() {
            count = to.size();
        }
        let fromBytes = self.bytes();
        let mut toBytes = to.bytes();
        _ = (&mut toBytes[0..count]).copyFrom(&fromBytes[0..count]);
    }
}
