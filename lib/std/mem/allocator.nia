using package::mem::copy;
using package::mem::types;

using types::{Block, Error, Layout};

pub trait Allocator {
    fn alloc(&mut self, layout: Layout) Error!Block;

    fn free(&mut self, block: Block) Error!void;

    fn resize(&mut self, block: Block, new_layout: Layout) bool {
        _ = self;
        if block.align() != new_layout.align() {
            return false;
        }
        block.size() == new_layout.size()
    }

    fn remap(&mut self, block: Block, new_layout: Layout) ?Block {
        if self.resize(block, new_layout) {
            ?Block::init(block.ptr(), new_layout)
        } else if block.is_empty() and new_layout.is_empty() {
            ?Block::empty(new_layout)
        } else {
            null
        }
    }

    fn realloc(&mut self, block: Block, new_layout: Layout) Error!Block {
        if let ?new_block = self.remap(block, new_layout) {
            return !new_block;
        }
        let new_block = self.alloc(new_layout).?;
        block.copy_prefix_to(new_block);
        if let !ok = self.free(block) {
            _ = ok;
            !new_block
        } else err! {
            if let !ok = self.free(new_block) {
                _ = ok;
            } else error! {}
            err!
        }
    }

    fn alloc_bytes(&mut self, len: usize, align: usize) Error!Block {
        let layout = Layout::init(len, align).?;
        self.alloc(layout)
    }
}

extend Allocator {
    pub fn alloc_slice[T](&mut self, len: usize) Error!&mut [T]
    where T: Sized
    {
        let layout = Layout::array[T](len).?;
        if layout.is_empty() {
            return !dangling_slice[T](len);
        }
        if let !block = self.alloc(layout) {
            !block.as_slice[T]()
        } else err! {
            err!
        }
    }

    pub fn free_slice[T](&mut self, slice: &mut [T]) Error!void
    where T: Sized
    {
        let layout = Layout::array[T](slice.len()).?;
        self.free(Block::init(slice.get_ptr() as &mut u8, layout))
    }
}

fn dangling_slice[T](len: usize) &mut [T]
where T: Sized
{
    var ptr = @align[T]() as &mut T;
    &mut ptr[0..len]
}

extend Block {
    fn copy_prefix_to(&self, to: Block) void {
        var count = self.size();
        if count > to.size() {
            count = to.size();
        }
        let from_bytes = self.bytes();
        var to_bytes = to.bytes();
        copy::copy_forwards[u8](&mut to_bytes[0..count], &from_bytes[0..count]);
    }
}
