// The `Allocator` trait and its default operations.
//
// `allocSlice` returns a `SliceAllocation[T]` owner instead of a raw slice.
// `asSlice` and `asMutSlice` borrow its view, `deinit` releases the exact
// `Block` even for a zero-length view, and `ArrayList`/`String` owner-transfer
// APIs consume that typed owner. Raw-slice ownership constructors are
// intentionally absent.
//
// Default `realloc` reports a typed `ReallocError`. When both the old and the
// replacement releases fail, `Rollback` carries the replacement block and its
// cleanup error so callers can retry the still-owned allocations. This
// owner-carrying error has no generic process-exit conversion; callers match
// it and retire the original and replacement owners explicitly.
//
// A successful remap changes only a block's logical layout. Default and
// concrete remap paths preserve the original release pointer and length.

using root::mem::types;
using root::result;
using root::slice;

using types::{Block, Error, Layout};

pub enum ReallocError {
    Allocation(Error),
    OldFree(Error),
    Rollback {
        primary: Error,
        replacement: Block,
        replacementError: Error,
    },
}

pub struct SliceAllocation[T]
where T: Sized
{
    block: Block,
    len: usize,
}

pub trait Allocator {
    fun alloc(&mut self, layout: Layout) Error!Block;

    fun free(&mut self, block: Block) Error!();

    fun resize(&mut self, block: Block, newLayout: Layout) bool {
        _ = self;
        if block.align() != newLayout.align() {
            return false;
        }
        block.size() == newLayout.size()
    }

    fun remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            // Resizing changes the logical view while the allocator's release
            // range remains stable for the caller's eventual free.
            ?block.withLayout(newLayout)
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?.empty(newLayout)
        } else {
            null
        }
    }

    // A rollback error carries the replacement block when both fallible frees
    // fail. The caller still owns the original block passed by value.
    fun realloc(&mut self, block: Block, newLayout: Layout) ReallocError!Block {
        if self.remap(block, newLayout) is ?newBlock {
            return !newBlock;
        }
        let newBlock = self.alloc(newLayout)
            .mapError(.Allocation).?;
        block.copyPrefixTo(newBlock);
        if self.free(block) is oldError! {
            if self.free(newBlock) is replacementError! {
                return .Rollback {
                    primary: oldError,
                    replacement: newBlock,
                    replacementError: replacementError,
                }!;
            }
            return .OldFree(oldError)!;
        }
        !newBlock
    }

    fun allocBytes(&mut self, len: usize, align: usize) Error!Block {
        let layout = Layout::init(len, align).?;
        self.alloc(layout)
    }
}

extend Allocator {
    pub fun allocSlice[T](&mut self, len: usize) Error!SliceAllocation[T]
    where T: Sized
    {
        let layout = Layout::array[T](len).?;
        let block = self.alloc(layout).?;
        !.{ block, len }
    }
}

extend[T] SliceAllocation[T]
where T: Sized
{
    pub(root) fun fromBlock(block: Block, len: usize) SliceAllocation[T] {
        .{ block, len }
    }

    pub fun len(&self) usize {
        self.len
    }

    pub(root) fun intoBlock(self) Block {
        self.block
    }

    pub fun asSlice(&self) &[T] {
        let ptr = self.block.ptr() as &mut T;
        &ptr[0..self.len]
    }

    pub fun asMutSlice(&mut self) &mut [T] {
        let mut ptr = self.block.ptr() as &mut T;
        &mut ptr[0..self.len]
    }

    pub fun deinit(&mut self, allocator: &mut Allocator) Error!() {
        let block = self.block;
        allocator.free(block).?;
        self.block = Block::empty(Layout::array[T](0).?);
        self.len = 0;
        !()
    }
}

fun danglingSlice[T](len: usize) &mut [T]
where T: Sized
{
    let mut ptr = root::builtin::align[T]() as &mut T;
    &mut ptr[0..len]
}

extend Block {
    fun copyPrefixTo(&self, to: Block) () {
        let mut count = self.size();
        if count > to.size() {
            count = to.size();
        }
        let fromBytes = self.bytes();
        let mut toBytes = to.bytes();
        _ = (&mut toBytes[0..count]).copyFrom(&fromBytes[0..count]);
    }
}
