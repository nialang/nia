using pkg::mem::allocator;
using pkg::mem::types;

using allocator::Allocator;
using types::{Block, Error, Layout};

pub struct Allocated[T]
where T: Sized
{
    valuePtr: &mut T,
    size: usize,
    align: usize,
}

pub struct CallableAllocation[V]
where V: Sized
{
    callback: V,
    allocationPtr: &mut u8,
    size: usize,
    align: usize,
}

pub fn allocValue[T](allocator: &mut Allocator, value: T) Error!Allocated[T]
where T: Sized
{
    let layout = Layout::of[T]().?;
    let block = allocator.alloc(layout).?;
    let address = block.ptr() as usize;
    let mut valuePtr = address as &mut T;
    valuePtr.* = value;
    !Allocated[T] { valuePtr, size: layout.size(), align: layout.align() }
}

extend[T] Allocated[T]
where T: Sized
{
    pub fn value(self) &T {
        self.valuePtr
    }

    pub fn valueMut(self) &mut T {
        self.valuePtr
    }

    pub fn intoCallable[V](
        &mut self,
        callback: V,
    ) CallableAllocation[V]
    where V: Sized
    {
        let allocationPtr = self.valuePtr as &mut u8;
        let size = self.size;
        let align = self.align;
        self.valuePtr = align as &mut T;
        self.size = 0;
        CallableAllocation[V] { callback, allocationPtr, size, align }
    }

    pub fn deinit(&mut self, allocator: &mut Allocator) Error!() {
        let address = self.valuePtr as usize;
        let allocationPtr = address as &mut u8;
        let layout = Layout::init(self.size, self.align).?;
        allocator.free(Block::init(allocationPtr, layout)).?;
        self.valuePtr = self.align as &mut T;
        self.size = 0;
        !()
    }
}

extend[V] CallableAllocation[V]
where V: Sized
{
    pub fn callback(&self) V {
        self.callback
    }

    pub fn deinit(&mut self, allocator: &mut Allocator) Error!() {
        let address = self.allocationPtr as usize;
        let allocationPtr = address as &mut u8;
        let layout = Layout::init(self.size, self.align).?;
        allocator.free(Block::init(allocationPtr, layout)).?;
        self.size = 0;
        !()
    }
}
