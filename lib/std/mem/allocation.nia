using pkg::mem::allocator;
using pkg::mem::types;

using allocator::Allocator;
using types::{Block, Error, Layout};

// The value pointer may be an aligned interior address, and an allocator may
// attach real storage to a zero-sized value. Keep the returned Block layout and
// release range instead of reconstructing either from the typed value layout.
pub struct Allocated[T]
where T: Sized
{
    valuePtr: &mut T,
    blockSize: usize,
    blockAlign: usize,
    releasePtr: usize,
    releaseSize: usize,
}

pub struct CallableAllocation[V]
where V: Sized
{
    callback: V,
    allocationPtr: &mut u8,
    blockSize: usize,
    blockAlign: usize,
    releasePtr: usize,
    releaseSize: usize,
}

pub fn allocValue[T](allocator: &mut Allocator, value: T) Error!Allocated[T]
where T: Sized
{
    let layout = Layout::of[T]().?;
    let block = allocator.alloc(layout).?;
    let address = block.ptr() as usize;
    let mut valuePtr = address as &mut T;
    valuePtr.* = value;
    !.{
        valuePtr,
        blockSize: block.size(),
        blockAlign: block.align(),
        releasePtr: block.releasePtr() as usize,
        releaseSize: block.releaseSize(),
    }
}

extend[T] Allocated[T]
where T: Sized
{
    pub fn value(self) &T {
        self.valuePtr
    }

    pub fn valueMut(self) &mut T {
        self.valuePtr
    }

    pub fn intoCallable[V](
        &mut self,
        callback: V,
    ) CallableAllocation[V]
    where V: Sized
    {
        let allocationPtr = self.valuePtr as &mut u8;
        let blockSize = self.blockSize;
        let blockAlign = self.blockAlign;
        let releasePtr = self.releasePtr;
        let releaseSize = self.releaseSize;
        self.valuePtr = blockAlign as &mut T;
        self.blockSize = 0;
        self.releasePtr = 0;
        self.releaseSize = 0;
        .{ callback, allocationPtr, blockSize, blockAlign, releasePtr, releaseSize }
    }

    pub fn deinit(&mut self, allocator: &mut Allocator) Error!() {
        let address = self.valuePtr as usize;
        let allocationPtr = address as &mut u8;
        let layout = Layout::init(self.blockSize, self.blockAlign).?;
        allocator.free(Block::initWithRelease(
            allocationPtr,
            layout,
            self.releasePtr as &mut u8,
            self.releaseSize,
        )).?;
        self.valuePtr = self.blockAlign as &mut T;
        self.blockSize = 0;
        self.releasePtr = 0;
        self.releaseSize = 0;
        !()
    }
}

extend[V] CallableAllocation[V]
where V: Sized
{
    pub fn callback(&self) V {
        self.callback
    }

    pub fn deinit(&mut self, allocator: &mut Allocator) Error!() {
        let address = self.allocationPtr as usize;
        let allocationPtr = address as &mut u8;
        let layout = Layout::init(self.blockSize, self.blockAlign).?;
        allocator.free(Block::initWithRelease(
            allocationPtr,
            layout,
            self.releasePtr as &mut u8,
            self.releaseSize,
        )).?;
        self.blockSize = 0;
        self.releasePtr = 0;
        self.releaseSize = 0;
        !()
    }
}
