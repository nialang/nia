using pkg::mem::types;

using types::Order;

pub fn copy_forwards[T](to: &mut [T], from: &[T]) void
where T: Sized
{
    let count = copy_count[T](to, from);
    var index = 0usize;
    while index < count {
        to[index] = from[index];
        index += 1usize;
    }
}

pub fn copy_backwards[T](to: &mut [T], from: &[T]) void
where T: Sized
{
    var index = copy_count[T](to, from);
    while index > 0usize {
        index -= 1usize;
        to[index] = from[index];
    }
}

fn copy_count[T](to: &mut [T], from: &[T]) usize
where T: Sized
{
    if to.len() < from.len() {
        to.len()
    } else {
        from.len()
    }
}

pub fn equal[T](left: &[T], right: &[T]) bool
where T: Eq[T]
{
    if left.len() != right.len() {
        return false;
    }

    var index = 0usize;
    while index < left.len() {
        if left[index] != right[index] {
            return false;
        }
        index += 1usize;
    }
    true
}

pub fn order[T](left: &[T], right: &[T]) Order
where T: Ord[T]
{
    var len = left.len();
    if right.len() < len {
        len = right.len();
    }

    var index = 0usize;
    while index < len {
        if left[index] < right[index] {
            return Order::Less;
        }
        if left[index] > right[index] {
            return Order::Greater;
        }
        index += 1usize;
    }

    if left.len() < right.len() {
        Order::Less
    } else if left.len() > right.len() {
        Order::Greater
    } else {
        Order::Equal
    }
}
