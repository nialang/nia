using package::math;
using package::mem::allocator;
using package::mem::types;
using package::os;

using allocator::Allocator;
using types::{Block, Error, Layout};

pub enum DeinitStatus: i32 {
    Ok = 0,
    Leak = 1,
}

extend DeinitStatus {
    pub fn ok(self) Error!void {
        if self == DeinitStatus::Ok {
            !{}
        } else {
            Error::Invalid!
        }
    }
}

extend Error!DeinitStatus {
    pub fn ok(self) Error!void {
        if let !status = self {
            status.ok()
        } else err! {
            err!
        }
    }
}

comptime let max_small_size: usize = 2048usize;
comptime let min_slot_size: usize = 16usize;
comptime let small_magic: usize = 0x6e69615f67707331usize;
comptime let large_magic: usize = 0x6e69615f67706131usize;

struct SmallSlot {
    magic: usize,
    size: usize,
    align: usize,
    allocated: bool,
    next: ?&mut SmallSlot,
}

struct SmallPage {
    block: Block,
    slot_size: usize,
    slot_count: usize,
    used_count: usize,
    used_bytes: usize,
    free_list: ?&mut SmallSlot,
    next: ?&mut SmallPage,
}

struct LargeHeader {
    magic: usize,
    backing: Block,
    user_layout: Layout,
    user_capacity: usize,
    next: ?&mut LargeHeader,
}

pub struct GeneralPurposeAllocator {
    child: &mut Allocator,
    small_pages: ?&mut SmallPage,
    large_allocations: ?&mut LargeHeader,
}

extend GeneralPurposeAllocator {
    pub fn init(child: &mut Allocator) GeneralPurposeAllocator {
        { child: child, small_pages: null, large_allocations: null }
    }

    pub fn deinit(&mut self) Error!DeinitStatus {
        let leaked = not self.is_empty();
        self.deinit_without_leak_check().?;
        if leaked {
            !DeinitStatus::Leak
        } else {
            !DeinitStatus::Ok
        }
    }

    pub fn deinit_without_leak_check(&mut self) Error!void {
        let small = self.small_pages;
        let large = self.large_allocations;
        self.small_pages = null;
        self.large_allocations = null;
        self.free_detached_lists(small, large)
    }

    pub fn query_capacity(&self) usize {
        var total = 0usize;
        var page = self.small_pages;
        while true {
            if let ?item = page {
                total = saturating_add(total, item.block.size());
                page = item.next;
            } else null {
                break;
            }
        }

        var large = self.large_allocations;
        while true {
            if let ?item = large {
                total = saturating_add(total, item.backing.size());
                large = item.next;
            } else null {
                return total;
            }
        }
        total
    }

    pub fn query_used(&self) usize {
        var total = 0usize;
        var page = self.small_pages;
        while true {
            if let ?item = page {
                total = saturating_add(total, item.used_bytes);
                page = item.next;
            } else null {
                break;
            }
        }

        var large = self.large_allocations;
        while true {
            if let ?item = large {
                total = saturating_add(total, item.user_layout.size());
                large = item.next;
            } else null {
                return total;
            }
        }
        total
    }

    pub fn is_empty(&self) bool {
        is_null_small_page(self.small_pages) and is_null_large_header(self.large_allocations)
    }
}

extend GeneralPurposeAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) Error!Block {
        if layout.is_empty() {
            return !Block::empty(layout);
        }
        if let ?slot_size = small_slot_size(layout) {
            self.alloc_small(layout, slot_size)
        } else null {
            self.alloc_large(layout)
        }
    }

    pub fn resize(&mut self, block: Block, new_layout: Layout) bool {
        if block.is_empty() {
            return new_layout.is_empty();
        }
        let small_page = self.find_small_page(block);
        if var ?page = small_page {
            if new_layout.is_empty() {
                return false;
            }
            if block.align() != new_layout.align() {
                return false;
            }
            var slot = if let ?value = small_page_slot_for_ptr(page, block.ptr()) {
                value
            } else null {
                return false;
            };
            if not small_slot_matches(slot, block) {
                return false;
            }
            let new_ptr = if let ?value = small_slot_user_ptr(slot, new_layout.align()) {
                value
            } else null {
                return false;
            };
            if new_ptr as usize != block.ptr() as usize {
                return false;
            }
            let slot_end = if let ?value = (slot as usize).checked_add(page.slot_size) {
                value
            } else null {
                return false;
            };
            let block_end = if let ?value = (new_ptr as usize).checked_add(new_layout.size()) {
                value
            } else null {
                return false;
            };
            if block_end > slot_end {
                return false;
            }
            page.used_bytes -= block.size();
            page.used_bytes = saturating_add(page.used_bytes, new_layout.size());
            slot.size = new_layout.size();
            slot.align = new_layout.align();
            return true;
        } else null {
            _ = small_page;
        }
        if var ?header = self.find_large_header(block.ptr()) {
            if header.user_layout.size() != block.size() or header.user_layout.align() != block.align() {
                return false;
            }
            if header.user_layout.align() != new_layout.align() {
                return false;
            }
            if new_layout.size() > header.user_capacity {
                return false;
            }
            header.user_layout = new_layout;
            true
        } else null {
            false
        }
    }

    pub fn remap(&mut self, block: Block, new_layout: Layout) ?Block {
        if self.resize(block, new_layout) {
            ?Block::init(block.ptr(), new_layout)
        } else if block.is_empty() and new_layout.is_empty() {
            ?Block::empty(new_layout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) Error!void {
        if block.is_empty() {
            return !{};
        }
        if let ?page = self.find_small_page(block) {
            return self.free_small(page, block);
        } else null {
        }
        self.free_large(block)
    }
}

extend GeneralPurposeAllocator {
    fn alloc_small(&mut self, layout: Layout, slot_size: usize) Error!Block {
        var page = if let ?item = self.find_page_with_free_slot(slot_size) {
            item
        } else null {
            self.allocate_small_page(slot_size).?
        };
        var slot = if let ?item = page.free_list {
            item
        } else null {
            return Error::OutOfMemory!;
        };
        page.free_list = slot.next;
        let ptr = if let ?value = small_slot_user_ptr(slot, layout.align()) {
            value
        } else null {
            slot.next = page.free_list;
            page.free_list = ?slot;
            return Error::OutOfMemory!;
        };
        slot.magic = small_magic;
        slot.size = layout.size();
        slot.align = layout.align();
        slot.allocated = true;
        slot.next = null;
        page.used_count += 1usize;
        page.used_bytes = saturating_add(page.used_bytes, layout.size());
        !Block::init(ptr, layout)
    }

    fn free_small(&mut self, page: &mut SmallPage, block: Block) Error!void {
        var slot = if let ?value = small_page_slot_for_ptr(page, block.ptr()) {
            value
        } else null {
            return Error::Invalid!;
        };
        if not small_slot_matches(slot, block) {
            return Error::Invalid!;
        }
        if page.used_count == 0usize {
            return Error::Invalid!;
        }
        slot.allocated = false;
        slot.size = 0usize;
        slot.align = 0usize;
        slot.next = page.free_list;
        page.free_list = ?slot;
        page.used_count -= 1usize;
        page.used_bytes -= block.size();
        if page.used_count == 0usize {
            self.release_empty_small_page(page).?;
        }
        !{}
    }

    fn allocate_small_page(&mut self, slot_size: usize) Error!&mut SmallPage {
        let page_size = os::page_size();
        let block_layout = Layout::init(page_size, page_size).?;
        let block = self.child.alloc(block_layout).?;
        var page = block.ptr() as &mut SmallPage;
        page.* = {
            block: block,
            slot_size: slot_size,
            slot_count: 0usize,
            used_count: 0usize,
            used_bytes: 0usize,
            free_list: null,
            next: self.small_pages,
        };

        let payload_base = if let ?value = small_page_payload_base(page) {
            value
        } else null {
            if let !ok = self.child.free(block) {
                _ = ok;
            } else error! {}
            return Error::OutOfMemory!;
        };
        let base = block.ptr() as usize;
        let payload_offset = payload_base - base;
        if payload_offset >= block.size() {
            if let !ok = self.child.free(block) {
                _ = ok;
            } else error! {}
            return Error::OutOfMemory!;
        }

        let capacity = block.size() - payload_offset;
        let slot_count = capacity / slot_size;
        if slot_count == 0usize {
            if let !ok = self.child.free(block) {
                _ = ok;
            } else error! {}
            return Error::OutOfMemory!;
        }

        var index = 0usize;
        while index < slot_count {
            let addr = payload_base + index * slot_size;
            var slot = addr as &mut SmallSlot;
            slot.* = {
                magic: small_magic,
                size: 0usize,
                align: 0usize,
                allocated: false,
                next: page.free_list,
            };
            page.free_list = ?slot;
            index += 1usize;
        }

        page.slot_count = slot_count;
        self.small_pages = ?page;
        !page
    }

    fn release_empty_small_page(&mut self, page: &mut SmallPage) Error!void {
        var current = self.small_pages;
        var previous: ?&mut SmallPage = null;
        while true {
            if var ?item = current {
                let next = item.next;
                if item as usize == page as usize {
                    if var ?prev = previous {
                        prev.next = next;
                    } else null {
                        self.small_pages = next;
                    }
                    if let !ok = self.child.free(item.block) {
                        return !ok;
                    } else err! {
                        item.next = self.small_pages;
                        self.small_pages = ?item;
                        return err!;
                    }
                }
                previous = ?item;
                current = next;
            } else null {
                return Error::Invalid!;
            }
        }
        !{}
    }

    fn alloc_large(&mut self, layout: Layout) Error!Block {
        let header_size = @size[LargeHeader]();
        let with_header = if let ?value = header_size.checked_add(layout.align()) {
            value
        } else null {
            return Error::OutOfMemory!;
        };
        let total_size = if let ?value = with_header.checked_add(layout.size()) {
            value
        } else null {
            return Error::OutOfMemory!;
        };
        let block_align = max_usize(@align[LargeHeader](), layout.align());
        let backing_layout = Layout::init(total_size, block_align).?;
        let backing = self.child.alloc(backing_layout).?;
        let base = backing.ptr() as usize;
        let user_addr = if let ?value = (base + header_size).align_forward(layout.align()) {
            value
        } else null {
            if let !ok = self.child.free(backing) {
                _ = ok;
            } else error! {}
            return Error::OutOfMemory!;
        };
        let header_addr = user_addr - header_size;
        let user_capacity = backing.size() - (user_addr - base);
        var header = header_addr as &mut LargeHeader;
        header.* = {
            magic: large_magic,
            backing: backing,
            user_layout: layout,
            user_capacity: user_capacity,
            next: self.large_allocations,
        };
        self.large_allocations = ?header;
        !Block::init(user_addr as &mut u8, layout)
    }

    fn free_large(&mut self, block: Block) Error!void {
        var current = self.large_allocations;
        var previous: ?&mut LargeHeader = null;
        while true {
            if var ?header = current {
                let next = header.next;
                if large_header_user_ptr(header) as usize == block.ptr() as usize {
                    if header.magic != large_magic {
                        return Error::Invalid!;
                    }
                    if header.user_layout.size() != block.size() or header.user_layout.align() != block.align() {
                        return Error::Invalid!;
                    }
                    if var ?prev = previous {
                        prev.next = next;
                    } else null {
                        self.large_allocations = next;
                    }
                    if let !ok = self.child.free(header.backing) {
                        return !ok;
                    } else err! {
                        header.next = self.large_allocations;
                        self.large_allocations = ?header;
                        return err!;
                    }
                }
                previous = ?header;
                current = next;
            } else null {
                return Error::Invalid!;
            }
        }
        !{}
    }

    fn find_page_with_free_slot(&mut self, slot_size: usize) ?&mut SmallPage {
        var current = self.small_pages;
        while true {
            if let ?page = current {
                if page.slot_size == slot_size {
                    if let ?node = page.free_list {
                        _ = node;
                        return ?page;
                    } else null {
                    }
                }
                current = page.next;
            } else null {
                return null;
            }
        }
        null
    }

    fn find_small_page(&mut self, block: Block) ?&mut SmallPage {
        var current = self.small_pages;
        while true {
            if let ?page = current {
                if small_page_contains_ptr(page, block.ptr()) {
                    return ?page;
                }
                current = page.next;
            } else null {
                return null;
            }
        }
        null
    }

    fn find_large_header(&mut self, ptr: &mut u8) ?&mut LargeHeader {
        var current = self.large_allocations;
        while true {
            if let ?header = current {
                if large_header_user_ptr(header) as usize == ptr as usize {
                    return ?header;
                }
                current = header.next;
            } else null {
                return null;
            }
        }
        null
    }

    fn free_detached_lists(&mut self, small: ?&mut SmallPage, large: ?&mut LargeHeader) Error!void {
        var failed = false;
        var first_error = Error::Invalid;

        var page = small;
        while true {
            if var ?item = page {
                let next = item.next;
                item.next = null;
                if let !ok = self.child.free(item.block) {
                    _ = ok;
                } else err! {
                    item.next = self.small_pages;
                    self.small_pages = ?item;
                    if not failed {
                        first_error = err;
                        failed = true;
                    }
                }
                page = next;
            } else null {
                break;
            }
        }

        var header = large;
        while true {
            if var ?item = header {
                let next = item.next;
                item.next = null;
                if let !ok = self.child.free(item.backing) {
                    _ = ok;
                } else err! {
                    item.next = self.large_allocations;
                    self.large_allocations = ?item;
                    if not failed {
                        first_error = err;
                        failed = true;
                    }
                }
                header = next;
            } else null {
                if failed {
                    return first_error!;
                }
                return !{};
            }
        }
        !{}
    }
}

fn small_slot_size(layout: Layout) ?usize {
    if layout.size() > max_small_size or layout.align() > max_small_size {
        return null;
    }
    var slot_size = min_slot_size;
    let with_header = if let ?value = @size[SmallSlot]().checked_add(layout.align()) {
        value
    } else null {
        return null;
    };
    let needed_size = if let ?value = with_header.checked_add(layout.size()) {
        value
    } else null {
        return null;
    };
    let needed = max_usize(needed_size, layout.align());
    while slot_size < needed {
        slot_size = slot_size * 2usize;
    }
    if slot_size >= os::page_size() {
        null
    } else {
        ?slot_size
    }
}

fn small_page_payload_base(page: &mut SmallPage) ?usize {
    let base = page.block.ptr() as usize;
    let after_header = if let ?value = base.checked_add(@size[SmallPage]()) {
        value
    } else null {
        return null;
    };
    after_header.align_forward(page.slot_size)
}

fn small_page_contains_ptr(page: &mut SmallPage, ptr: &mut u8) bool {
    let payload_base = if let ?value = small_page_payload_base(page) {
        value
    } else null {
        return false;
    };
    let addr = ptr as usize;
    if addr < payload_base {
        return false;
    }
    let page_end = if let ?value = payload_base.checked_add(page.slot_count * page.slot_size) {
        value
    } else null {
        return false;
    };
    addr < page_end
}

fn small_page_slot_for_ptr(page: &mut SmallPage, ptr: &mut u8) ?&mut SmallSlot {
    if not small_page_contains_ptr(page, ptr) {
        return null;
    }
    let payload_base = if let ?value = small_page_payload_base(page) {
        value
    } else null {
        return null;
    };
    let addr = ptr as usize;
    let offset = addr - payload_base;
    let index = offset / page.slot_size;
    if index >= page.slot_count {
        null
    } else {
        ?((payload_base + index * page.slot_size) as &mut SmallSlot)
    }
}

fn small_slot_user_ptr(slot: &mut SmallSlot, align: usize) ?&mut u8 {
    let addr = if let ?value = (slot as usize).checked_add(@size[SmallSlot]()) {
        value
    } else null {
        return null;
    };
    if let ?value = addr.align_forward(align) {
        ?(value as &mut u8)
    } else null {
        null
    }
}

fn small_slot_matches(slot: &mut SmallSlot, block: Block) bool {
    if slot.magic != small_magic or not slot.allocated {
        return false;
    }
    if slot.size != block.size() or slot.align != block.align() {
        return false;
    }
    let ptr = if let ?value = small_slot_user_ptr(slot, slot.align) {
        value
    } else null {
        return false;
    };
    ptr as usize == block.ptr() as usize
}

fn is_null_small_page(page: ?&mut SmallPage) bool {
    if let ?item = page {
        _ = item;
        false
    } else null {
        true
    }
}

fn is_null_large_header(header: ?&mut LargeHeader) bool {
    if let ?item = header {
        _ = item;
        false
    } else null {
        true
    }
}

fn large_header_user_ptr(header: &mut LargeHeader) &mut u8 {
    let header_addr = header as usize;
    (header_addr + @size[LargeHeader]()) as &mut u8
}

fn max_usize(left: usize, right: usize) usize {
    if left > right {
        left
    } else {
        right
    }
}

fn saturating_add(left: usize, right: usize) usize {
    if let ?value = left.checked_add(right) {
        value
    } else null {
        usize::MAX
    }
}
