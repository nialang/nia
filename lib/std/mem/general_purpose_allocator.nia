// Lightweight single-owner general-purpose allocator over a child allocator.
//
// `deinit` returns `mem::Error!()`. Live user allocations are reported as
// `Error::Leak` after backing cleanup completes; that diagnostic means the
// allocator is empty and needs no retry. Pending rollback storage and empty
// slabs are not user leaks. Cleanup independently walks small pages and large
// headers, then releases any pending rollback block; every independent release
// is attempted and the first release error takes priority. Each failed owner
// returns to its matching state slot, so capacity/used/emptiness stay truthful
// and a retry never revisits released owner classes. Failed owners and a
// detected leak remain on the allocator for cleanup retry; do not resume
// allocation during that retry. Once cleanup succeeds, a previously detected
// leak is reported. `deinitWithoutLeakCheck` suppresses the leak diagnostic,
// including one remembered from a failed checked teardown. Deferred cleanup
// uses `defer allocator.deinit().?;`, with `IntoError` converting the error.
//
// Freed memory is retained for reuse rather than returned to the child on
// every free: returning a page costs a system call, and the next request then
// pays for fresh zeroed pages on first touch. Up to `maxEmptySmallPages` empty
// small pages stay on their size-class lists, and freed large blocks of at most
// `maxCachedLargeBlockSize` bytes are cached, `maxCachedLargeBlocks` and
// `maxCachedLargeBytes` at most, then reused by best fit for requests at least
// half their size. Retained memory counts toward `capacity` and keeps
// `isEmpty` false; `trim` releases it under the same cleanup contract as
// `deinit`, which releases it too.
//
// Large allocations validate the backing base plus header offset before
// publishing metadata, rejecting malformed child addresses. If malformed
// metadata is rejected but the rollback release fails, the child block is kept
// pending; later allocation or `deinit` retries it, and it stays visible in
// capacity/emptiness accounting.
//
// Design boundary: diagnostic checks (allocation footers, checksums, canaries,
// freed-memory poisoning, stack traces, no-reuse, thread-aware metadata) would
// impose the wrong cost and synchronization contract on this allocator. A
// diagnostic allocator belongs in a separate type that wraps the `Allocator`
// boundary, preserves complete `mem::Error` cleanup propagation, and adds those
// checks incrementally without a status-to-error adapter or a weaker cleanup
// retry contract.

using root::cmp;
using root::error;
using root::math;
using root::iter::range;
using root::mem::allocator;
using root::mem::types;
using root::option;
using root::os;

using allocator::Allocator;
using root::mem::error::Error;
using types::Block;
using super::layout::Layout;

const maxSmallSize: usize = 2048;
const minSlotSize: usize = 16;
const maxEmptySmallPages: usize = 8;
const maxCachedLargeBlocks: usize = 8;
const maxCachedLargeBytes: usize = 64 * 1024 * 1024;
const maxCachedLargeBlockSize: usize = 32 * 1024 * 1024;
@[if pointerWidth == 64]
const smallMagic: usize = 0x6e69615f67707331;
@[if pointerWidth == 32]
const smallMagic: usize = 0x67707331;
@[if pointerWidth == 64]
const largeMagic: usize = 0x6e69615f67706131;
@[if pointerWidth == 32]
const largeMagic: usize = 0x67706131;

struct SmallSlot {
    magic: usize,
    size: usize,
    align: usize,
    allocated: bool,
    next: ?&mut SmallSlot,
}

struct SmallPage {
    block: Block,
    slotSize: usize,
    slotCount: usize,
    usedCount: usize,
    usedBytes: usize,
    freeList: ?&mut SmallSlot,
    next: ?&mut SmallPage,
}

struct LargeHeader {
    magic: usize,
    backing: Block,
    userLayout: Layout,
    userCapacity: usize,
    next: ?&mut LargeHeader,
}

// A freed large backing block kept for reuse; the record lives at its base.
struct CachedBlock {
    backing: Block,
    next: ?&mut CachedBlock,
}

pub struct GeneralPurposeAllocator {
    child: &mut Allocator,
    smallPages: ?&mut SmallPage,
    largeAllocations: ?&mut LargeHeader,
    cachedLarge: ?&mut CachedBlock,
    cachedLargeCount: usize,
    cachedLargeBytes: usize,
    pendingFree: ?Block,
    deinitLeak: bool,
}

extend GeneralPurposeAllocator {
    pub fun init(child: &mut Allocator) GeneralPurposeAllocator {
        .{
            child,
            smallPages: null,
            largeAllocations: null,
            cachedLarge: null,
            cachedLargeCount: 0,
            cachedLargeBytes: 0,
            pendingFree: null,
            deinitLeak: false,
        }
    }

    // Returns retained free memory to the child: empty small pages, cached
    // large blocks, and pending rollback storage. Every release is attempted
    // and the first error is returned; memory whose release failed stays
    // retained, so a retry revisits only it.
    pub fun trim(&mut self) Error!() {
        let mut cleanup: error::CleanupAccumulator[Error] = .init();
        let mut current = self.smallPages;
        let mut previous: ?&mut SmallPage = null;
        loop {
            if current is mut ?item {
                let next = item.next;
                if item.usedCount != 0 {
                    previous = ?item;
                } else if self.child.free(item.block) is err! {
                    cleanup.attempt(err!);
                    previous = ?item;
                } else if previous is mut ?prev {
                    prev.next = next;
                } else {
                    self.smallPages = next;
                }
                current = next;
            } else {
                break;
            }
        }
        let cached = self.detachCachedLarge();
        self.releaseCachedList(cached, &mut cleanup);
        if self.pendingFree is ?block {
            if self.child.free(block) is err! {
                cleanup.attempt(err!);
            } else {
                self.pendingFree = null;
            }
        }
        cleanup.finish()
    }

    pub fun deinit(&mut self) Error!() {
        self.deinitLeak = self.deinitLeak or self.hasLiveAllocations();
        self.deinitBacking().?;
        if self.deinitLeak {
            self.deinitLeak = false;
            return .Leak!;
        }
        !()
    }

    pub fun deinitWithoutLeakCheck(&mut self) Error!() {
        self.deinitLeak = false;
        self.deinitBacking()
    }

    fun deinitBacking(&mut self) Error!() {
        let small = self.smallPages;
        let large = self.largeAllocations;
        let pending = self.pendingFree;
        let cached = self.detachCachedLarge();
        self.smallPages = null;
        self.largeAllocations = null;
        self.pendingFree = null;
        self.freeDetachedLists(small, large, cached, pending)
    }

    fun hasLiveAllocations(&self) bool {
        if self.largeAllocations is ?_ {
            return true;
        }

        let mut page = self.smallPages;
        loop {
            if page is ?item {
                if item.usedCount != 0 {
                    return true;
                }
                page = item.next;
            } else {
                return false;
            }
        }
    }

    pub fun capacity(&self) usize {
        let mut total: usize = 0;
        let mut page = self.smallPages;
        loop {
            if page is ?item {
                total = saturatingAdd(total, item.block.size());
                page = item.next;
            } else {
                break;
            }
        }

        let mut large = self.largeAllocations;
        loop {
            if large is ?item {
                total = saturatingAdd(total, item.backing.size());
                large = item.next;
                continue;
            }
            total = saturatingAdd(total, self.cachedLargeBytes);
            if self.pendingFree is ?block {
                return saturatingAdd(total, block.size());
            }
            return total;
        }
    }

    pub fun used(&self) usize {
        let mut total: usize = 0;
        let mut page = self.smallPages;
        loop {
            if page is ?item {
                total = saturatingAdd(total, item.usedBytes);
                page = item.next;
            } else {
                break;
            }
        }

        let mut large = self.largeAllocations;
        loop {
            if large is ?item {
                total = saturatingAdd(total, item.userLayout.size());
                large = item.next;
            } else {
                return total;
            }
        }
    }

    pub fun isEmpty(&self) bool {
        self.smallPages.isNull()
            and self.largeAllocations.isNull()
            and self.cachedLarge.isNull()
            and self.pendingFree.isNull()
    }
}

extend GeneralPurposeAllocator : Allocator {
    pub fun alloc(&mut self, layout: Layout) Error!Block {
        if self.pendingFree is ?block {
            self.child.free(block).?;
            self.pendingFree = null;
        }
        if layout.isEmpty() {
            return !.empty(layout);
        }
        match smallSlotSize(layout) {
            ?slotSize => {
                self.allocSmall(layout, slotSize)
            },
            null => {
                self.allocLarge(layout)
            },
        }
    }

    pub fun resize(&mut self, block: Block, newLayout: Layout) bool {
        if block.isEmpty() {
            return newLayout.isEmpty();
        }
        let smallPage = self.findSmallPage(block);
        if smallPage is mut ?page {
            if newLayout.isEmpty() {
                return false;
            }
            if block.align() != newLayout.align() {
                return false;
            }
            let mut slot = match smallPageSlotForPtr(page, block.ptr()) {
                ?value => {
                    value
                },
                null => {
                    return false;
                },
            };
            if not smallSlotMatches(slot, block) {
                return false;
            }
            let newPtr = match smallSlotUserPtr(slot, newLayout.align()) {
                ?value => {
                    value
                },
                null => {
                    return false;
                },
            };
            if newPtr as usize != block.ptr() as usize {
                return false;
            }
            let slotEnd = match (slot as usize).checkedAdd(page.slotSize) {
                ?value => {
                    value
                },
                null => {
                    return false;
                },
            };
            let blockEnd = match (newPtr as usize).checkedAdd(newLayout.size()) {
                ?value => {
                    value
                },
                null => {
                    return false;
                },
            };
            if blockEnd > slotEnd {
                return false;
            }
            page.usedBytes -= block.size();
            page.usedBytes = saturatingAdd(page.usedBytes, newLayout.size());
            slot.size = newLayout.size();
            slot.align = newLayout.align();
            return true;
        }
        match self.findLargeHeader(block.ptr()) {
            mut ?header => {
                if newLayout.isEmpty() {
                    return false;
                }
                if header.userLayout.size() != block.size() or header.userLayout.align() != block.align() {
                    return false;
                }
                if header.userLayout.align() != newLayout.align() {
                    return false;
                }
                if newLayout.size() > header.userCapacity {
                    return false;
                }
                header.userLayout = newLayout;
                true
            },
            null => {
                false
            },
        }
    }

    pub fun remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            ?block.withLayout(newLayout)
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?.empty(newLayout)
        } else {
            null
        }
    }

    pub fun free(&mut self, block: Block) Error!() {
        if block.isEmpty() {
            return !();
        }
        if self.findSmallPage(block) is ?page {
            return self.freeSmall(page, block);
        }
        self.freeLarge(block)
    }
}

extend GeneralPurposeAllocator {
    fun allocSmall(&mut self, layout: Layout, slotSize: usize) Error!Block {
        let mut page = match self.findPageWithFreeSlot(slotSize) {
            ?item => {
                item
            },
            null => {
                self.allocateSmallPage(slotSize).?
            },
        };
        let mut slot = match page.freeList {
            ?item => {
                item
            },
            null => {
                return .OutOfMemory!;
            },
        };
        let usedCount = match page.usedCount.checkedAdd(1) {
            ?value => {
                value
            },
            null => {
                return .OutOfMemory!;
            },
        };
        if usedCount > page.slotCount {
            return .Invalid!;
        }
        page.freeList = slot.next;
        let ptr = match smallSlotUserPtr(slot, layout.align()) {
            ?value => {
                value
            },
            null => {
                slot.next = page.freeList;
                page.freeList = ?slot;
                return .OutOfMemory!;
            },
        };
        slot.magic = smallMagic;
        slot.size = layout.size();
        slot.align = layout.align();
        slot.allocated = true;
        slot.next = null;
        page.usedCount = usedCount;
        page.usedBytes = saturatingAdd(page.usedBytes, layout.size());
        !.init(ptr, layout)
    }

    fun freeSmall(&mut self, page: &mut SmallPage, block: Block) Error!() {
        let mut slot = match smallPageSlotForPtr(page, block.ptr()) {
            ?value => {
                value
            },
            null => {
                return .Invalid!;
            },
        };
        if not smallSlotMatches(slot, block) {
            return .Invalid!;
        }
        if page.usedCount == 0 {
            return .Invalid!;
        }
        if page.usedCount == 1 and self.emptySmallPageCount() >= maxEmptySmallPages {
            // Keep the user's allocation live if releasing its page fails, so
            // the caller still owns a block it can retry freeing.
            return self.releaseEmptySmallPage(page);
        }
        slot.allocated = false;
        slot.size = 0;
        slot.align = 0;
        slot.next = page.freeList;
        page.freeList = ?slot;
        page.usedCount -= 1;
        page.usedBytes -= block.size();
        !()
    }

    fun allocateSmallPage(&mut self, slotSize: usize) Error!&mut SmallPage {
        let pageSize = os::pageSize();
        let blockLayout = Layout::init(pageSize, pageSize).?;
        let block = self.child.alloc(blockLayout).?;
        let base = block.ptr() as usize;
        if block.size() < pageSize or base % pageSize != 0 {
            self.releaseOrRetain(block);
            return .OutOfMemory!;
        }

        let payloadBase = match smallPagePayloadBase(block, slotSize) {
            ?value => {
                value
            },
            null => {
                self.releaseOrRetain(block);
                return .OutOfMemory!;
            },
        };
        let payloadOffset = payloadBase - base;
        if payloadOffset >= block.size() {
            self.releaseOrRetain(block);
            return .OutOfMemory!;
        }

        let capacity = block.size() - payloadOffset;
        let slotCount = capacity / slotSize;
        if slotCount == 0 {
            self.releaseOrRetain(block);
            return .OutOfMemory!;
        }
        let slotBytes = match slotCount.checkedMul(slotSize) {
            ?value => value,
            null => {
                self.releaseOrRetain(block);
                return .OutOfMemory!;
            },
        };
        let payloadEnd = match payloadBase.checkedAdd(slotBytes) {
            ?value => value,
            null => {
                self.releaseOrRetain(block);
                return .OutOfMemory!;
            },
        };
        let blockEnd = match base.checkedAdd(block.size()) {
            ?value => value,
            null => {
                self.releaseOrRetain(block);
                return .OutOfMemory!;
            },
        };
        if payloadEnd > blockEnd {
            self.releaseOrRetain(block);
            return .OutOfMemory!;
        }

        let mut page = block.ptr() as &mut SmallPage;
        page.* = .{
            block: block,
            slotSize: slotSize,
            slotCount: 0,
            usedCount: 0,
            usedBytes: 0,
            freeList: null,
            next: self.smallPages,
        };

        for index in 0..slotCount {
            let addr = payloadBase + index * slotSize;
            let mut slot = addr as &mut SmallSlot;
            slot.* = .{
                magic: smallMagic,
                size: 0,
                align: 0,
                allocated: false,
                next: page.freeList,
            };
            page.freeList = ?slot;
        }

        page.slotCount = slotCount;
        self.smallPages = ?page;
        !page
    }

    fun releaseEmptySmallPage(&mut self, page: &mut SmallPage) Error!() {
        let mut current = self.smallPages;
        let mut previous: ?&mut SmallPage = null;
        loop {
            if current is mut ?item {
                let next = item.next;
                if item as usize == page as usize {
                    if previous is mut ?prev {
                        prev.next = next;
                    } else {
                        self.smallPages = next;
                    }
                    if self.child.free(item.block) is err! {
                        item.next = self.smallPages;
                        self.smallPages = ?item;
                        return err!;
                    }
                    return !();
                }
                previous = ?item;
                current = next;
            } else {
                return .Invalid!;
            }
        }
    }

    fun allocLarge(&mut self, layout: Layout) Error!Block {
        let headerSize = root::builtin::size[LargeHeader]();
        let withHeader = headerSize.checkedAdd(layout.align()).okOr(Error::OutOfMemory).?;
        let totalSize = withHeader.checkedAdd(layout.size()).okOr(Error::OutOfMemory).?;
        let blockAlign = cmp::max(root::builtin::align[LargeHeader](), layout.align());
        let backingLayout = Layout::init(totalSize, blockAlign).?;
        let backing = match self.takeCachedLarge(totalSize, blockAlign) {
            ?block => block,
            null => self.child.alloc(backingLayout).?,
        };
        let base = backing.ptr() as usize;
        if backing.size() < totalSize or base % blockAlign != 0 {
            self.releaseOrRetain(backing);
            return .OutOfMemory!;
        }
        let backingEnd = match base.checkedAdd(backing.size()) {
            ?value => value,
            null => {
                self.releaseOrRetain(backing);
                return .OutOfMemory!;
            },
        };
        let afterHeader = match base.checkedAdd(headerSize) {
            ?value => value,
            null => {
                self.releaseOrRetain(backing);
                return .OutOfMemory!;
            },
        };
        let userAddr = match afterHeader.alignForward(layout.align()) {
            ?value => {
                value
            },
            null => {
                self.releaseOrRetain(backing);
                return .OutOfMemory!;
            },
        };
        let headerAddr = userAddr - headerSize;
        if userAddr > backingEnd or layout.size() > backingEnd - userAddr {
            self.releaseOrRetain(backing);
            return .OutOfMemory!;
        }
        let userCapacity = backingEnd - userAddr;
        let mut header = headerAddr as &mut LargeHeader;
        header.* = .{
            magic: largeMagic,
            backing: backing,
            userLayout: layout,
            userCapacity: userCapacity,
            next: self.largeAllocations,
        };
        self.largeAllocations = ?header;
        !.init(userAddr as &mut u8, layout)
    }

    fun freeLarge(&mut self, block: Block) Error!() {
        let mut current = self.largeAllocations;
        let mut previous: ?&mut LargeHeader = null;
        loop {
            if current is mut ?header {
                let next = header.next;
                let userPtr = match largeHeaderUserPtr(header) {
                    ?value => value,
                    null => return .Invalid!,
                };
                if userPtr as usize == block.ptr() as usize {
                    if header.magic != largeMagic {
                        return .Invalid!;
                    }
                    if header.userLayout.size() != block.size() or header.userLayout.align() != block.align() {
                        return .Invalid!;
                    }
                    if previous is mut ?prev {
                        prev.next = next;
                    } else {
                        self.largeAllocations = next;
                    }
                    if self.cacheLarge(header.backing) {
                        return !();
                    }
                    if self.child.free(header.backing) is err! {
                        header.next = self.largeAllocations;
                        self.largeAllocations = ?header;
                        return err!;
                    }
                    return !();
                }
                previous = ?header;
                current = next;
            } else {
                return .Invalid!;
            }
        }
    }

    fun findPageWithFreeSlot(&mut self, slotSize: usize) ?&mut SmallPage {
        let mut current = self.smallPages;
        loop {
            if current is ?page {
                if page.slotSize == slotSize and page.freeList is ?_ {
                    return ?page;
                }
                current = page.next;
            } else {
                return null;
            }
        }
    }

    fun findSmallPage(&mut self, block: Block) ?&mut SmallPage {
        let mut current = self.smallPages;
        loop {
            if current is ?page {
                if smallPageContainsPtr(page, block.ptr()) {
                    return ?page;
                }
                current = page.next;
            } else {
                return null;
            }
        }
    }

    fun findLargeHeader(&mut self, ptr: &mut u8) ?&mut LargeHeader {
        let mut current = self.largeAllocations;
        loop {
            if current is ?header {
                if largeHeaderUserPtr(header) is ?userPtr {
                    if userPtr as usize == ptr as usize {
                        return ?header;
                    }
                } else {
                    return null;
                }
                current = header.next;
            } else {
                return null;
            }
        }
    }

    fun releaseOrRetain(&mut self, block: Block) () {
        if self.child.free(block) is error! {
            self.pendingFree = ?block;
        }
    }

    fun freeDetachedLists(
        &mut self,
        small: ?&mut SmallPage,
        large: ?&mut LargeHeader,
        cached: ?&mut CachedBlock,
        pending: ?Block,
    ) Error!() {
        let mut cleanup: error::CleanupAccumulator[Error] = .init();

        let mut page = small;
        loop {
            if page is mut ?item {
                let next = item.next;
                item.next = null;
                if self.child.free(item.block) is err! {
                    item.next = self.smallPages;
                    self.smallPages = ?item;
                    cleanup.attempt(err!);
                }
                page = next;
            } else {
                break;
            }
        }

        let mut header = large;
        loop {
            if header is mut ?item {
                let next = item.next;
                item.next = null;
                if self.child.free(item.backing) is err! {
                    item.next = self.largeAllocations;
                    self.largeAllocations = ?item;
                    cleanup.attempt(err!);
                }
                header = next;
            } else {
                break;
            }
        }

        self.releaseCachedList(cached, &mut cleanup);
        if pending is ?block {
            if self.child.free(block) is err! {
                self.pendingFree = ?block;
                cleanup.attempt(err!);
            }
        }
        cleanup.finish()
    }

    // Takes the whole large-block cache, leaving it empty.
    fun detachCachedLarge(&mut self) ?&mut CachedBlock {
        let cached = self.cachedLarge;
        self.cachedLarge = null;
        self.cachedLargeCount = 0;
        self.cachedLargeBytes = 0;
        cached
    }

    // Releases a detached cache list; blocks whose release fails go back on
    // the cache.
    fun releaseCachedList(
        &mut self,
        cached: ?&mut CachedBlock,
        cleanup: &mut error::CleanupAccumulator[Error],
    ) () {
        let mut current = cached;
        loop {
            if current is mut ?item {
                let next = item.next;
                let backing = item.backing;
                if self.child.free(backing) is err! {
                    self.pushCachedLarge(item);
                    cleanup.attempt(err!);
                }
                current = next;
            } else {
                return;
            }
        }
    }

    fun pushCachedLarge(&mut self, item: &mut CachedBlock) () {
        item.next = self.cachedLarge;
        self.cachedLarge = ?item;
        self.cachedLargeCount += 1;
        self.cachedLargeBytes = saturatingAdd(self.cachedLargeBytes, item.backing.size());
    }

    // Keeps a freed large backing block for reuse, evicting the least recently
    // freed blocks to make room: a recent free is the likeliest to be asked
    // for again.
    fun cacheLarge(&mut self, backing: Block) bool {
        let size = backing.size();
        if size > maxCachedLargeBlockSize
            or size < root::builtin::size[CachedBlock]()
            or size > maxCachedLargeBytes
        {
            return false;
        }
        while self.cachedLargeCount >= maxCachedLargeBlocks
            or size > maxCachedLargeBytes - self.cachedLargeBytes
        {
            if not self.evictOldestCachedLarge() {
                return false;
            }
        }
        let mut item = backing.ptr() as &mut CachedBlock;
        item.* = .{ backing, next: null };
        self.pushCachedLarge(item);
        true
    }

    // Releases the least recently cached block; false if there is none or its
    // release fails, in which case it stays cached.
    fun evictOldestCachedLarge(&mut self) bool {
        let mut previous: ?&mut CachedBlock = null;
        let mut current = self.cachedLarge;
        loop {
            if current is mut ?item {
                if item.next is ?_ {
                    previous = ?item;
                    current = item.next;
                    continue;
                }
                // The record lives inside the block, so read it before release.
                let backing = item.backing;
                if self.child.free(backing) is error! {
                    return false;
                }
                if previous is mut ?prev {
                    prev.next = null;
                } else {
                    self.cachedLarge = null;
                }
                self.cachedLargeCount -= 1;
                self.cachedLargeBytes -= backing.size();
                return true;
            } else {
                return false;
            }
        }
    }

    // The smallest cached block that holds `size` bytes at `align`, unless
    // that would leave more than half of it unused.
    fun takeCachedLarge(&mut self, size: usize, align: usize) ?Block {
        let mut best: ?&mut CachedBlock = null;
        let mut bestPrevious: ?&mut CachedBlock = null;
        let mut previous: ?&mut CachedBlock = null;
        let mut current = self.cachedLarge;
        loop {
            if current is mut ?item {
                let candidate = item.backing.size();
                let fits = candidate >= size
                    and candidate - size <= size
                    and item.backing.ptr() as usize % align == 0;
                let better = match best {
                    ?chosen => candidate < chosen.backing.size(),
                    null => true,
                };
                if fits and better {
                    best = ?item;
                    bestPrevious = previous;
                }
                previous = ?item;
                current = item.next;
            } else {
                break;
            }
        }
        let chosen = match best {
            ?item => item,
            null => return null,
        };
        if bestPrevious is mut ?prev {
            prev.next = chosen.next;
        } else {
            self.cachedLarge = chosen.next;
        }
        self.cachedLargeCount -= 1;
        self.cachedLargeBytes -= chosen.backing.size();
        ?chosen.backing
    }

    fun emptySmallPageCount(&self) usize {
        let mut count: usize = 0;
        let mut page = self.smallPages;
        loop {
            if page is ?item {
                if item.usedCount == 0 {
                    count += 1;
                }
                page = item.next;
            } else {
                return count;
            }
        }
    }
}

fun smallSlotSize(layout: Layout) ?usize {
    if layout.size() > maxSmallSize or layout.align() > maxSmallSize {
        return null;
    }
    let mut slotSize = minSlotSize;
    let withHeader = match root::builtin::size[SmallSlot]().checkedAdd(layout.align()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let neededSize = match withHeader.checkedAdd(layout.size()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let needed = cmp::max(neededSize, layout.align());
    while slotSize < needed {
        slotSize = match slotSize.checkedMul(2) {
            ?value => {
                value
            },
            null => {
                return null;
            },
        };
    }
    if slotSize >= os::pageSize() {
        null
    } else {
        ?slotSize
    }
}

fun smallPagePayloadBase(block: Block, slotSize: usize) ?usize {
    let base = block.ptr() as usize;
    let afterHeader = match base.checkedAdd(root::builtin::size[SmallPage]()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let payloadBase = match afterHeader.alignForward(slotSize) {
        ?value => value,
        null => return null,
    };
    let blockEnd = match base.checkedAdd(block.size()) {
        ?value => value,
        null => return null,
    };
    if payloadBase >= blockEnd {
        return null;
    }
    ?payloadBase
}

fun smallPageContainsPtr(page: &mut SmallPage, ptr: &mut u8) bool {
    let payloadBase = match smallPagePayloadBase(page.block, page.slotSize) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    let addr = ptr as usize;
    if addr < payloadBase {
        return false;
    }
    let slotBytes = match page.slotCount.checkedMul(page.slotSize) {
        ?value => value,
        null => return false,
    };
    let pageEnd = match payloadBase.checkedAdd(slotBytes) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    addr < pageEnd
}

fun smallPageSlotForPtr(page: &mut SmallPage, ptr: &mut u8) ?&mut SmallSlot {
    if not smallPageContainsPtr(page, ptr) {
        return null;
    }
    let payloadBase = match smallPagePayloadBase(page.block, page.slotSize) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let addr = ptr as usize;
    let offset = addr - payloadBase;
    let index = offset / page.slotSize;
    if index >= page.slotCount {
        null
    } else {
        let slotOffset = match index.checkedMul(page.slotSize) {
            ?value => value,
            null => return null,
        };
        let slotAddr = match payloadBase.checkedAdd(slotOffset) {
            ?value => value,
            null => return null,
        };
        ?(slotAddr as &mut SmallSlot)
    }
}

fun smallSlotUserPtr(slot: &mut SmallSlot, align: usize) ?&mut u8 {
    let addr = match (slot as usize).checkedAdd(root::builtin::size[SmallSlot]()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    addr.alignForward(align).map[&mut u8, _](\value: usize -> value as &mut u8)
}

fun smallSlotMatches(slot: &mut SmallSlot, block: Block) bool {
    if slot.magic != smallMagic or not slot.allocated {
        return false;
    }
    if slot.size != block.size() or slot.align != block.align() {
        return false;
    }
    let ptr = match smallSlotUserPtr(slot, slot.align) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    ptr as usize == block.ptr() as usize
}

fun largeHeaderUserPtr(header: &mut LargeHeader) ?&mut u8 {
    let headerAddr = header as usize;
    headerAddr
        .checkedAdd(root::builtin::size[LargeHeader]())
        .map[&mut u8, _](\value: usize -> value as &mut u8)
}

fun saturatingAdd(left: usize, right: usize) usize {
    match left.checkedAdd(right) {
        ?value => {
            value
        },
        null => {
            usize::MAX
        },
    }
}
