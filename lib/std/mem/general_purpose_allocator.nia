using pkg::math;
using pkg::iter::range;
using pkg::mem::allocator;
using pkg::mem::types;
using pkg::os;

using allocator::Allocator;
using types::{Block, Error, Layout};

pub enum DeinitStatus: i32 {
    Ok = 0,
    Leak = 1,
}

extend DeinitStatus {
    pub fn ok(self) Error!() {
        if self == DeinitStatus::Ok {
            !()
        } else {
            Error::Invalid!
        }
    }
}

extend Error!DeinitStatus {
    pub fn ok(self) Error!() {
        match self {
            !status => {
                status.ok()
            },
            err! => {
                err!
            },
        }
    }
}

const maxSmallSize: usize = 2048;
const minSlotSize: usize = 16;
const smallMagic: usize = 0x6e69615f67707331;
const largeMagic: usize = 0x6e69615f67706131;

struct SmallSlot {
    magic: usize,
    size: usize,
    align: usize,
    allocated: bool,
    next: ?&mut SmallSlot,
}

struct SmallPage {
    block: Block,
    slotSize: usize,
    slotCount: usize,
    usedCount: usize,
    usedBytes: usize,
    freeList: ?&mut SmallSlot,
    next: ?&mut SmallPage,
}

struct LargeHeader {
    magic: usize,
    backing: Block,
    userLayout: Layout,
    userCapacity: usize,
    next: ?&mut LargeHeader,
}

pub struct GeneralPurposeAllocator {
    child: &mut Allocator,
    smallPages: ?&mut SmallPage,
    largeAllocations: ?&mut LargeHeader,
}

extend GeneralPurposeAllocator {
    pub fn init(child: &mut Allocator) GeneralPurposeAllocator {
        Self { child, smallPages: null, largeAllocations: null }
    }

    pub fn deinit(&mut self) Error!DeinitStatus {
        let leaked = not self.isEmpty();
        self.deinitWithoutLeakCheck().?;
        if leaked {
            !DeinitStatus::Leak
        } else {
            !DeinitStatus::Ok
        }
    }

    pub fn deinitWithoutLeakCheck(&mut self) Error!() {
        let small = self.smallPages;
        let large = self.largeAllocations;
        self.smallPages = null;
        self.largeAllocations = null;
        self.freeDetachedLists(small, large)
    }

    pub fn capacity(&self) usize {
        let mut total: usize = 0;
        let mut page = self.smallPages;
        while true {
            match page {
                ?item => {
                    total = saturatingAdd(total, item.block.size());
                    page = item.next;
                },
                null => {
                    break;
                },
            }
        }

        let mut large = self.largeAllocations;
        while true {
            match large {
                ?item => {
                    total = saturatingAdd(total, item.backing.size());
                    large = item.next;
                },
                null => {
                    return total;
                },
            }
        }
        total
    }

    pub fn used(&self) usize {
        let mut total: usize = 0;
        let mut page = self.smallPages;
        while true {
            match page {
                ?item => {
                    total = saturatingAdd(total, item.usedBytes);
                    page = item.next;
                },
                null => {
                    break;
                },
            }
        }

        let mut large = self.largeAllocations;
        while true {
            match large {
                ?item => {
                    total = saturatingAdd(total, item.userLayout.size());
                    large = item.next;
                },
                null => {
                    return total;
                },
            }
        }
        total
    }

    pub fn isEmpty(&self) bool {
        isNullSmallPage(self.smallPages) and isNullLargeHeader(self.largeAllocations)
    }
}

extend GeneralPurposeAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) Error!Block {
        if layout.isEmpty() {
            return !Block::empty(layout);
        }
        match smallSlotSize(layout) {
            ?slotSize => {
                self.allocSmall(layout, slotSize)
            },
            null => {
                self.allocLarge(layout)
            },
        }
    }

    pub fn resize(&mut self, block: Block, newLayout: Layout) bool {
        if block.isEmpty() {
            return newLayout.isEmpty();
        }
        let smallPage = self.findSmallPage(block);
        match smallPage {
            mut ?page => {
                if newLayout.isEmpty() {
                    return false;
                }
                if block.align() != newLayout.align() {
                    return false;
                }
                let mut slot = match smallPageSlotForPtr(page, block.ptr()) {
                    ?value => {
                        value
                    },
                    null => {
                        return false;
                    },
                };
                if not smallSlotMatches(slot, block) {
                    return false;
                }
                let newPtr = match smallSlotUserPtr(slot, newLayout.align()) {
                    ?value => {
                        value
                    },
                    null => {
                        return false;
                    },
                };
                if newPtr as usize != block.ptr() as usize {
                    return false;
                }
                let slotEnd = match (slot as usize).checked_add(page.slotSize) {
                    ?value => {
                        value
                    },
                    null => {
                        return false;
                    },
                };
                let blockEnd = match (newPtr as usize).checked_add(newLayout.size()) {
                    ?value => {
                        value
                    },
                    null => {
                        return false;
                    },
                };
                if blockEnd > slotEnd {
                    return false;
                }
                page.usedBytes -= block.size();
                page.usedBytes = saturatingAdd(page.usedBytes, newLayout.size());
                slot.size = newLayout.size();
                slot.align = newLayout.align();
                return true;
            },
            null => {
                _ = smallPage;
            },
        }
        match self.findLargeHeader(block.ptr()) {
            mut ?header => {
                if newLayout.isEmpty() {
                    return false;
                }
                if header.userLayout.size() != block.size() or header.userLayout.align() != block.align() {
                    return false;
                }
                if header.userLayout.align() != newLayout.align() {
                    return false;
                }
                if newLayout.size() > header.userCapacity {
                    return false;
                }
                header.userLayout = newLayout;
                true
            },
            null => {
                false
            },
        }
    }

    pub fn remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            ?Block::init(block.ptr(), newLayout)
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?Block::empty(newLayout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) Error!() {
        if block.isEmpty() {
            return !();
        }
        match self.findSmallPage(block) {
            ?page => {
                return self.freeSmall(page, block);
            },
            null => {
            },
        }
        self.freeLarge(block)
    }
}

extend GeneralPurposeAllocator {
    fn allocSmall(&mut self, layout: Layout, slotSize: usize) Error!Block {
        let mut page = match self.findPageWithFreeSlot(slotSize) {
            ?item => {
                item
            },
            null => {
                self.allocateSmallPage(slotSize).?
            },
        };
        let mut slot = match page.freeList {
            ?item => {
                item
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        page.freeList = slot.next;
        let ptr = match smallSlotUserPtr(slot, layout.align()) {
            ?value => {
                value
            },
            null => {
                slot.next = page.freeList;
                page.freeList = ?slot;
                return Error::OutOfMemory!;
            },
        };
        slot.magic = smallMagic;
        slot.size = layout.size();
        slot.align = layout.align();
        slot.allocated = true;
        slot.next = null;
        page.usedCount += 1;
        page.usedBytes = saturatingAdd(page.usedBytes, layout.size());
        !Block::init(ptr, layout)
    }

    fn freeSmall(&mut self, page: &mut SmallPage, block: Block) Error!() {
        let mut slot = match smallPageSlotForPtr(page, block.ptr()) {
            ?value => {
                value
            },
            null => {
                return Error::Invalid!;
            },
        };
        if not smallSlotMatches(slot, block) {
            return Error::Invalid!;
        }
        if page.usedCount == 0 {
            return Error::Invalid!;
        }
        slot.allocated = false;
        slot.size = 0;
        slot.align = 0;
        slot.next = page.freeList;
        page.freeList = ?slot;
        page.usedCount -= 1;
        page.usedBytes -= block.size();
        if page.usedCount == 0 {
            self.releaseEmptySmallPage(page).?;
        }
        !()
    }

    fn allocateSmallPage(&mut self, slotSize: usize) Error!&mut SmallPage {
        let pageSize = os::pageSize();
        let blockLayout = Layout::init(pageSize, pageSize).?;
        let block = self.child.alloc(blockLayout).?;
        let mut page = block.ptr() as &mut SmallPage;
        page.* = SmallPage {
            block: block,
            slotSize: slotSize,
            slotCount: 0,
            usedCount: 0,
            usedBytes: 0,
            freeList: null,
            next: self.smallPages,
        };

        let payloadBase = match smallPagePayloadBase(page) {
            ?value => {
                value
            },
            null => {
                match self.child.free(block) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {},
                }
                return Error::OutOfMemory!;
            },
        };
        let base = block.ptr() as usize;
        let payloadOffset = payloadBase - base;
        if payloadOffset >= block.size() {
            match self.child.free(block) {
                !ok => {
                    _ = ok;
                },
                error! => {},
            }
            return Error::OutOfMemory!;
        }

        let capacity = block.size() - payloadOffset;
        let slotCount = capacity / slotSize;
        if slotCount == 0 {
            match self.child.free(block) {
                !ok => {
                    _ = ok;
                },
                error! => {},
            }
            return Error::OutOfMemory!;
        }

        for index in 0..slotCount {
            let addr = payloadBase + index * slotSize;
            let mut slot = addr as &mut SmallSlot;
            slot.* = SmallSlot {
                magic: smallMagic,
                size: 0,
                align: 0,
                allocated: false,
                next: page.freeList,
            };
            page.freeList = ?slot;
        }

        page.slotCount = slotCount;
        self.smallPages = ?page;
        !page
    }

    fn releaseEmptySmallPage(&mut self, page: &mut SmallPage) Error!() {
        let mut current = self.smallPages;
        let mut previous: ?&mut SmallPage = null;
        while true {
            match current {
                mut ?item => {
                    let next = item.next;
                    if item as usize == page as usize {
                        match previous {
                            mut ?prev => {
                                prev.next = next;
                            },
                            null => {
                                self.smallPages = next;
                            },
                        }
                        match self.child.free(item.block) {
                            !ok => {
                                return !ok;
                            },
                            err! => {
                                item.next = self.smallPages;
                                self.smallPages = ?item;
                                return err!;
                            },
                        }
                    }
                    previous = ?item;
                    current = next;
                },
                null => {
                    return Error::Invalid!;
                },
            }
        }
        !()
    }

    fn allocLarge(&mut self, layout: Layout) Error!Block {
        let headerSize = std::builtin::size[LargeHeader]();
        let withHeader = match headerSize.checked_add(layout.align()) {
            ?value => {
                value
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        let totalSize = match withHeader.checked_add(layout.size()) {
            ?value => {
                value
            },
            null => {
                return Error::OutOfMemory!;
            },
        };
        let blockAlign = maxUsize(std::builtin::align[LargeHeader](), layout.align());
        let backingLayout = Layout::init(totalSize, blockAlign).?;
        let backing = self.child.alloc(backingLayout).?;
        let base = backing.ptr() as usize;
        let userAddr = match (base + headerSize).align_forward(layout.align()) {
            ?value => {
                value
            },
            null => {
                match self.child.free(backing) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {},
                }
                return Error::OutOfMemory!;
            },
        };
        let headerAddr = userAddr - headerSize;
        let userCapacity = backing.size() - (userAddr - base);
        let mut header = headerAddr as &mut LargeHeader;
        header.* = LargeHeader {
            magic: largeMagic,
            backing: backing,
            userLayout: layout,
            userCapacity: userCapacity,
            next: self.largeAllocations,
        };
        self.largeAllocations = ?header;
        !Block::init(userAddr as &mut u8, layout)
    }

    fn freeLarge(&mut self, block: Block) Error!() {
        let mut current = self.largeAllocations;
        let mut previous: ?&mut LargeHeader = null;
        while true {
            match current {
                mut ?header => {
                    let next = header.next;
                    if largeHeaderUserPtr(header) as usize == block.ptr() as usize {
                        if header.magic != largeMagic {
                            return Error::Invalid!;
                        }
                        if header.userLayout.size() != block.size() or header.userLayout.align() != block.align() {
                            return Error::Invalid!;
                        }
                        match previous {
                            mut ?prev => {
                                prev.next = next;
                            },
                            null => {
                                self.largeAllocations = next;
                            },
                        }
                        match self.child.free(header.backing) {
                            !ok => {
                                return !ok;
                            },
                            err! => {
                                header.next = self.largeAllocations;
                                self.largeAllocations = ?header;
                                return err!;
                            },
                        }
                    }
                    previous = ?header;
                    current = next;
                },
                null => {
                    return Error::Invalid!;
                },
            }
        }
        !()
    }

    fn findPageWithFreeSlot(&mut self, slotSize: usize) ?&mut SmallPage {
        let mut current = self.smallPages;
        while true {
            match current {
                ?page => {
                    if page.slotSize == slotSize {
                        match page.freeList {
                            ?node => {
                                _ = node;
                                return ?page;
                            },
                            null => {
                            },
                        }
                    }
                    current = page.next;
                },
                null => {
                    return null;
                },
            }
        }
        null
    }

    fn findSmallPage(&mut self, block: Block) ?&mut SmallPage {
        let mut current = self.smallPages;
        while true {
            match current {
                ?page => {
                    if smallPageContainsPtr(page, block.ptr()) {
                        return ?page;
                    }
                    current = page.next;
                },
                null => {
                    return null;
                },
            }
        }
        null
    }

    fn findLargeHeader(&mut self, ptr: &mut u8) ?&mut LargeHeader {
        let mut current = self.largeAllocations;
        while true {
            match current {
                ?header => {
                    if largeHeaderUserPtr(header) as usize == ptr as usize {
                        return ?header;
                    }
                    current = header.next;
                },
                null => {
                    return null;
                },
            }
        }
        null
    }

    fn freeDetachedLists(&mut self, small: ?&mut SmallPage, large: ?&mut LargeHeader) Error!() {
        let mut failed = false;
        let mut firstError = Error::Invalid;

        let mut page = small;
        while true {
            match page {
                mut ?item => {
                    let next = item.next;
                    item.next = null;
                    match self.child.free(item.block) {
                        !ok => {
                            _ = ok;
                        },
                        err! => {
                            item.next = self.smallPages;
                            self.smallPages = ?item;
                            if not failed {
                                firstError = err;
                                failed = true;
                            }
                        },
                    }
                    page = next;
                },
                null => {
                    break;
                },
            }
        }

        let mut header = large;
        while true {
            match header {
                mut ?item => {
                    let next = item.next;
                    item.next = null;
                    match self.child.free(item.backing) {
                        !ok => {
                            _ = ok;
                        },
                        err! => {
                            item.next = self.largeAllocations;
                            self.largeAllocations = ?item;
                            if not failed {
                                firstError = err;
                                failed = true;
                            }
                        },
                    }
                    header = next;
                },
                null => {
                    if failed {
                        return firstError!;
                    }
                    return !();
                },
            }
        }
        !()
    }
}

fn smallSlotSize(layout: Layout) ?usize {
    if layout.size() > maxSmallSize or layout.align() > maxSmallSize {
        return null;
    }
    let mut slotSize = minSlotSize;
    let withHeader = match std::builtin::size[SmallSlot]().checked_add(layout.align()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let neededSize = match withHeader.checked_add(layout.size()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let needed = maxUsize(neededSize, layout.align());
    while slotSize < needed {
        slotSize = slotSize * 2;
    }
    if slotSize >= os::pageSize() {
        null
    } else {
        ?slotSize
    }
}

fn smallPagePayloadBase(page: &mut SmallPage) ?usize {
    let base = page.block.ptr() as usize;
    let afterHeader = match base.checked_add(std::builtin::size[SmallPage]()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    afterHeader.align_forward(page.slotSize)
}

fn smallPageContainsPtr(page: &mut SmallPage, ptr: &mut u8) bool {
    let payloadBase = match smallPagePayloadBase(page) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    let addr = ptr as usize;
    if addr < payloadBase {
        return false;
    }
    let pageEnd = match payloadBase.checked_add(page.slotCount * page.slotSize) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    addr < pageEnd
}

fn smallPageSlotForPtr(page: &mut SmallPage, ptr: &mut u8) ?&mut SmallSlot {
    if not smallPageContainsPtr(page, ptr) {
        return null;
    }
    let payloadBase = match smallPagePayloadBase(page) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    let addr = ptr as usize;
    let offset = addr - payloadBase;
    let index = offset / page.slotSize;
    if index >= page.slotCount {
        null
    } else {
        ?((payloadBase + index * page.slotSize) as &mut SmallSlot)
    }
}

fn smallSlotUserPtr(slot: &mut SmallSlot, align: usize) ?&mut u8 {
    let addr = match (slot as usize).checked_add(std::builtin::size[SmallSlot]()) {
        ?value => {
            value
        },
        null => {
            return null;
        },
    };
    match addr.align_forward(align) {
        ?value => {
            ?(value as &mut u8)
        },
        null => {
            null
        },
    }
}

fn smallSlotMatches(slot: &mut SmallSlot, block: Block) bool {
    if slot.magic != smallMagic or not slot.allocated {
        return false;
    }
    if slot.size != block.size() or slot.align != block.align() {
        return false;
    }
    let ptr = match smallSlotUserPtr(slot, slot.align) {
        ?value => {
            value
        },
        null => {
            return false;
        },
    };
    ptr as usize == block.ptr() as usize
}

fn isNullSmallPage(page: ?&mut SmallPage) bool {
    match page {
        ?item => {
            _ = item;
            false
        },
        null => {
            true
        },
    }
}

fn isNullLargeHeader(header: ?&mut LargeHeader) bool {
    match header {
        ?item => {
            _ = item;
            false
        },
        null => {
            true
        },
    }
}

fn largeHeaderUserPtr(header: &mut LargeHeader) &mut u8 {
    let headerAddr = header as usize;
    (headerAddr + std::builtin::size[LargeHeader]()) as &mut u8
}

fn maxUsize(left: usize, right: usize) usize {
    if left > right {
        left
    } else {
        right
    }
}

fn saturatingAdd(left: usize, right: usize) usize {
    match left.checked_add(right) {
        ?value => {
            value
        },
        null => {
            usize::MAX
        },
    }
}
