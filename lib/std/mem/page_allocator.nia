using pkg::error;
using pkg::mem::allocator;
using pkg::mem::types;
using pkg::os;

using allocator::Allocator;
using types::{Block, Layout};

pub struct PageAllocator {}

extend PageAllocator {
    pub fn init() PageAllocator {
        {}
    }
}

extend PageAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) types::Error!Block {
        _ = self;
        if layout.is_empty() {
            !Block::empty(layout)
        } else {
            let ptr = os::map_pages(layout.size(), layout.align()).as_page_allocator_error().?;
            !Block::init(ptr, layout)
        }
    }

    pub fn resize(&mut self, block: Block, new_layout: Layout) bool {
        _ = self;
        if block.align() != new_layout.align() {
            return false;
        }
        if block.is_empty() or new_layout.is_empty() {
            return block.is_empty() and new_layout.is_empty();
        }

        let mut old_size: usize;
        if let !size = os::page_aligned_len(block.size()) {
            old_size = size;
        } else err! {
            return false;
        }
        let mut new_size: usize;
        if let !size = os::page_aligned_len(new_layout.size()) {
            new_size = size;
        } else err! {
            return false;
        }
        old_size == new_size
    }

    pub fn remap(&mut self, block: Block, new_layout: Layout) ?Block {
        if self.resize(block, new_layout) {
            ?Block::init(block.ptr(), new_layout)
        } else if block.is_empty() and new_layout.is_empty() {
            ?Block::empty(new_layout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) types::Error!void {
        _ = self;
        if block.layout().is_empty() {
            !{}
        } else {
            os::unmap_pages(block.ptr(), block.size()).as_page_allocator_error()
        }
    }
}

extend os::Error : error::IntoError[types::Error] {
    fn into_error(self) types::Error {
        switch self {
            os::Error::Invalid => types::Error::Invalid,
            os::Error::OutOfMemory => types::Error::OutOfMemory,
            _ => types::Error::System,
        }
    }
}

extend os::Error {
    fn as_page_allocator_error(self) types::Error {
        self.into_error()
    }
}

extend[T] os::Error!T {
    fn as_page_allocator_error(self) types::Error!T {
        self.cast_error()
    }
}
