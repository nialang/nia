// Page allocator backed directly by OS mappings.
//
// Over-aligned allocations may expose an interior aligned pointer while
// `mem::Block` retains the complete mapping release range for one exact
// `free`. Validation failures after the mapping succeeds release that
// unpublished range before returning an error.

using root::builtin;
using root::mem::allocator;
using root::mem::types;
using root::os;

using allocator::Allocator;
using types::{Block, Layout};

pub struct PageAllocator {}

extend PageAllocator {
    pub fun init() PageAllocator {
        .{}
    }
}

extend PageAllocator : Allocator {
    pub fun alloc(&mut self, layout: Layout) types::Error!Block {
        _ = self;
        if layout.isEmpty() {
            !.empty(layout)
        } else {
            let mapping = os::mapPages(layout.size(), layout.align()).?;
            !.initWithRelease(
                mapping.ptr(),
                layout,
                mapping.releasePtr(),
                mapping.releaseSize(),
            )
        }
    }

    pub fun resize(&mut self, block: Block, newLayout: Layout) bool {
        _ = self;
        if block.align() != newLayout.align() {
            return false;
        }
        if block.isEmpty() or newLayout.isEmpty() {
            return block.isEmpty() and newLayout.isEmpty();
        }

        if os::pageAlignedLen(block.size()) is !oldSize
            and os::pageAlignedLen(newLayout.size()) is !newSize
        {
            return oldSize == newSize;
        };
        false
    }

    pub fun remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            ?block.withLayout(newLayout)
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?.empty(newLayout)
        } else {
            null
        }
    }

    pub fun free(&mut self, block: Block) types::Error!() {
        _ = self;
        if block.layout().isEmpty() {
            !()
        } else {
            !(os::unmapPages(block.releasePtr(), block.releaseSize()).?)
        }
    }
}

extend os::Error : builtin::IntoError[types::Error] {
    const fun intoError(self) types::Error {
        match self {
            .Invalid => .Invalid,
            .OutOfMemory => .OutOfMemory,
            _ => .System,
        }
    }
}
