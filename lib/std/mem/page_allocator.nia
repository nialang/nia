using pkg::error;
using pkg::mem::allocator;
using pkg::mem::types;
using pkg::os;

using allocator::Allocator;
using types::{Block, Layout};

pub struct PageAllocator {}

extend PageAllocator {
    pub fn init() PageAllocator {
        {}
    }
}

extend PageAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) types::Error!Block {
        _ = self;
        if layout.isEmpty() {
            !Block::empty(layout)
        } else {
            let mapping = os::mapPages(layout.size(), layout.align()).?;
            !Block::initWithRelease(
                mapping.ptr(),
                layout,
                mapping.releasePtr(),
                mapping.releaseSize(),
            )
        }
    }

    pub fn resize(&mut self, block: Block, newLayout: Layout) bool {
        _ = self;
        if block.align() != newLayout.align() {
            return false;
        }
        if block.isEmpty() or newLayout.isEmpty() {
            return block.isEmpty() and newLayout.isEmpty();
        }

        let mut oldSize: usize;
        match os::pageAlignedLen(block.size()) {
            !size => {
                oldSize = size;
            },
            err! => {
                return false;
            },
        }
        let mut newSize: usize;
        match os::pageAlignedLen(newLayout.size()) {
            !size => {
                newSize = size;
            },
            err! => {
                return false;
            },
        }
        oldSize == newSize
    }

    pub fn remap(&mut self, block: Block, newLayout: Layout) ?Block {
        if self.resize(block, newLayout) {
            ?Block::initWithRelease(
                block.ptr(),
                newLayout,
                block.releasePtr(),
                block.releaseSize(),
            )
        } else if block.isEmpty() and newLayout.isEmpty() {
            ?Block::empty(newLayout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) types::Error!() {
        _ = self;
        if block.layout().isEmpty() {
            !()
        } else {
            os::unmapPages(block.releasePtr(), block.releaseSize()).asPageAllocatorError()
        }
    }
}

extend os::Error : error::IntoError[types::Error] {
    const fn into_error(self) types::Error {
        match self {
            os::Error::Invalid => types::Error::Invalid,
            os::Error::OutOfMemory => types::Error::OutOfMemory,
            _ => types::Error::System,
        }
    }
}

extend os::Error {
    fn asPageAllocatorError(self) types::Error {
        self.into_error()
    }
}

extend[T] os::Error!T {
    fn asPageAllocatorError(self) types::Error!T {
        self.cast_error()
    }
}
