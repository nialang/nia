// ASCII decimal syntax and a borrowed iterator over significant digits.

using root::cmp;
using root::math::float::decimal;
using root::option;
using root::parse::ascii::AsciiUnit;
using root::parse::core::Error;

pub(root) struct Parsed {
    negative: bool,
    zero: bool,
    digitsEnd: usize,
    firstDigit: usize,
    significantDigits: usize,
    exponent10: i128,
}

pub(root) struct SignificantDigits[U] where U: AsciiUnit {
    input: &[U],
    cursor: usize,
    end: usize,
}

extend Parsed {
    pub(root) fun order(&self) i128 {
        self.significantDigits as i128 + self.exponent10
    }

    pub(root) fun digits[U](&self, input: &[U]) SignificantDigits[U]
    where U: AsciiUnit
    {
        .{ input, cursor: self.firstDigit, end: self.digitsEnd }
    }
}

extend[U] SignificantDigits[U] : Iterator
where U: AsciiUnit
{
    type Item = u8;

    fun next(&mut self) ?u8 {
        while self.cursor < self.end {
            let unit = self.input[self.cursor];
            self.cursor += 1;
            if unit.digit() is ?digit { return ?(b'0' + digit); }
        }
        null
    }
}

// Saturation beyond twice the largest slice length cannot affect a finite
// result, even after accounting for all fractional and significant digits.
fun appendExponent(value: i128, digit: u32) i128 {
    let limit = usize::MAX as i128 * 2;
    cmp::min(value * 10 + digit as i128, limit)
}

pub(root) fun parse[U](input: &[U]) Error!Parsed
where U: AsciiUnit
{
    if input.len() == 0 { return .Empty!; }
    let negative = input[0].isAscii('-');
    if input[0].isAscii('+') { return .InvalidSign!; }
    let start: usize = if negative { 1 } else { 0 };
    if start == input.len() { return .InvalidDigit!; }

    let mut index = start;
    let mut fractionDigits: usize = 0;
    let mut firstDigit = input.len();
    let mut significantDigits: usize = 0;
    let mut sawDigit = false;
    let mut sawDot = false;
    while index < input.len() {
        let unit = input[index];
        if unit.digit().isPresent() {
            sawDigit = true;
            if sawDot { fractionDigits += 1; }
            if firstDigit == input.len() and not unit.isAscii('0') { firstDigit = index; }
            if firstDigit != input.len() { significantDigits += 1; }
            index += 1;
        } else if unit.isAscii('.') and not sawDot {
            sawDot = true;
            index += 1;
        } else {
            break;
        }
    }
    if not sawDigit or (sawDot and input[index - 1].isAscii('.')) { return .InvalidDigit!; }
    let digitsEnd = index;

    let mut exponent: i128 = 0;
    let mut exponentNegative = false;
    if index < input.len() and (input[index].isAscii('e') or input[index].isAscii('E')) {
        index += 1;
        if index < input.len() and (input[index].isAscii('-') or input[index].isAscii('+')) {
            exponentNegative = input[index].isAscii('-');
            index += 1;
        }
        let exponentStart = index;
        while index < input.len() {
            if input[index].digit() is ?digit {
                exponent = appendExponent(exponent, digit as u32);
                index += 1;
            } else {
                break;
            }
        }
        if exponentStart == index { return .InvalidDigit!; }
    }
    if index != input.len() { return .InvalidDigit!; }
    if exponentNegative { exponent = -exponent; }
    let adjusted = exponent - fractionDigits as i128;
    !.{ negative, zero: firstDigit == input.len(), digitsEnd, firstDigit, significantDigits, exponent10: adjusted }
}

pub(root) fun compareParsed[U](input: &[U], parsed: Parsed, exact: &decimal::Decimal) i32
where U: AsciiUnit
{
    decimal::compare(parsed.digits(input), parsed.order(), parsed.zero, exact)
}
