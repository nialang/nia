// ASCII decimal syntax and a borrowed iterator over significant digits.

using root::cmp;
using root::math::float::decimal::Exact;
using root::parse::ascii::AsciiUnit;
using root::parse::core::Error;

pub(root) struct Parsed {
    negative: bool,
    zero: bool,
    digitsEnd: usize,
    firstDigit: usize,
    significantDigits: usize,
    exponent10: i128,
}

pub(root) struct SignificantDigits[U] where U: AsciiUnit {
    input: &[U],
    cursor: usize,
    end: usize,
}

extend Parsed {
    pub(root) fun order(&self) i128 {
        self.significantDigits as i128 + self.exponent10
    }

    pub(root) fun digits[U](&self, input: &[U]) SignificantDigits[U]
    where U: AsciiUnit
    {
        .{ input, cursor: self.firstDigit, end: self.digitsEnd }
    }
}

extend[U] SignificantDigits[U] : Iterator
where U: AsciiUnit
{
    type Item = u8;

    fun next(&mut self) ?u8 {
        while self.cursor < self.end {
            let byte = self.input[self.cursor].asciiCode();
            self.cursor += 1;
            if isDigit(byte) { return ?(byte as u8); }
        }
        null
    }
}

fun isDigit(byte: u32) bool {
    byte >= ('0' as u32) and byte <= ('9' as u32)
}

// Saturation beyond twice the largest slice length cannot affect a finite
// result, even after accounting for all fractional and significant digits.
fun appendExponent(value: i128, digit: u32) i128 {
    let limit = usize::MAX as i128 * 2;
    cmp::min(value * 10 + (digit - ('0' as u32)) as i128, limit)
}

pub(root) fun parse[U](input: &[U]) Error!Parsed
where U: AsciiUnit
{
    if input.len() == 0 { return .Empty!; }
    let negative = input[0].asciiCode() == ('-' as u32);
    if input[0].asciiCode() == ('+' as u32) { return .InvalidSign!; }
    let start: usize = if negative { 1 } else { 0 };
    if start == input.len() { return .InvalidDigit!; }

    let mut index = start;
    let mut fractionDigits: usize = 0;
    let mut firstDigit = input.len();
    let mut significantDigits: usize = 0;
    let mut sawDigit = false;
    let mut sawDot = false;
    while index < input.len() {
        let byte = input[index].asciiCode();
        if isDigit(byte) {
            sawDigit = true;
            if sawDot { fractionDigits += 1; }
            if firstDigit == input.len() and byte != ('0' as u32) { firstDigit = index; }
            if firstDigit != input.len() { significantDigits += 1; }
            index += 1;
        } else if byte == ('.' as u32) and not sawDot {
            sawDot = true;
            index += 1;
        } else {
            break;
        }
    }
    if not sawDigit or (sawDot and input[index - 1].asciiCode() == ('.' as u32)) { return .InvalidDigit!; }
    let digitsEnd = index;

    let mut exponent: i128 = 0;
    let mut exponentNegative = false;
    if index < input.len() and (input[index].asciiCode() == ('e' as u32) or input[index].asciiCode() == ('E' as u32)) {
        index += 1;
        if index < input.len() and (input[index].asciiCode() == ('-' as u32) or input[index].asciiCode() == ('+' as u32)) {
            exponentNegative = input[index].asciiCode() == ('-' as u32);
            index += 1;
        }
        let exponentStart = index;
        while index < input.len() and isDigit(input[index].asciiCode()) {
            exponent = appendExponent(exponent, input[index].asciiCode());
            index += 1;
        }
        if exponentStart == index { return .InvalidDigit!; }
    }
    if index != input.len() { return .InvalidDigit!; }
    if exponentNegative { exponent = -exponent; }
    let adjusted = exponent - fractionDigits as i128;
    !.{ negative, zero: firstDigit == input.len(), digitsEnd, firstDigit, significantDigits, exponent10: adjusted }
}

pub(root) fun compareParsed[U](input: &[U], parsed: Parsed, exact: &Exact) i32
where U: AsciiUnit
{
    if parsed.zero { return if exact.isZero() { 0 } else { -1 }; }
    let leftOrder = parsed.order();
    let rightOrder = exact.len() as i128 + exact.exponent10() as i128;
    if leftOrder < rightOrder { return -1; }
    if leftOrder > rightOrder { return 1; }

    let mut digits = parsed.digits(input);
    for &right in exact.asSlice() {
        let left = match digits.next() { ?digit => digit, null => b'0' };
        if left < right { return -1; }
        if left > right { return 1; }
    }
    // An omitted suffix represents zeros, never lost significant input digits.
    for left in digits {
        if left != b'0' { return 1; }
    }
    0
}
