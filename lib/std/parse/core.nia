using pkg::slice;

pub enum Error: i32 {
    Empty = 1,
    InvalidDigit = 2,
    InvalidSign = 3,
    Overflow = 4,
    InvalidRadix = 5,
    InvalidValue = 6,
    _,
}

pub trait From[Input] {
    type Error;

    fn from(input: Input) [Self as From[Input]]::Error!Self;
}

pub trait FromRadix[Input] {
    type Error;

    fn fromRadix(input: Input, radix: u32) [Self as FromRadix[Input]]::Error!Self;
}

struct ParsedInteger {
    negative: bool,
    abs: u128,
}

struct ParsedSign {
    negative: bool,
    digitsStart: usize,
}

trait AsciiUnit : Sized {
    fn asciiCode(self) u32;
}

extend[Unit] [Unit]
where Unit: Sized
{
    pub fn parse[T](&self) [T as From[&[Unit]]]::Error!T
    where T: From[&[Unit]]
    {
        [T]::from(self)
    }

    pub fn parseRadix[T](&self, radix: u32) [T as FromRadix[&[Unit]]]::Error!T
    where T: FromRadix[&[Unit]]
    {
        [T]::fromRadix(self, radix)
    }
}

extend char : AsciiUnit {
    fn asciiCode(self) u32 {
        self as u32
    }
}

extend u8 : AsciiUnit {
    fn asciiCode(self) u32 {
        self as u32
    }
}

fn asciiIs[U](unit: U, ch: char) bool
where U: AsciiUnit
{
    unit.asciiCode() == (ch as u32)
}

fn digitValue[U](unit: U) ?u32
where U: AsciiUnit
{
    let code = unit.asciiCode();
    if code >= ('0' as u32) and code <= ('9' as u32) {
        ?(code - ('0' as u32))
    } else if code >= ('a' as u32) and code <= ('z' as u32) {
        ?((code - ('a' as u32)) + 10)
    } else if code >= ('A' as u32) and code <= ('Z' as u32) {
        ?((code - ('A' as u32)) + 10)
    } else {
        null
    }
}

fn isHexPrefix[U](unit: U) bool
where U: AsciiUnit
{
    asciiIs[U](unit, 'x') or asciiIs[U](unit, 'X')
}

fn isBinaryPrefix[U](unit: U) bool
where U: AsciiUnit
{
    asciiIs[U](unit, 'b') or asciiIs[U](unit, 'B')
}

fn isOctalPrefix[U](unit: U) bool
where U: AsciiUnit
{
    asciiIs[U](unit, 'o') or asciiIs[U](unit, 'O')
}

fn asciiEquals[U](input: &[U], text: &[char]) bool
where U: AsciiUnit
{
    if input.len() != text.len() {
        return false;
    }
    let mut index = 0;
    for &unit in input {
        if not asciiIs[U](unit, text[index]) {
            return false;
        }
        index += 1;
    }
    true
}

fn parseSign[U](input: &[U], allowSign: bool) Error!ParsedSign
where U: AsciiUnit
{
    if input.len() == 0 {
        return Error::Empty!;
    }

    let first = input[0];
    if asciiIs[U](first, '-') or asciiIs[U](first, '+') {
        if not allowSign {
            return Error::InvalidSign!;
        }
        !ParsedSign { negative: asciiIs[U](first, '-'), digitsStart: 1 }
    } else {
        !ParsedSign { negative: false, digitsStart: 0 }
    }
}

fn parseDigits[U](input: &[U], start: usize, radix: u32, negative: bool) Error!ParsedInteger
where U: AsciiUnit
{
    if start == input.len() {
        return Error::InvalidDigit!;
    }
    let mut value: u128 = 0;
    let wideRadix = radix as u128;
    for &unit in &input[start..] {
        let digit = switch digitValue[U](unit) {
            ?digit => { digit },
            null => { return Error::InvalidDigit!; },
        };
        if digit >= radix {
            return Error::InvalidDigit!;
        }
        let wideDigit = digit as u128;
        if value > (u128::MAX - wideDigit) / wideRadix {
            return Error::Overflow!;
        }
        value = value * wideRadix + wideDigit;
    }

    !ParsedInteger { negative, abs: value }
}

fn parseIntegerRadix[U](input: &[U], radix: u32, allowSign: bool) Error!ParsedInteger
where U: AsciiUnit
{
    if radix < 2 or radix > 36 {
        return Error::InvalidRadix!;
    }
    let sign = parseSign[U](input, allowSign).?;
    parseDigits[U](input, sign.digitsStart, radix, sign.negative)
}

fn parseInteger[U](input: &[U], allowSign: bool) Error!ParsedInteger
where U: AsciiUnit
{
    let sign = parseSign[U](input, allowSign).?;
    let mut digitsStart = sign.digitsStart;
    let mut radix: u32 = 10;
    if digitsStart + 1 < input.len() and asciiIs[U](input[digitsStart], '0') {
        let marker = input[digitsStart + 1];
        if isHexPrefix[U](marker) {
            radix = 16;
            digitsStart += 2;
        } else if isBinaryPrefix[U](marker) {
            radix = 2;
            digitsStart += 2;
        } else if isOctalPrefix[U](marker) {
            radix = 8;
            digitsStart += 2;
        }
    }
    parseDigits[U](input, digitsStart, radix, sign.negative)
}

fn parseBool[U](input: &[U]) Error!bool
where U: AsciiUnit
{
    if asciiEquals[U](input, &"true") {
        !true
    } else if asciiEquals[U](input, &"false") {
        !false
    } else if input.len() == 0 {
        Error::Empty!
    } else {
        Error::InvalidValue!
    }
}

fn finishUnsigned(parsed: ParsedInteger, max: u128) Error!u128 {
    if parsed.negative {
        return Error::InvalidSign!;
    }
    if parsed.abs > max {
        return Error::Overflow!;
    }
    !parsed.abs
}

fn finishSigned(parsed: ParsedInteger, min: i128, max: i128) Error!i128 {
    let negativeLimit = ((0 - (min + 1)) as u128) + 1;
    if parsed.negative {
        if parsed.abs > negativeLimit {
            return Error::Overflow!;
        }
        if parsed.abs == negativeLimit {
            return !min;
        }
        return !(0 - parsed.abs as i128);
    }
    if parsed.abs > max as u128 {
        return Error::Overflow!;
    }
    !(parsed.abs as i128)
}

fn parseUnsignedChars(text: &[char], max: u128) Error!u128 {
    finishUnsigned(parseInteger[char](text, false).?, max)
}

fn parseUnsignedRadixChars(text: &[char], radix: u32, max: u128) Error!u128 {
    finishUnsigned(parseIntegerRadix[char](text, radix, false).?, max)
}

fn parseSignedChars(text: &[char], min: i128, max: i128) Error!i128 {
    finishSigned(parseInteger[char](text, true).?, min, max)
}

fn parseSignedRadixChars(text: &[char], radix: u32, min: i128, max: i128) Error!i128 {
    finishSigned(parseIntegerRadix[char](text, radix, true).?, min, max)
}

fn parseUnsignedBytes(bytes: &[u8], max: u128) Error!u128 {
    finishUnsigned(parseInteger[u8](bytes, false).?, max)
}

fn parseUnsignedRadixBytes(bytes: &[u8], radix: u32, max: u128) Error!u128 {
    finishUnsigned(parseIntegerRadix[u8](bytes, radix, false).?, max)
}

fn parseSignedBytes(bytes: &[u8], min: i128, max: i128) Error!i128 {
    finishSigned(parseInteger[u8](bytes, true).?, min, max)
}

fn parseSignedRadixBytes(bytes: &[u8], radix: u32, min: i128, max: i128) Error!i128 {
    finishSigned(parseIntegerRadix[u8](bytes, radix, true).?, min, max)
}

extend i8 : From[&[char]] {
    type Error = Error;

    fn from(text: &[char]) Error!i8 {
        !(parseSignedChars(text, i8::MIN as i128, i8::MAX as i128).? as i8)
    }
}

extend i8 : FromRadix[&[char]] {
    type Error = Error;

    fn fromRadix(text: &[char], radix: u32) Error!i8 {
        !(parseSignedRadixChars(text, radix, i8::MIN as i128, i8::MAX as i128).? as i8)
    }
}

extend i8 : From[&[u8]] {
    type Error = Error;

    fn from(bytes: &[u8]) Error!i8 {
        !(parseSignedBytes(bytes, i8::MIN as i128, i8::MAX as i128).? as i8)
    }
}

extend i8 : FromRadix[&[u8]] {
    type Error = Error;

    fn fromRadix(bytes: &[u8], radix: u32) Error!i8 {
        !(parseSignedRadixBytes(bytes, radix, i8::MIN as i128, i8::MAX as i128).? as i8)
    }
}

