// Accepts ASCII decimal forms `[-]digits[.digits][e[+-]digits]` and
// `[-].digits`. Whitespace, a leading plus, and non-finite spellings are invalid.

module syntax;

using root::parse::float::syntax;
using root::parse::ascii::AsciiUnit;
using root::cmp;
using root::iter;
using root::math::float as ieee;
using root::math::float::decimal;
using super::core::{Error, From};

fun roundedBits64[U](input: &[U], parsed: syntax::Parsed) u64
where U: AsciiUnit
{
    let maxFinite: u64 = 0x7fefffffffffffff;
    let mut low: u64 = 0;
    let mut high: u64 = maxFinite + 1;
    while low < high {
        let middle = low + (high - low) / 2;
        let exact = decimal::midpoint64(middle);
        let comparison = syntax::compareParsed(input, parsed, exact);
        if comparison < 0 or (comparison == 0 and (middle & 1) == 0) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}

fun roundedBits32[U](input: &[U], parsed: syntax::Parsed) u32
where U: AsciiUnit
{
    let maxFinite: u64 = 0x7f7fffff;
    let mut low: u64 = 0;
    let mut high: u64 = maxFinite + 1;
    while low < high {
        let middle = low + (high - low) / 2;
        let exact = decimal::midpoint32(middle as u32);
        let comparison = syntax::compareParsed(input, parsed, exact);
        if comparison < 0 or (comparison == 0 and (middle & 1) == 0) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low as u32
}

fun powerOfTen(exponent: i32) f64 {
    let mut power = if exponent < 0 { -exponent } else { exponent } as u32;
    let mut factor: f64 = 10.0;
    let mut result: f64 = 1.0;
    while power != 0 {
        if (power & 1u32) != 0 { result *= factor; }
        power >>= 1;
        if power != 0 { factor *= factor; }
    }
    if exponent < 0 { 1.0 / result } else { result }
}

fun approximateMagnitude[U](input: &[U], parsed: syntax::Parsed) ?f64
where U: AsciiUnit
{
    // Nineteen digits fit in u64; exact interval checks account for the discarded tail.
    let digitCount = cmp::min(parsed.significantDigits, 19usize);
    let significand = parsed.digits(input).take(digitCount).fold(
        0u64,
        \value, digit -> value * 10 + (digit - b'0') as u64,
    );
    let exponent = parsed.exponent10 + (parsed.significantDigits - digitCount) as i128;
    if exponent < -308 or exponent > 308 { return null; }
    let value = significand as f64 * powerOfTen(exponent as i32);
    if not ieee::isFinite64(value) or value == 0.0 { return null; }
    ?value
}

// Approximation only supplies a candidate. Exact midpoint checks decide whether
// it is correct; all candidates outside that rounding interval use the exact search.
fun tryRoundedBits64[U](input: &[U], parsed: syntax::Parsed) ?u64
where U: AsciiUnit
{
    let value = match approximateMagnitude(input, parsed) { ?value => value, null => return null };
    let bits = ieee::toBits64(value);
    if bits > 0x7fefffffffffffff { return null; }
    let even = (bits & 1u64) == 0;
    if bits != 0 {
        let lower = decimal::midpoint64(bits - 1);
        let comparison = syntax::compareParsed(input, parsed, lower);
        if comparison < 0 or (comparison == 0 and not even) { return null; }
    }
    let upper = decimal::midpoint64(bits);
    let comparison = syntax::compareParsed(input, parsed, upper);
    if comparison > 0 or (comparison == 0 and not even) { return null; }
    ?bits
}

fun tryRoundedBits32[U](input: &[U], parsed: syntax::Parsed) ?u32
where U: AsciiUnit
{
    let value = match approximateMagnitude(input, parsed) { ?value => value, null => return null };
    let bits = ieee::toBits32(value as f32);
    if bits > 0x7f7fffff { return null; }
    let even = (bits & 1u32) == 0;
    if bits != 0 {
        let lower = decimal::midpoint32(bits - 1);
        let comparison = syntax::compareParsed(input, parsed, lower);
        if comparison < 0 or (comparison == 0 and not even) { return null; }
    }
    let upper = decimal::midpoint32(bits);
    let comparison = syntax::compareParsed(input, parsed, upper);
    if comparison > 0 or (comparison == 0 and not even) { return null; }
    ?bits
}

fun parseFloat64[U](input: &[U]) Error!f64
where U: AsciiUnit
{
    let parsed = syntax::parse(input).?;
    let order = parsed.order();
    let magnitude = if parsed.zero or order < -323 {
        0u64
    } else if order > 309 {
        return .Overflow!;
    } else {
        match tryRoundedBits64(input, parsed) {
            ?bits => bits,
            null => roundedBits64(input, parsed),
        }
    };
    if magnitude > 0x7fefffffffffffff { return .Overflow!; }
    let sign: u64 = if parsed.negative { 0x8000000000000000u64 } else { 0u64 };
    !ieee::fromBits64(sign | magnitude)
}

fun parseFloat32[U](input: &[U]) Error!f32
where U: AsciiUnit
{
    let parsed = syntax::parse(input).?;
    let order = parsed.order();
    let magnitude = if parsed.zero or order < -45 {
        0u32
    } else if order > 39 {
        return .Overflow!;
    } else {
        match tryRoundedBits32(input, parsed) {
            ?bits => bits,
            null => roundedBits32(input, parsed),
        }
    };
    if magnitude > 0x7f7fffff { return .Overflow!; }
    let sign: u32 = if parsed.negative { 0x80000000u32 } else { 0u32 };
    !ieee::fromBits32(sign | magnitude)
}

// Concrete byte entry points share the same conversion used by text parsing.
pub fun parse64(input: &[u8]) Error!f64 { parseFloat64(input) }
pub fun parse32(input: &[u8]) Error!f32 { parseFloat32(input) }

extend f32 : From[&[u8]] {
    type Error = Error;

    fun from(input: &[u8]) Error!f32 { parseFloat32(input) }
}

extend f32 : From[&[char]] {
    type Error = Error;

    fun from(input: &[char]) Error!f32 { parseFloat32(input) }
}

extend f64 : From[&[u8]] {
    type Error = Error;

    fun from(input: &[u8]) Error!f64 { parseFloat64(input) }
}

extend f64 : From[&[char]] {
    type Error = Error;

    fun from(input: &[char]) Error!f64 { parseFloat64(input) }
}
