// Correctly rounded decimal-to-binary conversion for f32 and f64, from bytes
// or Unicode text through the same scanner. An f64 approximation proposes a
// result; exact comparisons with rounding midpoints decide it.

module syntax;

using root::cmp;
using root::iter;
using root::math::float::BinaryFormat;
using root::math::float::decimal;
using root::parse::ascii::AsciiUnit;
using root::parse::float::syntax;
using super::core::{Error, From};

// Binary search for the smallest magnitude whose upper midpoint the input
// does not exceed; a tie belongs to the even magnitude.
fun roundedBits[F, U](input: &[U], parsed: syntax::Parsed) u64
where F: BinaryFormat, U: AsciiUnit
{
    let mut low: u64 = 0;
    let mut high = [F]::maxFiniteBits() + 1;
    while low < high {
        let middle = low + (high - low) / 2;
        let roundsDown = match syntax::compareParsed(input, parsed, decimal::midpoint[F](middle)) {
            .Less => true,
            .Equal => (middle & 1) == 0,
            .Greater => false,
        };
        if roundsDown {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}

fun powerOfTen(exponent: i32) f64 {
    let mut power = if exponent < 0 { -exponent } else { exponent } as u32;
    let mut factor: f64 = 10.0;
    let mut result: f64 = 1.0;
    while power != 0 {
        if (power & 1u32) != 0 {
            result *= factor;
        }
        power >>= 1;
        if power != 0 {
            factor *= factor;
        }
    }
    if exponent < 0 { 1.0 / result } else { result }
}

fun approximateMagnitude[U](input: &[U], parsed: syntax::Parsed) ?f64
where U: AsciiUnit
{
    // Nineteen digits fit in u64; the exact checks account for the rest.
    let digitCount = cmp::min(parsed.significantDigits, 19usize);
    let significand = parsed.digits(input).take(digitCount).fold(
        0u64,
        \value, digit -> value * 10 + (digit - b'0') as u64,
    );
    let exponent = parsed.exponent10 + (parsed.significantDigits - digitCount) as i128;
    if exponent < -308 or exponent > 308 {
        return null;
    }
    let value = significand as f64 * powerOfTen(exponent as i32);
    if value.isFinite() and value != 0.0 { ?value } else { null }
}

// The approximation is only a candidate: it is accepted when the input lies in
// its rounding interval, and otherwise the exact search decides.
fun approximateBits[F, U](input: &[U], parsed: syntax::Parsed) ?u64
where F: BinaryFormat, U: AsciiUnit
{
    let bits = [F]::fromApproximation(approximateMagnitude(input, parsed).?).rawBits();
    if bits > [F]::maxFiniteBits() {
        return null;
    }
    let interval = decimal::interval[F](bits);
    if interval.contains(\[input, parsed] bound -> syntax::compareParsed(input, parsed, bound)) {
        ?bits
    } else {
        null
    }
}

fun parseFloat[F, U](input: &[U]) Error!F
where F: BinaryFormat, U: AsciiUnit
{
    let parsed = syntax::parse(input).?;
    let order = parsed.order();
    let magnitude = if parsed.zero or order < [F as BinaryFormat]::minDecimalOrder as i128 {
        0u64
    } else if order > [F as BinaryFormat]::maxDecimalOrder as i128 {
        return .Overflow!;
    } else if approximateBits[F, U](input, parsed) is ?bits {
        bits
    } else {
        roundedBits[F, U](input, parsed)
    };
    if magnitude > [F]::maxFiniteBits() {
        return .Overflow!;
    }
    let sign = if parsed.negative { [F]::signMask() } else { 0u64 };
    ![F]::fromRawBits(sign | magnitude)
}

extend f32 : From[&[u8]] {
    type Error = Error;

    fun from(input: &[u8]) Error!f32 {
        parseFloat(input)
    }
}

extend f32 : From[&[char]] {
    type Error = Error;

    fun from(input: &[char]) Error!f32 {
        parseFloat(input)
    }
}

extend f64 : From[&[u8]] {
    type Error = Error;

    fun from(input: &[u8]) Error!f64 {
        parseFloat(input)
    }
}

extend f64 : From[&[char]] {
    type Error = Error;

    fun from(input: &[char]) Error!f64 {
        parseFloat(input)
    }
}
