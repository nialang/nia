// Correctly rounded decimal-to-binary conversion for f32 and f64, from bytes
// or Unicode text through the same scanner. An f64 approximation starts the
// search; exact comparisons with rounding midpoints decide the result.

module syntax;

using root::cmp;
using root::iter;
using root::math::float::BinaryFormat;
using root::math::float::decimal;
using root::parse::ascii::AsciiUnit;
using root::parse::float::syntax;
using super::core::{Error, From};

// Correct rounding picks the smallest magnitude whose rounding interval does
// not lie below the input. The approximation starts the walk one or a few
// steps from it, so only that many intervals are written out exactly.
fun roundedBits[F, U](input: &[U], parsed: syntax::Parsed) u64
where F: BinaryFormat, U: AsciiUnit
{
    let maxFinite = [F]::maxFiniteBits();
    let mut bits = cmp::min([F]::fromApproximation(approximateMagnitude(input, parsed)).rawBits(), maxFinite);
    loop {
        match decimal::interval[F](bits).locate(\[input, parsed] bound -> syntax::compareParsed(input, parsed, bound)) {
            .Equal => return bits,
            // A positive input never lies below the interval of zero.
            .Less => bits -= 1,
            .Greater => {
                // Above the largest finite value's interval the input overflows.
                if bits == maxFinite {
                    return maxFinite + 1;
                }
                bits += 1;
            },
        }
    }
}

// Powers of ten up to 10^22 are exact in f64. Larger magnitudes multiply
// exact factors of 10^22, so each step adds at most half an ulp of error
// instead of the error that repeated squaring compounds.
const exactPowers: [f64; 23] = [
    1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22,
];

fun scaleByPowerOfTen(value: f64, exponent: i32) f64 {
    let mut result = value;
    let mut remaining = if exponent < 0 { -exponent } else { exponent } as usize;
    while remaining != 0 {
        let step = cmp::min(remaining, exactPowers.len() - 1);
        if exponent < 0 {
            result /= exactPowers[step];
        } else {
            result *= exactPowers[step];
        }
        remaining -= step;
    }
    result
}

// The leading nineteen digits, which fit in u64, scaled by their power of ten.
// Only its closeness matters: it may underflow to zero or overflow to
// infinity, and the exact walk corrects any error.
fun approximateMagnitude[U](input: &[U], parsed: syntax::Parsed) f64
where U: AsciiUnit
{
    let digitCount = cmp::min(parsed.significantDigits, 19usize);
    let significand = parsed.digits(input).take(digitCount).fold(
        0u64,
        \value, digit -> value * 10 + (digit - b'0') as u64,
    );
    let exponent = parsed.exponent10 + (parsed.significantDigits - digitCount) as i128;
    scaleByPowerOfTen(significand as f64, exponent as i32)
}

fun parseFloat[F, U](input: &[U]) Error!F
where F: BinaryFormat, U: AsciiUnit
{
    let parsed = syntax::parse(input).?;
    let order = parsed.order();
    let magnitude = if parsed.zero or order < [F as BinaryFormat]::minDecimalOrder as i128 {
        0u64
    } else if order > [F as BinaryFormat]::maxDecimalOrder as i128 {
        return .Overflow!;
    } else {
        roundedBits[F, U](input, parsed)
    };
    if magnitude > [F]::maxFiniteBits() {
        return .Overflow!;
    }
    let sign = if parsed.negative { [F]::signMask() } else { 0u64 };
    ![F]::fromRawBits(sign | magnitude)
}

extend f32 : From[&[u8]] {
    type Error = Error;

    fun from(input: &[u8]) Error!f32 {
        parseFloat(input)
    }
}

extend f32 : From[&[char]] {
    type Error = Error;

    fun from(input: &[char]) Error!f32 {
        parseFloat(input)
    }
}

extend f64 : From[&[u8]] {
    type Error = Error;

    fun from(input: &[u8]) Error!f64 {
        parseFloat(input)
    }
}

extend f64 : From[&[char]] {
    type Error = Error;

    fun from(input: &[char]) Error!f64 {
        parseFloat(input)
    }
}
