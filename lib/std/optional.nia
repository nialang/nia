// Optional value queries and transformations.
//
// Nia spells the two cases `?value` and `null`, so the query vocabulary is
// `isPresent`/`isNull` rather than names borrowed from another sum type. Use an
// `if value is ...` pattern when the payload is needed immediately; these
// methods are intended for boolean composition and callback pipelines.

extend[Value] ?Value {
    pub fn isPresent(&self) bool {
        let value = self.*;
        if value is ?_ { true } else { false }
    }

    pub fn isNull(&self) bool {
        let value = self.*;
        if value is null { true } else { false }
    }

    // Transform a present payload and leave the null case unchanged.
    pub fn map[Mapped](self, mapper: &Fn(Value) Mapped) ?Mapped {
        if self is ?value {
            ?mapper(value)
        } else {
            null
        }
    }

    // Continue a present value with another optional-producing operation.
    pub fn andThen[Mapped](self, next: &Fn(Value) ?Mapped) ?Mapped {
        if self is ?value {
            next(value)
        } else {
            null
        }
    }
}
