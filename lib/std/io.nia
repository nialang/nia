import std.fs;

pub enum BufferError: i32 {
    EndOfStream = 1,
    ShortWrite = 2,
    NoSpace = 3,
    _,
}

pub trait Writer {
    type Error;

    fn short_write(&self) Error;

    fn write(&mut self, bytes: &[u8]) Error!usize;

    fn flush(&mut self) Error!void {
        !{}
    }

    fn write_byte(&mut self, byte: u8) Error!void {
        let bytes: [1]u8 = [byte];
        self.write_all(&bytes[..])
    }

    fn write_all(&mut self, bytes: &[u8]) Error!void {
        var written = 0usize;
        while written < bytes.len() {
            let chunk = & bytes[written..];
            let n = self.write(chunk).?;
            if n == 0 {
                return self.short_write()!;
            }
            written += n;
        }
        !{}
    }
}

pub trait Reader {
    type Error;

    fn end_of_stream(&self) Error;

    fn read(&mut self, bytes: &mut [u8]) Error!usize;

    fn read_exact(&mut self, bytes: &mut [u8]) Error!void {
        var read = 0usize;
        while read < bytes.len() {
            let chunk = &mut bytes[read..];
            let n = self.read(chunk).?;
            if n == 0 {
                return self.end_of_stream()!;
            }
            read += n;
        }
        !{}
    }
}

pub struct FixedBufferWriter {
    buffer: &mut [u8],
    len: usize,
}

pub struct FixedBufferReader {
    buffer: &[u8],
    cursor: usize,
}

pub struct DiscardingWriter {
    len: usize,
}

pub struct Limit {
    remaining: ?usize,
}

pub struct LimitedReader[R] {
    reader: &mut R,
    limit: Limit,
}

pub struct BufferedReader[R] {
    reader: &mut R,
    buffer: &mut [u8],
    start: usize,
    end: usize,
}

pub struct BufferedWriter[W] {
    writer: &mut W,
    buffer: &mut [u8],
    len: usize,
}

extend FixedBufferWriter {
    pub fn init(buffer: &mut [u8]) FixedBufferWriter {
        { buffer: buffer, len: 0 }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn capacity(&self) usize {
        self.buffer.len()
    }

    pub fn written(&self) &[u8] {
        & self.buffer[0..self.len]
    }
}

extend FixedBufferWriter : Writer {
    type Error = BufferError;

    pub fn short_write(&self) BufferError {
        BufferError::NoSpace
    }

    pub fn write(&mut self, bytes: &[u8]) BufferError!usize {
        let remaining = self.buffer.len() - self.len;
        var count = bytes.len();
        if count > remaining {
            count = remaining;
        }

        var index = 0usize;
        while index < count {
            self.buffer[self.len + index] = bytes[index];
            index += 1;
        }
        self.len += count;
        !count
    }
}

extend FixedBufferReader {
    pub fn init(buffer: &[u8]) FixedBufferReader {
        { buffer: buffer, cursor: 0 }
    }

    pub fn remaining(&self) usize {
        self.buffer.len() - self.cursor
    }
}

extend FixedBufferReader : Reader {
    type Error = BufferError;

    pub fn end_of_stream(&self) BufferError {
        BufferError::EndOfStream
    }

    pub fn read(&mut self, bytes: &mut [u8]) BufferError!usize {
        let remaining = self.buffer.len() - self.cursor;
        var count = bytes.len();
        if count > remaining {
            count = remaining;
        }

        var index = 0usize;
        while index < count {
            bytes[index] = self.buffer[self.cursor + index];
            index += 1;
        }
        self.cursor += count;
        !count
    }
}

extend DiscardingWriter {
    pub fn init() DiscardingWriter {
        { len: 0 }
    }

    pub fn len(&self) usize {
        self.len
    }
}

extend DiscardingWriter : Writer {
    type Error = BufferError;

    pub fn short_write(&self) BufferError {
        _ = self;
        BufferError::ShortWrite
    }

    pub fn write(&mut self, bytes: &[u8]) BufferError!usize {
        self.len += bytes.len();
        !bytes.len()
    }
}

extend[R] BufferedReader[R]
where R: Reader
{
    pub fn init(reader: &mut R, buffer: &mut [u8]) BufferedReader[R] {
        { reader: reader, buffer: buffer, start: 0, end: 0 }
    }

    pub fn len(&self) usize {
        self.end - self.start
    }

    pub fn capacity(&self) usize {
        self.buffer.len()
    }

    pub fn buffered(&self) &[u8] {
        & self.buffer[self.start..self.end]
    }

    pub fn discard_buffered(&mut self) void {
        self.start = 0;
        self.end = 0;
    }

    fn read_buffered(&mut self, bytes: &mut [u8]) usize {
        var count = bytes.len();
        if count > self.len() {
            count = self.len();
        }

        var index = 0usize;
        while index < count {
            bytes[index] = self.buffer[self.start + index];
            index += 1usize;
        }
        self.start += count;
        if self.start == self.end {
            self.discard_buffered();
        }
        count
    }
}

extend[R] BufferedReader[R] : Reader
where R: Reader
{
    type Error = [R as Reader]::Error;

    pub fn end_of_stream(&self) Error {
        self.reader.end_of_stream()
    }

    pub fn read(&mut self, bytes: &mut [u8]) Error!usize {
        if bytes.len() == 0 {
            !0
        } else if self.len() != 0 {
            !self.read_buffered(bytes)
        } else if bytes.len() >= self.buffer.len() {
            self.reader.read(bytes)
        } else {
            self.start = 0;
            self.end = self.reader.read(self.buffer).?;
            if self.end == 0 {
                !0
            } else {
                !self.read_buffered(bytes)
            }
        }
    }
}

extend[W] BufferedWriter[W]
where W: Writer
{
    pub fn init(writer: &mut W, buffer: &mut [u8]) BufferedWriter[W] {
        { writer: writer, buffer: buffer, len: 0 }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn capacity(&self) usize {
        self.buffer.len()
    }

    pub fn buffered(&self) &[u8] {
        & self.buffer[0..self.len]
    }
}

extend[W] BufferedWriter[W] : Writer
where W: Writer
{
    type Error = [W as Writer]::Error;

    pub fn short_write(&self) Error {
        self.writer.short_write()
    }

    pub fn write(&mut self, bytes: &[u8]) Error!usize {
        if bytes.len() == 0 {
            !0
        } else if bytes.len() > self.buffer.len() {
            self.flush().?;
            self.writer.write(bytes)
        } else {
            let available = self.buffer.len() - self.len;
            if bytes.len() > available {
                self.flush().?;
            }

            var index = 0usize;
            while index < bytes.len() {
                self.buffer[self.len + index] = bytes[index];
                index += 1usize;
            }
            self.len += bytes.len();
            !bytes.len()
        }
    }

    pub fn flush(&mut self) Error!void {
        if self.len != 0 {
            self.writer.write_all(& self.buffer[0..self.len]).?;
            self.len = 0;
        }
        self.writer.flush()
    }
}

extend Limit {
    pub fn unlimited() Limit {
        { remaining: null }
    }

    pub fn limited(remaining: usize) Limit {
        { remaining: ?remaining }
    }

    pub fn remaining(&self) ?usize {
        self.remaining
    }
}

extend[R] LimitedReader[R]
where R: Reader
{
    pub fn init(reader: &mut R, limit: Limit) LimitedReader[R] {
        { reader: reader, limit: limit }
    }

    pub fn remaining(&self) ?usize {
        self.limit.remaining()
    }
}

extend[R] LimitedReader[R] : Reader
where R: Reader
{
    type Error = [R as Reader]::Error;

    pub fn end_of_stream(&self) Error {
        self.reader.end_of_stream()
    }

    pub fn read(&mut self, bytes: &mut [u8]) Error!usize {
        switch self.limit.remaining {
            ?remaining => {
                if remaining == 0 {
                    !0
                } else {
                    var count = bytes.len();
                    if count > remaining {
                        count = remaining;
                    }
                    let chunk = &mut bytes[0..count];
                    let n = self.reader.read(chunk).?;
                    switch self.limit.remaining {
                        ?current => self.limit = Limit::limited(current - n),
                        null => {},
                    }
                    !n
                }
            },
            null => self.reader.read(bytes),
        }
    }
}

extend fs::File : Writer {
    type Error = fs::Error;

    pub fn short_write(&self) Error {
        fs::Error::Io
    }

    pub fn write(&mut self, bytes: &[u8]) Error!usize {
        self.write_some(bytes)
    }
}

extend fs::File : Reader {
    type Error = fs::Error;

    pub fn end_of_stream(&self) Error {
        fs::Error::Io
    }

    pub fn read(&mut self, bytes: &mut [u8]) Error!usize {
        self.read_some(bytes)
    }
}
