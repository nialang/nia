// Fallible reader and writer traits plus explicit buffering adapters.
//
// Adapters borrow or own exactly the handle stated by their type and preserve
// partial I/O, buffering, and underlying system failures through typed errors.

pub(root) module buffered;
pub(root) module error;
pub(root) module file_adapter;
pub(root) module fixed_buffer;
pub(root) module limit;
pub(root) module debug;
pub(root) module traits;

using root::io::buffered;
using root::io::error;
using root::io::file_adapter;
using root::io::fixed_buffer;
using root::io::limit;
using root::io::debug;

pub using traits::{BufferError, Reader, Writer};
pub using error::{Error, SystemError};
pub using fixed_buffer::{DiscardingWriter, FixedBufferReader, FixedBufferWriter};
pub using buffered::{BufferedReader, BufferedWriter};
pub using file_adapter::{FileReader, FileWriter};
pub using limit::{Limit, LimitedReader};
pub using debug::{DebugPrintError, debugPrint};
