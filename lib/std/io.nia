import std.os;

pub enum Error: i32 {
    EndOfStream = 1,
    ShortWrite = 2,
    NoSpace = 3,
    _,
}

pub trait Writer {
    type Error;

    fn short_write(&self) [Self as Writer]::Error;

    fn write(&mut self, bytes: &[u8]) [Self as Writer]::Error!usize;

    fn flush(&mut self) [Self as Writer]::Error!void {
        !{}
    }

    fn write_all(&mut self, bytes: &[u8]) [Self as Writer]::Error!void {
        var written = 0usize;
        while written < bytes.len() {
            var chunk = & bytes[written..];
            var n = self.write(chunk).?;
            if n == 0 {
                return self.short_write()!;
            }
            written += n;
        }
        !{}
    }
}

pub trait Reader {
    type Error;

    fn end_of_stream(&self) [Self as Reader]::Error;

    fn read(&mut self, bytes: &mut [u8]) [Self as Reader]::Error!usize;

    fn read_exact(&mut self, bytes: &mut [u8]) [Self as Reader]::Error!void {
        var read = 0usize;
        while read < bytes.len() {
            var chunk = &mut bytes[read..];
            var n = self.read(chunk).?;
            if n == 0 {
                return self.end_of_stream()!;
            }
            read += n;
        }
        !{}
    }
}

pub struct FixedBufferWriter {
    buffer: &mut [u8],
    len: usize,
}

pub struct FixedBufferReader {
    buffer: &[u8],
    cursor: usize,
}

pub struct DiscardingWriter {
    len: usize,
}

pub struct Limit {
    remaining: ?usize,
}

pub struct LimitedReader[R] {
    reader: &mut R,
    limit: Limit,
}

extend FixedBufferWriter {
    pub fn init(buffer: &mut [u8]) FixedBufferWriter {
        { buffer: buffer, len: 0 }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn capacity(&self) usize {
        self.buffer.len()
    }

    pub fn written(&self) &[u8] {
        & self.buffer[0..self.len]
    }
}

extend FixedBufferWriter : Writer {
    type Error = Error;

    pub fn short_write(&self) Error {
        Error::NoSpace
    }

    pub fn write(&mut self, bytes: &[u8]) Error!usize {
        var remaining = self.buffer.len() - self.len;
        var count = bytes.len();
        if count > remaining {
            count = remaining;
        }

        var index = 0usize;
        while index < count {
            self.buffer[self.len + index] = bytes[index];
            index += 1;
        }
        self.len += count;
        !count
    }
}

extend FixedBufferReader {
    pub fn init(buffer: &[u8]) FixedBufferReader {
        { buffer: buffer, cursor: 0 }
    }

    pub fn remaining(&self) usize {
        self.buffer.len() - self.cursor
    }
}

extend FixedBufferReader : Reader {
    type Error = Error;

    pub fn end_of_stream(&self) Error {
        Error::EndOfStream
    }

    pub fn read(&mut self, bytes: &mut [u8]) Error!usize {
        var remaining = self.buffer.len() - self.cursor;
        var count = bytes.len();
        if count > remaining {
            count = remaining;
        }

        var index = 0usize;
        while index < count {
            bytes[index] = self.buffer[self.cursor + index];
            index += 1;
        }
        self.cursor += count;
        !count
    }
}

extend DiscardingWriter {
    pub fn init() DiscardingWriter {
        { len: 0 }
    }

    pub fn len(&self) usize {
        self.len
    }
}

extend DiscardingWriter : Writer {
    type Error = Error;

    pub fn short_write(&self) Error {
        _ = self;
        Error::ShortWrite
    }

    pub fn write(&mut self, bytes: &[u8]) Error!usize {
        self.len += bytes.len();
        !bytes.len()
    }
}

extend Limit {
    pub fn unlimited() Limit {
        { remaining: null }
    }

    pub fn limited(remaining: usize) Limit {
        { remaining: ?remaining }
    }

    pub fn remaining(&self) ?usize {
        self.remaining
    }
}

extend[R] LimitedReader[R]
where R: Reader
{
    pub fn init(reader: &mut R, limit: Limit) LimitedReader[R] {
        { reader: reader, limit: limit }
    }

    pub fn remaining(&self) ?usize {
        self.limit.remaining()
    }
}

extend[R] LimitedReader[R] : Reader
where R: Reader
{
    type Error = [R as Reader]::Error;

    pub fn end_of_stream(&self) [R as Reader]::Error {
        self.reader.end_of_stream()
    }

    pub fn read(&mut self, bytes: &mut [u8]) [R as Reader]::Error!usize {
        switch self.limit.remaining {
            ?remaining => {
                if remaining == 0 {
                    !0
                } else {
                    var count = bytes.len();
                    if count > remaining {
                        count = remaining;
                    }
                    var chunk = &mut bytes[0..count];
                    var n = self.reader.read(chunk).?;
                    switch self.limit.remaining {
                        ?current => self.limit = Limit::limited(current - n),
                        null => {},
                    }
                    !n
                }
            },
            null => self.reader.read(bytes),
        }
    }
}

extend os::File : Writer {
    type Error = os::Error;

    pub fn short_write(&self) os::Error {
        os::Error::Io
    }

    pub fn write(&mut self, bytes: &[u8]) os::Error!usize {
        self.write_some(bytes)
    }
}

extend os::File : Reader {
    type Error = os::Error;

    pub fn end_of_stream(&self) os::Error {
        os::Error::Io
    }

    pub fn read(&mut self, bytes: &mut [u8]) os::Error!usize {
        self.read_some(bytes)
    }
}
