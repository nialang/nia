// Transformations for Nia error unions (`Failure!Value`).
//
// These are result-like operations on the language's native error-union
// representation; no wrapper type is introduced.

extend[Value, Source] Source!Value {
    pub fun isSuccess(&self) bool {
        let result = self.*;
        if result is !_ { true } else { false }
    }

    pub fun isError(&self) bool {
        let result = self.*;
        if result is _! { true } else { false }
    }

    pub fun map[Mapped, Mapper](self, mapper: Mapper) Source!Mapped
    where Mapper: Fun(Value) Mapped
    {
        match self {
            !value => !mapper(value),
            error! => error!,
        }
    }

    pub fun andThen[Mapped, Next](self, next: Next) Source!Mapped
    where Next: Fun(Value) Source!Mapped
    {
        match self {
            !value => next(value),
            error! => error!,
        }
    }

    // Observe a failure without changing the result or its error type.
    // The callback is borrowed, synchronous, and runs only on the error arm.
    pub fun inspectError(self, inspector: &Fun(Source) ()) Source!Value {
        match self {
            !value => !value,
            error! => {
                inspector(error);
                error!
            },
        }
    }
}

extend[Value, Source, Target] Source!Value {
    pub fun mapError(self, mapper: &Fun(Source) Target) Target!Value {
        match self {
            !value => !value,
            error! => mapper(error)!,
        }
    }

    pub fun orElse(self, fallback: &Fun(Source) Target!Value) Target!Value {
        match self {
            !value => !value,
            error! => fallback(error),
        }
    }
}
