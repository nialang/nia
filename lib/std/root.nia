// Nia standard library root facade.
//
// Common value types and entry points are re-exported here for concise
// `std::name` paths. Domain-specific APIs remain under their modules.
//
// Public submodule facades re-export supported APIs. Implementation namespaces
// stay package-private; selected provider edges are published only for the
// facade types that need them. `os` deliberately exposes its native platform
// interfaces. Importing a facade does not itself select every provider.
// Callback parameters are borrowed for the
// duration of a call unless an API explicitly returns an owner such as
// `mem::CallableAllocation`.

pub module atomic;
pub module builtin;
pub module build;
pub module cmp;
pub module checksum;
pub module collections;
pub module cpu;
pub module crypto;
pub module cstring;
pub module error;
pub module fmt;
pub module fs;
pub module hash;
pub module io;
pub module iter;
pub module math;
pub module mem;
pub module os;
pub module option;
pub module parse;
pub module process;
pub module result;
pub module slice;
pub module source;
pub module string;
pub module test;
pub module time;
pub module unicode;

pub using atomic::Atomic;
pub using collections::{ArrayList, HashMap, HashMapInitError, HashSet, TreeMap, TreeSet};
pub using cstring::{CString, CStringBuildError, CStringError, CStringView};
pub using fs::{Path, PathView};
pub using source::{SourceLocation, callerLocation};
pub using string::{String, TextError, TextFormatError};

// Root collection types are re-exported values, while their implementations
// remain split across provider modules. Re-export those providers explicitly
// so methods such as `HashMap::deinit` remain available through `using std`.
pub using collections::array_list::list as array_list_provider;
pub using collections::hash_map::map as hash_map_map_provider;
pub using collections::hash_map::storage as hash_map_storage_provider;
pub using collections::hash_set as hash_set_provider;
pub using collections::tree_map::map as tree_map_map_provider;
pub using collections::tree_map::storage as tree_map_storage_provider;
pub using collections::tree_set as tree_set_provider;
pub using fmt::float as float_format_provider;

using root::iter::range;
using root::hash;
