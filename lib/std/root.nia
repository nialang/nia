// Nia standard library root facade.
//
// Common value types and entry points are re-exported here for concise
// `std::name` paths. Domain-specific APIs remain under their modules.
//
// Public submodule facades re-export supported APIs. Providers and internal
// implementations stay package-private; `os` deliberately exposes its native
// platform interfaces. Importing a facade does not itself select every
// provider. Callback parameters are borrowed for the
// duration of a call unless an API explicitly returns an owner such as
// `mem::CallableAllocation`.

pub module atomic;
pub module builtin;
pub module build;
pub module cmp;
pub module checksum;
pub module collections;
pub module crypto;
pub module cstring;
pub module error;
pub module fmt;
pub module fs;
pub module hash;
pub module io;
pub module iter;
pub module math;
pub module mem;
pub module os;
pub module option;
pub module parse;
pub module process;
pub module result;
pub module slice;
pub module source;
pub module string;
pub module test;
pub module unicode;

pub using atomic::Atomic;
pub using collections::{ArrayList, HashMap, HashMapInitError, HashSet, TreeMap, TreeSet};
pub using cstring::{CString, CStringBuildError, CStringError, CStringView};
pub using fs::{Path, PathView};
pub using source::{SourceLocation, callerLocation};
pub using string::{String, TextError, TextFormatError};

using root::iter::range;
using root::hash;
