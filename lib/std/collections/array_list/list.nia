// Growable-array views, element operations, and borrowed iteration.
// Storage ownership, capacity changes, and transfers live in `storage`.

using root::mem;
using root::option;
using root::slice;
using super::storage;

pub struct ArrayList[T]
where T: Sized
{
    items: &mut [T],
    capacity: usize,
    storageBlock: ?mem::Block,
    replacementBlock: ?mem::Block,
    aliasBlock: ?mem::Block,
}

extend[T] ArrayList[T]
where T: Sized
{
    pub fun len(&self) usize {
        self.items.len()
    }

    pub fun capacity(&self) usize {
        self.capacity
    }

    pub fun isEmpty(&self) bool {
        self.len() == 0
    }

    pub fun asSlice(&self) &[T] {
        &self.items[0..self.len()]
    }

    pub fun asMutSlice(&mut self) &mut [T] {
        &mut self.items[0..self.len()]
    }

    pub fun iter(&self) slice::SliceIter[T] {
        self.asSlice().iter()
    }

    pub fun iterMut(&mut self) slice::SliceIterMut[T] {
        self.asMutSlice().iterMut()
    }

    pub fun get(&self, index: usize) ?&T {
        self.asSlice().get(index)
    }

    pub fun getMut(&mut self, index: usize) ?&mut T {
        self.asMutSlice().getMut(index)
    }

    pub fun first(&self) ?&T {
        self.get(0)
    }

    pub fun firstMut(&mut self) ?&mut T {
        self.getMut(0)
    }

    pub fun last(&self) ?&T {
        self.asSlice().last()
    }

    pub fun lastMut(&mut self) ?&mut T {
        self.asMutSlice().lastMut()
    }

    pub fun clear(&mut self) () {
        let mut ptr = self.items.ptrMut();
        self.items = &mut ptr[0..0];
    }

    pub fun push(&mut self, allocator: &mut mem::Allocator, value: T) mem::Error!() {
        let slot = self.addOneUninitialized(allocator).?;
        slot.* = value;
        !()
    }

    pub fun pop(&mut self) ?T {
        let len = self.len();
        if len == 0 {
            null
        } else {
            let nextLen = len - 1;
            let value = self.items[nextLen];
            let mut ptr = self.items.ptrMut();
            self.items = &mut ptr[0..nextLen];
            ?value
        }
    }

    pub fun swapRemove(&mut self, index: usize) ?T {
        let len = self.len();
        if index >= len {
            null
        } else {
            let lastIndex = len - 1;
            let value = self.items[index];
            if index != lastIndex {
                self.items[index] = self.items[lastIndex];
            }
            let mut ptr = self.items.ptrMut();
            self.items = &mut ptr[0..lastIndex];
            ?value
        }
    }

    pub fun orderedRemove(&mut self, index: usize) ?T {
        let len = self.len();
        if index >= len {
            null
        } else {
            let value = self.items[index];
            let newLen = len - 1;
            let mut items = self.allocatedItems();
            if index < newLen {
                _ = (&mut items[index..newLen]).copyFrom(&items[(index + 1)..len]);
            }
            self.items = &mut items[0..newLen];
            ?value
        }
    }

    pub fun truncate(&mut self, newLen: usize) () {
        if newLen < self.len() {
            let mut ptr = self.items.ptrMut();
            self.items = &mut ptr[0..newLen];
        }
    }

    pub fun removeRange(&mut self, start: usize, count: usize) mem::Error!() {
        let len = self.len();
        if start > len {
            return .Invalid!;
        }
        let end = start.checkedAdd(count)
            .okOr(mem::Error::Invalid).?;
        if end > len {
            return .Invalid!;
        }
        if count == 0 {
            return !();
        }

        let mut items = self.allocatedItems();
        if end < len {
            _ = (&mut items[start..(len - count)]).copyFrom(&items[end..len]);
        }
        self.items = &mut items[0..(len - count)];
        !()
    }

    pub fun insert(&mut self, allocator: &mut mem::Allocator, index: usize, value: T) mem::Error!() {
        let mut slots = self.addManyAtUninitialized(allocator, index, 1).?;
        slots[0] = value;
        !()
    }

    pub fun insertSlice(&mut self, allocator: &mut mem::Allocator, index: usize, values: &[T]) mem::Error!() {
        self.freePendingItems(allocator).?;
        if index > self.len() {
            return .Invalid!;
        }
        self.withStableSlice(allocator, values,
            \[index] list: &mut ArrayList[T], allocator: &mut mem::Allocator, stable: &[T]
                -> list.insertStableSlice(allocator, index, stable))
    }

    pub fun replaceRange(
        &mut self,
        allocator: &mut mem::Allocator,
        start: usize,
        count: usize,
        values: &[T],
    ) mem::Error!() {
        self.freePendingItems(allocator).?;
        if start > self.len() {
            return .Invalid!;
        }
        let end = start.checkedAdd(count)
            .okOr(mem::Error::Invalid).?;
        if end > self.len() {
            return .Invalid!;
        }

        self.withStableSlice(allocator, values,
            \[start, count] list: &mut ArrayList[T], allocator: &mut mem::Allocator, stable: &[T]
                -> list.replaceRangeStable(allocator, start, count, stable))
    }

    fun insertStableSlice(&mut self, allocator: &mut mem::Allocator, index: usize, values: &[T]) mem::Error!() {
        let mut slots = self.addManyAtUninitialized(allocator, index, values.len()).?;
        _ = slots.copyFrom(values);
        !()
    }

    fun replaceRangeStable(
        &mut self,
        allocator: &mut mem::Allocator,
        start: usize,
        count: usize,
        values: &[T],
    ) mem::Error!() {
        let len = self.len();
        let replacementLen = values.len();
        let end = start + count;

        if replacementLen == count {
            if replacementLen != 0 {
                let mut items = self.allocatedItems();
                _ = (&mut items[start..end]).copyFrom(values);
            }
            return !();
        }

        if replacementLen < count {
            let removedExtra = count - replacementLen;
            let newLen = len - removedExtra;
            let mut items = self.allocatedItems();
            if replacementLen != 0 {
                _ = (&mut items[start..(start + replacementLen)]).copyFrom(values);
            }
            if end < len {
                _ = (&mut items[(start + replacementLen)..newLen]).copyFrom(&items[end..len]);
            }
            self.items = &mut items[0..newLen];
            return !();
        }

        let added = replacementLen - count;
        let newLen = len.checkedAdd(added)
            .okOr(mem::Error::OutOfMemory).?;
        self.ensureTotalCapacity(allocator, newLen).?;
        let mut items = self.allocatedItems();
        if end < len {
            _ = (&mut items[(start + replacementLen)..newLen]).copyFrom(&items[end..len]);
        }
        _ = (&mut items[start..(start + replacementLen)]).copyFrom(values);
        self.items = &mut items[0..newLen];
        !()
    }

    pub fun appendSlice(&mut self, allocator: &mut mem::Allocator, items: &[T]) mem::Error!() {
        self.freePendingItems(allocator).?;
        self.withStableSlice(allocator, items,
            \list: &mut ArrayList[T], allocator: &mut mem::Allocator, stable: &[T]
                -> list.appendStableSlice(allocator, stable))
    }

    fun appendStableSlice(&mut self, allocator: &mut mem::Allocator, items: &[T]) mem::Error!() {
        let mut out = self.addManyUninitialized(allocator, items.len()).?;
        _ = out.copyFrom(items);
        !()
    }

    pub fun appendSliceAssumeCapacity(&mut self, items: &[T]) () {
        let mut out = self.addManyUninitializedAssumeCapacity(items.len());
        _ = out.copyFrom(items);
    }

    pub fun appendAssumeCapacity(&mut self, value: T) () {
        let slot = self.addOneUninitializedAssumeCapacity();
        slot.* = value;
    }

    fun addOneUninitialized(&mut self, allocator: &mut mem::Allocator) mem::Error!&mut T {
        let mut items = self.addManyUninitialized(allocator, 1).?;
        !&mut items[0]
    }

    fun addOneUninitializedAssumeCapacity(&mut self) &mut T {
        let mut items = self.addManyUninitializedAssumeCapacity(1);
        &mut items[0]
    }

    fun addManyUninitialized(&mut self, allocator: &mut mem::Allocator, count: usize) mem::Error!&mut [T] {
        let oldLen = self.len();
        let newLen = oldLen.checkedAdd(count)
            .okOr(mem::Error::OutOfMemory).?;
        self.resizeUninitialized(allocator, newLen).?;
        let mut items = self.allocatedItems();
        !&mut items[oldLen..newLen]
    }

    fun addManyUninitializedAssumeCapacity(&mut self, count: usize) &mut [T] {
        let oldLen = self.len();
        let newLen = oldLen + count;
        if newLen > self.capacity() {
            root::builtin::trap()
        }
        let mut items = self.allocatedItems();
        self.items = &mut items[0..newLen];
        &mut items[oldLen..newLen]
    }

    fun addManyAtUninitialized(&mut self, allocator: &mut mem::Allocator, index: usize, count: usize) mem::Error!&mut [T] {
        if index > self.len() {
            return .Invalid!;
        }
        let newLen = self.len().checkedAdd(count)
            .okOr(mem::Error::OutOfMemory).?;
        self.ensureTotalCapacity(allocator, newLen).?;
        !self.addManyAtUninitializedAssumeCapacity(index, count)
    }

    fun addManyAtUninitializedAssumeCapacity(&mut self, index: usize, count: usize) &mut [T] {
        let len = self.len();
        if index > len {
            root::builtin::trap()
        }
        let newLen = len + count;
        if newLen > self.capacity() {
            root::builtin::trap()
        }
        let mut items = self.allocatedItems();
        if count != 0 and index < len {
            _ = (&mut items[(index + count)..newLen]).copyFrom(&items[index..len]);
        }
        self.items = &mut items[0..newLen];
        &mut items[index..(index + count)]
    }

    fun resizeUninitialized(&mut self, allocator: &mut mem::Allocator, newLen: usize) mem::Error!() {
        self.ensureTotalCapacity(allocator, newLen).?;
        let mut items = self.allocatedItems();
        self.items = &mut items[0..newLen];
        !()
    }
}

extend[T] ArrayList[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = slice::SliceIter[T];

    pub fun iter(&self) slice::SliceIter[T] {
        self.asSlice().iter()
    }
}

extend[T] &ArrayList[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = slice::SliceIter[T];

    pub fun iter(&self) slice::SliceIter[T] {
        self.*.iter()
    }
}

extend[T] &mut ArrayList[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = slice::SliceIter[T];

    pub fun iter(&self) slice::SliceIter[T] {
        self.*.iter()
    }
}
