using pkg::mem;
using pkg::slice;
using pkg::collections::array_list::raw;

pub struct ArrayList[T]
where T: Sized
{
    items: &mut [T],
    capacity: usize,
}

extend[T] ArrayList[T]
where T: Sized
{
    pub fn init() ArrayList[T] {
        { items: raw::danglingSlice[T](0), capacity: 0 }
    }

    pub fn initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!ArrayList[T] {
        let mut list = ArrayList[T]::init();
        list.ensureTotalCapacityPrecise(allocator, capacity).?;
        !list
    }

    pub fn fromOwnedSlice(items: &mut [T]) ArrayList[T] {
        { items: items, capacity: items.len() }
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.freeItems(allocator).?;
        self.items = raw::danglingSlice[T](0);
        self.capacity = 0;
        !{}
    }

    pub fn len(&self) usize {
        self.items.len()
    }

    pub fn capacity(&self) usize {
        self.capacity
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn asSlice(&self) &[T] {
        &self.items[0..self.len()]
    }

    pub fn asMutSlice(&mut self) &mut [T] {
        self.items
    }

    pub fn iter(&self) slice::SliceIter[T] {
        self.asSlice().iter()
    }

    pub fn iterMut(&mut self) slice::SliceIterMut[T] {
        self.asMutSlice().iter_mut()
    }

    pub fn get(&self, index: usize) ?&T {
        if index >= self.len() {
            null
        } else {
            ?&self.items[index]
        }
    }

    pub fn getMut(&mut self, index: usize) ?&mut T {
        if index >= self.len() {
            null
        } else {
            ?&mut self.items[index]
        }
    }

    pub fn first(&self) ?&T {
        self.get(0)
    }

    pub fn firstMut(&mut self) ?&mut T {
        self.getMut(0)
    }

    pub fn last(&self) ?&T {
        if self.len() == 0 {
            null
        } else {
            ?&self.items[self.len() - 1]
        }
    }

    pub fn lastMut(&mut self) ?&mut T {
        if self.len() == 0 {
            null
        } else {
            ?&mut self.items[self.len() - 1]
        }
    }

    pub fn clear(&mut self) void {
        let mut ptr = self.items.ptr_mut();
        self.items = &mut ptr[0..0];
    }

    pub fn intoOwnedSlice(&mut self, allocator: &mut mem::Allocator) mem::Error!&mut [T] {
        let len = self.len();
        if std::builtin::size[T]() == 0 {
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            return !raw::danglingSlice[T](len);
        }

        if self.capacity() == 0 {
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            return !raw::danglingSlice[T](len);
        }

        let oldBlock = self.allocatedBlock().?;
        if len == 0 {
            allocator.free(oldBlock).?;
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            return !raw::danglingSlice[T](0);
        }

        let layout = mem::Layout::array[T](len).?;
        switch allocator.remap(oldBlock, layout) {
            ?block => {
                self.items = raw::danglingSlice[T](0);
                self.capacity = 0;
                return !raw::blockItems[T](block, len);
            },
            null => {
            },
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, len);
        mem::copy_forwards[T](newItems, self.asSlice());
        switch allocator.free(oldBlock) {
            !ok => {
                _ = ok;
            },
            err! => {
                switch allocator.free(newBlock) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {},
                }
                return err!;
            },
        }
        self.items = raw::danglingSlice[T](0);
        self.capacity = 0;
        !newItems
    }

    pub fn toOwnedSlice(&self, allocator: &mut mem::Allocator) mem::Error!&mut [T] {
        let len = self.len();
        if len == 0 or std::builtin::size[T]() == 0 {
            return !raw::danglingSlice[T](len);
        }

        let layout = mem::Layout::array[T](len).?;
        let block = allocator.alloc(layout).?;
        let mut out = raw::blockItems[T](block, len);
        mem::copy_forwards[T](out, self.asSlice());
        !out
    }

    pub fn clone(&self, allocator: &mut mem::Allocator) mem::Error!ArrayList[T] {
        let mut cloned = ArrayList[T]::initCapacity(allocator, self.capacity()).?;
        cloned.appendSliceAssumeCapacity(self.asSlice());
        !cloned
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, value: T) mem::Error!void {
        let slot = self.addOneUninitialized(allocator).?;
        slot.* = value;
        !{}
    }

    pub fn pop(&mut self) ?T {
        let len = self.len();
        if len == 0 {
            null
        } else {
            let nextLen = len - 1;
            let value = self.items[nextLen];
            let mut ptr = self.items.ptr_mut();
            self.items = &mut ptr[0..nextLen];
            ?value
        }
    }

    pub fn swapRemove(&mut self, index: usize) ?T {
        let len = self.len();
        if index >= len {
            null
        } else {
            let lastIndex = len - 1;
            let value = self.items[index];
            if index != lastIndex {
                self.items[index] = self.items[lastIndex];
            }
            let mut ptr = self.items.ptr_mut();
            self.items = &mut ptr[0..lastIndex];
            ?value
        }
    }

    pub fn orderedRemove(&mut self, index: usize) ?T {
        let len = self.len();
        if index >= len {
            null
        } else {
            let value = self.items[index];
            let newLen = len - 1;
            let mut items = self.allocatedItems();
            if index < newLen {
                mem::copy_forwards[T](&mut items[index..newLen], &items[(index + 1)..len]);
            }
            self.items = &mut items[0..newLen];
            ?value
        }
    }

    pub fn truncate(&mut self, newLen: usize) void {
        if newLen < self.len() {
            let mut ptr = self.items.ptr_mut();
            self.items = &mut ptr[0..newLen];
        }
    }

    pub fn removeRange(&mut self, start: usize, count: usize) mem::Error!void {
        let len = self.len();
        if start > len {
            return mem::Error::Invalid!;
        }
        let end = switch start.checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::Invalid!;
            },
        };
        if end > len {
            return mem::Error::Invalid!;
        }
        if count == 0 {
            return !{};
        }

        let mut items = self.allocatedItems();
        if end < len {
            mem::copy_forwards[T](&mut items[start..(len - count)], &items[end..len]);
        }
        self.items = &mut items[0..(len - count)];
        !{}
    }

    pub fn insert(&mut self, allocator: &mut mem::Allocator, index: usize, value: T) mem::Error!void {
        let mut slots = self.addManyAtUninitialized(allocator, index, 1).?;
        slots[0] = value;
        !{}
    }

    pub fn insertSlice(&mut self, allocator: &mut mem::Allocator, index: usize, values: &[T]) mem::Error!void {
        if index > self.len() {
            return mem::Error::Invalid!;
        }
        if self.slicePointsIntoAllocation(values) {
            let copyLayout = mem::Layout::array[T](values.len()).?;
            let copyBlock = allocator.alloc(copyLayout).?;
            let mut copy = copyBlock.as_slice[T]();
            mem::copy_forwards[T](copy, values);
            switch self.insertStableSlice(allocator, index, copy) {
                !ok => {
                    _ = ok;
                },
                err! => {
                    switch allocator.free(copyBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {},
                    }
                    return err!;
                },
            }
            allocator.free(copyBlock).?;
            return !{};
        }

        self.insertStableSlice(allocator, index, values)
    }

    pub fn replaceRange(
        &mut self,
        allocator: &mut mem::Allocator,
        start: usize,
        count: usize,
        values: &[T],
    ) mem::Error!void {
        if start > self.len() {
            return mem::Error::Invalid!;
        }
        let end = switch start.checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::Invalid!;
            },
        };
        if end > self.len() {
            return mem::Error::Invalid!;
        }

        if self.slicePointsIntoAllocation(values) {
            let copyLayout = mem::Layout::array[T](values.len()).?;
            let copyBlock = allocator.alloc(copyLayout).?;
            let mut copy = copyBlock.as_slice[T]();
            mem::copy_forwards[T](copy, values);
            switch self.replaceRangeStable(allocator, start, count, copy) {
                !ok => {
                    _ = ok;
                },
                err! => {
                    switch allocator.free(copyBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {},
                    }
                    return err!;
                },
            }
            allocator.free(copyBlock).?;
            return !{};
        }

        self.replaceRangeStable(allocator, start, count, values)
    }

    fn insertStableSlice(&mut self, allocator: &mut mem::Allocator, index: usize, values: &[T]) mem::Error!void {
        let mut slots = self.addManyAtUninitialized(allocator, index, values.len()).?;
        mem::copy_forwards[T](slots, values);
        !{}
    }

    fn replaceRangeStable(
        &mut self,
        allocator: &mut mem::Allocator,
        start: usize,
        count: usize,
        values: &[T],
    ) mem::Error!void {
        let len = self.len();
        let replacementLen = values.len();
        let end = start + count;

        if replacementLen == count {
            if replacementLen != 0 {
                let mut items = self.allocatedItems();
                mem::copy_forwards[T](&mut items[start..end], values);
            }
            return !{};
        }

        if replacementLen < count {
            let removedExtra = count - replacementLen;
            let newLen = len - removedExtra;
            let mut items = self.allocatedItems();
            if replacementLen != 0 {
                mem::copy_forwards[T](&mut items[start..(start + replacementLen)], values);
            }
            if end < len {
                mem::copy_forwards[T](&mut items[(start + replacementLen)..newLen], &items[end..len]);
            }
            self.items = &mut items[0..newLen];
            return !{};
        }

        let added = replacementLen - count;
        let newLen = switch len.checked_add(added) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.ensureTotalCapacity(allocator, newLen).?;
        let mut items = self.allocatedItems();
        if end < len {
            mem::copy_backwards[T](&mut items[(start + replacementLen)..newLen], &items[end..len]);
        }
        mem::copy_forwards[T](&mut items[start..(start + replacementLen)], values);
        self.items = &mut items[0..newLen];
        !{}
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        self.ensureUnusedCapacity(allocator, additional)
    }

    pub fn reserveExact(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        let len = self.len();
        let needed = switch len.checked_add(additional) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.ensureTotalCapacityPrecise(allocator, needed)
    }

    fn ensureUnusedCapacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        let len = self.len();
        let needed = switch len.checked_add(additional) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.ensureTotalCapacity(allocator, needed)
    }

    pub fn ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, newCapacity: usize) mem::Error!void {
        if newCapacity <= self.capacity() {
            return !{};
        }
        let betterCapacity = self.grownCapacity(newCapacity).?;
        self.ensureTotalCapacityPrecise(allocator, betterCapacity)
    }

    fn ensureTotalCapacityPrecise(&mut self, allocator: &mut mem::Allocator, newCapacity: usize) mem::Error!void {
        if newCapacity <= self.capacity() {
            return !{};
        }
        self.growToCapacity(allocator, newCapacity).?;
        !{}
    }

    pub fn appendSlice(&mut self, allocator: &mut mem::Allocator, items: &[T]) mem::Error!void {
        if self.slicePointsIntoAllocation(items) {
            let copyLayout = mem::Layout::array[T](items.len()).?;
            let copyBlock = allocator.alloc(copyLayout).?;
            let mut copy = copyBlock.as_slice[T]();
            mem::copy_forwards[T](copy, items);
            switch self.appendStableSlice(allocator, copy) {
                !ok => {
                    _ = ok;
                },
                err! => {
                    switch allocator.free(copyBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {},
                    }
                    return err!;
                },
            }
            allocator.free(copyBlock).?;
            return !{};
        }

        self.appendStableSlice(allocator, items)
    }

    fn appendStableSlice(&mut self, allocator: &mut mem::Allocator, items: &[T]) mem::Error!void {
        let mut out = self.addManyUninitialized(allocator, items.len()).?;
        mem::copy_forwards[T](out, items);
        !{}
    }

    pub fn appendSliceAssumeCapacity(&mut self, items: &[T]) void {
        let mut out = self.addManyUninitializedAssumeCapacity(items.len());
        mem::copy_forwards[T](out, items);
    }

    pub fn appendAssumeCapacity(&mut self, value: T) void {
        let slot = self.addOneUninitializedAssumeCapacity();
        slot.* = value;
    }

    fn addOneUninitialized(&mut self, allocator: &mut mem::Allocator) mem::Error!&mut T {
        let mut items = self.addManyUninitialized(allocator, 1).?;
        !&mut items[0]
    }

    fn addOneUninitializedAssumeCapacity(&mut self) &mut T {
        let mut items = self.addManyUninitializedAssumeCapacity(1);
        &mut items[0]
    }

    fn addManyUninitialized(&mut self, allocator: &mut mem::Allocator, count: usize) mem::Error!&mut [T] {
        let oldLen = self.len();
        let newLen = switch oldLen.checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.resizeUninitialized(allocator, newLen).?;
        let mut items = self.allocatedItems();
        !&mut items[oldLen..newLen]
    }

    fn addManyUninitializedAssumeCapacity(&mut self, count: usize) &mut [T] {
        let oldLen = self.len();
        let newLen = switch oldLen.checked_add(count) {
            ?value => {
                value
            },
            null => {
                std::builtin::trap()
            },
        };
        if newLen > self.capacity() {
            std::builtin::trap()
        }
        let mut items = self.allocatedItems();
        self.items = &mut items[0..newLen];
        &mut items[oldLen..newLen]
    }

    fn addManyAtUninitialized(&mut self, allocator: &mut mem::Allocator, index: usize, count: usize) mem::Error!&mut [T] {
        if index > self.len() {
            return mem::Error::Invalid!;
        }
        let newLen = switch self.len().checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        if self.capacity() < newLen {
            let betterCapacity = self.grownCapacity(newLen).?;
            self.growToCapacity(allocator, betterCapacity).?;
        }
        !self.addManyAtUninitializedAssumeCapacity(index, count)
    }

    fn addManyAtUninitializedAssumeCapacity(&mut self, index: usize, count: usize) &mut [T] {
        let len = self.len();
        if index > len {
            std::builtin::trap()
        }
        let newLen = switch len.checked_add(count) {
            ?value => {
                value
            },
            null => {
                std::builtin::trap()
            },
        };
        if newLen > self.capacity() {
            std::builtin::trap()
        }
        let mut items = self.allocatedItems();
        if count != 0 and index < len {
            mem::copy_backwards[T](&mut items[(index + count)..newLen], &items[index..len]);
        }
        self.items = &mut items[0..newLen];
        &mut items[index..(index + count)]
    }

    fn resizeUninitialized(&mut self, allocator: &mut mem::Allocator, newLen: usize) mem::Error!void {
        self.ensureTotalCapacity(allocator, newLen).?;
        let mut items = self.allocatedItems();
        self.items = &mut items[0..newLen];
        !{}
    }

    pub fn shrinkToFit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.shrinkToCapacity(allocator, self.len())
    }

    pub fn shrinkToCapacity(&mut self, allocator: &mut mem::Allocator, minCapacity: usize) mem::Error!void {
        let targetCapacity = if minCapacity > self.len() {
            minCapacity
        } else {
            self.len()
        };
        if targetCapacity >= self.capacity() {
            return !{};
        }
        if std::builtin::size[T]() == 0 {
            self.capacity = usize::MAX;
            return !{};
        }

        let oldBlock = self.allocatedBlock().?;
        if targetCapacity == 0 {
            allocator.free(oldBlock).?;
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            return !{};
        }

        let layout = mem::Layout::array[T](targetCapacity).?;
        switch allocator.remap(oldBlock, layout) {
            ?block => {
                self.setAllocatedBlock(block, targetCapacity);
                return !{};
            },
            null => {
            },
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, targetCapacity);
        mem::copy_forwards[T](&mut newItems[0..self.len()], self.asSlice());
        switch allocator.free(oldBlock) {
            !ok => {
                _ = ok;
            },
            err! => {
                switch allocator.free(newBlock) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {},
                }
                return err!;
            },
        }
        self.setAllocatedBlock(newBlock, targetCapacity);
        !{}
    }

    fn grownCapacity(&self, needed: usize) mem::Error!usize {
        if std::builtin::size[T]() == 0 {
            return !usize::MAX;
        }
        let elemLen = std::builtin::size[T]();
        let mut initCapacity = 64 / elemLen;
        if initCapacity == 0 {
            initCapacity = 1;
        }
        let half = needed / 2;
        let extra = switch half.checked_add(initCapacity) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        switch needed.checked_add(extra) {
            ?capacity => {
                !capacity
            },
            null => {
                mem::Error::OutOfMemory!
            },
        }
    }

    fn growToCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        if std::builtin::size[T]() == 0 {
            self.capacity = usize::MAX;
            return !{};
        }
        let oldBlock = self.allocatedBlock().?;
        let layout = mem::Layout::array[T](capacity).?;
        switch allocator.remap(oldBlock, layout) {
            ?block => {
                self.setAllocatedBlock(block, capacity);
                return !{};
            },
            null => {
            },
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, capacity);
        mem::copy_forwards[T](newItems, self.asSlice());
        switch allocator.free(oldBlock) {
            !ok => {
                _ = ok;
            },
            err! => {
                switch allocator.free(newBlock) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {},
                }
                return err!;
            },
        }
        self.setAllocatedBlock(newBlock, capacity);
        !{}
    }

    fn freeItems(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        if self.capacity() == 0 or std::builtin::size[T]() == 0 {
            return !{};
        }
        let block = self.allocatedBlock().?;
        allocator.free(block)
    }

    fn allocatedItems(&mut self) &mut [T] {
        let mut ptr = self.items.ptr_mut() as &mut T;
        &mut ptr[0..self.capacity]
    }

    fn allocatedBlock(&self) mem::Error!mem::Block {
        let layout = mem::Layout::array[T](self.capacity).?;
        !mem::Block::init(self.items.ptr_mut() as &mut u8, layout)
    }

    fn setAllocatedBlock(&mut self, block: mem::Block, capacity: usize) void {
        let len = self.len();
        let mut items = raw::blockItems[T](block, capacity);
        self.items = &mut items[0..len];
        self.capacity = capacity;
    }

    fn slicePointsIntoAllocation(&self, items: &[T]) bool {
        if items.len() == 0 or self.capacity == 0 or std::builtin::size[T]() == 0 {
            return false;
        }

        let itemSize = std::builtin::size[T]();
        let base = self.items.ptr_mut() as usize;
        let ptr = items.ptr() as usize;
        if ptr < base {
            return false;
        }

        let byteOffset = ptr - base;
        let allocBytes = switch self.capacity.checked_mul(itemSize) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        let itemBytes = switch items.len().checked_mul(itemSize) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        if byteOffset > allocBytes {
            return false;
        }
        itemBytes <= allocBytes - byteOffset
    }
}

extend[T] ArrayList[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = slice::SliceIter[T];

    pub fn iter(&self) slice::SliceIter[T] {
        self.asSlice().iter()
    }
}
