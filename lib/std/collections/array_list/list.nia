using pkg::mem;
using pkg::error;
using pkg::slice;
using pkg::collections::array_list::raw;

pub struct ArrayList[T]
where T: Sized
{
    items: &mut [T],
    capacity: usize,
    storageBlock: ?mem::Block,
    replacementBlock: ?mem::Block,
    aliasBlock: ?mem::Block,
}

extend[T] ArrayList[T]
where T: Sized
{
    pub fn init() ArrayList[T] {
        Self {
            items: raw::danglingSlice[T](0),
            capacity: 0,
            storageBlock: null,
            replacementBlock: null,
            aliasBlock: null,
        }
    }

    pub fn initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!ArrayList[T] {
        let mut list = ArrayList[T]::init();
        list.ensureTotalCapacityPrecise(allocator, capacity).?;
        !list
    }

    pub fn fromOwnedAllocation(allocation: mem::SliceAllocation[T]) ArrayList[T] {
        let len = allocation.len();
        let block = allocation.intoBlock();
        let items = raw::blockItems[T](block, len);
        Self {
            items: items,
            capacity: len,
            storageBlock: ?block,
            replacementBlock: null,
            aliasBlock: null,
        }
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let mut cleanup: error::CleanupAccumulator[mem::Error] = .init();
        cleanup.attempt(self.freeItems(allocator));
        cleanup.attempt(self.freeReplacementItems(allocator));
        cleanup.attempt(self.freeAliasItems(allocator));
        if not cleanup.isClean() {
            return cleanup.finish();
        }
        self.items = raw::danglingSlice[T](0);
        self.capacity = 0;
        self.storageBlock = null;
        !()
    }

    pub fn len(&self) usize {
        self.items.len()
    }

    pub fn capacity(&self) usize {
        self.capacity
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn asSlice(&self) &[T] {
        &self.items[0..self.len()]
    }

    pub fn asMutSlice(&mut self) &mut [T] {
        &mut self.items[0..self.len()]
    }

    pub fn iter(&self) slice::SliceIter[T] {
        self.asSlice().iter()
    }

    pub fn iterMut(&mut self) slice::SliceIterMut[T] {
        self.asMutSlice().iterMut()
    }

    pub fn get(&self, index: usize) ?&T {
        self.asSlice().get(index)
    }

    pub fn getMut(&mut self, index: usize) ?&mut T {
        self.asMutSlice().getMut(index)
    }

    pub fn first(&self) ?&T {
        self.get(0)
    }

    pub fn firstMut(&mut self) ?&mut T {
        self.getMut(0)
    }

    pub fn last(&self) ?&T {
        self.asSlice().last()
    }

    pub fn lastMut(&mut self) ?&mut T {
        self.asMutSlice().lastMut()
    }

    pub fn clear(&mut self) () {
        let mut ptr = self.items.ptrMut();
        self.items = &mut ptr[0..0];
    }

    pub fn intoOwnedSlice(&mut self, allocator: &mut mem::Allocator) mem::Error!mem::SliceAllocation[T] {
        self.freePendingItems(allocator).?;
        let len = self.len();
        let layout = mem::Layout::array[T](len).?;
        if std::builtin::size[T]() == 0 or self.capacity() == 0 {
            if self.storageBlock is ?block {
                allocator.free(block).?;
            }
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            self.storageBlock = null;
            return !mem::SliceAllocation[T]::fromBlock(mem::Block::empty(layout), len);
        }

        let oldBlock = self.allocatedBlock().?;
        if len == 0 {
            allocator.free(oldBlock).?;
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            self.storageBlock = null;
            return !mem::SliceAllocation[T]::fromBlock(mem::Block::empty(layout), 0);
        }

        if allocator.remap(oldBlock, layout) is ?block {
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            self.storageBlock = null;
            return !mem::SliceAllocation[T]::fromBlock(block, len);
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, len);
        _ = newItems.copyFrom(self.asSlice());
        match allocator.free(oldBlock) {
            !ok => {
                _ = ok;
            },
            err! => {
                match allocator.free(newBlock) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {
                        self.retainReplacementBlock(newBlock);
                    },
                }
                return err!;
            },
        }
        self.items = raw::danglingSlice[T](0);
        self.capacity = 0;
        self.storageBlock = null;
        !mem::SliceAllocation[T]::fromBlock(newBlock, len)
    }

    pub fn toOwnedSlice(&self, allocator: &mut mem::Allocator) mem::Error!mem::SliceAllocation[T] {
        let len = self.len();
        if len == 0 or std::builtin::size[T]() == 0 {
            return !mem::SliceAllocation[T]::fromBlock(mem::Block::empty(mem::Layout::array[T](len).?), len);
        }

        let layout = mem::Layout::array[T](len).?;
        let block = allocator.alloc(layout).?;
        let mut out = raw::blockItems[T](block, len);
        _ = out.copyFrom(self.asSlice());
        !mem::SliceAllocation[T]::fromBlock(block, len)
    }

    pub fn clone(&self, allocator: &mut mem::Allocator) mem::Error!ArrayList[T] {
        let mut cloned = ArrayList[T]::initCapacity(allocator, self.capacity()).?;
        cloned.appendSliceAssumeCapacity(self.asSlice());
        !cloned
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, value: T) mem::Error!() {
        let slot = self.addOneUninitialized(allocator).?;
        slot.* = value;
        !()
    }

    pub fn pop(&mut self) ?T {
        let len = self.len();
        if len == 0 {
            null
        } else {
            let nextLen = len - 1;
            let value = self.items[nextLen];
            let mut ptr = self.items.ptrMut();
            self.items = &mut ptr[0..nextLen];
            ?value
        }
    }

    pub fn swapRemove(&mut self, index: usize) ?T {
        let len = self.len();
        if index >= len {
            null
        } else {
            let lastIndex = len - 1;
            let value = self.items[index];
            if index != lastIndex {
                self.items[index] = self.items[lastIndex];
            }
            let mut ptr = self.items.ptrMut();
            self.items = &mut ptr[0..lastIndex];
            ?value
        }
    }

    pub fn orderedRemove(&mut self, index: usize) ?T {
        let len = self.len();
        if index >= len {
            null
        } else {
            let value = self.items[index];
            let newLen = len - 1;
            let mut items = self.allocatedItems();
            if index < newLen {
                _ = (&mut items[index..newLen]).copyFrom(&items[(index + 1)..len]);
            }
            self.items = &mut items[0..newLen];
            ?value
        }
    }

    pub fn truncate(&mut self, newLen: usize) () {
        if newLen < self.len() {
            let mut ptr = self.items.ptrMut();
            self.items = &mut ptr[0..newLen];
        }
    }

    pub fn removeRange(&mut self, start: usize, count: usize) mem::Error!() {
        let len = self.len();
        if start > len {
            return mem::Error::Invalid!;
        }
        let end = match start.checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::Invalid!;
            },
        };
        if end > len {
            return mem::Error::Invalid!;
        }
        if count == 0 {
            return !();
        }

        let mut items = self.allocatedItems();
        if end < len {
            _ = (&mut items[start..(len - count)]).copyFrom(&items[end..len]);
        }
        self.items = &mut items[0..(len - count)];
        !()
    }

    pub fn insert(&mut self, allocator: &mut mem::Allocator, index: usize, value: T) mem::Error!() {
        let mut slots = self.addManyAtUninitialized(allocator, index, 1).?;
        slots[0] = value;
        !()
    }

    pub fn insertSlice(&mut self, allocator: &mut mem::Allocator, index: usize, values: &[T]) mem::Error!() {
        self.freePendingItems(allocator).?;
        if index > self.len() {
            return mem::Error::Invalid!;
        }
        if self.slicePointsIntoAllocation(values) {
            let copyLayout = mem::Layout::array[T](values.len()).?;
            let copyBlock = allocator.alloc(copyLayout).?;
            let mut copy = copyBlock.asSlice[T]();
            _ = copy.copyFrom(values);
            match self.insertStableSlice(allocator, index, copy) {
                !ok => {
                    _ = ok;
                },
                err! => {
                    match allocator.free(copyBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {
                            self.retainAliasBlock(copyBlock);
                        },
                    }
                    return err!;
                },
            }
            match allocator.free(copyBlock) {
                !ok => {
                    _ = ok;
                    return !();
                },
                err! => {
                    self.retainAliasBlock(copyBlock);
                    return err!;
                },
            }
        }

        self.insertStableSlice(allocator, index, values)
    }

    pub fn replaceRange(
        &mut self,
        allocator: &mut mem::Allocator,
        start: usize,
        count: usize,
        values: &[T],
    ) mem::Error!() {
        self.freePendingItems(allocator).?;
        if start > self.len() {
            return mem::Error::Invalid!;
        }
        let end = match start.checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::Invalid!;
            },
        };
        if end > self.len() {
            return mem::Error::Invalid!;
        }

        if self.slicePointsIntoAllocation(values) {
            let copyLayout = mem::Layout::array[T](values.len()).?;
            let copyBlock = allocator.alloc(copyLayout).?;
            let mut copy = copyBlock.asSlice[T]();
            _ = copy.copyFrom(values);
            match self.replaceRangeStable(allocator, start, count, copy) {
                !ok => {
                    _ = ok;
                },
                err! => {
                    match allocator.free(copyBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {
                            self.retainAliasBlock(copyBlock);
                        },
                    }
                    return err!;
                },
            }
            match allocator.free(copyBlock) {
                !ok => {
                    _ = ok;
                    return !();
                },
                err! => {
                    self.retainAliasBlock(copyBlock);
                    return err!;
                },
            }
        }

        self.replaceRangeStable(allocator, start, count, values)
    }

    fn insertStableSlice(&mut self, allocator: &mut mem::Allocator, index: usize, values: &[T]) mem::Error!() {
        let mut slots = self.addManyAtUninitialized(allocator, index, values.len()).?;
        _ = slots.copyFrom(values);
        !()
    }

    fn replaceRangeStable(
        &mut self,
        allocator: &mut mem::Allocator,
        start: usize,
        count: usize,
        values: &[T],
    ) mem::Error!() {
        let len = self.len();
        let replacementLen = values.len();
        let end = start + count;

        if replacementLen == count {
            if replacementLen != 0 {
                let mut items = self.allocatedItems();
                _ = (&mut items[start..end]).copyFrom(values);
            }
            return !();
        }

        if replacementLen < count {
            let removedExtra = count - replacementLen;
            let newLen = len - removedExtra;
            let mut items = self.allocatedItems();
            if replacementLen != 0 {
                _ = (&mut items[start..(start + replacementLen)]).copyFrom(values);
            }
            if end < len {
                _ = (&mut items[(start + replacementLen)..newLen]).copyFrom(&items[end..len]);
            }
            self.items = &mut items[0..newLen];
            return !();
        }

        let added = replacementLen - count;
        let newLen = match len.checked_add(added) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.ensureTotalCapacity(allocator, newLen).?;
        let mut items = self.allocatedItems();
        if end < len {
            _ = (&mut items[(start + replacementLen)..newLen]).copyFrom(&items[end..len]);
        }
        _ = (&mut items[start..(start + replacementLen)]).copyFrom(values);
        self.items = &mut items[0..newLen];
        !()
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        self.ensureUnusedCapacity(allocator, additional)
    }

    pub fn reserveExact(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        let len = self.len();
        let needed = match len.checked_add(additional) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.ensureTotalCapacityPrecise(allocator, needed)
    }

    fn ensureUnusedCapacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        let len = self.len();
        let needed = match len.checked_add(additional) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.ensureTotalCapacity(allocator, needed)
    }

    pub fn ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, newCapacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        if newCapacity <= self.capacity() {
            return !();
        }
        let betterCapacity = self.grownCapacity(newCapacity).?;
        self.ensureTotalCapacityPrecise(allocator, betterCapacity)
    }

    fn ensureTotalCapacityPrecise(&mut self, allocator: &mut mem::Allocator, newCapacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        if newCapacity <= self.capacity() {
            return !();
        }
        self.growToCapacity(allocator, newCapacity).?;
        !()
    }

    pub fn appendSlice(&mut self, allocator: &mut mem::Allocator, items: &[T]) mem::Error!() {
        self.freePendingItems(allocator).?;
        if self.slicePointsIntoAllocation(items) {
            let copyLayout = mem::Layout::array[T](items.len()).?;
            let copyBlock = allocator.alloc(copyLayout).?;
            let mut copy = copyBlock.asSlice[T]();
            _ = copy.copyFrom(items);
            match self.appendStableSlice(allocator, copy) {
                !ok => {
                    _ = ok;
                },
                err! => {
                    match allocator.free(copyBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {
                            self.retainAliasBlock(copyBlock);
                        },
                    }
                    return err!;
                },
            }
            match allocator.free(copyBlock) {
                !ok => {
                    _ = ok;
                    return !();
                },
                err! => {
                    self.retainAliasBlock(copyBlock);
                    return err!;
                },
            }
        }

        self.appendStableSlice(allocator, items)
    }

    fn appendStableSlice(&mut self, allocator: &mut mem::Allocator, items: &[T]) mem::Error!() {
        let mut out = self.addManyUninitialized(allocator, items.len()).?;
        _ = out.copyFrom(items);
        !()
    }

    pub fn appendSliceAssumeCapacity(&mut self, items: &[T]) () {
        let mut out = self.addManyUninitializedAssumeCapacity(items.len());
        _ = out.copyFrom(items);
    }

    pub fn appendAssumeCapacity(&mut self, value: T) () {
        let slot = self.addOneUninitializedAssumeCapacity();
        slot.* = value;
    }

    fn addOneUninitialized(&mut self, allocator: &mut mem::Allocator) mem::Error!&mut T {
        let mut items = self.addManyUninitialized(allocator, 1).?;
        !&mut items[0]
    }

    fn addOneUninitializedAssumeCapacity(&mut self) &mut T {
        let mut items = self.addManyUninitializedAssumeCapacity(1);
        &mut items[0]
    }

    fn addManyUninitialized(&mut self, allocator: &mut mem::Allocator, count: usize) mem::Error!&mut [T] {
        let oldLen = self.len();
        let newLen = match oldLen.checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        self.resizeUninitialized(allocator, newLen).?;
        let mut items = self.allocatedItems();
        !&mut items[oldLen..newLen]
    }

    fn addManyUninitializedAssumeCapacity(&mut self, count: usize) &mut [T] {
        let oldLen = self.len();
        let newLen = match oldLen.checked_add(count) {
            ?value => {
                value
            },
            null => {
                std::builtin::trap()
            },
        };
        if newLen > self.capacity() {
            std::builtin::trap()
        }
        let mut items = self.allocatedItems();
        self.items = &mut items[0..newLen];
        &mut items[oldLen..newLen]
    }

    fn addManyAtUninitialized(&mut self, allocator: &mut mem::Allocator, index: usize, count: usize) mem::Error!&mut [T] {
        if index > self.len() {
            return mem::Error::Invalid!;
        }
        let newLen = match self.len().checked_add(count) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        if self.capacity() < newLen {
            let betterCapacity = self.grownCapacity(newLen).?;
            self.growToCapacity(allocator, betterCapacity).?;
        }
        !self.addManyAtUninitializedAssumeCapacity(index, count)
    }

    fn addManyAtUninitializedAssumeCapacity(&mut self, index: usize, count: usize) &mut [T] {
        let len = self.len();
        if index > len {
            std::builtin::trap()
        }
        let newLen = match len.checked_add(count) {
            ?value => {
                value
            },
            null => {
                std::builtin::trap()
            },
        };
        if newLen > self.capacity() {
            std::builtin::trap()
        }
        let mut items = self.allocatedItems();
        if count != 0 and index < len {
            _ = (&mut items[(index + count)..newLen]).copyFrom(&items[index..len]);
        }
        self.items = &mut items[0..newLen];
        &mut items[index..(index + count)]
    }

    fn resizeUninitialized(&mut self, allocator: &mut mem::Allocator, newLen: usize) mem::Error!() {
        self.ensureTotalCapacity(allocator, newLen).?;
        let mut items = self.allocatedItems();
        self.items = &mut items[0..newLen];
        !()
    }

    pub fn shrinkToFit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.shrinkToCapacity(allocator, self.len())
    }

    pub fn shrinkToCapacity(&mut self, allocator: &mut mem::Allocator, minCapacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        let targetCapacity = if minCapacity > self.len() {
            minCapacity
        } else {
            self.len()
        };
        if targetCapacity >= self.capacity() {
            return !();
        }
        if std::builtin::size[T]() == 0 {
            self.capacity = usize::MAX;
            return !();
        }

        let oldBlock = self.allocatedBlock().?;
        if targetCapacity == 0 {
            allocator.free(oldBlock).?;
            self.items = raw::danglingSlice[T](0);
            self.capacity = 0;
            self.storageBlock = null;
            return !();
        }

        let layout = mem::Layout::array[T](targetCapacity).?;
        if allocator.remap(oldBlock, layout) is ?block {
            self.setAllocatedBlock(block, targetCapacity);
            return !();
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, targetCapacity);
        _ = (&mut newItems[0..self.len()]).copyFrom(self.asSlice());
        match allocator.free(oldBlock) {
            !ok => {
                _ = ok;
            },
            err! => {
                match allocator.free(newBlock) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {
                        self.retainReplacementBlock(newBlock);
                    },
                }
                return err!;
            },
        }
        self.setAllocatedBlock(newBlock, targetCapacity);
        !()
    }

    fn grownCapacity(&self, needed: usize) mem::Error!usize {
        if std::builtin::size[T]() == 0 {
            return !usize::MAX;
        }
        let elemLen = std::builtin::size[T]();
        let mut initCapacity = 64 / elemLen;
        if initCapacity == 0 {
            initCapacity = 1;
        }
        let half = needed / 2;
        let extra = match half.checked_add(initCapacity) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        match needed.checked_add(extra) {
            ?capacity => {
                !capacity
            },
            null => {
                mem::Error::OutOfMemory!
            },
        }
    }

    fn growToCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        if std::builtin::size[T]() == 0 {
            self.capacity = usize::MAX;
            return !();
        }
        let oldBlock = self.allocatedBlock().?;
        let layout = mem::Layout::array[T](capacity).?;
        if allocator.remap(oldBlock, layout) is ?block {
            self.setAllocatedBlock(block, capacity);
            return !();
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, capacity);
        _ = newItems.copyFrom(self.asSlice());
        match allocator.free(oldBlock) {
            !ok => {
                _ = ok;
            },
            err! => {
                match allocator.free(newBlock) {
                    !ok => {
                        _ = ok;
                    },
                    error! => {
                        self.retainReplacementBlock(newBlock);
                    },
                }
                return err!;
            },
        }
        self.setAllocatedBlock(newBlock, capacity);
        !()
    }

    fn freeItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let block = match self.storageBlock {
            ?value => value,
            null => return !(),
        };
        match allocator.free(block) {
            !ok => {
                _ = ok;
                self.items = raw::danglingSlice[T](0);
                self.capacity = 0;
                self.storageBlock = null;
                !()
            },
            err! => err!,
        }
    }

    fn freeReplacementItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let block = match self.replacementBlock {
            ?value => value,
            null => return !(),
        };
        match allocator.free(block) {
            !ok => {
                _ = ok;
                self.replacementBlock = null;
                !()
            },
            err! => err!,
        }
    }

    fn freePendingItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.freeReplacementItems(allocator).?;
        self.freeAliasItems(allocator)
    }

    fn freeAliasItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let block = match self.aliasBlock {
            ?value => value,
            null => return !(),
        };
        match allocator.free(block) {
            !ok => {
                _ = ok;
                self.aliasBlock = null;
                !()
            },
            err! => err!,
        }
    }

    fn retainReplacementBlock(&mut self, block: mem::Block) () {
        self.replacementBlock = ?block;
    }

    fn retainAliasBlock(&mut self, block: mem::Block) () {
        self.aliasBlock = ?block;
    }

    fn allocatedItems(&mut self) &mut [T] {
        let mut ptr = self.items.ptrMut() as &mut T;
        &mut ptr[0..self.capacity]
    }

    fn allocatedBlock(&self) mem::Error!mem::Block {
        match self.storageBlock {
            ?block => !block,
            null => {
                if self.capacity == 0 {
                    !mem::Block::empty(mem::Layout::array[T](0).?)
                } else {
                    mem::Error::Invalid!
                }
            },
        }
    }

    fn setAllocatedBlock(&mut self, block: mem::Block, capacity: usize) () {
        let len = self.len();
        let mut items = raw::blockItems[T](block, capacity);
        self.items = &mut items[0..len];
        self.capacity = capacity;
        self.storageBlock = ?block;
    }

    fn slicePointsIntoAllocation(&self, items: &[T]) bool {
        if items.len() == 0 or self.capacity == 0 or std::builtin::size[T]() == 0 {
            return false;
        }

        let itemSize = std::builtin::size[T]();
        let base = self.items.ptrMut() as usize;
        let ptr = items.ptr() as usize;
        if ptr < base {
            return false;
        }

        let byteOffset = ptr - base;
        let allocBytes = match self.capacity.checked_mul(itemSize) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        let itemBytes = match items.len().checked_mul(itemSize) {
            ?value => {
                value
            },
            null => {
                return false;
            },
        };
        if byteOffset > allocBytes {
            return false;
        }
        itemBytes <= allocBytes - byteOffset
    }
}

extend[T] ArrayList[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = slice::SliceIter[T];

    pub fn iter(&self) slice::SliceIter[T] {
        self.asSlice().iter()
    }
}

extend[T] &ArrayList[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = slice::SliceIter[T];

    pub fn iter(&self) slice::SliceIter[T] {
        self.*.iter()
    }
}

extend[T] &mut ArrayList[T] : Iterable
where T: Sized
{
    type Item = &T;
    type Iter = slice::SliceIter[T];

    pub fn iter(&self) slice::SliceIter[T] {
        self.*.iter()
    }
}
