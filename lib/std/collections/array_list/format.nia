using pkg::fmt;
using pkg::collections::array_list::list;

using list::ArrayList;

extend[T] ArrayList[T] : fmt::Format
where T: Sized + fmt::Format
{
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        formatter.write_byte(b'[').?;
        let mut index = 0usize;
        while index < self.len() {
            if index != 0usize {
                formatter.write_text(&", ").?;
            }
            self.as_slice()[index].format(formatter).?;
            index += 1usize;
        }
        formatter.write_byte(b']')
    }
}
