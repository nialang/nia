using root::fmt;
using root::collections::array_list::list;

using list::ArrayList;

extend[T] ArrayList[T] : fmt::Format
where T: Sized + fmt::Format
{
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        formatter.writeByte(b'[').?;
        let mut first = true;
        for item in self {
            if not first {
                formatter.writeText(", ").?;
            }
            item.format(formatter).?;
            first = false;
        }
        formatter.writeByte(b']')
    }
}
