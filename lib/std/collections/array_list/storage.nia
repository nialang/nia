// Growable-array allocation ownership, capacity, and owner transfers.
//
// The active allocation keeps its owner in `storageBlock`, even when the
// logical length or capacity is zero; later growth replaces that stored owner,
// not a block inferred from the logical capacity. Replacement growth and
// shrink retain a failed temporary replacement block for `deinit` retry
// instead of dropping it after an old-owner release failure. Self-aliasing
// append, insert, and replace keep failed temporary-copy blocks separately
// from replacement storage. Borrowed views and capacities are never used to
// recreate release ownership.

using root::mem;
using root::error;
using root::option;
using root::slice;
using super::list;
using super::raw;

using list::ArrayList;

extend[T] ArrayList[T]
where T: Sized
{
    pub fun init() ArrayList[T] {
        .{
            items: raw::danglingSlice[T](0),
            capacity: 0,
            storageBlock: null,
            replacementBlock: null,
            aliasBlock: null,
        }
    }

    pub fun initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!ArrayList[T] {
        let mut list: ArrayList[T] = .init();
        list.ensureTotalCapacityPrecise(allocator, capacity).?;
        !list
    }

    pub fun fromOwnedAllocation(allocation: mem::SliceAllocation[T]) ArrayList[T] {
        let len = allocation.len();
        let block = allocation.intoBlock();
        let items = raw::blockItems[T](block, len);
        .{
            items,
            capacity: len,
            storageBlock: ?block,
            replacementBlock: null,
            aliasBlock: null,
        }
    }

    pub fun deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let mut cleanup: error::CleanupAccumulator[mem::Error] = .init();
        cleanup.attempt(self.freeItems(allocator));
        cleanup.attempt(self.freeReplacementItems(allocator));
        cleanup.attempt(self.freeAliasItems(allocator));
        cleanup.finish().?;
        self.resetStorage();
        !()
    }

    pub fun intoOwnedSlice(&mut self, allocator: &mut mem::Allocator) mem::Error!mem::SliceAllocation[T] {
        self.freePendingItems(allocator).?;
        let len = self.len();
        let layout = mem::Layout::array[T](len).?;
        if root::builtin::size[T]() == 0 or self.capacity() == 0 {
            if self.storageBlock is ?block {
                allocator.free(block).?;
            }
            self.resetStorage();
            return !.fromBlock(mem::Block::empty(layout), len);
        }

        let oldBlock = self.allocatedBlock().?;
        if len == 0 {
            allocator.free(oldBlock).?;
            self.resetStorage();
            return !.fromBlock(mem::Block::empty(layout), 0);
        }

        if allocator.remap(oldBlock, layout) is ?block {
            self.resetStorage();
            return !.fromBlock(block, len);
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, len);
        _ = newItems.copyFrom(self.asSlice());
        self.releaseReplacedBlock(allocator, oldBlock, newBlock).?;
        self.resetStorage();
        !.fromBlock(newBlock, len)
    }

    pub fun toOwnedSlice(&self, allocator: &mut mem::Allocator) mem::Error!mem::SliceAllocation[T] {
        let len = self.len();
        if len == 0 or root::builtin::size[T]() == 0 {
            return !.fromBlock(mem::Block::empty(mem::Layout::array[T](len).?), len);
        }

        let layout = mem::Layout::array[T](len).?;
        let block = allocator.alloc(layout).?;
        let mut out = raw::blockItems[T](block, len);
        _ = out.copyFrom(self.asSlice());
        !.fromBlock(block, len)
    }

    pub fun clone(&self, allocator: &mut mem::Allocator) mem::Error!ArrayList[T] {
        let mut cloned = ArrayList[T]::initCapacity(allocator, self.capacity()).?;
        cloned.appendSliceAssumeCapacity(self.asSlice());
        !cloned
    }

    pub fun reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        self.ensureUnusedCapacity(allocator, additional)
    }

    pub fun reserveExact(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        let len = self.len();
        let needed = len.checkedAdd(additional)
            .okOr(mem::Error::OutOfMemory).?;
        self.ensureTotalCapacityPrecise(allocator, needed)
    }

    fun ensureUnusedCapacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        let len = self.len();
        let needed = len.checkedAdd(additional)
            .okOr(mem::Error::OutOfMemory).?;
        self.ensureTotalCapacity(allocator, needed)
    }

    pub fun ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, newCapacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        if newCapacity <= self.capacity() {
            return !();
        }
        let betterCapacity = self.grownCapacity(newCapacity).?;
        self.ensureTotalCapacityPrecise(allocator, betterCapacity)
    }

    fun ensureTotalCapacityPrecise(&mut self, allocator: &mut mem::Allocator, newCapacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        if newCapacity <= self.capacity() {
            return !();
        }
        self.growToCapacity(allocator, newCapacity).?;
        !()
    }

    pub fun shrinkToFit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.shrinkToCapacity(allocator, self.len())
    }

    pub fun shrinkToCapacity(&mut self, allocator: &mut mem::Allocator, minCapacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        let targetCapacity = if minCapacity > self.len() {
            minCapacity
        } else {
            self.len()
        };
        if targetCapacity >= self.capacity() {
            return !();
        }
        if root::builtin::size[T]() == 0 {
            self.capacity = usize::MAX;
            return !();
        }

        let oldBlock = self.allocatedBlock().?;
        if targetCapacity == 0 {
            allocator.free(oldBlock).?;
            self.resetStorage();
            return !();
        }

        let layout = mem::Layout::array[T](targetCapacity).?;
        if allocator.remap(oldBlock, layout) is ?block {
            self.setAllocatedBlock(block, targetCapacity);
            return !();
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, targetCapacity);
        _ = (&mut newItems[0..self.len()]).copyFrom(self.asSlice());
        self.releaseReplacedBlock(allocator, oldBlock, newBlock).?;
        self.setAllocatedBlock(newBlock, targetCapacity);
        !()
    }

    fun grownCapacity(&self, needed: usize) mem::Error!usize {
        if root::builtin::size[T]() == 0 {
            return !usize::MAX;
        }
        let elemLen = root::builtin::size[T]();
        let mut initCapacity = 64 / elemLen;
        if initCapacity == 0 {
            initCapacity = 1;
        }
        (needed / 2).checkedAdd(initCapacity)
            .andThen(\[needed] extra -> needed.checkedAdd(extra))
            .okOr(mem::Error::OutOfMemory)
    }

    fun growToCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        self.freePendingItems(allocator).?;
        if root::builtin::size[T]() == 0 {
            self.capacity = usize::MAX;
            return !();
        }
        let oldBlock = self.allocatedBlock().?;
        let layout = mem::Layout::array[T](capacity).?;
        if allocator.remap(oldBlock, layout) is ?block {
            self.setAllocatedBlock(block, capacity);
            return !();
        }

        let newBlock = allocator.alloc(layout).?;
        let mut newItems = raw::blockItems[T](newBlock, capacity);
        _ = newItems.copyFrom(self.asSlice());
        self.releaseReplacedBlock(allocator, oldBlock, newBlock).?;
        self.setAllocatedBlock(newBlock, capacity);
        !()
    }

    fun freeItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.storageBlock is ?block {
            allocator.free(block).?;
            self.resetStorage();
        }
        !()
    }

    fun freeReplacementItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.replacementBlock is ?block {
            allocator.free(block).?;
            self.replacementBlock = null;
        }
        !()
    }

    pub(super) fun freePendingItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.freeReplacementItems(allocator).?;
        self.freeAliasItems(allocator)
    }

    fun freeAliasItems(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.aliasBlock is ?block {
            allocator.free(block).?;
            self.aliasBlock = null;
        }
        !()
    }

    fun resetStorage(&mut self) () {
        self.items = raw::danglingSlice[T](0);
        self.capacity = 0;
        self.storageBlock = null;
    }

    // Release the previous storage after a replacement copy. If the old block
    // cannot be released, discard the replacement when possible and retain it
    // for a later retry when that cleanup also fails.
    fun releaseReplacedBlock(
        &mut self,
        allocator: &mut mem::Allocator,
        oldBlock: mem::Block,
        newBlock: mem::Block,
    ) mem::Error!() {
        if allocator.free(oldBlock) is error! {
            let oldError = error;
            if allocator.free(newBlock) is error! {
                self.replacementBlock = ?newBlock;
            }
            return oldError!;
        }
        !()
    }

    // Callers drain pending owners and validate their positions first. Only
    // aliased input needs a copy, whose ownership stays here across the callback.
    pub(super) fun withStableSlice(
        &mut self,
        allocator: &mut mem::Allocator,
        values: &[T],
        operation: &Fun(&mut ArrayList[T], &mut mem::Allocator, &[T]) mem::Error!(),
    ) mem::Error!() {
        if not self.slicePointsIntoAllocation(values) {
            return operation(self, allocator, values);
        }
        let copyBlock = allocator.alloc(mem::Layout::array[T](values.len()).?).?;
        let mut copy = copyBlock.asSlice[T]();
        _ = copy.copyFrom(values);
        let result = operation(self, allocator, copy);
        self.finishAliasCopy(allocator, copyBlock, result)
    }

    // Free an alias-stabilizing copy after its operation has completed. The
    // operation error remains primary, while a failed free keeps the block
    // owned by the list so deinit or the next mutating call can retry it.
    fun finishAliasCopy(
        &mut self,
        allocator: &mut mem::Allocator,
        block: mem::Block,
        result: mem::Error!(),
    ) mem::Error!() {
        let cleanup = allocator.free(block);
        if cleanup is error! {
            _ = error;
            self.aliasBlock = ?block;
        }
        result.cleanupAfter(cleanup)
    }

    pub(super) fun allocatedItems(&mut self) &mut [T] {
        let mut ptr = self.items.ptrMut() as &mut T;
        &mut ptr[0..self.capacity]
    }

    fun allocatedBlock(&self) mem::Error!mem::Block {
        if self.storageBlock is ?block {
            return !block;
        }
        if self.capacity == 0 {
            return !mem::Block::empty(mem::Layout::array[T](0).?);
        }
        .Invalid!
    }

    fun setAllocatedBlock(&mut self, block: mem::Block, capacity: usize) () {
        let len = self.len();
        let mut items = raw::blockItems[T](block, capacity);
        self.items = &mut items[0..len];
        self.capacity = capacity;
        self.storageBlock = ?block;
    }

    fun slicePointsIntoAllocation(&self, items: &[T]) bool {
        if items.len() == 0 or self.capacity == 0 or root::builtin::size[T]() == 0 {
            return false;
        }

        let itemSize = root::builtin::size[T]();
        let base = self.items.ptrMut() as usize;
        let ptr = items.ptr() as usize;
        if ptr < base {
            return false;
        }

        let byteOffset = ptr - base;
        if self.capacity.checkedMul(itemSize) is ?allocBytes
            and items.len().checkedMul(itemSize) is ?itemBytes
        {
            byteOffset <= allocBytes and itemBytes <= allocBytes - byteOffset
        } else {
            false
        }
    }
}
