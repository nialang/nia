using pkg::hash;
using pkg::iter::range;
using pkg::mem;
using pkg::os;
using pkg::collections::hash_map::context;
using pkg::collections::hash_map::entries;
using pkg::collections::hash_map::raw;
using pkg::collections::hash_map::types;

using context::DefaultHashMapContext;
using entries::{
    HashMapEntry,
    HashMapEntryMut,
    HashMapEntryRef,
    HashMapGetOrInsertResult,
    HashMapReplacement,
};
using types::{HashMapContext, HashMapLookupContext};

pub struct HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    ctrl: &mut [u8],
    keys: &mut [K],
    values: &mut [V],
    bucketCount: usize,
    len: usize,
    growthLeft: usize,
    seed: u64,
    context: C,
}

extend[K, V] HashMapWithContext[K, V, DefaultHashMapContext]
where K: Sized + Eq[K] + hash::Hash[hash::Wyhash], V: Sized
{
    pub fn init() os::Error!HashMapWithContext[K, V, DefaultHashMapContext] {
        let seed = raw::randomSeed().?;
        !HashMapWithContext[K, V, DefaultHashMapContext]::initSeed(seed)
    }

    pub fn initSeed(seed: u64) HashMapWithContext[K, V, DefaultHashMapContext] {
        HashMapWithContext[K, V, DefaultHashMapContext]::initContextSeed(DefaultHashMapContext::init(), seed)
    }

    pub fn initSeedCapacity(
        allocator: &mut mem::Allocator,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMapWithContext[K, V, DefaultHashMapContext] {
        HashMapWithContext[K, V, DefaultHashMapContext]::initContextSeedCapacity(
            allocator,
            DefaultHashMapContext::init(),
            seed,
            capacity,
        )
    }
}

extend[K, V, C] HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn initContext(context: C) os::Error!HashMapWithContext[K, V, C] {
        let seed = raw::randomSeed().?;
        !HashMapWithContext[K, V, C]::initContextSeed(context, seed)
    }

    pub fn initContextSeed(context: C, seed: u64) HashMapWithContext[K, V, C] {
        {
            ctrl: raw::danglingSlice[u8](),
            keys: raw::danglingSlice[K](),
            values: raw::danglingSlice[V](),
            bucketCount: 0,
            len: 0,
            growthLeft: 0,
            seed: seed,
            context: context,
        }
    }

    pub fn initContextSeedCapacity(
        allocator: &mut mem::Allocator,
        context: C,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMapWithContext[K, V, C] {
        let mut map = HashMapWithContext[K, V, C]::initContextSeed(context, seed);
        map.ensureTotalCapacity(allocator, capacity).?;
        !map
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        let mut result: ?mem::Error = null;
        switch self.freeAllocations(allocator) {
            !ok => {
                _ = ok;
            },
            err! => {
                result = ?err;
            },
        }
        self.ctrl = raw::danglingSlice[u8]();
        self.keys = raw::danglingSlice[K]();
        self.values = raw::danglingSlice[V]();
        self.bucketCount = 0;
        self.len = 0;
        self.growthLeft = 0;
        switch result {
            ?err => {
                err!
            },
            null => {
                !{}
            },
        }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn capacity(&self) usize {
        raw::usableCapacity(self.bucketCount)
    }

    pub fn isEmpty(&self) bool {
        self.len == 0
    }

    pub fn clear(&mut self) void {
        raw::fillCtrl(&mut self.ctrl[0..self.bucketCount], raw::ctrlEmpty);
        raw::mirrorCtrlTail(self.ctrl, self.bucketCount);
        self.len = 0;
        self.growthLeft = self.capacity();
    }

    pub fn shrinkToFit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.shrinkToCapacity(allocator, self.len())
    }

    pub fn shrinkToCapacity(&mut self, allocator: &mut mem::Allocator, minCapacity: usize) mem::Error!void {
        let targetCapacity = raw::maxUsize(self.len(), minCapacity);
        if targetCapacity >= self.capacity() {
            return !{};
        }
        if targetCapacity == 0 {
            self.deinit(allocator).?;
            return !{};
        }

        let target = raw::capacityToBuckets(targetCapacity).?;
        self.rehashToBuckets(allocator, target)
    }

    pub fn compact(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        if self.bucketCapacity() == 0 {
            return !{};
        }
        if self.len() == 0 {
            self.clear();
            return !{};
        }
        self.rehashToBuckets(allocator, self.bucketCapacity())
    }

    pub fn containsKey(&self, key: &K) bool {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                _ = index;
                true
            },
            null => {
                false
            },
        }
    }

    pub fn get(&self, key: &K) ?&V {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?&self.values[index]
            },
            null => {
                null
            },
        }
    }

    pub fn getMut(&mut self, key: &K) ?&mut V {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?&mut self.values[index]
            },
            null => {
                null
            },
        }
    }

    pub fn getEntry(&self, key: &K) ?HashMapEntryRef[K, V] {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?{
                    key: &self.keys[index],
                    value: &self.values[index],
                }
            },
            null => {
                null
            },
        }
    }

    pub fn getEntryMut(&mut self, key: &K) ?HashMapEntryMut[K, V] {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?{
                    key: &self.keys[index],
                    value: &mut self.values[index],
                }
            },
            null => {
                null
            },
        }
    }

    pub fn getKey(&self, key: &K) ?&K {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?&self.keys[index]
            },
            null => {
                null
            },
        }
    }

    pub fn containsKeyBy[Q](&self, query: Q) bool
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            _ = index;
            true
        } else {
            false
        }
    }

    pub fn getBy[Q](&self, query: Q) ?&V
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?&self.values[index]
        } else {
            null
        }
    }

    pub fn getMutBy[Q](&mut self, query: Q) ?&mut V
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?&mut self.values[index]
        } else {
            null
        }
    }

    pub fn getEntryBy[Q](&self, query: Q) ?HashMapEntryRef[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?{ key: &self.keys[index], value: &self.values[index] }
        } else {
            null
        }
    }

    pub fn getEntryMutBy[Q](&mut self, query: Q) ?HashMapEntryMut[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?{ key: &self.keys[index], value: &mut self.values[index] }
        } else {
            null
        }
    }

    pub fn getKeyBy[Q](&self, query: Q) ?&K
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?&self.keys[index]
        } else {
            null
        }
    }

    pub fn clone(&self, allocator: &mut mem::Allocator) mem::Error!HashMapWithContext[K, V, C] {
        let mut cloned = HashMapWithContext[K, V, C]::initContextSeed(self.context, self.seed);
        if self.bucketCapacity() == 0 {
            return !cloned;
        }
        cloned.allocate(allocator, self.bucketCapacity()).?;

        for index in 0..self.bucketCapacity() {
            if raw::isFull(self.ctrl[index]) {
                cloned.insertExisting(self.keys[index], self.values[index]);
            }
        }

        !cloned
    }

    pub fn insert(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!?HashMapReplacement[K, V] {
        let valueHash = self.hashKey(&key);
        switch self.findIndex(&key, valueHash) {
            ?index => {
                let old = self.values[index];
                self.values[index] = value;
                return !?{
                    rejectedKey: key,
                    replacedValue: old,
                };
            },
            null => {
            },
        }

        self.insertNew(allocator, key, value).?;
        !null
    }

    pub fn insertIfAbsent(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!?HashMapEntry[K, V] {
        let valueHash = self.hashKey(&key);
        switch self.findIndex(&key, valueHash) {
            ?index => {
                _ = index;
                return !?{ key: key, value: value };
            },
            null => {
            },
        }

        self.insertNew(allocator, key, value).?;
        !null
    }

    pub fn insertAssumeCapacity(&mut self, key: K, value: V) ?HashMapReplacement[K, V] {
        let valueHash = self.hashKey(&key);
        switch self.findIndex(&key, valueHash) {
            ?index => {
                let old = self.values[index];
                self.values[index] = value;
                return ?{
                    rejectedKey: key,
                    replacedValue: old,
                };
            },
            null => {
            },
        }

        self.insertNewAssumeCapacity(key, value);
        null
    }

    pub fn insertIfAbsentAssumeCapacity(
        &mut self,
        key: K,
        value: V,
    ) ?HashMapEntry[K, V] {
        let valueHash = self.hashKey(&key);
        switch self.findIndex(&key, valueHash) {
            ?index => {
                _ = index;
                return ?{ key: key, value: value };
            },
            null => {
            },
        }

        self.insertNewAssumeCapacity(key, value);
        null
    }

    pub fn getOrInsert(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!HashMapGetOrInsertResult[K, V] {
        let valueHash = self.hashKey(&key);
        switch self.findIndex(&key, valueHash) {
            ?index => {
                return !{
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    rejected: ?{ key: key, value: value },
                };
            },
            null => {
            },
        }

        let index = self.insertNewIndex(allocator, key, value).?;
        !{
            key: &self.keys[index],
            value: &mut self.values[index],
            rejected: null,
        }
    }

    pub fn getOrInsertAssumeCapacity(
        &mut self,
        key: K,
        value: V,
    ) HashMapGetOrInsertResult[K, V] {
        let valueHash = self.hashKey(&key);
        switch self.findIndex(&key, valueHash) {
            ?index => {
                return {
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    rejected: ?{ key: key, value: value },
                };
            },
            null => {
            },
        }

        let index = self.insertNewIndexAssumeCapacity(key, value);
        {
            key: &self.keys[index],
            value: &mut self.values[index],
            rejected: null,
        }
    }

    fn insertNew(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!void {
        _ = self.insertNewIndex(allocator, key, value).?;
        !{}
    }

    fn insertNewIndex(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!usize {
        let slot = self.insertNewUninitializedIndex(allocator, key).?;
        self.values[slot] = value;
        !slot
    }

    fn insertNewUninitializedIndex(&mut self, allocator: &mut mem::Allocator, key: K) mem::Error!usize {
        self.ensureUnusedCapacity(allocator, 1).?;
        let hashAfterGrow = self.hashKey(&key);
        let slot = self.findInsertIndex(hashAfterGrow);
        if self.ctrl[slot] == raw::ctrlEmpty {
            self.growthLeft -= 1;
        }
        self.setCtrl(slot, raw::tag(hashAfterGrow));
        self.keys[slot] = key;
        self.len += 1;
        !slot
    }

    fn insertNewAssumeCapacity(&mut self, key: K, value: V) void {
        let slot = self.insertNewIndexAssumeCapacity(key, value);
        _ = slot;
    }

    fn insertNewIndexAssumeCapacity(&mut self, key: K, value: V) usize {
        let slot = self.insertNewUninitializedIndexAssumeCapacity(key);
        self.values[slot] = value;
        slot
    }

    fn insertNewUninitializedIndexAssumeCapacity(&mut self, key: K) usize {
        if self.growthLeft == 0 {
            std::builtin::trap()
        }
        let valueHash = self.hashKey(&key);
        let slot = self.findInsertIndex(valueHash);
        if self.ctrl[slot] == raw::ctrlEmpty {
            self.growthLeft -= 1;
        }
        self.setCtrl(slot, raw::tag(valueHash));
        self.keys[slot] = key;
        self.len += 1;
        slot
    }

    pub fn remove(&mut self, key: &K) ?V {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                let value = self.values[index];
                self.setCtrl(index, raw::ctrlDeleted);
                self.len -= 1;
                ?value
            },
            null => {
                null
            },
        }
    }

    pub fn removeEntry(&mut self, key: &K) ?HashMapEntry[K, V] {
        switch self.findIndex(key, self.hashKey(key)) {
            ?index => {
                let foundKey = self.keys[index];
                let value = self.values[index];
                self.setCtrl(index, raw::ctrlDeleted);
                self.len -= 1;
                ?{ key: foundKey, value: value }
            },
            null => {
                null
            },
        }
    }

    pub fn removeEntryBy[Q](&mut self, query: Q) ?HashMapEntry[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            let foundKey = self.keys[index];
            let value = self.values[index];
            self.setCtrl(index, raw::ctrlDeleted);
            self.len -= 1;
            ?{ key: foundKey, value: value }
        } else {
            null
        }
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        self.ensureUnusedCapacity(allocator, additional)
    }

    fn ensureUnusedCapacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        if additional <= self.growthLeft {
            return !{};
        }
        let needed = switch self.len.checked_add(additional) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        if needed <= self.capacity() {
            self.rehashToBuckets(allocator, self.bucketCapacity()).?;
            return !{};
        }
        self.growForCapacity(allocator, needed).?;
        !{}
    }

    pub fn ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        if capacity <= self.capacity() {
            return !{};
        }
        self.growForCapacity(allocator, capacity).?;
        !{}
    }

    fn bucketCapacity(&self) usize {
        self.bucketCount
    }

    fn hashKey(&self, key: &K) u64 {
        self.context.hash(self.seed, key)
    }

    fn findIndex(&self, key: &K, valueHash: u64) ?usize {
        self.findQueryIndex[&K](key, valueHash)
    }

    fn findQueryIndex[Q](&self, query: Q, valueHash: u64) ?usize
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.bucketCapacity() == 0 {
            return null;
        }

        let needle = raw::tag(valueHash);
        let mut cursor = raw::ProbeCursor::init(valueHash, self.bucketCapacity());
        while cursor.hasRemaining() {
            let group = raw::ProbeGroup::load(self.ctrl, &cursor, needle);
            let mut matches = group.matchMask;
            while matches != 0 {
                let offset = raw::firstSet(matches);
                let index = cursor.index(offset);
                if self.context.eqlQuery(&self.keys[index], query) {
                    return ?index;
                }
                matches = raw::clearLowestSet(matches);
            }
            if group.emptyMask != 0 {
                return null;
            }
            cursor.advanceGroup();
        }
        null
    }

    fn findInsertIndex(&self, valueHash: u64) usize {
        let mut cursor = raw::ProbeCursor::init(valueHash, self.bucketCapacity());

        while cursor.hasRemaining() {
            let group = raw::ProbeGroup::load(self.ctrl, &cursor, raw::tag(valueHash));
            if group.availableMask != 0 {
                return cursor.index(raw::firstSet(group.availableMask));
            }

            cursor.advanceGroup();
        }

        std::builtin::trap()
    }

    fn growForCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        let target = raw::capacityToBuckets(capacity).?;
        self.rehashToBuckets(allocator, target)
    }

    fn rehashToBuckets(&mut self, allocator: &mut mem::Allocator, target: usize) mem::Error!void {
        let mut newMap = HashMapWithContext[K, V, C]::initContextSeed(self.context, self.seed);
        newMap.allocate(allocator, target).?;

        for index in 0..self.bucketCapacity() {
            if raw::isFull(self.ctrl[index]) {
                let key = self.keys[index];
                let value = self.values[index];
                newMap.insertExisting(key, value);
            }
        }

        let mut oldMap = HashMapWithContext[K, V, C]::initContextSeed(self.context, self.seed);
        oldMap.ctrl = self.ctrl;
        oldMap.keys = self.keys;
        oldMap.values = self.values;
        oldMap.bucketCount = self.bucketCount;
        oldMap.len = self.len;
        oldMap.growthLeft = self.growthLeft;
        self.ctrl = newMap.ctrl;
        self.keys = newMap.keys;
        self.values = newMap.values;
        self.bucketCount = newMap.bucketCount;
        self.len = newMap.len;
        self.growthLeft = newMap.growthLeft;
        newMap.ctrl = raw::danglingSlice[u8]();
        newMap.keys = raw::danglingSlice[K]();
        newMap.values = raw::danglingSlice[V]();
        newMap.bucketCount = 0;
        oldMap.freeAllocations(allocator)
    }

    fn insertExisting(&mut self, key: K, value: V) void {
        let valueHash = self.hashKey(&key);
        let slot = self.findInsertIndex(valueHash);
        self.setCtrl(slot, raw::tag(valueHash));
        self.keys[slot] = key;
        self.values[slot] = value;
        self.len += 1;
        self.growthLeft -= 1;
    }

    pub(pkg) fn setCtrl(&mut self, index: usize, value: u8) void {
        self.ctrl[index] = value;
        if index < raw::groupWidth - 1 {
            self.ctrl[self.bucketCount + index] = value;
        }
    }

    fn allocate(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        let ctrlLen = raw::ctrlAllocationLen(capacity).?;
        let ctrlLayout = mem::Layout::array[u8](ctrlLen).?;
        let keysLayout = mem::Layout::array[K](capacity).?;
        let valuesLayout = mem::Layout::array[V](capacity).?;
        let ctrlBlock = allocator.alloc(ctrlLayout).?;

        if keysLayout.is_empty() {
            self.keys = raw::danglingLenSlice[K](capacity);
        } else {
            switch allocator.alloc(keysLayout) {
                !keysBlock => {
                    self.keys = keysBlock.as_slice[K]();
                },
                err! => {
                    switch allocator.free(ctrlBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {},
                    }
                    return err!;
                },
            }
        }

        if valuesLayout.is_empty() {
            self.values = raw::danglingLenSlice[V](capacity);
        } else {
            switch allocator.alloc(valuesLayout) {
                !valuesBlock => {
                    self.values = valuesBlock.as_slice[V]();
                },
                err! => {
                    if not keysLayout.is_empty() {
                        let keyBlock = mem::Block::init(self.keys.ptr_mut() as &mut u8, keysLayout);
                        switch allocator.free(keyBlock) {
                            !ok => {
                                _ = ok;
                            },
                            error! => {},
                        }
                    }
                    switch allocator.free(ctrlBlock) {
                        !ok => {
                            _ = ok;
                        },
                        error! => {},
                    }
                    self.keys = raw::danglingSlice[K]();
                    return err!;
                },
            }
        }

        self.ctrl = ctrlBlock.as_slice[u8]();
        raw::fillCtrl(self.ctrl, raw::ctrlEmpty);
        self.bucketCount = capacity;
        self.len = 0;
        self.growthLeft = raw::usableCapacity(capacity);
        !{}
    }

    fn freeAllocations(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        let mut firstError: ?mem::Error = null;
        if self.ctrl.len() != 0 {
            let layout = mem::Layout::array[u8](self.ctrl.len()).?;
            switch allocator.free(mem::Block::init(self.ctrl.ptr_mut() as &mut u8, layout)) {
                !ok => {
                    _ = ok;
                },
                err! => {
                    firstError = ?err;
                },
            }
        }
        if self.keys.len() != 0 {
            let layout = mem::Layout::array[K](self.bucketCount).?;
            if not layout.is_empty() {
                switch allocator.free(mem::Block::init(self.keys.ptr_mut() as &mut u8, layout)) {
                    !ok => {
                        _ = ok;
                    },
                    err! => {
                        switch firstError {
                            ?value => {
                                _ = value;
                            },
                            null => {
                                firstError = ?err;
                            },
                        }
                    },
                }
            }
        }
        if self.values.len() != 0 {
            let layout = mem::Layout::array[V](self.bucketCount).?;
            if not layout.is_empty() {
                switch allocator.free(mem::Block::init(self.values.ptr_mut() as &mut u8, layout)) {
                    !ok => {
                        _ = ok;
                    },
                    err! => {
                        switch firstError {
                            ?value => {
                                _ = value;
                            },
                            null => {
                                firstError = ?err;
                            },
                        }
                    },
                }
            }
        }
        switch firstError {
            ?err => {
                err!
            },
            null => {
                !{}
            },
        }
    }
}
