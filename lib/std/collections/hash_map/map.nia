using pkg::error;
using pkg::hash;
using pkg::iter::range;
using pkg::mem;
using pkg::os;
using pkg::collections::hash_map::context;
using pkg::collections::hash_map::entries;
using pkg::collections::hash_map::raw;
using pkg::collections::hash_map::types;

using context::DefaultHashMapContext;
using entries::{
    HashMapEntry,
    HashMapEntryMut,
    HashMapEntryRef,
    HashMapGetOrInsertResult,
    HashMapReplacement,
};
using types::{HashMapContext, HashMapInitError, HashMapLookupContext};

pub struct HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    ctrl: &mut [u8],
    keys: &mut [K],
    values: &mut [V],
    storageBlock: ?mem::Block,
    bucketCount: usize,
    len: usize,
    growthLeft: usize,
    retiredStorageBlock: ?mem::Block,
    seed: u64,
    context: C,
}

struct StoragePlan {
    layout: mem::Layout,
    ctrlLen: usize,
    keysOffset: usize,
    valuesOffset: usize,
}

fn storagePlan[K, V](capacity: usize) mem::Error!StoragePlan
where K: Sized, V: Sized
{
    let ctrlLen = raw::ctrlAllocationLen(capacity).?;
    let keyBytes = match std::builtin::size[K]().checked_mul(capacity) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let valueBytes = match std::builtin::size[V]().checked_mul(capacity) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let keysOffset = match ctrlLen.align_forward(std::builtin::align[K]()) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let afterKeys = match keysOffset.checked_add(keyBytes) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let valuesOffset = match afterKeys.align_forward(std::builtin::align[V]()) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let totalSize = match valuesOffset.checked_add(valueBytes) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let mut blockAlign = std::builtin::align[u8]();
    if std::builtin::align[K]() > blockAlign {
        blockAlign = std::builtin::align[K]();
    }
    if std::builtin::align[V]() > blockAlign {
        blockAlign = std::builtin::align[V]();
    }
    !StoragePlan {
        layout: mem::Layout::init(totalSize, blockAlign).?,
        ctrlLen,
        keysOffset,
        valuesOffset,
    }
}

// Offsets are produced by `storagePlan` and stay within the one allocated
// block. The block alignment is the maximum alignment of every typed view.
fn storageItems[T](block: mem::Block, offset: usize, len: usize) &mut [T]
where T: Sized
{
    let mut ptr = ((block.ptr() as usize) + offset) as &mut T;
    &mut ptr[0..len]
}

extend[K, V] HashMapWithContext[K, V, DefaultHashMapContext]
where K: Sized + Eq[K] + hash::Hash[hash::Wyhash], V: Sized
{
    pub fn init() HashMapWithContext[K, V, DefaultHashMapContext] {
        match HashMapWithContext[K, V, DefaultHashMapContext]::tryInit() {
            !map => map,
            error! => {
                _ = error;
                std::builtin::trap()
            },
        }
    }

    pub fn tryInit() HashMapInitError!HashMapWithContext[K, V, DefaultHashMapContext] {
        let seed = raw::randomSeed().?;
        !HashMapWithContext[K, V, DefaultHashMapContext]::initSeed(seed)
    }

    pub fn initSeed(seed: u64) HashMapWithContext[K, V, DefaultHashMapContext] {
        HashMapWithContext[K, V, DefaultHashMapContext]::initContextSeed(DefaultHashMapContext::init(), seed)
    }

    pub fn initSeedCapacity(
        allocator: &mut mem::Allocator,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMapWithContext[K, V, DefaultHashMapContext] {
        HashMapWithContext[K, V, DefaultHashMapContext]::initContextSeedCapacity(
            allocator,
            DefaultHashMapContext::init(),
            seed,
            capacity,
        )
    }
}

extend[K, V, C] HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn initContext(context: C) HashMapWithContext[K, V, C] {
        match HashMapWithContext[K, V, C]::tryInitContext(context) {
            !map => map,
            error! => {
                _ = error;
                std::builtin::trap()
            },
        }
    }

    pub fn tryInitContext(context: C) HashMapInitError!HashMapWithContext[K, V, C] {
        let seed = raw::randomSeed().?;
        !HashMapWithContext[K, V, C]::initContextSeed(context, seed)
    }

    pub fn initContextSeed(context: C, seed: u64) HashMapWithContext[K, V, C] {
        Self {
            ctrl: raw::danglingSlice[u8](),
            keys: raw::danglingSlice[K](),
            values: raw::danglingSlice[V](),
            storageBlock: null,
            bucketCount: 0,
            len: 0,
            growthLeft: 0,
            retiredStorageBlock: null,
            seed: seed,
            context: context,
        }
    }

    pub fn initContextSeedCapacity(
        allocator: &mut mem::Allocator,
        context: C,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMapWithContext[K, V, C] {
        let mut map = HashMapWithContext[K, V, C]::initContextSeed(context, seed);
        map.ensureTotalCapacity(allocator, capacity).?;
        !map
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let mut firstError: ?mem::Error = null;
        match self.freeAllocations(allocator) {
            !ok => { _ = ok; },
            err! => { firstError = ?err; },
        }
        match self.freeRetiredAllocations(allocator) {
            !ok => { _ = ok; },
            err! => {
                match firstError {
                    ?value => { _ = value; },
                    null => { firstError = ?err; },
                }
            },
        }

        match firstError {
            ?err => err!,
            null => {
                self.ctrl = raw::danglingSlice[u8]();
                self.keys = raw::danglingSlice[K]();
                self.values = raw::danglingSlice[V]();
                self.bucketCount = 0;
                self.len = 0;
                self.growthLeft = 0;
                !()
            },
        }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn capacity(&self) usize {
        raw::usableCapacity(self.bucketCount)
    }

    pub fn isEmpty(&self) bool {
        self.len == 0
    }

    pub fn clear(&mut self) () {
        raw::fillCtrl(&mut self.ctrl[0..self.bucketCount], raw::ctrlEmpty);
        raw::mirrorCtrlTail(self.ctrl, self.bucketCount);
        self.len = 0;
        self.growthLeft = self.capacity();
    }

    pub fn shrinkToFit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.shrinkToCapacity(allocator, self.len())
    }

    pub fn shrinkToCapacity(&mut self, allocator: &mut mem::Allocator, minCapacity: usize) mem::Error!() {
        let targetCapacity = raw::maxUsize(self.len(), minCapacity);
        if targetCapacity >= self.capacity() {
            return !();
        }
        if targetCapacity == 0 {
            self.deinit(allocator).?;
            return !();
        }

        let target = raw::capacityToBuckets(targetCapacity).?;
        self.rehashToBuckets(allocator, target)
    }

    pub fn compact(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.bucketCapacity() == 0 {
            return !();
        }
        if self.len() == 0 {
            self.clear();
            return !();
        }
        self.rehashToBuckets(allocator, self.bucketCapacity())
    }

    pub fn containsKey(&self, key: &K) bool {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                _ = index;
                true
            },
            null => {
                false
            },
        }
    }

    pub fn get(&self, key: &K) ?&V {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?&self.values[index]
            },
            null => {
                null
            },
        }
    }

    pub fn getMut(&mut self, key: &K) ?&mut V {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?&mut self.values[index]
            },
            null => {
                null
            },
        }
    }

    pub fn getEntry(&self, key: &K) ?HashMapEntryRef[K, V] {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?HashMapEntryRef[K, V] {
                    key: &self.keys[index],
                    value: &self.values[index],
                }
            },
            null => {
                null
            },
        }
    }

    pub fn getEntryMut(&mut self, key: &K) ?HashMapEntryMut[K, V] {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?HashMapEntryMut[K, V] {
                    key: &self.keys[index],
                    value: &mut self.values[index],
                }
            },
            null => {
                null
            },
        }
    }

    pub fn getKey(&self, key: &K) ?&K {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                ?&self.keys[index]
            },
            null => {
                null
            },
        }
    }

    pub fn containsKeyBy[Q](&self, query: Q) bool
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            _ = index;
            true
        } else {
            false
        }
    }

    pub fn getBy[Q](&self, query: Q) ?&V
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?&self.values[index]
        } else {
            null
        }
    }

    pub fn getMutBy[Q](&mut self, query: Q) ?&mut V
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?&mut self.values[index]
        } else {
            null
        }
    }

    pub fn getEntryBy[Q](&self, query: Q) ?HashMapEntryRef[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?HashMapEntryRef[K, V] { key: &self.keys[index], value: &self.values[index] }
        } else {
            null
        }
    }

    pub fn getEntryMutBy[Q](&mut self, query: Q) ?HashMapEntryMut[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?HashMapEntryMut[K, V] { key: &self.keys[index], value: &mut self.values[index] }
        } else {
            null
        }
    }

    pub fn getKeyBy[Q](&self, query: Q) ?&K
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            ?&self.keys[index]
        } else {
            null
        }
    }

    pub fn clone(&self, allocator: &mut mem::Allocator) mem::Error!HashMapWithContext[K, V, C] {
        let mut cloned = HashMapWithContext[K, V, C]::initContextSeed(self.context, self.seed);
        if self.bucketCapacity() == 0 {
            return !cloned;
        }
        cloned.allocate(allocator, self.bucketCapacity()).?;

        for index in 0..self.bucketCapacity() {
            if raw::isFull(self.ctrl[index]) {
                cloned.insertExisting(self.keys[index], self.values[index]);
            }
        }

        !cloned
    }

    pub fn insert(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!?HashMapReplacement[K, V] {
        let valueHash = self.hashKey(&key);
        match self.findIndex(&key, valueHash) {
            ?index => {
                let old = self.values[index];
                self.values[index] = value;
                return !?HashMapReplacement[K, V] {
                    rejectedKey: key,
                    replacedValue: old,
                };
            },
            null => {
            },
        }

        self.insertNew(allocator, key, value).?;
        !null
    }

    pub fn insertIfAbsent(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!?HashMapEntry[K, V] {
        let valueHash = self.hashKey(&key);
        match self.findIndex(&key, valueHash) {
            ?index => {
                _ = index;
                return !?HashMapEntry[K, V] { key, value };
            },
            null => {
            },
        }

        self.insertNew(allocator, key, value).?;
        !null
    }

    pub fn insertAssumeCapacity(&mut self, key: K, value: V) ?HashMapReplacement[K, V] {
        let valueHash = self.hashKey(&key);
        match self.findIndex(&key, valueHash) {
            ?index => {
                let old = self.values[index];
                self.values[index] = value;
                return ?HashMapReplacement[K, V] {
                    rejectedKey: key,
                    replacedValue: old,
                };
            },
            null => {
            },
        }

        self.insertNewAssumeCapacity(key, value);
        null
    }

    pub fn insertIfAbsentAssumeCapacity(
        &mut self,
        key: K,
        value: V,
    ) ?HashMapEntry[K, V] {
        let valueHash = self.hashKey(&key);
        match self.findIndex(&key, valueHash) {
            ?index => {
                _ = index;
                return ?HashMapEntry[K, V] { key, value };
            },
            null => {
            },
        }

        self.insertNewAssumeCapacity(key, value);
        null
    }

    pub fn getOrInsert(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!HashMapGetOrInsertResult[K, V] {
        let valueHash = self.hashKey(&key);
        match self.findIndex(&key, valueHash) {
            ?index => {
                return !HashMapGetOrInsertResult[K, V] {
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    rejected: ?HashMapEntry[K, V] { key, value },
                };
            },
            null => {
            },
        }

        let index = self.insertNewIndex(allocator, key, value).?;
        !HashMapGetOrInsertResult[K, V] {
            key: &self.keys[index],
            value: &mut self.values[index],
            rejected: null,
        }
    }

    pub fn getOrInsertAssumeCapacity(
        &mut self,
        key: K,
        value: V,
    ) HashMapGetOrInsertResult[K, V] {
        let valueHash = self.hashKey(&key);
        match self.findIndex(&key, valueHash) {
            ?index => {
                return HashMapGetOrInsertResult[K, V] {
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    rejected: ?HashMapEntry[K, V] { key, value },
                };
            },
            null => {
            },
        }

        let index = self.insertNewIndexAssumeCapacity(key, value);
        HashMapGetOrInsertResult[K, V] {
            key: &self.keys[index],
            value: &mut self.values[index],
            rejected: null,
        }
    }

    fn insertNew(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!() {
        _ = self.insertNewIndex(allocator, key, value).?;
        !()
    }

    fn insertNewIndex(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!usize {
        let slot = self.insertNewUninitializedIndex(allocator, key).?;
        self.values[slot] = value;
        !slot
    }

    fn insertNewUninitializedIndex(&mut self, allocator: &mut mem::Allocator, key: K) mem::Error!usize {
        self.ensureUnusedCapacity(allocator, 1).?;
        let hashAfterGrow = self.hashKey(&key);
        let slot = self.findInsertIndex(hashAfterGrow);
        if self.ctrl[slot] == raw::ctrlEmpty {
            self.growthLeft -= 1;
        }
        self.setCtrl(slot, raw::tag(hashAfterGrow));
        self.keys[slot] = key;
        self.len += 1;
        !slot
    }

    fn insertNewAssumeCapacity(&mut self, key: K, value: V) () {
        let slot = self.insertNewIndexAssumeCapacity(key, value);
        _ = slot;
    }

    fn insertNewIndexAssumeCapacity(&mut self, key: K, value: V) usize {
        let slot = self.insertNewUninitializedIndexAssumeCapacity(key);
        self.values[slot] = value;
        slot
    }

    fn insertNewUninitializedIndexAssumeCapacity(&mut self, key: K) usize {
        if self.len >= self.capacity() {
            std::builtin::trap()
        }
        let valueHash = self.hashKey(&key);
        let slot = self.findInsertIndex(valueHash);
        // A deletion makes logical capacity available without restoring the
        // empty-slot growth budget. A new probe may still reach an empty slot
        // before that tombstone, so keep an exhausted budget saturated at zero.
        if self.ctrl[slot] == raw::ctrlEmpty and self.growthLeft != 0 {
            self.growthLeft -= 1;
        }
        self.setCtrl(slot, raw::tag(valueHash));
        self.keys[slot] = key;
        self.len += 1;
        slot
    }

    pub fn remove(&mut self, key: &K) ?V {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                let value = self.values[index];
                self.setCtrl(index, raw::ctrlDeleted);
                self.len -= 1;
                ?value
            },
            null => {
                null
            },
        }
    }

    pub fn removeEntry(&mut self, key: &K) ?HashMapEntry[K, V] {
        match self.findIndex(key, self.hashKey(key)) {
            ?index => {
                let foundKey = self.keys[index];
                let value = self.values[index];
                self.setCtrl(index, raw::ctrlDeleted);
                self.len -= 1;
                ?HashMapEntry[K, V] { key: foundKey, value }
            },
            null => {
                null
            },
        }
    }

    pub fn removeEntryBy[Q](&mut self, query: Q) ?HashMapEntry[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)) is ?index {
            let foundKey = self.keys[index];
            let value = self.values[index];
            self.setCtrl(index, raw::ctrlDeleted);
            self.len -= 1;
            ?HashMapEntry[K, V] { key: foundKey, value }
        } else {
            null
        }
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        self.ensureUnusedCapacity(allocator, additional)
    }

    fn ensureUnusedCapacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        if additional <= self.growthLeft {
            return !();
        }
        let needed = match self.len.checked_add(additional) {
            ?value => {
                value
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
        if needed <= self.capacity() {
            self.rehashToBuckets(allocator, self.bucketCapacity()).?;
            return !();
        }
        self.growForCapacity(allocator, needed).?;
        !()
    }

    pub fn ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        if capacity <= self.capacity() {
            return !();
        }
        self.growForCapacity(allocator, capacity).?;
        !()
    }

    fn bucketCapacity(&self) usize {
        self.bucketCount
    }

    fn hashKey(&self, key: &K) u64 {
        self.context.hash(self.seed, key)
    }

    fn findIndex(&self, key: &K, valueHash: u64) ?usize {
        self.findQueryIndex[&K](key, valueHash)
    }

    fn findQueryIndex[Q](&self, query: Q, valueHash: u64) ?usize
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.bucketCapacity() == 0 {
            return null;
        }

        let needle = raw::tag(valueHash);
        let mut cursor = raw::ProbeCursor::init(valueHash, self.bucketCapacity());
        while cursor.hasRemaining() {
            let group = raw::ProbeGroup::load(self.ctrl, &cursor, needle);
            let mut matches = group.matchMask;
            while matches != 0 {
                let offset = raw::firstSet(matches);
                let index = cursor.index(offset);
                if self.context.eqlQuery(&self.keys[index], query) {
                    return ?index;
                }
                matches = raw::clearLowestSet(matches);
            }
            if group.emptyMask != 0 {
                return null;
            }
            cursor.advanceGroup();
        }
        null
    }

    fn findInsertIndex(&self, valueHash: u64) usize {
        let mut cursor = raw::ProbeCursor::init(valueHash, self.bucketCapacity());

        while cursor.hasRemaining() {
            let group = raw::ProbeGroup::load(self.ctrl, &cursor, raw::tag(valueHash));
            if group.availableMask != 0 {
                return cursor.index(raw::firstSet(group.availableMask));
            }

            cursor.advanceGroup();
        }

        std::builtin::trap()
    }

    fn growForCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        let target = raw::capacityToBuckets(capacity).?;
        self.rehashToBuckets(allocator, target)
    }

    fn rehashToBuckets(&mut self, allocator: &mut mem::Allocator, target: usize) mem::Error!() {
        self.freeRetiredAllocations(allocator).?;
        let mut newMap = HashMapWithContext[K, V, C]::initContextSeed(self.context, self.seed);
        newMap.allocate(allocator, target).?;

        for index in 0..self.bucketCapacity() {
            if raw::isFull(self.ctrl[index]) {
                let key = self.keys[index];
                let value = self.values[index];
                newMap.insertExisting(key, value);
            }
        }

        self.retiredStorageBlock = self.storageBlock;
        self.ctrl = newMap.ctrl;
        self.keys = newMap.keys;
        self.values = newMap.values;
        self.storageBlock = newMap.storageBlock;
        self.bucketCount = newMap.bucketCount;
        self.len = newMap.len;
        self.growthLeft = newMap.growthLeft;
        newMap.ctrl = raw::danglingSlice[u8]();
        newMap.keys = raw::danglingSlice[K]();
        newMap.values = raw::danglingSlice[V]();
        newMap.storageBlock = null;
        newMap.bucketCount = 0;
        self.freeRetiredAllocations(allocator)
    }

    fn insertExisting(&mut self, key: K, value: V) () {
        let valueHash = self.hashKey(&key);
        let slot = self.findInsertIndex(valueHash);
        self.setCtrl(slot, raw::tag(valueHash));
        self.keys[slot] = key;
        self.values[slot] = value;
        self.len += 1;
        self.growthLeft -= 1;
    }

    pub(pkg) fn setCtrl(&mut self, index: usize, value: u8) () {
        self.ctrl[index] = value;
        if index < raw::groupWidth - 1 {
            self.ctrl[self.bucketCount + index] = value;
        }
    }

    fn allocate(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        let plan = storagePlan[K, V](capacity).?;
        let storage = allocator.alloc(plan.layout).?;
        self.ctrl = storageItems[u8](storage, 0, plan.ctrlLen);
        if std::builtin::size[K]() == 0 {
            self.keys = raw::danglingLenSlice[K](capacity);
        } else {
            self.keys = storageItems[K](storage, plan.keysOffset, capacity);
        }
        if std::builtin::size[V]() == 0 {
            self.values = raw::danglingLenSlice[V](capacity);
        } else {
            self.values = storageItems[V](storage, plan.valuesOffset, capacity);
        }
        self.storageBlock = ?storage;
        raw::fillCtrl(self.ctrl, raw::ctrlEmpty);
        self.bucketCount = capacity;
        self.len = 0;
        self.growthLeft = raw::usableCapacity(capacity);
        !()
    }

    // A failed release leaves the one combined ctrl/key/value owner attached
    // so a caller can retry deinit without losing or double-freeing storage.
    fn freeAllocations(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.storageBlock is ?block {
            allocator.free(block).?;
            self.storageBlock = null;
            self.ctrl = raw::danglingSlice[u8]();
            self.keys = raw::danglingSlice[K]();
            self.values = raw::danglingSlice[V]();
        }
        !()
    }

    fn freeRetiredAllocations(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.retiredStorageBlock is ?block {
            allocator.free(block).?;
            self.retiredStorageBlock = null;
        }
        !()
    }
}

extend os::Error : error::IntoError[HashMapInitError] {
    const fn into_error(self) HashMapInitError {
        HashMapInitError::fromOs(self)
    }
}
