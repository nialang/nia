// Open-addressing hash map: key/value operations and probing.
// Allocation ownership, capacity policy, and rehash live in `storage`.

using root::hash;
using root::mem;
using root::option;
using super::context;
using super::entries;
using super::raw;
using super::storage;
using super::types;

using context::DefaultHashMapContext;
using entries::{
    HashMapEntry,
    HashMapEntryMut,
    HashMapEntryRef,
    HashMapGetOrInsertResult,
    HashMapReplacement,
};
using types::{HashMapContext, HashMapInitError, HashMapLookupContext};

pub struct HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    ctrl: &mut [u8],
    keys: &mut [K],
    values: &mut [V],
    storageBlock: ?mem::Block,
    bucketCount: usize,
    len: usize,
    growthLeft: usize,
    retiredStorageBlock: ?mem::Block,
    seed: u64,
    context: C,
}

extend[K, V] HashMapWithContext[K, V, DefaultHashMapContext]
where K: Sized + Eq[K] + hash::Hash[hash::Wyhash], V: Sized
{
    pub fun init() HashMapWithContext[K, V, DefaultHashMapContext] {
        if HashMapWithContext[K, V, DefaultHashMapContext]::tryInit() is !map {
            return map;
        }
        root::builtin::trap()
    }

    pub fun tryInit() HashMapInitError!HashMapWithContext[K, V, DefaultHashMapContext] {
        let seed = raw::randomSeed().?;
        !HashMapWithContext[K, V, DefaultHashMapContext]::initSeed(seed)
    }

    pub fun initSeed(seed: u64) HashMapWithContext[K, V, DefaultHashMapContext] {
        HashMapWithContext[K, V, DefaultHashMapContext]::initContextSeed(DefaultHashMapContext::init(), seed)
    }

    pub fun initSeedCapacity(
        allocator: &mut mem::Allocator,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMapWithContext[K, V, DefaultHashMapContext] {
        HashMapWithContext[K, V, DefaultHashMapContext]::initContextSeedCapacity(
            allocator,
            DefaultHashMapContext::init(),
            seed,
            capacity,
        )
    }
}

extend[K, V, C] HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fun initContext(context: C) HashMapWithContext[K, V, C] {
        if HashMapWithContext[K, V, C]::tryInitContext(context) is !map {
            return map;
        }
        root::builtin::trap()
    }

    pub fun tryInitContext(context: C) HashMapInitError!HashMapWithContext[K, V, C] {
        let seed = raw::randomSeed().?;
        !HashMapWithContext[K, V, C]::initContextSeed(context, seed)
    }

    pub fun initContextSeed(context: C, seed: u64) HashMapWithContext[K, V, C] {
        .{
            ctrl: raw::danglingSlice[u8](),
            keys: raw::danglingSlice[K](),
            values: raw::danglingSlice[V](),
            storageBlock: null,
            bucketCount: 0,
            len: 0,
            growthLeft: 0,
            retiredStorageBlock: null,
            seed,
            context,
        }
    }

    pub fun initContextSeedCapacity(
        allocator: &mut mem::Allocator,
        context: C,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMapWithContext[K, V, C] {
        let mut map = HashMapWithContext[K, V, C]::initContextSeed(context, seed);
        map.ensureTotalCapacity(allocator, capacity).?;
        !map
    }

    pub fun len(&self) usize {
        self.len
    }

    pub fun capacity(&self) usize {
        raw::usableCapacity(self.bucketCount)
    }

    pub fun isEmpty(&self) bool {
        self.len == 0
    }

    pub fun clear(&mut self) () {
        raw::fillCtrl(&mut self.ctrl[0..self.bucketCount], raw::ctrlEmpty);
        raw::mirrorCtrlTail(self.ctrl, self.bucketCount);
        self.len = 0;
        self.growthLeft = self.capacity();
    }

    pub fun containsKey(&self, key: &K) bool {
        self.findIndex(key, self.hashKey(key)).isPresent()
    }

    pub fun get(&self, key: &K) ?&V {
        let index = self.findIndex(key, self.hashKey(key)).?;
        ?&self.values[index]
    }

    pub fun getMut(&mut self, key: &K) ?&mut V {
        let index = self.findIndex(key, self.hashKey(key)).?;
        ?&mut self.values[index]
    }

    pub fun getEntry(&self, key: &K) ?HashMapEntryRef[K, V] {
        let index = self.findIndex(key, self.hashKey(key)).?;
        ?.{ key: &self.keys[index], value: &self.values[index] }
    }

    pub fun getEntryMut(&mut self, key: &K) ?HashMapEntryMut[K, V] {
        let index = self.findIndex(key, self.hashKey(key)).?;
        ?.{ key: &self.keys[index], value: &mut self.values[index] }
    }

    pub fun getKey(&self, key: &K) ?&K {
        let index = self.findIndex(key, self.hashKey(key)).?;
        ?&self.keys[index]
    }

    pub fun containsKeyBy[Q](&self, query: Q) bool
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)).isPresent()
    }

    pub fun getBy[Q](&self, query: Q) ?&V
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        let index = self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)).?;
        ?&self.values[index]
    }

    pub fun getMutBy[Q](&mut self, query: Q) ?&mut V
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        let index = self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)).?;
        ?&mut self.values[index]
    }

    pub fun getEntryBy[Q](&self, query: Q) ?HashMapEntryRef[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        let index = self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)).?;
        ?.{ key: &self.keys[index], value: &self.values[index] }
    }

    pub fun getEntryMutBy[Q](&mut self, query: Q) ?HashMapEntryMut[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        let index = self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)).?;
        ?.{ key: &self.keys[index], value: &mut self.values[index] }
    }

    pub fun getKeyBy[Q](&self, query: Q) ?&K
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        let index = self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)).?;
        ?&self.keys[index]
    }

    pub fun insert(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!?HashMapReplacement[K, V] {
        let valueHash = self.hashKey(&key);
        if self.findIndex(&key, valueHash) is ?index {
            let old = self.values[index];
            self.values[index] = value;
            return !?.{
                rejectedKey: key,
                replacedValue: old,
            };
        }

        self.insertNew(allocator, key, value).?;
        !null
    }

    pub fun insertIfAbsent(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!?HashMapEntry[K, V] {
        let valueHash = self.hashKey(&key);
        if self.findIndex(&key, valueHash) is ?_ {
            return !?.{ key, value };
        }

        self.insertNew(allocator, key, value).?;
        !null
    }

    pub fun insertAssumeCapacity(&mut self, key: K, value: V) ?HashMapReplacement[K, V] {
        let valueHash = self.hashKey(&key);
        if self.findIndex(&key, valueHash) is ?index {
            let old = self.values[index];
            self.values[index] = value;
            return ?.{
                rejectedKey: key,
                replacedValue: old,
            };
        }

        self.insertNewAssumeCapacity(key, value);
        null
    }

    pub fun insertIfAbsentAssumeCapacity(
        &mut self,
        key: K,
        value: V,
    ) ?HashMapEntry[K, V] {
        let valueHash = self.hashKey(&key);
        if self.findIndex(&key, valueHash) is ?_ {
            return ?.{ key, value };
        }

        self.insertNewAssumeCapacity(key, value);
        null
    }

    pub fun getOrInsert(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!HashMapGetOrInsertResult[K, V] {
        let valueHash = self.hashKey(&key);
        if self.findIndex(&key, valueHash) is ?index {
            return !.{
                key: &self.keys[index],
                value: &mut self.values[index],
                rejected: ?.{ key, value },
            };
        }

        let index = self.insertNewIndex(allocator, key, value).?;
        !.{
            key: &self.keys[index],
            value: &mut self.values[index],
            rejected: null,
        }
    }

    pub fun getOrInsertAssumeCapacity(
        &mut self,
        key: K,
        value: V,
    ) HashMapGetOrInsertResult[K, V] {
        let valueHash = self.hashKey(&key);
        if self.findIndex(&key, valueHash) is ?index {
            return .{
                key: &self.keys[index],
                value: &mut self.values[index],
                rejected: ?.{ key, value },
            };
        }

        let index = self.insertNewIndexAssumeCapacity(key, value);
        .{
            key: &self.keys[index],
            value: &mut self.values[index],
            rejected: null,
        }
    }

    fun insertNew(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!() {
        _ = self.insertNewIndex(allocator, key, value).?;
        !()
    }

    fun insertNewIndex(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!usize {
        let slot = self.insertNewUninitializedIndex(allocator, key).?;
        self.values[slot] = value;
        !slot
    }

    fun insertNewUninitializedIndex(&mut self, allocator: &mut mem::Allocator, key: K) mem::Error!usize {
        self.ensureUnusedCapacity(allocator, 1).?;
        let hashAfterGrow = self.hashKey(&key);
        let slot = self.findInsertIndex(hashAfterGrow);
        if self.ctrl[slot] == raw::ctrlEmpty {
            self.growthLeft -= 1;
        }
        self.setCtrl(slot, raw::tag(hashAfterGrow));
        self.keys[slot] = key;
        self.len += 1;
        !slot
    }

    fun insertNewAssumeCapacity(&mut self, key: K, value: V) () {
        _ = self.insertNewIndexAssumeCapacity(key, value);
    }

    fun insertNewIndexAssumeCapacity(&mut self, key: K, value: V) usize {
        let slot = self.insertNewUninitializedIndexAssumeCapacity(key);
        self.values[slot] = value;
        slot
    }

    fun insertNewUninitializedIndexAssumeCapacity(&mut self, key: K) usize {
        if self.len >= self.capacity() {
            root::builtin::trap()
        }
        let valueHash = self.hashKey(&key);
        let slot = self.findInsertIndex(valueHash);
        // A deletion makes logical capacity available without restoring the
        // empty-slot growth budget. A new probe may still reach an empty slot
        // before that tombstone, so keep an exhausted budget saturated at zero.
        if self.ctrl[slot] == raw::ctrlEmpty and self.growthLeft != 0 {
            self.growthLeft -= 1;
        }
        self.setCtrl(slot, raw::tag(valueHash));
        self.keys[slot] = key;
        self.len += 1;
        slot
    }

    pub fun remove(&mut self, key: &K) ?V {
        ?self.removeEntry(key).?.intoValue()
    }

    pub fun removeEntry(&mut self, key: &K) ?HashMapEntry[K, V] {
        let index = self.findIndex(key, self.hashKey(key)).?;
        ?self.removeIndex(index)
    }

    pub fun removeEntryBy[Q](&mut self, query: Q) ?HashMapEntry[K, V]
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        let index = self.findQueryIndex[Q](query, self.context.hashQuery(self.seed, query)).?;
        ?self.removeIndex(index)
    }

    pub(super) fun removeIndex(&mut self, index: usize) HashMapEntry[K, V] {
        let entry = HashMapEntry[K, V] { key: self.keys[index], value: self.values[index] };
        self.setCtrl(index, raw::ctrlDeleted);
        self.len -= 1;
        entry
    }

    pub(super) fun bucketCapacity(&self) usize {
        self.bucketCount
    }

    pub(super) fun hashKey(&self, key: &K) u64 {
        self.context.hash(self.seed, key)
    }

    fun findIndex(&self, key: &K, valueHash: u64) ?usize {
        self.findQueryIndex[&K](key, valueHash)
    }

    fun findQueryIndex[Q](&self, query: Q, valueHash: u64) ?usize
    where Q: Sized, C: HashMapLookupContext[K, Q]
    {
        if self.bucketCapacity() == 0 {
            return null;
        }

        let needle = raw::tag(valueHash);
        let mut cursor = raw::ProbeCursor::init(valueHash, self.bucketCapacity());
        while cursor.hasRemaining() {
            let group = raw::ProbeGroup::load(self.ctrl, &cursor, needle);
            let mut matches = group.matchMask;
            while matches != 0 {
                let offset = raw::firstSet(matches);
                let index = cursor.index(offset);
                if self.context.eqlQuery(&self.keys[index], query) {
                    return ?index;
                }
                matches = raw::clearLowestSet(matches);
            }
            if group.emptyMask != 0 {
                return null;
            }
            cursor.advanceGroup();
        }
        null
    }

    pub(super) fun findInsertIndex(&self, valueHash: u64) usize {
        let mut cursor = raw::ProbeCursor::init(valueHash, self.bucketCapacity());

        while cursor.hasRemaining() {
            let group = raw::ProbeGroup::load(self.ctrl, &cursor, raw::tag(valueHash));
            if group.availableMask != 0 {
                return cursor.index(raw::firstSet(group.availableMask));
            }

            cursor.advanceGroup();
        }

        root::builtin::trap()
    }

    pub(super) fun setCtrl(&mut self, index: usize, value: u8) () {
        self.ctrl[index] = value;
        if index < raw::groupWidth - 1 {
            self.ctrl[self.bucketCount + index] = value;
        }
    }
}
