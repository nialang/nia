using pkg::math;
using pkg::mem;
using pkg::os;

pub const ctrl_empty: u8 = 0xffu8;
pub const ctrl_deleted: u8 = 0x80u8;
pub const group_width: usize = 8usize;

pub struct ProbeCursor {
    pos: usize,
    stride: usize,
    visited: usize,
    capacity: usize,
}

pub struct ProbeGroup {
    match_mask: usize,
    empty_mask: usize,
    available_mask: usize,
}

extend ProbeGroup {
    pub fn load(ctrl: &[u8], cursor: &ProbeCursor, needle: u8) ProbeGroup {
        let bytes = std::builtin::load_unaligned[u8x8](&ctrl[cursor.pos]);

        let match_mask = std::builtin::bitmask(bytes == std::builtin::splat[u8x8](needle));
        let empty_mask = std::builtin::bitmask(bytes == std::builtin::splat[u8x8](ctrl_empty));
        let deleted_mask = std::builtin::bitmask(bytes == std::builtin::splat[u8x8](ctrl_deleted));

        {
            match_mask: match_mask,
            empty_mask: empty_mask,
            available_mask: empty_mask | deleted_mask,
        }
    }
}

extend ProbeCursor {
    pub fn init(value_hash: u64, capacity: usize) ProbeCursor {
        let mask = capacity - 1usize;
        {
            pos: (value_hash as usize) & mask,
            stride: 0usize,
            visited: 0usize,
            capacity: capacity,
        }
    }

    pub fn has_remaining(&self) bool {
        self.visited < self.capacity
    }

    pub fn index(&self, offset: usize) usize {
        (self.pos + offset) & (self.capacity - 1usize)
    }

    pub fn advance_group(&mut self) void {
        self.stride += group_width;
        self.pos = (self.pos + self.stride) & (self.capacity - 1usize);
        self.visited += group_width;
    }
}

pub fn dangling_slice[T]() &mut [T]
where T: Sized
{
    let mut ptr = std::builtin::align[T]() as &mut T;
    &mut ptr[0..0]
}

pub fn dangling_len_slice[T](len: usize) &mut [T]
where T: Sized
{
    let mut ptr = std::builtin::align[T]() as &mut T;
    &mut ptr[0..len]
}

pub fn random_seed() os::Error!u64 {
    let mut bytes: [8]u8 = [0; 8];
    os::random(&mut bytes[..]).?;
    !read_u64(&bytes[..])
}

pub fn read_u64(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64)
        | ((bytes[4] as u64) << 32u64)
        | ((bytes[5] as u64) << 40u64)
        | ((bytes[6] as u64) << 48u64)
        | ((bytes[7] as u64) << 56u64)
}

pub fn tag(value_hash: u64) u8 {
    ((value_hash >> 57u64) as u8) & 0x7fu8
}

pub fn is_full(control: u8) bool {
    (control & 0x80u8) == 0u8
}

pub fn first_set(mask: usize) usize {
    std::builtin::ctz[usize](mask)
}

pub fn clear_lowest_set(mask: usize) usize {
    mask & (mask - 1usize)
}

pub fn ctrl_allocation_len(capacity: usize) mem::Error!usize {
    if capacity == 0usize {
        return !0usize;
    }
    switch capacity.checked_add(group_width - 1usize) {
        ?value => {
            !value
        },
        null => {
            mem::Error::OutOfMemory!
        },
    }
}

pub fn mirror_ctrl_tail(ctrl: &mut [u8], bucket_count: usize) void {
    if bucket_count == 0usize {
        return;
    }
    let mut index = 0usize;
    while index < group_width - 1usize {
        ctrl[bucket_count + index] = ctrl[index];
        index += 1usize;
    }
}

pub fn fill_ctrl(ctrl: &mut [u8], value: u8) void {
    let mut index = 0usize;
    while index < ctrl.len() {
        ctrl[index] = value;
        index += 1usize;
    }
}

pub fn usable_capacity(buckets: usize) usize {
    if buckets == 0usize {
        0usize
    } else if buckets < 8usize {
        buckets - 1usize
    } else {
        (buckets / 8usize) * 7usize
    }
}

pub fn capacity_to_buckets(capacity: usize) mem::Error!usize {
    if capacity == 0usize {
        return !0usize;
    }
    if capacity <= 7usize {
        return !8usize;
    }
    if capacity <= 14usize {
        return !16usize;
    }

    let multiplied = switch capacity.checked_mul(8usize) {
        ?value => {
            value
        },
        null => {
            return mem::Error::OutOfMemory!;
        },
    };
    let biased = switch multiplied.checked_add(6usize) {
        ?value => {
            value
        },
        null => {
            return mem::Error::OutOfMemory!;
        },
    };
    let adjusted = biased / 7usize;
    next_power_of_two(adjusted)
}

pub fn max_usize(left: usize, right: usize) usize {
    if left > right {
        left
    } else {
        right
    }
}

pub fn next_power_of_two(value: usize) mem::Error!usize {
    let mut n = 1usize;
    while n < value {
        n = switch n.checked_mul(2usize) {
            ?next => {
                next
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
    }
    !n
}
