using root::iter::range;
using root::math;
using root::mem;
using root::os;
using root::option;
using root::slice;

pub const ctrlEmpty: u8 = 0xff;
pub const ctrlDeleted: u8 = 0x80;
pub const groupWidth: usize = 8;

pub struct ProbeCursor {
    pos: usize,
    stride: usize,
    visited: usize,
    capacity: usize,
}

pub struct ProbeGroup {
    matchMask: usize,
    emptyMask: usize,
    availableMask: usize,
}

extend ProbeGroup {
    pub fun load(ctrl: &[u8], cursor: &ProbeCursor, needle: u8) ProbeGroup {
        let bytes = root::builtin::loadUnaligned[u8x8](&ctrl[cursor.pos]);

        let matchMask = root::builtin::bitmask(bytes == root::builtin::splat[u8x8](needle));
        let emptyMask = root::builtin::bitmask(bytes == root::builtin::splat[u8x8](ctrlEmpty));
        let deletedMask = root::builtin::bitmask(bytes == root::builtin::splat[u8x8](ctrlDeleted));

        .{ matchMask, emptyMask, availableMask: emptyMask | deletedMask }
    }
}

extend ProbeCursor {
    pub fun init(valueHash: u64, capacity: usize) ProbeCursor {
        if capacity < groupWidth or not capacity.isPowerOfTwo() {
            return .{
                pos: 0,
                stride: 0,
                visited: 0,
                capacity: 0,
            };
        }
        let mask = capacity - 1;
        .{ pos: (valueHash as usize) & mask, stride: 0, visited: 0, capacity }
    }

    pub fun hasRemaining(&self) bool {
        self.visited < self.capacity
    }

    pub fun index(&self, offset: usize) usize {
        if self.capacity == 0 {
            root::builtin::trap()
        }
        addMod(self.pos, offset, self.capacity)
    }

    pub fun advanceGroup(&mut self) () {
        if self.capacity == 0 or self.visited >= self.capacity {
            return;
        }
        self.stride = addMod(self.stride, groupWidth, self.capacity);
        self.pos = addMod(self.pos, self.stride, self.capacity);
        // Valid capacities and the visited count are multiples of groupWidth;
        // this step cannot pass capacity or overflow while hasRemaining holds.
        self.visited += groupWidth;
    }
}

// Probe capacities are powers of two. This computes `(value + offset) %
// capacity` without forming an overflowing host-width sum before masking.
fun addMod(value: usize, offset: usize, capacity: usize) usize {
    let mask = capacity - 1;
    let left = value & mask;
    let right = offset & mask;
    let complement = capacity - right;
    if left >= complement {
        left - complement
    } else {
        left + right
    }
}

pub fun danglingSlice[T]() &mut [T]
where T: Sized
{
    let mut ptr = root::builtin::align[T]() as &mut T;
    &mut ptr[0..0]
}

pub fun danglingLenSlice[T](len: usize) &mut [T]
where T: Sized
{
    let mut ptr = root::builtin::align[T]() as &mut T;
    &mut ptr[0..len]
}

pub fun randomSeed() os::Error!u64 {
    let mut bytes: [u8; 8] = [0; 8];
    os::random(&mut bytes[..]).?;
    !readU64(&bytes[..])
}

pub fun readU64(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8)
        | ((bytes[2] as u64) << 16)
        | ((bytes[3] as u64) << 24)
        | ((bytes[4] as u64) << 32)
        | ((bytes[5] as u64) << 40)
        | ((bytes[6] as u64) << 48)
        | ((bytes[7] as u64) << 56)
}

pub fun tag(valueHash: u64) u8 {
    ((valueHash >> 57) as u8) & 0x7f
}

pub fun isFull(control: u8) bool {
    (control & 0x80) == 0
}

pub fun firstSet(mask: usize) usize {
    root::builtin::ctz[usize](mask)
}

pub fun clearLowestSet(mask: usize) usize {
    mask & (mask - 1)
}

pub fun ctrlAllocationLen(capacity: usize) mem::Error!usize {
    if capacity == 0 {
        return !0;
    }
    capacity.checkedAdd(groupWidth - 1).okOr(mem::Error::OutOfMemory)
}

pub fun mirrorCtrlTail(ctrl: &mut [u8], bucketCount: usize) () {
    if bucketCount == 0 {
        return;
    }
    for index in 0..(groupWidth - 1) {
        ctrl[bucketCount + index] = ctrl[index];
    }
}

pub fun fillCtrl(ctrl: &mut [u8], value: u8) () {
    for slot in ctrl.iterMut() {
        slot.* = value;
    }
}

pub fun usableCapacity(buckets: usize) usize {
    if buckets == 0 {
        0
    } else if buckets < 8 {
        buckets - 1
    } else {
        (buckets / 8) * 7
    }
}

pub fun capacityToBuckets(capacity: usize) mem::Error!usize {
    if capacity == 0 {
        return !0;
    }
    if capacity <= 7 {
        return !8;
    }
    if capacity <= 14 {
        return !16;
    }

    // ceil(capacity * 8 / 7) = capacity + ceil(capacity / 7).
    // Divide first so a representable bucket count is not rejected because
    // the intermediate product overflows. The quotient plus one always fits.
    let extra = capacity / 7 + if capacity % 7 == 0 { 0usize } else { 1usize };
    let adjusted = capacity.checkedAdd(extra).okOr(mem::Error::OutOfMemory).?;
    nextPowerOfTwo(adjusted)
}

pub fun nextPowerOfTwo(value: usize) mem::Error!usize {
    let mut n: usize = 1;
    while n < value {
        n = n.checkedMul(2).okOr(mem::Error::OutOfMemory).?;
    }
    !n
}
