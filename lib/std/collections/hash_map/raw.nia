using pkg::iter::range;
using pkg::math;
using pkg::mem;
using pkg::os;

pub const ctrlEmpty: u8 = 0xff;
pub const ctrlDeleted: u8 = 0x80;
pub const groupWidth: usize = 8;

pub struct ProbeCursor {
    pos: usize,
    stride: usize,
    visited: usize,
    capacity: usize,
}

pub struct ProbeGroup {
    matchMask: usize,
    emptyMask: usize,
    availableMask: usize,
}

extend ProbeGroup {
    pub fn load(ctrl: &[u8], cursor: &ProbeCursor, needle: u8) ProbeGroup {
        let bytes = std::builtin::loadUnaligned[u8x8](&ctrl[cursor.pos]);

        let matchMask = std::builtin::bitmask(bytes == std::builtin::splat[u8x8](needle));
        let emptyMask = std::builtin::bitmask(bytes == std::builtin::splat[u8x8](ctrlEmpty));
        let deletedMask = std::builtin::bitmask(bytes == std::builtin::splat[u8x8](ctrlDeleted));

        .{ matchMask, emptyMask, availableMask: emptyMask | deletedMask }
    }
}

extend ProbeCursor {
    pub fn init(valueHash: u64, capacity: usize) ProbeCursor {
        if capacity < groupWidth or not capacity.isPowerOfTwo() {
            return .{
                pos: 0,
                stride: 0,
                visited: 0,
                capacity: 0,
            };
        }
        let mask = capacity - 1;
        .{ pos: (valueHash as usize) & mask, stride: 0, visited: 0, capacity }
    }

    pub fn hasRemaining(&self) bool {
        self.visited < self.capacity
    }

    pub fn index(&self, offset: usize) usize {
        if self.capacity == 0 {
            std::builtin::trap()
        }
        addMod(self.pos, offset, self.capacity)
    }

    pub fn advanceGroup(&mut self) () {
        if self.capacity == 0 or self.visited >= self.capacity {
            return;
        }
        self.stride = addMod(self.stride, groupWidth, self.capacity);
        self.pos = addMod(self.pos, self.stride, self.capacity);
        self.visited = match self.visited.checkedAdd(groupWidth) {
            ?value => {
                if value > self.capacity { self.capacity } else { value }
            },
            null => {
                self.capacity
            },
        };
    }
}

// Probe capacities are powers of two. This computes `(value + offset) %
// capacity` without forming an overflowing host-width sum before masking.
fn addMod(value: usize, offset: usize, capacity: usize) usize {
    let mask = capacity - 1;
    let left = value & mask;
    let right = offset & mask;
    let complement = capacity - right;
    if left >= complement {
        left - complement
    } else {
        left + right
    }
}

pub fn danglingSlice[T]() &mut [T]
where T: Sized
{
    let mut ptr = std::builtin::align[T]() as &mut T;
    &mut ptr[0..0]
}

pub fn danglingLenSlice[T](len: usize) &mut [T]
where T: Sized
{
    let mut ptr = std::builtin::align[T]() as &mut T;
    &mut ptr[0..len]
}

pub fn randomSeed() os::Error!u64 {
    let mut bytes: [u8; 8] = [0; 8];
    os::random(&mut bytes[..]).?;
    !readU64(&bytes[..])
}

pub fn readU64(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64)
        | ((bytes[4] as u64) << 32u64)
        | ((bytes[5] as u64) << 40u64)
        | ((bytes[6] as u64) << 48u64)
        | ((bytes[7] as u64) << 56u64)
}

pub fn tag(valueHash: u64) u8 {
    ((valueHash >> 57u64) as u8) & 0x7f
}

pub fn isFull(control: u8) bool {
    (control & 0x80) == 0
}

pub fn firstSet(mask: usize) usize {
    std::builtin::ctz[usize](mask)
}

pub fn clearLowestSet(mask: usize) usize {
    mask & (mask - 1)
}

pub fn ctrlAllocationLen(capacity: usize) mem::Error!usize {
    if capacity == 0 {
        return !0;
    }
    match capacity.checkedAdd(groupWidth - 1) {
        ?value => {
            !value
        },
        null => {
            mem::Error::OutOfMemory!
        },
    }
}

pub fn mirrorCtrlTail(ctrl: &mut [u8], bucketCount: usize) () {
    if bucketCount == 0 {
        return;
    }
    for index in 0..(groupWidth - 1) {
        ctrl[bucketCount + index] = ctrl[index];
    }
}

pub fn fillCtrl(ctrl: &mut [u8], value: u8) () {
    for index in 0..ctrl.len() {
        ctrl[index] = value;
    }
}

pub fn usableCapacity(buckets: usize) usize {
    if buckets == 0 {
        0
    } else if buckets < 8 {
        buckets - 1
    } else {
        (buckets / 8) * 7
    }
}

pub fn capacityToBuckets(capacity: usize) mem::Error!usize {
    if capacity == 0 {
        return !0;
    }
    if capacity <= 7 {
        return !8;
    }
    if capacity <= 14 {
        return !16;
    }

    let multiplied = match capacity.checkedMul(8) {
        ?value => {
            value
        },
        null => {
            return mem::Error::OutOfMemory!;
        },
    };
    let biased = match multiplied.checkedAdd(6) {
        ?value => {
            value
        },
        null => {
            return mem::Error::OutOfMemory!;
        },
    };
    let adjusted = biased / 7;
    nextPowerOfTwo(adjusted)
}

pub fn nextPowerOfTwo(value: usize) mem::Error!usize {
    let mut n: usize = 1;
    while n < value {
        n = match n.checkedMul(2) {
            ?next => {
                next
            },
            null => {
                return mem::Error::OutOfMemory!;
            },
        };
    }
    !n
}
