pub struct HashMapEntry[K, V]
where K: Sized, V: Sized
{
    key: K,
    value: V,
}

pub struct HashMapEntryRef[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &V,
}

pub struct HashMapEntryMut[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &mut V,
}

pub struct HashMapGetOrInsertResult[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &mut V,
    rejected: ?HashMapEntry[K, V],
}

pub struct HashMapReplacement[K, V]
where K: Sized, V: Sized
{
    rejectedKey: K,
    replacedValue: V,
}

extend[K, V] HashMapEntry[K, V]
where K: Sized, V: Sized
{
    pub fun key(&self) &K {
        &self.key
    }

    pub fun value(&self) &V {
        &self.value
    }

    pub fun keyMut(&mut self) &mut K {
        &mut self.key
    }

    pub fun valueMut(&mut self) &mut V {
        &mut self.value
    }

    pub fun intoKey(self) K {
        self.key
    }

    pub fun intoValue(self) V {
        self.value
    }
}

extend[K, V] HashMapEntryRef[K, V]
where K: Sized, V: Sized
{
    pub fun key(&self) &K {
        self.key
    }

    pub fun value(&self) &V {
        self.value
    }
}

extend[K, V] HashMapEntryMut[K, V]
where K: Sized, V: Sized
{
    pub fun key(&self) &K {
        self.key
    }

    pub fun value(&self) &V {
        self.value
    }

    pub fun valueMut(&mut self) &mut V {
        self.value
    }
}

extend[K, V] HashMapGetOrInsertResult[K, V]
where K: Sized, V: Sized
{
    pub fun key(&self) &K {
        self.key
    }

    pub fun value(&mut self) &mut V {
        self.value
    }

    pub fun intoRejected(self) ?HashMapEntry[K, V] {
        self.rejected
    }
}

extend[K, V] HashMapReplacement[K, V]
where K: Sized, V: Sized
{
    pub fun rejectedKey(&self) &K {
        &self.rejectedKey
    }

    pub fun replacedValue(&self) &V {
        &self.replacedValue
    }

    pub fun rejectedKeyMut(&mut self) &mut K {
        &mut self.rejectedKey
    }

    pub fun replacedValueMut(&mut self) &mut V {
        &mut self.replacedValue
    }

    pub fun intoRejectedKey(self) K {
        self.rejectedKey
    }

    pub fun intoReplacedValue(self) V {
        self.replacedValue
    }
}
