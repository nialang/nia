pub struct HashMapEntry[K, V]
where K: Sized, V: Sized
{
    key: K,
    value: V,
}

pub struct HashMapEntryRef[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &V,
}

pub struct HashMapEntryMut[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &mut V,
}

pub struct HashMapGetOrInsertResult[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &mut V,
    rejected: ?HashMapEntry[K, V],
}

pub struct HashMapReplacement[K, V]
where K: Sized, V: Sized
{
    rejectedKey: K,
    replacedValue: V,
}

extend[K, V] HashMapEntry[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        &self.key
    }

    pub fn value(&self) &V {
        &self.value
    }

    pub fn intoKey(self) K {
        self.key
    }

    pub fn intoValue(self) V {
        self.value
    }
}

extend[K, V] HashMapEntryRef[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        self.key
    }

    pub fn value(&self) &V {
        self.value
    }
}

extend[K, V] HashMapEntryMut[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        self.key
    }

    pub fn value(&self) &V {
        self.value
    }

    pub fn valueMut(&mut self) &mut V {
        self.value
    }
}

extend[K, V] HashMapGetOrInsertResult[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        self.key
    }

    pub fn value(&mut self) &mut V {
        self.value
    }

    pub fn intoRejected(self) ?HashMapEntry[K, V] {
        self.rejected
    }
}

extend[K, V] HashMapReplacement[K, V]
where K: Sized, V: Sized
{
    pub fn rejectedKey(&self) &K {
        &self.rejectedKey
    }

    pub fn replacedValue(&self) &V {
        &self.replacedValue
    }

    pub fn intoRejectedKey(self) K {
        self.rejectedKey
    }

    pub fn intoReplacedValue(self) V {
        self.replacedValue
    }
}
