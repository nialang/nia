pub enum HashMapInitError: i32 {
    PermissionDenied = 1,
    Io = 5,
    Again = 11,
    Fault = 14,
    Invalid = 22,
    System = 255,
    _,
}

pub trait HashMapContext[K] {
    fun hash(&self, seed: u64, key: &K) u64;
    fun eql(&self, left: &K, right: &K) bool;
}

pub trait HashMapLookupContext[K, Q] {
    fun hashQuery(&self, seed: u64, query: Q) u64;
    fun eqlQuery(&self, key: &K, query: Q) bool;
}

extend[K, C] C : HashMapLookupContext[K, &K]
where K: Sized, C: HashMapContext[K]
{
    fun hashQuery(&self, seed: u64, query: &K) u64 {
        self.hash(seed, query)
    }

    fun eqlQuery(&self, key: &K, query: &K) bool {
        self.eql(key, query)
    }
}
