using pkg::fmt;
using pkg::collections::hash_map::iterators;
using pkg::collections::hash_map::map;
using pkg::collections::hash_map::types;

using map::HashMapWithContext;
using types::HashMapContext;

extend[K, V, C] HashMapWithContext[K, V, C] : fmt::Format
where K: Sized + fmt::Format, V: Sized + fmt::Format, C: HashMapContext[K]
{
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        formatter.write_byte(b'{').?;
        let mut first = true;
        for entry in self.iter() {
            if first {
                first = false;
            } else {
                formatter.write_text(&", ").?;
            }
            entry.key().*.format(formatter).?;
            formatter.write_text(&": ").?;
            entry.value().*.format(formatter).?;
        }
        formatter.write_byte(b'}')
    }
}
