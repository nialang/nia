// Open-addressing hash map with allocator-explicit storage.
//
// Control bytes, keys, and values share one aligned storage block. Rehash
// keeps the replaced block as a map-owned retired allocation until its release
// succeeds; a failed release leaves the active table usable but requires
// cleanup retry before a later rehash or the final `deinit`.
//
// Capacity counts logical entries, including slots made reusable by deletion.
// `insertAssumeCapacity` therefore requires `len < capacity`, not an unused
// physical empty-slot budget; it may reuse an empty or a deleted control slot
// without allocating.

using root::cmp;
using root::error;
using root::iter::range;
using root::mem;
using root::mem::layout::LayoutBuilder;
using root::option;
using root::slice;
using super::map;
using super::raw;
using super::types;

using map::HashMapWithContext;
using types::HashMapContext;

struct StoragePlan {
    layout: mem::Layout,
    ctrlLen: usize,
    keysOffset: usize,
    valuesOffset: usize,
}

fun storagePlan[K, V](capacity: usize) mem::Error!StoragePlan
where K: Sized, V: Sized
{
    let ctrlLen = raw::ctrlAllocationLen(capacity).?;
    let mut storage = LayoutBuilder::init(mem::Layout::array[u8](ctrlLen).?);
    let keysOffset = storage.appendArray[K](capacity).?;
    let valuesOffset = storage.appendArray[V](capacity).?;
    !.{
        layout: storage.layout(),
        ctrlLen,
        keysOffset,
        valuesOffset,
    }
}

// Offsets are produced by `storagePlan` and stay within the one allocated
// block. The block alignment is the maximum alignment of every typed view.
fun storageItems[T](block: mem::Block, offset: usize, len: usize) &mut [T]
where T: Sized
{
    let mut ptr = ((block.ptr() as usize) + offset) as &mut T;
    &mut ptr[0..len]
}

extend[K, V, C] HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fun deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let mut cleanup: error::CleanupAccumulator[mem::Error] = .init();
        cleanup.attempt(self.freeAllocations(allocator));
        cleanup.attempt(self.freeRetiredAllocations(allocator));
        cleanup.finish().?;
        self.resetStorage();
        !()
    }

    pub fun shrinkToFit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.shrinkToCapacity(allocator, self.len())
    }

    pub fun shrinkToCapacity(&mut self, allocator: &mut mem::Allocator, minCapacity: usize) mem::Error!() {
        let targetCapacity = cmp::max(self.len(), minCapacity);
        if targetCapacity >= self.capacity() {
            return !();
        }
        if targetCapacity == 0 {
            self.deinit(allocator).?;
            return !();
        }

        let target = raw::capacityToBuckets(targetCapacity).?;
        self.rehashToBuckets(allocator, target)
    }

    pub fun compact(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.bucketCapacity() == 0 {
            return !();
        }
        if self.len() == 0 {
            self.clear();
            return !();
        }
        self.rehashToBuckets(allocator, self.bucketCapacity())
    }

    pub fun clone(&self, allocator: &mut mem::Allocator) mem::Error!HashMapWithContext[K, V, C] {
        let mut cloned = HashMapWithContext[K, V, C]::initContextSeed(self.context, self.seed);
        if self.bucketCapacity() == 0 {
            return !cloned;
        }
        cloned.allocate(allocator, self.bucketCapacity()).?;

        for index in 0..self.bucketCapacity() {
            if raw::isFull(self.ctrl[index]) {
                cloned.insertExisting(self.keys[index], self.values[index]);
            }
        }

        !cloned
    }

    pub fun reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        self.ensureUnusedCapacity(allocator, additional)
    }

    pub(super) fun ensureUnusedCapacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        if additional <= self.growthLeft {
            return !();
        }
        let needed = self.len.checkedAdd(additional)
            .okOr(mem::Error::OutOfMemory).?;
        if needed <= self.capacity() {
            self.rehashToBuckets(allocator, self.bucketCapacity())
        } else {
            self.growForCapacity(allocator, needed)
        }
    }

    pub fun ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        if capacity <= self.capacity() {
            return !();
        }
        self.growForCapacity(allocator, capacity)
    }

    fun growForCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        let target = raw::capacityToBuckets(capacity).?;
        self.rehashToBuckets(allocator, target)
    }

    fun rehashToBuckets(&mut self, allocator: &mut mem::Allocator, target: usize) mem::Error!() {
        self.freeRetiredAllocations(allocator).?;
        let mut newMap = HashMapWithContext[K, V, C]::initContextSeed(self.context, self.seed);
        newMap.allocate(allocator, target).?;

        for index in 0..self.bucketCapacity() {
            if raw::isFull(self.ctrl[index]) {
                let key = self.keys[index];
                let value = self.values[index];
                newMap.insertExisting(key, value);
            }
        }

        let retired = self.storageBlock;
        self.* = newMap;
        self.retiredStorageBlock = retired;
        self.freeRetiredAllocations(allocator)
    }

    fun insertExisting(&mut self, key: K, value: V) () {
        let valueHash = self.hashKey(&key);
        let slot = self.findInsertIndex(valueHash);
        self.setCtrl(slot, raw::tag(valueHash));
        self.keys[slot] = key;
        self.values[slot] = value;
        self.len += 1;
        self.growthLeft -= 1;
    }

    fun allocate(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        let plan = storagePlan[K, V](capacity).?;
        let storage = allocator.alloc(plan.layout).?;
        self.ctrl = storageItems[u8](storage, 0, plan.ctrlLen);
        if root::builtin::size[K]() == 0 {
            self.keys = raw::danglingLenSlice[K](capacity);
        } else {
            self.keys = storageItems[K](storage, plan.keysOffset, capacity);
        }
        if root::builtin::size[V]() == 0 {
            self.values = raw::danglingLenSlice[V](capacity);
        } else {
            self.values = storageItems[V](storage, plan.valuesOffset, capacity);
        }
        self.storageBlock = ?storage;
        raw::fillCtrl(self.ctrl, raw::ctrlEmpty);
        self.bucketCount = capacity;
        self.len = 0;
        self.growthLeft = raw::usableCapacity(capacity);
        !()
    }

    // A failed release leaves the one combined ctrl/key/value owner attached
    // so a caller can retry deinit without losing or double-freeing storage.
    fun freeAllocations(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.storageBlock is ?block {
            allocator.free(block).?;
            self.resetStorage();
        }
        !()
    }

    fun freeRetiredAllocations(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        if self.retiredStorageBlock is ?block {
            allocator.free(block).?;
            self.retiredStorageBlock = null;
        }
        !()
    }

    fun resetStorage(&mut self) () {
        self.ctrl = raw::danglingSlice[u8]();
        self.keys = raw::danglingSlice[K]();
        self.values = raw::danglingSlice[V]();
        self.storageBlock = null;
        self.bucketCount = 0;
        self.len = 0;
        self.growthLeft = 0;
    }
}
