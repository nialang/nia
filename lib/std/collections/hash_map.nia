using std::fmt;
using std::hash;
using std::mem;
using std::os;

comptime let ctrl_empty: u8 = 0xffu8;
comptime let ctrl_deleted: u8 = 0x80u8;
comptime let group_width: usize = 8usize;

pub trait HashMapContext[K] {
    fn hash(&self, seed: u64, key: &K) u64;
    fn eql(&self, left: &K, right: &K) bool;
}

pub struct DefaultHashMapContext {}

pub type HashMap[K, V] = HashMapWithContext[K, V, DefaultHashMapContext];

pub struct HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    ctrl: &mut [u8],
    keys: &mut [K],
    values: &mut [V],
    bucket_count: usize,
    len: usize,
    growth_left: usize,
    seed: u64,
    context: C,
}

pub struct HashMapEntry[K, V]
where K: Sized, V: Sized
{
    key: K,
    value: V,
}

pub struct HashMapEntryRef[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &V,
}

pub struct HashMapEntryMut[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &mut V,
}

pub struct HashMapGetOrPutResult[K, V]
where K: Sized, V: Sized
{
    key: &K,
    value: &mut V,
    found_existing: bool,
}

pub type HashMapIter[K, V] = HashMapIterWithContext[K, V, DefaultHashMapContext];

pub type HashMapIterMut[K, V] = HashMapIterMutWithContext[K, V, DefaultHashMapContext];

pub type HashMapKeys[K, V] = HashMapKeysWithContext[K, V, DefaultHashMapContext];

pub type HashMapValues[K, V] = HashMapValuesWithContext[K, V, DefaultHashMapContext];

pub type HashMapValuesMut[K, V] = HashMapValuesMutWithContext[K, V, DefaultHashMapContext];

pub struct HashMapIterWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    map: &HashMapWithContext[K, V, C],
    index: usize,
    remaining: usize,
}

pub struct HashMapIterMutWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    map: &mut HashMapWithContext[K, V, C],
    index: usize,
    remaining: usize,
}

pub struct HashMapKeysWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    iter: HashMapIterWithContext[K, V, C],
}

pub struct HashMapValuesWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    iter: HashMapIterWithContext[K, V, C],
}

pub struct HashMapValuesMutWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    iter: HashMapIterMutWithContext[K, V, C],
}

struct ProbeCursor {
    pos: usize,
    stride: usize,
    visited: usize,
    capacity: usize,
}

struct ProbeGroup {
    match_mask: usize,
    empty_mask: usize,
    available_mask: usize,
}

fn dangling_slice[T]() &mut [T]
where T: Sized
{
    var ptr = @align[T]() as &mut T;
    &mut ptr[0..0]
}

extend DefaultHashMapContext {
    pub fn init() DefaultHashMapContext {
        {}
    }
}

extend[K] DefaultHashMapContext : HashMapContext[K]
where K: Sized + Eq[K] + hash::Hash[hash::Wyhash]
{
    pub fn hash(&self, seed: u64, key: &K) u64 {
        _ = self;
        var hasher = hash::Wyhash::init(seed);
        key.hash(&mut hasher);
        hasher.finish()
    }

    pub fn eql(&self, left: &K, right: &K) bool {
        _ = self;
        left.* == right.*
    }
}

extend[K, V] HashMapEntry[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        &self.key
    }

    pub fn value(&self) &V {
        &self.value
    }

    pub fn into_key(self) K {
        self.key
    }

    pub fn into_value(self) V {
        self.value
    }
}

extend[K, V] HashMapEntryRef[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        self.key
    }

    pub fn value(&self) &V {
        self.value
    }
}

extend[K, V] HashMapEntryMut[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        self.key
    }

    pub fn value(&self) &V {
        self.value
    }

    pub fn value_mut(&mut self) &mut V {
        self.value
    }
}

extend[K, V] HashMapGetOrPutResult[K, V]
where K: Sized, V: Sized
{
    pub fn key(&self) &K {
        self.key
    }

    pub fn value(&mut self) &mut V {
        self.value
    }

    pub fn found_existing(&self) bool {
        self.found_existing
    }
}

extend[K, V, C] HashMapIterWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn len(&self) usize {
        self.remaining
    }

    pub fn is_empty(&self) bool {
        self.len() == 0usize
    }
}

extend[K, V, C] HashMapIterWithContext[K, V, C] : Iterator
where K: Sized, V: Sized, C: HashMapContext[K]
{
    type Item = HashMapEntryRef[K, V];

    pub fn next(&mut self) ?HashMapEntryRef[K, V] {
        while self.index < self.map.bucket_capacity() {
            let index = self.index;
            self.index += 1usize;
            if is_full(self.map.ctrl[index]) {
                self.remaining -= 1usize;
                return ?{
                    key: &self.map.keys[index],
                    value: &self.map.values[index],
                };
            }
        }
        null
    }
}

extend[K, V, C] HashMapIterMutWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn len(&self) usize {
        self.remaining
    }

    pub fn is_empty(&self) bool {
        self.len() == 0usize
    }
}

extend[K, V, C] HashMapIterMutWithContext[K, V, C] : Iterator
where K: Sized, V: Sized, C: HashMapContext[K]
{
    type Item = HashMapEntryMut[K, V];

    pub fn next(&mut self) ?HashMapEntryMut[K, V] {
        while self.index < self.map.bucket_capacity() {
            let index = self.index;
            self.index += 1usize;
            if is_full(self.map.ctrl[index]) {
                self.remaining -= 1usize;
                return ?{
                    key: &self.map.keys[index],
                    value: &mut self.map.values[index],
                };
            }
        }
        null
    }
}

extend[K, V, C] HashMapKeysWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn len(&self) usize {
        self.iter.len()
    }

    pub fn is_empty(&self) bool {
        self.iter.is_empty()
    }
}

extend[K, V, C] HashMapKeysWithContext[K, V, C] : Iterator
where K: Sized, V: Sized, C: HashMapContext[K]
{
    type Item = &K;

    pub fn next(&mut self) ?&K {
        switch self.iter.next() {
            ?entry => ?entry.key(),
            null => null,
        }
    }
}

extend[K, V, C] HashMapValuesWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn len(&self) usize {
        self.iter.len()
    }

    pub fn is_empty(&self) bool {
        self.iter.is_empty()
    }
}

extend[K, V, C] HashMapValuesWithContext[K, V, C] : Iterator
where K: Sized, V: Sized, C: HashMapContext[K]
{
    type Item = &V;

    pub fn next(&mut self) ?&V {
        switch self.iter.next() {
            ?entry => ?entry.value(),
            null => null,
        }
    }
}

extend[K, V, C] HashMapValuesMutWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn len(&self) usize {
        self.iter.len()
    }

    pub fn is_empty(&self) bool {
        self.iter.is_empty()
    }
}

extend[K, V, C] HashMapValuesMutWithContext[K, V, C] : Iterator
where K: Sized, V: Sized, C: HashMapContext[K]
{
    type Item = &mut V;

    pub fn next(&mut self) ?&mut V {
        switch self.iter.next() {
            ?entry => ?entry.value_mut(),
            null => null,
        }
    }
}

extend[K, V] HashMapWithContext[K, V, DefaultHashMapContext]
where K: Sized + Eq[K] + hash::Hash[hash::Wyhash], V: Sized
{
    pub fn init() os::Error!HashMap[K, V] {
        let seed = random_seed().?;
        !HashMap[K, V]::init_seed(seed)
    }

    pub fn init_seed(seed: u64) HashMap[K, V] {
        HashMapWithContext[K, V, DefaultHashMapContext]::init_context_seed(DefaultHashMapContext::init(), seed)
    }

    pub fn init_seed_capacity(
        allocator: &mut mem::Allocator,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMap[K, V] {
        HashMapWithContext[K, V, DefaultHashMapContext]::init_context_seed_capacity(
            allocator,
            DefaultHashMapContext::init(),
            seed,
            capacity,
        )
    }
}

extend[K, V, C] HashMapWithContext[K, V, C]
where K: Sized, V: Sized, C: HashMapContext[K]
{
    pub fn init_context(context: C) os::Error!HashMapWithContext[K, V, C] {
        let seed = random_seed().?;
        !HashMapWithContext[K, V, C]::init_context_seed(context, seed)
    }

    pub fn init_context_seed(context: C, seed: u64) HashMapWithContext[K, V, C] {
        {
            ctrl: dangling_slice[u8](),
            keys: dangling_slice[K](),
            values: dangling_slice[V](),
            bucket_count: 0usize,
            len: 0usize,
            growth_left: 0usize,
            seed: seed,
            context: context,
        }
    }

    pub fn init_context_seed_capacity(
        allocator: &mut mem::Allocator,
        context: C,
        seed: u64,
        capacity: usize,
    ) mem::Error!HashMapWithContext[K, V, C] {
        var map = HashMapWithContext[K, V, C]::init_context_seed(context, seed);
        map.ensure_total_capacity(allocator, capacity).?;
        !map
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        var result: ?mem::Error = null;
        switch self.free_allocations(allocator) {
            !ok => _ = ok,
            err! => result = ?err,
        }
        self.ctrl = dangling_slice[u8]();
        self.keys = dangling_slice[K]();
        self.values = dangling_slice[V]();
        self.bucket_count = 0usize;
        self.len = 0usize;
        self.growth_left = 0usize;
        switch result {
            ?err => err!,
            null => !{},
        }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn capacity(&self) usize {
        usable_capacity(self.bucket_count)
    }

    pub fn is_empty(&self) bool {
        self.len == 0usize
    }

    pub fn clear(&mut self) void {
        fill_ctrl(&mut self.ctrl[0..self.bucket_count], ctrl_empty);
        mirror_ctrl_tail(self.ctrl, self.bucket_count);
        self.len = 0usize;
        self.growth_left = self.capacity();
    }

    pub fn clear_retaining_capacity(&mut self) void {
        self.clear();
    }

    pub fn clear_and_free(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.deinit(allocator)
    }

    pub fn shrink_to_fit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.shrink_to_capacity(allocator, self.len())
    }

    pub fn shrink_to_capacity(&mut self, allocator: &mut mem::Allocator, min_capacity: usize) mem::Error!void {
        let target_capacity = max_usize(self.len(), min_capacity);
        if target_capacity >= self.capacity() {
            return !{};
        }
        if target_capacity == 0usize {
            self.clear_and_free(allocator).?;
            return !{};
        }

        let target = capacity_to_buckets(target_capacity).?;
        self.rehash_to_buckets(allocator, target)
    }

    pub fn compact(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        if self.bucket_capacity() == 0usize {
            return !{};
        }
        if self.len() == 0usize {
            self.clear();
            return !{};
        }
        self.rehash_to_buckets(allocator, self.bucket_capacity())
    }

    pub fn iter(&self) HashMapIterWithContext[K, V, C] {
        { map: self, index: 0usize, remaining: self.len }
    }

    pub fn iter_mut(&mut self) HashMapIterMutWithContext[K, V, C] {
        { map: self, index: 0usize, remaining: self.len }
    }

    pub fn keys(&self) HashMapKeysWithContext[K, V, C] {
        { iter: self.iter() }
    }

    pub fn values(&self) HashMapValuesWithContext[K, V, C] {
        { iter: self.iter() }
    }

    pub fn values_mut(&mut self) HashMapValuesMutWithContext[K, V, C] {
        { iter: self.iter_mut() }
    }

    pub fn contains_key(&self, key: &K) bool {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => true,
            null => false,
        }
    }

    pub fn get(&self, key: &K) ?&V {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => ?&self.values[index],
            null => null,
        }
    }

    pub fn get_mut(&mut self, key: &K) ?&mut V {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => ?&mut self.values[index],
            null => null,
        }
    }

    pub fn get_entry(&self, key: &K) ?HashMapEntryRef[K, V] {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => ?{
                key: &self.keys[index],
                value: &self.values[index],
            },
            null => null,
        }
    }

    pub fn get_entry_mut(&mut self, key: &K) ?HashMapEntryMut[K, V] {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => ?{
                key: &self.keys[index],
                value: &mut self.values[index],
            },
            null => null,
        }
    }

    pub fn get_key(&self, key: &K) ?&K {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => ?&self.keys[index],
            null => null,
        }
    }

    pub fn get_key_value(&self, key: &K) ?HashMapEntryRef[K, V] {
        self.get_entry(key)
    }

    pub fn clone(&self, allocator: &mut mem::Allocator) mem::Error!HashMapWithContext[K, V, C] {
        var cloned = HashMapWithContext[K, V, C]::init_context_seed(self.context, self.seed);
        if self.bucket_capacity() == 0usize {
            return !cloned;
        }
        cloned.allocate(allocator, self.bucket_capacity()).?;

        var index = 0usize;
        while index < self.bucket_capacity() {
            if is_full(self.ctrl[index]) {
                cloned.insert_existing(self.keys[index], self.values[index]);
            }
            index += 1usize;
        }

        !cloned
    }

    pub fn put(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!?V {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                let old = self.values[index];
                self.values[index] = value;
                return !?old;
            },
            null => {},
        }

        self.insert_new(allocator, key, value).?;
        !null
    }

    pub fn fetch_put(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!?V {
        self.put(allocator, key, value)
    }

    pub fn put_if_absent(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!bool {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                _ = index;
                return !false;
            },
            null => {},
        }

        self.insert_new(allocator, key, value).?;
        !true
    }

    pub fn put_assume_capacity(&mut self, key: K, value: V) ?V {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                let old = self.values[index];
                self.values[index] = value;
                return ?old;
            },
            null => {},
        }

        self.insert_new_assume_capacity(key, value);
        null
    }

    pub fn put_if_absent_assume_capacity(&mut self, key: K, value: V) bool {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                _ = index;
                return false;
            },
            null => {},
        }

        self.insert_new_assume_capacity(key, value);
        true
    }

    pub fn get_or_put_value(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
        value: V,
    ) mem::Error!HashMapGetOrPutResult[K, V] {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                return !{
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    found_existing: true,
                };
            },
            null => {},
        }

        let index = self.insert_new_index(allocator, key, value).?;
        !{
            key: &self.keys[index],
            value: &mut self.values[index],
            found_existing: false,
        }
    }

    pub fn get_or_put_value_assume_capacity(
        &mut self,
        key: K,
        value: V,
    ) HashMapGetOrPutResult[K, V] {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                return {
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    found_existing: true,
                };
            },
            null => {},
        }

        let index = self.insert_new_index_assume_capacity(key, value);
        {
            key: &self.keys[index],
            value: &mut self.values[index],
            found_existing: false,
        }
    }

    pub fn get_or_put(
        &mut self,
        allocator: &mut mem::Allocator,
        key: K,
    ) mem::Error!HashMapGetOrPutResult[K, V] {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                return !{
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    found_existing: true,
                };
            },
            null => {},
        }

        let index = self.insert_new_uninitialized_index(allocator, key).?;
        !{
            key: &self.keys[index],
            value: &mut self.values[index],
            found_existing: false,
        }
    }

    pub fn get_or_put_assume_capacity(
        &mut self,
        key: K,
    ) HashMapGetOrPutResult[K, V] {
        let value_hash = self.hash_key(&key);
        switch self.find_index(&key, value_hash) {
            ?index => {
                return {
                    key: &self.keys[index],
                    value: &mut self.values[index],
                    found_existing: true,
                };
            },
            null => {},
        }

        let index = self.insert_new_uninitialized_index_assume_capacity(key);
        {
            key: &self.keys[index],
            value: &mut self.values[index],
            found_existing: false,
        }
    }

    fn insert_new(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!void {
        _ = self.insert_new_index(allocator, key, value).?;
        !{}
    }

    fn insert_new_index(&mut self, allocator: &mut mem::Allocator, key: K, value: V) mem::Error!usize {
        let slot = self.insert_new_uninitialized_index(allocator, key).?;
        self.values[slot] = value;
        !slot
    }

    fn insert_new_uninitialized_index(&mut self, allocator: &mut mem::Allocator, key: K) mem::Error!usize {
        self.ensure_unused_capacity(allocator, 1usize).?;
        let hash_after_grow = self.hash_key(&key);
        let slot = self.find_insert_index(hash_after_grow);
        if self.ctrl[slot] == ctrl_empty {
            self.growth_left -= 1usize;
        }
        self.set_ctrl(slot, tag(hash_after_grow));
        self.keys[slot] = key;
        self.len += 1usize;
        !slot
    }

    fn insert_new_assume_capacity(&mut self, key: K, value: V) void {
        let slot = self.insert_new_index_assume_capacity(key, value);
        _ = slot;
    }

    fn insert_new_index_assume_capacity(&mut self, key: K, value: V) usize {
        let slot = self.insert_new_uninitialized_index_assume_capacity(key);
        self.values[slot] = value;
        slot
    }

    fn insert_new_uninitialized_index_assume_capacity(&mut self, key: K) usize {
        if self.growth_left == 0usize {
            @trap()
        }
        let value_hash = self.hash_key(&key);
        let slot = self.find_insert_index(value_hash);
        if self.ctrl[slot] == ctrl_empty {
            self.growth_left -= 1usize;
        }
        self.set_ctrl(slot, tag(value_hash));
        self.keys[slot] = key;
        self.len += 1usize;
        slot
    }

    pub fn remove(&mut self, key: &K) ?V {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => {
                let value = self.values[index];
                self.set_ctrl(index, ctrl_deleted);
                self.len -= 1usize;
                ?value
            },
            null => null,
        }
    }

    pub fn remove_entry(&mut self, key: &K) ?HashMapEntry[K, V] {
        switch self.find_index(key, self.hash_key(key)) {
            ?index => {
                let found_key = self.keys[index];
                let value = self.values[index];
                self.set_ctrl(index, ctrl_deleted);
                self.len -= 1usize;
                ?{ key: found_key, value: value }
            },
            null => null,
        }
    }

    pub fn fetch_remove(&mut self, key: &K) ?HashMapEntry[K, V] {
        self.remove_entry(key)
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        self.ensure_unused_capacity(allocator, additional)
    }

    pub fn reserve_exact(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        self.ensure_unused_capacity(allocator, additional)
    }

    pub fn ensure_unused_capacity(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        if additional <= self.growth_left {
            return !{};
        }
        let needed = switch self.len.checked_add(additional) {
            ?value => value,
            null => return mem::Error::OutOfMemory!,
        };
        if needed <= self.capacity() {
            self.rehash_to_buckets(allocator, self.bucket_capacity()).?;
            return !{};
        }
        self.grow_for_capacity(allocator, needed).?;
        !{}
    }

    pub fn ensure_total_capacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        if capacity <= self.capacity() {
            return !{};
        }
        self.grow_for_capacity(allocator, capacity).?;
        !{}
    }

    fn bucket_capacity(&self) usize {
        self.bucket_count
    }

    fn hash_key(&self, key: &K) u64 {
        self.context.hash(self.seed, key)
    }

    fn find_index(&self, key: &K, value_hash: u64) ?usize {
        if self.bucket_capacity() == 0usize {
            return null;
        }

        let needle = tag(value_hash);
        var cursor = ProbeCursor::init(value_hash, self.bucket_capacity());

        while cursor.has_remaining() {
            let group = ProbeGroup::load(self.ctrl, &cursor, needle);
            var matches = group.match_mask;
            while matches != 0usize {
                let offset = first_set(matches);
                let index = cursor.index(offset);
                if self.context.eql(&self.keys[index], key) {
                    return ?index;
                }
                matches = clear_lowest_set(matches);
            }
            if group.empty_mask != 0usize {
                return null;
            }

            cursor.advance_group();
        }
        null
    }

    fn find_insert_index(&self, value_hash: u64) usize {
        var cursor = ProbeCursor::init(value_hash, self.bucket_capacity());

        while cursor.has_remaining() {
            let group = ProbeGroup::load(self.ctrl, &cursor, tag(value_hash));
            if group.available_mask != 0usize {
                return cursor.index(first_set(group.available_mask));
            }

            cursor.advance_group();
        }

        @trap()
    }

    fn grow_for_capacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        let target = capacity_to_buckets(capacity).?;
        self.rehash_to_buckets(allocator, target)
    }

    fn rehash_to_buckets(&mut self, allocator: &mut mem::Allocator, target: usize) mem::Error!void {
        var new_map = HashMapWithContext[K, V, C]::init_context_seed(self.context, self.seed);
        new_map.allocate(allocator, target).?;

        var index = 0usize;
        while index < self.bucket_capacity() {
            if is_full(self.ctrl[index]) {
                let key = self.keys[index];
                let value = self.values[index];
                new_map.insert_existing(key, value);
            }
            index += 1usize;
        }

        var old_map = HashMapWithContext[K, V, C]::init_context_seed(self.context, self.seed);
        old_map.ctrl = self.ctrl;
        old_map.keys = self.keys;
        old_map.values = self.values;
        old_map.bucket_count = self.bucket_count;
        old_map.len = self.len;
        old_map.growth_left = self.growth_left;
        self.ctrl = new_map.ctrl;
        self.keys = new_map.keys;
        self.values = new_map.values;
        self.bucket_count = new_map.bucket_count;
        self.len = new_map.len;
        self.growth_left = new_map.growth_left;
        new_map.ctrl = dangling_slice[u8]();
        new_map.keys = dangling_slice[K]();
        new_map.values = dangling_slice[V]();
        new_map.bucket_count = 0usize;
        old_map.free_allocations(allocator)
    }

    fn insert_existing(&mut self, key: K, value: V) void {
        let value_hash = self.hash_key(&key);
        let slot = self.find_insert_index(value_hash);
        self.set_ctrl(slot, tag(value_hash));
        self.keys[slot] = key;
        self.values[slot] = value;
        self.len += 1usize;
        self.growth_left -= 1usize;
    }

    fn set_ctrl(&mut self, index: usize, value: u8) void {
        self.ctrl[index] = value;
        if index < group_width - 1usize {
            self.ctrl[self.bucket_count + index] = value;
        }
    }

    fn allocate(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        let ctrl_len = ctrl_allocation_len(capacity).?;
        let ctrl_layout = mem::Layout::array[u8](ctrl_len).?;
        let keys_layout = mem::Layout::array[K](capacity).?;
        let values_layout = mem::Layout::array[V](capacity).?;
        let ctrl_block = allocator.alloc(ctrl_layout).?;

        if keys_layout.is_empty() {
            self.keys = dangling_len_slice[K](capacity);
        } else {
            switch allocator.alloc(keys_layout) {
                !keys_block => self.keys = keys_block.as_slice[K](),
                err! => {
                    switch allocator.free(ctrl_block) {
                        !ok => _ = ok,
                        error! => {},
                    }
                    return err!;
                },
            }
        }

        if values_layout.is_empty() {
            self.values = dangling_len_slice[V](capacity);
        } else {
            switch allocator.alloc(values_layout) {
                !values_block => self.values = values_block.as_slice[V](),
                err! => {
                    if not keys_layout.is_empty() {
                        let key_block = mem::Block::init(self.keys.get_ptr() as &mut u8, keys_layout);
                        switch allocator.free(key_block) {
                            !ok => _ = ok,
                            error! => {},
                        }
                    }
                    switch allocator.free(ctrl_block) {
                        !ok => _ = ok,
                        error! => {},
                    }
                    self.keys = dangling_slice[K]();
                    return err!;
                },
            }
        }

        self.ctrl = ctrl_block.as_slice[u8]();
        fill_ctrl(self.ctrl, ctrl_empty);
        self.bucket_count = capacity;
        self.len = 0usize;
        self.growth_left = usable_capacity(capacity);
        !{}
    }

    fn free_allocations(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        var first_error: ?mem::Error = null;
        if self.ctrl.len() != 0usize {
            let layout = mem::Layout::array[u8](self.ctrl.len()).?;
            switch allocator.free(mem::Block::init(self.ctrl.get_ptr() as &mut u8, layout)) {
                !ok => _ = ok,
                err! => first_error = ?err,
            }
        }
        if self.keys.len() != 0usize {
            let layout = mem::Layout::array[K](self.bucket_count).?;
            if not layout.is_empty() {
                switch allocator.free(mem::Block::init(self.keys.get_ptr() as &mut u8, layout)) {
                    !ok => _ = ok,
                    err! => {
                        switch first_error {
                            ?value => {},
                            null => first_error = ?err,
                        }
                    },
                }
            }
        }
        if self.values.len() != 0usize {
            let layout = mem::Layout::array[V](self.bucket_count).?;
            if not layout.is_empty() {
                switch allocator.free(mem::Block::init(self.values.get_ptr() as &mut u8, layout)) {
                    !ok => _ = ok,
                    err! => {
                        switch first_error {
                            ?value => {},
                            null => first_error = ?err,
                        }
                    },
                }
            }
        }
        switch first_error {
            ?err => err!,
            null => !{},
        }
    }
}

extend ProbeGroup {
    fn load(ctrl: &[u8], cursor: &ProbeCursor, needle: u8) ProbeGroup {
        let bytes = @load_unaligned[u8x8](&ctrl[cursor.pos]);

        let match_mask = @bitmask(bytes == @splat[u8x8](needle));
        let empty_mask = @bitmask(bytes == @splat[u8x8](ctrl_empty));
        let deleted_mask = @bitmask(bytes == @splat[u8x8](ctrl_deleted));

        {
            match_mask: match_mask,
            empty_mask: empty_mask,
            available_mask: empty_mask | deleted_mask,
        }
    }
}

extend ProbeCursor {
    fn init(value_hash: u64, capacity: usize) ProbeCursor {
        let mask = capacity - 1usize;
        {
            pos: (value_hash as usize) & mask,
            stride: 0usize,
            visited: 0usize,
            capacity: capacity,
        }
    }

    fn has_remaining(&self) bool {
        self.visited < self.capacity
    }

    fn index(&self, offset: usize) usize {
        (self.pos + offset) & (self.capacity - 1usize)
    }

    fn advance_group(&mut self) void {
        self.stride += group_width;
        self.pos = (self.pos + self.stride) & (self.capacity - 1usize);
        self.visited += group_width;
    }
}

fn dangling_len_slice[T](len: usize) &mut [T]
where T: Sized
{
    var ptr = @align[T]() as &mut T;
    &mut ptr[0..len]
}

fn random_seed() os::Error!u64 {
    var bytes: [8]u8 = [0; 8];
    os::random(&mut bytes[..]).?;
    !read_u64(&bytes[..])
}

fn read_u64(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64)
        | ((bytes[4] as u64) << 32u64)
        | ((bytes[5] as u64) << 40u64)
        | ((bytes[6] as u64) << 48u64)
        | ((bytes[7] as u64) << 56u64)
}

fn tag(value_hash: u64) u8 {
    ((value_hash >> 57u64) as u8) & 0x7fu8
}

fn is_full(control: u8) bool {
    (control & 0x80u8) == 0u8
}

fn first_set(mask: usize) usize {
    @ctz[usize](mask)
}

fn clear_lowest_set(mask: usize) usize {
    mask & (mask - 1usize)
}

fn ctrl_allocation_len(capacity: usize) mem::Error!usize {
    if capacity == 0usize {
        return !0usize;
    }
    switch capacity.checked_add(group_width - 1usize) {
        ?value => !value,
        null => mem::Error::OutOfMemory!,
    }
}

fn mirror_ctrl_tail(ctrl: &mut [u8], bucket_count: usize) void {
    if bucket_count == 0usize {
        return;
    }
    var index = 0usize;
    while index < group_width - 1usize {
        ctrl[bucket_count + index] = ctrl[index];
        index += 1usize;
    }
}

fn fill_ctrl(ctrl: &mut [u8], value: u8) void {
    var index = 0usize;
    while index < ctrl.len() {
        ctrl[index] = value;
        index += 1usize;
    }
}

fn usable_capacity(buckets: usize) usize {
    if buckets == 0usize {
        0usize
    } else if buckets < 8usize {
        buckets - 1usize
    } else {
        (buckets / 8usize) * 7usize
    }
}

fn capacity_to_buckets(capacity: usize) mem::Error!usize {
    if capacity == 0usize {
        return !0usize;
    }
    if capacity <= 7usize {
        return !8usize;
    }
    if capacity <= 14usize {
        return !16usize;
    }

    let multiplied = switch capacity.checked_mul(8usize) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let biased = switch multiplied.checked_add(6usize) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let adjusted = biased / 7usize;
    next_power_of_two(adjusted)
}

fn max_usize(left: usize, right: usize) usize {
    if left > right {
        left
    } else {
        right
    }
}

fn next_power_of_two(value: usize) mem::Error!usize {
    var n = 1usize;
    while n < value {
        n = switch n.checked_mul(2usize) {
            ?next => next,
            null => return mem::Error::OutOfMemory!,
        };
    }
    !n
}

extend[K, V, C, E] HashMapWithContext[K, V, C] : fmt::Format[E]
where K: Sized + fmt::Format[E], V: Sized + fmt::Format[E], C: HashMapContext[K]
{
    fn format(&self, formatter: &mut fmt::Formatter[E]) E!void {
        formatter.write_byte(b'{').?;
        var first = true;
        for entry in self.iter() {
            if first {
                first = false;
            } else {
                formatter.write_text(", ").?;
            }
            entry.key().*.format(formatter).?;
            formatter.write_text(": ").?;
            entry.value().*.format(formatter).?;
        }
        formatter.write_byte(b'}')
    }
}
