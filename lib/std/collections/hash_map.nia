pub using context::DefaultHashMapContext;
pub using entries::{HashMapEntry, HashMapEntryMut, HashMapEntryRef, HashMapGetOrPutResult};
pub using iterators::{
    HashMapIter,
    HashMapIterMut,
    HashMapKeys,
    HashMapValues,
    HashMapValuesMut,
    HashMapIterWithContext,
    HashMapIterMutWithContext,
    HashMapKeysWithContext,
    HashMapValuesWithContext,
    HashMapValuesMutWithContext,
};
pub using map::HashMapWithContext;
pub using types::HashMapContext;

pub type HashMap[K, V] = HashMapWithContext[K, V, DefaultHashMapContext];
