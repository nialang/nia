using root::{atomic, builtin};
using root::builtin::target::CpuFeature;

// The high bit distinguishes an initialized empty set from an uninitialized
// cache. A single relaxed atomic publishes the entire immutable answer; no
// other memory is published alongside it.
const INITIALIZED: u32 = 0x80000000;
static mut cached: u32 = 0;

@[inlineAlways]
pub fun supports(feature: CpuFeature) bool {
    let mut features = builtin::atomicLoad[u32](cached, atomic::Monotonic);
    if features == 0 {
        features = detect() | INITIALIZED;
        builtin::atomicStore[u32](cached, features, atomic::Monotonic);
    }
    (features & bit(feature)) != 0
}

const fun bit(feature: CpuFeature) u32 {
    1u32 << (feature as u32)
}

struct Registers {
    a: u32,
    b: u32,
    c: u32,
    d: u32,
}

fun cpuid(leaf: u32, subleaf: u32) Registers {
    let mut a = 0u32;
    let mut b = 0u32;
    let mut c = 0u32;
    let mut d = 0u32;
    builtin::asm(.{
        code: b"cpuid",
        outputs: .{ eax: a, ebx: b, ecx: c, edx: d },
        inputs: .{ eax: leaf, ecx: subleaf },
        options: [b"volatile"],
    });
    .{ a, b, c, d }
}

fun xcr0() u32 {
    let mut value = 0u32;
    builtin::asm(.{
        code: b"xgetbv",
        outputs: .{ eax: value },
        inputs: .{ ecx: 0u32 },
        clobbers: [b"edx"],
        options: [b"volatile"],
    });
    value
}

fun detect() u32 {
    let maximum = cpuid(0, 0).a;
    if maximum < 1 {
        return 0;
    }
    let leaf1 = cpuid(1, 0);
    let mut state = 0u32;
    // XGETBV is legal only after the CPU and OS advertise XSAVE/OSXSAVE.
    if (leaf1.c & (3u32 << 26)) == (3u32 << 26) {
        state = xcr0();
    }
    let leaf7 = if maximum >= 7 { cpuid(7, 0) } else { Registers { a: 0, b: 0, c: 0, d: 0 } };
    let extended = if cpuid(0x80000000, 0).a >= 0x80000001 {
        cpuid(0x80000001, 0).c
    } else { 0u32 };
    decode(leaf1.c, leaf1.d, leaf7.b, extended, state)
}

// Kept separate from instruction execution so OS-state and missing-leaf
// combinations can be tested without depending on the host processor. The
// arguments are CPUID leaf 1 ECX and EDX, leaf 7 EBX, leaf 0x80000001 ECX,
// and XCR0.
fun decode(c: u32, d: u32, b7: u32, extended: u32, state: u32) u32 {
    let mut features = select(&[
        (d, 26, .Sse2), (c, 0, .Sse3), (c, 9, .Ssse3), (c, 19, .Sse4_1),
        (c, 20, .Sse4_2), (c, 23, .Popcnt), (c, 13, .Cmpxchg16b),
        (c, 22, .Movbe), (b7, 3, .Bmi1), (b7, 8, .Bmi2), (extended, 5, .Lzcnt),
    ]);

    // Hardware bits alone do not make AVX usable: XMM and YMM state must
    // survive context switches. FMA and F16C also use that AVX state.
    let avx = (c & (7u32 << 26)) == (7u32 << 26) and (state & 6) == 6;
    if avx {
        features |= bit(.Avx) | select(&[(b7, 5, .Avx2), (c, 12, .Fma), (c, 29, .F16c)]);
    }
    // Darwin saves the AVX-512 context lazily on first use. Other systems
    // must enable opmask, the upper ZMM halves and the extra ZMM registers.
    @[if os == "macos"]
    let avx512 = avx;
    @[if os != "macos"]
    let avx512 = avx and (state & 0xe0) == 0xe0;
    if avx512 and has(b7, 16) {
        features |= bit(.Avx512f) | select(&[
            (b7, 30, .Avx512bw), (b7, 28, .Avx512cd),
            (b7, 17, .Avx512dq), (b7, 31, .Avx512vl),
        ]);
    }
    features
}

// The features whose `(register, bit index, feature)` entry has its bit set.
fun select(entries: &[(u32, u32, CpuFeature)]) u32 {
    let mut features = 0u32;
    for &(register, index, feature) in entries {
        if has(register, index) {
            features |= bit(feature);
        }
    }
    features
}

fun has(register: u32, index: u32) bool {
    ((register >> index) & 1) != 0
}
