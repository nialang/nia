using root::slice;
using root::unicode;

pub enum BufferError: i32 {
    EndOfStream = 1,
    ShortWrite = 2,
    NoSpace = 3,
    _,
}

pub trait Writer {
    type Error;

    fun shortWrite(&self) Error;

    // A write reports at most the number of bytes available in the source
    // slice; larger reports are converted to the standard I/O error.
    fun invalidWrite(&self) Error {
        self.shortWrite()
    }

    fun write(&mut self, bytes: &[u8]) Error!usize;

    fun flush(&mut self) Error!() {
        !()
    }

    fun writeByte(&mut self, byte: u8) Error!() {
        let bytes: [u8; 1] = [byte];
        self.writeAll(&bytes[..])
    }

    fun writeAll(&mut self, bytes: &[u8]) Error!() {
        let mut written: usize = 0;
        while written < bytes.len() {
            let chunk = & bytes[written..];
            let n = self.write(chunk).?;
            if n == 0 {
                return self.shortWrite()!;
            }
            if n > chunk.len() {
                return self.invalidWrite()!;
            }
            written += n;
        }
        !()
    }

    fun writeUtf8(&mut self, text: &[char]) Error!() {
        for &ch in text {
            self.writeAll(ch.encodeUtf8().bytes()).?;
        }
        !()
    }
}

pub trait Reader {
    type Error;

    fun endOfStream(&self) Error;

    // A read reports at most the number of bytes available in the destination
    // slice; larger reports are converted to the standard I/O error.
    fun invalidRead(&self) Error {
        self.endOfStream()
    }

    fun read(&mut self, bytes: &mut [u8]) Error!usize;

    fun readExact(&mut self, bytes: &mut [u8]) Error!() {
        let mut read: usize = 0;
        while read < bytes.len() {
            let chunk = &mut bytes[read..];
            let n = self.read(chunk).?;
            if n == 0 {
                return self.endOfStream()!;
            }
            if n > chunk.len() {
                return self.invalidRead()!;
            }
            read += n;
        }
        !()
    }
}
