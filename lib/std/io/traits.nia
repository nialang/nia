pub enum BufferError: i32 {
    EndOfStream = 1,
    ShortWrite = 2,
    NoSpace = 3,
    _,
}

pub trait Writer {
    type Error;

    fn shortWrite(&self) Error;

    fn write(&mut self, bytes: &[u8]) Error!usize;

    fn flush(&mut self) Error!void {
        !{}
    }

    fn writeByte(&mut self, byte: u8) Error!void {
        let bytes: [1]u8 = [byte];
        self.writeAll(&bytes[..])
    }

    fn writeAll(&mut self, bytes: &[u8]) Error!void {
        let mut written = 0usize;
        while written < bytes.len() {
            let chunk = & bytes[written..];
            let n = self.write(chunk).?;
            if n == 0 {
                return self.shortWrite()!;
            }
            written += n;
        }
        !{}
    }
}

pub trait Reader {
    type Error;

    fn endOfStream(&self) Error;

    fn read(&mut self, bytes: &mut [u8]) Error!usize;

    fn readExact(&mut self, bytes: &mut [u8]) Error!void {
        let mut read = 0usize;
        while read < bytes.len() {
            let chunk = &mut bytes[read..];
            let n = self.read(chunk).?;
            if n == 0 {
                return self.endOfStream()!;
            }
            read += n;
        }
        !{}
    }
}
