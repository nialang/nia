using pkg::slice;

pub enum BufferError: i32 {
    EndOfStream = 1,
    ShortWrite = 2,
    NoSpace = 3,
    _,
}

pub trait Writer {
    type Error;

    fn shortWrite(&self) Error;

    // A write reports at most the number of bytes available in the source
    // slice; larger reports are converted to the standard I/O error.
    fn invalidWrite(&self) Error {
        self.shortWrite()
    }

    fn write(&mut self, bytes: &[u8]) Error!usize;

    fn flush(&mut self) Error!() {
        !()
    }

    fn writeByte(&mut self, byte: u8) Error!() {
        let bytes: [u8; 1] = [byte];
        self.writeAll(&bytes[..])
    }

    fn writeAll(&mut self, bytes: &[u8]) Error!() {
        let mut written: usize = 0;
        while written < bytes.len() {
            let chunk = & bytes[written..];
            let n = self.write(chunk).?;
            if n == 0 {
                return self.shortWrite()!;
            }
            if n > chunk.len() {
                return self.invalidWrite()!;
            }
            written += n;
        }
        !()
    }

    fn writeUtf8(&mut self, text: &[char]) Error!() {
        for &ch in text {
            self.writeAll(ch.encodeUtf8().bytes()).?;
        }
        !()
    }
}

pub trait Reader {
    type Error;

    fn endOfStream(&self) Error;

    // A read reports at most the number of bytes available in the destination
    // slice; larger reports are converted to the standard I/O error.
    fn invalidRead(&self) Error {
        self.endOfStream()
    }

    fn read(&mut self, bytes: &mut [u8]) Error!usize;

    fn readExact(&mut self, bytes: &mut [u8]) Error!() {
        let mut read: usize = 0;
        while read < bytes.len() {
            let chunk = &mut bytes[read..];
            let n = self.read(chunk).?;
            if n == 0 {
                return self.endOfStream()!;
            }
            if n > chunk.len() {
                return self.invalidRead()!;
            }
            read += n;
        }
        !()
    }
}
