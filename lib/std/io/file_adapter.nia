using pkg::fs;
using pkg::io::traits;
using pkg::os;
using pkg::slice;

using traits::{Reader, Writer};

pub struct FileWriter {
    file: FileSource,
    buffer: &mut [u8],
    len: usize,
}

pub struct FileReader {
    file: FileSource,
    buffer: &mut [u8],
    start: usize,
    end: usize,
}

enum FileSource {
    Borrowed(&fs::File),
    Standard(os::FileHandle),
}

extend FileSource {
    fn handle(&self) fs::Error!os::FileHandle {
        match self.* {
            .Borrowed(file) => file.borrowHandle(),
            .Standard(handle) => !handle,
        }
    }
}

extend fs::File {
    pub fn writer(&self, buffer: &mut [u8]) fs::Error!FileWriter {
        _ = self.borrowHandle().?;
        !FileWriter::init(FileSource::Borrowed(self), buffer)
    }

    pub fn reader(&self, buffer: &mut [u8]) fs::Error!FileReader {
        _ = self.borrowHandle().?;
        !FileReader::init(FileSource::Borrowed(self), buffer)
    }
}

extend FileWriter {
    fn init(file: FileSource, buffer: &mut [u8]) FileWriter {
        Self { file, buffer, len: 0 }
    }

    pub fn stdout(buffer: &mut [u8]) FileWriter {
        FileWriter::init(FileSource::Standard(os::FileHandle::stdout()), buffer)
    }

    pub fn stderr(buffer: &mut [u8]) FileWriter {
        FileWriter::init(FileSource::Standard(os::FileHandle::stderr()), buffer)
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn capacity(&self) usize {
        self.buffer.len()
    }

    pub fn buffered(&self) &[u8] {
        & self.buffer[0..self.len]
    }

    fn write_direct(&mut self, bytes: &[u8]) fs::Error!usize {
            let n = self.file.handle().?.writeSome(bytes).?;
        if n > bytes.len() {
            return fs::Error::Io!;
        }
        !n
    }

    fn append_buffered(&mut self, bytes: &[u8]) () {
        let mut index = 0usize;
        while index < bytes.len() {
            self.buffer[self.len + index] = bytes[index];
            index += 1usize;
        }
        self.len += bytes.len();
    }
}

extend FileWriter : Writer {
    type Error = fs::Error;

    pub fn shortWrite(&self) Error {
        fs::Error::Io
    }

    pub fn write(&mut self, bytes: &[u8]) Error!usize {
        if bytes.len() == 0 {
            !0
        } else if self.buffer.len() == 0 {
            self.write_direct(bytes)
        } else if bytes.len() > self.buffer.len() {
            self.flush().?;
            self.write_direct(bytes)
        } else {
            let available = self.buffer.len() - self.len;
            if bytes.len() > available {
                self.flush().?;
            }
            self.append_buffered(bytes);
            !bytes.len()
        }
    }

    pub fn flush(&mut self) Error!() {
        while self.len != 0 {
            let n = self.write_direct(& self.buffer[0..self.len]).?;
            if n == 0 {
                return self.shortWrite()!;
            }
            if n > self.len {
                return self.invalidWrite()!;
            }
            if n == self.len {
                self.len = 0;
            } else {
                let mut index = n;
                while index < self.len {
                    self.buffer[index - n] = self.buffer[index];
                    index += 1usize;
                }
                self.len -= n;
            }
        }
        !()
    }
}

extend FileReader {
    fn init(file: FileSource, buffer: &mut [u8]) FileReader {
        Self { file, buffer, start: 0, end: 0 }
    }

    pub fn stdin(buffer: &mut [u8]) FileReader {
        FileReader::init(FileSource::Standard(os::FileHandle::stdin()), buffer)
    }

    pub fn len(&self) usize {
        self.end - self.start
    }

    pub fn capacity(&self) usize {
        self.buffer.len()
    }

    pub fn buffered(&self) &[u8] {
        & self.buffer[self.start..self.end]
    }

    pub fn discardBuffered(&mut self) () {
        self.start = 0;
        self.end = 0;
    }

    fn read_direct(&mut self, bytes: &mut [u8]) fs::Error!usize {
        let n = self.file.handle().?.readSome(bytes).?;
        if n > bytes.len() {
            return fs::Error::Io!;
        }
        !n
    }

    fn read_buffered(&mut self, bytes: &mut [u8]) usize {
        let mut count = bytes.len();
        if count > self.len() {
            count = self.len();
        }

        _ = (&mut bytes[0..count]).copyFrom(&self.buffer[self.start..(self.start + count)]);
        self.start += count;
        if self.start == self.end {
            self.discardBuffered();
        }
        count
    }
}

extend FileReader : Reader {
    type Error = fs::Error;

    pub fn endOfStream(&self) Error {
        fs::Error::Io
    }

    pub fn read(&mut self, bytes: &mut [u8]) Error!usize {
        if bytes.len() == 0 {
            !0
        } else if self.len() != 0 {
            !self.read_buffered(bytes)
        } else if self.buffer.len() == 0 or bytes.len() >= self.buffer.len() {
            self.read_direct(bytes)
        } else {
            self.start = 0;
            self.end = self.read_direct(self.buffer).?;
            if self.end == 0 {
                !0
            } else {
                !self.read_buffered(bytes)
            }
        }
    }
}
