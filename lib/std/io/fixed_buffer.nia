using pkg::io::traits;
using pkg::math;
using pkg::slice;

using traits::{BufferError, Reader, Writer};

pub struct FixedBufferWriter {
    buffer: &mut [u8],
    len: usize,
}

pub struct FixedBufferReader {
    buffer: &[u8],
    cursor: usize,
}

pub struct DiscardingWriter {
    len: usize,
}

extend FixedBufferWriter {
    pub fun init(buffer: &mut [u8]) FixedBufferWriter {
        .{ buffer, len: 0 }
    }

    pub fun len(&self) usize {
        self.len
    }

    pub fun capacity(&self) usize {
        self.buffer.len()
    }

    pub fun written(&self) &[u8] {
        & self.buffer[0..self.len]
    }

    pub fun writeAll(&mut self, bytes: &[u8]) BufferError!() {
        if bytes.len() > self.buffer.len() - self.len {
            return .NoSpace!;
        }
        _ = (&mut self.buffer[self.len..(self.len + bytes.len())]).copyFrom(bytes);
        self.len += bytes.len();
        !()
    }
}

extend FixedBufferWriter : Writer {
    type Error = BufferError;

    pub fun shortWrite(&self) BufferError {
        .NoSpace
    }

    pub fun write(&mut self, bytes: &[u8]) BufferError!usize {
        let remaining = self.buffer.len() - self.len;
        let mut count = bytes.len();
        if count > remaining {
            count = remaining;
        }

        _ = (&mut self.buffer[self.len..(self.len + count)]).copyFrom(&bytes[0..count]);
        self.len += count;
        !count
    }
}

extend FixedBufferReader {
    pub fun init(buffer: &[u8]) FixedBufferReader {
        .{ buffer, cursor: 0 }
    }

    pub fun remaining(&self) usize {
        self.buffer.len() - self.cursor
    }
}

extend FixedBufferReader : Reader {
    type Error = BufferError;

    pub fun endOfStream(&self) BufferError {
        .EndOfStream
    }

    pub fun read(&mut self, bytes: &mut [u8]) BufferError!usize {
        let remaining = self.buffer.len() - self.cursor;
        let mut count = bytes.len();
        if count > remaining {
            count = remaining;
        }

        _ = (&mut bytes[0..count]).copyFrom(&self.buffer[self.cursor..(self.cursor + count)]);
        self.cursor += count;
        !count
    }
}

extend DiscardingWriter {
    pub fun init() DiscardingWriter {
        .{ len: 0 }
    }

    pub fun len(&self) usize {
        self.len
    }
}

extend DiscardingWriter : Writer {
    type Error = BufferError;

    pub fun shortWrite(&self) BufferError {
        _ = self;
        .ShortWrite
    }

    pub fun write(&mut self, bytes: &[u8]) BufferError!usize {
        self.len = match self.len.checkedAdd(bytes.len()) {
            ?value => value,
            null => usize::MAX,
        };
        !bytes.len()
    }
}
