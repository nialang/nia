// Byte-count limits for readers.
//
// Like every generic I/O adapter, the limited reader preserves the wrapped
// reader's invalid-transfer error identity and rejects impossible byte counts
// before mutating state.

using root::io::traits;

using traits::Reader;

pub struct Limit {
    remaining: ?usize,
}

pub struct LimitedReader[R] {
    reader: &mut R,
    limit: Limit,
}

extend Limit {
    pub fun unlimited() Limit {
        .{ remaining: null }
    }

    pub fun limited(remaining: usize) Limit {
        .{ remaining: ?remaining }
    }

    pub fun remaining(&self) ?usize {
        self.remaining
    }
}

extend[R] LimitedReader[R]
where R: Reader
{
    pub fun init(reader: &mut R, limit: Limit) LimitedReader[R] {
        .{ reader, limit }
    }

    pub fun remaining(&self) ?usize {
        self.limit.remaining()
    }
}

extend[R] LimitedReader[R] : Reader
where R: Reader
{
    type Error = [R as Reader]::Error;

    pub fun endOfStream(&self) Error {
        self.reader.endOfStream()
    }

    pub fun invalidRead(&self) Error {
        self.reader.invalidRead()
    }

    pub fun read(&mut self, bytes: &mut [u8]) Error!usize {
        if self.limit.remaining is ?remaining {
            if remaining == 0 {
                return !0;
            }
            let mut count = bytes.len();
            if count > remaining {
                count = remaining;
            }
            let chunk = &mut bytes[0..count];
            let n = self.reader.read(chunk).?;
            if n > count {
                return self.invalidRead()!;
            }
            if self.limit.remaining is ?current {
                self.limit = .limited(current - n);
            }
            return !n;
        }

        let n = self.reader.read(bytes).?;
        if n > bytes.len() {
            return self.invalidRead()!;
        }
        !n
    }
}
