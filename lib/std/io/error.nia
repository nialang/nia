using pkg::error;
using pkg::os;

pub enum SystemError: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    NotEmpty = 39,
    System = 255,
    _,
}

pub enum Error {
    EndOfStream,
    ShortWrite,
    Closed,
    System(SystemError),
}

extend os::Error : error::IntoError[SystemError] {
    const fn intoError(self) SystemError {
        match self {
            .PermissionDenied => .PermissionDenied,
            .NotFound => .NotFound,
            .Interrupted => .Interrupted,
            .Io => .Io,
            .BadFd => .BadFd,
            .Again => .Again,
            .OutOfMemory => .OutOfMemory,
            .Access => .Access,
            .Fault => .Fault,
            .Busy => .Busy,
            .AlreadyExists => .AlreadyExists,
            .CrossDevice => .CrossDevice,
            .NotDir => .NotDir,
            .IsDir => .IsDir,
            .Invalid => .Invalid,
            .NoSpace => .NoSpace,
            .ReadOnly => .ReadOnly,
            .BrokenPipe => .BrokenPipe,
            .OutOfRange => .OutOfRange,
            .TooLong => .TooLong,
            .NotEmpty => .NotEmpty,
            _ => .System,
        }
    }
}

extend os::Error : error::IntoError[Error] {
    const fn intoError(self) Error {
        match self {
            .PermissionDenied => .System(SystemError::PermissionDenied),
            .NotFound => .System(SystemError::NotFound),
            .Interrupted => .System(SystemError::Interrupted),
            .Io => .System(SystemError::Io),
            .BadFd => .System(SystemError::BadFd),
            .Again => .System(SystemError::Again),
            .OutOfMemory => .System(SystemError::OutOfMemory),
            .Access => .System(SystemError::Access),
            .Fault => .System(SystemError::Fault),
            .Busy => .System(SystemError::Busy),
            .AlreadyExists => .System(SystemError::AlreadyExists),
            .CrossDevice => .System(SystemError::CrossDevice),
            .NotDir => .System(SystemError::NotDir),
            .IsDir => .System(SystemError::IsDir),
            .Invalid => .System(SystemError::Invalid),
            .NoSpace => .System(SystemError::NoSpace),
            .ReadOnly => .System(SystemError::ReadOnly),
            .BrokenPipe => .System(SystemError::BrokenPipe),
            .OutOfRange => .System(SystemError::OutOfRange),
            .TooLong => .System(SystemError::TooLong),
            .NotEmpty => .System(SystemError::NotEmpty),
            _ => .System(SystemError::System),
        }
    }
}
