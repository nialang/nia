using pkg::error;
using pkg::os;

pub enum SystemError: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    NotEmpty = 39,
    System = 255,
    _,
}

pub enum Error {
    EndOfStream,
    ShortWrite,
    Closed,
    System(SystemError),
}

extend os::Error : error::IntoError[SystemError] {
    const fn intoError(self) SystemError {
        match self {
            .PermissionDenied => SystemError::PermissionDenied,
            .NotFound => SystemError::NotFound,
            .Interrupted => SystemError::Interrupted,
            .Io => SystemError::Io,
            .BadFd => SystemError::BadFd,
            .Again => SystemError::Again,
            .OutOfMemory => SystemError::OutOfMemory,
            .Access => SystemError::Access,
            .Fault => SystemError::Fault,
            .Busy => SystemError::Busy,
            .AlreadyExists => SystemError::AlreadyExists,
            .CrossDevice => SystemError::CrossDevice,
            .NotDir => SystemError::NotDir,
            .IsDir => SystemError::IsDir,
            .Invalid => SystemError::Invalid,
            .NoSpace => SystemError::NoSpace,
            .ReadOnly => SystemError::ReadOnly,
            .BrokenPipe => SystemError::BrokenPipe,
            .OutOfRange => SystemError::OutOfRange,
            .TooLong => SystemError::TooLong,
            .NotEmpty => SystemError::NotEmpty,
            _ => SystemError::System,
        }
    }
}

extend os::Error : error::IntoError[Error] {
    const fn intoError(self) Error {
        match self {
            .PermissionDenied => Error::System(SystemError::PermissionDenied),
            .NotFound => Error::System(SystemError::NotFound),
            .Interrupted => Error::System(SystemError::Interrupted),
            .Io => Error::System(SystemError::Io),
            .BadFd => Error::System(SystemError::BadFd),
            .Again => Error::System(SystemError::Again),
            .OutOfMemory => Error::System(SystemError::OutOfMemory),
            .Access => Error::System(SystemError::Access),
            .Fault => Error::System(SystemError::Fault),
            .Busy => Error::System(SystemError::Busy),
            .AlreadyExists => Error::System(SystemError::AlreadyExists),
            .CrossDevice => Error::System(SystemError::CrossDevice),
            .NotDir => Error::System(SystemError::NotDir),
            .IsDir => Error::System(SystemError::IsDir),
            .Invalid => Error::System(SystemError::Invalid),
            .NoSpace => Error::System(SystemError::NoSpace),
            .ReadOnly => Error::System(SystemError::ReadOnly),
            .BrokenPipe => Error::System(SystemError::BrokenPipe),
            .OutOfRange => Error::System(SystemError::OutOfRange),
            .TooLong => Error::System(SystemError::TooLong),
            .NotEmpty => Error::System(SystemError::NotEmpty),
            _ => Error::System(SystemError::System),
        }
    }
}
