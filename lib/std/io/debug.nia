using pkg::builtin;
using pkg::fmt;
using pkg::fs;
using pkg::io;

pub enum DebugPrintError {
    Format(fmt::Error),
    Flush(fs::Error),
}

extend fmt::Error : builtin::IntoError[DebugPrintError] {
    const fn intoError(self) DebugPrintError {
        DebugPrintError::Format(self)
    }
}

extend fs::Error : builtin::IntoError[DebugPrintError] {
    const fn intoError(self) DebugPrintError {
        DebugPrintError::Flush(self)
    }
}

pub fn debugPrint(template: &[char], args: &[&fmt::Format]) DebugPrintError!() {
    let mut buffer: [u8; 512] = [0; 512];
    let mut stderr = io::FileWriter::stderr(&mut buffer);

    stderr.print(template, args).?;
    stderr.flush().?;
    !()
}
