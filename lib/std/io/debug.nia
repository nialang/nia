using root::builtin;
using root::fmt;
using root::fmt::template;  // For .print() extension method
using root::fs;
using root::io;

pub enum DebugPrintError {
    Format(fmt::Error),
    Flush(fs::Error),
}

extend fmt::Error : builtin::IntoError[DebugPrintError] {
    const fun intoError(self) DebugPrintError {
        DebugPrintError::Format(self)
    }
}

extend fs::Error : builtin::IntoError[DebugPrintError] {
    const fun intoError(self) DebugPrintError {
        DebugPrintError::Flush(self)
    }
}

pub fun debugPrint(template: &[char], args: &[&fmt::Format]) DebugPrintError!() {
    let mut buffer: [u8; 512] = [0; 512];
    let mut stderr = io::FileWriter::stderr(buffer);

    stderr.print(template, args).?;
    stderr.flush().?;
    !()
}
