// Appends a reader's remaining bytes to caller-owned storage.
//
// Partial bytes remain in the output on every error, so a failed read or
// allocation never drops an owner that the caller cannot recover.

using root::collections::ArrayList;
using root::mem;
using root::cmp;
using root::result;
using root::io::traits::Reader;

pub enum ReadToEndError[E] {
    Read(E),
    Memory(mem::Error),
    LimitExceeded,
}

pub fun readToEnd[R](
    reader: &mut R,
    allocator: &mut mem::Allocator,
    maxBytes: usize,
    output: &mut ArrayList[u8],
) ReadToEndError[[R as Reader]::Error]!()
where R: Reader
{
    if output.len() > maxBytes {
        return .LimitExceeded!;
    }
    let mut chunk: [u8; 4096] = [0; 4096];
    loop {
        let remaining = maxBytes - output.len();
        // Probe one byte past the limit without overflowing even at usize::MAX.
        let request = cmp::min(remaining, chunk.len() - 1) + 1;
        if remaining != 0 {
            let additional = cmp::min(remaining, chunk.len());
            output.reserveExact(allocator, additional).mapError(.Memory).?;
        }
        let bytes = &mut chunk[0..request];
        let count = reader.read(bytes).mapError(.Read).?;
        if count > request {
            return .Read(reader.invalidRead())!;
        }
        if count == 0 {
            return !();
        }
        let accepted = cmp::min(count, remaining);
        output.appendSlice(allocator, &chunk[0..accepted]).mapError(.Memory).?;
        if count > remaining {
            return .LimitExceeded!;
        }
    }
}
