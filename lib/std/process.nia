pub struct ExitCode {
    code: i32,
}

pub struct Init {
    argc: usize,
    argv: &&u8,
    envp: &&u8,
}

extend Init {
    pub fn init(argc: usize, argv: &&u8, envp: &&u8) Init {
        { argc: argc, argv: argv, envp: envp }
    }

    pub fn argc(&self) usize {
        self.argc
    }

    pub fn argv(&self) &&u8 {
        self.argv
    }

    pub fn envp(&self) &&u8 {
        self.envp
    }
}

extend ExitCode {
    pub fn init(code: i32) ExitCode {
        { code: code }
    }

    pub fn success() ExitCode {
        ExitCode::init(0)
    }

    pub fn code(&self) i32 {
        self.code
    }
}

pub fn exit(code: i32) ExitCode {
    ExitCode::init(code)
}
