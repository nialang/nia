// Process startup views, commands, child handles, environment, and exit codes.
//
// Command configuration is borrowed until spawn produces an attempt. Finishing
// an attempt releases its staging state and returns either a child or a typed
// failure. Child streams and handles expose explicit close and wait operations,
// while failures retain their stage and underlying cause.

pub(pkg) module args;
pub(pkg) module child;
pub(pkg) module command;
pub(pkg) module env;
pub(pkg) module exit;
pub(pkg) module init;
pub(pkg) module pipe;
pub(pkg) module term;
pub(pkg) module types;

using pkg::process::args;
using pkg::process::child;
using pkg::process::command;
using pkg::process::env;
using pkg::process::exit;
using pkg::process::init;
using pkg::process::pipe;
using pkg::process::term;

pub using exit::exit;
pub using types::{
    Arg,
    AllocatorSpawnAttempt,
    Args,
    ArgsIter,
    Child,
    ChildStderr,
    ChildStdin,
    ChildStdout,
    Command,
    Env,
    EnvEntry,
    EnvEntryError,
    EnvIter,
    EnvVar,
    Error,
    ExitCode,
    Init,
    ProcessId,
    Signal,
    SpawnAttempt,
    SpawnError,
    SpawnStage,
    StdIo,
    StdStream,
    SystemError,
    Term,
    TermKind,
};
