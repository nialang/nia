using pkg::cstr;
using pkg::fs;
using pkg::fmt;
using pkg::io;
using pkg::mem;
using pkg::os;

pub enum ExitCode: i32 {
    Success = 0,
    _,
}

pub enum TermKind: i32 {
    Exited = 1,
    Signal = 2,
    Stopped = 3,
    Unknown = 4,
}

pub enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub struct Term {
    kind: TermKind,
    code: i32,
}

pub struct Command {
    path: cstr::CStr,
    argv: &&u8,
    envp: &&u8,
    stdin: StdIo,
    stdout: StdIo,
    stderr: StdIo,
}

pub struct Args {
    len: usize,
    ptr: &&u8,
}

pub struct ArgsIter {
    args: Args,
    index: usize,
}

pub struct Arg {
    text: cstr::CStr,
}

pub struct Env {
    ptr: &&u8,
}

pub struct EnvIter {
    env: Env,
    len: usize,
    index: usize,
}

pub struct EnvVar {
    text: cstr::CStr,
}

pub struct Child {
    pid: os::ProcessId,
    stdin: ?os::FileHandle,
    stdout: ?os::FileHandle,
    stderr: ?os::FileHandle,
}

pub struct Init {
    argc: usize,
    argv: &&u8,
    envp: &&u8,
    io: &mut io::Io[Error = os::Error],
}

extend Command {
    pub fn init(path: cstr::CStr, argv: &&u8, envp: &&u8) Command {
        {
            path: path,
            argv: argv,
            envp: envp,
            stdin: StdIo::Inherit,
            stdout: StdIo::Inherit,
            stderr: StdIo::Inherit,
        }
    }

    pub fn path(&self) cstr::CStr {
        self.path
    }

    pub fn argv(&self) &&u8 {
        self.argv
    }

    pub fn envp(&self) &&u8 {
        self.envp
    }

    pub fn stdin(&self) StdIo {
        self.stdin
    }

    pub fn stdout(&self) StdIo {
        self.stdout
    }

    pub fn stderr(&self) StdIo {
        self.stderr
    }

    pub fn set_stdin(&mut self, behavior: StdIo) void {
        self.stdin = behavior;
    }

    pub fn set_stdout(&mut self, behavior: StdIo) void {
        self.stdout = behavior;
    }

    pub fn set_stderr(&mut self, behavior: StdIo) void {
        self.stderr = behavior;
    }

    pub fn spawn(&self) os::Error!Child {
        var options = os::SpawnOptions::init();
        options.set_stdin(self.stdin.as_os_stdio());
        options.set_stdout(self.stdout.as_os_stdio());
        options.set_stderr(self.stderr.as_os_stdio());
        spawn_with_options(self.path.raw_ptr(), self.argv, self.envp, options)
    }

    pub fn run(&self) os::Error!Term {
        var child = self.spawn().?;
        child.wait()
    }
}

extend StdIo {
    fn as_os_stdio(self) os::StdIo {
        switch self {
            StdIo::Inherit => os::StdIo::Inherit,
            StdIo::Ignore => os::StdIo::Ignore,
            StdIo::Pipe => os::StdIo::Pipe,
            _ => os::StdIo::Inherit,
        }
    }
}

extend Child {
    pub fn init(pid: os::ProcessId) Child {
        { pid: pid, stdin: null, stdout: null, stderr: null }
    }

    pub fn from_spawn_result(result: os::SpawnResult) Child {
        {
            pid: result.pid(),
            stdin: result.stdin(),
            stdout: result.stdout(),
            stderr: result.stderr(),
        }
    }

    pub fn pid(&self) os::ProcessId {
        self.pid
    }

    pub fn take_stdin(&mut self) ?os::FileHandle {
        let handle = self.stdin;
        self.stdin = null;
        handle
    }

    pub fn take_stdout(&mut self) ?os::FileHandle {
        let handle = self.stdout;
        self.stdout = null;
        handle
    }

    pub fn take_stderr(&mut self) ?os::FileHandle {
        let handle = self.stderr;
        self.stderr = null;
        handle
    }

    pub fn close_stdin(&mut self) os::Error!void {
        if let ?handle = self.take_stdin() {
            handle.close()
        } else null {
            !{}
        }
    }

    pub fn close_stdout(&mut self) os::Error!void {
        if let ?handle = self.take_stdout() {
            handle.close()
        } else null {
            !{}
        }
    }

    pub fn close_stderr(&mut self) os::Error!void {
        if let ?handle = self.take_stderr() {
            handle.close()
        } else null {
            !{}
        }
    }

    pub fn close_pipes(&mut self) os::Error!void {
        self.close_stdin().?;
        self.close_stdout().?;
        self.close_stderr().?;
        !{}
    }

    pub fn wait_raw(&mut self) os::Error!os::WaitStatus {
        self.close_stdin().?;
        os::wait(self.pid)
    }

    pub fn wait(&mut self) os::Error!Term {
        let status = self.wait_raw().?;
        self.close_stdout().?;
        self.close_stderr().?;
        !Term::from_wait_status(status)
    }
}

extend Term {
    pub fn exited(code: i32) Term {
        { kind: TermKind::Exited, code: code }
    }

    pub fn signal(signal: i32) Term {
        { kind: TermKind::Signal, code: signal }
    }

    pub fn stopped(signal: i32) Term {
        { kind: TermKind::Stopped, code: signal }
    }

    pub fn unknown(raw: i32) Term {
        { kind: TermKind::Unknown, code: raw }
    }

    pub fn from_wait_status(status: os::WaitStatus) Term {
        if let ?code = status.exit_code() {
            Term::exited(code)
        } else if let ?signal = status.signal() {
            Term::signal(signal)
        } else if let ?signal = status.stop_signal() {
            Term::stopped(signal)
        } else {
            Term::unknown(status.raw())
        }
    }

    pub fn kind(&self) TermKind {
        self.kind
    }

    pub fn code(&self) i32 {
        self.code
    }

    pub fn exited_success(&self) bool {
        self.kind == TermKind::Exited and self.code == 0
    }

    pub fn exit_code(&self) ?i32 {
        if self.kind == TermKind::Exited {
            ?self.code
        } else {
            null
        }
    }

    pub fn signal_code(&self) ?i32 {
        if self.kind == TermKind::Signal {
            ?self.code
        } else {
            null
        }
    }
}

extend Init {
    pub fn init(argc: usize, argv: &&u8, envp: &&u8, io: &mut io::Io[Error = os::Error]) Init {
        { argc: argc, argv: argv, envp: envp, io: io }
    }

    pub fn argc(&self) usize {
        self.argc
    }

    pub fn args(&self) Args {
        Args::init(self.argc, self.argv)
    }

    pub fn env(&self) Env {
        Env::init(self.envp)
    }

    pub fn raw_argv(&self) &&u8 {
        self.argv
    }

    pub fn raw_envp(&self) &&u8 {
        self.envp
    }

    pub fn io(&self) &mut io::Io[Error = os::Error] {
        self.io
    }
}

extend Arg {
    fn init(ptr: &u8) Arg {
        { text: cstr::CStr::from_ptr(ptr) }
    }

    pub fn raw_ptr(&self) &u8 {
        self.text.raw_ptr()
    }

    pub fn cstr(&self) cstr::CStr {
        self.text
    }

    pub fn bytes(&self) &[u8] {
        self.text.bytes()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn is_empty(&self) bool {
        self.len() == 0usize
    }
}

extend Arg : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        self.text.format(formatter)
    }

    fn format_spec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!void {
        self.text.format_spec(formatter, spec)
    }
}

extend[T] T : fmt::ParseFrom[Arg]
where T: fmt::ParseFrom[cstr::CStr]
{
    fn parse_from(input: Arg) fmt::ParseError!T {
        fmt::parse[T](input.cstr())
    }

    fn parse_radix_from(input: Arg, radix: u32) fmt::ParseError!T {
        fmt::parse_radix[T](input.cstr(), radix)
    }
}

extend Args {
    pub fn init(len: usize, ptr: &&u8) Args {
        { len: len, ptr: ptr }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn is_empty(&self) bool {
        self.len == 0
    }

    pub fn program(&self) ?Arg {
        self.get(0usize)
    }

    pub fn get(&self, index: usize) ?Arg {
        if index >= self.len {
            null
        } else {
            ?Arg::init(self.ptr[index])
        }
    }

    pub fn iter(&self) ArgsIter {
        ArgsIter::init(self.*, 0usize)
    }

    pub fn skip_program(&self) ArgsIter {
        ArgsIter::init(self.*, 1usize)
    }

    pub fn raw_argv(&self) &&u8 {
        self.ptr
    }
}

extend ArgsIter {
    pub fn init(args: Args, index: usize) ArgsIter {
        var start = index;
        if start > args.len() {
            start = args.len();
        }
        { args: args, index: start }
    }

    pub fn remaining(&self) usize {
        self.args.len() - self.index
    }
}

extend ArgsIter : Iterator {
    type Item = Arg;

    pub fn next(&mut self) ?Arg {
        let value = if let ?value = self.args.get(self.index) {
            value
        } else null {
            return null;
        };
        self.index += 1usize;
        ?value
    }
}

extend EnvVar {
    fn init(ptr: &u8) EnvVar {
        { text: cstr::CStr::from_ptr(ptr) }
    }

    pub fn raw_ptr(&self) &u8 {
        self.text.raw_ptr()
    }

    pub fn cstr(&self) cstr::CStr {
        self.text
    }

    pub fn bytes(&self) &[u8] {
        self.text.bytes()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn is_empty(&self) bool {
        self.len() == 0usize
    }
}

extend EnvVar : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        self.text.format(formatter)
    }

    fn format_spec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!void {
        self.text.format_spec(formatter, spec)
    }
}

extend[T] T : fmt::ParseFrom[EnvVar]
where T: fmt::ParseFrom[cstr::CStr]
{
    fn parse_from(input: EnvVar) fmt::ParseError!T {
        fmt::parse[T](input.cstr())
    }

    fn parse_radix_from(input: EnvVar, radix: u32) fmt::ParseError!T {
        fmt::parse_radix[T](input.cstr(), radix)
    }
}

extend Env {
    pub fn init(ptr: &&u8) Env {
        { ptr: ptr }
    }

    pub fn len(&self) usize {
        var len = 0usize;
        while self.ptr[len] as usize != 0 {
            len += 1;
        }
        len
    }

    pub fn get(&self, index: usize) ?EnvVar {
        if index >= self.len() {
            null
        } else {
            ?EnvVar::init(self.ptr[index])
        }
    }

    pub fn iter(&self) EnvIter {
        EnvIter::init(self.*, 0usize)
    }

    pub fn raw_envp(&self) &&u8 {
        self.ptr
    }
}

extend EnvIter {
    pub fn init(env: Env, index: usize) EnvIter {
        let len = env.len();
        var start = index;
        if start > len {
            start = len;
        }
        { env: env, len: len, index: start }
    }

    pub fn remaining(&self) usize {
        self.len - self.index
    }
}

extend EnvIter : Iterator {
    type Item = EnvVar;

    pub fn next(&mut self) ?EnvVar {
        if self.index >= self.len {
            null
        } else {
            let value = if let ?value = self.env.get(self.index) {
                value
            } else null {
                return null;
            };
            self.index += 1usize;
            ?value
        }
    }
}

extend fs::Error {
    pub fn as_exit_code(self) ExitCode {
        self as i32 as ExitCode
    }
}

pub fn exit(code: i32) ExitCode {
    code as ExitCode
}

pub fn spawn_raw(path: &u8, argv: &&u8, envp: &&u8) os::Error!Child {
    let pid = os::spawn_raw(path, argv, envp).?;
    !Child::init(pid)
}

pub fn spawn_with_options(path: &u8, argv: &&u8, envp: &&u8, options: os::SpawnOptions) os::Error!Child {
    let result = os::spawn(path, argv, envp, options).?;
    !Child::from_spawn_result(result)
}

pub fn spawn(command: &Command) os::Error!Child {
    command.spawn()
}

pub fn run(command: &Command) os::Error!Term {
    command.run()
}

extend os::Error {
    pub fn as_exit_code(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend[T] os::Error!T {
    pub fn exit(self) ExitCode!T {
        if let !value = self {
            !value
        } else error! {
            error.as_exit_code()!
        }
    }
}

extend[T] fs::Error!T {
    pub fn exit(self) ExitCode!T {
        if let !value = self {
            !value
        } else error! {
            error.as_exit_code()!
        }
    }
}

extend fmt::Error {
    pub fn as_exit_code(self) ExitCode {
        switch self {
            fmt::Error::Write => exit(5),
            fmt::Error::InvalidTemplate => exit(22),
            fmt::Error::MissingArgument => exit(22),
            fmt::Error::ExtraArgument => exit(22),
            _ => exit(255),
        }
    }
}

extend[T] fmt::Error!T {
    pub fn exit(self) ExitCode!T {
        if let !value = self {
            !value
        } else error! {
            error.as_exit_code()!
        }
    }
}

extend mem::Error {
    pub fn as_exit_code(self) ExitCode {
        switch self {
            mem::Error::Invalid => exit(22),
            mem::Error::InvalidAlignment => exit(22),
            mem::Error::OutOfMemory => exit(12),
            _ => exit(255),
        }
    }
}

extend[T] mem::Error!T {
    pub fn exit(self) ExitCode!T {
        if let !value = self {
            !value
        } else error! {
            error.as_exit_code()!
        }
    }
}
