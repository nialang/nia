pub struct ExitCode {
    code: i32,
}

pub struct Args {
    len: usize,
    ptr: &&u8,
}

pub struct Arg {
    ptr: &u8,
}

pub struct Env {
    ptr: &&u8,
}

pub struct EnvVar {
    ptr: &u8,
}

pub struct Init {
    argc: usize,
    argv: &&u8,
    envp: &&u8,
}

extend Init {
    pub fn init(argc: usize, argv: &&u8, envp: &&u8) Init {
        { argc: argc, argv: argv, envp: envp }
    }

    pub fn argc(&self) usize {
        self.argc
    }

    pub fn args(&self) Args {
        Args::init(self.argc, self.argv)
    }

    pub fn env(&self) Env {
        Env::init(self.envp)
    }

    pub fn raw_argv(&self) &&u8 {
        self.argv
    }

    pub fn raw_envp(&self) &&u8 {
        self.envp
    }
}

extend &u8 {
    fn c_string_len(self) usize {
        var len = 0usize;
        while self[len] != 0u8 {
            len += 1;
        }
        len
    }

    fn c_string_bytes(self) &[u8] {
        & self[0..self.c_string_len()]
    }
}

extend Arg {
    fn init(ptr: &u8) Arg {
        { ptr: ptr }
    }

    pub fn raw_ptr(&self) &u8 {
        self.ptr
    }

    pub fn raw_bytes(&self) &[u8] {
        self.ptr.c_string_bytes()
    }

    pub fn raw_len(&self) usize {
        self.ptr.c_string_len()
    }

    pub fn is_empty(&self) bool {
        self.raw_len() == 0
    }
}

extend Args {
    pub fn init(len: usize, ptr: &&u8) Args {
        { len: len, ptr: ptr }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn is_empty(&self) bool {
        self.len == 0
    }

    pub fn get(&self, index: usize) ?Arg {
        if index >= self.len {
            null
        } else {
            ?Arg::init(self.ptr[index])
        }
    }

    pub fn raw_argv(&self) &&u8 {
        self.ptr
    }
}

extend EnvVar {
    fn init(ptr: &u8) EnvVar {
        { ptr: ptr }
    }

    pub fn raw_ptr(&self) &u8 {
        self.ptr
    }

    pub fn raw_bytes(&self) &[u8] {
        self.ptr.c_string_bytes()
    }

    pub fn raw_len(&self) usize {
        self.ptr.c_string_len()
    }

    pub fn is_empty(&self) bool {
        self.raw_len() == 0
    }
}

extend Env {
    pub fn init(ptr: &&u8) Env {
        { ptr: ptr }
    }

    pub fn len(&self) usize {
        var len = 0usize;
        while self.ptr[len] as usize != 0 {
            len += 1;
        }
        len
    }

    pub fn get(&self, index: usize) ?EnvVar {
        if index >= self.len() {
            null
        } else {
            ?EnvVar::init(self.ptr[index])
        }
    }

    pub fn raw_envp(&self) &&u8 {
        self.ptr
    }
}

extend ExitCode {
    pub fn init(code: i32) ExitCode {
        { code: code }
    }

    pub fn success() ExitCode {
        ExitCode::init(0)
    }

    pub fn code(&self) i32 {
        self.code
    }
}

pub fn exit(code: i32) ExitCode {
    ExitCode::init(code)
}
