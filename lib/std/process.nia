pub struct ExitCode {
    code: i32,
}

pub struct Args {
    len: usize,
    ptr: &&u8,
}

pub struct Env {
    ptr: &&u8,
}

pub struct Init {
    argc: usize,
    argv: &&u8,
    envp: &&u8,
}

extend Init {
    pub fn init(argc: usize, argv: &&u8, envp: &&u8) Init {
        { argc: argc, argv: argv, envp: envp }
    }

    pub fn argc(&self) usize {
        self.argc
    }

    pub fn args(&self) Args {
        Args::init(self.argc, self.argv)
    }

    pub fn env(&self) Env {
        Env::init(self.envp)
    }

    pub fn argv(&self) &&u8 {
        self.argv
    }

    pub fn envp(&self) &&u8 {
        self.envp
    }
}

fn c_string_len(ptr: &u8) usize {
    var len = 0usize;
    while ptr[len] != 0u8 {
        len += 1;
    }
    len
}

fn c_string_bytes(ptr: &u8) &[u8] {
    & ptr[0..c_string_len(ptr)]
}

extend Args {
    pub fn init(len: usize, ptr: &&u8) Args {
        { len: len, ptr: ptr }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn is_empty(&self) bool {
        self.len == 0
    }

    pub fn get(&self, index: usize) ?&[u8] {
        if index >= self.len {
            null
        } else {
            ?c_string_bytes(self.ptr[index])
        }
    }

    pub fn raw(&self) &&u8 {
        self.ptr
    }
}

extend Env {
    pub fn init(ptr: &&u8) Env {
        { ptr: ptr }
    }

    pub fn len(&self) usize {
        var len = 0usize;
        while self.ptr[len] as usize != 0 {
            len += 1;
        }
        len
    }

    pub fn get(&self, index: usize) ?&[u8] {
        if index >= self.len() {
            null
        } else {
            ?c_string_bytes(self.ptr[index])
        }
    }

    pub fn raw(&self) &&u8 {
        self.ptr
    }
}

extend ExitCode {
    pub fn init(code: i32) ExitCode {
        { code: code }
    }

    pub fn success() ExitCode {
        ExitCode::init(0)
    }

    pub fn code(&self) i32 {
        self.code
    }
}

pub fn exit(code: i32) ExitCode {
    ExitCode::init(code)
}
