pub struct Exit {
    code: i32,
}

pub struct Init {
    argc: usize,
    argv: &&u8,
    envp: &&u8,
}

pub fn init(argc: usize, argv: &&u8, envp: &&u8) Init {
    { argc: argc, argv: argv, envp: envp }
}

pub fn exit(code: i32) Exit {
    { code: code }
}

pub fn exit_code(exit: Exit) i32 {
    exit.code
}

pub fn argc(init: Init) usize {
    init.argc
}

pub fn argv(init: Init) &&u8 {
    init.argv
}

pub fn envp(init: Init) &&u8 {
    init.envp
}
