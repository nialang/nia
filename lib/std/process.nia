// Process startup views, commands, child handles, environment, and exit codes.
//
// Command configuration is borrowed until spawn produces an attempt. Finishing
// an attempt releases its staging state and returns either a child or a typed
// failure. Child streams and handles expose explicit close and wait operations,
// while failures retain their stage and underlying cause.

pub(root) module args;
pub(root) module child;
pub(root) module command;
pub(root) module convert;
pub(root) module env;
pub(root) module exit_code;
pub(root) module init;
pub(root) module pipe;
pub(root) module term;
pub(root) module types;

using root::process::args;
using root::process::child;
using root::process::command;
using root::process::convert;
using root::process::env;
using root::process::exit_code;
using root::process::init;
using root::process::pipe;
using root::process::term;

pub using types::{
    Arg,
    AllocatorSpawnAttempt,
    Args,
    ArgsIter,
    Child,
    ChildStderr,
    ChildStdin,
    ChildStdout,
    Command,
    Env,
    EnvEntry,
    EnvEntryError,
    EnvIter,
    EnvVar,
    Error,
    ExitCode,
    Init,
    ProcessId,
    Signal,
    SpawnAttempt,
    SpawnError,
    SpawnStage,
    StdIo,
    StdStream,
    SystemError,
    Term,
    TermKind,
};
pub using exit_code::exit;
