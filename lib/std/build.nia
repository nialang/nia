// Declarative package-build facade.
//
// A build script describes packages, modules, artifacts, actions, and their
// dependencies. Paths identify the package, build, and cache roots; target
// options distinguish the invocation artifact from host tools.
//
// Build retains the descriptors it needs in allocator-owned storage. Handles
// belong to their Build, and paths and commands keep their ownership and cache
// rules explicit. Initialization and teardown preserve partially owned state
// so failed cleanup can be retried without losing the original error.

pub(pkg) module commands;
pub(pkg) module core;
pub(pkg) module dependencies;
pub(pkg) module diagnostics;
pub(pkg) module error;
pub(pkg) module handles;
pub(pkg) module lifecycle;
pub(pkg) module modules;
pub(pkg) module ownership;
pub(pkg) module paths;
pub(pkg) module plan;
pub(pkg) module queries;
pub(pkg) module records_cleanup;
pub(pkg) module steps;
pub(pkg) module targets;
pub(pkg) module types;
pub(pkg) module validation;

using pkg::build::core;
using pkg::build::lifecycle;
using pkg::build::plan;

pub using error::{
    Error,
    ErrorCause,
    ErrorOperation,
    ErrorSubject,
};
pub using types::{
    Build,
    BuildInitAttempt,
    BuildPathView,
    ActionResourceClass,
    CommandCachePolicy,
    CommandEnvironmentInput,
    CommandEnvironmentPolicy,
    CommandArgument,
    ExternalCommandOptions,
    ExecutableHandle,
    ExecutableOptions,
    ObjectHandle,
    ObjectOptions,
    StaticArchiveHandle,
    StaticArchiveOptions,
    ModuleHandle,
    ModuleImport,
    ModuleOptions,
    PackageHandle,
    PackageOptions,
    OptimizationMode,
    RunOptions,
    TargetView,
    StepHandle,
};
