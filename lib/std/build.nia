// Build-script facade and owned build-plan construction.
//
// Public options are borrowed call descriptors. `Build` copies every retained
// string, path, argument, import, and target value into allocator-owned storage,
// validates graph ownership, and releases deep records explicitly.

pub(pkg) module core;
pub(pkg) module error;
pub(pkg) module plan;
pub(pkg) module types;

using pkg::build::core;
using pkg::build::plan;

pub using error::{
    Error,
    ErrorCause,
    ErrorOperation,
    ErrorSubject,
};
pub using types::{
    Build,
    BuildPathView,
    ActionResourceClass,
    CommandCachePolicy,
    CommandEnvironmentInput,
    CommandEnvironmentPolicy,
    CommandArgument,
    ExternalCommandOptions,
    ExecutableHandle,
    ExecutableOptions,
    ObjectHandle,
    ObjectOptions,
    StaticArchiveHandle,
    StaticArchiveOptions,
    ModuleHandle,
    ModuleImport,
    ModuleOptions,
    PackageHandle,
    PackageOptions,
    OptimizationMode,
    RunOptions,
    TargetView,
    StepHandle,
};
