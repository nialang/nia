using pkg::collections;
using pkg::cstr;
using pkg::process;
using pkg::fmt;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::os;

pub enum Error: i32 {
    UnknownStep = 1,
    InvalidStep = 2,
    OutOfMemory = 3,
    Report = 4,
    Internal = 5,
    CommandFailed = 6,
    UnknownTarget = 7,
    InvalidTarget = 8,
    PathTooLong = 9,
    _,
}

pub type StepFn = &fn(&mut Build) Error!void;

pub struct Step {
    name: &[char],
    run: StepFn,
}

pub struct ExecutableTarget {
    name: &[char],
    source: fs::Path,
}

pub struct Build {
    init: process::Init,
    allocator: &mut mem::Allocator,
    package_root: fs::Path,
    build_dir: fs::Path,
    cache_dir: fs::Path,
    toolchain_executable: fs::Path,
    steps: collections::ArrayList[Step],
    executables: collections::ArrayList[ExecutableTarget],
}

pub fn noop_step(b: &mut Build) Error!void {
    _ = b;
    !{}
}

extend Build {
    pub fn init(
        init: process::Init,
        allocator: &mut mem::Allocator,
        package_root: fs::Path,
        build_dir: fs::Path,
        cache_dir: fs::Path,
        toolchain_executable: fs::Path,
    ) Build {
        {
            init: init,
            allocator: allocator,
            package_root: package_root,
            build_dir: build_dir,
            cache_dir: cache_dir,
            toolchain_executable: toolchain_executable,
            steps: collections::ArrayList[Step]::init(),
            executables: collections::ArrayList[ExecutableTarget]::init(),
        }
    }

    pub fn deinit(&mut self) Error!void {
        self.executables.deinit(self.allocator).as_build_error().?;
        self.steps.deinit(self.allocator).as_build_error()
    }

    pub fn io(&self) &mut io::Io[Error = os::Error] {
        self.init.io()
    }

    pub fn package_root(&self) fs::Path {
        self.package_root
    }

    pub fn build_dir(&self) fs::Path {
        self.build_dir
    }

    pub fn cache_dir(&self) fs::Path {
        self.cache_dir
    }

    pub fn toolchain_executable(&self) fs::Path {
        self.toolchain_executable
    }

    pub fn step(&mut self, name: &[char], run: StepFn) Error!void {
        if name.len() == 0usize {
            return Error::InvalidStep!;
        }
        if let ?old = self.find_step(name) {
            _ = old;
            return Error::InvalidStep!;
        } else null {}
        self.steps.push(self.allocator, Step::init(name, run)).as_build_error()
    }

    pub fn executable(&mut self, name: &[char], source: fs::Path) Error!void {
        if not is_valid_target_name(name) {
            return Error::InvalidTarget!;
        }
        if let ?old = self.find_executable(name) {
            _ = old;
            return Error::InvalidTarget!;
        } else null {}
        self.executables.push(
            self.allocator,
            ExecutableTarget::init(name, source),
        ).as_build_error()
    }

    pub fn check_executable(&mut self, name: &[char]) Error!void {
        let target = if let ?target = self.find_executable(name) {
            target
        } else null {
            self.report_unknown_target(name).?;
            return Error::UnknownTarget!;
        };
        self.check_exe(target.source)
    }

    pub fn emit_executable(&mut self, name: &[char]) Error!void {
        let target = if let ?target = self.find_executable(name) {
            target
        } else null {
            self.report_unknown_target(name).?;
            return Error::UnknownTarget!;
        };
        var output_path_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        var target_path_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let output = self.executable_output_path(
            target.name,
            &mut output_path_storage[..],
            &mut target_path_storage[..],
        ).?;
        self.emit_exe(target.source, output)
    }

    pub fn check_exe(&mut self, source: fs::Path) Error!void {
        var toolchain_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        var source_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let toolchain = self.toolchain_executable.encode(&mut toolchain_storage[..]).as_build_error().?;
        let source_arg = source.encode(&mut source_storage[..]).as_build_error().?;
        let toolchain_cstr = if let ?value = cstr::CStr::from_bytes(toolchain.nul_terminated_bytes()) {
            value
        } else null {
            return Error::Internal!;
        };
        let check_arg = b"check\0";
        let exe_arg = b"--exe\0";
        var argv: [5]&u8 = [
            toolchain.ptr(),
            &check_arg.*[0],
            &exe_arg.*[0],
            source_arg.ptr(),
            0usize as &u8,
        ];
        var command = process::Command::init(toolchain_cstr, &argv[0], self.init.raw_envp());
        let term = command.run().as_build_error().?;
        if not term.exited_success() {
            return Error::CommandFailed!;
        }
        !{}
    }

    pub fn emit_exe(&mut self, source: fs::Path, output: fs::EncodedPath) Error!void {
        var toolchain_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        var source_storage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let toolchain = self.toolchain_executable.encode(&mut toolchain_storage[..]).as_build_error().?;
        let source_arg = source.encode(&mut source_storage[..]).as_build_error().?;
        let toolchain_cstr = if let ?value = cstr::CStr::from_bytes(toolchain.nul_terminated_bytes()) {
            value
        } else null {
            return Error::Internal!;
        };
        let emit_arg = b"emit\0";
        let exe_arg = b"--exe\0";
        let output_arg = b"-o\0";
        var argv: [7]&u8 = [
            toolchain.ptr(),
            &emit_arg.*[0],
            &exe_arg.*[0],
            source_arg.ptr(),
            &output_arg.*[0],
            output.ptr(),
            0usize as &u8,
        ];
        var command = process::Command::init(toolchain_cstr, &argv[0], self.init.raw_envp());
        let term = command.run().as_build_error().?;
        if not term.exited_success() {
            return Error::CommandFailed!;
        }
        !{}
    }

    pub fn requested_step(&self) ?process::Arg {
        self.init.args().get(1usize)
    }

    pub fn run_requested_step(&mut self) Error!void {
        if let ?step = self.requested_step() {
            if let ?registered = self.find_step_arg(step) {
                return registered.run(self);
            } else null {}
            self.report_unknown_step(step).?;
            return Error::UnknownStep!;
        } else null {}
        if let ?registered = self.first_step() {
            return registered.run(self);
        } else null {}
        !{}
    }

    fn first_step(&self) ?Step {
        if let ?step = self.steps.get(0usize) {
            ?step.*
        } else null {
            null
        }
    }

    fn find_step(&self, name: &[char]) ?Step {
        var index = 0usize;
        while index < self.steps.len() {
            let step = self.steps.as_slice()[index];
            if text_equal(step.name, name) {
                return ?step;
            }
            index += 1usize;
        }
        null
    }

    fn find_step_arg(&self, arg: process::Arg) ?Step {
        var index = 0usize;
        while index < self.steps.len() {
            let step = self.steps.as_slice()[index];
            if arg_matches_text(arg, step.name) {
                return ?step;
            }
            index += 1usize;
        }
        null
    }

    fn find_executable(&self, name: &[char]) ?ExecutableTarget {
        var index = 0usize;
        while index < self.executables.len() {
            let target = self.executables.as_slice()[index];
            if text_equal(target.name, name) {
                return ?target;
            }
            index += 1usize;
        }
        null
    }

    fn report_unknown_step(&mut self, step: process::Arg) Error!void {
        var buffer: [256]u8 = [_]u8[0; 256];
        var stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print("unknown build step `{}`\n", &[&step]).as_build_error().?;
        stderr.flush().as_build_error()
    }

    fn report_unknown_target(&mut self, name: &[char]) Error!void {
        var buffer: [256]u8 = [_]u8[0; 256];
        var stderr = io::FileWriter::stderr(self.init.io(), &mut buffer[..]);
        stderr.print("unknown executable target `{}`\n", &[name]).as_build_error().?;
        stderr.flush().as_build_error()
    }

    fn executable_output_path(
        &self,
        name: &[char],
        path_storage: &mut [u8],
        target_storage: &mut [u8],
    ) Error!fs::EncodedPath {
        let build_dir = self.build_dir.encode(path_storage).as_build_error().?;
        let target = fs::Path::init(name).encode(target_storage).as_build_error().?;
        let build_len = build_dir.len();
        let target_len = target.len();
        if build_len + 1usize + target_len >= path_storage.len() {
            return Error::PathTooLong!;
        }
        path_storage[build_len] = b'/';
        var index = 0usize;
        while index < target_len {
            path_storage[build_len + 1usize + index] = target.bytes()[index];
            index += 1usize;
        }
        let out_len = build_len + 1usize + target_len;
        path_storage[out_len] = 0u8;
        !fs::EncodedPath::init(path_storage.get_ptr_read(), out_len)
    }
}

extend Step {
    pub fn init(name: &[char], run: StepFn) Step {
        { name: name, run: run }
    }
}

extend ExecutableTarget {
    pub fn init(name: &[char], source: fs::Path) ExecutableTarget {
        { name: name, source: source }
    }
}

extend Error {
    pub fn as_exit_code(self) process::ExitCode {
        switch self {
            Error::UnknownStep => process::exit(2),
            Error::InvalidStep => process::exit(22),
            Error::OutOfMemory => process::exit(12),
            Error::Report => process::exit(5),
            Error::Internal => process::exit(255),
            Error::CommandFailed => process::exit(1),
            Error::UnknownTarget => process::exit(2),
            Error::InvalidTarget => process::exit(22),
            Error::PathTooLong => process::exit(36),
            _ => process::exit(255),
        }
    }
}

extend[T] Error!T {
    pub fn exit(self) process::ExitCode!T {
        if let !value = self {
            !value
        } else error! {
            error.as_exit_code()!
        }
    }
}

extend[T] fmt::Error!T {
    pub fn as_build_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            switch error {
                fmt::Error::Write => Error::Report!,
                fmt::Error::InvalidTemplate => Error::Internal!,
                fmt::Error::MissingArgument => Error::Internal!,
                fmt::Error::ExtraArgument => Error::Internal!,
                _ => Error::Internal!,
            }
        }
    }
}

extend[T] fs::Error!T {
    pub fn as_build_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            switch error {
                fs::Error::Invalid => Error::Report!,
                fs::Error::Io => Error::Report!,
                fs::Error::TooLong => Error::Report!,
                fs::Error::NotFound => Error::Report!,
                fs::Error::AlreadyExists => Error::Report!,
                fs::Error::NotDir => Error::Report!,
                fs::Error::IsDir => Error::Report!,
                fs::Error::NoSpace => Error::Report!,
                fs::Error::OutOfMemory => Error::OutOfMemory!,
                _ => Error::Report!,
            }
        }
    }
}

extend[T] process::Error!T {
    pub fn as_build_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            switch error {
                process::Error::Invalid => Error::InvalidStep!,
                process::Error::SpawnSetup => Error::Report!,
                process::Error::SpawnStdio => Error::Report!,
                process::Error::SpawnCwd => Error::Report!,
                process::Error::SpawnExec => Error::Report!,
                process::Error::Wait => Error::Report!,
                process::Error::TryWait => Error::Report!,
                process::Error::Kill => Error::Report!,
                process::Error::CloseStdin => Error::Report!,
                process::Error::CloseStdout => Error::Report!,
                process::Error::CloseStderr => Error::Report!,
                process::Error::System => Error::Report!,
                _ => Error::Report!,
            }
        }
    }
}

extend[T] mem::Error!T {
    pub fn as_build_error(self) Error!T {
        if let !value = self {
            !value
        } else error! {
            switch error {
                mem::Error::OutOfMemory => Error::OutOfMemory!,
                _ => Error::InvalidStep!,
            }
        }
    }
}

fn text_equal(left: &[char], right: &[char]) bool {
    if left.len() != right.len() {
        return false;
    }
    var index = 0usize;
    while index < left.len() {
        if left[index] != right[index] {
            return false;
        }
        index += 1usize;
    }
    true
}

fn is_valid_target_name(name: &[char]) bool {
    if name.len() == 0usize {
        return false;
    }
    var index = 0usize;
    while index < name.len() {
        let code = name[index] as u32;
        if code == 0u32 or code == 47u32 or code == 92u32 {
            return false;
        }
        index += 1usize;
    }
    true
}

fn arg_matches_text(arg: process::Arg, text: &[char]) bool {
    let bytes = arg.bytes();
    var byte_index = 0usize;
    var char_index = 0usize;
    while char_index < text.len() {
        let encoded = text[char_index].encode_utf8();
        let encoded_bytes = encoded.bytes();
        var encoded_index = 0usize;
        while encoded_index < encoded_bytes.len() {
            if byte_index >= bytes.len() or bytes[byte_index] != encoded_bytes[encoded_index] {
                return false;
            }
            byte_index += 1usize;
            encoded_index += 1usize;
        }
        char_index += 1usize;
    }
    byte_index == bytes.len()
}
