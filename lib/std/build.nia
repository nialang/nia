// Declarative package-build facade.
//
// A build script describes packages, modules, artifacts, actions, and their
// dependencies. Paths identify the package, build, and cache roots; target
// options distinguish the invocation artifact from host tools.
//
// Build retains the descriptors it needs in allocator-owned storage. Handles
// belong to their Build, and paths and commands keep their ownership and cache
// rules explicit. Initialization and teardown preserve partially owned state
// so failed cleanup can be retried without losing the original error.

pub(root) module commands;
pub(root) module artifacts;
pub(root) module core;
pub(root) module dependencies;
pub(root) module diagnostics;
pub(root) module error;
pub(root) module error_format;
pub(root) module handles;
pub(root) module lifecycle;
pub(root) module modules;
pub(root) module ownership;
pub(root) module paths;
pub(root) module plan;
pub module probes;
pub(root) module queries;
pub(root) module records_cleanup;
pub(root) module step_registration;
pub(root) module steps;
pub(root) module targets;
pub(root) module types;
pub(root) module validation;

// Build API values use the standard string and path views directly. Re-export
// their provider modules so build scripts can use the facade's documented
// view methods without inheriting private imports from implementation files.
pub using root::string;
pub using root::fs::path;

using root::build::artifacts;
using root::build::core;
using root::build::error_format;
using root::build::lifecycle;
using root::build::plan;
using root::build::probes;
using root::build::step_registration;
using root::build::targets;

// Public build API providers are split across focused files. Re-export the
// provider modules explicitly so associated constructors and methods remain
// available through `using std::build` without inheriting their private
// implementation imports.
pub using commands;
pub using artifacts;
pub using core;
pub using dependencies;
pub using handles;
pub using lifecycle;
pub using modules;
pub using paths;
pub using plan;
pub using step_registration;
pub using steps;
pub using targets;

pub using error::{
    Error,
    ErrorCause,
    ErrorOperation,
    ErrorSubject,
};
pub using types::{
    Build,
    BuildInitAttempt,
    BuildPathView,
    ActionResourceClass,
    CommandCachePolicy,
    CommandEnvironmentInput,
    CommandEnvironmentPolicy,
    CommandArgument,
    ExternalCommandOptions,
    ExecutableHandle,
    ExecutableOptions,
    ObjectHandle,
    ObjectOptions,
    StaticArchiveHandle,
    StaticArchiveOptions,
    ModuleHandle,
    ModuleImport,
    ModuleOptions,
    PackageHandle,
    PackageOptions,
    OptimizationMode,
    Runtime,
    Linkage,
    DebugInfo,
    PanicStrategy,
    LtoMode,
    CpuLevel,
    ArtifactDefine,
    SystemLibrary,
    SystemLibraryMode,
    RunOptions,
    TargetView,
    StepHandle,
};
