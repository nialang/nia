// Transformations and queries for Nia optional values (`?Value`).

extend[Value] ?Value {
    pub fn isPresent(&self) bool {
        let value = self.*;
        if value is ?_ { true } else { false }
    }

    pub fn isNull(&self) bool {
        let value = self.*;
        if value is null { true } else { false }
    }

    pub fn map[Mapped, Mapper](self, mapper: Mapper) ?Mapped
    where Mapper: Fn(Value) Mapped
    {
        if self is ?value {
            ?mapper(value)
        } else {
            null
        }
    }

    pub fn andThen[Mapped, Next](self, next: Next) ?Mapped
    where Next: Fn(Value) ?Mapped
    {
        if self is ?value {
            next(value)
        } else {
            null
        }
    }
}
