// Transformations and queries for Nia optional values (`?Value`).

extend[Value] ?Value {
    pub fun isPresent(&self) bool {
        let value = self.*;
        if value is ?_ { true } else { false }
    }

    pub fun isNull(&self) bool {
        let value = self.*;
        if value is null { true } else { false }
    }

    pub fun map[Mapped, Mapper](self, mapper: Mapper) ?Mapped
    where Mapper: Fun(Value) Mapped
    {
        if self is ?value {
            ?mapper(value)
        } else {
            null
        }
    }

    pub fun andThen[Mapped, Next](self, next: Next) ?Mapped
    where Next: Fun(Value) ?Mapped
    {
        if self is ?value {
            next(value)
        } else {
            null
        }
    }

    pub fun okOr[Error](self, error: Error) Error!Value {
        if self is ?value {
            !value
        } else {
            error!
        }
    }

    pub fun okOrElse[Error, Supplier](self, supplier: Supplier) Error!Value
    where Supplier: Fun() Error
    {
        if self is ?value {
            !value
        } else {
            supplier()!
        }
    }
}
