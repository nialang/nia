using pkg::hash::traits;
using pkg::math;
using pkg::slice;

using traits::Hasher;

const wyhashSecret0: u64 = 0xa0761d6478bd642f;
const wyhashSecret1: u64 = 0xe7037ed1a0b428db;
const wyhashSecret2: u64 = 0x8ebc6af09c88c6e3;
const wyhashSecret3: u64 = 0x589965cc75374cc3;

pub struct Wyhash {
    a: u64,
    b: u64,
    state0: u64,
    state1: u64,
    state2: u64,
    totalLen: usize,
    buf: [u8; 48],
    bufLen: usize,
}

extend Wyhash {
    pub fn init(seed: u64) Wyhash {
        let state = seed ^ mix(seed ^ wyhashSecret0, wyhashSecret1);
        Self {
            a: 0,
            b: 0,
            state0: state,
            state1: state,
            state2: state,
            totalLen: 0,
            buf: [0; 48],
            bufLen: 0,
        }
    }

    pub fn hash(seed: u64, bytes: &[u8]) u64 {
        wyhash(seed, bytes)
    }

    pub fn update(&mut self, bytes: &[u8]) () {
        self.totalLen = match self.totalLen.checkedAdd(bytes.len()) {
            ?value => value,
            null => usize::MAX,
        };

        if bytes.len() <= 48 - self.bufLen {
            _ = (&mut self.buf[self.bufLen..(self.bufLen + bytes.len())]).copyFrom(bytes);
            self.bufLen += bytes.len();
            return;
        }

        let mut index: usize = 0;
        if self.bufLen > 0 {
            index = 48 - self.bufLen;
            _ = (&mut self.buf[self.bufLen..48]).copyFrom(&bytes[0..index]);
            self.round(&self.buf[..]);
            self.bufLen = 0;
        }

        while true {
            let next = match index.checkedAdd(48) {
                ?value => value,
                null => break,
            };
            if next >= bytes.len() {
                break;
            }
            self.round(&bytes[index..next]);
            index = next;
        }

        let remaining = &bytes[index..];
        if remaining.len() < 16 and index >= 48 {
            let rem = 16 - remaining.len();
            _ = (&mut self.buf[(48 - rem)..48]).copyFrom(&bytes[(index - rem)..index]);
        }
        _ = (&mut self.buf[0..remaining.len()]).copyFrom(remaining);
        self.bufLen = remaining.len();
    }

    fn finishValue(&self) u64 {
        let mut copy = self.shallowCopy();
        if self.totalLen <= 16 {
            copy.smallKey(&self.buf[0..self.bufLen]);
        } else {
            let mut offset: usize = 0;
            let mut scratch: [u8; 16] = [0; 16];
            let mut input = &self.buf[0..self.bufLen];
            if self.bufLen < 16 {
                let rem = 16 - self.bufLen;
                _ = (&mut scratch[0..rem]).copyFrom(&self.buf[(48 - rem)..48]);
                _ = (&mut scratch[rem..16]).copyFrom(&self.buf[0..self.bufLen]);
                input = &scratch[..];
                offset = rem;
            }

            copy.final0();
            copy.final1(input, offset);
        }

        copy.final2()
    }

    fn shallowCopy(&self) Wyhash {
        Self {
            a: self.a,
            b: self.b,
            state0: self.state0,
            state1: self.state1,
            state2: self.state2,
            totalLen: self.totalLen,
            buf: [0; 48],
            bufLen: 0,
        }
    }

    fn smallKey(&mut self, bytes: &[u8]) () {
        self.a = 0;
        self.b = 0;
        if bytes.len() >= 4 {
            let end = bytes.len() - 4;
            let quarter = (bytes.len() >> 3) << 2;
            self.a = (read4(&bytes[0..]) << 32u64) | read4(&bytes[quarter..]);
            self.b = (read4(&bytes[end..]) << 32u64) | read4(&bytes[end - quarter..]);
        } else if bytes.len() > 0 {
            self.a = ((bytes[0] as u64) << 16u64)
                | ((bytes[bytes.len() >> 1] as u64) << 8u64)
                | (bytes[bytes.len() - 1] as u64);
        }
    }

    fn round(&mut self, bytes: &[u8]) () {
        self.state0 = mix(read8(&bytes[0..]) ^ wyhashSecret1, read8(&bytes[8..]) ^ self.state0);
        self.state1 = mix(read8(&bytes[16..]) ^ wyhashSecret2, read8(&bytes[24..]) ^ self.state1);
        self.state2 = mix(read8(&bytes[32..]) ^ wyhashSecret3, read8(&bytes[40..]) ^ self.state2);
    }

    fn final0(&mut self) () {
        self.state0 ^= self.state1 ^ self.state2;
    }

    fn final1(&mut self, inputLb: &[u8], startPos: usize) () {
        let input = &inputLb[startPos..];
        let mut i: usize = 0;
        while i + 16 < input.len() {
            self.state0 = mix(read8(&input[i..]) ^ wyhashSecret1, read8(&input[i + 8..]) ^ self.state0);
            i += 16;
        }

        self.a = read8(&inputLb[inputLb.len() - 16..]);
        self.b = read8(&inputLb[inputLb.len() - 8..]);
    }

    fn final2(&mut self) u64 {
        self.a ^= wyhashSecret1;
        self.b ^= self.state0;
        let product = (self.a as u128) * (self.b as u128);
        self.a = product as u64;
        self.b = (product >> 64u128) as u64;
        mix(self.a ^ wyhashSecret0 ^ (self.totalLen as u64), self.b ^ wyhashSecret1)
    }
}

extend Wyhash : Hasher {
    pub fn write(&mut self, bytes: &[u8]) () {
        self.update(bytes)
    }

    pub fn finish(&self) u64 {
        self.finishValue()
    }
}

pub fn wyhash(seed: u64, bytes: &[u8]) u64 {
    let mut hasher = Wyhash::init(seed);
    hasher.update(bytes);
    hasher.finishValue()
}

fn mix(a: u64, b: u64) u64 {
    let product = (a as u128) * (b as u128);
    (product as u64) ^ ((product >> 64u128) as u64)
}

fn read4(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64)
}

fn read8(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8u64)
        | ((bytes[2] as u64) << 16u64)
        | ((bytes[3] as u64) << 24u64)
        | ((bytes[4] as u64) << 32u64)
        | ((bytes[5] as u64) << 40u64)
        | ((bytes[6] as u64) << 48u64)
        | ((bytes[7] as u64) << 56u64)
}
