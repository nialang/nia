using root::hash::traits;
using root::slice;

using traits::Hasher;

const wyhashSecret0: u64 = 0xa0761d6478bd642f;
const wyhashSecret1: u64 = 0xe7037ed1a0b428db;
const wyhashSecret2: u64 = 0x8ebc6af09c88c6e3;
const wyhashSecret3: u64 = 0x589965cc75374cc3;

pub struct Wyhash {
    a: u64,
    b: u64,
    state0: u64,
    state1: u64,
    state2: u64,
    totalLen: usize,
    longInput: bool,
    buf: [u8; 48],
    bufLen: usize,
}

extend Wyhash {
    pub fun init(seed: u64) Wyhash {
        let state = seed ^ mix(seed ^ wyhashSecret0, wyhashSecret1);
        .{
            a: 0,
            b: 0,
            state0: state,
            state1: state,
            state2: state,
            totalLen: 0,
            longInput: false,
            buf: [0; 48],
            bufLen: 0,
        }
    }

    pub fun hash(seed: u64, bytes: &[u8]) u64 {
        wyhash(seed, bytes)
    }

    pub fun update(&mut self, bytes: &[u8]) () {
        if not self.longInput
            and (self.totalLen > 16 or bytes.len() > 16 - self.totalLen)
        {
            self.longInput = true;
        }
        self.totalLen = addWrapSize(self.totalLen, bytes.len());

        if bytes.len() <= 48 - self.bufLen {
            _ = (&mut self.buf[self.bufLen..(self.bufLen + bytes.len())]).copyFrom(bytes);
            self.bufLen += bytes.len();
            return;
        }

        let mut index: usize = 0;
        if self.bufLen > 0 {
            index = 48 - self.bufLen;
            _ = (&mut self.buf[self.bufLen..48]).copyFrom(&bytes[0..index]);
            self.round(&self.buf[..]);
            self.bufLen = 0;
        }

        while true {
            let next = match index.checkedAdd(48) {
                ?value => value,
                null => break,
            };
            if next >= bytes.len() {
                break;
            }
            self.round(&bytes[index..next]);
            index = next;
        }

        let remaining = &bytes[index..];
        if remaining.len() < 16 and index >= 48 {
            let rem = 16 - remaining.len();
            _ = (&mut self.buf[(48 - rem)..48]).copyFrom(&bytes[(index - rem)..index]);
        }
        _ = (&mut self.buf[0..remaining.len()]).copyFrom(remaining);
        self.bufLen = remaining.len();
    }

    fun finishValue(&self) u64 {
        let mut copy = self.shallowCopy();
        if not self.longInput {
            copy.smallKey(&self.buf[0..self.bufLen]);
        } else {
            let mut offset: usize = 0;
            let mut scratch: [u8; 16] = [0; 16];
            let mut input = &self.buf[0..self.bufLen];
            if self.bufLen < 16 {
                let rem = 16 - self.bufLen;
                _ = (&mut scratch[0..rem]).copyFrom(&self.buf[(48 - rem)..48]);
                _ = (&mut scratch[rem..16]).copyFrom(&self.buf[0..self.bufLen]);
                input = &scratch[..];
                offset = rem;
            }

            copy.final0();
            copy.final1(input, offset);
        }

        copy.final2()
    }

    fun shallowCopy(&self) Wyhash {
        .{
            a: self.a,
            b: self.b,
            state0: self.state0,
            state1: self.state1,
            state2: self.state2,
            totalLen: self.totalLen,
            longInput: self.longInput,
            buf: [0; 48],
            bufLen: 0,
        }
    }

    fun smallKey(&mut self, bytes: &[u8]) () {
        self.a = 0;
        self.b = 0;
        if bytes.len() >= 4 {
            let end = bytes.len() - 4;
            let quarter = (bytes.len() >> 3) << 2;
            self.a = (read4(&bytes[0..]) << 32) | read4(&bytes[quarter..]);
            self.b = (read4(&bytes[end..]) << 32) | read4(&bytes[end - quarter..]);
        } else if bytes.len() > 0 {
            self.a = ((bytes[0] as u64) << 16)
                | ((bytes[bytes.len() >> 1] as u64) << 8)
                | (bytes[bytes.len() - 1] as u64);
        }
    }

    fun round(&mut self, bytes: &[u8]) () {
        self.state0 = mix(read8(&bytes[0..]) ^ wyhashSecret1, read8(&bytes[8..]) ^ self.state0);
        self.state1 = mix(read8(&bytes[16..]) ^ wyhashSecret2, read8(&bytes[24..]) ^ self.state1);
        self.state2 = mix(read8(&bytes[32..]) ^ wyhashSecret3, read8(&bytes[40..]) ^ self.state2);
    }

    fun final0(&mut self) () {
        self.state0 ^= self.state1 ^ self.state2;
    }

    fun final1(&mut self, inputLb: &[u8], startPos: usize) () {
        let input = &inputLb[startPos..];
        let mut i: usize = 0;
        while i + 16 < input.len() {
            self.state0 = mix(read8(&input[i..]) ^ wyhashSecret1, read8(&input[i + 8..]) ^ self.state0);
            i += 16;
        }

        self.a = read8(&inputLb[inputLb.len() - 16..]);
        self.b = read8(&inputLb[inputLb.len() - 8..]);
    }

    fun final2(&mut self) u64 {
        self.a ^= wyhashSecret1;
        self.b ^= self.state0;
        let product = (self.a as u128) * (self.b as u128);
        self.a = product as u64;
        self.b = (product >> 64) as u64;
        mix(self.a ^ wyhashSecret0 ^ (self.totalLen as u64), self.b ^ wyhashSecret1)
    }
}

extend Wyhash : Hasher {
    pub fun write(&mut self, bytes: &[u8]) () {
        self.update(bytes)
    }

    pub fun finish(&self) u64 {
        self.finishValue()
    }
}

pub fun wyhash(seed: u64, bytes: &[u8]) u64 {
    let mut hasher = Wyhash::init(seed);
    hasher.update(bytes);
    hasher.finishValue()
}

fun addWrapSize(left: usize, right: usize) usize {
    // Wyhash mixes the low machine-word length, matching its size_t input.
    // Nia integer addition traps, so spell out modulo 2^usize without relying
    // on a wider integer type that may not exist on every target.
    if left > usize::MAX - right {
        left - (usize::MAX - right) - 1
    } else {
        left + right
    }
}

fun mix(a: u64, b: u64) u64 {
    let product = (a as u128) * (b as u128);
    (product as u64) ^ ((product >> 64) as u64)
}

fun read4(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8)
        | ((bytes[2] as u64) << 16)
        | ((bytes[3] as u64) << 24)
}

fun read8(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8)
        | ((bytes[2] as u64) << 16)
        | ((bytes[3] as u64) << 24)
        | ((bytes[4] as u64) << 32)
        | ((bytes[5] as u64) << 40)
        | ((bytes[6] as u64) << 48)
        | ((bytes[7] as u64) << 56)
}
