using package::hash::traits;

using traits::{Hash, Hasher};

extend[H] u8 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([self.*])
    }
}

extend[H] i8 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u8).hash(hasher)
    }
}

extend[H] u16 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([
            self.* as u8,
            (self.* >> 8u16) as u8,
        ])
    }
}

extend[H] i16 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u16).hash(hasher)
    }
}

extend[H] u32 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([
            self.* as u8,
            (self.* >> 8u32) as u8,
            (self.* >> 16u32) as u8,
            (self.* >> 24u32) as u8,
        ])
    }
}

extend[H] i32 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u32).hash(hasher)
    }
}

extend[H] u64 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        hasher.write([
            self.* as u8,
            (self.* >> 8u64) as u8,
            (self.* >> 16u64) as u8,
            (self.* >> 24u64) as u8,
            (self.* >> 32u64) as u8,
            (self.* >> 40u64) as u8,
            (self.* >> 48u64) as u8,
            (self.* >> 56u64) as u8,
        ])
    }
}

extend[H] i64 : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u64).hash(hasher)
    }
}

extend[H] usize : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u64).hash(hasher)
    }
}

extend[H] isize : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as usize).hash(hasher)
    }
}

extend[H] bool : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        if self.* {
            1u8.hash(hasher)
        } else {
            0u8.hash(hasher)
        }
    }
}

extend[H] char : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        (self.* as u32).hash(hasher)
    }
}

extend[H] [u8] : Hash[H]
where H: Hasher
{
    pub fn hash(&self, hasher: &mut H) void {
        self.len().hash(hasher);
        hasher.write(self)
    }
}
