using root::hash::traits;
using root::slice;

using traits::{Hash, Hasher};

extend[H] u8 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        hasher.write([self.*])
    }
}

extend[H] i8 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as u8).hash(hasher)
    }
}

extend[H] u16 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        hasher.write([
            self.* as u8,
            (self.* >> 8) as u8,
        ])
    }
}

extend[H] i16 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as u16).hash(hasher)
    }
}

extend[H] u32 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        hasher.write([
            self.* as u8,
            (self.* >> 8) as u8,
            (self.* >> 16) as u8,
            (self.* >> 24) as u8,
        ])
    }
}

extend[H] i32 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as u32).hash(hasher)
    }
}

extend[H] u64 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        hasher.write([
            self.* as u8,
            (self.* >> 8) as u8,
            (self.* >> 16) as u8,
            (self.* >> 24) as u8,
            (self.* >> 32) as u8,
            (self.* >> 40) as u8,
            (self.* >> 48) as u8,
            (self.* >> 56) as u8,
        ])
    }
}

extend[H] u128 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        let mut bytes: [u8; 16] = [0; 16];
        let mut value = self.*;
        for byte in (&mut bytes[..]).iterMut() {
            byte.* = value as u8;
            value >>= 8;
        }
        hasher.write(&bytes[..])
    }
}

extend[H] i64 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as u64).hash(hasher)
    }
}

extend[H] i128 : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as u128).hash(hasher)
    }
}

extend[H] usize : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as u64).hash(hasher)
    }
}

extend[H] isize : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as usize).hash(hasher)
    }
}

extend[H] bool : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        if self.* {
            1u8.hash(hasher)
        } else {
            0u8.hash(hasher)
        }
    }
}

extend[H] char : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        (self.* as u32).hash(hasher)
    }
}

extend[H] [char] : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        self.len().hash(hasher);
        for &ch in self.iter() {
            ch.hash(hasher);
        }
    }
}

extend[H] [u8] : Hash[H]
where H: Hasher
{
    pub fun hash(&self, hasher: &mut H) () {
        self.len().hash(hasher);
        hasher.write(self)
    }
}
