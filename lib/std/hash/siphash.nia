// Keyed SipHash-1-3 and SipHash-2-4.
//
// SipHash is a keyed pseudorandom function intended for short hash-table keys
// and denial-of-service resistance. It is not a password hash or a general
// purpose message authentication API.

using root::hash::traits;
using root::hash::block_buffer::BlockBuffer;

using traits::Hasher;

pub struct SipHash[C: usize, D: usize] {
    v0: u64,
    v1: u64,
    v2: u64,
    v3: u64,
    totalLen: usize,
    buffer: BlockBuffer[8],
}

pub type SipHash13 = SipHash[1, 3];
pub type SipHash24 = SipHash[2, 4];

fun initState(key0: u64, key1: u64) (u64, u64, u64, u64) {
    (
        key0 ^ 0x736f6d6570736575u64,
        key1 ^ 0x646f72616e646f6du64,
        key0 ^ 0x6c7967656e657261u64,
        key1 ^ 0x7465646279746573u64,
    )
}

fun read8(bytes: &[u8]) u64 {
    (bytes[0] as u64)
        | ((bytes[1] as u64) << 8)
        | ((bytes[2] as u64) << 16)
        | ((bytes[3] as u64) << 24)
        | ((bytes[4] as u64) << 32)
        | ((bytes[5] as u64) << 40)
        | ((bytes[6] as u64) << 48)
        | ((bytes[7] as u64) << 56)
}

fun addWrap64(left: u64, right: u64) u64 {
    // SipHash's state additions wrap modulo 2^64. Nia traps on overflow, so
    // perform the addition in a wider type and explicitly keep its low word.
    ((left as u128) + (right as u128)) as u64
}

fun round13(v0: &mut u64, v1: &mut u64, v2: &mut u64, v3: &mut u64) () {
    v0.* = addWrap64(v0.*, v1.*);
    v1.* = ((((v1.* as u128) << 13) as u64) | (v1.* >> 51));
    v1.* ^= v0.*;
    v0.* = ((((v0.* as u128) << 32) as u64) | (v0.* >> 32));
    v2.* = addWrap64(v2.*, v3.*);
    v3.* = ((((v3.* as u128) << 16) as u64) | (v3.* >> 48));
    v3.* ^= v2.*;
    v0.* = addWrap64(v0.*, v3.*);
    v3.* = ((((v3.* as u128) << 21) as u64) | (v3.* >> 43));
    v3.* ^= v0.*;
    v2.* = addWrap64(v2.*, v1.*);
    v1.* = ((((v1.* as u128) << 17) as u64) | (v1.* >> 47));
    v1.* ^= v2.*;
    v2.* = ((((v2.* as u128) << 32) as u64) | (v2.* >> 32));
}

fun compress[rounds: usize](v0: &mut u64, v1: &mut u64, v2: &mut u64, v3: &mut u64, word: u64) () {
    v3.* ^= word;
    for _ in 0..rounds { round13(v0, v1, v2, v3); }
    v0.* ^= word;
}

fun finish[compressRounds: usize, finalRounds: usize](
    v0: u64,
    v1: u64,
    v2: u64,
    v3: u64,
    totalLen: usize,
    tail: &[u8],
) u64 {
    let mut a = v0;
    let mut b = v1;
    let mut c = v2;
    let mut d = v3;
    let mut last: u64 = (((totalLen as u128) << 56) as u64);
    for index in 0..tail.len() {
        last |= (tail[index] as u64) << (index * 8);
    }
    compress[compressRounds](a, b, c, d, last);
    c ^= 0xff;
    for _ in 0..finalRounds { round13(a, b, c, d); }
    a ^ b ^ c ^ d
}

extend[C: usize, D: usize] SipHash[C, D] {
    pub fun init(key0: u64, key1: u64) Self {
        let (v0, v1, v2, v3) = initState(key0, key1);
        .{ v0, v1, v2, v3, totalLen: 0, buffer: .init() }
    }

    pub fun update(&mut self, bytes: &[u8]) () {
        self.totalLen = (self.totalLen + bytes.len() % 256) % 256;
        let v0 = &mut self.v0;
        let v1 = &mut self.v1;
        let v2 = &mut self.v2;
        let v3 = &mut self.v3;
        self.buffer.update(bytes, \[v0, v1, v2, v3] block ->
            compress[C](v0, v1, v2, v3, read8(block)));
    }

    pub fun finishValue(&self) u64 {
        finish[C, D](self.v0, self.v1, self.v2, self.v3, self.totalLen, self.buffer.pending())
    }

    pub fun hash(key0: u64, key1: u64, bytes: &[u8]) u64 {
        let mut hasher = SipHash[C, D]::init(key0, key1);
        hasher.update(bytes);
        hasher.finishValue()
    }
}

extend[C: usize, D: usize] SipHash[C, D] : Hasher {
    pub fun write(&mut self, bytes: &[u8]) () { self.update(bytes) }
    pub fun finish(&self) u64 { self.finishValue() }
}
