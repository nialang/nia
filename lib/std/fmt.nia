// Formatting traits, template parsing, and checked writer dispatch.
//
// Checked formatting preserves writer failures. Unchecked formatting is only
// for boundaries whose writer contract makes failure impossible or irrelevant.

pub(pkg) module core;
pub(pkg) module primitive;
pub(pkg) module template;

using pkg::fmt::core;
using pkg::fmt::primitive;
using pkg::fmt::template;

pub using core::{Error, FormatWriter, Format, FormatPresentation, FormatSpec, Formatter};
pub using template::{print_checked, print_unchecked};
