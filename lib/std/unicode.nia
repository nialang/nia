using pkg::iter;
using pkg::iter::range;

pub struct Utf8Scalar {
    bytes: [4]u8,
    byteLen: usize,
}

pub struct DecodedUtf8Scalar {
    scalar: char,
    byteLen: usize,
}

pub enum Utf8DecodeError: i32 {
    Empty = 1,
    Truncated = 2,
    InvalidLeadingByte = 3,
    InvalidContinuation = 4,
    Overlong = 5,
    InvalidScalar = 6,
}

extend Utf8Scalar {
    fn init(bytes: [4]u8, byteLen: usize) Utf8Scalar {
        { bytes: bytes, byteLen: byteLen }
    }

    pub fn byteLen(&self) usize {
        self.byteLen
    }

    pub fn bytes(&self) &[u8] {
        & self.bytes[0..self.byteLen]
    }
}

extend DecodedUtf8Scalar {
    fn init(scalar: char, byteLen: usize) DecodedUtf8Scalar {
        { scalar: scalar, byteLen: byteLen }
    }

    pub fn scalar(&self) char {
        self.scalar
    }

    pub fn byteLen(&self) usize {
        self.byteLen
    }
}

extend char {
    pub fn codepoint(self) u32 {
        self as u32
    }

    pub fn encodeUtf8(self) Utf8Scalar {
        let code = self as u32;
        if code <= 127 {
            Utf8Scalar::init([code as u8, 0, 0, 0], 1)
        } else if code <= 2047 {
            Utf8Scalar::init([
                192 + (code / 64) as u8,
                128 + (code % 64) as u8,
                0,
                0,
            ], 2)
        } else if code <= 65535 {
            Utf8Scalar::init([
                224 + (code / 4096) as u8,
                128 + ((code / 64) % 64) as u8,
                128 + (code % 64) as u8,
                0,
            ], 3)
        } else {
            Utf8Scalar::init([
                240 + (code / 262144) as u8,
                128 + ((code / 4096) % 64) as u8,
                128 + ((code / 64) % 64) as u8,
                128 + (code % 64) as u8,
            ], 4)
        }
    }
}

pub const fn fromScalarValue(value: u32) ?char {
    std::builtin::charFromU32(value)
}

pub const fn isValidScalarValue(value: u32) bool {
    value <= 0x10ffff and not (value >= 0xd800 and value <= 0xdfff)
}

pub fn decodeUtf8First(bytes: &[u8]) Utf8DecodeError!DecodedUtf8Scalar {
    if bytes.len() == 0 {
        return Utf8DecodeError::Empty!;
    }
    let first = bytes[0];
    let mut code: u32;
    let mut width: usize;
    if first < 0x80 {
        code = first as u32;
        width = 1;
    } else if (first & 0xe0) == 0xc0 {
        code = (first & 0x1f) as u32;
        width = 2;
    } else if (first & 0xf0) == 0xe0 {
        code = (first & 0x0f) as u32;
        width = 3;
    } else if (first & 0xf8) == 0xf0 and first <= 0xf4 {
        code = (first & 0x07) as u32;
        width = 4;
    } else {
        return Utf8DecodeError::InvalidLeadingByte!;
    }
    if bytes.len() < width {
        return Utf8DecodeError::Truncated!;
    }
    for index in 1..width {
        let continuation = bytes[index];
        if (continuation & 0xc0) != 0x80 {
            return Utf8DecodeError::InvalidContinuation!;
        }
        code = (code << 6) | ((continuation & 0x3f) as u32);
    }
    if isOverlongUtf8(code, width) {
        return Utf8DecodeError::Overlong!;
    }
    if not isValidScalarValue(code) {
        return Utf8DecodeError::InvalidScalar!;
    }
    switch fromScalarValue(code) {
        ?ch => {
            !DecodedUtf8Scalar::init(ch, width)
        },
        null => {
            Utf8DecodeError::InvalidScalar!
        },
    }
}

fn isOverlongUtf8(code: u32, width: usize) bool {
    switch width {
        1 => false,
        2 => code < 0x80,
        3 => code < 0x800,
        4 => code < 0x10000,
        _ => true,
    }
}
