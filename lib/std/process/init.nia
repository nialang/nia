using pkg::process::types;

using types::{Args, Env, Init};

extend Init {
    pub(pkg) fn init(argc: usize, argv: &&u8, envp: &&u8) Init {
        Self { argc: argc, argv: argv, envp: envp }
    }

    pub fn argc(&self) usize {
        self.argc
    }

    pub fn args(&self) Args {
        Args::init(self.argc, self.argv)
    }

    pub fn env(&self) Env {
        Env::init(self.envp)
    }

    pub fn rawArgv(&self) &&u8 {
        self.argv
    }

    pub fn rawEnvp(&self) &&u8 {
        self.envp
    }

}
