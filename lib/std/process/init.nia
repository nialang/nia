using root::builtin::Len;
using root::process::types;
using root::process::env;

using types::{Args, Env, Init};

extend Init {
    // Runtime startup constructs the public process context before invoking
    // the program's `main`.
    pub fun init(argc: usize, argv: &&u8, envp: &&u8) Init {
        .{ args: .init(argc, argv), env: .init(envp) }
    }

    pub fun argc(&self) usize {
        self.args.len()
    }

    pub fun args(&self) Args {
        self.args
    }

    pub fun env(&self) Env {
        self.env
    }
}

// Ends the process with `code`. Startup calls this with `main`'s result.
pub fun exit(code: types::ExitCode) () {
    root::os::exit(code.0);
}
