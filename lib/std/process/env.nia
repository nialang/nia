using pkg::cstring;
using pkg::fmt;
using pkg::parse;
using pkg::process::types;

using types::{Env, EnvEntry, EnvIter, EnvVar};

extend EnvEntry {
    pub fn init(name: &[char], value: &[char]) EnvEntry {
        Self { name: name, value: value }
    }

    pub fn name(&self) &[char] {
        self.name
    }

    pub fn value(&self) &[char] {
        self.value
    }
}

extend EnvVar {
    fn init(ptr: &u8) EnvVar {
        Self { text: cstring::CStringView::fromTerminatedPtr(ptr) }
    }

    pub fn cstring(&self) cstring::CStringView {
        self.text
    }

    pub fn bytes(&self) &[u8] {
        self.text.bytes()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn parse[T](self) [T as parse::From[EnvVar]]::Error!T
    where T: parse::From[EnvVar]
    {
        [T]::from(self)
    }

    pub fn parseRadix[T](self, radix: u32) [T as parse::FromRadix[EnvVar]]::Error!T
    where T: parse::FromRadix[EnvVar]
    {
        [T]::fromRadix(self, radix)
    }
}

extend EnvVar : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.text.format(formatter)
    }

    fn formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.text.formatSpec(formatter, spec)
    }
}

extend[T] T : parse::From[EnvVar]
where T: parse::From[cstring::CStringView]
{
    type Error = [T as parse::From[cstring::CStringView]]::Error;

    fn from(input: EnvVar) [T as parse::From[EnvVar]]::Error!T {
        input.cstring().parse[T]()
    }
}

extend[T] T : parse::FromRadix[EnvVar]
where T: parse::FromRadix[cstring::CStringView]
{
    type Error = [T as parse::FromRadix[cstring::CStringView]]::Error;

    fn fromRadix(input: EnvVar, radix: u32) [T as parse::FromRadix[EnvVar]]::Error!T {
        input.cstring().parseRadix[T](radix)
    }
}

extend Env {
    pub(pkg) fn init(ptr: &&u8) Env {
        if ptr as usize == 0usize {
            return Self { ptr: ptr, len: 0usize };
        }
        let mut len = 0usize;
        while ptr[len] as usize != 0 {
            len += 1;
        }
        Self { ptr: ptr, len: len }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn get(&self, index: usize) ?EnvVar {
        if index >= self.len {
            null
        } else {
            let ptr = self.ptr[index];
            if ptr as usize == 0usize {
                null
            } else {
                ?EnvVar::init(ptr)
            }
        }
    }

    pub fn iter(&self) EnvIter {
        EnvIter::init(self.*, 0)
    }

    pub(pkg) fn rawEnvp(&self) &&u8 {
        self.ptr
    }
}

extend EnvIter {
    pub fn init(env: Env, index: usize) EnvIter {
        let mut start = index;
        if start > env.len {
            start = env.len;
        }
        Self { env: env, len: env.len, index: start }
    }

    pub fn remaining(&self) usize {
        self.len - self.index
    }
}

extend EnvIter : Iterator {
    type Item = EnvVar;

    pub fn next(&mut self) ?EnvVar {
        if self.index >= self.len {
            null
        } else if self.env.get(self.index) is ?value {
            self.index += 1;
            ?value
        } else {
            null
        }
    }
}
