using root::cstring;
using root::fmt;
using root::parse;
using root::process::types;

using types::{Env, EnvEntry, EnvIter, EnvVar};

extend EnvEntry {
    pub fun init(name: &[char], value: &[char]) EnvEntry {
        .{ name, value }
    }

    pub fun name(&self) &[char] {
        self.name
    }

    pub fun value(&self) &[char] {
        self.value
    }
}

extend EnvVar {
    fun init(ptr: &u8) EnvVar {
        .{ text: cstring::CStringView::fromTerminatedPtr(ptr) }
    }

    pub fun cstring(&self) cstring::CStringView {
        self.text
    }

    pub fun bytes(&self) &[u8] {
        self.text.bytes()
    }

    pub fun hasName(&self, name: &[u8]) bool {
        let bytes = self.bytes();
        if bytes.len() <= name.len() or not (&bytes[0..name.len()]).equals(name) {
            return false;
        }
        bytes[name.len()] == b'='
    }

    pub fun valueBytes(&self) &[u8] {
        let bytes = self.bytes();
        let mut index: usize = 0;
        while index < bytes.len() {
            if bytes[index] == b'=' {
                return &bytes[(index + 1)..];
            }
            index += 1;
        }
        &bytes[0..0]
    }

    pub fun len(&self) usize {
        self.text.len()
    }

    pub fun isEmpty(&self) bool {
        self.len() == 0
    }

    pub fun parse[T](self) [T as parse::From[EnvVar]]::Error!T
    where T: parse::From[EnvVar]
    {
        [T]::from(self)
    }

    pub fun parseRadix[T](self, radix: u32) [T as parse::FromRadix[EnvVar]]::Error!T
    where T: parse::FromRadix[EnvVar]
    {
        [T]::fromRadix(self, radix)
    }
}

extend EnvVar : fmt::Format {
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.text.format(formatter)
    }

    fun formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.text.formatSpec(formatter, spec)
    }
}

extend[T] T : parse::From[EnvVar]
where T: parse::From[cstring::CStringView]
{
    type Error = [T as parse::From[cstring::CStringView]]::Error;

    fun from(input: EnvVar) [T as parse::From[EnvVar]]::Error!T {
        input.cstring().parse[T]()
    }
}

extend[T] T : parse::FromRadix[EnvVar]
where T: parse::FromRadix[cstring::CStringView]
{
    type Error = [T as parse::FromRadix[cstring::CStringView]]::Error;

    fun fromRadix(input: EnvVar, radix: u32) [T as parse::FromRadix[EnvVar]]::Error!T {
        input.cstring().parseRadix[T](radix)
    }
}

extend Env {
    pub(root) fun init(ptr: &&u8) Env {
        if ptr as usize == 0 {
            return .{ ptr, len: 0 };
        }
        let mut len: usize = 0;
        while ptr[len] as usize != 0 {
            len += 1;
        }
        .{ ptr, len }
    }

    pub fun len(&self) usize {
        self.len
    }

    pub fun get(&self, index: usize) ?EnvVar {
        if index >= self.len {
            null
        } else {
            let ptr = self.ptr[index];
            if ptr as usize == 0 {
                null
            } else {
                ?.init(ptr)
            }
        }
    }

    pub fun find(&self, name: &[u8]) ?EnvVar {
        let mut iterator = self.iter();
        loop {
            match iterator.next() {
                ?entry => {
                    if entry.hasName(name) {
                        return ?entry;
                    }
                },
                null => break,
            }
        }
        null
    }

    pub fun iter(&self) EnvIter {
        .init(self.*, 0)
    }

    pub(root) fun rawEnvp(&self) &&u8 {
        self.ptr
    }
}

extend EnvIter {
    pub fun init(env: Env, index: usize) EnvIter {
        let mut start = index;
        if start > env.len {
            start = env.len;
        }
        .{ env, len: env.len, index: start }
    }

    pub fun remaining(&self) usize {
        self.len - self.index
    }
}

extend EnvIter : Iterator {
    type Item = EnvVar;

    pub fun next(&mut self) ?EnvVar {
        if self.index >= self.len {
            null
        } else if self.env.get(self.index) is ?value {
            self.index += 1;
            ?value
        } else {
            null
        }
    }
}
