using pkg::cstring;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::os;

pub enum ExitCode: i32 {
    Success = 0,
    _,
}

pub enum TermKind: i32 {
    Exited = 1,
    Signal = 2,
    Stopped = 3,
    Unknown = 4,
}

pub enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub enum StdStream {
    Stdin,
    Stdout,
    Stderr,
}

pub enum EnvEntryError {
    EmptyName,
    NameContainsEquals,
    NameContainsNul,
    ValueContainsNul,
    DuplicateName(usize),
}

pub enum Error {
    Allocation(mem::Error),
    Path(fs::PathError),
    ArgumentContainsNul(usize),
    Environment { index: usize, cause: EnvEntryError },
    SpawnSetup(os::Error),
    Spawn(os::SpawnError),
    Wait(os::Error),
    TryWait(os::Error),
    Kill(os::Error),
    Close { stream: StdStream, cause: os::Error },
}

pub enum Signal: i32 {
    Term = 15,
    Kill = 9,
    _,
}

pub struct Term {
    kind: TermKind,
    code: i32,
}

pub struct Command {
    path: fs::PathView,
    arguments: ?&[&[char]],
    environment: CommandEnvironment,
    stdin: StdIo,
    stdout: StdIo,
    stderr: StdIo,
    cwd: ?fs::PathView,
}

pub struct Args {
    len: usize,
    ptr: &&u8,
}

pub struct ArgsIter {
    args: Args,
    index: usize,
}

pub struct Arg {
    text: cstring::CStringView,
}

pub struct Env {
    ptr: &&u8,
}

pub struct EnvIter {
    env: Env,
    len: usize,
    index: usize,
}

pub struct EnvVar {
    text: cstring::CStringView,
}

pub struct EnvEntry {
    name: &[char],
    value: &[char],
}

pub(pkg) enum CommandEnvironment {
    Inherit(Env),
    Exact(&[EnvEntry]),
    Empty,
}

pub enum ChildStateKind: i32 {
    Running = 1,
    Exited = 2,
}

pub struct RunningChild {
    pid: os::ProcessId,
}

pub struct ExitedChild {
    pid: os::ProcessId,
    status: os::WaitStatus,
}

pub union ChildStatePayload {
    running: RunningChild,
    exited: ExitedChild,
}

pub struct ChildState {
    kind: ChildStateKind,
    payload: ChildStatePayload,
}

pub struct Child {
    state: ChildState,
    stdin: ?os::FileHandle,
    stdout: ?os::FileHandle,
    stderr: ?os::FileHandle,
}

pub struct Init {
    argc: usize,
    argv: &&u8,
    envp: &&u8,
    io: &mut io::Io[Error = os::Error],
}
