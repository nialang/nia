using pkg::cstring;
using pkg::io;
using pkg::os;

pub enum ExitCode: i32 {
    Success = 0,
    _,
}

pub enum TermKind: i32 {
    Exited = 1,
    Signal = 2,
    Stopped = 3,
    Unknown = 4,
}

pub enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub enum Error: i32 {
    Invalid = 22,
    SpawnSetup = 101,
    SpawnStdio = 102,
    SpawnCwd = 103,
    SpawnExec = 104,
    Wait = 120,
    TryWait = 121,
    Kill = 122,
    CloseStdin = 130,
    CloseStdout = 131,
    CloseStderr = 132,
    System = 255,
    _,
}

pub enum Signal: i32 {
    Term = 15,
    Kill = 9,
    _,
}

pub struct Term {
    kind: TermKind,
    code: i32,
}

pub struct Command {
    path: cstring::CStringView,
    argv: &&u8,
    envp: &&u8,
    stdin: StdIo,
    stdout: StdIo,
    stderr: StdIo,
    cwd: ?cstring::CStringView,
}

pub struct Args {
    len: usize,
    ptr: &&u8,
}

pub struct ArgsIter {
    args: Args,
    index: usize,
}

pub struct Arg {
    text: cstring::CStringView,
}

pub(pkg) struct ArgList {
    args: &mut [&u8],
    arg_len: usize,
}

pub struct Env {
    ptr: &&u8,
}

pub struct EnvIter {
    env: Env,
    len: usize,
    index: usize,
}

pub struct EnvVar {
    text: cstring::CStringView,
}

pub enum ChildStateKind: i32 {
    Running = 1,
    Exited = 2,
}

pub struct RunningChild {
    pid: os::ProcessId,
}

pub struct ExitedChild {
    pid: os::ProcessId,
    status: os::WaitStatus,
}

pub union ChildStatePayload {
    running: RunningChild,
    exited: ExitedChild,
}

pub struct ChildState {
    kind: ChildStateKind,
    payload: ChildStatePayload,
}

pub struct Child {
    state: ChildState,
    stdin: ?os::FileHandle,
    stdout: ?os::FileHandle,
    stderr: ?os::FileHandle,
}

pub struct Init {
    argc: usize,
    argv: &&u8,
    envp: &&u8,
    io: &mut io::Io[Error = os::Error],
}
