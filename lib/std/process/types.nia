using pkg::collections;
using pkg::cstring;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::os;

pub enum ExitCode: i32 {
    Success = 0,
    _,
}

pub enum TermKind: i32 {
    Exited = 1,
    Signal = 2,
    Stopped = 3,
    Unknown = 4,
}

pub enum StdIo: i32 {
    Inherit = 1,
    Ignore = 2,
    Pipe = 3,
}

pub enum StdStream {
    Stdin,
    Stdout,
    Stderr,
}

pub enum EnvEntryError {
    EmptyName,
    NameContainsEquals,
    NameContainsNul,
    ValueContainsNul,
    DuplicateName(usize),
}

pub enum Error {
    Allocation(mem::Error),
    Path(fs::PathError),
    ArgumentContainsNul(usize),
    Environment { index: usize, cause: EnvEntryError },
    SpawnSetup(SystemError),
    Spawn(SpawnError),
    Wait(SystemError),
    TryWait(SystemError),
    Kill(SystemError),
    Close { stream: StdStream, cause: io::Error },
}

pub enum SpawnError {
    Setup(SystemError),
    Stdio(SystemError),
    Cwd(SystemError),
    Exec(SystemError),
    Reap {
        stage: SpawnStage,
        primary: SystemError,
        cause: SystemError,
        pid: ProcessId,
    },
}

pub enum SpawnStage: i32 {
    Setup = 1,
    Stdio = 2,
    Cwd = 3,
    Exec = 4,
    _,
}

pub enum SystemError: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    NoChild = 10,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    CrossDevice = 18,
    NotDir = 20,
    IsDir = 21,
    Invalid = 22,
    NoSpace = 28,
    ReadOnly = 30,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    NotEmpty = 39,
    System = 255,
    _,
}

pub struct ProcessId {
    raw: i32,
}

pub enum Signal: i32 {
    Term = 15,
    Kill = 9,
    _,
}

pub struct Term {
    kind: TermKind,
    code: i32,
}

pub struct Command {
    path: fs::PathView,
    arguments: ?&[&[char]],
    environment: CommandEnvironment,
    stdin: StdIo,
    stdout: StdIo,
    stderr: StdIo,
    cwd: ?fs::PathView,
}

pub(pkg) enum SpawnOutcome {
    Success(Child),
    Failure(Error),
}

pub(pkg) struct SpawnStorage {
    argumentBytes: collections::ArrayList[u8],
    argv: collections::ArrayList[&u8],
    environmentBytes: collections::ArrayList[u8],
    environmentPointers: collections::ArrayList[&u8],
    cwdBytes: collections::ArrayList[u8],
    nativeSpawn: ?os::SpawnAttempt,
    outcome: ?SpawnOutcome,
}

// SpawnAttempt owns both default-allocator staging and the pending spawn
// outcome until finish releases every staging allocation.
pub struct SpawnAttempt {
    allocator: mem::PageAllocator,
    storage: SpawnStorage,
}

// AllocatorSpawnAttempt keeps custom-allocator staging reachable. Every finish
// retry must receive the allocator that created the staging blocks.
pub struct AllocatorSpawnAttempt {
    storage: SpawnStorage,
}

pub struct Args {
    len: usize,
    ptr: &&u8,
}

pub struct ArgsIter {
    args: Args,
    index: usize,
}

pub struct Arg {
    text: cstring::CStringView,
}

pub struct Env {
    ptr: &&u8,
    len: usize,
}

pub struct EnvIter {
    env: Env,
    len: usize,
    index: usize,
}

pub struct EnvVar {
    text: cstring::CStringView,
}

pub struct EnvEntry {
    name: &[char],
    value: &[char],
}

pub(pkg) enum CommandEnvironment {
    Inherit(Env),
    Exact(&[EnvEntry]),
    Empty,
}

pub enum ChildStateKind: i32 {
    Running = 1,
    Exited = 2,
}

pub struct RunningChild {
    pid: ProcessId,
}

pub struct ExitedChild {
    pid: ProcessId,
    status: os::WaitStatus,
}

pub union ChildStatePayload {
    running: RunningChild,
    exited: ExitedChild,
}

pub struct ChildState {
    kind: ChildStateKind,
    payload: ChildStatePayload,
}

pub struct Child {
    state: ChildState,
    stdin: ?ChildStdin,
    stdout: ?ChildStdout,
    stderr: ?ChildStderr,
}

pub struct ChildStdin {
    handle: ?os::FileHandle,
}

pub struct ChildStdout {
    handle: ?os::FileHandle,
}

pub struct ChildStderr {
    handle: ?os::FileHandle,
}

pub struct Init {
    args: Args,
    env: Env,
}

extend SystemError {
    pub(pkg) fn fromOs(cause: os::Error) SystemError {
        match cause {
            os::Error::PermissionDenied => SystemError::PermissionDenied,
            os::Error::NotFound => SystemError::NotFound,
            os::Error::Interrupted => SystemError::Interrupted,
            os::Error::Io => SystemError::Io,
            os::Error::BadFd => SystemError::BadFd,
            os::Error::NoChild => SystemError::NoChild,
            os::Error::Again => SystemError::Again,
            os::Error::OutOfMemory => SystemError::OutOfMemory,
            os::Error::Access => SystemError::Access,
            os::Error::Fault => SystemError::Fault,
            os::Error::Busy => SystemError::Busy,
            os::Error::AlreadyExists => SystemError::AlreadyExists,
            os::Error::CrossDevice => SystemError::CrossDevice,
            os::Error::NotDir => SystemError::NotDir,
            os::Error::IsDir => SystemError::IsDir,
            os::Error::Invalid => SystemError::Invalid,
            os::Error::NoSpace => SystemError::NoSpace,
            os::Error::ReadOnly => SystemError::ReadOnly,
            os::Error::BrokenPipe => SystemError::BrokenPipe,
            os::Error::OutOfRange => SystemError::OutOfRange,
            os::Error::TooLong => SystemError::TooLong,
            os::Error::NotEmpty => SystemError::NotEmpty,
            _ => SystemError::System,
        }
    }
}
