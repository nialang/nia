using pkg::os;
using pkg::process::types;

using types::{Term, TermKind};

extend Term {
    fun exited(code: i32) Term {
        .{ kind: .Exited, code }
    }

    fun signal(signal: i32) Term {
        .{ kind: .Signal, code: signal }
    }

    fun stopped(signal: i32) Term {
        .{ kind: .Stopped, code: signal }
    }

    fun unknown(raw: i32) Term {
        .{ kind: .Unknown, code: raw }
    }

    pub(pkg) fun fromWaitStatus(status: os::WaitStatus) Term {
        if status.exitCode() is ?code {
            .exited(code)
        } else if status.signal() is ?signal {
            .signal(signal)
        } else if status.stopSignal() is ?signal {
            .stopped(signal)
        } else {
            .unknown(status.raw())
        }
    }

    pub fun kind(&self) TermKind {
        self.kind
    }

    pub fun code(&self) i32 {
        self.code
    }

    pub fun succeeded(&self) bool {
        self.kind == TermKind::Exited and self.code == 0
    }

    pub fun exitCode(&self) ?i32 {
        if self.kind == TermKind::Exited {
            ?self.code
        } else {
            null
        }
    }

    pub fun signalCode(&self) ?i32 {
        if self.kind == TermKind::Signal {
            ?self.code
        } else {
            null
        }
    }
}
