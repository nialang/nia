using pkg::os;
using pkg::process::types;

using types::{Term, TermKind};

extend Term {
    fn exited(code: i32) Term {
        .{ kind: .Exited, code }
    }

    fn signal(signal: i32) Term {
        .{ kind: .Signal, code: signal }
    }

    fn stopped(signal: i32) Term {
        .{ kind: .Stopped, code: signal }
    }

    fn unknown(raw: i32) Term {
        .{ kind: .Unknown, code: raw }
    }

    pub(pkg) fn fromWaitStatus(status: os::WaitStatus) Term {
        if status.exitCode() is ?code {
            Term::exited(code)
        } else if status.signal() is ?signal {
            Term::signal(signal)
        } else if status.stopSignal() is ?signal {
            Term::stopped(signal)
        } else {
            Term::unknown(status.raw())
        }
    }

    pub fn kind(&self) TermKind {
        self.kind
    }

    pub fn code(&self) i32 {
        self.code
    }

    pub fn succeeded(&self) bool {
        self.kind == TermKind::Exited and self.code == 0
    }

    pub fn exitCode(&self) ?i32 {
        if self.kind == TermKind::Exited {
            ?self.code
        } else {
            null
        }
    }

    pub fn signalCode(&self) ?i32 {
        if self.kind == TermKind::Signal {
            ?self.code
        } else {
            null
        }
    }
}
