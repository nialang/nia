using pkg::error;
using pkg::fmt;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::os;
using pkg::process::types;

using types::{Error, ExitCode};

extend fs::Error : error::IntoError[ExitCode] {
    fn into_error(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend fs::Error {
    pub fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

pub fn exit(code: i32) ExitCode {
    code as ExitCode
}

extend os::Error : error::IntoError[ExitCode] {
    fn into_error(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend os::Error {
    pub fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] os::Error!T {
    pub fn exit(self) ExitCode!T {
        self.cast_error()
    }
}

extend Error : error::IntoError[ExitCode] {
    fn into_error(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend Error {
    pub fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] Error!T {
    pub fn exit(self) ExitCode!T {
        self.cast_error()
    }
}

extend[T] fs::Error!T {
    pub fn exit(self) ExitCode!T {
        self.cast_error()
    }
}

extend fmt::Error : error::IntoError[ExitCode] {
    fn into_error(self) ExitCode {
        switch self {
            fmt::Error::Write => exit(5),
            fmt::Error::InvalidTemplate => exit(22),
            fmt::Error::MissingArgument => exit(22),
            fmt::Error::ExtraArgument => exit(22),
            _ => exit(255),
        }
    }
}

extend fmt::Error {
    pub fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] fmt::Error!T {
    pub fn exit(self) ExitCode!T {
        self.cast_error()
    }
}

extend io::BufferError : error::IntoError[ExitCode] {
    fn into_error(self) ExitCode {
        switch self {
            io::BufferError::NoSpace => exit(2),
            io::BufferError::ShortWrite => exit(5),
            io::BufferError::EndOfStream => exit(5),
            _ => exit(255),
        }
    }
}

extend io::BufferError {
    pub fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] io::BufferError!T {
    pub fn exit(self) ExitCode!T {
        self.cast_error()
    }
}

extend mem::Error : error::IntoError[ExitCode] {
    fn into_error(self) ExitCode {
        switch self {
            mem::Error::Invalid => exit(22),
            mem::Error::InvalidAlignment => exit(22),
            mem::Error::OutOfMemory => exit(12),
            _ => exit(255),
        }
    }
}

extend mem::Error {
    pub fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] mem::Error!T {
    pub fn exit(self) ExitCode!T {
        self.cast_error()
    }
}
