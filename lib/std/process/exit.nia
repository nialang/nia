    }
}

extend io::BufferError : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            io::BufferError::NoSpace => exit(2),
            io::BufferError::ShortWrite => exit(5),
            io::BufferError::EndOfStream => exit(5),
            _ => exit(255),
        }
    }
}

extend io::BufferError {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] io::BufferError!T {
