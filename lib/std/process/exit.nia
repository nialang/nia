using pkg::cstring;
using pkg::debug;
using pkg::error;
using pkg::result;
using pkg::test;
using pkg::fmt;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::process::types;

using types::{Error, ExitCode, SpawnError, SystemError};

extend test::Error : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .AssertionFailed(_), .ValuesEqual(_), .ValuesNotEqual(_) => exit(1),
        }
    }
}

extend debug::Error : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .Format(cause) => cause.asExitCode(),
            .Flush(cause) => cause.asExitCode(),
        }
    }
}

extend debug::Error {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend[T] debug::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: debug::Error -> cause.intoError())
    }
}

extend cstring::CStringBuildError : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .ContainsNul => exit(22),
            .Allocation(cause) => cause.asExitCode(),
        }
    }
}

extend cstring::CStringBuildError {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend[T] cstring::CStringBuildError!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: cstring::CStringBuildError -> cause.intoError())
    }
}

extend fs::Error : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend fs::Error {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend fs::PathError : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .ContainsNul, .Absolute, .ParentTraversal, .MissingTerminator => exit(22),
            .TooLong => exit(36),
            _ => exit(255),
        }
    }
}

extend fs::PathError {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend fs::OperationError : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .Path { operation: _, cause } => {
                cause.asExitCode()
            },
            .System { operation: _, cause } => {
                cause.asExitCode()
            },
        }
    }
}

extend fs::OperationError {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

pub const fn exit(code: i32) ExitCode {
    code as ExitCode
}

extend io::SystemError : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend io::SystemError {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend SystemError : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend SystemError {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend io::Error : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .EndOfStream => exit(5),
            .ShortWrite => exit(5),
            .Closed => exit(9),
            .System(cause) => cause.intoError(),
        }
    }
}

extend io::Error {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend[T] io::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: io::Error -> cause.intoError())
    }
}

extend Error : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .Allocation(cause) => cause.asExitCode(),
            .Path(cause) => cause.asExitCode(),
            .ArgumentContainsNul(_) => {
                exit(22)
            },
            .Environment { index: _, cause: _ } => {
                exit(22)
            },
            .SpawnSetup(cause) => cause.asExitCode(),
            .Spawn(cause) => cause.asExitCode(),
            .Wait(cause) => cause.asExitCode(),
            .TryWait(cause) => cause.asExitCode(),
            .Kill(cause) => cause.asExitCode(),
            .Close { stream: _, cause } => {
                cause.asExitCode()
            },
        }
    }
}

extend SpawnError : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .Setup(cause) => cause.asExitCode(),
            .Stdio(cause) => cause.asExitCode(),
            .Cwd(cause) => cause.asExitCode(),
            .Exec(cause) => cause.asExitCode(),
            .Reap { stage: _, primary: _, cause, pid: _ } => cause.asExitCode(),
        }
    }
}

extend SpawnError {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend Error {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend[T] Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: Error -> cause.intoError())
    }
}

extend[T] fs::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: fs::Error -> cause.intoError())
    }
}

extend[T] fs::PathError!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: fs::PathError -> cause.intoError())
    }
}

extend[T] fs::OperationError!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: fs::OperationError -> cause.intoError())
    }
}

extend fmt::Error : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .Write => exit(5),
            .InvalidTemplate => exit(22),
            .MissingArgument => exit(22),
            .ExtraArgument => exit(22),
            _ => exit(255),
        }
    }
}

extend fmt::Error {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend[T] fmt::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: fmt::Error -> cause.intoError())
    }
}

extend io::BufferError : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .NoSpace => exit(2),
            .ShortWrite => exit(5),
            .EndOfStream => exit(5),
            _ => exit(255),
        }
    }
}

extend io::BufferError {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend[T] io::BufferError!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: io::BufferError -> cause.intoError())
    }
}

extend mem::Error : error::IntoError[ExitCode] {
    const fn intoError(self) ExitCode {
        match self {
            .Invalid => exit(22),
            .InvalidAlignment => exit(22),
            .OutOfMemory => exit(12),
            _ => exit(255),
        }
    }
}

extend mem::Error {
    pub const fn asExitCode(self) ExitCode {
        self.intoError()
    }
}

extend[T] mem::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: mem::Error -> cause.intoError())
    }
}
