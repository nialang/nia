    }
}

extend mem::Error : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            mem::Error::Invalid => exit(22),
            mem::Error::InvalidAlignment => exit(22),
            mem::Error::OutOfMemory => exit(12),
            _ => exit(255),
        }
    }
}

extend mem::Error {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] mem::Error!T {
