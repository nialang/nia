using pkg::cstring;
using pkg::debug;
using pkg::error;
using pkg::fmt;
using pkg::fs;
using pkg::io;
using pkg::mem;
using pkg::process::types;

using types::{Error, ExitCode, SpawnError, SystemError};

extend debug::Error : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            debug::Error::Format(cause) => cause.asExitCode(),
            debug::Error::Flush(cause) => cause.asExitCode(),
        }
    }
}

extend debug::Error {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] debug::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: debug::Error -> cause.into_error())
    }
}

extend cstring::CStringBuildError : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            cstring::CStringBuildError::ContainsNul => exit(22),
            cstring::CStringBuildError::Allocation(cause) => cause.asExitCode(),
        }
    }
}

extend cstring::CStringBuildError {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] cstring::CStringBuildError!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: cstring::CStringBuildError -> cause.into_error())
    }
}

extend fs::Error : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend fs::Error {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend fs::PathError : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            fs::PathError::ContainsNul => exit(22),
            fs::PathError::Absolute => exit(22),
            fs::PathError::ParentTraversal => exit(22),
            fs::PathError::MissingTerminator => exit(22),
            fs::PathError::TooLong => exit(36),
            _ => exit(255),
        }
    }
}

extend fs::PathError {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend fs::OperationError : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            fs::OperationError::Path { operation: _, cause } => {
                cause.asExitCode()
            },
            fs::OperationError::System { operation: _, cause } => {
                cause.asExitCode()
            },
        }
    }
}

extend fs::OperationError {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

pub const fn exit(code: i32) ExitCode {
    code as ExitCode
}

extend io::SystemError : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend io::SystemError {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend SystemError : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        self as i32 as ExitCode
    }
}

extend SystemError {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend io::Error : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            io::Error::EndOfStream => exit(5),
            io::Error::ShortWrite => exit(5),
            io::Error::Closed => exit(9),
            io::Error::System(cause) => cause.into_error(),
        }
    }
}

extend io::Error {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] io::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: io::Error -> cause.into_error())
    }
}

extend Error : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            Error::Allocation(cause) => cause.asExitCode(),
            Error::Path(cause) => cause.asExitCode(),
            Error::ArgumentContainsNul(_) => {
                exit(22)
            },
            Error::Environment { index: _, cause: _ } => {
                exit(22)
            },
            Error::SpawnSetup(cause) => cause.asExitCode(),
            Error::Spawn(cause) => cause.asExitCode(),
            Error::Wait(cause) => cause.asExitCode(),
            Error::TryWait(cause) => cause.asExitCode(),
            Error::Kill(cause) => cause.asExitCode(),
            Error::Close { stream: _, cause } => {
                cause.asExitCode()
            },
        }
    }
}

extend SpawnError : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            SpawnError::Setup(cause) => cause.asExitCode(),
            SpawnError::Stdio(cause) => cause.asExitCode(),
            SpawnError::Cwd(cause) => cause.asExitCode(),
            SpawnError::Exec(cause) => cause.asExitCode(),
            SpawnError::Reap { stage: _, primary: _, cause, pid: _ } => cause.asExitCode(),
        }
    }
}

extend SpawnError {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend Error {
    pub const fn asExitCode(self) ExitCode {
        self.into_error()
    }
}

extend[T] Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: Error -> cause.into_error())
    }
}

extend[T] fs::Error!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: fs::Error -> cause.into_error())
    }
}

extend[T] fs::PathError!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: fs::PathError -> cause.into_error())
    }
}

extend[T] fs::OperationError!T {
    pub fn exit(self) ExitCode!T {
        self.mapError(&\cause: fs::OperationError -> cause.into_error())
    }
}

extend fmt::Error : error::IntoError[ExitCode] {
    const fn into_error(self) ExitCode {
        match self {
            fmt::Error::Write => exit(5),
            fmt::Error::InvalidTemplate => exit(22),
            fmt::Error::MissingArgument => exit(22),
            fmt::Error::ExtraArgument => exit(22),
            _ => exit(255),
        }
    }
}

extend fmt::Error {
