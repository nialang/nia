using pkg::cstring;
using pkg::fmt;
using pkg::parse;
using pkg::process::types;
using pkg::slice;

using types::{Arg, Args, ArgsIter};

extend Arg {
    fn init(ptr: &u8) Arg {
        { text: cstring::CStringView::fromPtrUnchecked(ptr) }
    }

    pub fn rawPtr(&self) &u8 {
        self.text.rawPtr()
    }

    pub fn cstring(&self) cstring::CStringView {
        self.text
    }

    pub fn bytes(&self) &[u8] {
        self.text.bytes()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }
}

extend Arg : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        self.text.format(formatter)
    }

    fn format_spec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!void {
        self.text.format_spec(formatter, spec)
    }
}

extend[T] T : parse::From[Arg]
where T: parse::From[cstring::CStringView]
{
    type Error = [T as parse::From[cstring::CStringView]]::Error;

    fn parse(input: Arg) [T as parse::From[Arg]]::Error!T {
        parse::value[T](input.cstring())
    }
}

extend[T] T : parse::FromRadix[Arg]
where T: parse::FromRadix[cstring::CStringView]
{
    type Error = [T as parse::FromRadix[cstring::CStringView]]::Error;

    fn parseRadix(input: Arg, radix: u32) [T as parse::FromRadix[Arg]]::Error!T {
        parse::radix[T](input.cstring(), radix)
    }
}

extend Args {
    pub fn init(len: usize, ptr: &&u8) Args {
        { len: len, ptr: ptr }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn isEmpty(&self) bool {
        self.len == 0
    }

    pub fn program(&self) ?Arg {
        self.get(0)
    }

    pub fn get(&self, index: usize) ?Arg {
        if index >= self.len {
            null
        } else {
            ?Arg::init(self.ptr[index])
        }
    }

    pub fn iter(&self) ArgsIter {
        ArgsIter::init(self.*, 0)
    }

    pub fn skipProgram(&self) ArgsIter {
        ArgsIter::init(self.*, 1)
    }

    pub fn rawArgv(&self) &&u8 {
        self.ptr
    }
}

extend ArgsIter {
    pub fn init(args: Args, index: usize) ArgsIter {
        let mut start = index;
        if start > args.len() {
            start = args.len();
        }
        { args: args, index: start }
    }

    pub fn remaining(&self) usize {
        self.args.len() - self.index
    }
}

extend ArgsIter : Iterator {
    type Item = Arg;

    pub fn next(&mut self) ?Arg {
        let value = switch self.args.get(self.index) {
            ?value => {
                value
            },
            null => {
                return null;
            },
        };
        self.index += 1;
        ?value
    }
}
