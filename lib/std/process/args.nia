using root::cstring;
using root::fmt;
using root::parse;
using root::process::types;
using root::slice;

using types::{Arg, Args, ArgsIter};

extend Arg {
    fun init(ptr: &u8) Arg {
        .{ text: cstring::CStringView::fromTerminatedPtr(ptr) }
    }

    pub fun cstring(&self) cstring::CStringView {
        self.text
    }

    pub fun bytes(&self) &[u8] {
        self.text.bytes()
    }

    pub fun len(&self) usize {
        self.text.len()
    }

    pub fun isEmpty(&self) bool {
        self.len() == 0
    }

    pub fun parse[T](self) [T as parse::From[Arg]]::Error!T
    where T: parse::From[Arg]
    {
        [T]::from(self)
    }

    pub fun parseRadix[T](self, radix: u32) [T as parse::FromRadix[Arg]]::Error!T
    where T: parse::FromRadix[Arg]
    {
        [T]::fromRadix(self, radix)
    }
}

extend Arg : fmt::Format {
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.text.format(formatter)
    }

    fun formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.text.formatSpec(formatter, spec)
    }
}

extend[T] T : parse::From[Arg]
where T: parse::From[cstring::CStringView]
{
    type Error = [T as parse::From[cstring::CStringView]]::Error;

    fun from(input: Arg) [T as parse::From[Arg]]::Error!T {
        input.cstring().parse[T]()
    }
}

extend[T] T : parse::FromRadix[Arg]
where T: parse::FromRadix[cstring::CStringView]
{
    type Error = [T as parse::FromRadix[cstring::CStringView]]::Error;

    fun fromRadix(input: Arg, radix: u32) [T as parse::FromRadix[Arg]]::Error!T {
        input.cstring().parseRadix[T](radix)
    }
}

extend Args {
    pub(root) fun init(len: usize, ptr: &&u8) Args {
        let actualLen = if ptr as usize == 0 { 0 } else { len };
        .{ len: actualLen, ptr }
    }

    pub fun len(&self) usize {
        self.len
    }

    pub fun isEmpty(&self) bool {
        self.len == 0
    }

    pub fun program(&self) ?Arg {
        self.get(0)
    }

    pub fun get(&self, index: usize) ?Arg {
        if index >= self.len {
            null
        } else {
            let ptr = self.ptr[index];
            if ptr as usize == 0 {
                null
            } else {
                ?.init(ptr)
            }
        }
    }

    pub fun iter(&self) ArgsIter {
        .init(self.*, 0)
    }

    pub fun skipProgram(&self) ArgsIter {
        .init(self.*, 1)
    }

}

extend ArgsIter {
    pub fun init(args: Args, index: usize) ArgsIter {
        let mut start = index;
        if start > args.len() {
            start = args.len();
        }
        .{ args, index: start }
    }

    pub fun remaining(&self) usize {
        self.args.len() - self.index
    }
}

extend ArgsIter : Iterator {
    type Item = Arg;

    pub fun next(&mut self) ?Arg {
        if self.args.get(self.index) is ?value {
            self.index += 1;
            ?value
        } else {
            null
        }
    }
}
