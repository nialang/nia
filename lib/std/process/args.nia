using pkg::cstring;
using pkg::fmt;
using pkg::parse;
using pkg::process::types;
using pkg::slice;

using types::{Arg, Args, ArgsIter};

extend Arg {
    fn init(ptr: &u8) Arg {
        Self { text: cstring::CStringView::fromTerminatedPtr(ptr) }
    }

    pub fn cstring(&self) cstring::CStringView {
        self.text
    }

    pub fn bytes(&self) &[u8] {
        self.text.bytes()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn isEmpty(&self) bool {
        self.len() == 0
    }

    pub fn parse[T](self) [T as parse::From[Arg]]::Error!T
    where T: parse::From[Arg]
    {
        [T]::from(self)
    }

    pub fn parseRadix[T](self, radix: u32) [T as parse::FromRadix[Arg]]::Error!T
    where T: parse::FromRadix[Arg]
    {
        [T]::fromRadix(self, radix)
    }
}

extend Arg : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.text.format(formatter)
    }

    fn formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.text.formatSpec(formatter, spec)
    }
}

extend[T] T : parse::From[Arg]
where T: parse::From[cstring::CStringView]
{
    type Error = [T as parse::From[cstring::CStringView]]::Error;

    fn from(input: Arg) [T as parse::From[Arg]]::Error!T {
        input.cstring().parse[T]()
    }
}

extend[T] T : parse::FromRadix[Arg]
where T: parse::FromRadix[cstring::CStringView]
{
    type Error = [T as parse::FromRadix[cstring::CStringView]]::Error;

    fn fromRadix(input: Arg, radix: u32) [T as parse::FromRadix[Arg]]::Error!T {
        input.cstring().parseRadix[T](radix)
    }
}

extend Args {
    pub(pkg) fn init(len: usize, ptr: &&u8) Args {
        if ptr as usize == 0 {
            Self { len: 0, ptr: ptr }
        } else {
            Self { len: len, ptr: ptr }
        }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn isEmpty(&self) bool {
        self.len == 0
    }

    pub fn program(&self) ?Arg {
        self.get(0)
    }

    pub fn get(&self, index: usize) ?Arg {
        if index >= self.len {
            null
        } else {
            let ptr = self.ptr[index];
            if ptr as usize == 0 {
                null
            } else {
                ?Arg::init(ptr)
            }
        }
    }

    pub fn iter(&self) ArgsIter {
        ArgsIter::init(self.*, 0)
    }

    pub fn skipProgram(&self) ArgsIter {
        ArgsIter::init(self.*, 1)
    }

}

extend ArgsIter {
    pub fn init(args: Args, index: usize) ArgsIter {
        let mut start = index;
        if start > args.len() {
            start = args.len();
        }
        Self { args: args, index: start }
    }

    pub fn remaining(&self) usize {
        self.args.len() - self.index
    }
}

extend ArgsIter : Iterator {
    type Item = Arg;

    pub fn next(&mut self) ?Arg {
        if self.args.get(self.index) is ?value {
            self.index += 1;
            ?value
        } else {
            null
        }
    }
}
