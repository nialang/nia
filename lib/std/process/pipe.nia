using pkg::io;
using pkg::os;
using pkg::process::types;

using types::{ChildStderr, ChildStdin, ChildStdout};

fun readHandle(handle: ?os::FileHandle, bytes: &mut [u8]) io::Error!usize {
    if handle is ?value {
        let n = value.readSome(bytes).?;
        if n > bytes.len() {
            return .EndOfStream!;
        }
        return !n;
    }
    .Closed!
}

fun writeHandle(handle: ?os::FileHandle, bytes: &[u8]) io::Error!usize {
    if handle is ?value {
        let n = value.writeSome(bytes).?;
        if n > bytes.len() {
            return .ShortWrite!;
        }
        return !n;
    }
    .Closed!
}

fun closeHandle(handle: &mut ?os::FileHandle) io::Error!() {
    let owned = handle.*;
    handle.* = null;
    if owned is ?value {
        return !(value.close().?);
    }
    !()
}

extend ChildStdin {
    pub(pkg) fun init(handle: os::FileHandle) ChildStdin {
        .{ handle: ?handle }
    }

    pub fun close(&mut self) io::Error!() {
        closeHandle(&mut self.handle)
    }

    pub fun buffered(&mut self, buffer: &mut [u8]) io::BufferedWriter[ChildStdin] {
        .init(self, buffer)
    }
}

extend ChildStdin : io::Writer {
    type Error = io::Error;

    pub fun shortWrite(&self) Error {
        io::Error::ShortWrite
    }

    pub fun write(&mut self, bytes: &[u8]) Error!usize {
        writeHandle(self.handle, bytes)
    }
}

extend ChildStdout {
    pub(pkg) fun init(handle: os::FileHandle) ChildStdout {
        .{ handle: ?handle }
    }

    pub fun close(&mut self) io::Error!() {
        closeHandle(&mut self.handle)
    }

    pub fun buffered(&mut self, buffer: &mut [u8]) io::BufferedReader[ChildStdout] {
        .init(self, buffer)
    }
}

extend ChildStdout : io::Reader {
    type Error = io::Error;

    pub fun endOfStream(&self) Error {
        io::Error::EndOfStream
    }

    pub fun read(&mut self, bytes: &mut [u8]) Error!usize {
        readHandle(self.handle, bytes)
    }
}

extend ChildStderr {
    pub(pkg) fun init(handle: os::FileHandle) ChildStderr {
        .{ handle: ?handle }
    }

    pub fun close(&mut self) io::Error!() {
        closeHandle(&mut self.handle)
    }

    pub fun buffered(&mut self, buffer: &mut [u8]) io::BufferedReader[ChildStderr] {
        .init(self, buffer)
    }
}

extend ChildStderr : io::Reader {
    type Error = io::Error;

    pub fun endOfStream(&self) Error {
        io::Error::EndOfStream
    }

    pub fun read(&mut self, bytes: &mut [u8]) Error!usize {
        readHandle(self.handle, bytes)
    }
}
