using pkg::os;
using pkg::process::types;

using types::{Child, ChildState, ChildStateKind, ChildStatePayload, Error, ExitedChild, RunningChild, Signal, Term};

extend Child {
    pub fn init(pid: os::ProcessId) Child {
        {
            state: ChildState::running(pid),
            stdin: null,
            stdout: null,
            stderr: null,
        }
    }

    pub fn from_spawn_result(result: os::SpawnResult) Child {
        {
            state: ChildState::running(result.pid()),
            stdin: result.stdin(),
            stdout: result.stdout(),
            stderr: result.stderr(),
        }
    }

    pub fn pid(&self) os::ProcessId {
        self.state.pid()
    }

    pub fn take_stdin(&mut self) ?os::FileHandle {
        let handle = self.stdin;
        self.stdin = null;
        handle
    }

    pub fn take_stdout(&mut self) ?os::FileHandle {
        let handle = self.stdout;
        self.stdout = null;
        handle
    }

    pub fn take_stderr(&mut self) ?os::FileHandle {
        let handle = self.stderr;
        self.stderr = null;
        handle
    }

    pub fn close_stdin(&mut self) Error!void {
        if ?handle = self.take_stdin() {
            handle.close().as_process_error(Error::CloseStdin)
        } or null {
            !{}
        }
    }

    pub fn close_stdout(&mut self) Error!void {
        if ?handle = self.take_stdout() {
            handle.close().as_process_error(Error::CloseStdout)
        } or null {
            !{}
        }
    }

    pub fn close_stderr(&mut self) Error!void {
        if ?handle = self.take_stderr() {
            handle.close().as_process_error(Error::CloseStderr)
        } or null {
            !{}
        }
    }

    pub fn close_pipes(&mut self) Error!void {
        self.close_stdin().?;
        self.close_stdout().?;
        self.close_stderr().?;
        !{}
    }

    pub fn wait_raw(&mut self) Error!os::WaitStatus {
        if ?status = self.state.status() {
            return !status;
        } or null {}
        let pid = self.state.pid();
        self.close_stdin().?;
        let status = os::wait(pid).as_process_error(Error::Wait).?;
        self.state = ChildState::exited(pid, status);
        self.close_stdout().?;
        self.close_stderr().?;
        !status
    }

    pub fn try_wait_raw(&mut self) Error! ?os::WaitStatus {
        if ?status = self.state.status() {
            return !(?status);
        } or null {}
        let pid = self.state.pid();
        let status = os::try_wait(pid).as_process_error(Error::TryWait).?;
        if ?value = status {
            self.state = ChildState::exited(pid, value);
            self.close_pipes().?;
            !(?value)
        } or null {
            !null
        }
    }

    pub fn wait(&mut self) Error!Term {
        let status = self.wait_raw().?;
        !Term::from_wait_status(status)
    }

    pub fn try_wait(&mut self) Error! ?Term {
        let status = self.try_wait_raw().?;
        if ?value = status {
            !(?Term::from_wait_status(value))
        } or null {
            !null
        }
    }

    pub fn kill(&mut self) Error!Term {
        self.kill_with(Signal::Term)
    }

    pub fn kill_with(&mut self, signal: Signal) Error!Term {
        if ?status = self.state.status() {
            return !Term::from_wait_status(status);
        } or null {}
        os::kill_with(self.state.pid(), signal as i32).as_process_error(Error::Kill).?;
        self.wait()
    }
}

extend ChildState {
    fn running(pid: os::ProcessId) ChildState {
        {
            kind: ChildStateKind::Running,
            payload: { running: RunningChild::init(pid) },
        }
    }

    fn exited(pid: os::ProcessId, status: os::WaitStatus) ChildState {
        {
            kind: ChildStateKind::Exited,
            payload: { exited: ExitedChild::init(pid, status) },
        }
    }

    fn pid(&self) os::ProcessId {
        switch self.kind {
            ChildStateKind::Running => self.payload.running.pid(),
            ChildStateKind::Exited => self.payload.exited.pid(),
        }
    }

    fn status(&self) ?os::WaitStatus {
        switch self.kind {
            ChildStateKind::Running => null,
            ChildStateKind::Exited => ?self.payload.exited.status(),
        }
    }
}

extend RunningChild {
    fn init(pid: os::ProcessId) RunningChild {
        { pid: pid }
    }

    fn pid(&self) os::ProcessId {
        self.pid
    }
}

extend ExitedChild {
    fn init(pid: os::ProcessId, status: os::WaitStatus) ExitedChild {
        { pid: pid, status: status }
    }

    fn pid(&self) os::ProcessId {
        self.pid
    }

    fn status(&self) os::WaitStatus {
        self.status
    }
}

extend os::Error {
    fn as_process_error(self, context: Error) Error {
        switch self {
            os::Error::Invalid => Error::Invalid,
            os::Error::System => Error::System,
            _ => context,
        }
    }
}

extend[T] os::Error!T {
    fn as_process_error(self, context: Error) Error!T {
        if !value = self {
            !value
        } or error! {
            error.as_process_error(context)!
        }
    }
}
