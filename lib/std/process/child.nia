using root::io;
using root::error;
using root::os;
using root::process::convert;
using root::process::types;

using types::{Child, ChildState, ChildStateKind, ChildStderr, ChildStdin, ChildStdout, Error, ExitedChild, ProcessId, RunningChild, Signal, StdStream, Term};

extend Child {
    pub(root) fun init(pid: os::ProcessId) Child {
        .{
            state: .running(.fromOs(pid)),
            stdin: null,
            stdout: null,
            stderr: null,
        }
    }

    pub(root) fun fromSpawnResult(result: os::SpawnResult) Child {
        .{
            state: .running(.fromOs(result.pid())),
            stdin: result.stdin().map[ChildStdin, _](\handle: os::FileHandle -> ChildStdin { handle: ?handle }),
            stdout: result.stdout().map[ChildStdout, _](\handle: os::FileHandle -> ChildStdout { handle: ?handle }),
            stderr: result.stderr().map[ChildStderr, _](\handle: os::FileHandle -> ChildStderr { handle: ?handle }),
        }
    }

    pub fun pid(&self) ProcessId {
        self.state.pid()
    }

    pub fun takeStdin(&mut self) ?ChildStdin {
        let pipe = self.stdin;
        self.stdin = null;
        pipe
    }

    pub fun takeStdout(&mut self) ?ChildStdout {
        let pipe = self.stdout;
        self.stdout = null;
        pipe
    }

    pub fun takeStderr(&mut self) ?ChildStderr {
        let pipe = self.stderr;
        self.stderr = null;
        pipe
    }

    pub fun closeStdin(&mut self) Error!() {
        if self.takeStdin() is ?pipe {
            let mut owned = pipe;
            owned.close().withCloseContext(.Stdin)
        } else {
            !()
        }
    }

    pub fun closeStdout(&mut self) Error!() {
        if self.takeStdout() is ?pipe {
            let mut owned = pipe;
            owned.close().withCloseContext(.Stdout)
        } else {
            !()
        }
    }

    pub fun closeStderr(&mut self) Error!() {
        if self.takeStderr() is ?pipe {
            let mut owned = pipe;
            owned.close().withCloseContext(.Stderr)
        } else {
            !()
        }
    }

    pub fun closePipes(&mut self) Error!() {
        let mut cleanup: error::CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.closeStdin());
        cleanup.attempt(self.closeStdout());
        cleanup.attempt(self.closeStderr());
        cleanup.finish()
    }

    fun waitStatus(&mut self) Error!os::WaitStatus {
        if self.state.status() is ?status {
            return !status;
        }
        let pid = self.state.pid();
        self.closeStdin().?;
        let status = os::wait(self.state.osPid()).withWaitContext().?;
        self.state = .exited(pid, status);
        self.closePipes().?;
        !status
    }

    fun tryWaitStatus(&mut self) Error! ?os::WaitStatus {
        if self.state.status() is ?status {
            return !(?status);
        }
        let pid = self.state.pid();
        let status = os::tryWait(self.state.osPid()).withTryWaitContext().?;
        if status is ?value {
            self.state = .exited(pid, value);
            self.closePipes().?;
            return !(?value);
        }
        !null
    }

    pub fun wait(&mut self) Error!Term {
        let status = self.waitStatus().?;
        !.fromWaitStatus(status)
    }

    pub fun tryWait(&mut self) Error! ?Term {
        let status = self.tryWaitStatus().?;
        if status is ?value {
            return !(?.fromWaitStatus(value));
        }
        !null
    }

    pub fun kill(&mut self) Error!Term {
        self.killWith(.Term)
    }

    pub fun killWith(&mut self, signal: Signal) Error!Term {
        if self.state.status() is ?status {
            return !.fromWaitStatus(status);
        }
        os::killWith(self.state.osPid(), signal as i32).withKillContext().?;
        self.wait()
    }
}

extend ChildState {
    fun running(pid: ProcessId) ChildState {
        .{
            kind: ChildStateKind::Running,
            payload: .{ running: .init(pid) },
        }
    }

    fun exited(pid: ProcessId, status: os::WaitStatus) ChildState {
        .{
            kind: ChildStateKind::Exited,
            payload: .{ exited: .init(pid, status) },
        }
    }

    fun pid(&self) ProcessId {
        match self.kind {
            .Running => self.payload.running.pid(),
            .Exited => self.payload.exited.pid(),
        }
    }

    fun osPid(&self) os::ProcessId {
        self.pid().os()
    }

    fun status(&self) ?os::WaitStatus {
        match self.kind {
            .Running => null,
            .Exited => ?self.payload.exited.status(),
        }
    }
}

extend RunningChild {
    fun init(pid: ProcessId) RunningChild {
        .{ pid }
    }

    fun pid(&self) ProcessId {
        self.pid
    }
}

extend ExitedChild {
    fun init(pid: ProcessId, status: os::WaitStatus) ExitedChild {
        .{ pid, status }
    }

    fun pid(&self) ProcessId {
        self.pid
    }

    fun status(&self) os::WaitStatus {
        self.status
    }
}

extend[T] io::Error!T {
    fun withCloseContext(self, stream: StdStream) Error!T {
        self.mapError(&\[stream] cause: io::Error -> .Close { stream, cause })
    }
}

extend[T] os::Error!T {
    fun withWaitContext(self) Error!T {
        self.mapError(&\cause: os::Error -> .Wait(cause.intoError()))
    }
}

extend[T] os::Error!T {
    fun withTryWaitContext(self) Error!T {
        self.mapError(&\cause: os::Error -> .TryWait(cause.intoError()))
    }
}

extend[T] os::Error!T {
    fun withKillContext(self) Error!T {
        self.mapError(&\cause: os::Error -> .Kill(cause.intoError()))
    }
}
