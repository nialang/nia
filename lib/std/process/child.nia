using pkg::io;
using pkg::error;
using pkg::option;
using pkg::result;
using pkg::os;
using pkg::process::types;

using types::{Child, ChildState, ChildStateKind, ChildStatePayload, ChildStderr, ChildStdin, ChildStdout, Error, ExitedChild, ProcessId, RunningChild, Signal, StdStream, SystemError, Term};

pub(pkg) fn processIdFromOs(pid: os::ProcessId) ProcessId {
    ProcessId::fromRaw(pid.raw())
}

extend Child {
    pub(pkg) fn init(pid: os::ProcessId) Child {
        .{
            state: ChildState::running(ProcessId::fromRaw(pid.raw())),
            stdin: null,
            stdout: null,
            stderr: null,
        }
    }

    pub(pkg) fn fromSpawnResult(result: os::SpawnResult) Child {
        .{
            state: ChildState::running(ProcessId::fromRaw(result.pid().raw())),
            stdin: result.stdin().map(&\handle -> .init(handle)),
            stdout: result.stdout().map(&\handle -> .init(handle)),
            stderr: result.stderr().map(&\handle -> .init(handle)),
        }
    }

    pub fn pid(&self) ProcessId {
        self.state.pid()
    }

    pub fn takeStdin(&mut self) ?ChildStdin {
        let pipe = self.stdin;
        self.stdin = null;
        pipe
    }

    pub fn takeStdout(&mut self) ?ChildStdout {
        let pipe = self.stdout;
        self.stdout = null;
        pipe
    }

    pub fn takeStderr(&mut self) ?ChildStderr {
        let pipe = self.stderr;
        self.stderr = null;
        pipe
    }

    pub fn closeStdin(&mut self) Error!() {
        if self.takeStdin() is ?pipe {
            let mut owned = pipe;
            owned.close().withCloseContext(StdStream::Stdin)
        } else {
            !()
        }
    }

    pub fn closeStdout(&mut self) Error!() {
        if self.takeStdout() is ?pipe {
            let mut owned = pipe;
            owned.close().withCloseContext(StdStream::Stdout)
        } else {
            !()
        }
    }

    pub fn closeStderr(&mut self) Error!() {
        if self.takeStderr() is ?pipe {
            let mut owned = pipe;
            owned.close().withCloseContext(StdStream::Stderr)
        } else {
            !()
        }
    }

    pub fn closePipes(&mut self) Error!() {
        let mut cleanup: error::CleanupAccumulator[Error] = .init();
        cleanup.attempt(self.closeStdin());
        cleanup.attempt(self.closeStdout());
        cleanup.attempt(self.closeStderr());
        cleanup.finish()
    }

    fn waitStatus(&mut self) Error!os::WaitStatus {
        if self.state.status() is ?status {
            return !status;
        }
        let pid = self.state.pid();
        self.closeStdin().?;
        let status = os::wait(self.state.osPid()).withWaitContext().?;
        self.state = ChildState::exited(pid, status);
        self.closePipes().?;
        !status
    }

    fn tryWaitStatus(&mut self) Error! ?os::WaitStatus {
        if self.state.status() is ?status {
            return !(?status);
        }
        let pid = self.state.pid();
        let status = os::tryWait(self.state.osPid()).withTryWaitContext().?;
        if status is ?value {
            self.state = ChildState::exited(pid, value);
            self.closePipes().?;
            return !(?value);
        }
        !null
    }

    pub fn wait(&mut self) Error!Term {
        let status = self.waitStatus().?;
        !Term::fromWaitStatus(status)
    }

    pub fn tryWait(&mut self) Error! ?Term {
        let status = self.tryWaitStatus().?;
        if status is ?value {
            return !(?Term::fromWaitStatus(value));
        }
        !null
    }

    pub fn kill(&mut self) Error!Term {
        self.killWith(Signal::Term)
    }

    pub fn killWith(&mut self, signal: Signal) Error!Term {
        if self.state.status() is ?status {
            return !Term::fromWaitStatus(status);
        }
        os::killWith(self.state.osPid(), signal as i32).withKillContext().?;
        self.wait()
    }
}

extend ChildState {
    fn running(pid: ProcessId) ChildState {
        .{
            kind: ChildStateKind::Running,
            payload: ChildStatePayload { running: .init(pid) },
        }
    }

    fn exited(pid: ProcessId, status: os::WaitStatus) ChildState {
        .{
            kind: ChildStateKind::Exited,
            payload: ChildStatePayload { exited: .init(pid, status) },
        }
    }

    fn pid(&self) ProcessId {
        match self.kind {
            .Running => self.payload.running.pid(),
            .Exited => self.payload.exited.pid(),
        }
    }

    fn osPid(&self) os::ProcessId {
        os::ProcessId::fromRaw(self.pid().raw())
    }

    fn status(&self) ?os::WaitStatus {
        match self.kind {
            .Running => null,
            .Exited => ?self.payload.exited.status(),
        }
    }
}

extend RunningChild {
    fn init(pid: ProcessId) RunningChild {
        .{ pid }
    }

    fn pid(&self) ProcessId {
        self.pid
    }
}

extend ExitedChild {
    fn init(pid: ProcessId, status: os::WaitStatus) ExitedChild {
        .{ pid, status }
    }

    fn pid(&self) ProcessId {
        self.pid
    }

    fn status(&self) os::WaitStatus {
        self.status
    }
}

extend ProcessId {
    fn fromRaw(raw: i32) ProcessId {
        .{ raw }
    }

    pub fn raw(&self) i32 {
        self.raw
    }
}

extend[T] io::Error!T {
    fn withCloseContext(self, stream: StdStream) Error!T {
        self.mapError(&\[stream] cause: io::Error -> .Close { stream, cause })
    }
}

extend[T] os::Error!T {
    fn withWaitContext(self) Error!T {
        self.mapError(&\cause: os::Error -> .Wait(SystemError::fromOs(cause)))
    }
}

extend[T] os::Error!T {
    fn withTryWaitContext(self) Error!T {
        self.mapError(&\cause: os::Error -> .TryWait(SystemError::fromOs(cause)))
    }
}

extend[T] os::Error!T {
    fn withKillContext(self) Error!T {
        self.mapError(&\cause: os::Error -> .Kill(SystemError::fromOs(cause)))
    }
}
