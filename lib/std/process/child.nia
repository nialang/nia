using pkg::os;
using pkg::process::types;

using types::{Child, ChildState, ChildStateKind, ChildStatePayload, Error, ExitedChild, RunningChild, Signal, StdStream, Term};

extend Child {
    pub(pkg) fn init(pid: os::ProcessId) Child {
        {
            state: ChildState::running(pid),
            stdin: null,
            stdout: null,
            stderr: null,
        }
    }

    pub(pkg) fn fromSpawnResult(result: os::SpawnResult) Child {
        {
            state: ChildState::running(result.pid()),
            stdin: result.stdin(),
            stdout: result.stdout(),
            stderr: result.stderr(),
        }
    }

    pub fn pid(&self) os::ProcessId {
        self.state.pid()
    }

    pub fn takeStdin(&mut self) ?os::FileHandle {
        let handle = self.stdin;
        self.stdin = null;
        handle
    }

    pub fn takeStdout(&mut self) ?os::FileHandle {
        let handle = self.stdout;
        self.stdout = null;
        handle
    }

    pub fn takeStderr(&mut self) ?os::FileHandle {
        let handle = self.stderr;
        self.stderr = null;
        handle
    }

    pub fn closeStdin(&mut self) Error!void {
        switch self.takeStdin() {
            ?handle => {
                handle.close().asProcessCloseError(StdStream::Stdin)
            },
            null => {
                !{}
            },
        }
    }

    pub fn closeStdout(&mut self) Error!void {
        switch self.takeStdout() {
            ?handle => {
                handle.close().asProcessCloseError(StdStream::Stdout)
            },
            null => {
                !{}
            },
        }
    }

    pub fn closeStderr(&mut self) Error!void {
        switch self.takeStderr() {
            ?handle => {
                handle.close().asProcessCloseError(StdStream::Stderr)
            },
            null => {
                !{}
            },
        }
    }

    pub fn closePipes(&mut self) Error!void {
        self.closeStdin().?;
        self.closeStdout().?;
        self.closeStderr().?;
        !{}
    }

    fn waitStatus(&mut self) Error!os::WaitStatus {
        switch self.state.status() {
            ?status => {
                return !status;
            },
            null => {},
        }
        let pid = self.state.pid();
        self.closeStdin().?;
        let status = os::wait(pid).asProcessWaitError().?;
        self.state = ChildState::exited(pid, status);
        self.closeStdout().?;
        self.closeStderr().?;
        !status
    }

    fn tryWaitStatus(&mut self) Error! ?os::WaitStatus {
        switch self.state.status() {
            ?status => {
                return !(?status);
            },
            null => {},
        }
        let pid = self.state.pid();
        let status = os::tryWait(pid).asProcessTryWaitError().?;
        switch status {
            ?value => {
                self.state = ChildState::exited(pid, value);
                self.closePipes().?;
                !(?value)
            },
            null => {
                !null
            },
        }
    }

    pub fn wait(&mut self) Error!Term {
        let status = self.waitStatus().?;
        !Term::fromWaitStatus(status)
    }

    pub fn tryWait(&mut self) Error! ?Term {
        let status = self.tryWaitStatus().?;
        switch status {
            ?value => {
                !(?Term::fromWaitStatus(value))
            },
            null => {
                !null
            },
        }
    }

    pub fn kill(&mut self) Error!Term {
        self.killWith(Signal::Term)
    }

    pub fn killWith(&mut self, signal: Signal) Error!Term {
        switch self.state.status() {
            ?status => {
                return !Term::fromWaitStatus(status);
            },
            null => {},
        }
        os::killWith(self.state.pid(), signal as i32).asProcessKillError().?;
        self.wait()
    }
}

extend ChildState {
    fn running(pid: os::ProcessId) ChildState {
        {
            kind: ChildStateKind::Running,
            payload: { running: RunningChild::init(pid) },
        }
    }

    fn exited(pid: os::ProcessId, status: os::WaitStatus) ChildState {
        {
            kind: ChildStateKind::Exited,
            payload: { exited: ExitedChild::init(pid, status) },
        }
    }

    fn pid(&self) os::ProcessId {
        switch self.kind {
            ChildStateKind::Running => self.payload.running.pid(),
            ChildStateKind::Exited => self.payload.exited.pid(),
        }
    }

    fn status(&self) ?os::WaitStatus {
        switch self.kind {
            ChildStateKind::Running => null,
            ChildStateKind::Exited => ?self.payload.exited.status(),
        }
    }
}

extend RunningChild {
    fn init(pid: os::ProcessId) RunningChild {
        { pid: pid }
    }

    fn pid(&self) os::ProcessId {
        self.pid
    }
}

extend ExitedChild {
    fn init(pid: os::ProcessId, status: os::WaitStatus) ExitedChild {
        { pid: pid, status: status }
    }

    fn pid(&self) os::ProcessId {
        self.pid
    }

    fn status(&self) os::WaitStatus {
        self.status
    }
}

extend[T] os::Error!T {
    fn asProcessCloseError(self, stream: StdStream) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Close { stream: stream, cause: cause }!,
        }
    }
}

extend[T] os::Error!T {
    fn asProcessWaitError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Wait(cause)!,
        }
    }
}

extend[T] os::Error!T {
    fn asProcessTryWaitError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::TryWait(cause)!,
        }
    }
}

extend[T] os::Error!T {
    fn asProcessKillError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Kill(cause)!,
        }
    }
}
