// Command configuration and spawn attempts.
//
// `Command::spawn` returns a `SpawnAttempt` owner. `finish` tries every argv,
// envp, and path staging release and returns a cleanup error while keeping the
// pending `Child` or spawn error attached for retry; only complete cleanup
// exposes that outcome. Custom-allocator attempts require the same allocator
// on each retry. Owner-discarding `run` shortcuts are not part of the API.

using root::collections;
using root::builtin;
using root::error;
using root::fs;
using root::mem;
using root::os;
using root::process::convert;
using root::process::types;

using types::{
    AllocatorSpawnAttempt,
    Child,
    Command,
    Env,
    EnvEntry,
    Error,
    SpawnAttempt,
    SpawnError,
    SpawnOutcome,
    SpawnStorage,
    StdIo,
};

extend Command {
    /// Describes a program to run. A path containing a separator names that
    /// file, relative to the child's working directory. A bare name is
    /// searched in the `PATH` of the child's environment; on Windows a name
    /// without an extension also tries each `PATHEXT` extension.
    pub fun init(path: fs::PathView, env: Env) Command {
        .{
            path,
            arguments: null,
            environment: .Inherit(env),
            stdin: .Inherit,
            stdout: .Inherit,
            stderr: .Inherit,
            cwd: null,
        }
    }

    pub fun path(&self) fs::PathView {
        self.path
    }

    pub fun arguments(&self) ?&[&[char]] {
        self.arguments
    }

    pub fun stdin(&self) StdIo {
        self.stdin
    }

    pub fun stdout(&self) StdIo {
        self.stdout
    }

    pub fun stderr(&self) StdIo {
        self.stderr
    }

    pub fun cwd(&self) ?fs::PathView {
        self.cwd
    }

    pub fun withArguments(self, arguments: &[&[char]]) Command {
        .{
            path: self.path,
            arguments: ?arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fun withStdin(self, behavior: StdIo) Command {
        .{
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: behavior,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fun withStdout(self, behavior: StdIo) Command {
        .{
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: behavior,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fun withStderr(self, behavior: StdIo) Command {
        .{
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: behavior,
            cwd: self.cwd,
        }
    }

    pub fun withCwd(self, cwd: fs::PathView) Command {
        .{
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: ?cwd,
        }
    }

    pub fun withEnvironment(self, entries: &[EnvEntry]) Command {
        .{
            path: self.path,
            arguments: self.arguments,
            environment: .Exact(entries),
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fun withoutEnvironment(self) Command {
        .{
            path: self.path,
            arguments: self.arguments,
            environment: .Empty,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fun spawn(&self) SpawnAttempt {
        .start(self)
    }

    pub fun spawnWithAllocator(&self, allocator: &mut mem::Allocator) AllocatorSpawnAttempt {
        .start(self, allocator)
    }

    fun executeSpawn(
        &self,
        allocator: &mut mem::Allocator,
        storage: &mut SpawnStorage,
    ) Error!() {
        if self.environment is .Exact(entries) {
            validateEnvironment(entries).?;
        }

        appendPath(allocator, &mut storage.argumentBytes, self.path).?;
        if self.arguments is ?arguments {
            let mut argumentIndex: usize = 0;
            for &argument in arguments {
                appendArgument(allocator, &mut storage.argumentBytes, argument, argumentIndex).?;
                argumentIndex += 1;
            }
        }

        let bytes = storage.argumentBytes.asSlice();
        appendCStringPointers(allocator, bytes, &mut storage.argv).?;

        let emptyEnvp: [&u8; 1] = [0usize as &u8];
        let envp = match self.environment {
            .Inherit(env) => env.rawEnvp(),
            .Exact(entries) => {
                if entries.isEmpty() {
                    &emptyEnvp[0]
                } else {
                    for &entry in entries {
                        appendEnvironmentEntry(allocator, &mut storage.environmentBytes, entry).?;
                    }
                    appendCStringPointers(
                        allocator,
                        storage.environmentBytes.asSlice(),
                        &mut storage.environmentPointers,
                    ).?;
                    storage.environmentPointers.asSlice().ptr()
                }
            },
            .Empty => &emptyEnvp[0],
        };

        let mut options: os::SpawnOptions = .init();
        options.setStdin(self.stdin.asOsStdio()).withSpawnSetupContext().?;
        options.setStdout(self.stdout.asOsStdio()).withSpawnSetupContext().?;
        options.setStderr(self.stderr.asOsStdio()).withSpawnSetupContext().?;
        if self.cwd is ?cwd {
            appendPath(allocator, &mut storage.cwdBytes, cwd).?;
            options.setCwd(storage.cwdBytes.asSlice().ptr());
        }
        storage.nativeSpawn = ?os::spawn(bytes.ptr(), storage.argv.asSlice().ptr(), envp, options);
        !()
    }
}

extend SpawnStorage {
    fun init() SpawnStorage {
        .{
            argumentBytes: .init(),
            argv: .init(),
            environmentBytes: .init(),
            environmentPointers: .init(),
            cwdBytes: .init(),
            nativeSpawn: null,
            outcome: null,
        }
    }

    fun execute(&mut self, command: &Command, allocator: &mut mem::Allocator) () {
        if command.executeSpawn(allocator, self) is cause! {
            self.outcome = ?.Failure(cause);
        }
    }

    fun finish(&mut self, allocator: &mut mem::Allocator) Error!Child {
        let nativeResult = self.finishNativeSpawn();
        let mut cleanup: error::CleanupAccumulator[mem::Error] = .init();
        cleanup.attempt(self.cwdBytes.deinit(allocator));
        cleanup.attempt(self.environmentPointers.deinit(allocator));
        cleanup.attempt(self.environmentBytes.deinit(allocator));
        cleanup.attempt(self.argv.deinit(allocator));
        cleanup.attempt(self.argumentBytes.deinit(allocator));
        cleanup.finish().?;
        nativeResult.?;
        let outcome = match self.outcome {
            ?value => value,
            null => return .SpawnSetup(.Invalid)!,
        };
        self.outcome = null;
        match outcome {
            .Success(child) => !child,
            .Failure(cause) => cause!,
        }
    }

    fun finishNativeSpawn(&mut self) Error!() {
        if self.nativeSpawn is ?value {
            let mut attempt = value;
            self.nativeSpawn = null;
            match attempt.finish() {
                !result => {
                    self.outcome = ?.Success(Child::fromSpawnResult(result));
                },
                .Reap { stage, primary, cause, pid }! => {
                    self.nativeSpawn = ?attempt;
                    let converted: SpawnError = os::SpawnError::Reap {
                        stage,
                        primary,
                        cause,
                        pid,
                    }.intoError();
                    return .Spawn(converted)!;
                },
                cause! => {
                    self.outcome = ?.Failure(.Spawn(cause.intoError()));
                },
            }
        }
        !()
    }
}

extend SpawnAttempt {
    fun start(command: &Command) SpawnAttempt {
        let mut attempt: SpawnAttempt = .{
            allocator: .init(),
            storage: .init(),
        };
        let allocator: &mut mem::Allocator = &mut attempt.allocator;
        _ = attempt.storage.execute(command, allocator);
        attempt
    }

    pub fun finish(&mut self) Error!Child {
        let allocator: &mut mem::Allocator = &mut self.allocator;
        self.storage.finish(allocator)
    }
}

extend AllocatorSpawnAttempt {
    fun start(command: &Command, allocator: &mut mem::Allocator) AllocatorSpawnAttempt {
        let mut attempt: AllocatorSpawnAttempt = .{ storage: .init() };
        _ = attempt.storage.execute(command, allocator);
        attempt
    }

    pub fun finish(&mut self, allocator: &mut mem::Allocator) Error!Child {
        self.storage.finish(allocator)
    }
}

extend StdIo {
    fun asOsStdio(self) os::StdIo {
        match self {
            .Inherit => .Inherit,
            .Ignore => .Ignore,
            .Pipe => .Pipe,
        }
    }
}

fun appendArgument(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    argument: &[char],
    argumentIndex: usize,
) Error!() {
    appendText(
        allocator,
        bytes,
        argument,
        .ArgumentContainsNul(argumentIndex),
    )
}

fun appendPath(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    path: fs::PathView,
) Error!() {
    appendText(
        allocator,
        bytes,
        path.text(),
        .Path(.ContainsNul),
    )
}

fun appendText(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    text: &[char],
    containsNul: Error,
) Error!() {
    let mut byteLen: usize = 1;
    for &ch in text {
        if ch.codepoint() == 0 {
            return containsNul!;
        }
        byteLen = match byteLen.checkedAdd(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return .Allocation(.OutOfMemory)!,
        };
    }
    bytes.reserve(allocator, byteLen).?;
    for &ch in text {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !()
}

fun validateEnvironment(entries: &[EnvEntry]) Error!() {
    let mut index: usize = 0;
    for &entry in entries {
        if entry.name().isEmpty() {
            return .Environment { index: index, cause: .EmptyName }!;
        }
        for &ch in entry.name() {
            if ch.codepoint() == 0 {
                return .Environment { index: index, cause: .NameContainsNul }!;
            }
            if ch == '=' {
                return .Environment { index: index, cause: .NameContainsEquals }!;
            }
        }
        for &ch in entry.value() {
            if ch.codepoint() == 0 {
                return .Environment { index: index, cause: .ValueContainsNul }!;
            }
        }
        let mut priorIndex: usize = 0;
        for &prior in &entries[0..index] {
            if entry.name().equals(prior.name()) {
                return .Environment {
                    index: index,
                    cause: .DuplicateName(priorIndex),
                }!;
            }
            priorIndex += 1;
        }
        index += 1;
    }
    !()
}

fun appendEnvironmentEntry(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    entry: EnvEntry,
) Error!() {
    let mut byteLen: usize = 1;
    for &ch in entry.name() {
        byteLen = match byteLen.checkedAdd(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return .Allocation(.OutOfMemory)!,
        };
    }
    for &ch in entry.value() {
        byteLen = match byteLen.checkedAdd(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return .Allocation(.OutOfMemory)!,
        };
    }
    let needed = match byteLen.checkedAdd(1) {
        ?value => value,
        null => return .Allocation(.OutOfMemory)!,
    };
    bytes.reserve(allocator, needed).?;
    for &ch in entry.name() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(b'=');
    for &ch in entry.value() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !()
}

fun appendCStringPointers(
    allocator: &mut mem::Allocator,
    bytes: &[u8],
    pointers: &mut collections::ArrayList[&u8],
) Error!() {
    // Callers finish a non-empty arena of adjacent NUL-terminated strings
    // before taking any pointers into it.
    let mut start: usize = 0;
    while start < bytes.len() {
        pointers.push(allocator, &bytes[start]).?;
        while bytes[start] != 0 {
            start += 1;
        }
        start += 1;
    }
    pointers.push(allocator, 0usize as &u8).?;
    !()
}

extend[T] os::Error!T {
    fun withSpawnSetupContext(self) Error!T {
        self.mapError(\cause: os::Error -> .SpawnSetup(cause.intoError()))
    }
}

extend mem::Error : builtin::IntoError[Error] {
    const fun intoError(self) Error {
        Error::Allocation(self)
    }
}
