using pkg::collections;
using pkg::cstring;
using pkg::fs;
using pkg::mem;
using pkg::os;
using pkg::process::child;
using pkg::process::types;
using pkg::slice;
using pkg::unicode;

using types::{Child, Command, CommandEnvironment, Env, EnvEntry, EnvEntryError, Error, SpawnError, StdIo, SystemError, Term};

extend Command {
    pub fn init(path: fs::PathView, env: Env) Command {
        Self {
            path: path,
            arguments: null,
            environment: CommandEnvironment::Inherit(env),
            stdin: StdIo::Inherit,
            stdout: StdIo::Inherit,
            stderr: StdIo::Inherit,
            cwd: null,
        }
    }

    pub fn path(&self) fs::PathView {
        self.path
    }

    pub fn arguments(&self) ?&[&[char]] {
        self.arguments
    }

    pub fn stdin(&self) StdIo {
        self.stdin
    }

    pub fn stdout(&self) StdIo {
        self.stdout
    }

    pub fn stderr(&self) StdIo {
        self.stderr
    }

    pub fn cwd(&self) ?fs::PathView {
        self.cwd
    }

    pub fn withArguments(self, arguments: &[&[char]]) Command {
        Self {
            path: self.path,
            arguments: ?arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdin(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: behavior,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdout(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: behavior,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStderr(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: behavior,
            cwd: self.cwd,
        }
    }

    pub fn withCwd(self, cwd: fs::PathView) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: ?cwd,
        }
    }

    pub fn withEnvironment(self, entries: &[EnvEntry]) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: CommandEnvironment::Exact(entries),
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withoutEnvironment(self) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: CommandEnvironment::Empty,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn spawn(&self) Error!Child {
        let mut pageAllocator = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut pageAllocator;
        self.spawnWithAllocator(allocator)
    }

    pub fn spawnWithAllocator(&self, allocator: &mut mem::Allocator) Error!Child {
        switch self.environment {
            CommandEnvironment::Exact(entries) => validateEnvironment(entries).?,
            CommandEnvironment::Inherit(env) => { _ = env; },
            CommandEnvironment::Empty => {},
        }

        let mut argumentBytes = collections::ArrayList[u8]::init();
        defer argumentBytes.deinit(allocator).asProcessAllocationError().?;
        appendPath(allocator, &mut argumentBytes, self.path).?;
        switch self.arguments {
            ?arguments => {
                let mut argumentIndex: usize = 0;
                for &argument in arguments {
                    appendArgument(allocator, &mut argumentBytes, argument, argumentIndex).?;
                    argumentIndex += 1;
                }
            },
            null => {},
        }

        let mut argv = collections::ArrayList[&u8]::init();
        defer argv.deinit(allocator).asProcessAllocationError().?;
        let bytes = argumentBytes.asSlice();
        appendCStringPointers(allocator, bytes, &mut argv).?;

        let mut environmentBytes = collections::ArrayList[u8]::init();
        defer environmentBytes.deinit(allocator).asProcessAllocationError().?;
        let mut environmentPointers = collections::ArrayList[&u8]::init();
        defer environmentPointers.deinit(allocator).asProcessAllocationError().?;
        let emptyEnvp: [&u8; 1] = [0usize as &u8];
        let envp = switch self.environment {
            CommandEnvironment::Inherit(env) => env.rawEnvp(),
            CommandEnvironment::Exact(entries) => {
                if entries.isEmpty() {
                    &emptyEnvp[0]
                } else {
                    for &entry in entries {
                        appendEnvironmentEntry(allocator, &mut environmentBytes, entry).?;
                    }
                    appendCStringPointers(
                        allocator,
                        environmentBytes.asSlice(),
                        &mut environmentPointers,
                    ).?;
                    environmentPointers.asSlice().ptr()
                }
            },
            CommandEnvironment::Empty => &emptyEnvp[0],
        };

        let mut options = os::SpawnOptions::init();
        options.setStdin(self.stdin.asOsStdio()).asCommandSpawnSetupError().?;
        options.setStdout(self.stdout.asOsStdio()).asCommandSpawnSetupError().?;
        options.setStderr(self.stderr.asOsStdio()).asCommandSpawnSetupError().?;
        let mut cwdBytes = collections::ArrayList[u8]::init();
        defer cwdBytes.deinit(allocator).asProcessAllocationError().?;
        switch self.cwd {
            ?cwd => {
                appendPath(allocator, &mut cwdBytes, cwd).?;
                options.setCwd(cwdBytes.asSlice().ptr());
            },
            null => {},
        }
        spawnWithOptions(bytes.ptr(), argv.asSlice().ptr(), envp, options)
    }

    pub fn run(&self) Error!Term {
        let mut child = self.spawn().?;
        child.wait()
    }

    pub fn runWithAllocator(&self, allocator: &mut mem::Allocator) Error!Term {
        let mut child = self.spawnWithAllocator(allocator).?;
        child.wait()
    }
}

extend StdIo {
    fn asOsStdio(self) os::StdIo {
        switch self {
            StdIo::Inherit => os::StdIo::Inherit,
            StdIo::Ignore => os::StdIo::Ignore,
            StdIo::Pipe => os::StdIo::Pipe,
        }
    }
}

pub fn spawnRaw(path: &u8, argv: &&u8, envp: &&u8) Error!Child {
    let pid = switch os::spawnRaw(path, argv, envp) {
        !value => value,
        cause! => return commandSpawnError(cause)!,
    };
    !Child::init(pid)
}

fn spawnWithOptions(path: &u8, argv: &&u8, envp: &&u8, options: os::SpawnOptions) Error!Child {
    let result = switch os::spawn(path, argv, envp, options) {
        !value => value,
        cause! => return commandSpawnError(cause)!,
    };
    !Child::fromSpawnResult(result)
}

fn appendArgument(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    argument: &[char],
    argumentIndex: usize,
) Error!() {
    let mut owned = switch cstring::CString::fromText(allocator, argument) {
        !value => value,
        cause! => switch cause {
            cstring::CStringBuildError::ContainsNul => return Error::ArgumentContainsNul(argumentIndex)!,
            cstring::CStringBuildError::Allocation(error) => return Error::Allocation(error)!,
        },
    };
    defer owned.deinit(allocator).asProcessAllocationError().?;
    bytes.appendSlice(allocator, owned.nulTerminatedBytes()).asProcessAllocationError().?;
    !()
}

fn appendPath(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    path: fs::PathView,
) Error!() {
    let mut owned = switch cstring::CString::fromText(allocator, path.text()) {
        !value => value,
        cstring::CStringBuildError::ContainsNul! => return Error::Path(fs::PathError::ContainsNul)!,
        cstring::CStringBuildError::Allocation(cause)! => return Error::Allocation(cause)!,
    };
    defer owned.deinit(allocator).asProcessAllocationError().?;
    bytes.appendSlice(allocator, owned.nulTerminatedBytes()).asProcessAllocationError().?;
    !()
}

fn validateEnvironment(entries: &[EnvEntry]) Error!() {
    let mut index: usize = 0;
    for &entry in entries {
        if entry.name().isEmpty() {
            return Error::Environment { index: index, cause: EnvEntryError::EmptyName }!;
        }
        for &ch in entry.name() {
            if ch.codepoint() == 0 {
                return Error::Environment { index: index, cause: EnvEntryError::NameContainsNul }!;
            }
            if ch == '=' {
                return Error::Environment { index: index, cause: EnvEntryError::NameContainsEquals }!;
            }
        }
        for &ch in entry.value() {
            if ch.codepoint() == 0 {
                return Error::Environment { index: index, cause: EnvEntryError::ValueContainsNul }!;
            }
        }
        let mut priorIndex: usize = 0;
        for &prior in &entries[0..index] {
            if entry.name().equals(prior.name()) {
                return Error::Environment {
                    index: index,
                    cause: EnvEntryError::DuplicateName(priorIndex),
                }!;
            }
            priorIndex += 1;
        }
        index += 1;
    }
    !()
}

fn appendEnvironmentEntry(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    entry: EnvEntry,
) Error!() {
    let mut byteLen: usize = 1;
    for &ch in entry.name() {
        byteLen = switch byteLen.checked_add(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    for &ch in entry.value() {
        byteLen = switch byteLen.checked_add(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    let needed = switch byteLen.checked_add(1) {
        ?value => value,
        null => return Error::Allocation(mem::Error::OutOfMemory)!,
    };
    bytes.reserve(allocator, needed).asProcessAllocationError().?;
    for &ch in entry.name() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(b'=');
    for &ch in entry.value() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !()
}

fn appendCStringPointers(
    allocator: &mut mem::Allocator,
    bytes: &[u8],
    pointers: &mut collections::ArrayList[&u8],
) Error!() {
    // Callers finish a non-empty arena of adjacent NUL-terminated strings
    // before taking any pointers into it.
    let mut start: usize = 0;
    while start < bytes.len() {
        pointers.push(allocator, &bytes[start]).asProcessAllocationError().?;
        while bytes[start] != 0 {
            start += 1;
        }
        start += 1;
    }
    pointers.push(allocator, 0usize as &u8).asProcessAllocationError().?;
    !()
}

fn commandSpawnError(cause: os::SpawnError) Error {
    switch cause {
        os::SpawnError::Setup(system) => {
            Error::Spawn(SpawnError::Setup(SystemError::fromOs(system)))
        },
        os::SpawnError::Stdio(system) => {
            Error::Spawn(SpawnError::Stdio(SystemError::fromOs(system)))
        },
        os::SpawnError::Cwd(system) => {
            Error::Spawn(SpawnError::Cwd(SystemError::fromOs(system)))
        },
        os::SpawnError::Exec(system) => {
            Error::Spawn(SpawnError::Exec(SystemError::fromOs(system)))
        },
    }
}

extend[T] os::Error!T {
    fn asCommandSpawnSetupError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::SpawnSetup(SystemError::fromOs(cause))!,
        }
    }
}

extend[T] mem::Error!T {
    fn asProcessAllocationError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Allocation(cause)!,
        }
    }
}
