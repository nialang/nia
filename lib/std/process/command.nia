using pkg::collections;
using pkg::fs;
using pkg::mem;
using pkg::os;
using pkg::process::child;
using pkg::process::types;
using pkg::unicode;

using types::{Child, Command, Env, Error, StdIo, Term};

extend Command {
    pub fn init(path: fs::PathView, env: Env) Command {
        {
            path: path,
            arguments: null,
            env: env,
            stdin: StdIo::Inherit,
            stdout: StdIo::Inherit,
            stderr: StdIo::Inherit,
            cwd: null,
        }
    }

    pub fn path(&self) fs::PathView {
        self.path
    }

    pub fn arguments(&self) ?&[&[char]] {
        self.arguments
    }

    pub fn env(&self) Env {
        self.env
    }

    pub fn stdin(&self) StdIo {
        self.stdin
    }

    pub fn stdout(&self) StdIo {
        self.stdout
    }

    pub fn stderr(&self) StdIo {
        self.stderr
    }

    pub fn cwd(&self) ?fs::PathView {
        self.cwd
    }

    pub fn withArguments(self, arguments: &[&[char]]) Command {
        {
            path: self.path,
            arguments: ?arguments,
            env: self.env,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdin(self, behavior: StdIo) Command {
        {
            path: self.path,
            arguments: self.arguments,
            env: self.env,
            stdin: behavior,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdout(self, behavior: StdIo) Command {
        {
            path: self.path,
            arguments: self.arguments,
            env: self.env,
            stdin: self.stdin,
            stdout: behavior,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStderr(self, behavior: StdIo) Command {
        {
            path: self.path,
            arguments: self.arguments,
            env: self.env,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: behavior,
            cwd: self.cwd,
        }
    }

    pub fn withCwd(self, cwd: fs::PathView) Command {
        {
            path: self.path,
            arguments: self.arguments,
            env: self.env,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: ?cwd,
        }
    }

    pub fn spawn(&self) Error!Child {
        let mut pageAllocator = mem::PageAllocator::init();
        let allocator: &mut mem::Allocator = &mut pageAllocator;
        self.spawnWithAllocator(allocator)
    }

    pub fn spawnWithAllocator(&self, allocator: &mut mem::Allocator) Error!Child {
        let mut pathStorage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        let encodedPath = self.path.encode(&mut pathStorage[..]).asProcessPathError().?;

        let mut argumentBytes = collections::ArrayList[u8]::init();
        defer argumentBytes.deinit(allocator).asProcessAllocationError().?;
        argumentBytes.appendSlice(allocator, encodedPath.nulTerminatedBytes()).asProcessAllocationError().?;
        switch self.arguments {
            ?arguments => {
                let mut argumentIndex: usize = 0;
                for &argument in arguments {
                    appendArgument(allocator, &mut argumentBytes, argument, argumentIndex).?;
                    argumentIndex += 1;
                }
            },
            null => {},
        }

        let mut argv = collections::ArrayList[&u8]::init();
        defer argv.deinit(allocator).asProcessAllocationError().?;
        let bytes = argumentBytes.asSlice();
        let mut start: usize = 0;
        while start < bytes.len() {
            argv.push(allocator, &bytes[start]).asProcessAllocationError().?;
            while bytes[start] != 0 {
                start += 1;
            }
            start += 1;
        }
        argv.push(allocator, 0usize as &u8).asProcessAllocationError().?;

        let mut options = os::SpawnOptions::init();
        options.set_stdin(self.stdin.asOsStdio()).asProcessSpawnSetupError().?;
        options.set_stdout(self.stdout.asOsStdio()).asProcessSpawnSetupError().?;
        options.set_stderr(self.stderr.asOsStdio()).asProcessSpawnSetupError().?;
        let mut cwdStorage: [os::max_path_bytes]u8 = [_]u8[0; os::max_path_bytes];
        switch self.cwd {
            ?cwd => {
                let encodedCwd = cwd.encode(&mut cwdStorage[..]).asProcessPathError().?;
                options.set_cwd(encodedCwd.ptr());
            },
            null => {},
        }
        spawnWithOptions(bytes.ptr(), argv.asSlice().ptr(), self.env.rawEnvp(), options)
    }

    pub fn run(&self) Error!Term {
        let mut child = self.spawn().?;
        child.wait()
    }

    pub fn runWithAllocator(&self, allocator: &mut mem::Allocator) Error!Term {
        let mut child = self.spawnWithAllocator(allocator).?;
        child.wait()
    }
}

extend StdIo {
    fn asOsStdio(self) os::StdIo {
        switch self {
            StdIo::Inherit => os::StdIo::Inherit,
            StdIo::Ignore => os::StdIo::Ignore,
            StdIo::Pipe => os::StdIo::Pipe,
        }
    }
}

pub fn spawnRaw(path: &u8, argv: &&u8, envp: &&u8) Error!Child {
    let pid = os::spawn_raw(path, argv, envp).asProcessSpawnError().?;
    !Child::init(pid)
}

fn spawnWithOptions(path: &u8, argv: &&u8, envp: &&u8, options: os::SpawnOptions) Error!Child {
    let result = os::spawn(path, argv, envp, options).asProcessSpawnError().?;
    !Child::fromSpawnResult(result)
}

fn appendArgument(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    argument: &[char],
    argumentIndex: usize,
) Error!void {
    let mut byteLen: usize = 0;
    for &ch in argument {
        if ch.codepoint() == 0 {
            return Error::ArgumentContainsNul(argumentIndex)!;
        }
        byteLen = switch byteLen.checked_add(ch.encode_utf8().len()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    let needed = switch byteLen.checked_add(1) {
        ?value => value,
        null => return Error::Allocation(mem::Error::OutOfMemory)!,
    };
    bytes.reserve(allocator, needed).asProcessAllocationError().?;
    for &ch in argument {
        bytes.appendSliceAssumeCapacity(ch.encode_utf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !{}
}

extend[T] os::SpawnError!T {
    fn asProcessSpawnError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Spawn(cause)!,
        }
    }
}

extend[T] os::Error!T {
    fn asProcessSpawnSetupError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::SpawnSetup(cause)!,
        }
    }
}

extend[T] fs::PathError!T {
    fn asProcessPathError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Path(cause)!,
        }
    }
}

extend[T] mem::Error!T {
    fn asProcessAllocationError(self) Error!T {
        switch self {
            !value => !value,
            cause! => Error::Allocation(cause)!,
        }
    }
}
