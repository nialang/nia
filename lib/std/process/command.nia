using pkg::collections;
using pkg::fs;
using pkg::mem;
using pkg::os;
using pkg::process::child;
using pkg::process::types;
using pkg::slice;
using pkg::unicode;

using types::{
    AllocatorSpawnAttempt,
    Child,
    Command,
    CommandEnvironment,
    Env,
    EnvEntry,
    EnvEntryError,
    Error,
    SpawnAttempt,
    SpawnError,
    SpawnOutcome,
    SpawnStorage,
    StdIo,
    SystemError,
};

extend Command {
    pub fn init(path: fs::PathView, env: Env) Command {
        Self {
            path: path,
            arguments: null,
            environment: CommandEnvironment::Inherit(env),
            stdin: StdIo::Inherit,
            stdout: StdIo::Inherit,
            stderr: StdIo::Inherit,
            cwd: null,
        }
    }

    pub fn path(&self) fs::PathView {
        self.path
    }

    pub fn arguments(&self) ?&[&[char]] {
        self.arguments
    }

    pub fn stdin(&self) StdIo {
        self.stdin
    }

    pub fn stdout(&self) StdIo {
        self.stdout
    }

    pub fn stderr(&self) StdIo {
        self.stderr
    }

    pub fn cwd(&self) ?fs::PathView {
        self.cwd
    }

    pub fn withArguments(self, arguments: &[&[char]]) Command {
        Self {
            path: self.path,
            arguments: ?arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdin(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: behavior,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdout(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: behavior,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStderr(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: behavior,
            cwd: self.cwd,
        }
    }

    pub fn withCwd(self, cwd: fs::PathView) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: ?cwd,
        }
    }

    pub fn withEnvironment(self, entries: &[EnvEntry]) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: CommandEnvironment::Exact(entries),
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withoutEnvironment(self) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: CommandEnvironment::Empty,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn spawn(&self) SpawnAttempt {
        SpawnAttempt::start(self)
    }

    pub fn spawnWithAllocator(&self, allocator: &mut mem::Allocator) AllocatorSpawnAttempt {
        AllocatorSpawnAttempt::start(self, allocator)
    }

    fn executeSpawn(
        &self,
        allocator: &mut mem::Allocator,
        storage: &mut SpawnStorage,
    ) Error!Child {
        match self.environment {
            CommandEnvironment::Exact(entries) => validateEnvironment(entries).?,
            CommandEnvironment::Inherit(env) => { _ = env; },
            CommandEnvironment::Empty => {},
        }

        appendPath(allocator, &mut storage.argumentBytes, self.path).?;
        match self.arguments {
            ?arguments => {
                let mut argumentIndex: usize = 0;
                for &argument in arguments {
                    appendArgument(allocator, &mut storage.argumentBytes, argument, argumentIndex).?;
                    argumentIndex += 1;
                }
            },
            null => {},
        }

        let bytes = storage.argumentBytes.asSlice();
        appendCStringPointers(allocator, bytes, &mut storage.argv).?;

        let emptyEnvp: [&u8; 1] = [0usize as &u8];
        let envp = match self.environment {
            CommandEnvironment::Inherit(env) => env.rawEnvp(),
            CommandEnvironment::Exact(entries) => {
                if entries.isEmpty() {
                    &emptyEnvp[0]
                } else {
                    for &entry in entries {
                        appendEnvironmentEntry(allocator, &mut storage.environmentBytes, entry).?;
                    }
                    appendCStringPointers(
                        allocator,
                        storage.environmentBytes.asSlice(),
                        &mut storage.environmentPointers,
                    ).?;
                    storage.environmentPointers.asSlice().ptr()
                }
            },
            CommandEnvironment::Empty => &emptyEnvp[0],
        };

        let mut options = os::SpawnOptions::init();
        options.setStdin(self.stdin.asOsStdio()).asCommandSpawnSetupError().?;
        options.setStdout(self.stdout.asOsStdio()).asCommandSpawnSetupError().?;
        options.setStderr(self.stderr.asOsStdio()).asCommandSpawnSetupError().?;
        match self.cwd {
            ?cwd => {
                appendPath(allocator, &mut storage.cwdBytes, cwd).?;
                options.setCwd(storage.cwdBytes.asSlice().ptr());
            },
            null => {},
        }
        spawnWithOptions(bytes.ptr(), storage.argv.asSlice().ptr(), envp, options)
    }
}

extend SpawnStorage {
    fn init() SpawnStorage {
        Self {
            argumentBytes: collections::ArrayList[u8]::init(),
            argv: collections::ArrayList[&u8]::init(),
            environmentBytes: collections::ArrayList[u8]::init(),
            environmentPointers: collections::ArrayList[&u8]::init(),
            cwdBytes: collections::ArrayList[u8]::init(),
            outcome: null,
        }
    }

    fn execute(&mut self, command: &Command, allocator: &mut mem::Allocator) () {
        self.outcome = ?match command.executeSpawn(allocator, self) {
            !child => SpawnOutcome::Success(child),
            cause! => SpawnOutcome::Failure(cause),
        };
    }

    fn finish(&mut self, allocator: &mut mem::Allocator) Error!Child {
        let mut firstError: ?mem::Error = null;
        rememberSpawnCleanupError(&mut firstError, self.cwdBytes.deinit(allocator));
        rememberSpawnCleanupError(&mut firstError, self.environmentPointers.deinit(allocator));
        rememberSpawnCleanupError(&mut firstError, self.environmentBytes.deinit(allocator));
        rememberSpawnCleanupError(&mut firstError, self.argv.deinit(allocator));
        rememberSpawnCleanupError(&mut firstError, self.argumentBytes.deinit(allocator));
        if firstError is ?cause {
            return Error::Allocation(cause)!;
        }
        let outcome = match self.outcome {
            ?value => value,
            null => return Error::SpawnSetup(SystemError::Invalid)!,
        };
        self.outcome = null;
        match outcome {
            SpawnOutcome::Success(child) => !child,
            SpawnOutcome::Failure(cause) => cause!,
        }
    }
}

extend SpawnAttempt {
    fn start(command: &Command) SpawnAttempt {
        let mut attempt = Self {
            allocator: mem::PageAllocator::init(),
            storage: SpawnStorage::init(),
        };
        let allocator: &mut mem::Allocator = &mut attempt.allocator;
        attempt.storage.execute(command, allocator);
        attempt
    }

    pub fn finish(&mut self) Error!Child {
        let allocator: &mut mem::Allocator = &mut self.allocator;
        self.storage.finish(allocator)
    }
}

extend AllocatorSpawnAttempt {
    fn start(command: &Command, allocator: &mut mem::Allocator) AllocatorSpawnAttempt {
        let mut attempt = Self { storage: SpawnStorage::init() };
        attempt.storage.execute(command, allocator);
        attempt
    }

    pub fn finish(&mut self, allocator: &mut mem::Allocator) Error!Child {
        self.storage.finish(allocator)
    }
}

fn rememberSpawnCleanupError(firstError: &mut ?mem::Error, result: mem::Error!()) () {
    match result {
        !ok => {
            _ = ok;
        },
        cause! => {
            if firstError.* is null {
                firstError.* = ?cause;
            }
        },
    }
}

extend StdIo {
    fn asOsStdio(self) os::StdIo {
        match self {
            StdIo::Inherit => os::StdIo::Inherit,
            StdIo::Ignore => os::StdIo::Ignore,
            StdIo::Pipe => os::StdIo::Pipe,
        }
    }
}

fn spawnWithOptions(path: &u8, argv: &&u8, envp: &&u8, options: os::SpawnOptions) Error!Child {
    let result = match os::spawn(path, argv, envp, options) {
        !value => value,
        cause! => return commandSpawnError(cause)!,
    };
    !Child::fromSpawnResult(result)
}

fn appendArgument(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    argument: &[char],
    argumentIndex: usize,
) Error!() {
    appendText(
        allocator,
        bytes,
        argument,
        Error::ArgumentContainsNul(argumentIndex),
    )
}

fn appendPath(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    path: fs::PathView,
) Error!() {
    appendText(
        allocator,
        bytes,
        path.text(),
        Error::Path(fs::PathError::ContainsNul),
    )
}

fn appendText(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    text: &[char],
    containsNul: Error,
) Error!() {
    let mut byteLen: usize = 1;
    for &ch in text {
        if ch.codepoint() == 0 {
            return containsNul!;
        }
        byteLen = match byteLen.checked_add(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    bytes.reserve(allocator, byteLen).asProcessAllocationError().?;
    for &ch in text {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !()
}

fn validateEnvironment(entries: &[EnvEntry]) Error!() {
    let mut index: usize = 0;
    for &entry in entries {
        if entry.name().isEmpty() {
            return Error::Environment { index: index, cause: EnvEntryError::EmptyName }!;
        }
        for &ch in entry.name() {
            if ch.codepoint() == 0 {
                return Error::Environment { index: index, cause: EnvEntryError::NameContainsNul }!;
            }
            if ch == '=' {
                return Error::Environment { index: index, cause: EnvEntryError::NameContainsEquals }!;
            }
        }
        for &ch in entry.value() {
            if ch.codepoint() == 0 {
                return Error::Environment { index: index, cause: EnvEntryError::ValueContainsNul }!;
            }
        }
        let mut priorIndex: usize = 0;
        for &prior in &entries[0..index] {
            if entry.name().equals(prior.name()) {
                return Error::Environment {
                    index: index,
                    cause: EnvEntryError::DuplicateName(priorIndex),
                }!;
            }
            priorIndex += 1;
        }
        index += 1;
    }
    !()
}

fn appendEnvironmentEntry(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    entry: EnvEntry,
) Error!() {
    let mut byteLen: usize = 1;
    for &ch in entry.name() {
        byteLen = match byteLen.checked_add(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    for &ch in entry.value() {
        byteLen = match byteLen.checked_add(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    let needed = match byteLen.checked_add(1) {
        ?value => value,
        null => return Error::Allocation(mem::Error::OutOfMemory)!,
    };
    bytes.reserve(allocator, needed).asProcessAllocationError().?;
    for &ch in entry.name() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(b'=');
    for &ch in entry.value() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !()
}

fn appendCStringPointers(
    allocator: &mut mem::Allocator,
    bytes: &[u8],
    pointers: &mut collections::ArrayList[&u8],
) Error!() {
    // Callers finish a non-empty arena of adjacent NUL-terminated strings
    // before taking any pointers into it.
    let mut start: usize = 0;
    while start < bytes.len() {
        pointers.push(allocator, &bytes[start]).asProcessAllocationError().?;
        while bytes[start] != 0 {
            start += 1;
        }
        start += 1;
    }
    pointers.push(allocator, 0usize as &u8).asProcessAllocationError().?;
    !()
}

fn commandSpawnError(cause: os::SpawnError) Error {
    match cause {
        os::SpawnError::Setup(system) => {
            Error::Spawn(SpawnError::Setup(SystemError::fromOs(system)))
        },
        os::SpawnError::Stdio(system) => {
            Error::Spawn(SpawnError::Stdio(SystemError::fromOs(system)))
        },
        os::SpawnError::Cwd(system) => {
            Error::Spawn(SpawnError::Cwd(SystemError::fromOs(system)))
        },
        os::SpawnError::Exec(system) => {
            Error::Spawn(SpawnError::Exec(SystemError::fromOs(system)))
        },
    }
}

extend[T] os::Error!T {
    fn asCommandSpawnSetupError(self) Error!T {
        match self {
            !value => !value,
            cause! => Error::SpawnSetup(SystemError::fromOs(cause))!,
        }
    }
}

extend[T] mem::Error!T {
    fn asProcessAllocationError(self) Error!T {
        match self {
            !value => !value,
            cause! => Error::Allocation(cause)!,
        }
    }
}
