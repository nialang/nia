using pkg::collections;
using pkg::error;
using pkg::result;
using pkg::fs;
using pkg::mem;
using pkg::os;
using pkg::process::child;
using pkg::process::types;
using pkg::slice;
using pkg::unicode;

using types::{
    AllocatorSpawnAttempt,
    Child,
    Command,
    CommandEnvironment,
    Env,
    EnvEntry,
    EnvEntryError,
    Error,
    SpawnAttempt,
    SpawnError,
    SpawnStage,
    SpawnOutcome,
    SpawnStorage,
    StdIo,
    SystemError,
};

extend Command {
    pub fn init(path: fs::PathView, env: Env) Command {
        Self {
            path: path,
            arguments: null,
            environment: CommandEnvironment::Inherit(env),
            stdin: StdIo::Inherit,
            stdout: StdIo::Inherit,
            stderr: StdIo::Inherit,
            cwd: null,
        }
    }

    pub fn path(&self) fs::PathView {
        self.path
    }

    pub fn arguments(&self) ?&[&[char]] {
        self.arguments
    }

    pub fn stdin(&self) StdIo {
        self.stdin
    }

    pub fn stdout(&self) StdIo {
        self.stdout
    }

    pub fn stderr(&self) StdIo {
        self.stderr
    }

    pub fn cwd(&self) ?fs::PathView {
        self.cwd
    }

    pub fn withArguments(self, arguments: &[&[char]]) Command {
        Self {
            path: self.path,
            arguments: ?arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdin(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: behavior,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStdout(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: behavior,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withStderr(self, behavior: StdIo) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: behavior,
            cwd: self.cwd,
        }
    }

    pub fn withCwd(self, cwd: fs::PathView) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: self.environment,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: ?cwd,
        }
    }

    pub fn withEnvironment(self, entries: &[EnvEntry]) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: CommandEnvironment::Exact(entries),
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn withoutEnvironment(self) Command {
        Self {
            path: self.path,
            arguments: self.arguments,
            environment: CommandEnvironment::Empty,
            stdin: self.stdin,
            stdout: self.stdout,
            stderr: self.stderr,
            cwd: self.cwd,
        }
    }

    pub fn spawn(&self) SpawnAttempt {
        SpawnAttempt::start(self)
    }

    pub fn spawnWithAllocator(&self, allocator: &mut mem::Allocator) AllocatorSpawnAttempt {
        AllocatorSpawnAttempt::start(self, allocator)
    }

    fn executeSpawn(
        &self,
        allocator: &mut mem::Allocator,
        storage: &mut SpawnStorage,
    ) Error!() {
        match self.environment {
            .Exact(entries) => validateEnvironment(entries).?,
            .Inherit(_) => {},
            .Empty => {},
        }

        appendPath(allocator, &mut storage.argumentBytes, self.path).?;
        if self.arguments is ?arguments {
            let mut argumentIndex: usize = 0;
            for &argument in arguments {
                appendArgument(allocator, &mut storage.argumentBytes, argument, argumentIndex).?;
                argumentIndex += 1;
            }
        }

        let bytes = storage.argumentBytes.asSlice();
        appendCStringPointers(allocator, bytes, &mut storage.argv).?;

        let emptyEnvp: [&u8; 1] = [0usize as &u8];
        let envp = match self.environment {
            .Inherit(env) => env.rawEnvp(),
            .Exact(entries) => {
                if entries.isEmpty() {
                    &emptyEnvp[0]
                } else {
                    for &entry in entries {
                        appendEnvironmentEntry(allocator, &mut storage.environmentBytes, entry).?;
                    }
                    appendCStringPointers(
                        allocator,
                        storage.environmentBytes.asSlice(),
                        &mut storage.environmentPointers,
                    ).?;
                    storage.environmentPointers.asSlice().ptr()
                }
            },
            .Empty => &emptyEnvp[0],
        };

        let mut options: os::SpawnOptions = .init();
        options.setStdin(self.stdin.asOsStdio()).withSpawnSetupContext().?;
        options.setStdout(self.stdout.asOsStdio()).withSpawnSetupContext().?;
        options.setStderr(self.stderr.asOsStdio()).withSpawnSetupContext().?;
        if self.cwd is ?cwd {
            appendPath(allocator, &mut storage.cwdBytes, cwd).?;
            options.setCwd(storage.cwdBytes.asSlice().ptr());
        }
        storage.nativeSpawn = ?os::spawn(bytes.ptr(), storage.argv.asSlice().ptr(), envp, options);
        !()
    }
}

extend SpawnStorage {
    fn init() SpawnStorage {
        Self {
            argumentBytes: .init(),
            argv: .init(),
            environmentBytes: .init(),
            environmentPointers: .init(),
            cwdBytes: .init(),
            nativeSpawn: null,
            outcome: null,
        }
    }

    fn execute(&mut self, command: &Command, allocator: &mut mem::Allocator) () {
        if command.executeSpawn(allocator, self) is cause! {
            self.outcome = ?SpawnOutcome::Failure(cause);
        }
    }

    fn finish(&mut self, allocator: &mut mem::Allocator) Error!Child {
        let nativeResult = self.finishNativeSpawn();
        let mut cleanup: error::CleanupAccumulator[mem::Error] = .init();
        cleanup.attempt(self.cwdBytes.deinit(allocator));
        cleanup.attempt(self.environmentPointers.deinit(allocator));
        cleanup.attempt(self.environmentBytes.deinit(allocator));
        cleanup.attempt(self.argv.deinit(allocator));
        cleanup.attempt(self.argumentBytes.deinit(allocator));
        if not cleanup.isClean() {
            if cleanup.finish() is error! {
                return .Allocation(error)!;
            }
        }
        nativeResult.?;
        let outcome = match self.outcome {
            ?value => value,
            null => return Error::SpawnSetup(SystemError::Invalid)!,
        };
        self.outcome = null;
        match outcome {
            .Success(child) => !child,
            .Failure(cause) => cause!,
        }
    }

    fn finishNativeSpawn(&mut self) Error!() {
        if self.nativeSpawn is ?value {
            let mut attempt = value;
            self.nativeSpawn = null;
            match attempt.finish() {
                !result => {
                    self.outcome = ?SpawnOutcome::Success(Child::fromSpawnResult(result));
                },
                .Reap { stage, primary, cause, pid }! => {
                    self.nativeSpawn = ?attempt;
                    return Error::Spawn(SpawnError::Reap {
                        stage: commandSpawnStage(stage),
                        primary: SystemError::fromOs(primary),
                        cause: SystemError::fromOs(cause),
                        pid: child::processIdFromOs(pid),
                    })!;
                },
                cause! => {
                    self.outcome = ?SpawnOutcome::Failure(commandSpawnError(cause));
                },
            }
        }
        !()
    }
}

extend SpawnAttempt {
    fn start(command: &Command) SpawnAttempt {
        let mut attempt = Self {
            allocator: .init(),
            storage: .init(),
        };
        let allocator: &mut mem::Allocator = &mut attempt.allocator;
        attempt.storage.execute(command, allocator);
        attempt
    }

    pub fn finish(&mut self) Error!Child {
        let allocator: &mut mem::Allocator = &mut self.allocator;
        self.storage.finish(allocator)
    }
}

extend AllocatorSpawnAttempt {
    fn start(command: &Command, allocator: &mut mem::Allocator) AllocatorSpawnAttempt {
        let mut attempt = Self { storage: .init() };
        attempt.storage.execute(command, allocator);
        attempt
    }

    pub fn finish(&mut self, allocator: &mut mem::Allocator) Error!Child {
        self.storage.finish(allocator)
    }
}

extend StdIo {
    fn asOsStdio(self) os::StdIo {
        match self {
            .Inherit => .Inherit,
            .Ignore => .Ignore,
            .Pipe => .Pipe,
        }
    }
}

fn appendArgument(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    argument: &[char],
    argumentIndex: usize,
) Error!() {
    appendText(
        allocator,
        bytes,
        argument,
        Error::ArgumentContainsNul(argumentIndex),
    )
}

fn appendPath(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    path: fs::PathView,
) Error!() {
    appendText(
        allocator,
        bytes,
        path.text(),
        Error::Path(fs::PathError::ContainsNul),
    )
}

fn appendText(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    text: &[char],
    containsNul: Error,
) Error!() {
    let mut byteLen: usize = 1;
    for &ch in text {
        if ch.codepoint() == 0 {
            return containsNul!;
        }
        byteLen = match byteLen.checkedAdd(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    bytes.reserve(allocator, byteLen).?;
    for &ch in text {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !()
}

fn validateEnvironment(entries: &[EnvEntry]) Error!() {
    let mut index: usize = 0;
    for &entry in entries {
        if entry.name().isEmpty() {
            return Error::Environment { index: index, cause: EnvEntryError::EmptyName }!;
        }
        for &ch in entry.name() {
            if ch.codepoint() == 0 {
                return Error::Environment { index: index, cause: EnvEntryError::NameContainsNul }!;
            }
            if ch == '=' {
                return Error::Environment { index: index, cause: EnvEntryError::NameContainsEquals }!;
            }
        }
        for &ch in entry.value() {
            if ch.codepoint() == 0 {
                return Error::Environment { index: index, cause: EnvEntryError::ValueContainsNul }!;
            }
        }
        let mut priorIndex: usize = 0;
        for &prior in &entries[0..index] {
            if entry.name().equals(prior.name()) {
                return Error::Environment {
                    index: index,
                    cause: EnvEntryError::DuplicateName(priorIndex),
                }!;
            }
            priorIndex += 1;
        }
        index += 1;
    }
    !()
}

fn appendEnvironmentEntry(
    allocator: &mut mem::Allocator,
    bytes: &mut collections::ArrayList[u8],
    entry: EnvEntry,
) Error!() {
    let mut byteLen: usize = 1;
    for &ch in entry.name() {
        byteLen = match byteLen.checkedAdd(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    for &ch in entry.value() {
        byteLen = match byteLen.checkedAdd(ch.encodeUtf8().byteLen()) {
            ?value => value,
            null => return Error::Allocation(mem::Error::OutOfMemory)!,
        };
    }
    let needed = match byteLen.checkedAdd(1) {
        ?value => value,
        null => return Error::Allocation(mem::Error::OutOfMemory)!,
    };
    bytes.reserve(allocator, needed).?;
    for &ch in entry.name() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(b'=');
    for &ch in entry.value() {
        bytes.appendSliceAssumeCapacity(ch.encodeUtf8().bytes());
    }
    bytes.appendAssumeCapacity(0);
    !()
}

fn appendCStringPointers(
    allocator: &mut mem::Allocator,
    bytes: &[u8],
    pointers: &mut collections::ArrayList[&u8],
) Error!() {
    // Callers finish a non-empty arena of adjacent NUL-terminated strings
    // before taking any pointers into it.
    let mut start: usize = 0;
    while start < bytes.len() {
    pointers.push(allocator, &bytes[start]).?;
        while bytes[start] != 0 {
            start += 1;
        }
        start += 1;
    }
    pointers.push(allocator, 0usize as &u8).?;
    !()
}

fn commandSpawnError(cause: os::SpawnError) Error {
    match cause {
        .Setup(system) => {
            Error::Spawn(SpawnError::Setup(SystemError::fromOs(system)))
        },
        .Stdio(system) => {
            Error::Spawn(SpawnError::Stdio(SystemError::fromOs(system)))
        },
        .Cwd(system) => {
            Error::Spawn(SpawnError::Cwd(SystemError::fromOs(system)))
        },
        .Exec(system) => {
            Error::Spawn(SpawnError::Exec(SystemError::fromOs(system)))
        },
        .Reap { stage, primary, cause, pid } => {
            Error::Spawn(SpawnError::Reap {
                stage: commandSpawnStage(stage),
                primary: SystemError::fromOs(primary),
                cause: SystemError::fromOs(cause),
                pid: child::processIdFromOs(pid),
            })
        },
    }
}

fn commandSpawnStage(stage: os::SpawnStage) SpawnStage {
    match stage {
        .Setup => SpawnStage::Setup,
        .Stdio => SpawnStage::Stdio,
        .Cwd => SpawnStage::Cwd,
        .Exec => SpawnStage::Exec,
        _ => SpawnStage::Setup,
    }
}

extend[T] os::Error!T {
    fn withSpawnSetupContext(self) Error!T {
        match self {
            !value => !value,
            cause! => Error::SpawnSetup(SystemError::fromOs(cause))!,
        }
    }
}

extend mem::Error : error::IntoError[Error] {
    const fn intoError(self) Error {
        Error::Allocation(self)
    }
}
