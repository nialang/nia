pub trait Step {
    fn forward_checked(self) ?Self;
}

pub struct Range[T] {
    start: T,
    end: T,
}

pub struct RangeInclusive[T] {
    current: T,
    end: T,
    done: bool,
}

pub struct RangeFrom[T] {
    current: T,
    done: bool,
}

extend[T] Range[T] {
    pub fn init(start: T, end: T) Range[T] {
        { start: start, end: end }
    }

    pub fn from(bounds: T..T) Range[T] {
        Range[T]::init(bounds.start(), bounds.end())
    }

    pub fn start(&self) T {
        self.start
    }

    pub fn end(&self) T {
        self.end
    }
}

extend[T] Range[T] : Iterator
where T: Step + Ord[T]
{
    type Item = T;

    pub fn next(&mut self) ?T {
        if self.start >= self.end {
            null
        } else {
            let value = self.start;
            self.start = if ?next = self.start.forward_checked() {
                next
            } or null {
                self.end
            };
            ?value
        }
    }
}

extend[T] RangeInclusive[T]
where T: Ord[T]
{
    pub fn init(start: T, end: T) RangeInclusive[T] {
        { current: start, end: end, done: start > end }
    }

    pub fn from(bounds: T..=T) RangeInclusive[T] {
        RangeInclusive[T]::init(bounds.start(), bounds.end())
    }

    pub fn start(&self) T {
        self.current
    }

    pub fn end(&self) T {
        self.end
    }
}

extend[T] RangeInclusive[T] : Iterator
where T: Step + Ord[T] + Eq[T]
{
    type Item = T;

    pub fn next(&mut self) ?T {
        if self.done {
            return null;
        }
        let value = self.current;
        if value == self.end {
            self.done = true;
        } else {
            self.current = if ?next = self.current.forward_checked() {
                next
            } or null {
                    self.done = true;
                    self.end
            };
        }
        ?value
    }
}

extend[T] RangeFrom[T] {
    pub fn init(start: T) RangeFrom[T] {
        { current: start, done: false }
    }

    pub fn from(bounds: T..) RangeFrom[T] {
        RangeFrom[T]::init(bounds.start())
    }

    pub fn start(&self) T {
        self.current
    }
}

extend[T] RangeFrom[T] : Iterator
where T: Step
{
    type Item = T;

    pub fn next(&mut self) ?T {
        if self.done {
            return null;
        }
        let value = self.current;
        self.current = if ?next = self.current.forward_checked() {
            next
        } or null {
                self.done = true;
                self.current
        };
        ?value
    }
}

pub fn range[T](bounds: T..T) Range[T]
where T: Step + Ord[T]
{
    Range[T]::from(bounds)
}

pub fn inclusive[T](bounds: T..=T) RangeInclusive[T]
where T: Step + Ord[T] + Eq[T]
{
    RangeInclusive[T]::from(bounds)
}

pub fn from[T](bounds: T..) RangeFrom[T]
where T: Step
{
    RangeFrom[T]::from(bounds)
}

extend i8 : Step {
    pub fn forward_checked(self) ?i8 {
        if self == i8::MAX { null } else { ?(self + 1i8) }
    }
}

extend i16 : Step {
    pub fn forward_checked(self) ?i16 {
        if self == i16::MAX { null } else { ?(self + 1i16) }
    }
}

