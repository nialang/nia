// Scalar paths, validated native path views, and filesystem handles.
//
// `Path` owns allocator-backed scalar text and `PathView` borrows it. Native
// and relative views are validated capabilities. Contextual operations retain
// both the attempted operation and their allocation, path, or system cause.

pub(pkg) module convert;
pub(pkg) module file;
pub(pkg) module options;
pub(pkg) module path;
pub(pkg) module types;

using pkg::fs::file;
using pkg::fs::options;
using pkg::fs::path;
using pkg::fs::types;

pub using file::getCwd;
pub using types::{
    CreateDirOptions,
    CreateOptions,
    Dir,
    DirEntry,
    DirIterator,
    Error,
    File,
    FileKind,
    Metadata,
    MetadataOptions,
    NativePathView,
    OpenDirOptions,
    OpenMode,
    OpenOptions,
    Path,
    PathError,
    PathView,
    RelativeNativePathView,
    RelativePathView,
    Operation,
    OperationError,
    Timestamp,
};
