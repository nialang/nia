// Scalar paths, validated native path views, and filesystem handles.
//
// `Path` owns allocator-backed scalar text and `PathView` borrows it. Native
// and relative views are validated capabilities. Scalar syscall paths encode
// into bounded stack storage; contextual operations retain both the attempted
// operation and their path or system cause.

pub(root) module convert;
pub(root) module file;
pub(root) module options;
pub(root) module path;
pub(root) module types;

using root::fs::file;
using root::fs::options;
using root::fs::path;
using root::fs::types;

pub using file::getCwd;
pub using types::{
    CreateDirOptions,
    CreateOptions,
    Dir,
    DirEntry,
    DirIterator,
    Error,
    File,
    FileKind,
    Metadata,
    MetadataOptions,
    NativePathView,
    OpenDirOptions,
    OpenMode,
    OpenOptions,
    Path,
    PathError,
    PathView,
    RelativeNativePathView,
    RelativePathView,
    Operation,
    OperationError,
    Timestamp,
};
