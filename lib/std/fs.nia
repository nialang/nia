import std.os;
import std.result;
import std.unicode;

pub enum Error: i32 {
    PermissionDenied = 1,
    NotFound = 2,
    Interrupted = 4,
    Io = 5,
    BadFd = 9,
    Again = 11,
    OutOfMemory = 12,
    Access = 13,
    Fault = 14,
    Busy = 16,
    AlreadyExists = 17,
    Invalid = 22,
    NoSpace = 28,
    BrokenPipe = 32,
    OutOfRange = 34,
    TooLong = 36,
    System = 255,
    _,
}

enum PathError: i32 {
    Invalid = 1,
    TooLong = 36,
    _,
}

pub enum OpenMode: i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    ReadWrite = 2,
    _,
}

pub struct Path {
    text: &[char],
}

struct EncodedPath {
    ptr: &u8,
}

pub struct Dir {
    handle: os::FileDescriptor,
}

pub struct File {
    handle: os::FileDescriptor,
}

pub struct OpenOptions {
    mode: OpenMode,
}

pub struct CreateOptions {
    read: bool,
    truncate: bool,
    exclusive: bool,
    permissions: u32,
}

extend Path {
    pub fn init(text: &[char]) Path {
        { text: text }
    }

    pub fn text(&self) &[char] {
        self.text
    }
}

extend EncodedPath {
    fn init(ptr: &u8) EncodedPath {
        { ptr: ptr }
    }

    fn ptr(&self) &u8 {
        self.ptr
    }
}

extend Dir {
    fn init(handle: os::FileDescriptor) Dir {
        { handle: handle }
    }

    pub fn cwd() Dir {
        Dir::init(os::cwd())
    }

    pub fn open_file(&self, path: Path, options: OpenOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = encode_path(path, &mut storage[..]).?;
        open_encoded_file(self.handle, encoded, options)
    }

    pub fn create_file(&self, path: Path, options: CreateOptions) Error!File {
        var storage: [os::max_path_bytes]u8 = [0; os::max_path_bytes];
        let encoded = encode_path(path, &mut storage[..]).?;
        create_encoded_file(self.handle, encoded, options)
    }
}

extend File {
    fn init(handle: os::FileDescriptor) File {
        { handle: handle }
    }

    pub fn stdin() File {
        File::init(os::FileDescriptor::stdin())
    }

    pub fn stdout() File {
        File::init(os::FileDescriptor::stdout())
    }

    pub fn stderr() File {
        File::init(os::FileDescriptor::stderr())
    }

    pub fn close(&self) Error!void {
        self.handle.close().map_err[Error](&os::Error::as_fs_error)
    }

    pub fn write_some(&self, bytes: &[u8]) Error!usize {
        self.handle.write_some(bytes).map_err[Error](&os::Error::as_fs_error)
    }

    pub fn read_some(&self, bytes: &mut [u8]) Error!usize {
        self.handle.read_some(bytes).map_err[Error](&os::Error::as_fs_error)
    }
}

extend OpenOptions {
    pub fn read_only() OpenOptions {
        { mode: OpenMode::ReadOnly }
    }

    pub fn write_only() OpenOptions {
        { mode: OpenMode::WriteOnly }
    }

    pub fn read_write() OpenOptions {
        { mode: OpenMode::ReadWrite }
    }

    pub fn mode(&self) OpenMode {
        self.mode
    }

}

extend CreateOptions {
    pub fn init() CreateOptions {
        { read: false, truncate: true, exclusive: false, permissions: 0o666 }
    }

    pub fn read_write() CreateOptions {
        { read: true, truncate: true, exclusive: false, permissions: 0o666 }
    }

    pub fn exclusive() CreateOptions {
        { read: false, truncate: true, exclusive: true, permissions: 0o666 }
    }

    pub fn read(&self) bool {
        self.read
    }

    pub fn truncate(&self) bool {
        self.truncate
    }

    pub fn is_exclusive(&self) bool {
        self.exclusive
    }

    pub fn permissions(&self) u32 {
        self.permissions
    }

}

fn open_encoded_file(dir: os::FileDescriptor, path: EncodedPath, options: OpenOptions) Error!File {
    let handle = os::open_at(
        dir,
        path.ptr(),
        open_options_mode(options),
        false,
        false,
        false,
        0,
    ).map_err[Error](&os::Error::as_fs_error).?;
    !File::init(handle)
}

fn create_encoded_file(
    dir: os::FileDescriptor,
    path: EncodedPath,
    options: CreateOptions,
) Error!File {
    let handle = os::open_at(
        dir,
        path.ptr(),
        create_options_mode(options),
        true,
        options.truncate(),
        options.is_exclusive(),
        options.permissions(),
    ).map_err[Error](&os::Error::as_fs_error).?;
    !File::init(handle)
}

fn open_options_mode(options: OpenOptions) os::OpenMode {
    switch options.mode() {
        OpenMode::ReadOnly => os::OpenMode::ReadOnly,
        OpenMode::WriteOnly => os::OpenMode::WriteOnly,
        OpenMode::ReadWrite => os::OpenMode::ReadWrite,
        _ => os::OpenMode::ReadOnly,
    }
}

fn create_options_mode(options: CreateOptions) os::OpenMode {
    if options.read() {
        os::OpenMode::ReadWrite
    } else {
        os::OpenMode::WriteOnly
    }
}

fn encode_path(path: Path, storage: &mut [u8]) Error!EncodedPath {
    encode_path_bytes(path.text(), storage).map_err[Error](&PathError::as_fs_error)
}

fn encode_path_bytes(text: &[char], storage: &mut [u8]) PathError!EncodedPath {
    var out = 0usize;
    var index = 0usize;
    while index < text.len() {
        let ch = text[index];
        if ch as u32 == 0u32 {
            return PathError::Invalid!;
        }
        let encoded = unicode::encode_utf8(ch);
        if out + encoded.len() >= storage.len() {
            return PathError::TooLong!;
        }
        let bytes = encoded.bytes();
        var byte_index = 0usize;
        while byte_index < bytes.len() {
            storage[out] = bytes[byte_index];
            out += 1usize;
            byte_index += 1usize;
        }
        index += 1usize;
    }
    if out >= storage.len() {
        return PathError::TooLong!;
    }
    storage[out] = 0u8;
    !EncodedPath::init(storage.get_ptr_read())
}

extend PathError {
    fn as_fs_error(self) Error {
        switch self {
            PathError::Invalid => Error::Invalid,
            PathError::TooLong => Error::TooLong,
            _ => Error::Invalid,
        }
    }
}

extend os::Error {
    fn as_fs_error(self) Error {
        switch self {
            os::Error::PermissionDenied => Error::PermissionDenied,
            os::Error::NoEntry => Error::NotFound,
            os::Error::Interrupted => Error::Interrupted,
            os::Error::Io => Error::Io,
            os::Error::BadFd => Error::BadFd,
            os::Error::Again => Error::Again,
            os::Error::NoMemory => Error::OutOfMemory,
            os::Error::Access => Error::Access,
            os::Error::Fault => Error::Fault,
            os::Error::Busy => Error::Busy,
            os::Error::Exists => Error::AlreadyExists,
            os::Error::Invalid => Error::Invalid,
            os::Error::NoSpace => Error::NoSpace,
            os::Error::BrokenPipe => Error::BrokenPipe,
            os::Error::OutOfRange => Error::OutOfRange,
            _ => Error::System,
        }
    }
}
