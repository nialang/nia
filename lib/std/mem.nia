import std.os;

pub struct Block {
    ptr: &mut u8,
    len: usize,
    align: usize,
}

pub struct PageAllocator {}

pub trait Allocator {
    type Error;

    fn allocate(&self, len: usize, align: usize) [Self as Allocator]::Error!Block;
    fn deallocate(&self, block: Block) [Self as Allocator]::Error!void;
}

pub fn block(ptr: &mut u8, len: usize, align: usize) Block {
    { ptr: ptr, len: len, align: align }
}

pub fn block_ptr(block: Block) &mut u8 {
    block.ptr
}

pub fn block_len(block: Block) usize {
    block.len
}

pub fn block_align(block: Block) usize {
    block.align
}

pub fn page_allocator() PageAllocator {
    {}
}

extend PageAllocator : Allocator {
    type Error = os::Error;

    fn allocate(&self, len: usize, align: usize) os::Error!Block {
        _ = self;
        if len == 0 {
            !(block(0usize as &mut u8, 0, align))
        } else {
            var ptr = os::map_pages(len).?;
            !(block(ptr, len, align))
        }
    }

    fn deallocate(&self, block: Block) os::Error!void {
        _ = self;
        if block.len == 0 {
            !{}
        } else {
            os::unmap_pages(block.ptr, block.len).?;
            !{}
        }
    }
}

pub fn allocate[A](allocator: &A, len: usize, align: usize) [A as Allocator]::Error!Block
where A: Allocator
{
    allocator.allocate(len, align)
}

pub fn deallocate[A](allocator: &A, block: Block) [A as Allocator]::Error!void
where A: Allocator
{
    allocator.deallocate(block)
}
