// Explicit allocation and ownership primitives.
//
// Allocator-backed values retain no implicit destructor. Release uses the
// allocator that produced the storage, and callable views remain borrowed
// from their `Allocated` or `CallableAllocation` owner.

pub(pkg) module arena_allocator;
pub(pkg) module allocation;
pub(pkg) module allocator;
pub(pkg) module fixed_buffer_allocator;
pub(pkg) module general_purpose_allocator;
pub(pkg) module page_allocator;
pub(pkg) module types;

using pkg::mem::arena_allocator;
using pkg::mem::allocation;
using pkg::mem::fixed_buffer_allocator;
using pkg::mem::general_purpose_allocator;
using pkg::mem::page_allocator;

pub using types::{Block, Error, Layout};
pub using allocation::{Allocated, CallableAllocation};
pub using arena_allocator::ArenaAllocator;
pub using allocator::{Allocator, ReallocError, SliceAllocation};
pub using fixed_buffer_allocator::FixedBufferAllocator;
pub using general_purpose_allocator::{DeinitStatus, GeneralPurposeAllocator};
pub using page_allocator::PageAllocator;

pub fn allocValue[T](allocator: &mut Allocator, value: T) Error!Allocated[T]
where T: Sized
{
    allocation::allocValue[T](allocator, value)
}
