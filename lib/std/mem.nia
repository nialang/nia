import std.os;
import std.result;

pub enum Error: i32 {
    Invalid = 1,
    InvalidAlignment = 2,
    OutOfMemory = 3,
    System = 4,
    _,
}

pub struct Layout {
    size: usize,
    align: usize,
}

pub struct Block {
    ptr: &mut u8,
    layout: Layout,
}

pub struct PageAllocator {}

pub trait Allocator {
    fn alloc(&mut self, layout: Layout) Error!Block;

    fn free(&mut self, block: Block) Error!void;

    fn resize(&mut self, block: Block, new_layout: Layout) bool {
        _ = self;
        if block.align() != new_layout.align() {
            return false;
        }
        block.size() == new_layout.size()
    }

    fn remap(&mut self, block: Block, new_layout: Layout) ?Block {
        if self.resize(block, new_layout) {
            ?Block::init(block.ptr(), new_layout)
        } else if block.is_empty() and new_layout.is_empty() {
            ?dangling_block(new_layout)
        } else {
            null
        }
    }

    fn realloc(&mut self, block: Block, new_layout: Layout) Error!Block {
        switch self.remap(block, new_layout) {
            ?new_block => return !new_block,
            null => {},
        }
        let new_block = self.alloc(new_layout).?;
        copy_block_prefix(block, new_block);
        self.free(block).?;
        !new_block
    }

    fn alloc_bytes(&mut self, len: usize, align: usize) Error!Block {
        let layout = Layout::init(len, align).?;
        self.alloc(layout)
    }

    fn alloc_slice[T](&mut self, len: usize) Error!&mut [T]
    where T: Sized
    {
        let layout = Layout::array[T](len).?;
        if layout.is_empty() {
            return !dangling_slice[T](len);
        }
        switch self.alloc(layout) {
            !block => !block.as_slice[T](),
            err! => err!,
        }
    }

    fn free_slice[T](&mut self, slice: &mut [T]) Error!void
    where T: Sized
    {
        let layout = Layout::array[T](slice.len()).?;
        self.free(Block::init(slice.get_ptr() as &mut u8, layout))
    }
}

fn dangling_slice[T](len: usize) &mut [T]
where T: Sized
{
    var ptr = @align[T]() as &mut T;
    &mut ptr[0..len]
}

fn dangling_block(layout: Layout) Block {
    Block::init(layout.align() as &mut u8, layout)
}

fn copy_block_prefix(from: Block, to: Block) void {
    var count = from.size();
    if count > to.size() {
        count = to.size();
    }
    copy_bytes(&mut to.ptr()[0..count], &from.ptr()[0..count]);
}

fn copy_bytes(to: &mut [u8], from: &[u8]) void {
    var index = 0usize;
    while index < to.len() {
        to[index] = from[index];
        index += 1usize;
    }
}

fn is_power_of_two(value: usize) bool {
    if value == 0 {
        false
    } else {
        var n = value;
        while n > 1usize {
            if n % 2usize != 0usize {
                return false;
            }
            n = n / 2usize;
        }
        true
    }
}

extend Layout {
    pub fn init(size: usize, align: usize) Error!Layout {
        if align == 0 {
            Error::InvalidAlignment!
        } else if not is_power_of_two(align) {
            Error::InvalidAlignment!
        } else {
            !{ size: size, align: align }
        }
    }

    pub fn of[T]() Error!Layout
    where T: Sized
    {
        Layout::init(@size[T](), @align[T]())
    }

    pub fn array[T](count: usize) Error!Layout
    where T: Sized
    {
        let elem_len = @size[T]();
        if elem_len != 0usize and count != 0usize {
            let size = elem_len * count;
            if size / elem_len != count {
                return Error::OutOfMemory!;
            }
            Layout::init(size, @align[T]())
        } else {
            Layout::init(0, @align[T]())
        }
    }

    pub fn size(&self) usize {
        self.size
    }

    pub fn align(&self) usize {
        self.align
    }

    pub fn is_empty(&self) bool {
        self.size == 0
    }
}

extend Block {
    pub fn init(ptr: &mut u8, layout: Layout) Block {
        { ptr: ptr, layout: layout }
    }

    pub fn ptr(&self) &mut u8 {
        self.ptr
    }

    pub fn layout(&self) Layout {
        self.layout
    }

    pub fn size(&self) usize {
        self.layout.size()
    }

    pub fn align(&self) usize {
        self.layout.align()
    }

    pub fn is_empty(&self) bool {
        self.layout.is_empty()
    }

    pub fn bytes(&self) &mut [u8] {
        &mut self.ptr[0..self.size()]
    }

    pub fn as_slice[T](&self) &mut [T]
    where T: Sized
    {
        var ptr = self.ptr as &mut T;
        &mut ptr[0..(self.size() / @size[T]())]
    }
}

extend PageAllocator {
    pub fn init() PageAllocator {
        {}
    }
}

extend PageAllocator : Allocator {
    pub fn alloc(&mut self, layout: Layout) Error!Block {
        _ = self;
        if layout.is_empty() {
            !dangling_block(layout)
        } else {
            let ptr = os::map_pages(layout.size(), layout.align()).map_err[Error](&[os::Error]::as_mem_error).?;
            !Block::init(ptr, layout)
        }
    }

    pub fn resize(&mut self, block: Block, new_layout: Layout) bool {
        _ = self;
        if block.align() != new_layout.align() {
            return false;
        }
        if block.is_empty() or new_layout.is_empty() {
            return block.is_empty() and new_layout.is_empty();
        }

        var old_size: usize;
        switch os::page_aligned_len(block.size()) {
            !size => old_size = size,
            err! => return false,
        }
        var new_size: usize;
        switch os::page_aligned_len(new_layout.size()) {
            !size => new_size = size,
            err! => return false,
        }
        old_size == new_size
    }

    pub fn remap(&mut self, block: Block, new_layout: Layout) ?Block {
        if self.resize(block, new_layout) {
            ?Block::init(block.ptr(), new_layout)
        } else if block.is_empty() and new_layout.is_empty() {
            ?dangling_block(new_layout)
        } else {
            null
        }
    }

    pub fn free(&mut self, block: Block) Error!void {
        _ = self;
        if block.layout().is_empty() {
            !{}
        } else {
            os::unmap_pages(block.ptr(), block.size()).map_err[Error](&[os::Error]::as_mem_error)
        }
    }
}

extend os::Error {
    fn as_mem_error(self) Error {
        switch self {
            os::Error::Invalid => Error::Invalid,
            os::Error::NoMemory => Error::OutOfMemory,
            _ => Error::System,
        }
    }
}
