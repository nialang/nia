import std.os;

pub struct Layout {
    len: usize,
    align: usize,
}

pub struct Block {
    ptr: &mut u8,
    layout: Layout,
}

pub struct PageAllocator {}

pub trait Allocator {
    type Error;

    fn alloc(&self, layout: Layout) [Self as Allocator]::Error!?Block;
    fn free(&self, block: Block) [Self as Allocator]::Error!void;
}

extend Layout {
    pub fn init(len: usize, align: usize) os::Error!Layout {
        if align == 0 {
            os::Error::Invalid!
        } else {
            !{ len: len, align: align }
        }
    }

    pub fn len(&self) usize {
        self.len
    }

    pub fn align(&self) usize {
        self.align
    }
}

extend Block {
    pub fn init(ptr: &mut u8, layout: Layout) Block {
        { ptr: ptr, layout: layout }
    }

    pub fn ptr(&self) &mut u8 {
        self.ptr
    }

    pub fn layout(&self) Layout {
        self.layout
    }

    pub fn len(&self) usize {
        self.layout.len()
    }

    pub fn align(&self) usize {
        self.layout.align()
    }
}

extend PageAllocator {
    pub fn init() PageAllocator {
        {}
    }
}

extend PageAllocator : Allocator {
    type Error = os::Error;

    pub fn alloc(&self, layout: Layout) os::Error!?Block {
        _ = self;
        if layout.len() == 0 {
            !null
        } else {
            var ptr = os::map_pages(layout.len(), layout.align()).?;
            !(?Block::init(ptr, layout))
        }
    }

    pub fn free(&self, block: Block) os::Error!void {
        _ = self;
        os::unmap_pages(block.ptr(), block.len()).?;
        !{}
    }
}
