using pkg::fmt;
using pkg::io;

pub fn print(template: &[char], args: &[&fmt::Format]) void {
    let mut runtime_io = io::BlockingIo::init();
    let mut buffer: [512]u8 = [_]u8[0; 512];
    let mut stderr = io::FileWriter::stderr(&mut runtime_io, &mut buffer);

    if let !ok = stderr.print(template, args) {
        _ = ok;
    } else error! {
        @trap();
    }
    if let !ok = stderr.flush() {
        _ = ok;
    } else error! {
        @trap();
    }
}
