using package::fmt;
using package::io;

pub fn print(template: &[char], args: &[&fmt::Format]) void {
    var runtime_io = io::BlockingIo::init();
    var buffer: [512]u8 = [_]u8[0; 512];
    var stderr = io::FileWriter::stderr(&mut runtime_io, &mut buffer);

    if let !ok = stderr.print(template, args) {
        _ = ok;
    } else error! {
        @trap();
    }
    if let !ok = stderr.flush() {
        _ = ok;
    } else error! {
        @trap();
    }
}
