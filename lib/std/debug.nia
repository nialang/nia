using pkg::fmt;
using pkg::fs;
using pkg::io;

pub enum Error {
    Format(fmt::Error),
    Flush(fs::Error),
}

pub fn print(template: &[char], args: &[&fmt::Format]) Error!void {
    let mut buffer: [512]u8 = [_]u8[0; 512];
    let mut stderr = io::FileWriter::stderr(&mut buffer);

    switch stderr.print(template, args) {
        !ok => {
            _ = ok;
        },
        cause! => {
            return Error::Format(cause)!;
        },
    }
    switch stderr.flush() {
        !ok => {
            _ = ok;
        },
        cause! => {
            return Error::Flush(cause)!;
        },
    }
    !{}
}
