using pkg::fmt;
using pkg::fs;
using pkg::io;

pub enum Error {
    Format(fmt::Error),
    Flush(fs::Error),
}

pub fn print(template: &[char], args: &[&fmt::Format]) Error!() {
    let mut buffer: [u8; 512] = [0; 512];
    let mut stderr = io::FileWriter::stderr(&mut buffer);

    if stderr.print(template, args) is cause! {
        return .Format(cause)!;
    }
    if stderr.flush() is cause! {
        return .Flush(cause)!;
    }
    !()
}
