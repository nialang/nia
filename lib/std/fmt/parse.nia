pub enum ParseError: i32 {
    Empty = 1,
    InvalidDigit = 2,
    InvalidSign = 3,
    Overflow = 4,
    InvalidRadix = 5,
    _,
}

pub trait ParseFrom[Input] {
    fn parse_from(input: Input) ParseError!Self;

    fn parse_radix_from(input: Input, radix: u32) ParseError!Self {
        _ = input;
        _ = radix;
        ParseError::InvalidRadix!
    }
}

struct ParsedInteger {
    negative: bool,
    abs: u128,
}

trait AsciiParseUnit {
    fn ascii_code(self) u32;
}

pub fn parse[T, Input](input: Input) ParseError!T
where T: ParseFrom[Input]
{
    [T]::parse_from(input)
}

pub fn parse_radix[T, Input](input: Input, radix: u32) ParseError!T
where T: ParseFrom[Input]
{
    [T]::parse_radix_from(input, radix)
}

extend char : AsciiParseUnit {
    fn ascii_code(self) u32 {
        self as u32
    }
}

extend u8 : AsciiParseUnit {
    fn ascii_code(self) u32 {
        self as u32
    }
}

fn ascii_is[U](unit: U, ch: char) bool
where U: AsciiParseUnit
{
    unit.ascii_code() == (ch as u32)
}

fn ascii_digit_value[U](unit: U) ?u32
where U: AsciiParseUnit
{
    let code = unit.ascii_code();
    if code >= ('0' as u32) and code <= ('9' as u32) {
        ?(code - ('0' as u32))
    } else if code >= ('a' as u32) and code <= ('z' as u32) {
        ?((code - ('a' as u32)) + 10u32)
    } else if code >= ('A' as u32) and code <= ('Z' as u32) {
        ?((code - ('A' as u32)) + 10u32)
    } else {
        null
    }
}

fn ascii_is_hex_prefix[U](unit: U) bool
where U: AsciiParseUnit
{
    ascii_is[U](unit, 'x') or ascii_is[U](unit, 'X')
}

fn ascii_is_binary_prefix[U](unit: U) bool
where U: AsciiParseUnit
{
    ascii_is[U](unit, 'b') or ascii_is[U](unit, 'B')
}

fn ascii_is_octal_prefix[U](unit: U) bool
where U: AsciiParseUnit
{
    ascii_is[U](unit, 'o') or ascii_is[U](unit, 'O')
}

fn ascii_matches[U](input: &[U], text: &[char]) bool
where U: AsciiParseUnit
{
    if input.len() != text.len() {
        return false;
    }
    let mut index = 0usize;
    while index < input.len() {
        if not ascii_is[U](input[index], text[index]) {
            return false;
        }
        index += 1usize;
    }
    true
}

fn parse_integer_radix_units[U](input: &[U], radix: u32, allow_sign: bool) ParseError!ParsedInteger
where U: AsciiParseUnit
{
    if radix < 2u32 or radix > 36u32 {
        return ParseError::InvalidRadix!;
    }
    if input.len() == 0usize {
        return ParseError::Empty!;
    }

    let mut index = 0usize;
    let mut negative = false;
    let first = input[0];
    if ascii_is[U](first, '-') or ascii_is[U](first, '+') {
        if not allow_sign {
            return ParseError::InvalidSign!;
        }
        negative = ascii_is[U](first, '-');
        index = 1usize;
        if index == input.len() {
            return ParseError::InvalidDigit!;
        }
    }

    let mut value = 0u128;
    let radix_wide = radix as u128;
    while index < input.len() {
        let digit = if ?value = ascii_digit_value[U](input[index]) {
            value
        } or null {
            return ParseError::InvalidDigit!;
        };
        if digit >= radix {
            return ParseError::InvalidDigit!;
        }
        let digit_wide = digit as u128;
        if value > (u128::MAX - digit_wide) / radix_wide {
            return ParseError::Overflow!;
        }
        value = value * radix_wide + digit_wide;
        index += 1usize;
    }

    !{ negative: negative, abs: value }
}

fn parse_integer_units[U](input: &[U], allow_sign: bool) ParseError!ParsedInteger
where U: AsciiParseUnit
{
    if input.len() == 0usize {
        return ParseError::Empty!;
    }

    let mut index = 0usize;
    let mut negative = false;
    let first = input[0];
    if ascii_is[U](first, '-') or ascii_is[U](first, '+') {
        if not allow_sign {
            return ParseError::InvalidSign!;
        }
        negative = ascii_is[U](first, '-');
        index = 1usize;
        if index == input.len() {
            return ParseError::InvalidDigit!;
        }
    }

    let mut radix = 10u32;
    if index + 1usize < input.len() and ascii_is[U](input[index], '0') {
        let marker = input[index + 1usize];
        if ascii_is_hex_prefix[U](marker) {
            radix = 16u32;
            index += 2usize;
        } else if ascii_is_binary_prefix[U](marker) {
            radix = 2u32;
            index += 2usize;
        } else if ascii_is_octal_prefix[U](marker) {
            radix = 8u32;
            index += 2usize;
        }
        if index == input.len() {
            return ParseError::InvalidDigit!;
        }
    }

    let mut value = 0u128;
    let radix_wide = radix as u128;
    while index < input.len() {
        let digit = if ?value = ascii_digit_value[U](input[index]) {
            value
        } or null {
            return ParseError::InvalidDigit!;
        };
        if digit >= radix {
            return ParseError::InvalidDigit!;
        }
        let digit_wide = digit as u128;
        if value > (u128::MAX - digit_wide) / radix_wide {
            return ParseError::Overflow!;
        }
        value = value * radix_wide + digit_wide;
        index += 1usize;
    }

    !{ negative: negative, abs: value }
}

fn parse_bool_units[U](input: &[U]) ParseError!bool
where U: AsciiParseUnit
{
    if ascii_matches[U](input, "true") {
        !true
    } else if ascii_matches[U](input, "false") {
        !false
    } else if input.len() == 0usize {
        ParseError::Empty!
    } else {
        ParseError::InvalidDigit!
    }
}

fn finish_unsigned(parsed: ParsedInteger, max: u128) ParseError!u128 {
    if parsed.negative {
        return ParseError::InvalidSign!;
    }
    if parsed.abs > max {
        return ParseError::Overflow!;
    }
    !parsed.abs
}

fn finish_signed(parsed: ParsedInteger, min: i128, max: i128) ParseError!i128 {
    let negative_limit = ((0i128 - (min + 1i128)) as u128) + 1u128;
    if parsed.negative {
        if parsed.abs > negative_limit {
            return ParseError::Overflow!;
        }
        if parsed.abs == negative_limit {
            return !min;
        }
        return !(0i128 - parsed.abs as i128);
    }
    if parsed.abs > max as u128 {
        return ParseError::Overflow!;
    }
    !(parsed.abs as i128)
}

fn parse_unsigned_chars(text: &[char], max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_units[char](text, false).?, max)
}

fn parse_unsigned_radix_chars(text: &[char], radix: u32, max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_radix_units[char](text, radix, false).?, max)
}

fn parse_signed_chars(text: &[char], min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_units[char](text, true).?, min, max)
}

fn parse_signed_radix_chars(text: &[char], radix: u32, min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_radix_units[char](text, radix, true).?, min, max)
}

fn parse_unsigned_bytes(bytes: &[u8], max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_units[u8](bytes, false).?, max)
}

fn parse_unsigned_radix_bytes(bytes: &[u8], radix: u32, max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_radix_units[u8](bytes, radix, false).?, max)
}

fn parse_signed_bytes(bytes: &[u8], min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_units[u8](bytes, true).?, min, max)
}

fn parse_signed_radix_bytes(bytes: &[u8], radix: u32, min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_radix_units[u8](bytes, radix, true).?, min, max)
}

extend i8 : ParseFrom[&[char]] {
    fn parse_from(text: &[char]) ParseError!i8 {
        !(parse_signed_chars(text, i8::MIN as i128, i8::MAX as i128).? as i8)
    }

    fn parse_radix_from(text: &[char], radix: u32) ParseError!i8 {
        !(parse_signed_radix_chars(text, radix, i8::MIN as i128, i8::MAX as i128).? as i8)
    }
}

extend i8 : ParseFrom[&[u8]] {
    fn parse_from(bytes: &[u8]) ParseError!i8 {
        !(parse_signed_bytes(bytes, i8::MIN as i128, i8::MAX as i128).? as i8)
