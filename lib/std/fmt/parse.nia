extend i128 : Parse {
    fn parse(text: &[char]) ParseError!i128 {
        parse_signed(text, i128::MIN, i128::MAX)
    }

    fn parse_radix(text: &[char], radix: u32) ParseError!i128 {
        parse_signed_radix(text, radix, i128::MIN, i128::MAX)
    }
}

