extend bool : ParseFrom[&[char]] {
    fn parse_from(text: &[char]) ParseError!bool {
        parse_bool_units[char](text)
    }
}

extend bool : ParseFrom[&[u8]] {
    fn parse_from(bytes: &[u8]) ParseError!bool {
        parse_bool_units[u8](bytes)
    }
}
