    fn parse(text: &[char]) ParseError!isize {
        !(parse_signed(text, isize::MIN as i128, isize::MAX as i128).? as isize)
    }

    fn parse_radix(text: &[char], radix: u32) ParseError!isize {
        !(parse_signed_radix(text, radix, isize::MIN as i128, isize::MAX as i128).? as isize)
    }
}

extend u8 : Parse {
    fn parse(text: &[char]) ParseError!u8 {
        !(parse_unsigned(text, u8::MAX as u128).? as u8)
    }

    fn parse_radix(text: &[char], radix: u32) ParseError!u8 {
        !(parse_unsigned_radix(text, radix, u8::MAX as u128).? as u8)
    }
}

