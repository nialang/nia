pub enum ParseError: i32 {
    Empty = 1,
    InvalidDigit = 2,
    InvalidSign = 3,
    Overflow = 4,
    InvalidRadix = 5,
    _,
}

pub trait ParseFrom[Input] {
    fn parse_from(input: Input) ParseError!Self;

    fn parse_radix_from(input: Input, radix: u32) ParseError!Self {
        _ = input;
        _ = radix;
        ParseError::InvalidRadix!
    }
}

struct ParsedInteger {
    negative: bool,
    abs: u128,
}

pub fn parse[T, Input](input: Input) ParseError!T
where T: ParseFrom[Input]
{
    [T]::parse_from(input)
}

pub fn parse_radix[T, Input](input: Input, radix: u32) ParseError!T
where T: ParseFrom[Input]
{
    [T]::parse_radix_from(input, radix)
}

fn digit_value_char(ch: char) ?u32 {
    if ch >= '0' and ch <= '9' {
        ?(ch as u32 - '0' as u32)
    } else if ch >= 'a' and ch <= 'z' {
        ?((ch as u32 - 'a' as u32) + 10u32)
    } else if ch >= 'A' and ch <= 'Z' {
        ?((ch as u32 - 'A' as u32) + 10u32)
    } else {
        null
    }
}

fn digit_value_byte(byte: u8) ?u32 {
    if byte >= b'0' and byte <= b'9' {
        ?(byte as u32 - b'0' as u32)
    } else if byte >= b'a' and byte <= b'z' {
        ?((byte as u32 - b'a' as u32) + 10u32)
    } else if byte >= b'A' and byte <= b'Z' {
        ?((byte as u32 - b'A' as u32) + 10u32)
    } else {
        null
    }
}

fn parse_integer_radix_chars(text: &[char], radix: u32, allow_sign: bool) ParseError!ParsedInteger {
    if radix < 2u32 or radix > 36u32 {
        return ParseError::InvalidRadix!;
    }
    if text.len() == 0usize {
        return ParseError::Empty!;
    }

    var index = 0usize;
    var negative = false;
    let first = text[0];
    if first == '-' or first == '+' {
        if not allow_sign {
            return ParseError::InvalidSign!;
        }
        negative = first == '-';
        index = 1usize;
        if index == text.len() {
            return ParseError::InvalidDigit!;
        }
    }

    var value = 0u128;
    let radix_wide = radix as u128;
    while index < text.len() {
        let digit = switch digit_value_char(text[index]) {
            ?value => value,
            null => return ParseError::InvalidDigit!,
        };
        if digit >= radix {
            return ParseError::InvalidDigit!;
        }
        let digit_wide = digit as u128;
        if value > (u128::MAX - digit_wide) / radix_wide {
            return ParseError::Overflow!;
        }
        value = value * radix_wide + digit_wide;
        index += 1usize;
    }

    !{ negative: negative, abs: value }
}

fn parse_integer_radix_bytes(bytes: &[u8], radix: u32, allow_sign: bool) ParseError!ParsedInteger {
    if radix < 2u32 or radix > 36u32 {
        return ParseError::InvalidRadix!;
    }
    if bytes.len() == 0usize {
        return ParseError::Empty!;
    }

    var index = 0usize;
    var negative = false;
    let first = bytes[0];
    if first == b'-' or first == b'+' {
        if not allow_sign {
            return ParseError::InvalidSign!;
        }
        negative = first == b'-';
        index = 1usize;
        if index == bytes.len() {
            return ParseError::InvalidDigit!;
        }
    }

    var value = 0u128;
    let radix_wide = radix as u128;
    while index < bytes.len() {
        let digit = switch digit_value_byte(bytes[index]) {
            ?value => value,
            null => return ParseError::InvalidDigit!,
        };
        if digit >= radix {
            return ParseError::InvalidDigit!;
        }
        let digit_wide = digit as u128;
        if value > (u128::MAX - digit_wide) / radix_wide {
            return ParseError::Overflow!;
        }
        value = value * radix_wide + digit_wide;
        index += 1usize;
    }

    !{ negative: negative, abs: value }
}

fn parse_integer_chars(text: &[char], allow_sign: bool) ParseError!ParsedInteger {
    if text.len() == 0usize {
        return ParseError::Empty!;
    }

    var index = 0usize;
    var negative = false;
    let first = text[0];
    if first == '-' or first == '+' {
        if not allow_sign {
            return ParseError::InvalidSign!;
        }
        negative = first == '-';
        index = 1usize;
        if index == text.len() {
            return ParseError::InvalidDigit!;
        }
    }

    var radix = 10u32;
    if index + 1usize < text.len() and text[index] == '0' {
        let marker = text[index + 1usize];
        if marker == 'x' or marker == 'X' {
            radix = 16u32;
            index += 2usize;
        } else if marker == 'b' or marker == 'B' {
            radix = 2u32;
            index += 2usize;
        } else if marker == 'o' or marker == 'O' {
            radix = 8u32;
            index += 2usize;
        }
        if index == text.len() {
            return ParseError::InvalidDigit!;
        }
    }

    var value = 0u128;
    let radix_wide = radix as u128;
    while index < text.len() {
        let digit = switch digit_value_char(text[index]) {
            ?value => value,
            null => return ParseError::InvalidDigit!,
        };
        if digit >= radix {
            return ParseError::InvalidDigit!;
        }
        let digit_wide = digit as u128;
        if value > (u128::MAX - digit_wide) / radix_wide {
            return ParseError::Overflow!;
        }
        value = value * radix_wide + digit_wide;
        index += 1usize;
    }

    !{ negative: negative, abs: value }
}

fn parse_integer_bytes(bytes: &[u8], allow_sign: bool) ParseError!ParsedInteger {
    if bytes.len() == 0usize {
        return ParseError::Empty!;
    }

    var index = 0usize;
    var negative = false;
    let first = bytes[0];
    if first == b'-' or first == b'+' {
        if not allow_sign {
            return ParseError::InvalidSign!;
        }
        negative = first == b'-';
        index = 1usize;
        if index == bytes.len() {
            return ParseError::InvalidDigit!;
        }
    }

    var radix = 10u32;
    if index + 1usize < bytes.len() and bytes[index] == b'0' {
        let marker = bytes[index + 1usize];
        if marker == b'x' or marker == b'X' {
            radix = 16u32;
            index += 2usize;
        } else if marker == b'b' or marker == b'B' {
            radix = 2u32;
            index += 2usize;
        } else if marker == b'o' or marker == b'O' {
            radix = 8u32;
            index += 2usize;
        }
        if index == bytes.len() {
            return ParseError::InvalidDigit!;
        }
    }

    var value = 0u128;
    let radix_wide = radix as u128;
    while index < bytes.len() {
        let digit = switch digit_value_byte(bytes[index]) {
            ?value => value,
            null => return ParseError::InvalidDigit!,
        };
        if digit >= radix {
            return ParseError::InvalidDigit!;
        }
        let digit_wide = digit as u128;
        if value > (u128::MAX - digit_wide) / radix_wide {
            return ParseError::Overflow!;
        }
        value = value * radix_wide + digit_wide;
        index += 1usize;
    }

    !{ negative: negative, abs: value }
}

fn finish_unsigned(parsed: ParsedInteger, max: u128) ParseError!u128 {
    if parsed.negative {
        return ParseError::InvalidSign!;
    }
    if parsed.abs > max {
        return ParseError::Overflow!;
    }
    !parsed.abs
}

fn finish_signed(parsed: ParsedInteger, min: i128, max: i128) ParseError!i128 {
    let negative_limit = ((0i128 - (min + 1i128)) as u128) + 1u128;
    if parsed.negative {
        if parsed.abs > negative_limit {
            return ParseError::Overflow!;
        }
        if parsed.abs == negative_limit {
            return !min;
        }
        return !(0i128 - parsed.abs as i128);
    }
    if parsed.abs > max as u128 {
        return ParseError::Overflow!;
    }
    !(parsed.abs as i128)
}

fn parse_unsigned_chars(text: &[char], max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_chars(text, false).?, max)
}

fn parse_unsigned_radix_chars(text: &[char], radix: u32, max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_radix_chars(text, radix, false).?, max)
}

fn parse_signed_chars(text: &[char], min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_chars(text, true).?, min, max)
}

fn parse_signed_radix_chars(text: &[char], radix: u32, min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_radix_chars(text, radix, true).?, min, max)
}

fn parse_unsigned_bytes(bytes: &[u8], max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_bytes(bytes, false).?, max)
}

fn parse_unsigned_radix_bytes(bytes: &[u8], radix: u32, max: u128) ParseError!u128 {
    finish_unsigned(parse_integer_radix_bytes(bytes, radix, false).?, max)
}

fn parse_signed_bytes(bytes: &[u8], min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_bytes(bytes, true).?, min, max)
}

fn parse_signed_radix_bytes(bytes: &[u8], radix: u32, min: i128, max: i128) ParseError!i128 {
    finish_signed(parse_integer_radix_bytes(bytes, radix, true).?, min, max)
}

extend i8 : ParseFrom[&[char]] {
    fn parse_from(text: &[char]) ParseError!i8 {
        !(parse_signed_chars(text, i8::MIN as i128, i8::MAX as i128).? as i8)
    }

    fn parse_radix_from(text: &[char], radix: u32) ParseError!i8 {
        !(parse_signed_radix_chars(text, radix, i8::MIN as i128, i8::MAX as i128).? as i8)
    }
}

extend i8 : ParseFrom[&[u8]] {
    fn parse_from(bytes: &[u8]) ParseError!i8 {
        !(parse_signed_bytes(bytes, i8::MIN as i128, i8::MAX as i128).? as i8)
    }

    fn parse_radix_from(bytes: &[u8], radix: u32) ParseError!i8 {
        !(parse_signed_radix_bytes(bytes, radix, i8::MIN as i128, i8::MAX as i128).? as i8)
