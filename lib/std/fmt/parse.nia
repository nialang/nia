extend bool : ParseFrom[&[char]] {
    fn parse_from(text: &[char]) ParseError!bool {
        if text.len() == 4usize and text[0] == 't' and text[1] == 'r' and text[2] == 'u' and text[3] == 'e' {
            !true
        } else if text.len() == 5usize and text[0] == 'f' and text[1] == 'a' and text[2] == 'l' and text[3] == 's' and text[4] == 'e' {
            !false
        } else if text.len() == 0usize {
            ParseError::Empty!
        } else {
            ParseError::InvalidDigit!
        }
    }
}

extend bool : ParseFrom[&[u8]] {
    fn parse_from(bytes: &[u8]) ParseError!bool {
        if bytes.len() == 4usize and bytes[0] == b't' and bytes[1] == b'r' and bytes[2] == b'u' and bytes[3] == b'e' {
            !true
        } else if bytes.len() == 5usize and bytes[0] == b'f' and bytes[1] == b'a' and bytes[2] == b'l' and bytes[3] == b's' and bytes[4] == b'e' {
            !false
        } else if bytes.len() == 0usize {
            ParseError::Empty!
        } else {
            ParseError::InvalidDigit!
        }
    }
}
