using package::fmt::core;

fn format_signed_spec(
    value: i128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!void {
    switch spec.presentation() {
        core::FormatPresentation::Display => formatter.write_signed(value),
        core::FormatPresentation::LowerHex => formatter.write_signed_radix(value, 16u128, false),
        core::FormatPresentation::UpperHex => formatter.write_signed_radix(value, 16u128, true),
        core::FormatPresentation::Binary => formatter.write_signed_radix(value, 2u128, false),
        core::FormatPresentation::Octal => formatter.write_signed_radix(value, 8u128, false),
        _ => core::Error::InvalidTemplate!,
    }
}

fn format_unsigned_spec(
    value: u128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!void {
    switch spec.presentation() {
        core::FormatPresentation::Display => formatter.write_unsigned(value),
        core::FormatPresentation::LowerHex => formatter.write_unsigned_radix(value, 16u128, false),
        core::FormatPresentation::UpperHex => formatter.write_unsigned_radix(value, 16u128, true),
        core::FormatPresentation::Binary => formatter.write_unsigned_radix(value, 2u128, false),
        core::FormatPresentation::Octal => formatter.write_unsigned_radix(value, 8u128, false),
        _ => core::Error::InvalidTemplate!,
    }
}

extend i8 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        format_signed_spec(self.* as i128, formatter, spec)
    }
}

extend i16 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
