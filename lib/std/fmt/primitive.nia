extend usize : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_unsigned(self.* as u128)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        format_unsigned_spec(self.* as u128, formatter, spec)
    }

    fn format_usize_arg(&self) ?usize {
        ?self.*
    }
}

fn format_pointer_spec(
    value: usize,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!void {
    if spec.presentation() == core::FormatPresentation::Display or spec.presentation() == core::FormatPresentation::Pointer {
        formatter.write_pointer_spec(value, spec)
    } else {
        core::Error::InvalidTemplate!
    }
}

extend[T] &T : core::Format
where T: Sized
{
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_pointer(self.* as usize)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        format_pointer_spec(self.* as usize, formatter, spec)
    }
}

extend[T] &mut T : core::Format
where T: Sized
{
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_pointer(self.* as usize)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        format_pointer_spec(self.* as usize, formatter, spec)
    }
}

extend bool : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        if self.* {
            formatter.write_text("true")
        } else {
            formatter.write_text("false")
        }
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        if self.* {
            format_text_spec(formatter, "true", spec)
        } else {
            format_text_spec(formatter, "false", spec)
        }
    }
}

extend char : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_char(self.*)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        if spec.presentation() != core::FormatPresentation::Display or spec.sign_plus() or spec.alternate() {
            return core::Error::InvalidTemplate!;
        }
        let content_width = formatter.precision_width(1usize, spec);
        formatter.write_padding_before(content_width, spec).?;
        if content_width != 0usize {
            formatter.write_char(self.*).?;
        }
        formatter.write_padding_after(content_width, spec)
    }
}

extend [char] : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        var index = 0usize;
        while index < self.len() {
            formatter.write_char(self[index]).?;
            index += 1usize;
        }
        !{}
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        format_text_spec(formatter, self, spec)
    }
}

extend[T] [T] : core::Format
where T: Sized + core::Format
{
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_byte(b'[').?;
        var index = 0usize;
        while index < self.len() {
            if index != 0usize {
                formatter.write_text(", ").?;
            }
            self[index].format(formatter).?;
            index += 1usize;
        }
        formatter.write_byte(b']')
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        if spec.presentation() != core::FormatPresentation::Display or spec.width() != 0usize or spec.has_precision() or spec.sign_plus() or spec.alternate() {
            return core::Error::InvalidTemplate!;
        }
        self.format(formatter)
    }
}
