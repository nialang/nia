using package::fmt::core;

extend i8 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }
}

extend i16 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }
}

extend i32 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }
}

extend i64 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }
}

extend i128 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.*)
    }
}

extend isize : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }
}

extend u8 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_unsigned(self.* as u128)
    }
}

extend u16 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_unsigned(self.* as u128)
    }
}

extend u32 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_unsigned(self.* as u128)
    }
}

extend u64 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_unsigned(self.* as u128)
    }
}

extend u128 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_unsigned(self.*)
    }
}

extend usize : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_unsigned(self.* as u128)
    }
}

extend bool : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        if self.* {
            formatter.write_text("true")
        } else {
            formatter.write_text("false")
        }
    }
}

extend char : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_char(self.*)
    }
}

extend [char] : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        var index = 0usize;
        while index < self.len() {
            formatter.write_char(self[index]).?;
            index += 1usize;
        }
        !{}
    }
}
