    fun formatUsizeArg(&self) ?usize {
        ?self.*
    }
}

fun formatPointerSpec(
    value: usize,
    formatter: &mut Formatter,
    spec: FormatSpec,
) Error!() {
    if spec.presentation() == FormatPresentation::Display or spec.presentation() == FormatPresentation::Pointer {
        formatter.writePointerSpec(value, spec)
    } else {
        .InvalidTemplate!
    }
}

extend[T] &T : Format
where T: Sized
{
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writePointer(self.* as usize)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatPointerSpec(self.* as usize, formatter, spec)
    }
}

extend[T] &mut T : Format
where T: Sized
{
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writePointer(self.* as usize)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatPointerSpec(self.* as usize, formatter, spec)
    }
}

extend bool : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        if self.* {
            formatter.writeText(&"true")
        } else {
            formatter.writeText(&"false")
        }
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        if self.* {
            formatTextSpec(formatter, &"true", spec)
        } else {
            formatTextSpec(formatter, &"false", spec)
        }
    }
}

extend char : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeChar(self.*)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        if spec.presentation() != FormatPresentation::Display or spec.signPlus() or spec.alternate() {
            return .InvalidTemplate!;
        }
        let contentWidth = formatter.precisionWidth(1, spec);
        formatter.writePaddingBefore(contentWidth, spec).?;
        if contentWidth != 0 {
            formatter.writeChar(self.*).?;
        }
        formatter.writePaddingAfter(contentWidth, spec)
    }
}

extend [char] : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeText(self)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatTextSpec(formatter, self, spec)
    }
}

extend [u8] : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeBytes(self)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatBytesSpec(formatter, self, spec)
    }
}

extend[T] [T] : Format
where T: Sized + Format
{
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeByte(b'[').?;
        let mut index: usize = 0;
        while index < self.len() {
            if index != 0 {
                formatter.writeText(&", ").?;
            }
            self[index].format(formatter).?;
            index += 1;
        }
        formatter.writeByte(b']')
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        spec.validate().?;
        if spec.presentation() != FormatPresentation::Display or spec.width() != 0 or spec.hasPrecision() or spec.signPlus() or spec.alternate() {
            return .InvalidTemplate!;
        }
        self.format(formatter)
    }
}
