using root::builtin::Len;
using root::fmt::core;

fun formatSignedSpec(
    value: i128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!() {
    if spec.hasPrecision() {
        return .InvalidTemplate!;
    }
    match spec.presentation() {
        .Display => formatter.writeSignedRadixSpec(value, 10, false, spec),
        .LowerHex => formatter.writeSignedRadixSpec(value, 16, false, spec),
        .UpperHex => formatter.writeSignedRadixSpec(value, 16, true, spec),
        .Binary => formatter.writeSignedRadixSpec(value, 2, false, spec),
        .Octal => formatter.writeSignedRadixSpec(value, 8, false, spec),
        _ => .InvalidTemplate!,
    }
}

fun formatUnsignedSpec(
    value: u128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!() {
    if spec.signPlus() or spec.hasPrecision() {
        return .InvalidTemplate!;
    }
    match spec.presentation() {
        .Display => formatter.writeUnsignedRadixSpec(value, 10, false, spec),
        .LowerHex => formatter.writeUnsignedRadixSpec(value, 16, false, spec),
        .UpperHex => formatter.writeUnsignedRadixSpec(value, 16, true, spec),
        .Binary => formatter.writeUnsignedRadixSpec(value, 2, false, spec),
        .Octal => formatter.writeUnsignedRadixSpec(value, 8, false, spec),
        _ => .InvalidTemplate!,
    }
}

fun formatTextSpec(
    formatter: &mut core::Formatter,
    text: &[char],
    spec: core::FormatSpec,
) core::Error!() {
    if spec.presentation() != core::FormatPresentation::Display or spec.signPlus() or spec.alternate() {
        return .InvalidTemplate!;
    }
    let contentWidth = formatter.precisionWidth(text.len(), spec);
    formatter.writePaddingBefore(contentWidth, spec).?;
    formatter.writeTextPrefix(text, contentWidth).?;
    formatter.writePaddingAfter(contentWidth, spec)
}

fun formatBytesSpec(
    formatter: &mut core::Formatter,
    bytes: &[u8],
    spec: core::FormatSpec,
) core::Error!() {
    if spec.presentation() != core::FormatPresentation::Display or spec.signPlus() or spec.alternate() {
        return .InvalidTemplate!;
    }
    let contentWidth = formatter.precisionWidth(bytes.len(), spec);
    formatter.writePaddingBefore(contentWidth, spec).?;
    formatter.writeBytes(&bytes[0..contentWidth]).?;
    formatter.writePaddingAfter(contentWidth, spec)
}

extend i8 : core::Format {
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writeSigned(self.* as i128)
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        formatSignedSpec(self.* as i128, formatter, spec)
    }
}

