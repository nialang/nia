using pkg::fmt::core;

fn format_signed_spec(
    value: i128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!void {
    if spec.has_precision() {
        return core::Error::InvalidTemplate!;
    }
    switch spec.presentation() {
        core::FormatPresentation::Display => formatter.write_signed_radix_spec(value, 10u128, false, spec),
        core::FormatPresentation::LowerHex => formatter.write_signed_radix_spec(value, 16u128, false, spec),
        core::FormatPresentation::UpperHex => formatter.write_signed_radix_spec(value, 16u128, true, spec),
        core::FormatPresentation::Binary => formatter.write_signed_radix_spec(value, 2u128, false, spec),
        core::FormatPresentation::Octal => formatter.write_signed_radix_spec(value, 8u128, false, spec),
        _ => core::Error::InvalidTemplate!,
    }
}

fn format_unsigned_spec(
    value: u128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!void {
    if spec.sign_plus() or spec.has_precision() {
        return core::Error::InvalidTemplate!;
    }
    switch spec.presentation() {
        core::FormatPresentation::Display => formatter.write_unsigned_radix_spec(value, 10u128, false, spec),
        core::FormatPresentation::LowerHex => formatter.write_unsigned_radix_spec(value, 16u128, false, spec),
        core::FormatPresentation::UpperHex => formatter.write_unsigned_radix_spec(value, 16u128, true, spec),
        core::FormatPresentation::Binary => formatter.write_unsigned_radix_spec(value, 2u128, false, spec),
        core::FormatPresentation::Octal => formatter.write_unsigned_radix_spec(value, 8u128, false, spec),
        _ => core::Error::InvalidTemplate!,
    }
}

fn format_text_spec(
    formatter: &mut core::Formatter,
    text: &[char],
    spec: core::FormatSpec,
) core::Error!void {
    if spec.presentation() != core::FormatPresentation::Display or spec.sign_plus() or spec.alternate() {
        return core::Error::InvalidTemplate!;
    }
    let content_width = formatter.precision_width(text.len(), spec);
    formatter.write_padding_before(content_width, spec).?;
    formatter.write_text_prefix(text, content_width).?;
    formatter.write_padding_after(content_width, spec)
}

extend i8 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
        format_signed_spec(self.* as i128, formatter, spec)
    }
}

extend i16 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!void {
        formatter.write_signed(self.* as i128)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!void {
