    }

    fun formatUsizeArg(&self) ?usize {
        ?self.*
    }
}

fun formatPointerSpec(
    value: usize,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!() {
    if spec.presentation() == core::FormatPresentation::Display or spec.presentation() == core::FormatPresentation::Pointer {
        formatter.writePointerSpec(value, spec)
    } else {
        .InvalidTemplate!
    }
}

extend[T] &T : core::Format
where T: Sized
{
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writePointer(self.* as usize)
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        formatPointerSpec(self.* as usize, formatter, spec)
    }
}

extend[T] &mut T : core::Format
where T: Sized
{
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writePointer(self.* as usize)
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        formatPointerSpec(self.* as usize, formatter, spec)
    }
}

extend bool : core::Format {
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        if self.* {
            formatter.writeText(&"true")
        } else {
            formatter.writeText(&"false")
        }
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        if self.* {
            formatTextSpec(formatter, &"true", spec)
        } else {
            formatTextSpec(formatter, &"false", spec)
        }
    }
}

extend char : core::Format {
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writeChar(self.*)
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        if spec.presentation() != core::FormatPresentation::Display or spec.signPlus() or spec.alternate() {
            return .InvalidTemplate!;
        }
        let contentWidth = formatter.precisionWidth(1, spec);
        formatter.writePaddingBefore(contentWidth, spec).?;
        if contentWidth != 0 {
            formatter.writeChar(self.*).?;
        }
        formatter.writePaddingAfter(contentWidth, spec)
    }
}

extend [char] : core::Format {
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        let mut index: usize = 0;
        while index < self.len() {
            formatter.writeChar(self[index]).?;
            index += 1;
        }
        !()
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        formatTextSpec(formatter, self, spec)
    }
}

extend [u8] : core::Format {
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writeBytes(self)
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        formatBytesSpec(formatter, self, spec)
    }
}

extend[T] [T] : core::Format
where T: Sized + core::Format
{
    fun format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writeByte(b'[').?;
        let mut index: usize = 0;
        while index < self.len() {
            if index != 0 {
                formatter.writeText(&", ").?;
            }
            self[index].format(formatter).?;
            index += 1;
        }
        formatter.writeByte(b']')
    }

    fun formatSpec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        spec.validate().?;
        if spec.presentation() != core::FormatPresentation::Display or spec.width() != 0 or spec.hasPrecision() or spec.signPlus() or spec.alternate() {
            return .InvalidTemplate!;
        }
        self.format(formatter)
    }
}
