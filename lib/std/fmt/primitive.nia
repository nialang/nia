using pkg::fmt::core;

fn format_signed_spec(
    value: i128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!() {
    if spec.has_precision() {
        return core::Error::InvalidTemplate!;
    }
    match spec.presentation() {
        core::FormatPresentation::Display => formatter.writeSignedRadixSpec(value, 10u128, false, spec),
        core::FormatPresentation::LowerHex => formatter.writeSignedRadixSpec(value, 16u128, false, spec),
        core::FormatPresentation::UpperHex => formatter.writeSignedRadixSpec(value, 16u128, true, spec),
        core::FormatPresentation::Binary => formatter.writeSignedRadixSpec(value, 2u128, false, spec),
        core::FormatPresentation::Octal => formatter.writeSignedRadixSpec(value, 8u128, false, spec),
        _ => core::Error::InvalidTemplate!,
    }
}

fn format_unsigned_spec(
    value: u128,
    formatter: &mut core::Formatter,
    spec: core::FormatSpec,
) core::Error!() {
    if spec.sign_plus() or spec.has_precision() {
        return core::Error::InvalidTemplate!;
    }
    match spec.presentation() {
        core::FormatPresentation::Display => formatter.writeUnsignedRadixSpec(value, 10u128, false, spec),
        core::FormatPresentation::LowerHex => formatter.writeUnsignedRadixSpec(value, 16u128, false, spec),
        core::FormatPresentation::UpperHex => formatter.writeUnsignedRadixSpec(value, 16u128, true, spec),
        core::FormatPresentation::Binary => formatter.writeUnsignedRadixSpec(value, 2u128, false, spec),
        core::FormatPresentation::Octal => formatter.writeUnsignedRadixSpec(value, 8u128, false, spec),
        _ => core::Error::InvalidTemplate!,
    }
}

fn format_text_spec(
    formatter: &mut core::Formatter,
    text: &[char],
    spec: core::FormatSpec,
) core::Error!() {
    if spec.presentation() != core::FormatPresentation::Display or spec.sign_plus() or spec.alternate() {
        return core::Error::InvalidTemplate!;
    }
    let content_width = formatter.precision_width(text.len(), spec);
    formatter.writePaddingBefore(content_width, spec).?;
    formatter.writeTextPrefix(text, content_width).?;
    formatter.writePaddingAfter(content_width, spec)
}

fn format_bytes_spec(
    formatter: &mut core::Formatter,
    bytes: &[u8],
    spec: core::FormatSpec,
) core::Error!() {
    if spec.presentation() != core::FormatPresentation::Display or spec.sign_plus() or spec.alternate() {
        return core::Error::InvalidTemplate!;
    }
    let content_width = formatter.precision_width(bytes.len(), spec);
    formatter.writePaddingBefore(content_width, spec).?;
    formatter.writeBytes(&bytes[0..content_width]).?;
    formatter.writePaddingAfter(content_width, spec)
}

extend i8 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writeSigned(self.* as i128)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        format_signed_spec(self.* as i128, formatter, spec)
    }
}

extend i16 : core::Format {
    fn format(&self, formatter: &mut core::Formatter) core::Error!() {
        formatter.writeSigned(self.* as i128)
    }

    fn format_spec(&self, formatter: &mut core::Formatter, spec: core::FormatSpec) core::Error!() {
        format_signed_spec(self.* as i128, formatter, spec)
