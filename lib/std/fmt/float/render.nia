// A layout is planned once, then measured and streamed from the same pieces.
// Width/precision overflow is rejected before the writer sees any bytes.

using root::cmp;
using root::option;
using root::math::float::decimal::Decimal;
using root::fmt::formatter::Formatter;
using root::fmt::spec::{FormatAlignment, FormatSpec};
using root::fmt::traits::Error;

enum Piece {
    Digits(usize, usize),
    Zeros(usize),
    Byte(u8),
    Exponent(i32),
}

// Fixed layout: integer digits/zeros, dot, then leading zeros/digits/trailing
// zeros (at most six pieces). Scientific layout uses at most five pieces.
const layoutCapacity: usize = 6;

struct Layout {
    pieces: [Piece; layoutCapacity],
    used: usize,
    length: usize,
}

extend Piece {
    fun len(self) usize {
        match self {
            .Digits(start, end) => end - start,
            .Zeros(count) => count,
            .Byte(_) => 1,
            .Exponent(exponent) => {
                let mut magnitude = if exponent < 0 { -exponent } else { exponent } as u32;
                let mut length: usize = if exponent < 0 { 2 } else { 1 };
                while magnitude >= 10 {
                    magnitude /= 10;
                    length += 1;
                }
                length
            },
        }
    }

    fun write(self, formatter: &mut Formatter, candidate: &Decimal) Error!() {
        match self {
            .Digits(start, end) => formatter.writeBytes(&candidate.asSlice()[start..end]),
            .Zeros(count) => formatter.writeFill('0', count),
            .Byte(byte) => formatter.writeByte(byte),
            .Exponent(exponent) => {
                if exponent < 0 { formatter.writeByte(b'-').?; }
                let magnitude = if exponent < 0 { -exponent } else { exponent };
                formatter.writeUnsigned(magnitude as u128)
            },
        }
    }
}

extend Layout {
    fun init() Layout { .{ pieces: [Piece::Zeros(0); layoutCapacity], used: 0, length: 0 } }

    fun push(&mut self, piece: Piece) Error!() {
        self.length = self.length.checkedAdd(piece.len()).okOr(Error::InvalidTemplate).?;
        self.pieces[self.used] = piece;
        self.used += 1;
        !()
    }

    fun write(&self, formatter: &mut Formatter, candidate: &Decimal) Error!() {
        for &piece in &self.pieces[..self.used] { piece.write(formatter, candidate).?; }
        !()
    }
}

fun fixedLayout(candidate: &Decimal, precision: ?usize, alternate: bool) Error!Layout {
    let mut layout = Layout::init();
    let point = candidate.point();
    if point <= 0 {
        layout.push(.Byte(b'0')).?;
    } else {
        layout.push(.Digits(0, cmp::min(point as usize, candidate.len()))).?;
        if point > candidate.len() as i64 {
            layout.push(.Zeros(point as usize - candidate.len())).?;
        }
    }
    let fraction = match precision {
        ?count => count,
        // Shortest output keeps exactly the digits after the point.
        null => cmp::max(-(candidate.exponent10() as i64), 0) as usize,
    };
    if fraction != 0 or alternate { layout.push(.Byte(b'.')).?; }
    if fraction != 0 {
        let leading = if point < 0 { cmp::min((-point) as usize, fraction) } else { 0usize };
        if leading != 0 { layout.push(.Zeros(leading)).?; }
        let start = if point > 0 { cmp::min(point as usize, candidate.len()) } else { 0usize };
        let count = cmp::min(candidate.len() - start, fraction - leading);
        if count != 0 { layout.push(.Digits(start, start + count)).?; }
        if fraction > leading + count { layout.push(.Zeros(fraction - leading - count)).?; }
    }
    !layout
}

fun scientificLayout(candidate: &Decimal, alternate: bool) Error!Layout {
    let mut layout = Layout::init();
    layout.push(.Digits(0, 1)).?;
    if candidate.len() > 1 or alternate {
        layout.push(.Byte(b'.')).?;
        layout.push(.Digits(1, candidate.len())).?;
    }
    layout.push(.Byte(b'e')).?;
    layout.push(.Exponent(candidate.exponent())).?;
    !layout
}

fun writeSign(formatter: &mut Formatter, negative: bool, signPlus: bool) Error!() {
    if negative {
        formatter.writeByte(b'-')
    } else if signPlus {
        formatter.writeByte(b'+')
    } else {
        !()
    }
}

// Shortest output takes whichever of fixed and scientific notation is
// shorter; an explicit precision always uses fixed notation.
pub(super) fun write(formatter: &mut Formatter, candidate: &Decimal, negative: bool, spec: FormatSpec) Error!() {
    let fixed = fixedLayout(candidate, spec.precision(), spec.alternate()).?;
    let layout = if spec.precision().isPresent() {
        fixed
    } else {
        let scientific = scientificLayout(candidate, spec.alternate()).?;
        if scientific.length < fixed.length { scientific } else { fixed }
    };
    let signLength: usize = if negative or spec.signPlus() { 1 } else { 0 };
    let totalLength = layout.length.checkedAdd(signLength).okOr(Error::InvalidTemplate).?;
    let padding = if spec.width() > totalLength { spec.width() - totalLength } else { 0 };
    let zeroPad = spec.fill() == '0' and spec.alignment() == FormatAlignment::Right;
    if zeroPad {
        writeSign(formatter, negative, spec.signPlus()).?;
        formatter.writeFill('0', padding).?;
    } else {
        formatter.writePaddingBefore(totalLength, spec).?;
        writeSign(formatter, negative, spec.signPlus()).?;
    }
    layout.write(formatter, candidate).?;
    if zeroPad { !() } else { formatter.writePaddingAfter(totalLength, spec) }
}
