// Exact decimal rounding and shortest round-trip interval search.

using root::cmp;
using root::iter;
using root::slice;
using root::math::float::decimal;

const maxFloatDigits: usize = decimal::digitCapacity;

pub(super) struct Candidate {
    digits: [u8; maxFloatDigits],
    len: usize,
    exponent10: i32,
}

fun nonZeroSuffix(exact: &decimal::Exact) [bool; maxFloatDigits] {
    let mut suffix: [bool; maxFloatDigits] = [false; maxFloatDigits];
    let mut found = false;
    let mut index = exact.len();
    while index != 0 {
        index -= 1;
        suffix[index] = found;
        if exact.digit(index) != b'0' { found = true; }
    }
    suffix
}

fun hasNonZeroAfter(exact: &decimal::Exact, index: usize) bool {
    if (&exact.asSlice()[index + 1..exact.len()])
        .iter().position(\byte -> byte.* != b'0') is ?_
    {
        true
    } else {
        false
    }
}

fun roundedCandidate(exact: &decimal::Exact, precision: usize, tailNonZero: bool) Candidate {
    let len = cmp::min(exact.len(), precision);
    let mut result: Candidate = .{
        digits: [0u8; maxFloatDigits],
        len,
        exponent10: exact.exponent10() + exact.len() as i32 - len as i32,
    };
    _ = (&mut result.digits[0..len]).copyFrom(&exact.asSlice()[0..len]);
    if exact.len() > len {
        let next = exact.digit(len);
        let lastOdd = ((result.digits[len - 1] - b'0') & 1) != 0;
        let roundUp = next > b'5' or (next == b'5' and (tailNonZero or lastOdd));
        if roundUp {
            let mut carry = true;
            let mut index = len;
            while index != 0 and carry {
                index -= 1;
                if result.digits[index] == b'9' {
                    result.digits[index] = b'0';
                } else {
                    result.digits[index] += 1;
                    carry = false;
                }
            }
            if carry {
                result.digits[0] = b'1';
                // Carry already cleared every following digit.
                result.exponent10 += 1;
            }
        }
    }
    while result.len > 1 and result.digits[result.len - 1] == b'0' {
        result.len -= 1;
        result.exponent10 += 1;
    }
    result
}

fun zeroCandidate() Candidate {
    let mut result: Candidate = .{ digits: [0u8; maxFloatDigits], len: 1, exponent10: 0 };
    result.digits[0] = b'0';
    result
}

fun fits(candidate: &Candidate, bits: u64, lower: &decimal::Exact, upper: &decimal::Exact) bool {
    let digits = &candidate.digits[0..candidate.len];
    let even = (bits & 1) == 0;
    if bits != 0 {
        let comparison = decimal::compareDigits(digits, candidate.exponent10, lower);
        if comparison < 0 or (comparison == 0 and not even) { return false; }
    }
    let comparison = decimal::compareDigits(digits, candidate.exponent10, upper);
    comparison < 0 or (comparison == 0 and even)
}

// The same decimal interval search serves binary32 and binary64.
pub(super) fun shortest(
    exact: &decimal::Exact,
    lower: &decimal::Exact,
    upper: &decimal::Exact,
    bits: u64,
    maxPrecision: usize,
) Candidate {
    let suffix = nonZeroSuffix(exact);
    for precision in 1usize..maxPrecision {
        let candidate = roundedCandidate(exact, precision, suffix[precision]);
        if fits(candidate, bits, lower, upper) { return candidate; }
    }
    roundedCandidate(exact, maxPrecision, suffix[maxPrecision])
}

pub(super) fun fixedPrecision(exact: &decimal::Exact, precision: usize) Candidate {
    let point = exact.len() as i64 + exact.exponent10() as i64;
    if point >= exact.len() as i64 {
        return roundedCandidate(exact, exact.len(), false);
    }
    let requiredPrecision = if point < 0 {
        exact.len() + (-point) as usize
    } else {
        exact.len() - point as usize
    };
    if precision >= requiredPrecision {
        return roundedCandidate(exact, exact.len(), false);
    }
    let retained = point + precision as i64;
    if retained <= 0 {
        let roundUp = retained == 0 and (exact.digit(0) > b'5'
            or (exact.digit(0) == b'5' and hasNonZeroAfter(exact, 0)));
        if roundUp {
            let mut result = zeroCandidate();
            result.digits[0] = b'1';
            result.exponent10 = -(precision as i32);
            result
        } else {
            zeroCandidate()
        }
    } else {
        let retained = retained as usize;
        roundedCandidate(exact, retained, hasNonZeroAfter(exact, retained))
    }
}
