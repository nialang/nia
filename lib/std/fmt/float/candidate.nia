// Rounding exact decimals: to a fixed precision, or to the shortest digits
// that still round trip.

using root::cmp;
using root::iter;
using root::option;
using root::slice;
using root::math::float::decimal::{Decimal, Interval, digitCapacity};

// suffix[i] records whether a nonzero digit follows position i, so each
// shortest-search candidate rounds without rescanning the tail.
fun nonZeroSuffix(exact: &Decimal) [bool; digitCapacity] {
    let mut suffix: [bool; digitCapacity] = [false; digitCapacity];
    let mut found = false;
    for index in (0..exact.len()).iter().rev() {
        suffix[index] = found;
        if exact.digit(index) != b'0' {
            found = true;
        }
    }
    suffix
}

fun hasNonZeroAfter(exact: &Decimal, index: usize) bool {
    (&exact.asSlice()[index + 1..]).iter().position(\byte -> byte.* != b'0').isPresent()
}

// The first `precision` digits of `exact`, rounded to nearest, ties to even,
// without trailing zeros. `tailNonZero` reports a nonzero digit after the
// first discarded one.
fun rounded(exact: &Decimal, precision: usize, tailNonZero: bool) Decimal {
    let len = cmp::min(exact.len(), precision);
    let mut result: Decimal = .{
        digits: [0u8; digitCapacity],
        len,
        exponent10: exact.exponent10() + (exact.len() - len) as i32,
    };
    _ = (&mut result.digits[..len]).copyFrom(&exact.asSlice()[..len]);
    if len < exact.len() {
        let next = exact.digit(len);
        let lastOdd = ((result.digits[len - 1] - b'0') & 1) != 0;
        if next > b'5' or (next == b'5' and (tailNonZero or lastOdd)) {
            let mut carry = true;
            for digit in (&mut result.digits[..len]).iterMut().rev() {
                if digit.* == b'9' {
                    digit.* = b'0';
                } else {
                    digit.* += 1;
                    carry = false;
                    break;
                }
            }
            // Every digit was 9: the value became the next power of ten.
            if carry {
                result.digits[0] = b'1';
                result.exponent10 += 1;
            }
        }
    }
    while result.len > 1 and result.digits[result.len - 1] == b'0' {
        result.len -= 1;
        result.exponent10 += 1;
    }
    result
}

fun unitAt(exponent10: i32) Decimal {
    let mut unit = Decimal::zero();
    unit.digits[0] = b'1';
    unit.exponent10 = exponent10;
    unit
}

// The fewest digits that round back to the value `interval` describes.
// `maxPrecision` digits always suffice for the format.
pub(super) fun shortest(exact: &Decimal, interval: &Interval, maxPrecision: usize) Decimal {
    let suffix = nonZeroSuffix(exact);
    for precision in 1usize..maxPrecision {
        let candidate = rounded(exact, precision, suffix[precision]);
        if interval.contains(\[&candidate] bound -> candidate.compare(bound)) {
            return candidate;
        }
    }
    rounded(exact, maxPrecision, suffix[maxPrecision])
}

// `exact` rounded to `precision` digits after the decimal point.
pub(super) fun fixedPrecision(exact: &Decimal, precision: usize) Decimal {
    let fractionDigits = -(exact.exponent10() as i64);
    if precision as i64 >= fractionDigits {
        return rounded(exact, exact.len(), false);
    }
    let retained = exact.point() + precision as i64;
    if retained > 0 {
        let retained = retained as usize;
        return rounded(exact, retained, hasNonZeroAfter(exact, retained));
    }
    // Every digit lies beyond the precision, so the result is zero or one
    // unit in the last kept place.
    let first = exact.digit(0);
    let roundUp = retained == 0 and (first > b'5' or (first == b'5' and hasNonZeroAfter(exact, 0)));
    if roundUp {
        unitAt(-(precision as i32))
    } else {
        Decimal::zero()
    }
}
