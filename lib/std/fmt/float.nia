// Finite IEEE-754 formatting. All entry points share exact rounding and layout.
// Invalid specifications and non-finite values fail before any output is written.

module candidate;
module render;

using root::math::float::BinaryFloat;
using root::math::float::BinaryFloatRepresentation;
using root::math::float::decimal;
using root::fmt::float::{candidate, render};
using super::formatter::Formatter;
using super::spec::{FormatPresentation, FormatSpec};
using super::traits::{Error, Format};

fun validate(spec: FormatSpec, finite: bool) Error!() {
    spec.validate().?;
    if spec.presentation() != FormatPresentation::Display {
        .InvalidTemplate!
    } else if not finite {
        .NonFinite!
    } else {
        !()
    }
}

extend Formatter {
    // Shortest round-trip output for a finite IEEE value.
    pub fun writeFloat[F](&mut self, value: F) Error!() where F: BinaryFloat {
        self.writeFloatSpec(value, FormatSpec::display())
    }

    // Precision counts fractional digits, rounded to nearest, ties to even.
    // Value/spec errors are detected before writing; writer errors can leave
    // partial output, just like other Formatter methods.
    pub fun writeFloatSpec[F](&mut self, value: F, spec: FormatSpec) Error!()
    where F: BinaryFloat
    {
        validate(spec, value.isFinite()).?;
        let bits = value.magnitudeBits();
        let exact = decimal::exact[F](bits);
        let digits = if spec.precision() is ?precision {
            candidate::fixedPrecision(exact, precision)
        } else {
            let lower = decimal::midpoint[F](bits - if bits == 0 { 0u64 } else { 1u64 });
            let upper = decimal::midpoint[F](bits);
            candidate::shortest(
                exact,
                lower,
                upper,
                bits,
                [F as BinaryFloat]::shortestDigits,
            )
        };
        render::write(self, digits, value.signBit(), spec)
    }
}

extend f64 : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeFloat(self.*)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatter.writeFloatSpec(self.*, spec)
    }
}

extend f32 : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeFloat(self.*)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatter.writeFloatSpec(self.*, spec)
    }
}
