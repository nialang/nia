// Finite IEEE-754 formatting. All entry points share exact rounding and layout.
// Invalid specifications and non-finite values fail before any output is written.

module candidate;
module render;

using root::math::float as ieee;
using root::math::float::decimal;
using root::fmt::float::{candidate, render};
using super::formatter::Formatter;
using super::spec::{FormatPresentation, FormatSpec};
using super::traits::{Error, Format};

fun validate(spec: FormatSpec, finite: bool) Error!() {
    spec.validate().?;
    if spec.presentation() != FormatPresentation::Display or not finite {
        .InvalidTemplate!
    } else {
        !()
    }
}

extend Formatter {
    // Writes the shortest round-trip representation; non-finite values fail.
    pub fun writeFloat64(&mut self, value: f64) Error!() {
        self.writeFloat64Spec(value, FormatSpec::display())
    }

    pub fun writeFloat32(&mut self, value: f32) Error!() {
        self.writeFloat32Spec(value, FormatSpec::display())
    }

    // Precision is fractional decimal digits with ties-to-even rounding.
    // Non-finite input and non-display presentations return InvalidTemplate.
    pub fun writeFloat64Spec(&mut self, value: f64, spec: FormatSpec) Error!() {
        validate(spec, ieee::isFinite64(value)).?;
        let bits = ieee::toBits64(value) & 0x7fffffffffffffffu64;
        let exact = decimal::exact64(bits);
        let digits = if spec.precision() is ?precision {
            candidate::fixedPrecision(exact, precision)
        } else {
            let lower = decimal::midpoint64(bits - if bits == 0 { 0u64 } else { 1u64 });
            let upper = decimal::midpoint64(bits);
            candidate::shortest(exact, lower, upper, bits, 17)
        };
        render::write(self, digits, ieee::signBit64(value), spec)
    }

    pub fun writeFloat32Spec(&mut self, value: f32, spec: FormatSpec) Error!() {
        validate(spec, ieee::isFinite32(value)).?;
        let bits = ieee::toBits32(value) & 0x7fffffffu32;
        let exact = decimal::exact32(bits);
        let digits = if spec.precision() is ?precision {
            candidate::fixedPrecision(exact, precision)
        } else {
            let lower = decimal::midpoint32(bits - if bits == 0 { 0u32 } else { 1u32 });
            let upper = decimal::midpoint32(bits);
            candidate::shortest(exact, lower, upper, bits as u64, 9)
        };
        render::write(self, digits, ieee::signBit32(value), spec)
    }
}

extend f64 : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeFloat64(self.*)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatter.writeFloat64Spec(self.*, spec)
    }
}

extend f32 : Format {
    fun format(&self, formatter: &mut Formatter) Error!() {
        formatter.writeFloat32(self.*)
    }

    fun formatSpec(&self, formatter: &mut Formatter, spec: FormatSpec) Error!() {
        formatter.writeFloat32Spec(self.*, spec)
    }
}
