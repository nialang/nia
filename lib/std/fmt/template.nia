using pkg::fmt::core;
using pkg::io;

struct ParsedSpec {
    spec: core::FormatSpec,
    next_index: usize,
    dynamic_width: bool,
    dynamic_precision: bool,
}

pub fn print_unchecked[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!void
where W: io::Writer
{
    print_template(writer, template, args, false)
}

fn parse_presentation(ch: char) ?core::FormatPresentation {
    if ch == 'x' {
        ?core::FormatPresentation::LowerHex
    } else if ch == 'X' {
        ?core::FormatPresentation::UpperHex
    } else if ch == 'b' {
        ?core::FormatPresentation::Binary
    } else if ch == 'o' {
        ?core::FormatPresentation::Octal
    } else if ch == 'p' {
        ?core::FormatPresentation::Pointer
    } else {
        null
    }
}

fn parse_alignment(ch: char) ?core::FormatAlignment {
    if ch == '<' {
        ?core::FormatAlignment::Left
    } else if ch == '>' {
        ?core::FormatAlignment::Right
    } else if ch == '^' {
        ?core::FormatAlignment::Center
    } else {
        null
    }
}

fn digit_value(ch: char) ?usize {
    if ch >= '0' and ch <= '9' {
        ?((ch as u32 - '0' as u32) as usize)
    } else {
        null
    }
}

fn parse_spec_end(
    template: &[char],
    index: usize,
    presentation: core::FormatPresentation,
    width: usize,
    precision: ?usize,
    dynamic_width: bool,
    dynamic_precision: bool,
    fill: char,
    alignment: core::FormatAlignment,
    sign_plus: bool,
    alternate: bool,
) core::Error!ParsedSpec {
    if index >= template.len() or template[index] != '}' {
        return core::Error::InvalidTemplate!;
    }
    !{
        spec: core::FormatSpec::init(presentation, width, precision, fill, alignment, sign_plus, alternate),
        next_index: index + 1usize,
        dynamic_width: dynamic_width,
        dynamic_precision: dynamic_precision,
    }
}

fn parse_extended_spec(template: &[char], start: usize) core::Error!ParsedSpec {
    let mut index = start;
    let mut fill = ' ';
    let mut alignment = core::FormatAlignment::None;
    let mut sign_plus = false;
    let mut alternate = false;

    let mut parsing_flags = true;
    while parsing_flags and index < template.len() {
        let ch = template[index];
        if index + 1usize < template.len() {
            if parse_alignment(template[index + 1usize]) is ?parsed_alignment {
                fill = ch;
                alignment = parsed_alignment;
                index += 2usize;
                continue;
            }
        }
        switch parse_alignment(ch) {
            ?parsed_alignment => {
                alignment = parsed_alignment;
                index += 1usize;
            },
            null => {
                if ch == '0' {
                        fill = '0';
                        alignment = core::FormatAlignment::Right;
                        index += 1usize;
                    } else if ch == '+' and not sign_plus {
                        sign_plus = true;
                        index += 1usize;
                    } else if ch == '#' and not alternate {
                        alternate = true;
                        index += 1usize;
                    } else {
                        parsing_flags = false;
                    }
            },
        }
    }

    let mut width = 0usize;
    let mut dynamic_width = false;
    if index + 1usize < template.len() and template[index] == '{' and template[index + 1usize] == '}' {
        dynamic_width = true;
        index += 2usize;
    } else {
        while index < template.len() {
            let digit = switch digit_value(template[index]) {
                ?digit => {
                    digit
                },
                null => {
                    break;
                },
            };
            width = width * 10usize + digit;
            index += 1usize;
        }
    }

    let mut precision: ?usize = null;
    let mut dynamic_precision = false;
    if index < template.len() and template[index] == '.' {
        index += 1usize;
        if index + 1usize < template.len() and template[index] == '{' and template[index + 1usize] == '}' {
            dynamic_precision = true;
            index += 2usize;
        } else {
            let mut parsed_precision = 0usize;
            let mut has_digit = false;
            while index < template.len() {
                let digit = switch digit_value(template[index]) {
                    ?digit => {
                        digit
                    },
                    null => {
                        break;
                    },
                };
                parsed_precision = parsed_precision * 10usize + digit;
                has_digit = true;
                index += 1usize;
            }
            if not has_digit {
                return core::Error::InvalidTemplate!;
            }
            precision = ?parsed_precision;
        }
    }

    let mut presentation = core::FormatPresentation::Display;
    if index < template.len() {
        if parse_presentation(template[index]) is ?parsed {
            presentation = parsed;
            index += 1usize;
        }
    }

    parse_spec_end(
        template,
        index,
        presentation,
        width,
        precision,
        dynamic_width,
        dynamic_precision,
        fill,
        alignment,
        sign_plus,
        alternate,
    )
}

fn next_usize_arg(args: &[&core::Format], arg_index: &mut usize, checked_args: bool) core::Error!usize {
    if checked_args and arg_index.* >= args.len() {
        return core::Error::MissingArgument!;
    }
    if arg_index.* >= args.len() {
        return core::Error::InvalidTemplate!;
    }
    let value = switch args[arg_index.*].format_usize_arg() {
        ?value => {
            value
        },
        null => {
            return core::Error::InvalidTemplate!;
        },
    };
    arg_index.* += 1usize;
    !value
}

fn resolve_dynamic_spec(
    parsed: ParsedSpec,
    args: &[&core::Format],
    arg_index: &mut usize,
    checked_args: bool,
) core::Error!core::FormatSpec {
    let mut width = parsed.spec.width();
    let mut precision = parsed.spec.precision();
    if parsed.dynamic_width {
        width = next_usize_arg(args, arg_index, checked_args).?;
    }
    if parsed.dynamic_precision {
        precision = ?next_usize_arg(args, arg_index, checked_args).?;
    }
    !core::FormatSpec::init(
        parsed.spec.presentation(),
        width,
        precision,
        parsed.spec.fill(),
        parsed.spec.alignment(),
        parsed.spec.sign_plus(),
        parsed.spec.alternate(),
    )
}

fn print_template[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
    checked_args: bool,
) core::Error!void
where W: io::Writer
{
    let mut formatter = core::Formatter::init(writer);
    let mut index = 0usize;
    let mut arg_index = 0usize;
    while index < template.len() {
        let ch = template[index];
        if ch == '{' {
            if index + 1usize >= template.len() {
                return core::Error::InvalidTemplate!;
            }
            let next = template[index + 1usize];
            if next == '}' {
                if checked_args and arg_index >= args.len() {
                    return core::Error::MissingArgument!;
                }
                args[arg_index].format_spec(&mut formatter, core::FormatSpec::display()).?;
                arg_index += 1usize;
                index += 2usize;
            } else if next == '{' {
                formatter.write_char('{').?;
                index += 2usize;
            } else if next == ':' {
                let parsed = parse_extended_spec(template, index + 2usize).?;
                if checked_args and arg_index >= args.len() {
                    return core::Error::MissingArgument!;
                }
                let value_index = arg_index;
                arg_index += 1usize;
                let spec = resolve_dynamic_spec(parsed, args, &mut arg_index, checked_args).?;
                args[value_index].format_spec(&mut formatter, spec).?;
                index = parsed.next_index;
            } else {
                return core::Error::InvalidTemplate!;
            }
        } else if ch == '}' {
            if index + 1usize < template.len() and template[index + 1usize] == '}' {
                formatter.write_char('}').?;
                index += 2usize;
            } else {
                return core::Error::InvalidTemplate!;
            }
        } else {
            formatter.write_char(ch).?;
            index += 1usize;
        }
    }
    if checked_args and arg_index != args.len() {
        return core::Error::ExtraArgument!;
    }
    !{}
}

pub fn print_checked[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!void
where W: io::Writer
{
    print_template(writer, template, args, true)
}

extend[W] W
where W: io::Writer
{
    pub fn print(
        &mut self,
        template: &[char],
        args: &[&core::Format],
    ) core::Error!void {
        print_checked(self, template, args)
    }
}
