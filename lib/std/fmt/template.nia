using package::fmt::core;
using package::io;

struct ParsedSpec {
    spec: core::FormatSpec,
    next_index: usize,
}

pub fn print_unchecked[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!void
where W: io::Writer
{
    print_template(writer, template, args, false)
}

fn parse_presentation(ch: char) ?core::FormatPresentation {
    if ch == 'x' {
        ?core::FormatPresentation::LowerHex
    } else if ch == 'X' {
        ?core::FormatPresentation::UpperHex
    } else if ch == 'b' {
        ?core::FormatPresentation::Binary
    } else if ch == 'o' {
        ?core::FormatPresentation::Octal
    } else {
        null
    }
}

fn digit_value(ch: char) ?usize {
    if ch >= '0' and ch <= '9' {
        ?((ch as u32 - '0' as u32) as usize)
    } else {
        null
    }
}

fn parse_spec_end(
    template: &[char],
    index: usize,
    presentation: core::FormatPresentation,
    width: usize,
    fill: char,
    alignment: core::FormatAlignment,
    sign_plus: bool,
    alternate: bool,
) core::Error!ParsedSpec {
    if index >= template.len() or template[index] != '}' {
        return core::Error::InvalidTemplate!;
    }
    !{
        spec: core::FormatSpec::init(presentation, width, fill, alignment, sign_plus, alternate),
        next_index: index + 1usize,
    }
}

fn parse_extended_spec(template: &[char], start: usize) core::Error!ParsedSpec {
    var index = start;
    var fill = ' ';
    var alignment = core::FormatAlignment::None;
    var sign_plus = false;
    var alternate = false;

    var parsing_flags = true;
    while parsing_flags and index < template.len() {
        let ch = template[index];
        if ch == '<' {
            alignment = core::FormatAlignment::Left;
            index += 1usize;
        } else if ch == '>' {
            alignment = core::FormatAlignment::Right;
            index += 1usize;
        } else if ch == '^' {
            alignment = core::FormatAlignment::Center;
            index += 1usize;
        } else if ch == '0' {
            fill = '0';
            alignment = core::FormatAlignment::Right;
            index += 1usize;
        } else if ch == '+' and not sign_plus {
            sign_plus = true;
            index += 1usize;
        } else if ch == '#' and not alternate {
            alternate = true;
            index += 1usize;
        } else {
            parsing_flags = false;
        }
    }

    var width = 0usize;
    while index < template.len() {
        let digit = switch digit_value(template[index]) {
            ?digit => digit,
            null => break,
        };
        width = width * 10usize + digit;
        index += 1usize;
    }

    var presentation = core::FormatPresentation::Display;
    if index < template.len() {
        switch parse_presentation(template[index]) {
            ?parsed => {
                presentation = parsed;
                index += 1usize;
            },
            null => {},
        }
    }

    parse_spec_end(template, index, presentation, width, fill, alignment, sign_plus, alternate)
}

fn print_template[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
    checked_args: bool,
) core::Error!void
where W: io::Writer
{
    var formatter = core::Formatter::init(writer);
    var index = 0usize;
    var arg_index = 0usize;
    while index < template.len() {
        let ch = template[index];
        if ch == '{' {
            if index + 1usize >= template.len() {
                return core::Error::InvalidTemplate!;
            }
            let next = template[index + 1usize];
            if next == '}' {
                if checked_args and arg_index >= args.len() {
                    return core::Error::MissingArgument!;
                }
                args[arg_index].format_spec(&mut formatter, core::FormatSpec::display()).?;
                arg_index += 1usize;
                index += 2usize;
            } else if next == '{' {
                formatter.write_char('{').?;
                index += 2usize;
            } else if next == ':' {
                let parsed = parse_extended_spec(template, index + 2usize).?;
                if checked_args and arg_index >= args.len() {
                    return core::Error::MissingArgument!;
                }
                args[arg_index].format_spec(&mut formatter, parsed.spec).?;
                arg_index += 1usize;
                index = parsed.next_index;
            } else {
                return core::Error::InvalidTemplate!;
            }
        } else if ch == '}' {
            if index + 1usize < template.len() and template[index + 1usize] == '}' {
                formatter.write_char('}').?;
                index += 2usize;
            } else {
                return core::Error::InvalidTemplate!;
            }
        } else {
            formatter.write_char(ch).?;
            index += 1usize;
        }
    }
    if checked_args and arg_index != args.len() {
        return core::Error::ExtraArgument!;
    }
    !{}
}

pub fn print_checked[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!void
where W: io::Writer
{
    print_template(writer, template, args, true)
}

extend[W] W
where W: io::Writer
{
    pub fn print(
        &mut self,
        template: &[char],
        args: &[&core::Format],
    ) core::Error!void {
        print_checked(self, template, args)
    }
}
