using pkg::fmt::core;
using pkg::io;
using pkg::math;

struct ParsedSpec {
    spec: core::FormatSpec,
    nextIndex: usize,
    dynamicWidth: bool,
    dynamicPrecision: bool,
}

fn parsePresentation(ch: char) ?core::FormatPresentation {
    if ch == 'x' {
        ?core::FormatPresentation::LowerHex
    } else if ch == 'X' {
        ?core::FormatPresentation::UpperHex
    } else if ch == 'b' {
        ?core::FormatPresentation::Binary
    } else if ch == 'o' {
        ?core::FormatPresentation::Octal
    } else if ch == 'p' {
        ?core::FormatPresentation::Pointer
    } else {
        null
    }
}

fn parseAlignment(ch: char) ?core::FormatAlignment {
    if ch == '<' {
        ?core::FormatAlignment::Left
    } else if ch == '>' {
        ?core::FormatAlignment::Right
    } else if ch == '^' {
        ?core::FormatAlignment::Center
    } else {
        null
    }
}

fn digitValue(ch: char) ?usize {
    if ch >= '0' and ch <= '9' {
        ?((ch as u32 - '0' as u32) as usize)
    } else {
        null
    }
}

fn appendDecimalDigit(value: usize, digit: usize) core::Error!usize {
    let scaled = match value.checkedMul(10usize) {
        ?scaled => scaled,
        null => return core::Error::InvalidTemplate!,
    };
    match scaled.checkedAdd(digit) {
        ?next => !next,
        null => core::Error::InvalidTemplate!,
    }
}

fn parseSpecEnd(
    template: &[char],
    index: usize,
    presentation: core::FormatPresentation,
    width: usize,
    precision: ?usize,
    dynamicWidth: bool,
    dynamicPrecision: bool,
    fill: char,
    alignment: core::FormatAlignment,
    signPlus: bool,
    alternate: bool,
) core::Error!ParsedSpec {
    if index >= template.len() or template[index] != '}' {
        return core::Error::InvalidTemplate!;
    }
    !ParsedSpec {
        spec: core::FormatSpec::init(presentation, width, precision, fill, alignment, signPlus, alternate),
        nextIndex: index + 1usize,
        dynamicWidth: dynamicWidth,
        dynamicPrecision: dynamicPrecision,
    }
}

fn parseExtendedSpec(template: &[char], start: usize) core::Error!ParsedSpec {
    let mut index = start;
    let mut fill = ' ';
    let mut alignment = core::FormatAlignment::None;
    let mut signPlus = false;
    let mut alternate = false;

    let mut parsingFlags = true;
    while parsingFlags and index < template.len() {
        let ch = template[index];
        if index + 1usize < template.len() {
            if parseAlignment(template[index + 1usize]) is ?parsedAlignment {
                fill = ch;
                alignment = parsedAlignment;
                index += 2usize;
                continue;
            }
        }
        match parseAlignment(ch) {
            ?parsedAlignment => {
                alignment = parsedAlignment;
                index += 1usize;
            },
            null => {
                if ch == '0' {
                        fill = '0';
                        alignment = core::FormatAlignment::Right;
                        index += 1usize;
                    } else if ch == '+' and not signPlus {
                        signPlus = true;
                        index += 1usize;
                    } else if ch == '#' and not alternate {
                        alternate = true;
                        index += 1usize;
                    } else {
                        parsingFlags = false;
                    }
            },
        }
    }

    let mut width = 0usize;
    let mut dynamicWidth = false;
    if index + 1usize < template.len() and template[index] == '{' and template[index + 1usize] == '}' {
        dynamicWidth = true;
        index += 2usize;
    } else {
        while index < template.len() {
            let digit = match digitValue(template[index]) {
                ?digit => {
                    digit
                },
                null => {
                    break;
                },
            };
            width = appendDecimalDigit(width, digit).?;
            index += 1usize;
        }
    }

    let mut precision: ?usize = null;
    let mut dynamicPrecision = false;
    if index < template.len() and template[index] == '.' {
        index += 1usize;
        if index + 1usize < template.len() and template[index] == '{' and template[index + 1usize] == '}' {
            dynamicPrecision = true;
            index += 2usize;
        } else {
            let mut parsedPrecision = 0usize;
            let mut hasDigit = false;
            while index < template.len() {
                let digit = match digitValue(template[index]) {
                    ?digit => {
                        digit
                    },
                    null => {
                        break;
                    },
                };
                parsedPrecision = appendDecimalDigit(parsedPrecision, digit).?;
                hasDigit = true;
                index += 1usize;
            }
            if not hasDigit {
                return core::Error::InvalidTemplate!;
            }
            precision = ?parsedPrecision;
        }
    }

    let mut presentation = core::FormatPresentation::Display;
    if index < template.len() {
        if parsePresentation(template[index]) is ?parsed {
            presentation = parsed;
            index += 1usize;
        }
    }

    parseSpecEnd(
        template,
        index,
        presentation,
        width,
        precision,
        dynamicWidth,
        dynamicPrecision,
        fill,
        alignment,
        signPlus,
        alternate,
    )
}

fn nextUsizeArg(args: &[&core::Format], argIndex: &mut usize) core::Error!usize {
    if argIndex.* >= args.len() {
        return core::Error::MissingArgument!;
    }
    let value = match args[argIndex.*].formatUsizeArg() {
        ?value => {
            value
        },
        null => {
            return core::Error::InvalidTemplate!;
        },
    };
    argIndex.* += 1usize;
    !value
}

fn resolveDynamicSpec(
    parsed: ParsedSpec,
    args: &[&core::Format],
    argIndex: &mut usize,
) core::Error!core::FormatSpec {
    let mut width = parsed.spec.width();
    let mut precision = parsed.spec.precision();
    if parsed.dynamicWidth {
        width = nextUsizeArg(args, argIndex).?;
    }
    if parsed.dynamicPrecision {
        precision = ?nextUsizeArg(args, argIndex).?;
    }
    !core::FormatSpec::init(
        parsed.spec.presentation(),
        width,
        precision,
        parsed.spec.fill(),
        parsed.spec.alignment(),
        parsed.spec.signPlus(),
        parsed.spec.alternate(),
    )
}

fn printTemplate[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!()
where W: io::Writer
{
    let mut formatter = core::Formatter::init(writer);
    let mut index = 0usize;
    let mut argIndex = 0usize;
    while index < template.len() {
        let ch = template[index];
        if ch == '{' {
            if index + 1usize >= template.len() {
                return core::Error::InvalidTemplate!;
            }
            let next = template[index + 1usize];
            if next == '}' {
                if argIndex >= args.len() {
                    return core::Error::MissingArgument!;
                }
                args[argIndex].formatSpec(&mut formatter, core::FormatSpec::display()).?;
                argIndex += 1usize;
                index += 2usize;
            } else if next == '{' {
                formatter.writeChar('{').?;
                index += 2usize;
            } else if next == ':' {
                let parsed = parseExtendedSpec(template, index + 2usize).?;
                if argIndex >= args.len() {
                    return core::Error::MissingArgument!;
                }
                let valueIndex = argIndex;
                argIndex += 1usize;
                let spec = resolveDynamicSpec(parsed, args, &mut argIndex).?;
                args[valueIndex].formatSpec(&mut formatter, spec).?;
                index = parsed.nextIndex;
            } else {
                return core::Error::InvalidTemplate!;
            }
        } else if ch == '}' {
            if index + 1usize < template.len() and template[index + 1usize] == '}' {
                formatter.writeChar('}').?;
                index += 2usize;
            } else {
                return core::Error::InvalidTemplate!;
            }
        } else {
            formatter.writeChar(ch).?;
            index += 1usize;
        }
    }
    if argIndex != args.len() {
        return core::Error::ExtraArgument!;
    }
    !()
}

pub fn printChecked[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!()
where W: io::Writer
{
    printTemplate(writer, template, args)
}

extend[W] W
where W: io::Writer
{
    pub fn print(
        &mut self,
        template: &[char],
        args: &[&core::Format],
    ) core::Error!() {
        printChecked(self, template, args)
    }
}
