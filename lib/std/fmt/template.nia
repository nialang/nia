using package::fmt::core;
using package::io;

pub fn print_unchecked[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!void
where W: io::Writer
{
    print_template(writer, template, args, false)
}

fn parse_spec(ch: char) ?core::FormatSpec {
    if ch == 'x' {
        ?core::FormatSpec::lower_hex()
    } else if ch == 'X' {
        ?core::FormatSpec::upper_hex()
    } else if ch == 'b' {
        ?core::FormatSpec::binary()
    } else if ch == 'o' {
        ?core::FormatSpec::octal()
    } else {
        null
    }
}

fn print_template[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
    checked_args: bool,
) core::Error!void
where W: io::Writer
{
    var formatter = core::Formatter::init(writer);
    var index = 0usize;
    var arg_index = 0usize;
    while index < template.len() {
        let ch = template[index];
        if ch == '{' {
            if index + 1usize >= template.len() {
                return core::Error::InvalidTemplate!;
            }
            let next = template[index + 1usize];
            if next == '}' {
                if checked_args and arg_index >= args.len() {
                    return core::Error::MissingArgument!;
                }
                args[arg_index].format_spec(&mut formatter, core::FormatSpec::display()).?;
                arg_index += 1usize;
                index += 2usize;
            } else if next == '{' {
                formatter.write_char('{').?;
                index += 2usize;
            } else {
                if index + 2usize >= template.len() or template[index + 2usize] != '}' {
                    return core::Error::InvalidTemplate!;
                }
                let spec = switch parse_spec(next) {
                    ?spec => spec,
                    null => return core::Error::InvalidTemplate!,
                };
                if checked_args and arg_index >= args.len() {
                    return core::Error::MissingArgument!;
                }
                args[arg_index].format_spec(&mut formatter, spec).?;
                arg_index += 1usize;
                index += 3usize;
            }
        } else if ch == '}' {
            if index + 1usize < template.len() and template[index + 1usize] == '}' {
                formatter.write_char('}').?;
                index += 2usize;
            } else {
                return core::Error::InvalidTemplate!;
            }
        } else {
            formatter.write_char(ch).?;
            index += 1usize;
        }
    }
    if checked_args and arg_index != args.len() {
        return core::Error::ExtraArgument!;
    }
    !{}
}

pub fn print_checked[W](
    writer: &mut W,
    template: &[char],
    args: &[&core::Format],
) core::Error!void
where W: io::Writer
{
    print_template(writer, template, args, true)
}

extend[W] W
where W: io::Writer
{
    pub fn print(
        &mut self,
        template: &[char],
        args: &[&core::Format],
    ) core::Error!void {
        print_checked(self, template, args)
    }
}
