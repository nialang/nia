// Fixed-capacity integer arithmetic for IEEE binary32/binary64 conversion.
// 5^1075 times a 54-bit significand needs fewer than 2,560 bits.

using root::iter;
using root::slice;

const limbCapacity: usize = 80;
pub(root) const digitCapacity: usize = 800;
const decimalChunkBase: u32 = 1000000000;
const decimalChunkDigits: usize = 9;
const chunkCapacity: usize = (digitCapacity + decimalChunkDigits - 1) / decimalChunkDigits;
// 5^13 is the largest power of five that fits in one u32 multiplier.
const powerOfFiveChunk: u32 = 1220703125;
const powerOfFiveChunkExponent: i32 = 13;

pub(super) struct BigUInt {
    limbs: [u32; limbCapacity],
    used: usize,
}

extend BigUInt {
    pub(super) fun fromU64(value: u64) BigUInt {
        let mut result: BigUInt = .{ limbs: [0u32; limbCapacity], used: 0 };
        if value != 0 {
            result.limbs[0] = value as u32;
            result.used = 1;
            let high = (value >> 32) as u32;
            if high != 0 {
                result.limbs[1] = high;
                result.used = 2;
            }
        }
        result
    }

    fun multiplySmall(&mut self, factor: u32) () {
        let mut carry: u64 = 0;
        // Carry flows low to high. Keep an indexed loop here: the measured
        // iterMut version doubled conversion time on this hot limb pass.
        let mut index: usize = 0;
        while index < self.used {
            let product = self.limbs[index] as u64 * factor as u64 + carry;
            self.limbs[index] = product as u32;
            carry = product >> 32;
            index += 1;
        }
        if carry != 0 {
            // Internal range violations must never silently discard high bits.
            if self.used == limbCapacity { root::builtin::trap(); }
            self.limbs[self.used] = carry as u32;
            self.used += 1;
        }
    }

    pub(super) fun multiplyPowerOfFive(&mut self, exponent: i32) () {
        let mut remaining = exponent;
        while remaining >= powerOfFiveChunkExponent {
            self.multiplySmall(powerOfFiveChunk);
            remaining -= powerOfFiveChunkExponent;
        }
        while remaining != 0 {
            self.multiplySmall(5);
            remaining -= 1;
        }
    }

    pub(super) fun shiftLeft(&mut self, count: u32) () {
        let mut remaining = count;
        while remaining >= 31 {
            self.multiplySmall(0x80000000u32);
            remaining -= 31;
        }
        if remaining != 0 { self.multiplySmall(1u32 << remaining); }
    }

    fun divideSmall(&mut self, divisor: u32) u32 {
        let mut remainder: u64 = 0;
        // Remainders flow high to low. As with multiplySmall, indexing avoids
        // the measured iterMut overhead in this conversion hot loop.
        let mut index = self.used;
        while index != 0 {
            index -= 1;
            let dividend = (remainder << 32) | self.limbs[index] as u64;
            self.limbs[index] = (dividend / divisor as u64) as u32;
            remainder = dividend % divisor as u64;
        }
        while self.used != 0 and self.limbs[self.used - 1] == 0 { self.used -= 1; }
        remainder as u32
    }

    // Writes the decimal digits, most significant first, and returns their
    // count. The value is consumed: it is zero afterwards.
    pub(super) fun drainDecimal(&mut self, out: &mut [u8]) usize {
        if self.used == 0 {
            out[0] = b'0';
            return 1;
        }
        // Base 10^9 turns hundreds of single-digit divisions into a small chunk pass.
        let mut chunks: [u32; chunkCapacity];
        let mut chunkCount: usize = 0;
        while self.used != 0 {
            chunks[chunkCount] = self.divideSmall(decimalChunkBase);
            chunkCount += 1;
        }
        let mut len: usize = 0;
        for &chunk in (&chunks[..chunkCount]).iter().rev() {
            // Leading zeros only pad the lower chunks to their full width.
            let width = if len == 0 { decimalWidth(chunk) } else { decimalChunkDigits };
            let mut remaining = chunk;
            for digit in (&mut out[len..len + width]).iterMut().rev() {
                digit.* = b'0' + (remaining % 10) as u8;
                remaining /= 10;
            }
            len += width;
        }
        len
    }
}

fun decimalWidth(value: u32) usize {
    let mut width: usize = 1;
    let mut remaining = value;
    while remaining >= 10 {
        remaining /= 10;
        width += 1;
    }
    width
}
