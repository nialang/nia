// Exact decimal magnitudes and rounding intervals shared by parsing and
// formatting. Syntax and rendering depend on this layer, never on each other.

module big_uint;

using root::cmp;
using root::iter;
using root::slice;
using root::math::float::BinaryFormat;
using root::math::float::decimal::big_uint::{BigUInt, Digits};

pub(root) using big_uint::digitCapacity;

// ASCII digits followed by an implicit run of zeros, scaled by 10^exponent10.
// The same representation holds exact values and rounded output candidates.
pub(root) struct Decimal {
    digits: [u8; digitCapacity],
    len: usize,
    exponent10: i32,
}

extend Decimal {
    pub(root) fun zero() Decimal {
        Decimal::fromDigits(Digits::zero(), 0)
    }

    fun fromDigits(digits: Digits, exponent10: i32) Decimal {
        .{ digits: digits.bytes, len: digits.len, exponent10 }
    }

    pub(root) fun len(&self) usize { self.len }
    pub(root) fun digit(&self, index: usize) u8 { self.digits[index] }
    pub(root) fun exponent10(&self) i32 { self.exponent10 }
    pub(root) fun asSlice(&self) &[u8] { &self.digits[..self.len] }
    pub(root) fun isZero(&self) bool { self.len == 1 and self.digits[0] == b'0' }

    // Digits before the decimal point; negative when zeros follow the point.
    pub(root) fun point(&self) i64 { self.len as i64 + self.exponent10 as i64 }

    // The exponent of the first digit in scientific notation.
    pub(root) fun exponent(&self) i32 { (self.point() - 1) as i32 }

    pub(root) fun compare(&self, exact: &Decimal) cmp::Ordering {
        compareDigits(self.asSlice().iter().map(\byte -> byte.*), self.point() as i128, self.isZero(), exact)
    }
}

pub(root) fun fromBinary(significand: u64, exponent2: i32) Decimal {
    if significand == 0 {
        return Decimal::zero();
    }
    let mut value = BigUInt::fromU64(significand);
    if exponent2 >= 0 {
        value.shiftLeft(exponent2 as u32);
        Decimal::fromDigits(value.toDigits(), 0)
    } else {
        value.multiplyPowerOfFive(-exponent2);
        Decimal::fromDigits(value.toDigits(), exponent2)
    }
}

struct Binary {
    significand: u64,
    exponent2: i32,
}

fun decode[F](bits: u64) Binary
where F: BinaryFormat
{
    let fractionBits = [F as BinaryFormat]::fractionBits;
    let exponentBits = [F as BinaryFormat]::exponentBits;
    let exponent = ((bits & [F]::exponentMask()) >> fractionBits) as i32;
    let fraction = bits & [F]::fractionMask();
    let bias = ((1u32 << (exponentBits - 1)) - 1) as i32;
    // Subnormals have no hidden bit and share the smallest normal exponent.
    if exponent == 0 {
        .{ significand: fraction, exponent2: 1 - bias - fractionBits as i32 }
    } else {
        .{ significand: (1u64 << fractionBits) | fraction, exponent2: exponent - bias - fractionBits as i32 }
    }
}

pub(root) fun exact[F](bits: u64) Decimal
where F: BinaryFormat
{
    let binary = decode[F](bits);
    fromBinary(binary.significand, binary.exponent2)
}

// The midpoint between a value and its upper neighbour. After the largest
// finite value the neighbour is the next power of two, so the same midpoint
// decides whether a decimal at the halfway tie overflows.
pub(root) fun midpoint[F](lowerBits: u64) Decimal
where F: BinaryFormat
{
    let binary = decode[F](lowerBits);
    fromBinary(binary.significand * 2 + 1, binary.exponent2 - 1)
}

// The decimals that round to one binary value: everything between the
// midpoints to its neighbours, including the midpoints when the value's
// significand is even (ties to even). Zero has no lower neighbour in the
// nonnegative magnitudes that conversion works with.
pub(root) struct Interval {
    lower: ?Decimal,
    upper: Decimal,
    closed: bool,
}

pub(root) fun interval[F](bits: u64) Interval
where F: BinaryFormat
{
    .{
        lower: if bits == 0 { null } else { ?midpoint[F](bits - 1) },
        upper: midpoint[F](bits),
        closed: (bits & 1) == 0,
    }
}

extend Interval {
    // `compare` orders the candidate against a boundary.
    pub(root) fun contains(&self, compare: &Fun(&Decimal) cmp::Ordering) bool {
        let aboveLower = match self.lower {
            ?lower => match compare(lower) {
                .Greater => true,
                .Equal => self.closed,
                .Less => false,
            },
            null => true,
        };
        aboveLower and match compare(self.upper) {
            .Less => true,
            .Equal => self.closed,
            .Greater => false,
        }
    }
}

// Orders a decimal, given as its significant digits and the order of its
// decimal point, against `exact`. Digits missing from either side are zeros.
pub(root) fun compareDigits[I](digits: I, order: i128, zero: bool, exact: &Decimal) cmp::Ordering
where I: Iterator[Item = u8]
{
    if zero or exact.isZero() {
        return if zero and exact.isZero() { .Equal } else if zero { .Less } else { .Greater };
    }
    let exactOrder = exact.point() as i128;
    if order != exactOrder {
        return if order < exactOrder { .Less } else { .Greater };
    }
    let mut remaining = digits;
    for &right in exact.asSlice() {
        let left = if remaining.next() is ?digit { digit } else { b'0' };
        if left != right {
            return if left < right { .Less } else { .Greater };
        }
    }
    for left in remaining {
        if left != b'0' {
            return .Greater;
        }
    }
    .Equal
}
