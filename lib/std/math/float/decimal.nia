// Shared exact decimal magnitudes and rounding boundaries for IEEE conversion.
// Parsing syntax belongs to std::parse; integer storage is independent.

module big_uint;

using root::cmp;
using root::iter;
using root::slice;
using root::math::float::decimal::big_uint::{BigUInt, Digits};

pub(root) using big_uint::digitCapacity;

pub(root) struct Exact {
    digits: Digits,
    exponent10: i32,
}

extend Exact {
    pub(root) fun len(&self) usize { self.digits.len }
    pub(root) fun digit(&self, index: usize) u8 { self.digits.bytes[index] }
    pub(root) fun exponent10(&self) i32 { self.exponent10 }

    pub(root) fun asSlice(&self) &[u8] {
        &self.digits.bytes[0..self.digits.len]
    }

    pub(root) fun isZero(&self) bool {
        self.digits.len == 1 and self.digits.bytes[0] == b'0'
    }
}

pub(root) fun fromBinary(significand: u64, exponent2: i32) Exact {
    if significand == 0 {
        let mut digits: Digits = .{ bytes: [0u8; digitCapacity], len: 1 };
        digits.bytes[0] = b'0';
        return .{ digits, exponent10: 0 };
    }
    let mut value = BigUInt::fromU64(significand);
    let mut exponent10: i32 = 0;
    if exponent2 >= 0 {
        value.shiftLeft(exponent2 as u32);
    } else {
        value.multiplyPowerOfFive(-exponent2);
        exponent10 = exponent2;
    }
    .{ digits: value.toDigits(), exponent10 }
}

struct Binary {
    significand: u64,
    exponent2: i32,
}

fun decode32(bits: u32) Binary {
    let exponent = (bits >> 23) & 0xffu32;
    let fraction = bits & 0x007fffffu32;
    .{
        significand: if exponent == 0 { fraction as u64 } else { (0x00800000u32 | fraction) as u64 },
        exponent2: if exponent == 0 { -149 } else { exponent as i32 - 150 },
    }
}

fun decode64(bits: u64) Binary {
    let exponent = ((bits >> 52) & 0x7ffu64) as u32;
    let fraction = bits & 0x000fffffffffffffu64;
    .{
        significand: if exponent == 0 { fraction } else { 0x0010000000000000u64 | fraction },
        exponent2: if exponent == 0 { -1074 } else { exponent as i32 - 1075 },
    }
}

pub(root) fun exact32(bits: u32) Exact {
    let binary = decode32(bits);
    fromBinary(binary.significand, binary.exponent2)
}

pub(root) fun exact64(bits: u64) Exact {
    let binary = decode64(bits);
    fromBinary(binary.significand, binary.exponent2)
}

// The upper neighbour of the largest finite value is the conceptual power of
// two beyond it. The same midpoint construction handles the overflow tie.
pub(root) fun midpoint32(lowerBits: u32) Exact {
    let binary = decode32(lowerBits);
    fromBinary(binary.significand * 2 + 1, binary.exponent2 - 1)
}

pub(root) fun midpoint64(lowerBits: u64) Exact {
    let binary = decode64(lowerBits);
    fromBinary(binary.significand * 2 + 1, binary.exponent2 - 1)
}

pub(root) fun compareDigits(input: &[u8], exponent10: i32, exact: &Exact) i32 {
    if input.iter().position(\byte -> byte.* != b'0') is null {
        return if exact.isZero() { 0 } else { -1 };
    }
    let leftOrder = input.len() as i64 + exponent10 as i64;
    let rightOrder = exact.len() as i64 + exact.exponent10() as i64;
    if leftOrder < rightOrder { return -1; }
    if leftOrder > rightOrder { return 1; }
    for index in 0..cmp::max(input.len(), exact.len()) {
        let left = if index < input.len() { input[index] } else { b'0' };
        let right = if index < exact.len() { exact.digit(index) } else { b'0' };
        if left < right { return -1; }
        if left > right { return 1; }
    }
    0
}
