// Internal decimal syntax and exact-integer support for IEEE conversion.

// IEEE binary64 midpoints need fewer than 2,560 bits and 800 decimal digits.
// The largest exact denominator is 5^1075, multiplied by at most 54 bits.
const limbCapacity: usize = 80;
const digitCapacity: usize = 800;

pub(root) enum SyntaxError: i32 {
    Empty = 1,
    Invalid = 2,
    _,
}

pub(root) struct Parsed {
    negative: bool,
    zero: bool,
    digitsStart: usize,
    digitsEnd: usize,
    firstDigit: usize,
    significantDigits: usize,
    exponent10: i64,
}

pub(root) struct BigUInt {
    limbs: [u32; limbCapacity],
    used: usize,
}

pub(root) struct Digits {
    bytes: [u8; digitCapacity],
    len: usize,
}

pub(root) struct Exact {
    digits: Digits,
    exponent10: i32,
}

extend Exact {
    pub(root) fun len(&self) usize { self.digits.len }
    pub(root) fun digit(&self, index: usize) u8 { self.digits.bytes[index] }
    pub(root) fun exponent10(&self) i32 { self.exponent10 }
}

fun isDigit(byte: u8) bool {
    byte >= b'0' and byte <= b'9'
}

fun appendExponent(value: i64, digit: u8) i64 {
    if value >= 1000000000000 { return value; }
    let next = value * 10 + (digit - b'0') as i64;
    if next > 1000000000000 { 1000000000000 } else { next }
}

pub(root) fun parse(input: &[u8]) SyntaxError!Parsed {
    if input.len() == 0 { return .Empty!; }
    let negative = input[0] == b'-';
    if input[0] == b'+' { return .Invalid!; }
    let start: usize = if negative { 1 } else { 0 };
    if start == input.len() { return .Invalid!; }

    let mut index = start;
    let mut fractionDigits: usize = 0;
    let mut firstDigit = input.len();
    let mut significantDigits: usize = 0;
    let mut sawDigit = false;
    let mut sawDot = false;
    while index < input.len() {
        let byte = input[index];
        if isDigit(byte) {
            sawDigit = true;
            if sawDot { fractionDigits += 1; }
            if firstDigit == input.len() and byte != b'0' { firstDigit = index; }
            if firstDigit != input.len() { significantDigits += 1; }
            index += 1;
        } else if byte == b'.' and not sawDot {
            sawDot = true;
            index += 1;
        } else {
            break;
        }
    }
    if not sawDigit or (sawDot and input[index - 1] == b'.') { return .Invalid!; }
    let digitsEnd = index;

    let mut exponent: i64 = 0;
    let mut exponentNegative = false;
    if index < input.len() and (input[index] == b'e' or input[index] == b'E') {
        index += 1;
        if index < input.len() and (input[index] == b'-' or input[index] == b'+') {
            exponentNegative = input[index] == b'-';
            index += 1;
        }
        let exponentStart = index;
        while index < input.len() and isDigit(input[index]) {
            exponent = appendExponent(exponent, input[index]);
            index += 1;
        }
        if exponentStart == index { return .Invalid!; }
    }
    if index != input.len() { return .Invalid!; }
    if exponentNegative { exponent = -exponent; }
    let adjusted = exponent - fractionDigits as i64;
    !.{ negative, zero: firstDigit == input.len(), digitsStart: start, digitsEnd, firstDigit, significantDigits, exponent10: adjusted }
}

extend BigUInt {
    pub(root) fun fromU64(value: u64) BigUInt {
        let mut result: BigUInt = .{ limbs: [0u32; limbCapacity], used: 0 };
        if value != 0 {
            result.limbs[0] = value as u32;
            result.used = 1;
            let high = (value >> 32) as u32;
            if high != 0 {
                result.limbs[1] = high;
                result.used = 2;
            }
        }
        result
    }

    pub(root) fun multiplySmall(&mut self, factor: u32) () {
        let mut carry: u64 = 0;
        let mut index: usize = 0;
        while index < self.used {
            let product = self.limbs[index] as u64 * factor as u64 + carry;
            self.limbs[index] = product as u32;
            carry = product >> 32;
            index += 1;
        }
        if carry != 0 and self.used < limbCapacity {
            self.limbs[self.used] = carry as u32;
            self.used += 1;
        }
    }

    pub(root) fun shiftLeftOne(&mut self) () {
        let mut carry: u32 = 0;
        let mut index: usize = 0;
        while index < self.used {
            let next = self.limbs[index] >> 31;
            let widened = ((self.limbs[index] as u64) << 1) | carry as u64;
            self.limbs[index] = widened as u32;
            carry = next;
            index += 1;
        }
        if carry != 0 and self.used < limbCapacity {
            self.limbs[self.used] = carry;
            self.used += 1;
        }
    }

    pub(root) fun divideSmall(&mut self, divisor: u32) u32 {
        let mut remainder: u64 = 0;
        let mut index = self.used;
        while index != 0 {
            index -= 1;
            let dividend = (remainder << 32) | self.limbs[index] as u64;
            self.limbs[index] = (dividend / divisor as u64) as u32;
            remainder = dividend % divisor as u64;
        }
        while self.used != 0 and self.limbs[self.used - 1] == 0 { self.used -= 1; }
        remainder as u32
    }

    pub(root) fun compareParsed(input: &[u8], parsed: Parsed, exact: Exact) i32 {
        let leftOrder = parsed.significantDigits as i128 + parsed.exponent10 as i128;
        let rightOrder = exact.digits.len as i128 + exact.exponent10 as i128;
        if parsed.zero { return if exact.digits.len == 1 and exact.digits.bytes[0] == b'0' { 0 } else { -1 }; }
        if leftOrder < rightOrder { return -1; }
        if leftOrder > rightOrder { return 1; }

        let mut sourceIndex = parsed.firstDigit;
        let mut leftIndex: usize = 0;
        let mut rightIndex: usize = 0;
        while leftIndex < parsed.significantDigits or rightIndex < exact.digits.len {
            let mut leftDigit = b'0';
            if leftIndex < parsed.significantDigits {
                while sourceIndex < parsed.digitsEnd and not isDigit(input[sourceIndex]) {
                    sourceIndex += 1;
                }
                leftDigit = input[sourceIndex];
                sourceIndex += 1;
            }
            let rightDigit = if rightIndex < exact.digits.len { exact.digits.bytes[rightIndex] } else { b'0' };
            if leftDigit < rightDigit { return -1; }
            if leftDigit > rightDigit { return 1; }
            leftIndex += 1;
            rightIndex += 1;
        }
        0
    }

    pub(root) fun toDigits(&self) Digits {
        let mut value = self.*;
        let mut result: Digits = .{ bytes: [0u8; digitCapacity], len: 0 };
        if value.used == 0 {
            result.bytes[0] = b'0';
            result.len = 1;
            return result;
        }
        while value.used != 0 {
            result.bytes[result.len] = b'0' + value.divideSmall(10) as u8;
            result.len += 1;
        }
        let mut left: usize = 0;
        let mut right = result.len - 1;
        while left < right {
            let digit = result.bytes[left];
            result.bytes[left] = result.bytes[right];
            result.bytes[right] = digit;
            left += 1;
            right -= 1;
        }
        result
    }
}

pub(root) fun fromBinary(significand: u64, exponent2: i32) Exact {
    if significand == 0 {
        let mut digits: Digits = .{ bytes: [0u8; digitCapacity], len: 1 };
        digits.bytes[0] = b'0';
        return .{ digits, exponent10: 0 };
    }
    let mut value = BigUInt::fromU64(significand);
    let mut exponent10: i32 = 0;
    if exponent2 >= 0 {
        let mut index: i32 = 0;
        while index < exponent2 { value.shiftLeftOne(); index += 1; }
    } else {
        let mut index: i32 = 0;
        while index < -exponent2 { value.multiplySmall(5); index += 1; }
        exponent10 = exponent2;
    }
    .{ digits: value.toDigits(), exponent10 }
}

pub(root) fun midpoint32(lowerBits: u32) Exact {
    let exponentField = (lowerBits >> 23) & 0xffu32;
    let fraction = lowerBits & 0x007fffffu32;
    let significand = if exponentField == 0 {
        fraction as u64
    } else {
        (0x00800000u32 | fraction) as u64
    };
    let exponent2 = if exponentField == 0 { -150 } else { exponentField as i32 - 151 };
    fromBinary(significand * 2 + 1, exponent2)
}

pub(root) fun midpoint64(lowerBits: u64) Exact {
    let exponentField = ((lowerBits >> 52) & 0x7ffu64) as u32;
    let fraction = lowerBits & 0x000fffffffffffffu64;
    let significand = if exponentField == 0 {
        fraction
    } else {
        0x0010000000000000u64 | fraction
    };
    let exponent2 = if exponentField == 0 { -1075 } else { exponentField as i32 - 1076 };
    fromBinary(significand * 2 + 1, exponent2)
}

pub(root) fun compareDigits(input: &[u8], length: usize, exponent10: i32, exact: Exact) i32 {
    let mut nonZero = false;
    let mut scan: usize = 0;
    while scan < length {
        if input[scan] != b'0' { nonZero = true; }
        scan += 1;
    }
    if not nonZero {
        if exact.digits.len == 1 and exact.digits.bytes[0] == b'0' { return 0; }
        return -1;
    }
    let leftOrder = length as i64 + exponent10 as i64;
    let rightOrder = exact.digits.len as i64 + exact.exponent10 as i64;
    if leftOrder < rightOrder { return -1; }
    if leftOrder > rightOrder { return 1; }
    let mut index: usize = 0;
    while index < length or index < exact.digits.len {
        let leftDigit = if index < length { input[index] } else { b'0' };
        let rightDigit = if index < exact.digits.len { exact.digits.bytes[index] } else { b'0' };
        if leftDigit < rightDigit { return -1; }
        if leftDigit > rightDigit { return 1; }
        index += 1;
    }
    0
}
