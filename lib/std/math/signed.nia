// Checked arithmetic for signed integers.

using root::math::checked::{
    CheckedAdd,
    CheckedSub,
    CheckedMul,
    CheckedDiv,
    CheckedRem,
    CheckedNeg,
    CheckedAbs,
};

extend i8 : CheckedAdd[i8] {
    type Output = i8;

    fun checkedAdd(self, rhs: i8) ?i8 {
        if rhs > 0 and self > i8::MAX - rhs {
            null
        } else if rhs < 0 and self < i8::MIN - rhs {
            null
        } else {
            ?(self + rhs)
        }
    }
}

extend i8 : CheckedSub[i8] {
    type Output = i8;

    fun checkedSub(self, rhs: i8) ?i8 {
        if rhs > 0 and self < i8::MIN + rhs {
            null
        } else if rhs < 0 and self > i8::MAX + rhs {
            null
        } else {
            ?(self - rhs)
        }
    }
}

extend i8 : CheckedMul[i8] {
    type Output = i8;

    fun checkedMul(self, rhs: i8) ?i8 {
        if self == 0 or rhs == 0 {
            ?0
        } else if self > 0 and rhs > 0 {
            if self > i8::MAX / rhs { null } else { ?(self * rhs) }
        } else if self > 0 and rhs < 0 {
            if rhs < i8::MIN / self { null } else { ?(self * rhs) }
        } else if self < 0 and rhs > 0 {
            if self < i8::MIN / rhs { null } else { ?(self * rhs) }
        } else {
            if self < i8::MAX / rhs { null } else { ?(self * rhs) }
        }
    }
}

extend i8 : CheckedDiv[i8] {
    type Output = i8;

    fun checkedDiv(self, rhs: i8) ?i8 {
        if rhs == 0 or (self == i8::MIN and rhs == -1) {
            null
        } else {
            ?(self / rhs)
        }
    }
}

extend i8 : CheckedRem[i8] {
    type Output = i8;

    fun checkedRem(self, rhs: i8) ?i8 {
        if rhs == 0 or (self == i8::MIN and rhs == -1) {
            null
        } else {
            ?(self % rhs)
        }
    }
}

extend i8 : CheckedNeg {
    type Output = i8;

    fun checkedNeg(self) ?i8 {
        if self == i8::MIN {
            null
        } else {
            ?(0 - self)
        }
    }
}

extend i8 : CheckedAbs {
    type Output = i8;

    fun checkedAbs(self) ?i8 {
        if self < 0 {
            self.checkedNeg()
        } else {
            ?self
        }
    }
}

