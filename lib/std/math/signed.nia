        } else if self > 0 and rhs > 0 {
            if self > i16::MAX / rhs { null } else { ?(self * rhs) }
        } else if self > 0 and rhs < 0 {
            if rhs < i16::MIN / self { null } else { ?(self * rhs) }
        } else if self < 0 and rhs > 0 {
            if self < i16::MIN / rhs { null } else { ?(self * rhs) }
        } else {
            if self < i16::MAX / rhs { null } else { ?(self * rhs) }
        }
    }
}

