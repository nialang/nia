// Checked arithmetic for unsigned integers.

using root::math::checked::{
    CheckedAdd,
    CheckedSub,
    CheckedMul,
    CheckedDiv,
    CheckedRem,
    CheckedNeg,
    CheckedAbs,
};

extend u8 : CheckedAdd[u8] {
    type Output = u8;

    fun checkedAdd(self, rhs: u8) ?u8 {
        if self > u8::MAX - rhs {
            null
        } else {
            ?(self + rhs)
        }
    }
}

extend u8 : CheckedSub[u8] {
    type Output = u8;

    fun checkedSub(self, rhs: u8) ?u8 {
        if self < rhs {
            null
        } else {
            ?(self - rhs)
        }
    }
}

extend u8 : CheckedMul[u8] {
    type Output = u8;

    fun checkedMul(self, rhs: u8) ?u8 {
        if self == 0 or rhs == 0 {
            ?0
        } else if self > u8::MAX / rhs {
            null
        } else {
            ?(self * rhs)
        }
    }
}

extend u8 : CheckedDiv[u8] {
    type Output = u8;

    fun checkedDiv(self, rhs: u8) ?u8 {
        if rhs == 0 {
            null
        } else {
            ?(self / rhs)
        }
    }
}

extend u8 : CheckedRem[u8] {
    type Output = u8;

    fun checkedRem(self, rhs: u8) ?u8 {
        if rhs == 0 {
            null
        } else {
            ?(self % rhs)
        }
    }
}

