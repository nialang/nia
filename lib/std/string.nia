// Owned Unicode scalar text.
//
// `String` owns allocator-backed `char` storage; slices and iterators borrow it.
// UTF-8 and formatting APIs preserve validation, allocation, and writer errors,
// and mutation commits only after the complete operation can succeed.

pub(pkg) module hash;

using pkg::collections;
using pkg::error;
using pkg::fmt;
using pkg::io;
using pkg::mem;
using pkg::slice;
using pkg::unicode;

using pkg::string::hash as stringHash;

pub enum TextError {
    InvalidUtf8(unicode::Utf8DecodeError),
    Allocation(mem::Error),
}

pub enum TextFormatError {
    InvalidUtf8(unicode::Utf8DecodeError),
    Allocation(mem::Error),
    Format(fmt::Error),
}

pub struct String {
    text: collections::ArrayList[char],
    formatBytes: collections::ArrayList[u8],
}

struct TextFormatWriter {
    allocator: &mut mem::Allocator,
    bytes: collections::ArrayList[u8],
    failure: ?mem::Error,
}

extend String {
    pub fn init() String {
        Self {
            text: .init(),
            formatBytes: .init(),
        }
    }

    pub fn initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!String {
        let mut text = collections::ArrayList[char]::initCapacity(allocator, capacity).?;
        !String {
            text: text,
            formatBytes: .init(),
        }
    }

    pub fn fromSlice(allocator: &mut mem::Allocator, text: &[char]) mem::Error!String {
        let mut out = String::initCapacity(allocator, text.len()).?;
        out.append(allocator, text).?;
        !out
    }

    pub fn fromUtf8(allocator: &mut mem::Allocator, bytes: &[u8]) TextError!String {
        let view = unicode::Utf8View::fromBytes(bytes)
            .mapError(&\cause: unicode::Utf8DecodeError -> TextError::InvalidUtf8(cause)).?;
        !(String::fromUtf8View(allocator, view).?)
    }

    pub fn fromUtf8View(allocator: &mut mem::Allocator, view: unicode::Utf8View) mem::Error!String {
        let mut out = String::initCapacity(allocator, view.scalarCount()).?;
        for scalar in view {
            out.text.appendAssumeCapacity(scalar);
        }
        !out
    }

    pub fn appendUtf8(&mut self, allocator: &mut mem::Allocator, bytes: &[u8]) TextError!() {
        let view = unicode::Utf8View::fromBytes(bytes)
            .mapError(&\cause: unicode::Utf8DecodeError -> TextError::InvalidUtf8(cause)).?;
        !(self.appendUtf8View(allocator, view).?)
    }

    pub fn appendUtf8View(&mut self, allocator: &mut mem::Allocator, view: unicode::Utf8View) mem::Error!() {
        let oldLen = self.len();
        let newLen = match oldLen.checkedAdd(view.scalarCount()) {
            ?value => value,
            null => return mem::Error::OutOfMemory!,
        };
        self.text.ensureTotalCapacity(allocator, newLen).?;
        for scalar in view {
            self.text.appendAssumeCapacity(scalar);
        }
        !()
    }

    pub fn appendFormat(
        &mut self,
        allocator: &mut mem::Allocator,
        template: &[char],
        args: &[&fmt::Format],
    ) TextFormatError!() {
        if self.releaseFormatBytes(allocator) is error! {
            return .Allocation(error)!;
        }
        let oldLen = self.len();
        let mut committed = false;
        defer if not committed {
            self.text.truncate(oldLen);
        };

        let mut writer = TextFormatWriter::init(allocator);
        if fmt::printChecked(&mut writer, template, args) is error! {
            let primary = writer.textError(error);
            return writer.finish(self, ?primary);
        }
        if writer.appendTo(self) is error! {
            return writer.finish(self, ?error);
        }
        writer.finish(self, null).?;
        committed = true;
        !()
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let mut cleanup: error::CleanupAccumulator[mem::Error] = .init();
        cleanup.attempt(self.text.deinit(allocator));
        cleanup.attempt(self.formatBytes.deinit(allocator));
        if not cleanup.isClean() {
            return cleanup.finish();
        }
        !()
    }

    fn releaseFormatBytes(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.formatBytes.deinit(allocator)
    }

    pub fn text(&self) &[char] {
        self.text.asSlice()
    }

    pub fn textMut(&mut self) &mut [char] {
        self.text.asMutSlice()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn capacity(&self) usize {
        self.text.capacity()
    }

    pub fn isEmpty(&self) bool {
        self.text.isEmpty()
    }

    pub fn clear(&mut self) () {
        self.text.clear()
    }

    pub fn equals(&self, other: &[char]) bool {
        self.text().equals(other)
    }

    pub fn startsWith(&self, prefix: &[char]) bool {
        self.text().startsWith(prefix)
    }

    pub fn endsWith(&self, suffix: &[char]) bool {
        self.text().endsWith(suffix)
    }

    pub fn find(&self, needle: &[char]) ?usize {
        self.text().find(needle)
    }

    pub fn contains(&self, needle: &[char]) bool {
        self.text().contains(needle)
    }

    pub fn split(&self, separator: &[char]) slice::SliceSplit[char] {
        self.text().split(separator)
    }

    pub fn replaceAll(
        &self,
        allocator: &mut mem::Allocator,
        needle: &[char],
        replacement: &[char],
    ) mem::Error!String {
        replaceAllText(allocator, self.text(), needle, replacement)
    }

    pub fn ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        self.text.ensureTotalCapacity(allocator, capacity)
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        self.text.reserve(allocator, additional)
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, ch: char) mem::Error!() {
        self.text.push(allocator, ch)
    }

    pub fn pushAssumeCapacity(&mut self, ch: char) () {
        self.text.appendAssumeCapacity(ch)
    }

    pub fn append(&mut self, allocator: &mut mem::Allocator, text: &[char]) mem::Error!() {
        self.text.appendSlice(allocator, text)
    }

    pub fn appendAssumeCapacity(&mut self, text: &[char]) () {
        self.text.appendSliceAssumeCapacity(text)
    }

    pub fn intoOwnedSlice(&mut self, allocator: &mut mem::Allocator) mem::Error!mem::SliceAllocation[char] {
        self.releaseFormatBytes(allocator).?;
        self.text.intoOwnedSlice(allocator)
    }
}

extend [char] {
    pub fn replaceAll(
        &self,
        allocator: &mut mem::Allocator,
        needle: &[char],
        replacement: &[char],
    ) mem::Error!String {
        replaceAllText(allocator, self, needle, replacement)
    }
}

extend [&[char]] {
    pub fn join(
        &self,
        allocator: &mut mem::Allocator,
        separator: &[char],
    ) mem::Error!String {
        let separatorCount = if self.isEmpty() { 0 } else { self.len() - 1 };
        let mut outputLen = match separator.len().checkedMul(separatorCount) {
            ?value => value,
            null => return mem::Error::OutOfMemory!,
        };
        for &part in self {
            outputLen = match outputLen.checkedAdd(part.len()) {
                ?value => value,
                null => return mem::Error::OutOfMemory!,
            };
        }

        let mut out = String::initCapacity(allocator, outputLen).?;
        for index in 0..self.len() {
            if index != 0 {
                out.appendAssumeCapacity(separator);
            }
            out.appendAssumeCapacity(self[index]);
        }
        !out
    }
}

fn replaceAllText(
    allocator: &mut mem::Allocator,
    source: &[char],
    needle: &[char],
    replacement: &[char],
) mem::Error!String {
    let matchCount = source.split(needle).count() - 1;
    let removed = match needle.len().checkedMul(matchCount) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let added = match replacement.len().checkedMul(matchCount) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };
    let outputLen = match (source.len() - removed).checkedAdd(added) {
        ?value => value,
        null => return mem::Error::OutOfMemory!,
    };

    let mut out = String::initCapacity(allocator, outputLen).?;
    let mut firstPart = true;
    for part in source.split(needle) {
        if firstPart {
            firstPart = false;
        } else {
            out.appendAssumeCapacity(replacement);
        }
        out.appendAssumeCapacity(part);
    }
    !out
}

extend String : Eq[String] {
    fn eq(&self, other: &String) bool {
        self.equals(other.text())
    }

    fn ne(&self, other: &String) bool {
        not self.equals(other.text())
    }
}

extend TextFormatWriter {
    fn init(allocator: &mut mem::Allocator) TextFormatWriter {
        Self {
            allocator: allocator,
            bytes: .init(),
            failure: null,
        }
    }

    fn deinit(&mut self) mem::Error!() {
        self.bytes.deinit(self.allocator)
    }

    fn finish(&mut self, out: &mut String, primary: ?TextFormatError) TextFormatError!() {
        if self.deinit() is error! {
            out.formatBytes = self.bytes;
            self.bytes = .init();
            if primary is ?cause {
                return cause!;
            }
            return .Allocation(error)!;
        }
        if primary is ?cause {
            return cause!;
        }
        !()
    }

    fn appendTo(&mut self, out: &mut String) TextFormatError!() {
        !(out.appendUtf8(self.allocator, self.bytes.asSlice()).?)
    }

    fn textError(&self, error: fmt::Error) TextFormatError {
        if error == fmt::Error::Write {
            if self.failure is ?failure {
                return TextFormatError::Allocation(failure);
            }
        }
        TextFormatError::Format(error)
    }
}

extend TextFormatWriter : io::Writer {
    type Error = mem::Error;

    fn shortWrite(&self) mem::Error {
        mem::Error::OutOfMemory
    }

    fn write(&mut self, bytes: &[u8]) mem::Error!usize {
        if self.bytes.appendSlice(self.allocator, bytes) is error! {
            self.failure = ?error;
            return error!;
        }
        !bytes.len()
    }
}

extend mem::Error : error::IntoError[TextError] {
    const fn intoError(self) TextError {
        TextError::Allocation(self)
    }
}

extend TextError : error::IntoError[TextFormatError] {
    const fn intoError(self) TextFormatError {
        match self {
            .InvalidUtf8(error) => .InvalidUtf8(error),
            .Allocation(error) => .Allocation(error),
        }
    }
}

extend String : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.text().format(formatter)
    }

    fn formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.text().formatSpec(formatter, spec)
    }
}
