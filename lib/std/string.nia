// Owned Unicode scalar text.
//
// `String` owns allocator-backed `char` storage; slices and iterators borrow it.
// UTF-8 and formatting APIs preserve validation, allocation, and writer errors,
// and mutation commits only after the complete operation can succeed.

pub(root) module hash;

using root::collections;
using root::builtin;
using root::error;
using root::fmt;
using root::io;
using root::iter;
using root::mem;
using root::option;
using root::result;
using root::slice;
using root::unicode;

using root::string::hash as stringHash;

pub enum TextError {
    InvalidUtf8(unicode::Utf8DecodeError),
    Allocation(mem::Error),
}

pub enum TextFormatError {
    InvalidUtf8(unicode::Utf8DecodeError),
    Allocation(mem::Error),
    Format(fmt::Error),
}

pub struct String {
    text: collections::ArrayList[char],
    formatBytes: collections::ArrayList[u8],
}

struct TextFormatWriter {
    allocator: &mut mem::Allocator,
    bytes: collections::ArrayList[u8],
    failure: ?mem::Error,
}

extend String {
    pub fun init() String {
        .{
            text: .init(),
            formatBytes: .init(),
        }
    }

    pub fun initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!String {
        let mut text = collections::ArrayList[char]::initCapacity(allocator, capacity).?;
        !.{ text, formatBytes: .init() }
    }

    pub fun fromSlice(allocator: &mut mem::Allocator, text: &[char]) mem::Error!String {
        let mut out = String::initCapacity(allocator, text.len()).?;
        out.append(allocator, text).?;
        !out
    }

    pub fun fromUtf8(allocator: &mut mem::Allocator, bytes: &[u8]) TextError!String {
        let view = unicode::Utf8View::fromBytes(bytes).?;
        !(String::fromUtf8View(allocator, view).?)
    }

    pub fun fromUtf8View(allocator: &mut mem::Allocator, view: unicode::Utf8View) mem::Error!String {
        let mut out = String::initCapacity(allocator, view.scalarCount()).?;
        for scalar in view {
            out.text.appendAssumeCapacity(scalar);
        }
        !out
    }

    pub fun appendUtf8(&mut self, allocator: &mut mem::Allocator, bytes: &[u8]) TextError!() {
        let view = unicode::Utf8View::fromBytes(bytes).?;
        !(self.appendUtf8View(allocator, view).?)
    }

    pub fun appendUtf8View(&mut self, allocator: &mut mem::Allocator, view: unicode::Utf8View) mem::Error!() {
        let oldLen = self.len();
        let newLen = oldLen.checkedAdd(view.scalarCount()).okOr(mem::Error::OutOfMemory).?;
        self.text.ensureTotalCapacity(allocator, newLen).?;
        for scalar in view {
            self.text.appendAssumeCapacity(scalar);
        }
        !()
    }

    pub fun appendFormat(
        &mut self,
        allocator: &mut mem::Allocator,
        template: &[char],
        args: &[&fmt::Format],
    ) TextFormatError!() {
        self.releaseFormatBytes(allocator).?;
        let oldLen = self.len();
        let mut committed = false;
        defer if not committed {
            self.text.truncate(oldLen);
        };

        let mut writer = TextFormatWriter::init(allocator);
        if fmt::printChecked(&mut writer, template, args) is error! {
            let primary = writer.textError(error);
            return writer.finish(self, ?primary);
        }
        if writer.appendTo(self) is error! {
            return writer.finish(self, ?error);
        }
        writer.finish(self, null).?;
        committed = true;
        !()
    }

    pub fun deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        let mut cleanup: error::CleanupAccumulator[mem::Error] = .init();
        cleanup.attempt(self.text.deinit(allocator));
        cleanup.attempt(self.formatBytes.deinit(allocator));
        cleanup.finish()
    }

    fun releaseFormatBytes(&mut self, allocator: &mut mem::Allocator) mem::Error!() {
        self.formatBytes.deinit(allocator)
    }

    pub fun text(&self) &[char] {
        self.text.asSlice()
    }

    pub fun textMut(&mut self) &mut [char] {
        self.text.asMutSlice()
    }

    pub fun len(&self) usize {
        self.text.len()
    }

    pub fun capacity(&self) usize {
        self.text.capacity()
    }

    pub fun isEmpty(&self) bool {
        self.text.isEmpty()
    }

    pub fun clear(&mut self) () {
        self.text.clear()
    }

    pub fun equals(&self, other: &[char]) bool {
        self.text().equals(other)
    }

    pub fun startsWith(&self, prefix: &[char]) bool {
        self.text().startsWith(prefix)
    }

    pub fun endsWith(&self, suffix: &[char]) bool {
        self.text().endsWith(suffix)
    }

    pub fun find(&self, needle: &[char]) ?usize {
        self.text().find(needle)
    }

    pub fun contains(&self, needle: &[char]) bool {
        self.text().contains(needle)
    }

    pub fun split(&self, separator: &[char]) slice::SliceSplit[char] {
        self.text().split(separator)
    }

    pub fun replaceAll(
        &self,
        allocator: &mut mem::Allocator,
        needle: &[char],
        replacement: &[char],
    ) mem::Error!String {
        replaceAllText(allocator, self.text(), needle, replacement)
    }

    pub fun ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!() {
        self.text.ensureTotalCapacity(allocator, capacity)
    }

    pub fun reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!() {
        self.text.reserve(allocator, additional)
    }

    pub fun push(&mut self, allocator: &mut mem::Allocator, ch: char) mem::Error!() {
        self.text.push(allocator, ch)
    }

    pub fun pushAssumeCapacity(&mut self, ch: char) () {
        self.text.appendAssumeCapacity(ch)
    }

    pub fun append(&mut self, allocator: &mut mem::Allocator, text: &[char]) mem::Error!() {
        self.text.appendSlice(allocator, text)
    }

    pub fun appendAssumeCapacity(&mut self, text: &[char]) () {
        self.text.appendSliceAssumeCapacity(text)
    }

    // Retires any pending formatting staging owner first, so a successful
    // transfer leaves no second allocation behind in this string.
    pub fun intoOwnedSlice(&mut self, allocator: &mut mem::Allocator) mem::Error!mem::SliceAllocation[char] {
        self.releaseFormatBytes(allocator).?;
        self.text.intoOwnedSlice(allocator)
    }
}

extend [char] {
    pub fun replaceAll(
        &self,
        allocator: &mut mem::Allocator,
        needle: &[char],
        replacement: &[char],
    ) mem::Error!String {
        replaceAllText(allocator, self, needle, replacement)
    }
}

extend [&[char]] {
    pub fun join(
        &self,
        allocator: &mut mem::Allocator,
        separator: &[char],
    ) mem::Error!String {
        let separatorCount = if self.isEmpty() { 0 } else { self.len() - 1 };
        let mut outputLen = separator.len().checkedMul(separatorCount)
            .okOr(mem::Error::OutOfMemory).?;
        for &part in self {
            outputLen = outputLen.checkedAdd(part.len()).okOr(mem::Error::OutOfMemory).?;
        }

        let mut out = String::initCapacity(allocator, outputLen).?;
        for index in 0..self.len() {
            if index != 0 {
                out.appendAssumeCapacity(separator);
            }
            out.appendAssumeCapacity(self[index]);
        }
        !out
    }
}

fun replaceAllText(
    allocator: &mut mem::Allocator,
    source: &[char],
    needle: &[char],
    replacement: &[char],
) mem::Error!String {
    let matchCount = source.split(needle).count() - 1;
    let removed = needle.len().checkedMul(matchCount).okOr(mem::Error::OutOfMemory).?;
    let added = replacement.len().checkedMul(matchCount).okOr(mem::Error::OutOfMemory).?;
    let outputLen = (source.len() - removed).checkedAdd(added)
        .okOr(mem::Error::OutOfMemory).?;

    let mut out = String::initCapacity(allocator, outputLen).?;
    let mut firstPart = true;
    for part in source.split(needle) {
        if firstPart {
            firstPart = false;
        } else {
            out.appendAssumeCapacity(replacement);
        }
        out.appendAssumeCapacity(part);
    }
    !out
}

extend String : Eq[String] {
    fun eq(&self, other: &String) bool {
        self.equals(other.text())
    }

    fun ne(&self, other: &String) bool {
        not self.equals(other.text())
    }
}

extend TextFormatWriter {
    fun init(allocator: &mut mem::Allocator) TextFormatWriter {
        .{ allocator, bytes: .init(), failure: null }
    }

    fun deinit(&mut self) mem::Error!() {
        self.bytes.deinit(self.allocator)
    }

    // Format and UTF-8 errors stay primary over staging cleanup failures; a
    // cleanup allocation error is reported only when formatting succeeded. A
    // backing whose free failed moves to `out` as a pending owner, retried
    // before the next format and during `String::deinit`.
    fun finish(&mut self, out: &mut String, primary: ?TextFormatError) TextFormatError!() {
        if self.deinit() is error! {
            out.formatBytes = self.bytes;
            self.bytes = .init();
            if primary is ?cause {
                return cause!;
            }
            return error.intoError()!;
        }
        if primary is ?cause {
            return cause!;
        }
        !()
    }

    fun appendTo(&mut self, out: &mut String) TextFormatError!() {
        !(out.appendUtf8(self.allocator, self.bytes.asSlice()).?)
    }

    fun textError(&self, error: fmt::Error) TextFormatError {
        if error == fmt::Error::Write {
            if self.failure is ?failure {
                return .Allocation(failure);
            }
        }
        .Format(error)
    }
}

extend TextFormatWriter : io::Writer {
    type Error = mem::Error;

    fun shortWrite(&self) mem::Error {
        .OutOfMemory
    }

    fun write(&mut self, bytes: &[u8]) mem::Error!usize {
        if self.bytes.appendSlice(self.allocator, bytes) is error! {
            self.failure = ?error;
            return error!;
        }
        !bytes.len()
    }
}

extend mem::Error : builtin::IntoError[TextError] {
    const fun intoError(self) TextError {
        TextError::Allocation(self)
    }
}

extend unicode::Utf8DecodeError : builtin::IntoError[TextError] {
    const fun intoError(self) TextError {
        TextError::InvalidUtf8(self)
    }
}

extend mem::Error : builtin::IntoError[TextFormatError] {
    const fun intoError(self) TextFormatError {
        TextFormatError::Allocation(self)
    }
}

extend TextError : builtin::IntoError[TextFormatError] {
    const fun intoError(self) TextFormatError {
        match self {
            .InvalidUtf8(error) => .InvalidUtf8(error),
            .Allocation(error) => .Allocation(error),
        }
    }
}

extend String : fmt::Format {
    fun format(&self, formatter: &mut fmt::Formatter) fmt::Error!() {
        self.text().format(formatter)
    }

    fun formatSpec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!() {
        self.text().formatSpec(formatter, spec)
    }
}
