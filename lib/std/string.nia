using pkg::collections;
using pkg::fmt;
using pkg::io;
using pkg::mem;
using pkg::unicode;

pub enum TextError {
    InvalidUtf8(unicode::Utf8DecodeError),
    Allocation(mem::Error),
    Format(fmt::Error),
}

pub struct StringBuf {
    text: collections::ArrayList[char],
}

struct TextFormatWriter {
    allocator: &mut mem::Allocator,
    bytes: collections::ArrayList[u8],
    failure: ?mem::Error,
}

extend StringBuf {
    pub fn init() StringBuf {
        { text: collections::ArrayList[char]::init() }
    }

    pub fn init_capacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!StringBuf {
        let mut text = collections::ArrayList[char]::init_capacity(allocator, capacity).?;
        !StringBuf { text: text }
    }

    pub fn from_owned_slice(text: &mut [char]) StringBuf {
        { text: collections::ArrayList[char]::from_owned_slice(text) }
    }

    pub fn from_slice(allocator: &mut mem::Allocator, text: &[char]) mem::Error!StringBuf {
        let mut out = StringBuf::init_capacity(allocator, text.len()).?;
        out.append(allocator, text).?;
        !out
    }

    pub fn fromUtf8(allocator: &mut mem::Allocator, bytes: &[u8]) TextError!StringBuf {
        let scalarCount = utf8ScalarCount(bytes).?;

        let mut out = StringBuf::init_capacity(allocator, scalarCount).asTextError().?;
        let mut complete = false;
        defer if not complete {
            out.deinit(allocator).asTextError().?;
        };
        let mut index = 0usize;
        while index < bytes.len() {
            let decoded = switch unicode::decodeUtf8First(&bytes[index..]) {
                !value => value,
                error! => return TextError::InvalidUtf8(error)!,
            };
            out.text.append_assume_capacity(decoded.char());
            index += decoded.len();
        }
        complete = true;
        !out
    }

    pub fn appendUtf8(&mut self, allocator: &mut mem::Allocator, bytes: &[u8]) TextError!void {
        let scalarCount = utf8ScalarCount(bytes).?;
        let oldLen = self.len();
        let newLen = switch oldLen.checked_add(scalarCount) {
            ?value => value,
            null => return TextError::Allocation(mem::Error::OutOfMemory)!,
        };
        self.text.ensure_total_capacity(allocator, newLen).asTextError().?;

        let mut complete = false;
        defer if not complete {
            self.text.truncate(oldLen);
        };
        let mut index = 0usize;
        while index < bytes.len() {
            let decoded = switch unicode::decodeUtf8First(&bytes[index..]) {
                !value => value,
                error! => return TextError::InvalidUtf8(error)!,
            };
            self.text.append_assume_capacity(decoded.char());
            index += decoded.len();
        }
        complete = true;
        !{}
    }

    pub fn appendFormat(
        &mut self,
        allocator: &mut mem::Allocator,
        template: &[char],
        args: &[&fmt::Format],
    ) TextError!void {
        let oldLen = self.len();
        let mut committed = false;
        defer if not committed {
            self.text.truncate(oldLen);
        };

        let mut writer = TextFormatWriter::init(allocator);
        switch fmt::print_checked(&mut writer, template, args) {
            !ok => { _ = ok; },
            error! => {
                let primary = writer.textError(error);
                return writer.finish(?primary);
            },
        }
        switch writer.appendTo(self) {
            !ok => { _ = ok; },
            error! => return writer.finish(?error),
        }
        writer.finish(null).?;
        committed = true;
        !{}
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.text.deinit(allocator)
    }

    pub fn text(&self) &[char] {
        self.text.as_slice()
    }

    pub fn as_slice(&self) &[char] {
        self.text.as_slice()
    }

    pub fn as_mut_slice(&mut self) &mut [char] {
        self.text.as_mut_slice()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn capacity(&self) usize {
        self.text.capacity()
    }

    pub fn is_empty(&self) bool {
        self.text.is_empty()
    }

    pub fn clear(&mut self) void {
        self.text.clear()
    }

    pub fn clear_retaining_capacity(&mut self) void {
        self.text.clear_retaining_capacity()
    }

    pub fn equals(&self, other: &[char]) bool {
        self.text().equals(other)
    }

    pub fn startsWith(&self, prefix: &[char]) bool {
        self.text().startsWith(prefix)
    }

    pub fn endsWith(&self, suffix: &[char]) bool {
        self.text().endsWith(suffix)
    }

    pub fn find(&self, needle: &[char]) ?usize {
        self.text().find(needle)
    }

    pub fn contains(&self, needle: &[char]) bool {
        self.text().contains(needle)
    }

    pub fn ensure_total_capacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        self.text.ensure_total_capacity(allocator, capacity)
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, ch: char) mem::Error!void {
        self.text.push(allocator, ch)
    }

    pub fn append(&mut self, allocator: &mut mem::Allocator, text: &[char]) mem::Error!void {
        self.text.append_slice(allocator, text)
    }

    pub fn into_owned_slice(&mut self, allocator: &mut mem::Allocator) mem::Error!&mut [char] {
        self.text.into_owned_slice(allocator)
    }
}

extend [char] {
    pub fn equals(&self, other: &[char]) bool {
        if self.len() != other.len() {
            return false;
        }

        let mut index = 0usize;
        while index < self.len() {
            if self[index] != other[index] {
                return false;
            }
            index += 1usize;
        }
        true
    }

    pub fn startsWith(&self, prefix: &[char]) bool {
        if prefix.len() > self.len() {
            return false;
        }
        (&self[0usize..prefix.len()]).equals(prefix)
    }

    pub fn endsWith(&self, suffix: &[char]) bool {
        if suffix.len() > self.len() {
            return false;
        }
        (&self[(self.len() - suffix.len())..]).equals(suffix)
    }

    pub fn find(&self, needle: &[char]) ?usize {
        if needle.len() == 0usize {
            return ?0usize;
        }
        if needle.len() > self.len() {
            return null;
        }

        let lastStart = self.len() - needle.len();
        let mut index = 0usize;
        while index <= lastStart {
            if (&self[index..(index + needle.len())]).equals(needle) {
                return ?index;
            }
            index += 1usize;
        }
        null
    }

    pub fn contains(&self, needle: &[char]) bool {
        if self.find(needle) is ?index {
            _ = index;
            true
        } else {
            false
        }
    }
}

extend TextFormatWriter {
    fn init(allocator: &mut mem::Allocator) TextFormatWriter {
        {
            allocator: allocator,
            bytes: collections::ArrayList[u8]::init(),
            failure: null,
        }
    }

    fn deinit(&mut self) mem::Error!void {
        self.bytes.deinit(self.allocator)
    }

    fn finish(&mut self, primary: ?TextError) TextError!void {
        switch self.deinit() {
            !ok => {
                _ = ok;
                switch primary {
                    ?error => error!,
                    null => !{},
                }
            },
            error! => TextError::Allocation(error)!,
        }
    }

    fn appendTo(&mut self, out: &mut StringBuf) TextError!void {
        out.appendUtf8(self.allocator, self.bytes.as_slice())
    }

    fn textError(&self, error: fmt::Error) TextError {
        if error == fmt::Error::Write {
            if self.failure is ?failure {
                return TextError::Allocation(failure);
            }
        }
        TextError::Format(error)
    }
}

extend TextFormatWriter : io::Writer {
    type Error = mem::Error;

    fn short_write(&self) mem::Error {
        mem::Error::OutOfMemory
    }

    fn write(&mut self, bytes: &[u8]) mem::Error!usize {
        switch self.bytes.append_slice(self.allocator, bytes) {
            !ok => {
                _ = ok;
                !bytes.len()
            },
            error! => {
                self.failure = ?error;
                error!
            },
        }
    }
}

fn utf8ScalarCount(bytes: &[u8]) TextError!usize {
    let mut count = 0usize;
    let mut index = 0usize;
    while index < bytes.len() {
        let decoded = switch unicode::decodeUtf8First(&bytes[index..]) {
            !value => value,
            error! => return TextError::InvalidUtf8(error)!,
        };
        count += 1usize;
        index += decoded.len();
    }
    !count
}

extend[T] mem::Error!T {
    fn asTextError(self) TextError!T {
        switch self {
            !value => !value,
            error! => TextError::Allocation(error)!,
        }
    }
}

extend StringBuf : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        self.text().format(formatter)
    }

    fn format_spec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!void {
        self.text().format_spec(formatter, spec)
    }
}
