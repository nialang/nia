pub(pkg) module hash;

using pkg::collections;
using pkg::fmt;
using pkg::io;
using pkg::mem;
using pkg::slice;
using pkg::unicode;

using pkg::string::hash as stringHash;

pub enum TextError {
    InvalidUtf8(unicode::Utf8DecodeError),
    Allocation(mem::Error),
}

pub enum TextFormatError {
    InvalidUtf8(unicode::Utf8DecodeError),
    Allocation(mem::Error),
    Format(fmt::Error),
}

pub struct String {
    text: collections::ArrayList[char],
}

struct TextFormatWriter {
    allocator: &mut mem::Allocator,
    bytes: collections::ArrayList[u8],
    failure: ?mem::Error,
}

extend String {
    pub fn init() String {
        { text: collections::ArrayList[char]::init() }
    }

    pub fn initCapacity(allocator: &mut mem::Allocator, capacity: usize) mem::Error!String {
        let mut text = collections::ArrayList[char]::initCapacity(allocator, capacity).?;
        !String { text: text }
    }

    pub fn fromOwnedSlice(text: &mut [char]) String {
        { text: collections::ArrayList[char]::fromOwnedSlice(text) }
    }

    pub fn fromSlice(allocator: &mut mem::Allocator, text: &[char]) mem::Error!String {
        let mut out = String::initCapacity(allocator, text.len()).?;
        out.append(allocator, text).?;
        !out
    }

    pub fn fromUtf8(allocator: &mut mem::Allocator, bytes: &[u8]) TextError!String {
        let scalarCount = utf8ScalarCount(bytes).?;

        let mut out = String::initCapacity(allocator, scalarCount).asTextError().?;
        let mut complete = false;
        defer if not complete {
            out.deinit(allocator).asTextError().?;
        };
        let mut index: usize = 0;
        while index < bytes.len() {
            let decoded = switch unicode::decodeUtf8First(&bytes[index..]) {
                !value => value,
                error! => return TextError::InvalidUtf8(error)!,
            };
            out.text.appendAssumeCapacity(decoded.char());
            index += decoded.len();
        }
        complete = true;
        !out
    }

    pub fn appendUtf8(&mut self, allocator: &mut mem::Allocator, bytes: &[u8]) TextError!void {
        let scalarCount = utf8ScalarCount(bytes).?;
        let oldLen = self.len();
        let newLen = switch oldLen.checked_add(scalarCount) {
            ?value => value,
            null => return TextError::Allocation(mem::Error::OutOfMemory)!,
        };
        self.text.ensureTotalCapacity(allocator, newLen).asTextError().?;

        let mut complete = false;
        defer if not complete {
            self.text.truncate(oldLen);
        };
        let mut index: usize = 0;
        while index < bytes.len() {
            let decoded = switch unicode::decodeUtf8First(&bytes[index..]) {
                !value => value,
                error! => return TextError::InvalidUtf8(error)!,
            };
            self.text.appendAssumeCapacity(decoded.char());
            index += decoded.len();
        }
        complete = true;
        !{}
    }

    pub fn appendFormat(
        &mut self,
        allocator: &mut mem::Allocator,
        template: &[char],
        args: &[&fmt::Format],
    ) TextFormatError!void {
        let oldLen = self.len();
        let mut committed = false;
        defer if not committed {
            self.text.truncate(oldLen);
        };

        let mut writer = TextFormatWriter::init(allocator);
        switch fmt::print_checked(&mut writer, template, args) {
            !ok => { _ = ok; },
            error! => {
                let primary = writer.textError(error);
                return writer.finish(?primary);
            },
        }
        switch writer.appendTo(self) {
            !ok => { _ = ok; },
            error! => return writer.finish(?error),
        }
        writer.finish(null).?;
        committed = true;
        !{}
    }

    pub fn deinit(&mut self, allocator: &mut mem::Allocator) mem::Error!void {
        self.text.deinit(allocator)
    }

    pub fn text(&self) &[char] {
        self.text.asSlice()
    }

    pub fn textMut(&mut self) &mut [char] {
        self.text.asMutSlice()
    }

    pub fn len(&self) usize {
        self.text.len()
    }

    pub fn capacity(&self) usize {
        self.text.capacity()
    }

    pub fn isEmpty(&self) bool {
        self.text.isEmpty()
    }

    pub fn clear(&mut self) void {
        self.text.clear()
    }

    pub fn equals(&self, other: &[char]) bool {
        self.text().equals(other)
    }

    pub fn startsWith(&self, prefix: &[char]) bool {
        self.text().startsWith(prefix)
    }

    pub fn endsWith(&self, suffix: &[char]) bool {
        self.text().endsWith(suffix)
    }

    pub fn find(&self, needle: &[char]) ?usize {
        self.text().find(needle)
    }

    pub fn contains(&self, needle: &[char]) bool {
        self.text().contains(needle)
    }

    pub fn split(&self, separator: &[char]) slice::SliceSplit[char] {
        self.text().split(separator)
    }

    pub fn ensureTotalCapacity(&mut self, allocator: &mut mem::Allocator, capacity: usize) mem::Error!void {
        self.text.ensureTotalCapacity(allocator, capacity)
    }

    pub fn reserve(&mut self, allocator: &mut mem::Allocator, additional: usize) mem::Error!void {
        self.text.reserve(allocator, additional)
    }

    pub fn push(&mut self, allocator: &mut mem::Allocator, ch: char) mem::Error!void {
        self.text.push(allocator, ch)
    }

    pub fn pushAssumeCapacity(&mut self, ch: char) void {
        self.text.appendAssumeCapacity(ch)
    }

    pub fn append(&mut self, allocator: &mut mem::Allocator, text: &[char]) mem::Error!void {
        self.text.appendSlice(allocator, text)
    }

    pub fn appendAssumeCapacity(&mut self, text: &[char]) void {
        self.text.appendSliceAssumeCapacity(text)
    }

    pub fn intoOwnedSlice(&mut self, allocator: &mut mem::Allocator) mem::Error!&mut [char] {
        self.text.intoOwnedSlice(allocator)
    }
}

extend String : Eq[String] {
    fn eq(&self, other: &String) bool {
        self.equals(other.text())
    }

    fn ne(&self, other: &String) bool {
        not self.equals(other.text())
    }
}

extend TextFormatWriter {
    fn init(allocator: &mut mem::Allocator) TextFormatWriter {
        {
            allocator: allocator,
            bytes: collections::ArrayList[u8]::init(),
            failure: null,
        }
    }

    fn deinit(&mut self) mem::Error!void {
        self.bytes.deinit(self.allocator)
    }

    fn finish(&mut self, primary: ?TextFormatError) TextFormatError!void {
        switch self.deinit() {
            !ok => {
                _ = ok;
                switch primary {
                    ?error => error!,
                    null => !{},
                }
            },
            error! => TextFormatError::Allocation(error)!,
        }
    }

    fn appendTo(&mut self, out: &mut String) TextFormatError!void {
        out.appendUtf8(self.allocator, self.bytes.asSlice()).asTextFormatError()
    }

    fn textError(&self, error: fmt::Error) TextFormatError {
        if error == fmt::Error::Write {
            if self.failure is ?failure {
                return TextFormatError::Allocation(failure);
            }
        }
        TextFormatError::Format(error)
    }
}

extend TextFormatWriter : io::Writer {
    type Error = mem::Error;

    fn shortWrite(&self) mem::Error {
        mem::Error::OutOfMemory
    }

    fn write(&mut self, bytes: &[u8]) mem::Error!usize {
        switch self.bytes.appendSlice(self.allocator, bytes) {
            !ok => {
                _ = ok;
                !bytes.len()
            },
            error! => {
                self.failure = ?error;
                error!
            },
        }
    }
}

fn utf8ScalarCount(bytes: &[u8]) TextError!usize {
    let mut count: usize = 0;
    let mut index: usize = 0;
    while index < bytes.len() {
        let decoded = switch unicode::decodeUtf8First(&bytes[index..]) {
            !value => value,
            error! => return TextError::InvalidUtf8(error)!,
        };
        count += 1;
        index += decoded.len();
    }
    !count
}

extend[T] mem::Error!T {
    fn asTextError(self) TextError!T {
        switch self {
            !value => !value,
            error! => TextError::Allocation(error)!,
        }
    }
}

extend[T] TextError!T {
    fn asTextFormatError(self) TextFormatError!T {
        switch self {
            !value => !value,
            TextError::InvalidUtf8(error)! => TextFormatError::InvalidUtf8(error)!,
            TextError::Allocation(error)! => TextFormatError::Allocation(error)!,
        }
    }
}

extend String : fmt::Format {
    fn format(&self, formatter: &mut fmt::Formatter) fmt::Error!void {
        self.text().format(formatter)
    }

    fn format_spec(&self, formatter: &mut fmt::Formatter, spec: fmt::FormatSpec) fmt::Error!void {
        self.text().format_spec(formatter, spec)
    }
}
