using std::process;

struct Pair {
    a: i32,
    b: i32,
}

const T: Pair = Pair { a: 1, b: 2 };
static S: Pair = T;

pub fn main(init: process::Init) process::ExitCode!() {
    _ = init;
    if S.a != 1 {
        return process::exit(1)!;
    }
    if S.b != 2 {
        return process::exit(2)!;
    }
    !()
}
