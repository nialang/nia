using std::process;

const O: ?i32 = ?5i32;
static S: ?i32 = O;

pub fn main(init: process::Init) process::ExitCode!() {
    _ = init;
    // O is present with payload 5, so a correct initializer exits 0.
    if S is ?v {
        if v != 5 {
            return process::exit(2)!;
        }
        !()
    } else {
        // Reached only if the present optional became null.
        return process::exit(1)!;
    }
}
