using std::process;
using helper;

struct Pair {
    left: i32,
    right: i32,
}

struct Width {
    value: i32,
}

struct Empty {}

enum Mode {
    Plain(i32),
    Scale(i32, i32),
}

union PointerSlot {
    pointer: &usize,
    integer: usize,
}

union ArrayPointerSlot {
    pointer: &[3]u8,
    integer: usize,
}

union PairPointerSlot {
    pointer: &Pair,
    integer: usize,
}

union VectorPointerSlot {
    pointer: &u16x2,
    integer: usize,
}

union NestedPointerSlot {
    pointer: &PointerSlot,
    integer: usize,
}

struct PointerHolder {
    marker: u8,
    slot: PointerSlot,
}

union HolderPointerSlot {
    pointer: &PointerHolder,
    integer: usize,
}

union NestedArrayPointerSlot {
    pointer: &[2]PointerSlot,
    integer: usize,
}

union ByteUnion {
    byte: u8,
    wide: u64,
}

union ByteUnionPointerSlot {
    pointer: &ByteUnion,
    integer: usize,
}

union EmptyPointerSlot {
    pointer: &Empty,
    integer: usize,
}

extend Pair {
    const fn sum(self) i32 {
        self.left + self.right
    }
}

extend Width {
    const fn fromValue(value: i32) Width {
        { value: value }
    }
}

const fn arithmetic(value: i32) i32 {
    (value * 3 + 2) / 2
}

const fn castScore(value: u8) i32 {
    (value as i32) * 2
}

const fn arrayScore(values: [3]i32) i32 {
    values[0] + values[1] + values[2]
}

const fn optionalScore(value: ?Pair) i32 {
    if value is ?pair {
        pair.sum()
    } else {
        -1
    }
}

const fn resultScore(value: i32!Pair) i32 {
    switch value {
        !pair => pair.sum(),
        error! => error,
    }
}

const fn switchScore(mode: Mode) i32 {
    switch mode {
        Mode::Plain(value) => value,
        Mode::Scale(value, factor) => value * factor,
    }
}

const fn loopScore(limit: i32) i32 {
    let mut index: i32 = 0;
    let mut total: i32 = 0;
    while index < limit {
        total += index;
        index += 1;
    }
    total
}

const fn select[T](useValue: bool, value: T, fallback: T) T {
    if useValue {
        value
    } else {
        fallback
    }
}

const fn constGenericScore[N: usize](value: i32) i32 {
    value + N as i32
}

const fn referencedScore(value: i32) i32 {
    value * 2 + 1
}

const fn unusedScore(value: i32) i32 {
    value - 100
}

const arithmeticExpected: i32 = arithmetic(7);
const castExpected: i32 = castScore(9);
const arrayExpected: i32 = arrayScore([2, 3, 5]);
const optionalExpected: i32 = optionalScore(?Pair{left: 4, right: 6});
const optionalNullExpected: i32 = optionalScore(null);
const resultExpected: i32 = resultScore(!Pair{left: 5, right: 7});
const errorExpected: i32 = resultScore(9!);
const switchExpected: i32 = switchScore(Mode::Scale(3, 4));
const loopExpected: i32 = loopScore(5);
const genericExpected: i32 = select[i32](true, 13, 2);
const importedExpected: i32 = helper::importedScore(6);
const associatedExpected: i32 = Width::fromValue(14).value;
const constGenericExpected: i32 = constGenericScore[4](11);
const firstPointerSlot: PointerSlot = { pointer: &34usize };
const secondPointerSlot: PointerSlot = { pointer: &34usize };
const arrayPointerSlot: ArrayPointerSlot = { pointer: &[3]u8[2, 4, 8] };
const pairPointerSlot: PairPointerSlot = { pointer: &Pair{left: 5, right: 7} };
const vectorPointerSlot: VectorPointerSlot = {
    pointer: &std::builtin::insert(
        std::builtin::splat[u16x2](4386),
        1,
        13124,
    ),
};
const nestedPointerSlot: NestedPointerSlot = {
    pointer: &PointerSlot{pointer: &91usize},
};
const holderPointerSlot: HolderPointerSlot = {
    pointer: &PointerHolder{marker: 3, slot: PointerSlot{pointer: &37usize}},
};
const nestedArrayPointerSlot: NestedArrayPointerSlot = {
    pointer: &[2]PointerSlot[
        PointerSlot{pointer: &11usize},
        PointerSlot{pointer: &13usize},
    ],
};
const byteUnionPointerSlot: ByteUnionPointerSlot = {
    pointer: &ByteUnion{byte: 7},
};
const firstEmptyPointerSlot: EmptyPointerSlot = { pointer: &Empty{} };
const secondEmptyPointerSlot: EmptyPointerSlot = { pointer: &Empty{} };
const directArrayPointer: &[3]u8 = &[3]u8[6, 7, 8];
const secondDirectArrayPointer: &[3]u8 = &[3]u8[6, 7, 8];
const importedGenericPointer: helper::PointerSlot[usize] =
    helper::passPointer[usize](helper::firstPointerSlot);
const importedGenericPointerValue: usize =
    helper::readPointer[usize](importedGenericPointer);
const importedGenericSamePointer: bool = helper::samePointer[usize](
    importedGenericPointer,
    helper::firstPointerSlot,
);
const importedGenericDistinctPointer: bool = helper::samePointer[usize](
    importedGenericPointer,
    helper::secondPointerSlot,
);
const importedGenericConstOnlyValue: u32 = helper::readPointer[u32](
    helper::passPointer[u32](helper::constOnlyPointerSlot),
);

pub fn main(init: process::Init) process::ExitCode!void {
    _ = init;
    let runtimeWidth = Width::fromValue(14);
    let runtimeReferencedScore = & referencedScore;
    let firstPointer: PointerSlot = firstPointerSlot;
    let samePointer: PointerSlot = firstPointerSlot;
    let secondPointer: PointerSlot = secondPointerSlot;
    let arrayPointer: ArrayPointerSlot = arrayPointerSlot;
    let pairPointer: PairPointerSlot = pairPointerSlot;
    let vectorPointer: VectorPointerSlot = vectorPointerSlot;
    let nestedPointer: NestedPointerSlot = nestedPointerSlot;
    let holderPointer: HolderPointerSlot = holderPointerSlot;
    let nestedArrayPointer: NestedArrayPointerSlot = nestedArrayPointerSlot;
    let byteUnionPointer: ByteUnionPointerSlot = byteUnionPointerSlot;
    let firstEmptyPointer: EmptyPointerSlot = firstEmptyPointerSlot;
    let sameEmptyPointer: EmptyPointerSlot = firstEmptyPointerSlot;
    let secondEmptyPointer: EmptyPointerSlot = secondEmptyPointerSlot;
    let directArrayFirst: ArrayPointerSlot = { pointer: directArrayPointer };
    let directArraySame: ArrayPointerSlot = { pointer: directArrayPointer };
    let directArraySecond: ArrayPointerSlot = { pointer: secondDirectArrayPointer };
    let runtimeImportedGenericPointer =
        helper::passPointer[usize](helper::firstPointerSlot);
    let runtimeOnlyImportedGenericPointer =
        helper::passPointer[u64](helper::runtimeOnlyPointerSlot);
    if arithmetic(7) != arithmeticExpected or arithmeticExpected != 11 {
        return process::exit(10)!;
    }
    if castScore(9) != castExpected or castExpected != 18 {
        return process::exit(11)!;
    }
    if arrayScore([2, 3, 5]) != arrayExpected or arrayExpected != 10 {
        return process::exit(12)!;
    }
    if optionalScore(?Pair{left: 4, right: 6}) != optionalExpected or optionalExpected != 10 {
        return process::exit(13)!;
    }
    if optionalScore(null) != optionalNullExpected or optionalNullExpected != -1 {
        return process::exit(14)!;
    }
    if resultScore(!Pair{left: 5, right: 7}) != resultExpected or resultExpected != 12 {
        return process::exit(15)!;
    }
    if resultScore(9!) != errorExpected or errorExpected != 9 {
        return process::exit(16)!;
    }
    if switchScore(Mode::Scale(3, 4)) != switchExpected or switchExpected != 12 {
        return process::exit(17)!;
    }
    if loopScore(5) != loopExpected or loopExpected != 10 {
        return process::exit(18)!;
    }
    if select[i32](true, 13, 2) != genericExpected or genericExpected != 13 {
        return process::exit(19)!;
    }
    if helper::importedScore(6) != importedExpected or importedExpected != 24 {
        return process::exit(20)!;
    }
    if helper::onlyExpected != 12 {
        return process::exit(21)!;
    }
    if helper::importedOptionalScore(?8) != helper::importedOptionalExpected or helper::importedOptionalExpected != 10 {
        return process::exit(22)!;
    }
    if runtimeWidth.value != associatedExpected or associatedExpected != 14 {
        return process::exit(23)!;
    }
    if constGenericScore[4](11) != constGenericExpected or constGenericExpected != 15 {
        return process::exit(24)!;
    }
    if runtimeReferencedScore(12) != 25 {
        return process::exit(25)!;
    }
    if firstPointer.pointer != samePointer.pointer or firstPointer.pointer.* != 34 {
        return process::exit(26)!;
    }
    if firstPointer.pointer == secondPointer.pointer {
        return process::exit(27)!;
    }
    if arrayPointer.pointer.*[0] != 2 or arrayPointer.pointer.*[2] != 8 {
        return process::exit(28)!;
    }
    if pairPointer.pointer.*.sum() != 12 {
        return process::exit(29)!;
    }
    if std::builtin::extract(vectorPointer.pointer.*, 0) != 4386
        or std::builtin::extract(vectorPointer.pointer.*, 1) != 13124 {
        return process::exit(30)!;
    }
    if nestedPointer.pointer.*.pointer.* != 91 {
        return process::exit(31)!;
    }
    if holderPointer.pointer.*.marker != 3 or holderPointer.pointer.*.slot.pointer.* != 37 {
        return process::exit(32)!;
    }
    if nestedArrayPointer.pointer.*[0].pointer.* != 11
        or nestedArrayPointer.pointer.*[1].pointer.* != 13 {
        return process::exit(33)!;
    }
    if byteUnionPointer.pointer.*.byte != 7 {
        return process::exit(34)!;
    }
    if firstEmptyPointer.pointer != sameEmptyPointer.pointer
        or firstEmptyPointer.pointer == secondEmptyPointer.pointer {
        return process::exit(35)!;
    }
    if directArrayFirst.integer != directArraySame.integer
        or directArrayFirst.integer == directArraySecond.integer
        or directArrayPointer.*[2] != 8 {
        return process::exit(36)!;
    }
    if importedGenericPointerValue != 55
        or importedGenericConstOnlyValue != 89
        or not importedGenericSamePointer
        or importedGenericDistinctPointer
        or helper::readPointer[usize](runtimeImportedGenericPointer) != importedGenericPointerValue
        or helper::readPointer[u64](runtimeOnlyImportedGenericPointer) != 144
        or not helper::samePointer[usize](
            runtimeImportedGenericPointer,
            importedGenericPointer,
        )
        or helper::samePointer[usize](
            runtimeImportedGenericPointer,
            helper::secondPointerSlot,
        )
        or runtimeImportedGenericPointer.pointer == &helper::globalPointerValue {
        return process::exit(37)!;
    }
    !{}
}
