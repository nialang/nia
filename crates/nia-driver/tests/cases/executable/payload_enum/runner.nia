using std::process;
using helper;

enum Event {
    Closed,
    Data(i32),
    Move(i32, i32),
    Resize { width: i32, height: i32 },
}

const fn const_score(event: Event) i32 {
    match event {
        Event::Closed => 0,
        Event::Data(value) => value,
        Event::Move(x, y) => x + y,
        Event::Resize { width, height: h } => width + h,
    }
}

fn score(event: Event) i32 {
    match event {
        Event::Closed => 0,
        Event::Data(value) => value,
        Event::Move(x, y) => x + y,
        Event::Resize { width, height: h } => width + h,
    }
}

const closed_score: i32 = const_score(Event::Closed);
const data_score: i32 = const_score(Event::Data(2));
const move_score: i32 = const_score(Event::Move(3, 4));
const resize_score: i32 = const_score(Event::Resize { height: 5, width: 6 });

pub fn main(init: process::Init) process::ExitCode!() {
    _ = init;
    let dataConstructor: &fn(i32) Event = &Event::Data;
    let omittedConstructor: &fn(i32, i32) Event = &.Move;
    let resizeConstructor: &fn(i32, i32) Event = &Event::Resize;
    let remoteConstructor: &fn(helper::Pair) helper::RemoteEvent = &helper::RemoteEvent::Pair;
    if score(Event::Closed) != closed_score or closed_score != 0 {
        return process::exit(10)!;
    }
    if score(helper::id[Event](Event::Data(2))) != data_score or data_score != 2 {
        return process::exit(11)!;
    }
    if score(Event::Move(3, 4)) != move_score or move_score != 7 {
        return process::exit(12)!;
    }
    if score(Event::Resize { height: 5, width: 6 }) != resize_score or resize_score != 11 {
        return process::exit(13)!;
    }
    if helper::marker() != 1 {
        return process::exit(14)!;
    }
    if score(dataConstructor(17)) != 17 {
        return process::exit(15)!;
    }
    if score(omittedConstructor(8, 9)) != 17 {
        return process::exit(16)!;
    }
    if score(resizeConstructor(4, 5)) != 9 {
        return process::exit(17)!;
    }
    let pair = helper::pair(6, 7);
    if helper::remoteScore(remoteConstructor(pair)) != 67 {
        return process::exit(18)!;
    }
    !()
}
