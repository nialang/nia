struct Pair[A, B] {
    a: A,
    b: B,
}

extend[T] Pair[T, i32] {
    fun rank(self) i32 {
        1
    }

    fun associated_rank() i32 {
        1
    }
}

extend[U] Pair[i32, U] {
    fun rank(self) i32 {
        2
    }

    fun associated_rank() i32 {
        2
    }
}

fun main(pair: Pair[i32, i32]) i32 {
    let associated_rank: &fun() i32 = &Pair[i32, i32]::associated_rank;
    _ = associated_rank;
    pair.rank()
}
