    _ = std::builtin::extract(&missing_vector, 0usize);
    _ = std::builtin::bitmask([missing_mask]);
    _ = std::builtin::loadUnaligned[i32](&missing_pointer);
    _ = sliceLen(&missing_slice);
}

fn places() () {
    _ = (&missing_index)[0usize];
    _ = (&missing_deref).*;
}

