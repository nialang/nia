struct Point { x: i32 }
enum Color { Red }

fun optional() () {
    if optional_missing is ?value {
        _ = value;
    }
}

fun error_union() () {
    match error_missing {
        !ok => { _ = ok; },
        err! => { _ = err; }
    }
}

fun tuple() () {
    match tuple_missing {
        (left, right) => { _ = left; _ = right; }
    }
}

fun pointer() () {
    match pointer_missing {
        &value => { _ = value; }
    }
}

fun null_pattern() () {
    match null_missing {
        null => {}
    }
}

fun struct_pattern() () {
    match struct_missing {
        Point { x } => { _ = x; }
    }
}

fun enum_pattern() () {
    match enum_missing {
        Color::Red => {}
    }
}

fun unknown_enum_pattern() () {
    match unknown_enum_missing {
        Ghost::Variant => {}
    }
}

fun unknown_struct_pattern() () {
    match unknown_struct_missing {
        GhostStruct { field } => { _ = field; }
    }
}

fun range_pattern() () {
    match range_missing {
        range_start..3 => {}
    }
}
