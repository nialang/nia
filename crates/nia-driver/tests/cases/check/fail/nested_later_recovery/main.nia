fun main(value: (bool, bool, bool)) () {
    match value {
        (true, @ (bad, value), false) => (),
        _ => (),
    }
    let (first, @ (bad, value), retained) = value;
    consume(true, @ (bad, value), 1);
    later();
}

fun typed(value: (bool, @ (bad, value), i32)) () {}
fun consume(first: bool, second: i32, third: i32) () {}
fun later() () {}
