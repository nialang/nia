fn need(value: i32) i32 { value }

fn arrayRecovery() () {
    let value: Missing = [.{ field: need(true) }];
    _ = value;
}

fn tupleRecovery() () {
    let value: Missing = (.{ field: need(true) }, 0);
    _ = value;
}

union Storage[T] { value: T }
fn unionRecovery() () {
    let value: Storage[Missing] = .{ value: need(true) };
    _ = value;
}

enum Event { Value(Missing), Named { value: Missing } }
fn enumRecovery() () {
    _ = Event::Value(need(true));
    _ = Event::Named { value: need(true) };
}
