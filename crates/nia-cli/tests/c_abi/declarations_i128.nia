// 128-bit integers at the C boundary, for targets with `__int128`.
extern struct Q { a: i128 }
extern fun r_i128() i128;
extern fun t_i128(v: i128) ();
extern fun t_q(v: Q) ();
extern fun r_q() Q;

pub extern fun use_i128() () {
    _ = r_i128();
    t_i128(0);
    t_q(Q { a: 0 });
    _ = r_q();
}
