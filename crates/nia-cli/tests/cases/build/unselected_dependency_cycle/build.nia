using std::build;

pub fn build(b: &mut build::Build) build::Error!void {
    let selected = b.addAggregateStep(&"selected").?;
    let first = b.addAggregateStep(&"first").?;
    let second = b.addAggregateStep(&"second").?;
    b.dependOn(first, second).?;
    b.dependOn(second, first).?;
    b.setDefaultStep(selected).?;
    !{}
}
