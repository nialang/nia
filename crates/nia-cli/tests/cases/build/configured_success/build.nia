using std::build;
using std::fs;
using std::fmt;
using std::io;
using std::string;

fn configure(b: &mut build::Build) build::Error!void {
    let helperName = "helper";
    let helperPath = "deps/helper.nia";
    let srcMain = "src/main.nia";
    let appName = "app";
    let outputName = "custom-app";
    let buildStepName = "build";
    let checkStepName = "check";
    let runStepName = "run";
    let imports = [
        build::ModuleImport::init(&helperName, fs::PathView::init(&helperPath)),
    ];
    let rootModule = b.addModule(
        build::ModuleOptions::init(&appName, fs::PathView::init(&srcMain))
            .withImports(&imports[..]),
    ).?;
    let app = b.addExecutable(
        build::ExecutableOptions::init(&appName, rootModule).withOutputName(&outputName),
    ).?;
    _ = b.addEmitExecutableStep(&buildStepName, app).?;
    _ = b.addCheckExecutableStep(&checkStepName, app).?;
    let runArguments = [string::StringView::init(&"roadmap")];
    let runStep = b.addRunExecutableStep(
        &runStepName,
        build::RunOptions::init(app).withArguments(&runArguments[..]),
    ).?;
    b.setDefaultStep(runStep).?;
    !{}
}

pub fn build(b: &mut build::Build) build::Error!void {
    configure(b).?;

    let mut buffer: [1024]u8 = [_]u8[0; 1024];
    let mut stdout = io::FileWriter::stdout(b.io(), &mut buffer[..]);
    stdout.print(&"root={}\n", &[b.packageRoot().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.print(&"build={}\n", &[b.buildDir().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.print(&"cache={}\n", &[b.cacheDir().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.print(&"toolchain={}\n", &[b.toolchainExecutable().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.flush().asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    !{}
}
