using std::build;
using std::fs;
using std::fmt;
using std::io;

fn configure(b: &mut build::Build) build::Error!void {
    let assets = b.addPackage(
        build::PackageOptions::init(&"assets", fs::PathView::init(&"packages/assets")),
    ).?;
    let helperName = "helper";
    let helperPath = "generated/helper.nia";
    let srcMain = "src/main.nia";
    let generatedWorker = "generated/worker.nia";
    let appName = "app";
    let workerName = "worker";
    let outputName = "custom-app";
    let workerOutputName = "custom-worker";
    let buildStepName = "build";
    let checkStepName = "check";
    let runStepName = "run";
    let installStepName = "install";
    let toolStepName = "tool";
    let generateWorkerStepName = "generate-worker";
    let generateHelperStepName = "generate-helper";
    let imports = [
        build::ModuleImport::fromBuild(
            &helperName,
            build::BuildPathView::init(&helperPath),
        ),
        build::ModuleImport::fromPackage(
            &"assetHelper",
            assets,
            fs::PathView::init(&"helper.nia"),
        ),
    ];
    let rootModule = b.addModule(
        build::ModuleOptions::fromPackage(&appName, assets, fs::PathView::init(&srcMain))
            .withImports(&imports[..]),
    ).?;
    let app = b.addExecutable(
        build::ExecutableOptions::init(&appName, rootModule).withOutputName(&outputName),
    ).?;
    let workerModule = b.addModule(
        build::ModuleOptions::fromBuild(
            &workerName,
            build::BuildPathView::init(&generatedWorker),
        ),
    ).?;
    let worker = b.addExecutable(
        build::ExecutableOptions::init(&workerName, workerModule)
            .withOutputName(&workerOutputName),
    ).?;
    _ = b.addEmitExecutableStep(&buildStepName, app).?;
    _ = b.addEmitExecutableStep(&workerName, worker).?;
    _ = b.addCheckExecutableStep(&checkStepName, app).?;
    _ = b.addGeneratedFileStep(
        &generateWorkerStepName,
        build::BuildPathView::init(&generatedWorker),
        &b"using std::process;\n\npub fn main(init: process::Init) process::ExitCode!void {\n    _ = init;\n    !{}\n}\n"[..],
    ).?;
    _ = b.addGeneratedFileStep(
        &generateHelperStepName,
        build::BuildPathView::init(&helperPath),
        &b"pub fn value() i32 {\n    7\n}\n"[..],
    ).?;
    let runArguments: [1]&[char] = [&"roadmap"];
    let runStep = b.addRunExecutableStep(
        &runStepName,
        build::RunOptions::init(app).withArguments(&runArguments[..]),
    ).?;
    let installStep = b.addInstallExecutableStep(
        &installStepName,
        app,
        build::BuildPathView::init(&"install/custom-app"),
    ).?;
    let toolArguments = [
        build::CommandArgument::literal(&"-c"),
        build::CommandArgument::literal(&"test \"$MODE\" = fixture && test -s \"$4\" && test -s \"$5\" && tr a-z A-Z < \"$1\" > \"$2\" && printf 'source=tool-input\\n' > \"$3\""),
        build::CommandArgument::literal(&"nia-build-tool"),
        build::CommandArgument::packageInput(assets, fs::PathView::init(&"tool-input.txt")),
        build::CommandArgument::buildOutput(build::BuildPathView::init(&"transformed.txt")),
        build::CommandArgument::buildOutput(build::BuildPathView::init(&"transformed.meta")),
        build::CommandArgument::artifactInput(app),
        build::CommandArgument::artifactInput(worker),
    ];
    let toolEnvironment = [
        build::CommandEnvironmentInput::init(&"MODE", &"fixture"),
    ];
    let toolStep = b.addExternalCommandStep(
        &toolStepName,
        build::ExternalCommandOptions::search(&"sh")
            .withArguments(&toolArguments)
            .withEnvironment(&toolEnvironment)
            .withClearedEnvironment()
            .withDeclaredInputCache()
            .withResourceClass(build::ActionResourceClass::Io),
    ).?;
    b.dependOn(toolStep, installStep).?;
    b.dependOn(toolStep, runStep).?;
    b.setDefaultStep(toolStep).?;
    !{}
}

pub fn build(b: &mut build::Build) build::Error!void {
    configure(b).?;

    let mut buffer: [1024]u8 = [_]u8[0; 1024];
    let mut stdout = io::FileWriter::stdout(&mut buffer[..]);
    stdout.print(&"root={}\n", &[b.packageRoot().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.print(&"build={}\n", &[b.buildDir().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.print(&"cache={}\n", &[b.cacheDir().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.print(&"toolchain={}\n", &[b.toolchainExecutable().text()]).asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    stdout.flush().asBuildError(build::ErrorOperation::Report, build::ErrorSubject::Diagnostic).?;
    !{}
}
