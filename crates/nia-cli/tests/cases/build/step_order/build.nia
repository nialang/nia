using std::build;
pub fn build(b: &mut build::Build) build::Error!void {
    static prepareName = "prepare";
    static buildName = "build";
    static checkName = "check";
    let prepareStep = b.addAggregateStep(&prepareName).?;
    let buildStep = b.addAggregateStep(&buildName).?;
    let checkStep = b.addAggregateStep(&checkName).?;
    b.dependOn(buildStep, prepareStep).?;
    b.dependOn(checkStep, prepareStep).?;
    b.dependOn(checkStep, buildStep).?;
    !{}
}
