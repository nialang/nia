using std::build;

fn first(b: &mut build::Build) build::Error!void { _ = b; !{} }
fn second(b: &mut build::Build) build::Error!void { _ = b; !{} }

pub fn build(b: &mut build::Build) build::Error!void {
    static firstName = "first";
    static secondName = "second";
    let firstStep = b.addStep(&firstName, &first).?;
    let secondStep = b.addStep(&secondName, &second).?;
    b.dependOn(firstStep, secondStep).?;
    b.dependOn(secondStep, firstStep).?;
    !{}
}
