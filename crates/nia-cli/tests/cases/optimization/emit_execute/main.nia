using std::process;

fun pick(flag: bool, a: i32, b: i32) i32 {
    if flag {
        a
    } else {
        b
    }
}

fun answer() i32 {
    40
}

fun identity[T](value: T) T {
    value
}

fun plus_two(value: i32) i32 {
    value + 2
}

pub fun main(init: process::Init) process::ExitCode!() {
    _ = init;
    let mut x = answer();
    let mut y = x;
    y = identity[i32](y);
    let mut unused = plus_two(99);
    process::ExitCode(pick(true, plus_two(y), unused))!
}
